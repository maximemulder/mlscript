//│       {ε ≥ ({δ ≤ Int} ⟹ Int) ∧ ({δ ≤ ¬({ζ ≥ Str} ⟹ ¬Str), ζ ≥ Str ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ ζ), ζ ≥ ({δ ≤ Int, ε ≥ Int} ⟹ ⊥) ∧ ({δ ≤ ¬({ζ ≥ Str} ⟹ ¬Str), ε ≥ ζ} ⟹ Str ∧ ({δ ≤ ⊥} ⟹ ⊥)), δ ≤ ¬({ε ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≥ ζ, ζ ≥ ({δ ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥), ζ ≥ Str} ⟹ ¬Str)} ⟹ δ → ε ≤ Bool → Bool
//│         {ζ ≥ ({δ ≤ Int, ε ≥ Int} ⟹ ⊥) ∧ ({δ ≤ ¬({ζ ≥ Str} ⟹ ¬Str), ε ≥ ζ} ⟹ Str ∧ ({δ ≤ ⊥} ⟹ ⊥)), δ ≤ ¬({ε ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≥ ζ, ζ ≥ ({δ ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥), ζ ≥ Str} ⟹ ¬Str)} ⟹ δ → ε ≤ Bool → Bool
