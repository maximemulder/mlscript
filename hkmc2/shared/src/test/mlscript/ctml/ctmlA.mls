:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence

// Unique parameter

// Function definitions

fun foo(a) =
  if a is
    Int then (a as Int)
    Str then (a as Str)
//│ foo: ∀α, β, γ. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ {γ ≥ Str} ⟹ Str, γ ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ γ), γ ≥ ({α ≤ Int, β ≥ Int} ⟹ ⊥) ∧ ({α ≤ {γ ≥ Str} ⟹ Str, β ≥ γ} ⟹ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)), α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ γ, γ ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥), γ ≥ Str} ⟹ Str)} ⟹ α → β

// fun bar(a) =
//   foo(a) as Int

// Function overloads

foo as (Int -> Int) & (Str -> Str)
//│ (Int → Int) ∧ (Str → Str)

// Function applications

val int_or_string: Int | Str
//│ int_or_string: Int ∨ Str

foo(1)
//│ ∀α. {α ≥ Int} ⟹ α

foo("Hello")
//│ ∀α, β. {β ≥ {α ≥ β} ⟹ Str, α ≥ β} ⟹ α ∨ β

foo(bot)
//│ ∀α, β. {β ≥ ({α ≥ Int} ⟹ ⊥) ∧ ({α ≥ β} ⟹ ⊥), α ≥ Int ∧ β} ⟹ α ∨ (Int ∧ β)

foo(int_or_string)
//│ ∀α, β, γ, δ. {α ≥ Int, β ≥ {α ≥ Int} ⟹ ⊥, γ ≥ δ, δ ≥ {γ ≥ δ} ⟹ Str} ⟹ α ∨ γ ∨ Int ∨ δ

// Errors

:te
foo as (Int -> Int) & (Str -> Str) & (Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ {γ ≥ Str} ⟹ Str, γ ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ γ), γ ≥ ({α ≤ Int, β ≥ Int} ⟹ ⊥) ∧ ({α ≤ {γ ≥ Str} ⟹ Str, β ≥ γ} ⟹ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)), α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ γ, γ ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥), γ ≥ Str} ⟹ Str)} ⟹ α → β ≤ ((Int → Int) ∧ (Str → Str)) ∧ (Bool → Bool).
//│ Typing error tree:
//│   ∀α, β, γ. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ {γ ≥ Str} ⟹ Str, γ ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ γ), γ ≥ ({α ≤ Int, β ≥ Int} ⟹ ⊥) ∧ ({α ≤ {γ ≥ Str} ⟹ Str, β ≥ γ} ⟹ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)), α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ γ, γ ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥), γ ≥ Str} ⟹ Str)} ⟹ α → β ≤ ((Int → Int) ∧ (Str → Str)) ∧ (Bool → Bool)
//│     ∀α, β, γ. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ {γ ≥ Str} ⟹ Str, γ ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ γ), γ ≥ ({α ≤ Int, β ≥ Int} ⟹ ⊥) ∧ ({α ≤ {γ ≥ Str} ⟹ Str, β ≥ γ} ⟹ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)), α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ γ, γ ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥), γ ≥ Str} ⟹ Str)} ⟹ α → β ≤ Bool → Bool
//│       {ε ≥ ({δ ≤ Int} ⟹ Int) ∧ ({δ ≤ {ζ ≥ Str} ⟹ Str, ζ ≥ ({δ ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ ζ), ζ ≥ ({δ ≤ Int, ε ≥ Int} ⟹ ⊥) ∧ ({δ ≤ {ζ ≥ Str} ⟹ Str, ε ≥ ζ} ⟹ ({δ ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)), δ ≤ ({ε ≥ Int} ⟹ Int) ∨ ({ε ≥ ζ, ζ ≥ ({δ ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥), ζ ≥ Str} ⟹ Str)} ⟹ δ → ε ≤ Bool → Bool
//│         {ζ ≥ ({δ ≤ Int, ε ≥ Int} ⟹ ⊥) ∧ ({δ ≤ {ζ ≥ Str} ⟹ Str, ε ≥ ζ} ⟹ ({δ ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)), δ ≤ ({ε ≥ Int} ⟹ Int) ∨ ({ε ≥ ζ, ζ ≥ ({δ ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥), ζ ≥ Str} ⟹ Str)} ⟹ δ → ε ≤ Bool → Bool
//│           {δ ≤ ({ε ≥ Int} ⟹ Int) ∨ ({ε ≥ ζ, ζ ≥ ({δ ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥), ζ ≥ Str} ⟹ Str)} ⟹ δ → ε ≤ Bool → Bool
//│             δ → ε ≤ Bool → Bool
//│               Bool ≤ δ
//│                 Bool ≤ ({ε ≥ Int} ⟹ Int) ∨ ({ε ≥ ζ, ζ ≥ ({δ ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥), ζ ≥ Str} ⟹ Str)
//│                   Bool ≤ {ε ≥ Int} ⟹ Int
//│                     Bool ≤ Int
//│                   Bool ≤ {ε ≥ ζ, ζ ≥ ({δ ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥), ζ ≥ Str} ⟹ Str
//│                     Bool ≤ {ζ ≥ ({δ ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥), ζ ≥ Str} ⟹ Str
//│                       Bool ≤ {ζ ≥ Str} ⟹ Str
//│                         Bool ≤ Str

:te
foo(true)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ {γ ≥ Str} ⟹ Str, γ ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ γ), γ ≥ ({α ≤ Int, β ≥ Int} ⟹ ⊥) ∧ ({α ≤ {γ ≥ Str} ⟹ Str, β ≥ γ} ⟹ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)), α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ γ, γ ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥), γ ≥ Str} ⟹ Str)} ⟹ α → β ≤ Bool → δ.
//│ Typing error tree:
//│   ∀α, β, γ. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ {γ ≥ Str} ⟹ Str, γ ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ γ), γ ≥ ({α ≤ Int, β ≥ Int} ⟹ ⊥) ∧ ({α ≤ {γ ≥ Str} ⟹ Str, β ≥ γ} ⟹ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)), α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ γ, γ ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥), γ ≥ Str} ⟹ Str)} ⟹ α → β ≤ Bool → δ
//│     {ζ ≥ ({ε ≤ Int} ⟹ Int) ∧ ({ε ≤ {η ≥ Str} ⟹ Str, η ≥ ({ε ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ η), η ≥ ({ε ≤ Int, ζ ≥ Int} ⟹ ⊥) ∧ ({ε ≤ {η ≥ Str} ⟹ Str, ζ ≥ η} ⟹ ({ε ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)), ε ≤ ({ζ ≥ Int} ⟹ Int) ∨ ({ζ ≥ η, η ≥ ({ε ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥), η ≥ Str} ⟹ Str)} ⟹ ε → ζ ≤ Bool → δ
//│       {η ≥ ({ε ≤ Int, ζ ≥ Int} ⟹ ⊥) ∧ ({ε ≤ {η ≥ Str} ⟹ Str, ζ ≥ η} ⟹ ({ε ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)), ε ≤ ({ζ ≥ Int} ⟹ Int) ∨ ({ζ ≥ η, η ≥ ({ε ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥), η ≥ Str} ⟹ Str)} ⟹ ε → ζ ≤ Bool → δ
//│         {ε ≤ ({ζ ≥ Int} ⟹ Int) ∨ ({ζ ≥ η, η ≥ ({ε ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥), η ≥ Str} ⟹ Str)} ⟹ ε → ζ ≤ Bool → δ
//│           ε → ζ ≤ Bool → δ
//│             Bool ≤ ε
//│               Bool ≤ ({ζ ≥ Int} ⟹ Int) ∨ ({ζ ≥ η, η ≥ ({ε ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥), η ≥ Str} ⟹ Str)
//│                 Bool ≤ {ζ ≥ Int} ⟹ Int
//│                   Bool ≤ Int
//│                 Bool ≤ {ζ ≥ η, η ≥ ({ε ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥), η ≥ Str} ⟹ Str
//│                   Bool ≤ {η ≥ ({ε ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥), η ≥ Str} ⟹ Str
//│                     Bool ≤ {η ≥ Str} ⟹ Str
//│                       Bool ≤ Str

// Multiple parameters

// Function definitons

fun foo2(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo2: ∀α, β, γ, δ. {α ≤ ({β ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({γ ≥ δ, δ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥), β ≤ Str, δ ≥ Str} ⟹ Str), δ ≥ ({α ≤ Int, β ≤ Int, γ ≥ Int} ⟹ ⊥) ∧ ({α ≤ {β ≤ Str, δ ≥ Str} ⟹ Str, γ ≥ δ} ⟹ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ {β ≤ Str, δ ≥ Str} ⟹ Str, δ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ δ)} ⟹ α → β → γ

// fun bar2(a, b) =
//   foo2(a, b) as Int

// Function overloads

foo2 as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

// Function applications

foo2(1, 2)
//│ ∀α, β. {α ≥ Int, β ≥ {α ≥ Int} ⟹ ⊥} ⟹ α

foo2("Hello", "World")
//│ ∀α, β. {α ≥ β, β ≥ {α ≥ β} ⟹ Str} ⟹ α ∨ β

foo2(bot, bot)
//│ ∀α, β. {α ≥ Int ∧ β, β ≥ ({α ≥ Int} ⟹ ⊥) ∧ ({α ≥ β} ⟹ ⊥)} ⟹ α ∨ (Int ∧ β)

// Errors

:te
foo2(1, "World")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ {β ≤ Str} ⟹ Str.
//│ Typing error tree:
//│   α ≤ {β ≤ Str} ⟹ Str
//│     Int ≤ {β ≤ Str} ⟹ Str
//│       Int ≤ Str

// Same return

fun fooI(a, b) =
  let _ = if a is
    Int then (b as Int)
    Str then (b as Str)
  1
//│ fooI: ∀α. (({α ≤ Int} ⟹ Int) ∨ ({α ≤ Str} ⟹ Str)) → α → Int

fooI(1, 2)
//│ Int

:breakme // FIXME: Discarded match constraints do not escape into the enclosing function type.
:te
fooI(1, "World")
//│ Int

:breakme // FIXME: Discarded match constraints do not escape into the enclosing function type.
:te
fooI("Hello", 2)
//│ Int

fooI("Hello", "World")
//│ Int
