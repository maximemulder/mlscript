//│ Typing error tree:
//│   ∀α, β, γ. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬({γ ≥ Str} ⟹ ¬Str)} ⟹ γ), γ ≥ ({α ≤ Int, β ≥ Int} ⟹ ⊥) ∧ ({α ≤ ¬({γ ≥ Str} ⟹ ¬Str), β ≥ γ} ⟹ Str ∧ ({α ≤ ⊥} ⟹ ⊥)), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ ¬({γ ≥ Str} ⟹ ¬Str), β ≥ γ} ⟹ ¬Str)} ⟹ α → β ≤ ((Int → Int) ∧ (Str → Str)) ∧ (Bool → Bool)
//│     ∀α, β, γ. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬({γ ≥ Str} ⟹ ¬Str)} ⟹ γ), γ ≥ ({α ≤ Int, β ≥ Int} ⟹ ⊥) ∧ ({α ≤ ¬({γ ≥ Str} ⟹ ¬Str), β ≥ γ} ⟹ Str ∧ ({α ≤ ⊥} ⟹ ⊥)), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ ¬({γ ≥ Str} ⟹ ¬Str), β ≥ γ} ⟹ ¬Str)} ⟹ α → β ≤ Bool → Bool
//│       {ε ≥ ({δ ≤ Int} ⟹ Int) ∧ ({δ ≤ ¬({ζ ≥ Str} ⟹ ¬Str)} ⟹ ζ), ζ ≥ ({δ ≤ Int, ε ≥ Int} ⟹ ⊥) ∧ ({δ ≤ ¬({ζ ≥ Str} ⟹ ¬Str), ε ≥ ζ} ⟹ Str ∧ ({δ ≤ ⊥} ⟹ ⊥)), δ ≤ ¬({ε ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≤ ¬({ζ ≥ Str} ⟹ ¬Str), ε ≥ ζ} ⟹ ¬Str)} ⟹ δ → ε ≤ Bool → Bool
//│         {ζ ≥ ({δ ≤ Int, ε ≥ Int} ⟹ ⊥) ∧ ({δ ≤ ¬({ζ ≥ Str} ⟹ ¬Str), ε ≥ ζ} ⟹ Str ∧ ({δ ≤ ⊥} ⟹ ⊥)), δ ≤ ¬({ε ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≤ ¬({ζ ≥ Str} ⟹ ¬Str), ε ≥ ζ} ⟹ ¬Str)} ⟹ δ → ε ≤ Bool → Bool
//│           {δ ≤ ¬({ε ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≤ ¬({ζ ≥ Str} ⟹ ¬Str), ε ≥ ζ} ⟹ ¬Str)} ⟹ δ → ε ≤ Bool → Bool
//│             δ → ε ≤ Bool → Bool
//│               Bool ≤ δ
//│                 Bool ≤ ¬({ε ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≤ ¬({ζ ≥ Str} ⟹ ¬Str), ε ≥ ζ} ⟹ ¬Str)
//│                   Bool ≤ ¬({ε ≥ Int} ⟹ ¬Int)
