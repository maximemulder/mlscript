:ctml

fun foo2(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo2: ∀α, β, γ. {β ≤ ({γ ≥ Int, α ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, α ≤ Str} ⟹ Str), α ≤ ({γ ≥ Int, β ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, β ≤ Str} ⟹ Str), γ ≥ ({β ≤ Int, α ≤ Int} ⟹ Int) ∧ ({β ≤ Str, α ≤ Str} ⟹ Str)} ⟹ α → β → γ

fun bar2(a, b) =
  foo2(a, b) as Int
//│ bar2: ∀α, β, γ. {α ≤ Int, γ ≤ Int, α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ Str, γ ≤ Str} ⟹ Str), β ≥ Int ∧ ({γ ≤ Str, α ≤ Str} ⟹ Str)} ⟹ α → Int → Int
