// Same return

fun fooI(a, b) =
  let _ = if a is
    Int then (b as Int)
    Str then (b as Str)
  1
//│ fooI: ∀α. (({α ≤ Int} ⟹ Int) ∨ ({α ≤ Str} ⟹ Str)) → α → Int

fooI(1, 2)
//│ Int

:breakme // FIXME: Discarded match constraints do not escape into the enclosing function type.
:te
fooI(1, "World")
//│ Int

:breakme // FIXME: Discarded match constraints do not escape into the enclosing function type.
:te
fooI("Hello", 2)
//│ Int

fooI("Hello", "World")
//│ Int
