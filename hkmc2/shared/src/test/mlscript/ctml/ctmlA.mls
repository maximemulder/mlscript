:ctml

:ctml-dbg infer constrain check var

:ctml-cfg cache-univ

fun foo(a, b) =
  a(1, b)
//│ infer ELam(a,ELam(b,EApp(EApp(EVar(a),EVar(int)),EVar(b))))
