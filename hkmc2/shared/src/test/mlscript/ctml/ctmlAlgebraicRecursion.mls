//│         ((LCons ∧ {head: β}) ∧ {tail: ∀γ. {(((LCons ∧ {head: β}) ∧ {tail: γ}) ∨ LNil) ∨ δ ≤ γ} ⟹ γ}) ∨ LNil ≤ {ε ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ε})} ⟹ ε
//│           ((LCons ∧ {head: β}) ∧ {tail: ∀γ. {(((LCons ∧ {head: β}) ∧ {tail: γ}) ∨ LNil) ∨ δ ≤ γ} ⟹ γ}) ∨ LNil ≤ ε
