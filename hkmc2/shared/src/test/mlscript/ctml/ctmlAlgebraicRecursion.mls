:ctml
:ctml-cfg algebraic-recursion search-steps 5000

/** The end of a chain. */
data class Stop()
/** A node of a chain. */
data class Next(tail)
//│ Stop: Unit → Stop
//│ Next: ∀α. α → (Next ∧ {tail: α})

/** A consumer's admissible domains are post-fixed points of the chain layer. */
type Consumer = [A extends (Stop | (Next & {tail: A}))] -> A -> Int
//│ Consumer = ∀A. {A ≤ Stop ∨ (Next ∧ {tail: A})} ⟹ A → Int

/** A producer with a payload binder preceding its recursive result carrier. */
type Producer = [P] -> [R restricts (P | (Next & {tail: R}))] -> P -> R
//│ Producer = ∀P, R. {R ≥ P ∨ (Next ∧ {tail: R})} ⟹ P → R

/** Finite chains ending in Stop. */
type Chain = [R restricts (Stop | (Next & {tail: R}))] -> R
//│ Chain = ∀R. {R ≥ Stop ∨ (Next ∧ {tail: R})} ⟹ R

declare fun consume: Consumer
declare fun produce: Producer
//│ consume: Consumer
//│ produce: Producer

produce(Stop()) as Chain
//│ Chain

consume(Stop()) as Int
//│ Int

consume(Next(Stop())) as Int
//│ Int

:te
consume(true)
//│ ═══[TYPE ERROR] Cannot solve judgment Consumer ≤ Bool → α.
//│ Typing error tree:
//│   Consumer ≤ Bool → α
//│     ∀A. {A ≤ Stop ∨ (Next ∧ {tail: A})} ⟹ A → Int ≤ Bool → α
//│       ¬(∀β. {¬(Stop ∨ (Next ∧ {tail: ¬β})) ∨ γ ≤ β} ⟹ β) → Int ≤ Bool → α
//│         Bool ≤ ¬(∀β. {¬(Stop ∨ (Next ∧ {tail: ¬β})) ∨ γ ≤ β} ⟹ β)
//│           ∀β. {¬(Stop ∨ (Next ∧ {tail: ¬β})) ∨ γ ≤ β} ⟹ β ≤ ¬Bool
//│             {¬(Stop ∨ (Next ∧ {tail: ¬δ})) ∨ γ ≤ δ} ⟹ δ ≤ ¬Bool
//│               δ ≤ ¬Bool
//│                 ¬(Stop ∨ (Next ∧ {tail: ¬δ})) ∨ γ ≤ ¬Bool
//│                   ¬(Stop ∨ (Next ∧ {tail: ¬δ})) ≤ ¬Bool
//│                     Bool ≤ Stop ∨ (Next ∧ {tail: ¬δ})
//│                       Bool ≤ Stop
//│                       Bool ≤ Next ∧ {tail: ¬δ}
//│                         Bool ≤ Next

:te
consume(Next(true))
//│ ═══[TYPE ERROR] Cannot solve judgment Consumer ≤ α → β.
//│ Typing error tree:
//│   Consumer ≤ α → β
//│     ∀A. {A ≤ Stop ∨ (Next ∧ {tail: A})} ⟹ A → Int ≤ α → β
//│       ¬(∀γ. {¬(Stop ∨ (Next ∧ {tail: ¬γ})) ∨ δ ≤ γ} ⟹ γ) → Int ≤ α → β
//│         α ≤ ¬(∀γ. {¬(Stop ∨ (Next ∧ {tail: ¬γ})) ∨ δ ≤ γ} ⟹ γ)
//│           ∀γ. {¬(Stop ∨ (Next ∧ {tail: ¬γ})) ∨ δ ≤ γ} ⟹ γ ≤ ¬α
//│             {¬(Stop ∨ (Next ∧ {tail: ¬ε})) ∨ δ ≤ ε} ⟹ ε ≤ ¬α
//│               ε ≤ ¬α
//│                 ¬(Stop ∨ (Next ∧ {tail: ¬ε})) ∨ δ ≤ ¬α
//│                   α ≤ ¬(¬(Stop ∨ (Next ∧ {tail: ¬ε})) ∨ δ)
//│                     Next ∧ {tail: ζ} ≤ ¬(¬(Stop ∨ (Next ∧ {tail: ¬ε})) ∨ δ)
//│                       Next ∧ {tail: ζ} ≤ ¬¬(Stop ∨ (Next ∧ {tail: ¬ε}))
//│                         Next ∧ {tail: ζ} ≤ Stop ∨ (Next ∧ {tail: ¬ε})
//│                           Next ∧ {tail: ζ} ≤ Stop
//│                             Next ≤ Stop
//│                             {tail: ζ} ≤ Stop
//│                               ζ ≤ ⊥
//│                                 Bool ≤ ⊥
//│                           Next ∧ {tail: ζ} ≤ Next ∧ {tail: ¬ε}
//│                             Next ∧ {tail: ζ} ≤ {tail: ¬ε}
//│                               Next ≤ {tail: ¬ε}
//│                               {tail: ζ} ≤ {tail: ¬ε}
//│                                 ζ ≤ ¬ε
//│                                   Bool ≤ ¬ε
//│                                     ε ≤ ¬Bool
//│                                       ¬(Stop ∨ (Next ∧ {tail: ¬ε})) ∨ δ ≤ ¬Bool
//│                                         ¬(Stop ∨ (Next ∧ {tail: ¬ε})) ≤ ¬Bool
//│                                           Bool ≤ Stop ∨ (Next ∧ {tail: ¬ε})
//│                                             Bool ≤ Stop
//│                                             Bool ≤ Next ∧ {tail: ¬ε}
//│                                               Bool ≤ Next

:fixme // FIXME: Closing recursive branch guards still exceeds the bounded solver search.
/** A return annotation constrains the result without supplying a recursive domain. */
fun walk(xs): Int = if xs is
  Stop() then 0
  Next(t) then walk(t)
//│ ═══[TYPE ERROR] Subtyping search inconclusive: operation exceeded 5000 solver calls

