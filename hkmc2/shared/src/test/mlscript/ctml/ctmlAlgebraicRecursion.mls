:ctml-cfg algebraic-recursion

/** Empty list. */
data class LNil()
/** A list cell. */
data class LCons(head, tail)
//│ LNil: Unit → LNil
//│ LCons: ∀α, β. α → β → ((LCons ∧ {head: α}) ∧ {tail: β})

/** Replicate a payload through a recursive result carrier. */
fun replicate(n, x) = if n == 0 then LNil() else LCons(x, replicate(n - 1, x))
//│ replicate: ∀α, β. {β ≥ ((LCons ∧ {head: α}) ∧ {tail: β}) ∨ LNil} ⟹ Int → α → (((LCons ∧ {head: α}) ∧ {tail: β}) ∨ LNil)

/** Integer lists. */
type IntList = [X restricts (LNil | (LCons & {head: Int} & {tail: X}))] -> X
//│ IntList = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X

replicate as (Int -> Int -> IntList)
//│ Int → Int → IntList

replicate(2, 1) as IntList
//│ IntList

:te
