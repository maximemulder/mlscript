:ctml

// Local helpers can capture parameters, call themselves, and return closures.

fun local(x) =
  fun add(y) = x + y
  add(1)
//│ local: Int → Int

local(2)
//│ Int

:te
local("bad")
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int ≤ Str → α.
//│ Typing error tree:
//│   Int → Int ≤ Str → α
//│     Str ≤ Int

fun localFib(n) =
  fun fib(n) = if n == 0 || n == 1 then n else fib(n - 1) + fib(n - 2)
  fib(n)
//│ localFib: Int → Int

localFib(10)
//│ Int

fun delayed(x) =
  fun get() = x
  get
//│ delayed: ∀α. α → Unit → α

delayed(1)()
//│ Int

delayed("hello")()
//│ Str

// Sequential helpers retain polymorphism at their uses.

fun polymorphic() =
  fun id(x) = x
  fun use() = [id(1), id("hello")]
  use()
//│ polymorphic: Unit → ⟨Int, Str⟩

polymorphic()
//│ ⟨Int, Str⟩

// Forward references and mutual recursion are unsupported, including inside closures.

:te
fun forward(x) = later(x)
fun later(x) = x
//│ ═══[TYPE ERROR] Variable 'later' has no type.

:te
fun localForward() =
  fun use() = id(1)
  fun id(x) = x
  use()
//│ ═══[TYPE ERROR] Variable 'id' has no type.

:te
fun even(n) = if n == 0 then true else odd(n - 1)
fun odd(n) = if n == 0 then false else even(n - 1)
//│ ═══[TYPE ERROR] Variable 'odd' has no type.

:te
fun parity(n) =
  fun even(n) = if n == 0 then true else odd(n - 1)
  fun odd(n) = if n == 0 then false else even(n - 1)
  even(n)
//│ ═══[TYPE ERROR] Variable 'odd' has no type.

// Direct recursive helpers preserve constraints on captured parameters.

fun captured(x) =
  fun loop(n) = if n == 0 then x + 1 else loop(n - 1)
  loop(2)
//│ captured: Int → Int

captured(1)
//│ Int

:te
captured(1) as Str
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str.
//│ Typing error tree:
//│   α ≤ Str
//│     Int ≤ Str

:te
captured("bad")
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int ≤ Str → α.
//│ Typing error tree:
//│   Int → Int ≤ Str → α
//│     Str ≤ Int

// An unused initializer must still constrain its captured parameter.

fun unused(x) =
  let ignored = x + 1
  true
//│ unused: Int → Bool

unused(1)
//│ Bool

:te
unused("bad")
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Bool ≤ Str → α.
//│ Typing error tree:
//│   Int → Bool ≤ Str → α
//│     Str ≤ Int

// An unused closure does not execute its body or require the captured value to be an integer.

fun unusedHelper(x) =
  fun ignored() = x + 1
  true
//│ unusedHelper: ⊤ → Bool

unusedHelper(1)
//│ Bool

unusedHelper("bad")
//│ Bool

// Symbol identities keep a closure's references intact across shadowing.

fun shadow(x) =
  fun get() = x
  let x = "shadow"
  get()
//│ shadow: ∀α. α → α

shadow(1)
//│ Int

fun nested(n) =
  fun loop(n) = if n == 0 then 0 else loop(n - 1)
  fun call() =
    fun loop(x) = x
    [loop("inner"), loop(true)]
  [loop(n), call()]
//│ nested: Int → ⟨Int, ⟨Str, Bool⟩⟩

nested(2)
//│ ⟨Int, ⟨Str, Bool⟩⟩

// Parameter and result annotations constrain both ordinary and recursive functions.

fun annotated(x: Int): Int = x
//│ annotated: Int → Int

annotated(1)
//│ Int

:te
annotated("bad")
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int ≤ Str → α.
//│ Typing error tree:
//│   Int → Int ≤ Str → α
//│     Str ≤ Int

:te
fun badBody(x: Str) = x + 1
//│ ═══[TYPE ERROR] Cannot solve judgment ⊥ → Int ≤ Str → ⊤.
//│ Typing error tree:
//│   ⊥ → Int ≤ Str → ⊤
//│     Str ≤ ⊥

fun annotatedRec(x: Int): Int = if x == 0 then x else annotatedRec(x - 1)
//│ annotatedRec: Int → Int

annotatedRec(3)
//│ Int

:te
fun badRec(x: Int): Str = if x == 0 then x else badRec(x - 1)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {β ≤ Str, γ ≤ α → β, α ≥ Int} ⟹ ⊥ → Str ≤ Int → ⊤.
//│ Typing error tree:
//│   ∀α, β. {β ≤ Str, γ ≤ α → β, α ≥ Int} ⟹ ⊥ → Str ≤ Int → ⊤
//│     {ε ≤ Str, γ ≤ δ → ε, δ ≥ Int} ⟹ ⊥ → Str ≤ Int → ⊤
//│       {γ ≤ δ → ε, δ ≥ Int} ⟹ ⊥ → Str ≤ Int → ⊤
//│         {δ ≥ Int} ⟹ ⊥ → Str ≤ Int → ⊤
//│           ⊥ → Str ≤ Int → ⊤
//│             Int ≤ ⊥

// Generated references to the prelude fixed point cannot capture a local name.

fun independent(fix) =
  fun loop(n) = if n == 0 then 0 else loop(n - 1)
  loop(2)
//│ independent: ⊤ → Int

independent("shadowed")
//│ Int

// Ordinary let bindings retain first-class polymorphic values.

fun letPoly() =
  let id = x => x
  [id(1), id("hello")]
//│ letPoly: Unit → ⟨Int, Str⟩

letPoly()
//│ ⟨Int, Str⟩

// Functions and values can be interleaved in dependency order.

fun mixed(x) =
  val localCapture = x + 1
  fun helper(y) = y
  fun first(y) = helper(y) + localCapture
  first(2)
//│ mixed: Int → Int

mixed(1)
//│ Int

:te
mixed("bad")
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int ≤ Str → α.
//│ Typing error tree:
//│   Int → Int ≤ Str → α
//│     Str ≤ Int

fun withValues(x) =
  val y = x + 1
  fun add(z) = y + z
  val answer = add(2)
  answer
//│ withValues: Int → Int

withValues(1)
//│ Int

// Value initializers cannot refer to later functions or values.

:te
val forwardValue = forwardFunction(1)
fun forwardFunction(x) = x
//│ ═══[TYPE ERROR] Variable 'forwardFunction' has no type.

:te
val premature = readLater()
fun readLater() = laterValue
val laterValue = 1
//│ ═══[TYPE ERROR] Variable 'readLater' has no type.

:te
val early = late + 1
val late = 1
//│ ═══[TYPE ERROR] Variable 'late' has no type.

// Function-valued vals support direct recursion, but not mutual recursion.

val countdown = n => if n == 0 then 0 else countdown(n - 1)
//│ countdown: Int → Int

countdown(3)
//│ Int

:te
val evenValue = n => if n == 0 then true else oddValue(n - 1)
val oddValue = n => if n == 0 then false else evenValue(n - 1)
//│ ═══[TYPE ERROR] Variable 'oddValue' has no type.

// Local recursive functions can be used at different types, but may merge their results.

fun recursiveIdentity() =
  fun id(n, x) = if n == 0 then x else id(n - 1, x)
  [id(1, 1), id(1, "hello")]
//│ recursiveIdentity: Unit → ⟨Int ∨ Str, Int ∨ Str⟩

recursiveIdentity()
//│ ⟨Int ∨ Str, Int ∨ Str⟩

:fixme // FIXME: Local fixed-point applications are not generalized before their continuation.
recursiveIdentity() as [Int, Str]
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ ⟨Int, Str⟩.
//│ Typing error tree:
//│   α ≤ ⟨Int, Str⟩
//│     ⟨Int ∨ Str, Int ∨ Str⟩ ≤ ⟨Int, Str⟩
//│       Int ∨ Str ≤ Int
//│         Str ≤ Int

// Top-level recursive definitions are generalized before their uses.

fun recursiveId(n, x) = if n == 0 then x else recursiveId(n - 1, x)
//│ recursiveId: ∀α. Int → α → α

[recursiveId(1, 1), recursiveId(1, "hello")] as [Int, Str]
//│ ⟨Int, Str⟩

// A direct recursive call must agree with the inferred function signature.

:te
fun badSelf(n) = if n - 1 == 0 then 0 else badSelf("bad")
//│ ═══[TYPE ERROR] Cannot solve judgment ∀A. (A → A) → A ≤ (∀α, β. {α ≤ Str → β} ⟹ α → Int → (β ∨ Int)) → γ.
//│ Typing error tree:
//│   ∀A. (A → A) → A ≤ (∀α, β. {α ≤ Str → β} ⟹ α → Int → (β ∨ Int)) → γ
//│     (δ → δ) → δ ≤ (∀α, β. {α ≤ Str → β} ⟹ α → Int → (β ∨ Int)) → γ
//│       ∀α, β. {α ≤ Str → β} ⟹ α → Int → (β ∨ Int) ≤ δ → δ
//│         {ε ≤ Str → ζ} ⟹ ε → Int → (ζ ∨ Int) ≤ δ → δ
//│           ε → Int → (ζ ∨ Int) ≤ δ → δ
//│             Int → (ζ ∨ Int) ≤ δ
//│               Int → (ζ ∨ Int) ≤ Str → ζ
//│                 Str ≤ Int

// Local recursive values are rejected without executing their initializers.

:pe
fun recursiveValue() =
  val x = x + 1
  x
//│ ═══[PARSE ERROR] Recursive bindings require a function initializer.

// Captured refinements remain available in local functions.

fun refined(x) =
  if x is Int then
    fun add(y) = x + y
    add(1)
  else 0
//│ refined: ∀α. α → (({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Int))

refined(1)
//│ Int

refined("hello")
//│ Int

// Compiler-generated references to literals and the conditional cannot capture local names.

fun constants(int, bool, string, _if_) =
  [1, if true then "yes" else "no"]
//│ constants: ⊤ → ⊤ → ⊤ → ⊤ → ⟨Int, Str⟩

constants("shadow", 1, true, 2)
//│ ⟨Int, Str⟩

:te
constants("shadow", 1, true, 2) as [Str, Str]
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ ⟨Str, Str⟩.
//│ Typing error tree:
//│   α ≤ ⟨Str, Str⟩
//│     ⟨Int, Str⟩ ≤ ⟨Str, Str⟩
//│       Int ≤ Str

// An annotated parameter can be refined, and its function must accept the entire annotation.

fun typedFlow(x: Int | Str) = if x is Int then x + 1 else 0
//│ typedFlow: ∀α. {α ≤ Int ∨ Str} ⟹ α → (({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Int))

typedFlow(1)
//│ Int

typedFlow("hello")
//│ Int

:te
typedFlow(true)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α. {α ≤ Int ∨ Str} ⟹ α → (({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Int)) ≤ Bool → β.
//│ Typing error tree:
//│   ∀α. {α ≤ Int ∨ Str} ⟹ α → (({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Int)) ≤ Bool → β
//│     {γ ≤ Int ∨ Str} ⟹ γ → (({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ ¬Int} ⟹ Int)) ≤ Bool → β
//│       γ → (({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ ¬Int} ⟹ Int)) ≤ Bool → β
//│         Bool ≤ γ
//│           Bool ≤ Int ∨ Str
//│             Bool ≤ Int
//│             Bool ≤ Str

:te
fun partial(x: Int | Str) = if x is Int then x
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α. {α ≤ Int} ⟹ α → α ≤ (Int ∨ Str) → ⊤.
//│ Typing error tree:
//│   ∀α. {α ≤ Int} ⟹ α → α ≤ (Int ∨ Str) → ⊤
//│     ∀α. {α ≤ Int} ⟹ α → α ≤ Str → ⊤
//│       {β ≤ Int} ⟹ β → β ≤ Str → ⊤
//│         β → β ≤ Str → ⊤
//│           Str ≤ β
//│             Str ≤ Int

:te
fun narrowed(x: Int | Str) = x + 1
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int ≤ (Int ∨ Str) → ⊤.
//│ Typing error tree:
//│   Int → Int ≤ (Int ∨ Str) → ⊤
//│     Int ∨ Str ≤ Int
//│       Str ≤ Int

// Unsupported variadics are rejected instead of dropping parameters or arguments.

:pe
fun variadic(...args) = args
//│ ═══[PARSE ERROR] Rest and contextual parameters are unsupported in CTML.

:pe
((x, y) => x)(...[1, 2], true)
//│ ═══[PARSE ERROR] Unsupported CTML term: Lam(ParamList(‹›,List(Param(‹›,x,None,Modulefulness(None)), Param(‹›,y,None,Modulefulness(None))),None),Ref(x))

:pe
declare fun variadicDeclaration(...args): Top
//│ ═══[PARSE ERROR] Rest and contextual parameters are unsupported in CTML.

:pe
fun explicitTypeParameter[A](x: A) = x
//│ ═══[PARSE ERROR] Type parameters on function definitions are unsupported.
