//│                             Int ≤ Str

// Local recursive values are rejected without executing their initializers.

:pe
fun recursiveValue() =
  val x = x + 1
  x
//│ ═══[PARSE ERROR] Recursive bindings require a function initializer.

// Captured refinements remain available in local functions.

fun refined(x) =
  if x is Int then
    fun add(y) = x + y
    add(1)
  else 0
//│ refined: ∀α. α → (({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Int))

refined(1)
//│ Int

refined("hello")
//│ Int

fun mutualIdentity() =
  fun left(n, x) = if n == 0 then x else right(n - 1, x)
  fun right(n, x) = left(n, x)
  [left(1, 1), right(1, "hello")]
//│ mutualIdentity: Unit → ⟨Int, Str⟩

mutualIdentity()
//│ ⟨Int, Str⟩

// Compiler-generated references to literals and the conditional cannot capture local names.

fun constants(int, bool, string, _if_) =
  [1, if true then "yes" else "no"]
//│ constants: ⊤ → ⊤ → ⊤ → ⊤ → ⟨Int, Str⟩

constants("shadow", 1, true, 2)
//│ ⟨Int, Str⟩

:te
constants("shadow", 1, true, 2) as [Str, Str]
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ ⟨Str, Str⟩.
//│ Typing error tree:
//│   α ≤ ⟨Str, Str⟩
//│     ⟨Int, Str⟩ ≤ ⟨Str, Str⟩
//│       Int ≤ Str

// An annotated parameter can be refined, and its function must accept the entire annotation.

fun typedFlow(x: Int | Str) = if x is Int then x + 1 else 0
//│ typedFlow: ∀α. {α ≤ Int ∨ Str} ⟹ α → (({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Int))

typedFlow(1)
//│ Int

typedFlow("hello")
//│ Int

:te
typedFlow(true)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α. {α ≤ Int ∨ Str} ⟹ α → (({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Int)) ≤ Bool → β.
//│ Typing error tree:
//│   ∀α. {α ≤ Int ∨ Str} ⟹ α → (({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Int)) ≤ Bool → β
//│     {γ ≤ Int ∨ Str} ⟹ γ → (({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ ¬Int} ⟹ Int)) ≤ Bool → β
//│       γ → (({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ ¬Int} ⟹ Int)) ≤ Bool → β
//│         Bool ≤ γ
//│           Bool ≤ Int ∨ Str
//│             Bool ≤ Int
//│             Bool ≤ Str

:te
fun partial(x: Int | Str) = if x is Int then x
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α. {α ≤ Int} ⟹ α → α ≤ (Int ∨ Str) → ⊤.
//│ Typing error tree:
//│   ∀α. {α ≤ Int} ⟹ α → α ≤ (Int ∨ Str) → ⊤
//│     ∀α. {α ≤ Int} ⟹ α → α ≤ Str → ⊤
//│       {β ≤ Int} ⟹ β → β ≤ Str → ⊤
//│         β → β ≤ Str → ⊤
//│           Str ≤ β
//│             Str ≤ Int

:te
fun narrowed(x: Int | Str) = x + 1
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int ≤ (Int ∨ Str) → ⊤.
//│ Typing error tree:
//│   Int → Int ≤ (Int ∨ Str) → ⊤
//│     Int ∨ Str ≤ Int
//│       Str ≤ Int

// Unsupported variadics are rejected instead of dropping parameters or arguments.

:pe
fun variadic(...args) = args
//│ ═══[PARSE ERROR] Rest and contextual parameters are unsupported in CTML.

:pe
((x, y) => x)(...[1, 2], true)
//│ ═══[PARSE ERROR] Unsupported CTML term: Lam(ParamList(‹›,List(Param(‹›,x,None,Modulefulness(None)), Param(‹›,y,None,Modulefulness(None))),None),Ref(x))

:pe
declare fun variadicDeclaration(...args): Top
//│ ═══[PARSE ERROR] Rest and contextual parameters are unsupported in CTML.

:pe
fun explicitTypeParameter[A](x: A) = x
//│ ═══[PARSE ERROR] Type parameters on function definitions are unsupported.
