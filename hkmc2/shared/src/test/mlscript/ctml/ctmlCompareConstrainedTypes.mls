:ctml

([A] -> A -> A) == ([A] -> A -> A)
//│ OK

([A] -> A -> A) <= (Int -> Int)
//│ OK

:e
(Int -> Int) <= ([A] -> A -> A)
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ ∀A. A → A.
//│ Typing error tree:
//│   Int → Int ≤ ∀A. A → A
//│     Int → Int ≤ α → α
//│       α ≤ Int
//│         ⊤ ≤ Int

:e
([A extends Str] -> A -> A) <= (Int -> Int)
//│ ═══[ERROR] Cannot solve judgment ∀A. {A ≤ Str} ⟹ A → A ≤ Int → Int.
//│ Typing error tree:
//│   ∀A. {A ≤ Str} ⟹ A → A ≤ Int → Int
//│     {α ≤ Str} ⟹ α → α ≤ Int → Int
//│       α → α ≤ Int → Int
//│         Int ≤ α
//│           Int ≤ Str

// ([A extends Int restricts Str] -> A) <= Top
