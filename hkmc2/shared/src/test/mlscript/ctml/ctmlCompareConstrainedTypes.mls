:ctml

([A] -> A -> A) == ([A] -> A -> A)
//│ OK
//│ δ ≤ γ, δ ≥ γ, δ fresh, γ rigid, β ≤ α, β ≥ α, β fresh, α rigid

([A] -> A -> A) <= (Int -> Int)
//│ OK
//│ ε ≤ Int, ε ≥ Int, ε fresh

:e
(Int -> Int) <= ([A] -> A -> A)
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ ∀A. A → A.
//│ Typing error tree:
//│   Int → Int ≤ ∀A. A → A
//│     Int → Int ≤ ζ → ζ
//│       ζ ≤ Int
//│         ⊤ ≤ Int
//│           ⊤ ≤ ⊥

:e
([A extends Str] -> A -> A) <= (Int -> Int)
//│ ═══[ERROR] Cannot solve judgment ∀A. {A ≤ Str} ⟹ A → A ≤ Int → Int.
//│ Typing error tree:
//│   ∀A. {A ≤ Str} ⟹ A → A ≤ Int → Int
//│     {η ≤ Str} ⟹ η → η ≤ Int → Int
//│       η → η ≤ Int → Int
//│         Int ≤ η
//│           Int ≤ Str
//│             Int ≤ ⊥
//│               ⊤ ≤ ⊥

// ([A extends Int restricts Str] -> A) <= Top
