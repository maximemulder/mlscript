:ctml

type A
type B
type C
type D

// Simple constrained types

Int <:< [Bot <:< Top] => Int
//│ OK

([Bot <:< Top] => Int) <:< Int
//│ OK

([Bot <:< Top] => Nat) <:< ([Bot <:< Top] => Int)
//│ OK

:te
Int <:< ([Bot <:< Top] => Nat)
//│ ═══[TYPE ERROR] Cannot solve judgment Int ≤ {⊥ ≤ ⊤} ⟹ Nat.
//│ Typing error tree:
//│   Int ≤ {⊥ ≤ ⊤} ⟹ Nat
//│     Int ≤ Nat

:te
([Bot <:< Top] => Int) <:< Nat
//│ ═══[TYPE ERROR] Cannot solve judgment {⊥ ≤ ⊤} ⟹ Int ≤ Nat.
//│ Typing error tree:
//│   {⊥ ≤ ⊤} ⟹ Int ≤ Nat
//│     Int ≤ Nat

:te
([Top <:< Bot] => Int) <:< Int
//│ ═══[TYPE ERROR] Cannot solve judgment {⊤ ≤ ⊥} ⟹ Int ≤ Int.
//│ Typing error tree:
//│   {⊤ ≤ ⊥} ⟹ Int ≤ Int
//│     ⊤ ≤ ⊥

// Constrained types distributvity

Int <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ OK

Str <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ OK

(Int | Str) <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ OK

([A <:< Int] => Int) <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:65)
//│ ═══[TYPE ERROR] Cannot solve judgment {A ≤ Int} ⟹ Int ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str).
//│ Typing error tree:
//│   {A ≤ Int} ⟹ Int ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│     {A ≤ Int} ⟹ Int ≤ {A ≤ Int} ⟹ Int
//│       A ≤ Int
//│         ⊤ ≤ Int
//│     {A ≤ Int} ⟹ Int ≤ {A ≤ Str} ⟹ Str
//│       A ≤ Int
//│         ⊤ ≤ Int

:te
(Bool | Int | Str) <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ ═══[TYPE ERROR] Cannot solve judgment (Bool ∨ Int) ∨ Str ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str).
//│ Typing error tree:
//│   (Bool ∨ Int) ∨ Str ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│     Bool ∨ Int ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│       Bool ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│         Bool ≤ {A ≤ Int} ⟹ Int
//│           Bool ≤ Int
//│         Bool ≤ {A ≤ Str} ⟹ Str
//│           Bool ≤ Str

:te
([A <:< Int] => (Int | Str)) <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ ═══[TYPE ERROR] Cannot solve judgment {A ≤ Int} ⟹ Int ∨ Str ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str).
//│ Typing error tree:
//│   {A ≤ Int} ⟹ Int ∨ Str ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│     {A ≤ Int} ⟹ Int ∨ Str ≤ {A ≤ Int} ⟹ Int
//│       A ≤ Int
//│         ⊤ ≤ Int
//│     {A ≤ Int} ⟹ Int ∨ Str ≤ {A ≤ Str} ⟹ Str
//│       A ≤ Int
//│         ⊤ ≤ Int

// Opposite bounds

([A <:< Int] => Int) <:< ([A >:> Int] => Int)
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:65)
//│ ═══[TYPE ERROR] Cannot solve judgment {A ≤ Int} ⟹ Int ≤ {A ≥ Int} ⟹ Int.
//│ Typing error tree:
//│   {A ≤ Int} ⟹ Int ≤ {A ≥ Int} ⟹ Int
//│     A ≤ Int
//│       ⊤ ≤ Int

([A >:> Int] => Int) <:< ([A <:< Int] => Int)
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:65)
//│ ═══[TYPE ERROR] Cannot solve judgment {A ≥ Int} ⟹ Int ≤ {A ≤ Int} ⟹ Int.
//│ Typing error tree:
//│   {A ≥ Int} ⟹ Int ≤ {A ≤ Int} ⟹ Int
//│     Int ≤ A
//│       Int ≤ ⊥

// Distributvity across variables

type L = Int | Str
//│ L = Int ∨ Str
type R = (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ R = ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)

(Int | Str) <:< R
//│ OK

L <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ OK

L <:< R
//│ OK
