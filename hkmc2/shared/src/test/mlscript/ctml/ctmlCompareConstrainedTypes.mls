:ctml

([A] -> A -> A) == ([A] -> A -> A)
//│ OK
//│ 3 ≤ 2, 3 ≥ 2, 3 fresh, 2 rigid, 1 ≤ 0, 1 ≥ 0, 1 fresh, 0 rigid

([A] -> A -> A) <= (Int -> Int)
//│ OK
//│ 4 ≤ Int, 4 ≥ Int, 4 fresh

:e
(Int -> Int) <= ([A] -> A -> A)
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ ∀A. A → A.
//│ Typing error tree:
//│   Int → Int ≤ ∀A. A → A
//│     Int → Int ≤ 5 → 5
//│       5 ≤ Int
//│         ⊤ ≤ Int
//│           ⊤ ≤ ⊥

:e
([A extends Str] -> A -> A) <= (Int -> Int)
//│ ═══[ERROR] Cannot solve judgment ∀A. {A ≤ Str} ⟹ A → A ≤ Int → Int.
//│ Typing error tree:
//│   ∀A. {A ≤ Str} ⟹ A → A ≤ Int → Int
//│     {6 ≤ Str} ⟹ 6 → 6 ≤ Int → Int
//│       6 → 6 ≤ Int → Int
//│         Int ≤ 6
//│           Int ≤ Str
//│             Int ≤ ⊥
//│               ⊤ ≤ ⊥

// ([A extends Int restricts Str] -> A) <= Top
