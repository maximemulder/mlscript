:ctml

declare type A
declare type B
declare type C
declare type D

// Simple constrained types

Int <:< [Bot <:< Top] => Int
//│ OK

([Bot <:< Top] => Int) <:< Int
//│ OK

:te
Int <:< ([Bot <:< Top] => Nat)
//│ ═══[TYPE ERROR] Cannot solve judgment Int ≤ {⊥ ≤ ⊤} ⟹ Nat.
//│ Typing error tree:
//│   Int ≤ {⊥ ≤ ⊤} ⟹ Nat
//│     Int ≤ Nat

:te
([Top <:< Bot] => Int) <:< Int
//│ ═══[TYPE ERROR] Cannot solve judgment {⊤ ≤ ⊥} ⟹ Int ≤ Int.
//│ Typing error tree:
//│   {⊤ ≤ ⊥} ⟹ Int ≤ Int
//│     ⊤ ≤ ⊥

// Body covariance

([Bot <:< Top] => Nat) <:< ([Bot <:< Top] => Int)
//│ OK

:te
([Bot <:< Top] => Int) <:< Nat
//│ ═══[TYPE ERROR] Cannot solve judgment {⊥ ≤ ⊤} ⟹ Int ≤ Nat.
//│ Typing error tree:
//│   {⊥ ≤ ⊤} ⟹ Int ≤ Nat
//│     Int ≤ Nat

// Constraint contravariance

([A] -> A -> A) <:< ([A <:< Int] => A -> A)
//│ OK

:te
([A <:< Int] => A -> A) <:< ([A] -> A -> A)
//│ ═══[TYPE ERROR] Cannot solve judgment {A ≤ Int} ⟹ A → A ≤ ∀A. A → A.
//│ Typing error tree:
//│   {A ≤ Int} ⟹ A → A ≤ ∀A. A → A
//│     {A ≤ Int} ⟹ A → A ≤ α → α
//│       A → A ≤ α → α
//│         α ≤ A
//│           α ≤ Int
//│             ⊤ ≤ Int

// Body covariance and constraint contravariance

([A] -> Int -> Int) <:< ([A <:< Int] => A -> A)
//│ OK

([A <:< Int] => A -> A) <:< ([A] -> Int -> Int)
//│ OK

:te
([A <:< Int] => A -> A) <:< ([A] -> Int -> A)
//│ ═══[TYPE ERROR] Cannot solve judgment {A ≤ Int} ⟹ A → A ≤ ∀A. Int → A.
//│ Typing error tree:
//│   {A ≤ Int} ⟹ A → A ≤ ∀A. Int → A
//│     {A ≤ Int} ⟹ A → A ≤ Int → α
//│       A → A ≤ Int → α
//│         A ≤ α
//│           Int ≤ α
//│             Int ≤ ⊥

:te
([A <:< Int] => A -> A) <:< ([A] -> A -> Int)
//│ ═══[TYPE ERROR] Cannot solve judgment {A ≤ Int} ⟹ A → A ≤ ∀A. A → Int.
//│ Typing error tree:
//│   {A ≤ Int} ⟹ A → A ≤ ∀A. A → Int
//│     {A ≤ Int} ⟹ A → A ≤ α → Int
//│       A → A ≤ α → Int
//│         α ≤ A
//│           α ≤ Int
//│             ⊤ ≤ Int

// Distributvity

Int <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ OK

Str <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ OK

(Int | Str) <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ OK

([A >:> Int] => Int) <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ OK

:te
(Bool | Int | Str) <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ ═══[TYPE ERROR] Cannot solve judgment (Bool ∨ Int) ∨ Str ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str).
//│ Typing error tree:
//│   (Bool ∨ Int) ∨ Str ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│     Bool ∨ Int ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│       Bool ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│         Bool ≤ {A ≤ Int} ⟹ Int
//│           Bool ≤ Int
//│         Bool ≤ {A ≤ Str} ⟹ Str
//│           Bool ≤ Str

:te
([A >:> Int] => (Int | Str)) <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ ═══[TYPE ERROR] Cannot solve judgment {A ≥ Int} ⟹ Int ∨ Str ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str).
//│ Typing error tree:
//│   {A ≥ Int} ⟹ Int ∨ Str ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│     {A ≥ Int} ⟹ Int ∨ Str ≤ {A ≤ Int} ⟹ Int
//│       Int ∨ Str ≤ {A ≤ Int} ⟹ Int
//│         Str ≤ {A ≤ Int} ⟹ Int
//│           Str ≤ Int
//│     {A ≥ Int} ⟹ Int ∨ Str ≤ {A ≤ Str} ⟹ Str
//│       Int ∨ Str ≤ {A ≤ Str} ⟹ Str
//│         Int ≤ {A ≤ Str} ⟹ Str
//│           A ≤ Str
//│             Int ≤ Str

// Distributvity across variables

type L = Int | Str
//│ L = Int ∨ Str
type R = (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ R = ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)

(Int | Str) <:< R
//│ OK

L <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ OK

L <:< R
//│ OK
