:ctml

([A] -> A -> A) == ([A] -> A -> A)
//│ OK
//│ α ≤ β, α ≥ β, α fresh, β rigid, γ ≤ δ, γ ≥ δ, γ fresh, δ rigid

([A] -> A -> A) <= (Int -> Int)
//│ OK
//│ α ≤ Int, α ≥ Int, α fresh

:e
(Int -> Int) <= ([A] -> A -> A)
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ ∀A. A → A.
//│ Typing error tree:
//│   Int → Int ≤ ∀A. A → A
//│     Int → Int ≤ α → α
//│       α ≤ Int
//│         ⊤ ≤ Int
//│           ⊤ ≤ ⊥

:e
([A extends Str] -> A -> A) <= (Int -> Int)
//│ ═══[ERROR] Cannot solve judgment ∀A. {A ≤ Str} ⟹ A → A ≤ Int → Int.
//│ Typing error tree:
//│   ∀A. {A ≤ Str} ⟹ A → A ≤ Int → Int
//│     {α ≤ Str} ⟹ α → α ≤ Int → Int
//│       α → α ≤ Int → Int
//│         Int ≤ α
//│           Int ≤ Str
//│             Int ≤ ⊥
//│               ⊤ ≤ ⊥

// ([A extends Int restricts Str] -> A) <= Top
