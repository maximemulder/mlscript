:ctml

type A
type B
type C
type D

// Simple constrained types

Int <:< [Bot <:< Top] => Int
//│ OK

([Bot <:< Top] => Int) <:< Int
//│ OK

([Bot <:< Top] => Nat) <:< ([Bot <:< Top] => Int)
//│ OK

:te
Int <:< ([Bot <:< Top] => Nat)
//│ ═══[TYPE ERROR] Cannot solve judgment Int ≤ {⊥ ≤ ⊤} ⟹ Nat.
//│ Typing error tree:
//│   Int ≤ {⊥ ≤ ⊤} ⟹ Nat
//│     Int ≤ Nat

:te
([Bot <:< Top] => Int) <:< Nat
//│ ═══[TYPE ERROR] Cannot solve judgment {⊥ ≤ ⊤} ⟹ Int ≤ Nat.
//│ Typing error tree:
//│   {⊥ ≤ ⊤} ⟹ Int ≤ Nat
//│     Int ≤ Nat

:te
([Top <:< Bot] => Int) <:< Int
//│ ═══[TYPE ERROR] Cannot solve judgment {⊤ ≤ ⊥} ⟹ Int ≤ Int.
//│ Typing error tree:
//│   {⊤ ≤ ⊥} ⟹ Int ≤ Int
//│     ⊤ ≤ ⊥

// Constrained types distributvity

Int <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ OK

Str <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ OK

(Int | Str) <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ OK

([A <:< Int] => Int) <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ OK

:te
(Bool | Int | Str) <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ ═══[TYPE ERROR] Cannot solve judgment (Bool ∨ Int) ∨ Str ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str).
//│ Typing error tree:
//│   (Bool ∨ Int) ∨ Str ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│     Bool ∨ Int ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│       Bool ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│         Bool ≤ {A ≤ Int} ⟹ Int
//│           Bool ≤ Int
//│         Bool ≤ {A ≤ Str} ⟹ Str
//│           Bool ≤ Str

:te
([A <:< Int] => (Int | Str)) <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ ═══[TYPE ERROR] Cannot solve judgment {A ≤ Int} ⟹ Int ∨ Str ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str).
//│ Typing error tree:
//│   {A ≤ Int} ⟹ Int ∨ Str ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│     {A ≤ Int} ⟹ Int ∨ Str ≤ {A ≤ Int} ⟹ Int
//│       {A ≤ Int} ⟹ Int ∨ Str ≤ Int
//│         Int ∨ Str ≤ Int
//│           Str ≤ Int
//│     {A ≤ Int} ⟹ Int ∨ Str ≤ {A ≤ Str} ⟹ Str
//│       {A ≤ Int} ⟹ Int ∨ Str ≤ Str
//│         A ≤ Int
//│           Str ≤ Int
//│     ({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│       ({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int ≤ {A ≤ Int} ⟹ Int
//│         ({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int ≤ Int
//│           {A ≤ Int} ⟹ Int ∨ Str ≤ Int
//│             Int ∨ Str ≤ Int
//│               Str ≤ Int
//│           ¬Int ≤ Int
//│       ({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int ≤ {A ≤ Str} ⟹ Str
//│         ({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int ≤ Str
//│           {A ≤ Int} ⟹ Int ∨ Str ≤ Str
//│             A ≤ Int
//│               Str ≤ Int
//│           ¬Int ≤ Str
//│       (({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int) ∧ ¬Str ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│         (({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int) ∧ ¬Str ≤ {A ≤ Int} ⟹ Int
//│           (({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int) ∧ ¬Str ≤ Int
//│             ({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int ≤ Int
//│               {A ≤ Int} ⟹ Int ∨ Str ≤ Int
//│                 Int ∨ Str ≤ Int
//│                   Str ≤ Int
//│               ¬Int ≤ Int
//│             ¬Str ≤ Int
//│         (({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int) ∧ ¬Str ≤ {A ≤ Str} ⟹ Str
//│           (({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int) ∧ ¬Str ≤ Str
//│             ({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int ≤ Str
//│               {A ≤ Int} ⟹ Int ∨ Str ≤ Str
//│                 A ≤ Int
//│                   Str ≤ Int
//│               ¬Int ≤ Str
//│             ¬Str ≤ Str

// Opposite bounds

:te
([A <:< Int] => Int) <:< ([A >:> Int] => Int)
//│ ═══[TYPE ERROR] Cannot solve judgment {A ≤ Int} ⟹ Int ≤ {A ≥ Int} ⟹ Int.
//│ Typing error tree:
//│   {A ≤ Int} ⟹ Int ≤ {A ≥ Int} ⟹ Int
//│     {A ≤ Int} ⟹ Int ≤ Int
//│       A ≤ Int
//│         ⊤ ≤ Int

:te
([A >:> Int] => Int) <:< ([A <:< Int] => Int)
//│ ═══[TYPE ERROR] Cannot solve judgment {A ≥ Int} ⟹ Int ≤ {A ≤ Int} ⟹ Int.
//│ Typing error tree:
//│   {A ≥ Int} ⟹ Int ≤ {A ≤ Int} ⟹ Int
//│     {A ≥ Int} ⟹ Int ≤ Int
//│       Int ≤ A
//│         Int ≤ ⊥

// Distributvity across variables

type L = Int | Str
//│ L = Int ∨ Str
type R = (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ R = ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)

(Int | Str) <:< R
//│ OK

L <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ OK

L <:< R
//│ OK

// Constrained types and rigid variables

// The constraint of a right constrained type is assumed before a rigid variable on the left is
// replaced by its bound, or an operand of an intersection is chosen.

A <:< ([A <:< Int] => Int)
//│ OK

(A & B) <:< ([A <:< Int] => Int)
//│ OK

:te
A <:< ([B <:< Int] => Int)
//│ ═══[TYPE ERROR] Cannot solve judgment A ≤ {B ≤ Int} ⟹ Int.
//│ Typing error tree:
//│   A ≤ {B ≤ Int} ⟹ Int
//│     A ≤ Int
//│       ⊤ ≤ Int

// A constrained type is a subtype of itself under an intersection, without solving its constraint.

(([A <:< Int] => A) & B) <:< ([A <:< Int] => A)
//│ OK

:fixme // FIXME: A rigid variable on the right is replaced by its lower bound before the left constrained type is opened.
([A <:< Int] => A) <:< ([A <:< Nat] => A)
//│ ═══[TYPE ERROR] Cannot solve judgment {A ≤ Int} ⟹ A ≤ {A ≤ Nat} ⟹ A.
//│ Typing error tree:
//│   {A ≤ Int} ⟹ A ≤ {A ≤ Nat} ⟹ A
//│     {A ≤ Int} ⟹ A ≤ A
//│       {A ≤ Int} ⟹ A ≤ ⊥
//│         A ≤ ⊥
//│           Nat ≤ ⊥
