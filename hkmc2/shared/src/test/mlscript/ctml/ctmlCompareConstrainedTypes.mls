:ctml

type A
type B
type C
type D

// Simple constrained types

Int <:< [Bot <:< Top] => Int
//│ OK

([Bot <:< Top] => Int) <:< Int
//│ OK

([Bot <:< Top] => Nat) <:< ([Bot <:< Top] => Int)
//│ OK

:te
Int <:< ([Bot <:< Top] => Nat)
//│ ═══[TYPE ERROR] Cannot solve judgment Int ≤ {⊥ ≤ ⊤} ⟹ Nat.
//│ Typing error tree:
//│   Int ≤ {⊥ ≤ ⊤} ⟹ Nat
//│     Int ≤ Nat

:te
([Bot <:< Top] => Int) <:< Nat
//│ ═══[TYPE ERROR] Cannot solve judgment {⊥ ≤ ⊤} ⟹ Int ≤ Nat.
//│ Typing error tree:
//│   {⊥ ≤ ⊤} ⟹ Int ≤ Nat
//│     Int ≤ Nat

:te
([Top <:< Bot] => Int) <:< Int
//│ ═══[TYPE ERROR] Cannot solve judgment {⊤ ≤ ⊥} ⟹ Int ≤ Int.
//│ Typing error tree:
//│   {⊤ ≤ ⊥} ⟹ Int ≤ Int
//│     ⊤ ≤ ⊥

// A guarded result can span both alternatives of the target union.

([Int <:< (Int | Str)] => (Int | Str)) <:< (Int | Str)
//│ OK

:te
([Int <:< (Int | Str)] => (Int | Str)) <:< Int
//│ ═══[TYPE ERROR] Cannot solve judgment {Int ≤ Int ∨ Str} ⟹ Int ∨ Str ≤ Int.
//│ Typing error tree:
//│   {Int ≤ Int ∨ Str} ⟹ Int ∨ Str ≤ Int
//│     Int ∨ Str ≤ Int
//│       Str ≤ Int

:te
([Str <:< Int] => (Int | Str)) <:< (Int | Str)
//│ ═══[TYPE ERROR] Cannot solve judgment {Str ≤ Int} ⟹ Int ∨ Str ≤ Int ∨ Str.
//│ Typing error tree:
//│   {Str ≤ Int} ⟹ Int ∨ Str ≤ Int ∨ Str
//│     Str ≤ Int
//│     ⊤ ≤ Int ∨ Str
//│       ⊤ ≤ Int
//│       ⊤ ≤ Str
//│       ¬Int ≤ Int ∨ Str
//│         ¬Int ≤ Int
//│         ¬Int ≤ Str
//│         ¬Int ∧ ¬Str ≤ Int ∨ Str
//│           ¬Int ∧ ¬Str ≤ Int
//│             ¬Int ≤ Int
//│             ¬Str ≤ Int
//│           ¬Int ∧ ¬Str ≤ Str
//│             ¬Int ≤ Str
//│             ¬Str ≤ Str

// An applicable guard suffices in either intersection order.

type U = Int | Str
type GivenU = [Int <:< Int] => U
type UnavailableU = [Int <:< Str] => U
//│ U = Int ∨ Str
//│ GivenU = {Int ≤ Int} ⟹ U
//│ UnavailableU = {Int ≤ Str} ⟹ U

(GivenU & UnavailableU) <:< U
//│ OK

(UnavailableU & GivenU) <:< U
//│ OK

:te
(GivenU & UnavailableU) <:< Int
//│ ═══[TYPE ERROR] Cannot solve judgment GivenU ∧ UnavailableU ≤ Int.
//│ Typing error tree:
//│   GivenU ∧ UnavailableU ≤ Int
//│     GivenU ≤ Int
//│       {Int ≤ Int} ⟹ U ≤ Int
//│         U ≤ Int
//│           Int ∨ Str ≤ Int
//│             Str ≤ Int
//│     UnavailableU ≤ Int
//│       {Int ≤ Str} ⟹ U ≤ Int
//│         Int ≤ Str

// Both guarded operands contribute to the common result Bool.

(([Int <:< Int] => (Int | Bool)) & ([Int <:< Int] => (Str | Bool))) <:< (Bool | Nat)
//│ OK

:te
(([Int <:< Int] => (Int | Bool)) & ([Str <:< Int] => (Str | Bool))) <:< (Bool | Nat)
//│ ═══[TYPE ERROR] Cannot solve judgment ({Int ≤ Int} ⟹ Int ∨ Bool) ∧ ({Str ≤ Int} ⟹ Str ∨ Bool) ≤ Bool ∨ Nat.
//│ Typing error tree:
//│   ({Int ≤ Int} ⟹ Int ∨ Bool) ∧ ({Str ≤ Int} ⟹ Str ∨ Bool) ≤ Bool ∨ Nat
//│     (Int ∨ Bool) ∧ ({Str ≤ Int} ⟹ Str ∨ Bool) ≤ Bool ∨ Nat
//│       Int ∧ ({Str ≤ Int} ⟹ Str ∨ Bool) ≤ Bool ∨ Nat
//│         Str ≤ Int
//│         Int ≤ Bool ∨ Nat
//│           Int ≤ Bool
//│           Int ≤ Nat
//│           Int ∧ ¬Nat ≤ Bool ∨ Nat
//│             Int ∧ ¬Nat ≤ Bool
//│               Int ≤ Bool
//│               ¬Nat ≤ Bool
//│             Int ∧ ¬Nat ≤ Nat
//│               Int ≤ Nat
//│               ¬Nat ≤ Nat

// A target alternative can supply the assumption needed to open the source guard.

([A <:< Int] => Nat) <:< (([A <:< Nat] => Int) | Str)
//│ OK

// The assumption may also be inside an intersection in a target alternative.

type GuardedArm = Int & ([A <:< Nat] => Str)
//│ GuardedArm = Int ∧ ({A ≤ Nat} ⟹ Str)

(([A <:< Int] => Str) & Int) <:< (GuardedArm | Bool)
//│ OK

:fixme // FIXME: The field lookup loses the guarded refinement supplied by the other conjunct.
(([A <:< Int] => ({x: Str})) & {x: Top}) <:< ({x: ([A <:< Nat] => Str)})
//│ ═══[TYPE ERROR] Cannot solve judgment ({A ≤ Int} ⟹ {x: Str}) ∧ {x: ⊤} ≤ {x: {A ≤ Nat} ⟹ Str}.
//│ Typing error tree:
//│   ({A ≤ Int} ⟹ {x: Str}) ∧ {x: ⊤} ≤ {x: {A ≤ Nat} ⟹ Str}
//│     {A ≤ Int} ⟹ {x: Str} ≤ {x: {A ≤ Nat} ⟹ Str}
//│       A ≤ Int
//│         ⊤ ≤ Int
//│     {x: ⊤} ≤ {x: {A ≤ Nat} ⟹ Str}
//│       ⊤ ≤ {A ≤ Nat} ⟹ Str
//│         ⊤ ≤ Str

// Constrained types distributvity

Int <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ OK

Str <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ OK

(Int | Str) <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ OK

([A <:< Int] => Int) <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ OK

:te
(Bool | Int | Str) <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ ═══[TYPE ERROR] Cannot solve judgment (Bool ∨ Int) ∨ Str ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str).
//│ Typing error tree:
//│   (Bool ∨ Int) ∨ Str ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│     Bool ∨ Int ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│       Bool ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│         Bool ≤ {A ≤ Int} ⟹ Int
//│           Bool ≤ Int
//│         Bool ≤ {A ≤ Str} ⟹ Str
//│           Bool ≤ Str

:te
([A <:< Int] => (Int | Str)) <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ ═══[TYPE ERROR] Cannot solve judgment {A ≤ Int} ⟹ Int ∨ Str ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str).
//│ Typing error tree:
//│   {A ≤ Int} ⟹ Int ∨ Str ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│     {A ≤ Int} ⟹ Int ∨ Str ≤ {A ≤ Int} ⟹ Int
//│       {A ≤ Int} ⟹ Int ∨ Str ≤ Int
//│         Int ∨ Str ≤ Int
//│           Str ≤ Int
//│     {A ≤ Int} ⟹ Int ∨ Str ≤ {A ≤ Str} ⟹ Str
//│       {A ≤ Int} ⟹ Int ∨ Str ≤ Str
//│         A ≤ Int
//│           Str ≤ Int
//│     ({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│       ({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int ≤ {A ≤ Int} ⟹ Int
//│         ({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int ≤ Int
//│           {A ≤ Int} ⟹ Int ∨ Str ≤ Int
//│             Int ∨ Str ≤ Int
//│               Str ≤ Int
//│           ¬Int ≤ Int
//│       ({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int ≤ {A ≤ Str} ⟹ Str
//│         ({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int ≤ Str
//│           {A ≤ Int} ⟹ Int ∨ Str ≤ Str
//│             A ≤ Int
//│               Str ≤ Int
//│           ¬Int ≤ Str
//│       (({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int) ∧ ¬Str ≤ ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)
//│         (({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int) ∧ ¬Str ≤ {A ≤ Int} ⟹ Int
//│           (({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int) ∧ ¬Str ≤ Int
//│             ({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int ≤ Int
//│               {A ≤ Int} ⟹ Int ∨ Str ≤ Int
//│                 Int ∨ Str ≤ Int
//│                   Str ≤ Int
//│               ¬Int ≤ Int
//│             ¬Str ≤ Int
//│         (({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int) ∧ ¬Str ≤ {A ≤ Str} ⟹ Str
//│           (({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int) ∧ ¬Str ≤ Str
//│             ({A ≤ Int} ⟹ Int ∨ Str) ∧ ¬Int ≤ Str
//│               {A ≤ Int} ⟹ Int ∨ Str ≤ Str
//│                 A ≤ Int
//│                   Str ≤ Int
//│               ¬Int ≤ Str
//│             ¬Str ≤ Str

// Opposite bounds

:te
([A <:< Int] => Int) <:< ([A >:> Int] => Int)
//│ ═══[TYPE ERROR] Cannot solve judgment {A ≤ Int} ⟹ Int ≤ {A ≥ Int} ⟹ Int.
//│ Typing error tree:
//│   {A ≤ Int} ⟹ Int ≤ {A ≥ Int} ⟹ Int
//│     {A ≤ Int} ⟹ Int ≤ Int
//│       A ≤ Int
//│         ⊤ ≤ Int

:te
([A >:> Int] => Int) <:< ([A <:< Int] => Int)
//│ ═══[TYPE ERROR] Cannot solve judgment {A ≥ Int} ⟹ Int ≤ {A ≤ Int} ⟹ Int.
//│ Typing error tree:
//│   {A ≥ Int} ⟹ Int ≤ {A ≤ Int} ⟹ Int
//│     {A ≥ Int} ⟹ Int ≤ Int
//│       Int ≤ A
//│         Int ≤ ⊥

// Distributvity across variables

type L = Int | Str
//│ L = Int ∨ Str
type R = (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ R = ({A ≤ Int} ⟹ Int) ∨ ({A ≤ Str} ⟹ Str)

(Int | Str) <:< R
//│ OK

L <:< (([A <:< Int] => Int) | ([A <:< Str] => Str))
//│ OK

L <:< R
//│ OK

// Constrained types and rigid variables

// The constraint of a right constrained type is assumed before a rigid variable on the left is
// replaced by its bound, or an operand of an intersection is chosen.

A <:< ([A <:< Int] => Int)
//│ OK

(A & B) <:< ([A <:< Int] => Int)
//│ OK

:te
A <:< ([B <:< Int] => Int)
//│ ═══[TYPE ERROR] Cannot solve judgment A ≤ {B ≤ Int} ⟹ Int.
//│ Typing error tree:
//│   A ≤ {B ≤ Int} ⟹ Int
//│     A ≤ Int
//│       ⊤ ≤ Int

// A constrained type is a subtype of itself under an intersection, without solving its constraint.

(([A <:< Int] => A) & B) <:< ([A <:< Int] => A)
//│ OK

// The right guard implies the left guard, and both bodies name the same rigid variable.
([A <:< Int] => A) <:< ([A <:< Nat] => A)
//│ OK

// A guard containing a constrained type is still required when the body alone matches.

:te
([([Int <:< Int] => Int) <:< Str] => Int) <:< Int
//│ ═══[TYPE ERROR] Cannot solve judgment {{Int ≤ Int} ⟹ Int ≤ Str} ⟹ Int ≤ Int.
//│ Typing error tree:
//│   {{Int ≤ Int} ⟹ Int ≤ Str} ⟹ Int ≤ Int
//│     {Int ≤ Int} ⟹ Int ≤ Str
//│       Int ≤ Str
