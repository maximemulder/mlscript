:ctml

// Top and bottom types


Bot == ~Top
//│ OK

Top == ~Bot
//│ OK

// Single class

class A

(~A & A) == Bot
//│ OK

(A & ~A) == Bot
//│ OK

(~A | A) == Top
//│ OK

(A | ~A) == Top
//│ OK

// Disjoint classes

class A
class B

A <= ~B
//│ OK

(~A & B) == B
//│ OK

(~A | B) == ~A
//│ OK

~(A & B) == (~A | ~B)
//│ OK

~(A | B) == (~A & ~B)
//│ OK

(~B & (A | B)) == A
//│ OK

(~B | (A & B)) == ~B
//│ OK

:te
~A <= B
//│ ═══[TYPE ERROR] Cannot solve judgment ¬A ≤ B.
//│ Typing error tree:
//│   ¬A ≤ B

// Inherited classes

(~Nat & Int) <= Int
//│ OK

(~Int & Nat) == Bot
//│ OK

(Nat & ~Int) == Bot
//│ OK

(~Nat | Int) == Top
//│ OK

(Int | ~Nat) == Top
//│ OK

Nat <= (~Int | Nat)
//│ OK

:te
Int <= (~Nat & Int)
//│ ═══[TYPE ERROR] Cannot solve judgment Int ≤ ¬Nat ∧ Int.
//│ Typing error tree:
//│   Int ≤ ¬Nat ∧ Int
//│     Int ≤ ¬Nat

:te
Nat <= (~Nat & Int)
//│ ═══[TYPE ERROR] Cannot solve judgment Nat ≤ ¬Nat ∧ Int.
//│ Typing error tree:
//│   Nat ≤ ¬Nat ∧ Int
//│     Nat ≤ ¬Nat

:te
(~Int | Nat) <= Nat
//│ ═══[TYPE ERROR] Cannot solve judgment ¬Int ∨ Nat ≤ Nat.
//│ Typing error tree:
//│   ¬Int ∨ Nat ≤ Nat
//│     ¬Int ≤ Nat

:te
(~Int | Nat) <= Int
//│ ═══[TYPE ERROR] Cannot solve judgment ¬Int ∨ Nat ≤ Int.
//│ Typing error tree:
//│   ¬Int ∨ Nat ≤ Int
//│     ¬Int ≤ Int
