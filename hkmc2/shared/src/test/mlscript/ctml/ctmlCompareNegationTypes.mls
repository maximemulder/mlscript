:ctml

// Top and bottom types


Bot == ~Top
//│ OK

Top == ~Bot
//│ OK

// Single class

class A

(~A & A) == Bot
//│ OK

(A & ~A) == Bot
//│ OK

(~A | A) == Top
//│ OK

(A | ~A) == Top
//│ OK

// Disjoint classes

class A
class B

A <= ~B
//│ OK

:e
~A <= B
//│ ═══[ERROR] Cannot solve judgment ¬A ≤ B.
//│ Typing error tree:
//│   ¬A ≤ B

// Inherited classes

(~Nat & Int) <= Int
//│ OK

(~Int & Nat) == Bot
//│ OK

(~Nat | Int) == Top
//│ OK

Nat <= (~Int | Nat)
//│ OK

:e
Int <= (~Nat & Int)
//│ ═══[ERROR] Cannot solve judgment Int ≤ ¬Nat ∧ Int.
//│ Typing error tree:
//│   Int ≤ ¬Nat ∧ Int
//│     Int ≤ ¬Nat

:e
Nat <= (~Nat & Int)
//│ ═══[ERROR] Cannot solve judgment Nat ≤ ¬Nat ∧ Int.
//│ Typing error tree:
//│   Nat ≤ ¬Nat ∧ Int
//│     Nat ≤ ¬Nat

:e
(~Int | Nat) <= Nat
//│ ═══[ERROR] Cannot solve judgment ¬Int ∨ Nat ≤ Nat.
//│ Typing error tree:
//│   ¬Int ∨ Nat ≤ Nat
//│     ¬Int ≤ Nat

:e
(~Int | Nat) <= Int
//│ ═══[ERROR] Cannot solve judgment ¬Int ∨ Nat ≤ Int.
//│ Typing error tree:
//│   ¬Int ∨ Nat ≤ Int
//│     ¬Int ≤ Int
