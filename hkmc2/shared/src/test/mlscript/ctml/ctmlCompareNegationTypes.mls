:ctml

// Top and bottom types


Bot == ~Top
//│ OK

Top == ~Bot
//│ OK

// Single class

class A

(~A & A) == Bot
//│ OK

(A & ~A) == Bot
//│ OK

(~A | A) == Top
//│ OK

(A | ~A) == Top
//│ OK

// Disjoint classes

class A
class B

A <:< ~B
//│ OK

(~A & B) == B
//│ OK

(~A | B) == ~A
//│ OK

~(A & B) == (~A | ~B)
//│ OK

~(A | B) == (~A & ~B)
//│ OK

(~B & (A | B)) == A
//│ OK

(~B | (A & B)) == ~B
//│ OK

// Excluded middle under intersections

Top <:< ((A | ~A) & (B | ~B))
//│ OK

Top <:< ~((A & ~A) | (B & ~B))
//│ OK

:te
~A <:< B
//│ ═══[TYPE ERROR] Cannot solve judgment ¬A ≤ B.
//│ Typing error tree:
//│   ¬A ≤ B

// Inherited classes

(~Nat & Int) <:< Int
//│ OK

(~Int & Nat) == Bot
//│ OK

(Nat & ~Int) == Bot
//│ OK

(~Nat | Int) == Top
//│ OK

(Int | ~Nat) == Top
//│ OK

:te
Nat <:< ~Int
//│ ═══[TYPE ERROR] Cannot solve judgment Nat ≤ ¬Int.
//│ Typing error tree:
//│   Nat ≤ ¬Int

Nat <:< (~Int | Nat)
//│ OK

:te
Int <:< (~Nat & Int)
//│ ═══[TYPE ERROR] Cannot solve judgment Int ≤ ¬Nat ∧ Int.
//│ Typing error tree:
//│   Int ≤ ¬Nat ∧ Int
//│     Int ≤ ¬Nat

:te
Nat <:< (~Nat & Int)
//│ ═══[TYPE ERROR] Cannot solve judgment Nat ≤ ¬Nat ∧ Int.
//│ Typing error tree:
//│   Nat ≤ ¬Nat ∧ Int
//│     Nat ≤ ¬Nat

:te
(~Int | Nat) <:< Nat
//│ ═══[TYPE ERROR] Cannot solve judgment ¬Int ∨ Nat ≤ Nat.
//│ Typing error tree:
//│   ¬Int ∨ Nat ≤ Nat
//│     ¬Int ≤ Nat

:te
(~Int | Nat) <:< Int
//│ ═══[TYPE ERROR] Cannot solve judgment ¬Int ∨ Nat ≤ Int.
//│ Typing error tree:
//│   ¬Int ∨ Nat ≤ Int
//│     ¬Int ≤ Int

// Negated binder types

type T

// Constraining types, encoded as negated constrained types

Int <:< ~([Bot <:< Int] => ~Int)
//│ OK

:te
Int <:< ~([T <:< Int] => ~Int)
//│ ═══[TYPE ERROR] Cannot solve judgment Int ≤ ¬({T ≤ Int} ⟹ ¬Int).
//│ Typing error tree:
//│   Int ≤ ¬({T ≤ Int} ⟹ ¬Int)
//│     {T ≤ Int} ⟹ ¬Int ≤ ¬Int
//│       T ≤ Int
//│         ⊤ ≤ Int

~([T <:< Int] => ~Int) <:< Int
//│ OK

:te
~([T <:< Int] => ~Int) <:< Str
//│ ═══[TYPE ERROR] Cannot solve judgment ¬({T ≤ Int} ⟹ ¬Int) ≤ Str.
//│ Typing error tree:
//│   ¬({T ≤ Int} ⟹ ¬Int) ≤ Str
//│     ¬Str ≤ {T ≤ Int} ⟹ ¬Int
//│       ¬Str ≤ ¬Int
//│         Int ≤ Str

~([T <:< Int] => ~Nat) <:< ~([T <:< Int] => ~Int)
//│ OK

~([T <:< Nat] => ~Int) <:< ~([T <:< Int] => ~Int)
//│ OK

:te
~([T <:< Int] => ~Int) <:< ~([T <:< Nat] => ~Int)
//│ ═══[TYPE ERROR] Cannot solve judgment ¬({T ≤ Int} ⟹ ¬Int) ≤ ¬({T ≤ Nat} ⟹ ¬Int).
//│ Typing error tree:
//│   ¬({T ≤ Int} ⟹ ¬Int) ≤ ¬({T ≤ Nat} ⟹ ¬Int)
//│     {T ≤ Nat} ⟹ ¬Int ≤ {T ≤ Int} ⟹ ¬Int
//│       {T ≤ Nat} ⟹ ¬Int ≤ ¬Int
//│         T ≤ Nat
//│           Int ≤ Nat

// Constraining types against constrained types

~([T <:< Int] => ~Int) <:< ([Bot <:< Top] => Int)
//│ OK

:te
([Bot <:< Top] => Int) <:< ~([T <:< Int] => ~Int)
//│ ═══[TYPE ERROR] Cannot solve judgment {⊥ ≤ ⊤} ⟹ Int ≤ ¬({T ≤ Int} ⟹ ¬Int).
//│ Typing error tree:
//│   {⊥ ≤ ⊤} ⟹ Int ≤ ¬({T ≤ Int} ⟹ ¬Int)
//│     Int ≤ ¬({T ≤ Int} ⟹ ¬Int)
//│       {T ≤ Int} ⟹ ¬Int ≤ ¬Int
//│         T ≤ Int
//│           ⊤ ≤ Int

// Negated universal types

Top <:< ~([X] -> X)
//│ OK

Int <:< ~([X] -> X -> X)
//│ OK

:te
~([X] -> X -> X) <:< (Int -> Int)
//│ ═══[TYPE ERROR] Cannot solve judgment ¬(∀X. X → X) ≤ Int → Int.
//│ Typing error tree:
//│   ¬(∀X. X → X) ≤ Int → Int
//│     ¬(Int → Int) ≤ ∀X. X → X
//│       ¬(Int → Int) ≤ α → α

// Negated flexible variables

declare type Y1
declare type Y2
declare type Y3
declare type Y4
declare type Y5

~Y1 <:< Int
//│ OK

Int <:< ~Y2
//│ OK

~([Bot <:< Top] => Bot) <:< Y3
//│ OK

(~Y4 -> ~Y4) <:< (Int -> Int)
//│ OK

:te
(~Y5 -> ~Y5) <:< (Int -> Str)
//│ ═══[TYPE ERROR] Cannot solve judgment ¬Y5 → ¬Y5 ≤ Int → Str.
//│ Typing error tree:
//│   ¬Y5 → ¬Y5 ≤ Int → Str
//│     ¬Y5 ≤ Str
//│       ¬Str ≤ Y5
//│         ¬Str ≤ ¬Int
//│           Int ≤ Str

// Complement on the decided fragment

// Excluded middle and non-contradiction only apply to closed Boolean combinations of classes,
// which the shape of every value decides (see `isDecided`).

Top <:< ((A | B) | ~A)
//│ OK

(~(A | B) & A) <:< Bot
//│ OK

// The negated operand is matched syntactically against the other operand of the union.

:te
Top <:< (A | (B | ~A))
//│ ═══[TYPE ERROR] Cannot solve judgment ⊤ ≤ A ∨ B ∨ ¬A.
//│ Typing error tree:
//│   ⊤ ≤ A ∨ B ∨ ¬A
//│     ⊤ ≤ A
//│     ⊤ ≤ B ∨ ¬A
//│       ⊤ ≤ B
//│       ⊤ ≤ ¬A

:te
Top <:< ((Int -> Int) | ~(Int -> Int))
//│ ═══[TYPE ERROR] Cannot solve judgment ⊤ ≤ (Int → Int) ∨ ¬(Int → Int).
//│ Typing error tree:
//│   ⊤ ≤ (Int → Int) ∨ ¬(Int → Int)
//│     ⊤ ≤ Int → Int
//│     ⊤ ≤ ¬(Int → Int)

:te
((Int -> Int) & ~(Int -> Int)) <:< Bot
//│ ═══[TYPE ERROR] Cannot solve judgment (Int → Int) ∧ ¬(Int → Int) ≤ ⊥.
//│ Typing error tree:
//│   (Int → Int) ∧ ¬(Int → Int) ≤ ⊥
//│     Int → Int ≤ ⊥
//│     ¬(Int → Int) ≤ ⊥

:te
Top <:< (T | ~T)
//│ ═══[TYPE ERROR] Cannot solve judgment ⊤ ≤ T ∨ ¬T.
//│ Typing error tree:
//│   ⊤ ≤ T ∨ ¬T
//│     ⊤ ≤ T
//│       ⊤ ≤ ⊥
//│     ⊤ ≤ ¬T

:te
(T & ~T) <:< Bot
//│ ═══[TYPE ERROR] Cannot solve judgment T ∧ ¬T ≤ ⊥.
//│ Typing error tree:
//│   T ∧ ¬T ≤ ⊥
//│     T ≤ ⊥
//│       ⊤ ≤ ⊥
//│     ¬T ≤ ⊥

:te
Top <:< (([T <:< Int] => ~Int) | ~([T <:< Int] => ~Int))
//│ ═══[TYPE ERROR] Cannot solve judgment ⊤ ≤ ({T ≤ Int} ⟹ ¬Int) ∨ ¬({T ≤ Int} ⟹ ¬Int).
//│ Typing error tree:
//│   ⊤ ≤ ({T ≤ Int} ⟹ ¬Int) ∨ ¬({T ≤ Int} ⟹ ¬Int)
//│     ⊤ ≤ {T ≤ Int} ⟹ ¬Int
//│       ⊤ ≤ ¬Int
//│     ⊤ ≤ ¬({T ≤ Int} ⟹ ¬Int)
//│       {T ≤ Int} ⟹ ¬Int ≤ ⊥
//│         T ≤ Int
//│           ⊤ ≤ Int

// Functions are typed at the negation of every class, so that excluded middle at a class is
// preserved through the distribution of lambda types over their parameters.

((Int -> Str) & (~Int -> Str)) <:< (Top -> Str)
//│ OK

:te
(((Int -> Int) -> Str) & (~(Int -> Int) -> Str)) <:< (Top -> Str)
//│ ═══[TYPE ERROR] Cannot solve judgment ((Int → Int) → Str) ∧ (¬(Int → Int) → Str) ≤ ⊤ → Str.
//│ Typing error tree:
//│   ((Int → Int) → Str) ∧ (¬(Int → Int) → Str) ≤ ⊤ → Str
//│     ((Int → Int) ∨ ¬(Int → Int)) → Str ≤ ⊤ → Str
//│       ⊤ ≤ (Int → Int) ∨ ¬(Int → Int)
//│         ⊤ ≤ Int → Int
//│         ⊤ ≤ ¬(Int → Int)

// The general complement applies excluded middle and non-contradiction to every type, which is
// sound for the safety of programs but not for the preservation of types (see `admitsComplement`).

:ctml-cfg general-complement

Top <:< ((Int -> Int) | ~(Int -> Int))
//│ OK

((Int -> Int) & ~(Int -> Int)) <:< Bot
//│ OK

Top <:< (T | ~T)
//│ OK

Top <:< (([T <:< Int] => ~Int) | ~([T <:< Int] => ~Int))
//│ OK

(((Int -> Int) -> Str) & (~(Int -> Int) -> Str)) <:< (Top -> Str)
//│ OK
