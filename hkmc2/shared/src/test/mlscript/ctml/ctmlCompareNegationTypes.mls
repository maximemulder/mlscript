:ctml

// Top and bottom types


Bot == ~Top
//│ OK

Top == ~Bot
//│ OK

// Single class

class A

(~A & A) == Bot
//│ OK

(A & ~A) == Bot
//│ OK

(~A | A) == Top
//│ OK

(A | ~A) == Top
//│ OK

// Disjoint classes

class A
class B

A :<: ~B
//│ FAILURE: Unexpected compilation error
//│ FAILURE LOCATION: subterm (Elaborator.scala:515)
//│ ╔══[COMPILATION ERROR] Name not found: :<:
//│ ║  l.33: 	A :<: ~B
//│ ╙──      	  ^^^
//│ FAILURE: Unexpected parse error
//│ FAILURE LOCATION: raise (test.scala:57)
//│ ═══[PARSE ERROR] Unsupported CTML term: Error

(~A & B) == B
//│ OK

(~A | B) == ~A
//│ OK

~(A & B) == (~A | ~B)
//│ OK

~(A | B) == (~A & ~B)
//│ OK

(~B & (A | B)) == A
//│ OK

(~B | (A & B)) == ~B
//│ OK

:te
~A :<: B
