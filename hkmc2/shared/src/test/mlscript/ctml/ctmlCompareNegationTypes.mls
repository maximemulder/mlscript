:ctml

// Top and bottom types


Bot == ~Top
//│ OK

Top == ~Bot
//│ OK

// Single class

class A

(~A & A) == Bot
//│ OK

(A & ~A) == Bot
//│ OK

(~A | A) == Top
//│ OK

(A | ~A) == Top
//│ OK

// Disjoint classes

class A
class B

A <:< ~B
//│ OK

(~A & B) == B
//│ OK

(~A | B) == ~A
//│ OK

~(A & B) == (~A | ~B)
//│ OK

~(A | B) == (~A & ~B)
//│ OK

(~B & (A | B)) == A
//│ OK

(~B | (A & B)) == ~B
//│ OK

// Excluded middle under intersections

Top <:< ((A | ~A) & (B | ~B))
//│ OK

Top <:< ~((A & ~A) | (B & ~B))
//│ OK

:te
~A <:< B
//│ ═══[TYPE ERROR] Cannot solve judgment ¬A ≤ B.
//│ Typing error tree:
//│   ¬A ≤ B

// Inherited classes

(~Nat & Int) <:< Int
//│ OK

(~Int & Nat) == Bot
//│ OK

(Nat & ~Int) == Bot
//│ OK

(~Nat | Int) == Top
//│ OK

(Int | ~Nat) == Top
//│ OK

:te
Nat <:< ~Int
//│ ═══[TYPE ERROR] Cannot solve judgment Nat ≤ ¬Int.
//│ Typing error tree:
//│   Nat ≤ ¬Int

Nat <:< (~Int | Nat)
//│ OK

:te
Int <:< (~Nat & Int)
//│ ═══[TYPE ERROR] Cannot solve judgment Int ≤ ¬Nat ∧ Int.
//│ Typing error tree:
//│   Int ≤ ¬Nat ∧ Int
//│     Int ≤ ¬Nat

:te
Nat <:< (~Nat & Int)
//│ ═══[TYPE ERROR] Cannot solve judgment Nat ≤ ¬Nat ∧ Int.
//│ Typing error tree:
//│   Nat ≤ ¬Nat ∧ Int
//│     Nat ≤ ¬Nat

:te
(~Int | Nat) <:< Nat
//│ ═══[TYPE ERROR] Cannot solve judgment ¬Int ∨ Nat ≤ Nat.
//│ Typing error tree:
//│   ¬Int ∨ Nat ≤ Nat
//│     ¬Int ≤ Nat

:te
(~Int | Nat) <:< Int
//│ ═══[TYPE ERROR] Cannot solve judgment ¬Int ∨ Nat ≤ Int.
//│ Typing error tree:
//│   ¬Int ∨ Nat ≤ Int
//│     ¬Int ≤ Int

// A class is the union of a subclass and of its difference with the subclass, which is derived by
// cases on the subclass (see `subtypeCases`).

Int <:< (Nat | (Int & ~Nat))
//│ OK

(Nat | (Int & ~Nat)) <:< Int
//│ OK

// Negated binder types

type T

// Constraining types, encoded as negated constrained types

Int <:< ~([Bot <:< Int] => ~Int)
//│ OK

:te
Int <:< ~([T <:< Int] => ~Int)
//│ ═══[TYPE ERROR] Cannot solve judgment Int ≤ ¬({T ≤ Int} ⟹ ¬Int).
//│ Typing error tree:
//│   Int ≤ ¬({T ≤ Int} ⟹ ¬Int)
//│     T ≤ Int
//│       ⊤ ≤ Int

~([T <:< Int] => ~Int) <:< Int
//│ OK

:te
~([T <:< Int] => ~Int) <:< Str
//│ ═══[TYPE ERROR] Cannot solve judgment ¬({T ≤ Int} ⟹ ¬Int) ≤ Str.
//│ Typing error tree:
//│   ¬({T ≤ Int} ⟹ ¬Int) ≤ Str
//│     ¬Str ≤ {T ≤ Int} ⟹ ¬Int
//│       ¬Str ≤ ¬Int
//│         Int ≤ Str

~([T <:< Int] => ~Nat) <:< ~([T <:< Int] => ~Int)
//│ OK

~([T <:< Nat] => ~Int) <:< ~([T <:< Int] => ~Int)
//│ OK

:te
~([T <:< Int] => ~Int) <:< ~([T <:< Nat] => ~Int)
//│ ═══[TYPE ERROR] Cannot solve judgment ¬({T ≤ Int} ⟹ ¬Int) ≤ ¬({T ≤ Nat} ⟹ ¬Int).
//│ Typing error tree:
//│   ¬({T ≤ Int} ⟹ ¬Int) ≤ ¬({T ≤ Nat} ⟹ ¬Int)
//│     {T ≤ Nat} ⟹ ¬Int ≤ {T ≤ Int} ⟹ ¬Int
//│       {T ≤ Nat} ⟹ ¬Int ≤ ¬Int
//│         T ≤ Nat
//│           Int ≤ Nat

// Constraining types against constrained types

~([T <:< Int] => ~Int) <:< ([Bot <:< Top] => Int)
//│ OK

:te
([Bot <:< Top] => Int) <:< ~([T <:< Int] => ~Int)
//│ ═══[TYPE ERROR] Cannot solve judgment {⊥ ≤ ⊤} ⟹ Int ≤ ¬({T ≤ Int} ⟹ ¬Int).
//│ Typing error tree:
//│   {⊥ ≤ ⊤} ⟹ Int ≤ ¬({T ≤ Int} ⟹ ¬Int)
//│     Int ≤ ¬({T ≤ Int} ⟹ ¬Int)
//│       T ≤ Int
//│         ⊤ ≤ Int

// Negated universal types

Top <:< ~([X] -> X)
//│ OK

Int <:< ~([X] -> X -> X)
//│ OK

:te
~([X] -> X -> X) <:< (Int -> Int)
//│ ═══[TYPE ERROR] Cannot solve judgment ¬(∀X. X → X) ≤ Int → Int.
//│ Typing error tree:
//│   ¬(∀X. X → X) ≤ Int → Int
//│     ¬(Int → Int) ≤ ∀X. X → X
//│       ¬(Int → Int) ≤ α → α

// Negated flexible variables

declare type Y1
declare type Y2
declare type Y3
declare type Y4
declare type Y5

~Y1 <:< Int
//│ OK

Int <:< ~Y2
//│ OK

~([Bot <:< Top] => Bot) <:< Y3
//│ OK

(~Y4 -> ~Y4) <:< (Int -> Int)
//│ OK

:te
(~Y5 -> ~Y5) <:< (Int -> Str)
//│ ═══[TYPE ERROR] Cannot solve judgment ¬Y5 → ¬Y5 ≤ Int → Str.
//│ Typing error tree:
//│   ¬Y5 → ¬Y5 ≤ Int → Str
//│     ¬Y5 ≤ Str
//│       ¬Str ≤ Y5
//│         ¬Str ≤ ¬Int
//│           Int ≤ Str

// Complement

// Excluded middle and non-contradiction apply to every type (see the complement rules in
// `negation.scala`).

Top <:< ((A | B) | ~A)
//│ OK

(~(A | B) & A) <:< Bot
//│ OK

// The negated operand need not be an operand of the union itself, since the judgment is derived by
// cases on the class (see `subtypeCases`).

Top <:< (A | (B | ~A))
//│ OK

// Function types, rigid variables, and constrained types.

Top <:< ((Int -> Int) | ~(Int -> Int))
//│ OK

((Int -> Int) & ~(Int -> Int)) <:< Bot
//│ OK

Top <:< (T | ~T)
//│ OK

(T & ~T) <:< Bot
//│ OK

Top <:< (([T <:< Int] => ~Int) | ~([T <:< Int] => ~Int))
//│ OK

// A judgment also holds by atoms that are not operands of the same joint type, by reflexivity, by
// the complement rules, or by disjoint constructors (see `holdsByAtoms`).

Top <:< (T | (Int | ~T))
//│ OK

Top <:< ((Int -> Int) | (Str | ~(Int -> Int)))
//│ OK

(A & (T & ~A)) <:< Bot
//│ OK

(T & (Int & ~T)) <:< Bot
//│ OK

(Int & (T & Str)) <:< Bot
//│ OK

((Int & T) & Str) <:< Bot
//│ OK

Top <:< (~Int | (T | ~Str))
//│ OK

:te
Top <:< (T | (Int | ~Str))
//│ ═══[TYPE ERROR] Cannot solve judgment ⊤ ≤ T ∨ Int ∨ ¬Str.
//│ Typing error tree:
//│   ⊤ ≤ T ∨ Int ∨ ¬Str
//│     ⊤ ≤ T
//│       ⊤ ≤ ⊥
//│     ⊤ ≤ Int ∨ ¬Str
//│       ⊤ ≤ Int
//│       ⊤ ≤ ¬Str
//│       ¬Int ≤ Int ∨ ¬Str
//│         ¬Int ≤ Int
//│         ¬Int ≤ ¬Str
//│           Str ≤ Int
//│         Str ≤ Int ∨ ¬Str
//│           Str ≤ Int
//│           Str ≤ ¬Str
//│     ¬Int ≤ T ∨ Int ∨ ¬Str
//│       ¬Int ≤ T
//│         ¬Int ≤ ⊥
//│       ¬Int ≤ Int ∨ ¬Str
//│         ¬Int ≤ Int
//│         ¬Int ≤ ¬Str
//│           Str ≤ Int
//│         Str ≤ Int ∨ ¬Str
//│           Str ≤ Int
//│           Str ≤ ¬Str
//│       Str ≤ T ∨ Int ∨ ¬Str
//│         Str ≤ T
//│           Str ≤ ⊥
//│         Str ≤ Int ∨ ¬Str
//│           Str ≤ Int
//│           Str ≤ ¬Str

// A function that accepts both a type and its negation accepts every value, by the distribution of
// lambda types over the unions of their parameter (see `meetLambdas`).

((Int -> Str) & (~Int -> Str)) <:< (Top -> Str)
//│ OK

(((Int -> Int) -> Str) & (~(Int -> Int) -> Str)) <:< (Top -> Str)
//│ OK
