:ctml

class A
class B

// Top and bottom types.

Bot == Bot
//│ OK

Top == Top
//│ OK

Bot <= Top
//│ OK

:e
Top <= Bot
//│ ═══[ERROR] Cannot solve judgment ⊤ ≤ ⊥.
//│ Typing error tree:
//│   ⊤ ≤ ⊥

// Rigid type variables.

A == A
//│ OK

A <= Top
//│ OK

Bot <= A
//│ OK

:fixme
(Int & Str) == Bot
//│ ═══[ERROR] Cannot solve judgment Int ∧ Str ≡ ⊥.
//│ Typing error tree:
//│   Int ∧ Str ≡ ⊥
//│     Int ∧ Str ≤ ⊥
//│       Int ≤ ⊥
//│       Str ≤ ⊥

:e
Top <= A
//│ ═══[ERROR] Cannot solve judgment ⊤ ≤ A.
//│ Typing error tree:
//│   ⊤ ≤ A

:e
A <= Bot
//│ ═══[ERROR] Cannot solve judgment A ≤ ⊥.
//│ Typing error tree:
//│   A ≤ ⊥

:e
A == B
//│ ═══[ERROR] Cannot solve judgment A ≡ B.
//│ Typing error tree:
//│   A ≡ B
//│     A ≤ B

// Lambda types.

(Top -> Bot) <= (A -> Bot)
//│ OK

(Top -> Bot) <= (Top -> A)
//│ OK

(A -> Top) <= (Bot -> Top)
//│ OK

(Bot -> A) <= (Bot -> Top)
//│ OK

:e
(A -> Bot) <= (Top -> Bot)
//│ ═══[ERROR] Cannot solve judgment A → ⊥ ≤ ⊤ → ⊥.
//│ Typing error tree:
//│   A → ⊥ ≤ ⊤ → ⊥
//│     ⊤ ≤ A

:e
(Top -> A) <= (Top -> Bot)
//│ ═══[ERROR] Cannot solve judgment ⊤ → A ≤ ⊤ → ⊥.
//│ Typing error tree:
//│   ⊤ → A ≤ ⊤ → ⊥
//│     A ≤ ⊥

:e
(Bot -> Top) <= (A -> Top)
//│ ═══[ERROR] Cannot solve judgment ⊥ → ⊤ ≤ A → ⊤.
//│ Typing error tree:
//│   ⊥ → ⊤ ≤ A → ⊤
//│     A ≤ ⊥

:e
(Bot -> Top) <= (Bot -> A)
//│ ═══[ERROR] Cannot solve judgment ⊥ → ⊤ ≤ ⊥ → A.
//│ Typing error tree:
//│   ⊥ → ⊤ ≤ ⊥ → A
//│     ⊤ ≤ A
