:ctml

class A
class B

// Top and bottom types.

Bot == Bot
//│ OK

Top == Top
//│ OK

Bot <:< Top
//│ OK

:te
Top <:< Bot
//│ ═══[TYPE ERROR] Cannot solve judgment ⊤ ≤ ⊥.
//│ Typing error tree:
//│   ⊤ ≤ ⊥

// Rigid type variables.

A == A
//│ OK

A <:< Top
//│ OK

Bot <:< A
//│ OK

(Int & Str) == Bot
//│ OK

:te
Top <:< A
//│ ═══[TYPE ERROR] Cannot solve judgment ⊤ ≤ A.
//│ Typing error tree:
//│   ⊤ ≤ A

:te
A <:< Bot
//│ ═══[TYPE ERROR] Cannot solve judgment A ≤ ⊥.
//│ Typing error tree:
//│   A ≤ ⊥

:te
A == B
//│ ═══[TYPE ERROR] Cannot solve judgment A ≡ B.
//│ Typing error tree:
//│   A ≡ B
//│     A ≤ B

// Lambda types.

(Top -> Bot) <:< (A -> Bot)
//│ OK

(Top -> Bot) <:< (Top -> A)
//│ OK

(A -> Top) <:< (Bot -> Top)
//│ OK

(Bot -> A) <:< (Bot -> Top)
//│ OK

:te
(A -> Bot) <:< (Top -> Bot)
//│ ═══[TYPE ERROR] Cannot solve judgment A → ⊥ ≤ ⊤ → ⊥.
//│ Typing error tree:
//│   A → ⊥ ≤ ⊤ → ⊥
//│     ⊤ ≤ A

:te
(Top -> A) <:< (Top -> Bot)
//│ ═══[TYPE ERROR] Cannot solve judgment ⊤ → A ≤ ⊤ → ⊥.
//│ Typing error tree:
//│   ⊤ → A ≤ ⊤ → ⊥
//│     A ≤ ⊥

:te
(Bot -> Top) <:< (A -> Top)
//│ ═══[TYPE ERROR] Cannot solve judgment ⊥ → ⊤ ≤ A → ⊤.
//│ Typing error tree:
//│   ⊥ → ⊤ ≤ A → ⊤
//│     A ≤ ⊥

:te
(Bot -> Top) <:< (Bot -> A)
//│ ═══[TYPE ERROR] Cannot solve judgment ⊥ → ⊤ ≤ ⊥ → A.
//│ Typing error tree:
//│   ⊥ → ⊤ ≤ ⊥ → A
//│     ⊤ ≤ A
