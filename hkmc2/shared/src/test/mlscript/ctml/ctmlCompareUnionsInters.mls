:ctml

class A
class B
class C
class D

// Simple unions and intersections.

Top == (Top | A)
//│ OK

Bot == (Bot & A)
//│ OK

A == (A | A)
//│ OK

A == (A & A)
//│ OK

A <= (A | B)
//│ OK

(A & B) <= A
//│ OK

(A | B) == (B | A)
//│ OK

(A & B) == (B & A)
//│ OK

// Unions and intersection with flexible variables.

([Y, Z] -> [Y, Z]) <= ([Int, Str] | [Str, Int])
//│ OK

declare type Y
declare type Z

[Y, Z] <= ([Int, Str] | [Str, Int])
//│ OK

// Unions and intersections distributvity.

(A | (B & C)) == ((A | B) & (A | C))
//│ OK

(A & (B | C)) == ((A & B) | (A & C))
//│ OK

// Lambdas and intersections distributvity.

((A -> B) & (A -> C)) == (A -> (B & C))
//│ OK

((A -> C) & (B -> C)) == ((A | B) -> C)
//│ OK

((A | C) -> (B & D)) <= ((A -> B) & (C -> D))
//│ OK

// Type errors

:te
(A | B) <= A
//│ ═══[TYPE ERROR] Cannot solve judgment A ∨ B ≤ A.
//│ Typing error tree:
//│   A ∨ B ≤ A
//│     B ≤ A

:te
A <= (A & B)
//│ ═══[TYPE ERROR] Cannot solve judgment A ≤ A ∧ B.
//│ Typing error tree:
//│   A ≤ A ∧ B
//│     A ≤ B

:te
((A -> B) & (C -> D)) <= ((A | C) -> (B & D))
//│ ═══[TYPE ERROR] Cannot solve judgment (A → B) ∧ (C → D) ≤ (A ∨ C) → (B ∧ D).
//│ Typing error tree:
//│   (A → B) ∧ (C → D) ≤ (A ∨ C) → (B ∧ D)
//│     (A → B) ∧ (C → D) ≤ A → (B ∧ D)
//│       (A → B) ∧ (C → D) ≤ A → D
//│         A → B ≤ A → D
//│           B ≤ D
//│         C → D ≤ A → D
//│           A ≤ C

:te
([Int, Str] | [Str, Int]) <= ([A, B] -> [A, B])
//│ ═══[TYPE ERROR] Cannot solve judgment ⟨Int, Str⟩ ∨ ⟨Str, Int⟩ ≤ ∀A, B. ⟨A, B⟩.
//│ Typing error tree:
//│   ⟨Int, Str⟩ ∨ ⟨Str, Int⟩ ≤ ∀A, B. ⟨A, B⟩
//│     ⟨Int, Str⟩ ≤ ∀A, B. ⟨A, B⟩
//│       ⟨Int, Str⟩ ≤ ∀B. ⟨α, B⟩
//│         ⟨Int, Str⟩ ≤ ⟨α, β⟩
//│           Int ≤ α
//│             Int ≤ ⊥

// Function intersections type inference.

fun baz: (Int -> Int -> Int) & (Str -> Str -> Str)
//│ baz: (Int → Int → Int) ∧ (Str → Str → Str)

baz(1, 2)
//│ Int

baz("Hello", "World")
//│ Str

baz(bot, bot)
//│ ⊥

:te
baz(1, "World")
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int ≤ Str → α.
//│ Typing error tree:
//│   Int → Int ≤ Str → α
//│     Str ≤ Int

:te
baz(1, top)
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int ≤ ⊤ → α.
//│ Typing error tree:
//│   Int → Int ≤ ⊤ → α
//│     ⊤ ≤ Int
