:ctml

class A
class B
class C
class D
class E

// Simple unions and intersections

Top == (Top | A)
//│ OK

Bot == (Bot & A)
//│ OK

A == (A | A)
//│ OK

A == (A & A)
//│ OK

A <:< (A | B)
//│ OK

(A & B) <:< A
//│ OK

(A | B) == (B | A)
//│ OK

(A & B) == (B & A)
//│ OK

// Unions and intersections with extrmemum types

(A | Bot) <:< A
//│ OK

A <:< (A & Top)
//│ OK

:te
(Bot -> A) <:< (Top -> A)
//│ ═══[TYPE ERROR] Cannot solve judgment ⊥ → A ≤ ⊤ → A.
//│ Typing error tree:
//│   ⊥ → A ≤ ⊤ → A
//│     ⊤ ≤ ⊥

:te
(A -> Top) <:< (A -> Bot)
//│ ═══[TYPE ERROR] Cannot solve judgment A → ⊤ ≤ A → ⊥.
//│ Typing error tree:
//│   A → ⊤ ≤ A → ⊥
//│     ⊤ ≤ ⊥

// Unions and intersection with flexible variables

([Y, Z] -> [Y, Z]) <:< ([Int, Str] | [Str, Int])
//│ OK

declare type Y
declare type Z

[Y, Z] <:< ([Int, Str] | [Str, Int])
//│ OK

// Unions and intersections distributvity

(A | (B & C)) == ((A | B) & (A | C))
//│ OK

(A & (B | C)) == ((A & B) | (A & C))
//│ OK

// Lambdas and intersections distributvity

((A -> B) & (A -> C)) == (A -> (B & C))
//│ OK

((A -> C) & (B -> C)) == ((A | B) -> C)
//│ OK

((A | C) -> (B & D)) <:< ((A -> B) & (C -> D))
//│ OK

// Unions and intersections distributivity across variables

type L = Int | Str
type R = Int | Str
//│ L = Int ∨ Str
//│ R = Int ∨ Str

(Int | Str) <:< R
//│ OK

L <:< (Int | Str)
//│ OK

L <:< R
//│ OK

// Type errors

:te
(A | B) <:< A
//│ ═══[TYPE ERROR] Cannot solve judgment A ∨ B ≤ A.
//│ Typing error tree:
//│   A ∨ B ≤ A
//│     B ≤ A

:te
A <:< (A & B)
//│ ═══[TYPE ERROR] Cannot solve judgment A ≤ A ∧ B.
//│ Typing error tree:
//│   A ≤ A ∧ B
//│     A ≤ B

:te
((A -> B) & (C -> D)) <:< ((A | C) -> (B & D))
//│ ═══[TYPE ERROR] Cannot solve judgment (A → B) ∧ (C → D) ≤ (A ∨ C) → (B ∧ D).
//│ Typing error tree:
//│   (A → B) ∧ (C → D) ≤ (A ∨ C) → (B ∧ D)
//│     (A → B) ∧ (C → D) ≤ A → (B ∧ D)
//│       (A → B) ∧ (C → D) ≤ A → D
//│         A → B ≤ A → D
//│           B ≤ D
//│         C → D ≤ A → D
//│           A ≤ C

:te
([Int, Str] | [Str, Int]) <:< ([A, B] -> [A, B])
//│ ═══[TYPE ERROR] Cannot solve judgment ⟨Int, Str⟩ ∨ ⟨Str, Int⟩ ≤ ∀A, B. ⟨A, B⟩.
//│ Typing error tree:
//│   ⟨Int, Str⟩ ∨ ⟨Str, Int⟩ ≤ ∀A, B. ⟨A, B⟩
//│     ⟨Int, Str⟩ ≤ ∀A, B. ⟨A, B⟩
//│       ⟨Int, Str⟩ ≤ ⟨α, β⟩
//│         Int ≤ α
//│           Int ≤ ⊥

// Function distributivity across unions and variables

type T1 = ((A | B) -> C) | D
type T2 = ((A -> C) & (B -> C)) | D
//│ T1 = ((A ∨ B) → C) ∨ D
//│ T2 = ((A → C) ∧ (B → C)) ∨ D

T1 <:< T2
//│ OK

// Complex nesting with tuples
type U1 = ([A, B] | [C, D]) -> E
type U2 = (([A, B]) -> E) & (([C, D]) -> E)
//│ U1 = (⟨A, B⟩ ∨ ⟨C, D⟩) → E
//│ U2 = (⟨A, B⟩ → E) ∧ (⟨C, D⟩ → E)

U1 <:< U2
//│ OK

type T3 = Int & Str
//│ T3 = Int ∧ Str

(Top -> T3) <:< ((Top -> Int) & (Top -> Str))
//│ OK

(Top -> (Int & Str)) <:< (Top -> T3)
//│ OK

(Top -> T3) <:< (Top -> (Int & Str))
//│ OK

((Top -> Int) & (Top -> Str)) <:< (Top -> T3)
//│ OK

(Top -> T3) <:< ((Top -> T3) & (Top -> T3))
//│ OK

((Top -> T3) & (Top -> T3)) <:< (Top -> T3)
//│ OK
