:ctml

declare class A
declare class B
declare class C
declare class D

// Simple unions and intersections.

Top == (Top | A)
//│ OK

Bot == (Bot & A)
//│ OK

A == (A | A)
//│ OK

A == (A & A)
//│ OK

A <= (A | B)
//│ OK

(A & B) <= A
//│ OK

(A | B) == (B | A)
//│ OK

(A & B) == (B & A)
//│ OK

([Y, Z] -> (Y, Z)) <= ((Int, Str) | (Str, Int))
//│ OK

// Unions and intersections distributvity.

(A | (B & C)) == ((A | B) & (A | C))
//│ OK

(A & (B | C)) == ((A & B) | (A & C))
//│ OK

// Lambdas and intersections distributvity.

((A -> B) & (A -> C)) == (A -> (B & C))
//│ OK

((A -> C) & (B -> C)) == ((A | B) -> C)
//│ OK

((A | C) -> (B & D)) <= ((A -> B) & (C -> D))
//│ OK

// Type errors

:e
(A | B) <= A
//│ ═══[ERROR] Cannot solve judgment B ≤ A.
//│ Typing error tree:
//│   B ≤ A
//│     ⊤ ≤ A
//│       ⊤ ≤ ⊥

:e
A <= (A & B)
//│ ═══[ERROR] Cannot solve judgment A ≤ B.
//│ Typing error tree:
//│   A ≤ B
//│     A ≤ ⊥
//│       ⊤ ≤ ⊥

:e
((A -> B) & (C -> D)) <= ((A | C) -> (B & D))
//│ ═══[ERROR] Cannot solve judgment (A → B) ∧ (C → D) ≤ (A ∨ C) → (B ∧ D).
//│ Typing error tree:
//│   (A → B) ∧ (C → D) ≤ (A ∨ C) → (B ∧ D)
//│     (A → B) ∧ (C → D) ≤ A → (B ∧ D)
//│       (A → B) ∧ (C → D) ≤ A → D
//│         A → B ≤ A → D
//│           B ≤ D
//│             B ≤ ⊥
//│               ⊤ ≤ ⊥
//│         C → D ≤ A → D
//│           A ≤ C
//│             A ≤ ⊥
//│               ⊤ ≤ ⊥

:e
((Int, Str) | (Str, Int)) <= ([A, B] -> (A, B))
//│ ═══[ERROR] Cannot solve judgment ⟨Int, Str⟩ ∨ ⟨Str, Int⟩ ≤ ∀A, B. ⟨A, B⟩.
//│ Typing error tree:
//│   ⟨Int, Str⟩ ∨ ⟨Str, Int⟩ ≤ ∀A, B. ⟨A, B⟩
//│     ⟨Int, Str⟩ ≤ ∀A, B. ⟨A, B⟩
//│       ⟨Int, Str⟩ ≤ ∀B. ⟨α, B⟩
//│         ⟨Int, Str⟩ ≤ ⟨α, β⟩
//│           Int ≤ α
//│             Int ≤ ⊥
//│               ⊤ ≤ ⊥

// Function intersections type inference.

fun baz: (Int -> Int -> Int) & (Str -> Str -> Str)
//│ baz: (Int → Int → Int) ∧ (Str → Str → Str)

baz(1, 2)
//│ Int

baz("Hello", "World")
//│ Str

baz(bot, bot)
//│ Int ∨ Str

:e
baz(1, "World")
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ Str → α.
//│ Typing error tree:
//│   Int → Int ≤ Str → α
//│     Str ≤ Int
//│       ⊤ ≤ Int
//│         ⊤ ≤ ⊥

:e
baz(1, top)
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ ⊤ → α.
//│ Typing error tree:
//│   Int → Int ≤ ⊤ → α
//│     ⊤ ≤ Int
//│       ⊤ ≤ ⊥
