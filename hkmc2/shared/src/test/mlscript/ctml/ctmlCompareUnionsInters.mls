// Unions and intersections distributvity

(A | (B & C)) == ((A | B) & (A | C))
//│ OK

(A & (B | C)) == ((A & B) | (A & C))
//│ OK

// Lambdas and intersections distributvity

((A -> B) & (A -> C)) == (A -> (B & C))
//│ OK

((A -> C) & (B -> C)) == ((A | B) -> C)
//│ OK

(A | C) -> (B & D) :<: (A -> B) & (C -> D)
//│ FAILURE: Unexpected compilation error
//│ FAILURE LOCATION: subterm (Elaborator.scala:515)
//│ ╔══[COMPILATION ERROR] Name not found: :<:
//│ ║  l.89: 	(A | C) -> (B & D) :<: (A -> B) & (C -> D)
//│ ╙──      	                   ^^^
//│ FAILURE: Unexpected parse error
//│ FAILURE LOCATION: raise (test.scala:57)
//│ ═══[PARSE ERROR] Unsupported CTML term: FunTy(Tup(List(Fld(‹›,CompType(Ref(member:A),Ref(member:C),true),None))),App(Error,Tup(List(Fld(‹›,CompType(Ref(member:B),Ref(member:D),false),None), Fld(‹›,CompType(FunTy(Tup(List(Fld(‹›,Ref(member:A),None))),Ref(member:B),None),FunTy(Tup(List(Fld(‹›,Ref(member:C),None))),Ref(member:D),None),false),None)))),None)

