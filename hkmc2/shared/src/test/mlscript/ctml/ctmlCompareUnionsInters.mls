:ctml

class A
class B
class C
class D
class E

// Simple unions and intersections

Top == (Top | A)
//│ OK

Bot == (Bot & A)
//│ OK

A == (A | A)
//│ OK

A == (A & A)
//│ OK

A <:< (A | B)
//│ OK

(A & B) <:< A
//│ OK

(A | B) == (B | A)
//│ OK

(A & B) == (B & A)
//│ OK

// Unions and intersections with extrmemum types

(A | Bot) <:< A
//│ OK

A <:< (A & Top)
//│ OK

:te
(Bot -> A) <:< (Top -> A)
//│ ═══[TYPE ERROR] Cannot solve judgment ⊥ → A ≤ ⊤ → A.
//│ Typing error tree:
//│   ⊥ → A ≤ ⊤ → A
//│     ⊤ ≤ ⊥

:te
(A -> Top) <:< (A -> Bot)
//│ ═══[TYPE ERROR] Cannot solve judgment A → ⊤ ≤ A → ⊥.
//│ Typing error tree:
//│   A → ⊤ ≤ A → ⊥
//│     ⊤ ≤ ⊥

// Unions and intersection with flexible variables

([Y, Z] -> [Y, Z]) <:< ([Int, Str] | [Str, Int])
//│ OK

declare type Y
declare type Z

[Y, Z] <:< ([Int, Str] | [Str, Int])
//│ OK

// Unions and intersections distributvity

(A | (B & C)) == ((A | B) & (A | C))
//│ OK

(A & (B | C)) == ((A & B) | (A & C))
//│ OK

// Lambdas and intersections distributvity

((A -> B) & (A -> C)) == (A -> (B & C))
//│ OK

((A -> C) & (B -> C)) == ((A | B) -> C)
//│ OK

((A | C) -> (B & D)) <:< ((A -> B) & (C -> D))
//│ OK

((A -> C) & (A -> D)) <:< (A -> (B | (C & D)))
//│ OK

// Unions and intersections distributivity across variables

type L = Int | Str
type R = Int | Str
//│ L = Int ∨ Str
//│ R = Int ∨ Str

(Int | Str) <:< R
//│ OK

L <:< (Int | Str)
//│ OK

L <:< R
//│ OK

// Type errors

:te
(A | B) <:< A
//│ ═══[TYPE ERROR] Cannot solve judgment A ∨ B ≤ A.
//│ Typing error tree:
//│   A ∨ B ≤ A
//│     B ≤ A

:te
A <:< (A & B)
//│ ═══[TYPE ERROR] Cannot solve judgment A ≤ A ∧ B.
//│ Typing error tree:
//│   A ≤ A ∧ B
//│     A ≤ B

:te
((A -> B) & (C -> D)) <:< ((A | C) -> (B & D))
//│ ═══[TYPE ERROR] Cannot solve judgment (A → B) ∧ (C → D) ≤ (A ∨ C) → (B ∧ D).
//│ Typing error tree:
//│   (A → B) ∧ (C → D) ≤ (A ∨ C) → (B ∧ D)
//│     (A → B) ∧ (C → D) ≤ A → (B ∧ D)
//│       (A → B) ∧ (C → D) ≤ A → D
//│         A → B ≤ A → D
//│           B ≤ D
//│         C → D ≤ A → D
//│           A ≤ C

:te
([Int, Str] | [Str, Int]) <:< ([A, B] -> [A, B])
//│ ═══[TYPE ERROR] Cannot solve judgment ⟨Int, Str⟩ ∨ ⟨Str, Int⟩ ≤ ∀A, B. ⟨A, B⟩.
//│ Typing error tree:
//│   ⟨Int, Str⟩ ∨ ⟨Str, Int⟩ ≤ ∀A, B. ⟨A, B⟩
//│     ⟨Int, Str⟩ ∨ ⟨Str, Int⟩ ≤ ⟨α, β⟩
//│       ⟨Int, Str⟩ ≤ ⟨α, β⟩
//│         Int ≤ α
//│           Int ≤ ⊥

// Function distributivity across unions and variables

type T1 = ((A | B) -> C) | D
type T2 = ((A -> C) & (B -> C)) | D
//│ T1 = ((A ∨ B) → C) ∨ D
//│ T2 = ((A → C) ∧ (B → C)) ∨ D

T1 <:< T2
//│ OK

// Complex nesting with tuples
type U1 = ([A, B] | [C, D]) -> E
type U2 = (([A, B]) -> E) & (([C, D]) -> E)
//│ U1 = (⟨A, B⟩ ∨ ⟨C, D⟩) → E
//│ U2 = (⟨A, B⟩ → E) ∧ (⟨C, D⟩ → E)

U1 <:< U2
//│ OK

type T3 = Int & Str
//│ T3 = Int ∧ Str

(Top -> T3) <:< ((Top -> Int) & (Top -> Str))
//│ OK

(Top -> (Int & Str)) <:< (Top -> T3)
//│ OK

(Top -> T3) <:< (Top -> (Int & Str))
//│ OK

((Top -> Int) & (Top -> Str)) <:< (Top -> T3)
//│ OK

(Top -> T3) <:< ((Top -> T3) & (Top -> T3))
//│ OK

((Top -> T3) & (Top -> T3)) <:< (Top -> T3)
//│ OK

// Unions and intersections across the bounds of rigid variables

// A variable under a negation or in a lambda parameter is replaced by its bound of the opposite
// direction. Both of these used to be accepted, although they do not hold for `X = ⊤` and `X = ⊥`
// respectively.

:te
(Top -> C) <:< ([X restricts (A -> A) & (B -> B)] -> Top -> ~X)
//│ ═══[TYPE ERROR] Cannot solve judgment ⊤ → C ≤ ∀X. {X ≥ (A → A) ∧ (B → B)} ⟹ ⊤ → ¬X.
//│ Typing error tree:
//│   ⊤ → C ≤ ∀X. {X ≥ (A → A) ∧ (B → B)} ⟹ ⊤ → ¬X
//│     ⊤ → C ≤ {α ≥ (A → A) ∧ (B → B)} ⟹ ⊤ → ¬α
//│       ⊤ → C ≤ ⊤ → ¬α
//│         C ≤ ¬α

:te
((A -> C) -> D) <:< ([X extends A | B] -> (X -> C) -> D)
//│ ═══[TYPE ERROR] Cannot solve judgment (A → C) → D ≤ ∀X. {X ≤ A ∨ B} ⟹ (X → C) → D.
//│ Typing error tree:
//│   (A → C) → D ≤ ∀X. {X ≤ A ∨ B} ⟹ (X → C) → D
//│     (A → C) → D ≤ {α ≤ A ∨ B} ⟹ (α → C) → D
//│       (A → C) → D ≤ (α → C) → D
//│         α → C ≤ A → C
//│           A ≤ α
//│             A ≤ ⊥

(Top -> ~(A | B)) <:< ([X extends A | B] -> Top -> ~X)
//│ OK

(((A | B) -> C) -> D) <:< ([X restricts A | B] -> (X -> C) -> D)
//│ OK

// A lambda type on the left is compared as a whole, rather than split into an intersection of
// lambda types of which a single one is kept.

((A | B) -> C) <:< ([X extends A | B] -> X -> C)
//│ OK

// A variable that occurs elsewhere in the judgment is not replaced by its bound to decompose a
// union or an intersection, since its other occurrences would no longer be related to it. These
// used to be explored with `A` and `B` in place of the leftmost `X`, or with `A -> A` and `B -> B`
// in place of the rightmost one.

([X] -> X -> X) <:< ([X extends A | B] -> X -> X)
//│ OK

([X] -> X -> X) <:< ([X extends A | B] -> (X & A) -> X)
//│ OK

([X] -> X -> X) <:< ([X extends A | B] -> X -> (X | C))
//│ OK

([X] -> X -> X) <:< ([X restricts (A -> A) & (B -> B)] -> (X & C) -> (X | D))
//│ OK

:te
([X] -> X -> X) <:< ([X extends A | B] -> (X & A) -> B)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀X. X → X ≤ ∀X. {X ≤ A ∨ B} ⟹ (X ∧ A) → B.
//│ Typing error tree:
//│   ∀X. X → X ≤ ∀X. {X ≤ A ∨ B} ⟹ (X ∧ A) → B
//│     ∀X. X → X ≤ {α ≤ A ∨ B} ⟹ (α ∧ A) → B
//│       ∀X. X → X ≤ (α ∧ A) → B
//│         ∀X. X → X ≤ (A ∧ A) → B
//│           β → β ≤ (A ∧ A) → B
//│             β ≤ B
//│               A ∧ A ≤ B
//│                 A ≤ B
//│                 A ≤ B

:te
(A -> A) <:< ([X extends A | B] -> X -> X)
//│ ═══[TYPE ERROR] Cannot solve judgment A → A ≤ ∀X. {X ≤ A ∨ B} ⟹ X → X.
//│ Typing error tree:
//│   A → A ≤ ∀X. {X ≤ A ∨ B} ⟹ X → X
//│     A → A ≤ {α ≤ A ∨ B} ⟹ α → α
//│       A → A ≤ α → α
//│         α ≤ A
//│           B ≤ A

// A variable that occurs once is still replaced by its bound, which loses nothing.

type V

(((A & V) | (B & V)) -> D) <:< ([X extends A | B] -> (X & V) -> D)
//│ OK

(B -> B) <:< ([X extends A | B] -> (X & ~A) -> B)
//│ OK

:te
(B -> B) <:< ([X extends A | B | C] -> (X & ~A) -> B)
//│ ═══[TYPE ERROR] Cannot solve judgment B → B ≤ ∀X. {X ≤ (A ∨ B) ∨ C} ⟹ (X ∧ ¬A) → B.
//│ Typing error tree:
//│   B → B ≤ ∀X. {X ≤ (A ∨ B) ∨ C} ⟹ (X ∧ ¬A) → B
//│     B → B ≤ {α ≤ (A ∨ B) ∨ C} ⟹ (α ∧ ¬A) → B
//│       B → B ≤ (α ∧ ¬A) → B
//│         α ∧ ¬A ≤ B
//│           C ∧ ¬A ≤ B
//│             C ≤ B

// Two lambda types are compared as they are, so that a flexible variable of the subtype is bounded
// by the variable itself rather than by its bound. This used to require `A | B <:< Y <:< X`.

([Y] -> [Y -> C, Y]) <:< ([X extends A | B] -> [X -> C, X])
//│ OK

// The constraint of a constrained type is assumed before an operand of an intersection is chosen,
// so that the bound of the variable is known when the supertype is decomposed.

((A -> C) & (B -> C)) <:< ([X extends A | B] -> X -> C)
//│ OK

((A -> C) & (B -> D)) <:< ([X extends A | B] -> X -> (C | D))
//│ OK

:te
((A -> C) & (B -> D)) <:< ([X extends A | B] -> X -> C)
//│ ═══[TYPE ERROR] Cannot solve judgment (A → C) ∧ (B → D) ≤ ∀X. {X ≤ A ∨ B} ⟹ X → C.
//│ Typing error tree:
//│   (A → C) ∧ (B → D) ≤ ∀X. {X ≤ A ∨ B} ⟹ X → C
//│     (A → C) ∧ (B → D) ≤ {α ≤ A ∨ B} ⟹ α → C
//│       (A → C) ∧ (B → D) ≤ α → C
//│         (A → C) ∧ (B → D) ≤ B → C
//│           A → C ≤ B → C
//│             B ≤ A
//│           B → D ≤ B → C
//│             D ≤ C

:fixme // FIXME: A variable that occurs elsewhere in the judgment is not analysed by cases, which requires to keep it in each case.
((A -> C) & (B -> C)) <:< ([X extends A | B] -> X -> (X | C))
//│ ═══[TYPE ERROR] Cannot solve judgment (A → C) ∧ (B → C) ≤ ∀X. {X ≤ A ∨ B} ⟹ X → (X ∨ C).
//│ Typing error tree:
//│   (A → C) ∧ (B → C) ≤ ∀X. {X ≤ A ∨ B} ⟹ X → (X ∨ C)
//│     (A → C) ∧ (B → C) ≤ {α ≤ A ∨ B} ⟹ α → (α ∨ C)
//│       (A → C) ∧ (B → C) ≤ α → (α ∨ C)
//│         A → C ≤ α → (α ∨ C)
//│           α ≤ A
//│             B ≤ A
//│         B → C ≤ α → (α ∨ C)
//│           α ≤ B
//│             A ≤ B

// Reflexivity up to the choice rules

(V & A) <:< (B | V)
//│ OK

((A -> B) & V) <:< (A -> B)
//│ OK
