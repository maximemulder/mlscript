:ctml

class A
class B
class C
class D
class E

// Simple unions and intersections

Top == (Top | A)
//│ OK

Bot == (Bot & A)
//│ OK

A == (A | A)
//│ OK

A == (A & A)
//│ OK

A <:< (A | B)
//│ OK

(A & B) <:< A
//│ OK

(A | B) == (B | A)
//│ OK

(A & B) == (B & A)
//│ OK

// Unions and intersections with extrmemum types

(A | Bot) <:< A
//│ OK

A <:< (A & Top)
//│ OK

:te
(Bot -> A) <:< (Top -> A)
//│ ═══[TYPE ERROR] Cannot solve judgment ⊥ → A ≤ ⊤ → A.
//│ Typing error tree:
//│   ⊥ → A ≤ ⊤ → A
//│     ⊤ ≤ ⊥

:te
(A -> Top) <:< (A -> Bot)
//│ ═══[TYPE ERROR] Cannot solve judgment A → ⊤ ≤ A → ⊥.
//│ Typing error tree:
//│   A → ⊤ ≤ A → ⊥
//│     ⊤ ≤ ⊥

// Unions and intersection with flexible variables

([Y, Z] -> [Y, Z]) <:< ([Int, Str] | [Str, Int])
//│ OK

declare type Y
declare type Z

[Y, Z] <:< ([Int, Str] | [Str, Int])
//│ OK

// Unions and intersections distributvity

(A | (B & C)) == ((A | B) & (A | C))
//│ OK

(A & (B | C)) == ((A & B) | (A & C))
//│ OK

// Lambdas and intersections distributvity

((A -> B) & (A -> C)) == (A -> (B & C))
//│ OK

((A -> C) & (B -> C)) == ((A | B) -> C)
//│ OK

((A | C) -> (B & D)) <:< ((A -> B) & (C -> D))
//│ OK

((A -> C) & (A -> D)) <:< (A -> (B | (C & D)))
//│ OK

// Unions and intersections distributivity across variables

type L = Int | Str
type R = Int | Str
//│ L = Int ∨ Str
//│ R = Int ∨ Str

(Int | Str) <:< R
//│ OK

L <:< (Int | Str)
//│ OK

L <:< R
//│ OK

// Type errors

:te
(A | B) <:< A
//│ ═══[TYPE ERROR] Cannot solve judgment A ∨ B ≤ A.
//│ Typing error tree:
//│   A ∨ B ≤ A
//│     B ≤ A

:te
A <:< (A & B)
//│ ═══[TYPE ERROR] Cannot solve judgment A ≤ A ∧ B.
//│ Typing error tree:
//│   A ≤ A ∧ B
//│     A ≤ B

:te
((A -> B) & (C -> D)) <:< ((A | C) -> (B & D))
//│ ═══[TYPE ERROR] Cannot solve judgment (A → B) ∧ (C → D) ≤ (A ∨ C) → (B ∧ D).
//│ Typing error tree:
//│   (A → B) ∧ (C → D) ≤ (A ∨ C) → (B ∧ D)
//│     (A → B) ∧ (C → D) ≤ A → (B ∧ D)
//│       (A → B) ∧ (C → D) ≤ A → D
//│         A → B ≤ A → D
//│           B ≤ D
//│         C → D ≤ A → D
//│           A ≤ C

:te
([Int, Str] | [Str, Int]) <:< ([A, B] -> [A, B])
//│ ═══[TYPE ERROR] Cannot solve judgment ⟨Int, Str⟩ ∨ ⟨Str, Int⟩ ≤ ∀A, B. ⟨A, B⟩.
//│ Typing error tree:
//│   ⟨Int, Str⟩ ∨ ⟨Str, Int⟩ ≤ ∀A, B. ⟨A, B⟩
//│     ⟨Int, Str⟩ ∨ ⟨Str, Int⟩ ≤ ⟨α, β⟩
//│       ⟨Int, Str⟩ ≤ ⟨α, β⟩
//│         Int ≤ α
//│           Int ≤ ⊥

// Function distributivity across unions and variables

type T1 = ((A | B) -> C) | D
type T2 = ((A -> C) & (B -> C)) | D
//│ T1 = ((A ∨ B) → C) ∨ D
//│ T2 = ((A → C) ∧ (B → C)) ∨ D

T1 <:< T2
//│ OK

// Complex nesting with tuples
type U1 = ([A, B] | [C, D]) -> E
type U2 = (([A, B]) -> E) & (([C, D]) -> E)
//│ U1 = (⟨A, B⟩ ∨ ⟨C, D⟩) → E
//│ U2 = (⟨A, B⟩ → E) ∧ (⟨C, D⟩ → E)

U1 <:< U2
//│ OK

type T3 = Int & Str
//│ T3 = Int ∧ Str

(Top -> T3) <:< ((Top -> Int) & (Top -> Str))
//│ OK

(Top -> (Int & Str)) <:< (Top -> T3)
//│ OK

(Top -> T3) <:< (Top -> (Int & Str))
//│ OK

((Top -> Int) & (Top -> Str)) <:< (Top -> T3)
//│ OK

(Top -> T3) <:< ((Top -> T3) & (Top -> T3))
//│ OK

((Top -> T3) & (Top -> T3)) <:< (Top -> T3)
//│ OK

// Unions and intersections across the bounds of rigid variables

// A variable under a negation or in a lambda parameter is replaced by its bound of the opposite
// direction. Both of these used to be accepted, although they do not hold for `X = ⊤` and `X = ⊥`
// respectively.

:te
(Top -> C) <:< ([X restricts (A -> A) & (B -> B)] -> Top -> ~X)
//│ ═══[TYPE ERROR] Cannot solve judgment ⊤ → C ≤ ∀X. {X ≥ (A → A) ∧ (B → B)} ⟹ ⊤ → ¬X.
//│ Typing error tree:
//│   ⊤ → C ≤ ∀X. {X ≥ (A → A) ∧ (B → B)} ⟹ ⊤ → ¬X
//│     ⊤ → C ≤ {α ≥ (A → A) ∧ (B → B)} ⟹ ⊤ → ¬α
//│       ⊤ → C ≤ ⊤ → ¬α
//│         C ≤ ¬α

:te
((A -> C) -> D) <:< ([X extends A | B] -> (X -> C) -> D)
//│ ═══[TYPE ERROR] Cannot solve judgment (A → C) → D ≤ ∀X. {X ≤ A ∨ B} ⟹ (X → C) → D.
//│ Typing error tree:
//│   (A → C) → D ≤ ∀X. {X ≤ A ∨ B} ⟹ (X → C) → D
//│     (A → C) → D ≤ {α ≤ A ∨ B} ⟹ (α → C) → D
//│       (A → C) → D ≤ (α → C) → D
//│         α → C ≤ A → C
//│           A ≤ α
//│             A ≤ ⊥

(Top -> ~(A | B)) <:< ([X extends A | B] -> Top -> ~X)
//│ OK

(((A | B) -> C) -> D) <:< ([X restricts A | B] -> (X -> C) -> D)
//│ OK

// A lambda type on the left is compared as a whole, rather than split into an intersection of
// lambda types of which a single one is kept.

((A | B) -> C) <:< ([X extends A | B] -> X -> C)
//│ OK

:fixme // FIXME: A variable is forgotten when it is replaced by its bound to split a type.
([X] -> X -> X) <:< ([X extends A | B] -> (X & A) -> X)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀X. X → X ≤ ∀X. {X ≤ A ∨ B} ⟹ (X ∧ A) → X.
//│ Typing error tree:
//│   ∀X. X → X ≤ ∀X. {X ≤ A ∨ B} ⟹ (X ∧ A) → X
//│     ∀X. X → X ≤ {α ≤ A ∨ B} ⟹ (α ∧ A) → α
//│       ∀X. X → X ≤ (α ∧ A) → α
//│         ∀X. X → X ≤ (A ∧ A) → α
//│           β → β ≤ (A ∧ A) → α
//│             β ≤ α
//│               A ∧ A ≤ α
//│                 A ≤ α
//│                   A ≤ ⊥
//│                 A ≤ α
//│                   A ≤ ⊥

:fixme // FIXME: The left intersection is decomposed by the choice rule before the right constrained type is opened, when the bound of the variable is not known yet.
((A -> C) & (B -> C)) <:< ([X extends A | B] -> X -> C)
//│ ═══[TYPE ERROR] Cannot solve judgment (A → C) ∧ (B → C) ≤ ∀X. {X ≤ A ∨ B} ⟹ X → C.
//│ Typing error tree:
//│   (A → C) ∧ (B → C) ≤ ∀X. {X ≤ A ∨ B} ⟹ X → C
//│     (A → C) ∧ (B → C) ≤ {α ≤ A ∨ B} ⟹ α → C
//│       A → C ≤ {α ≤ A ∨ B} ⟹ α → C
//│         A → C ≤ α → C
//│           A → C ≤ B → C
//│             B ≤ A
//│       B → C ≤ {α ≤ A ∨ B} ⟹ α → C
//│         B → C ≤ α → C
//│           B → C ≤ A → C
//│             A ≤ B
