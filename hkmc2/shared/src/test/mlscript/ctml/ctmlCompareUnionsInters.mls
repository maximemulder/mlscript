// Function intersections type inference.

fun baz: (Int -> Int -> Int) & (Str -> Str -> Str)
//│ baz: (Int → Int → Int) ∧ (Str → Str → Str)

baz(1, 2)
//│ Int

baz("Hello", "World")
//│ Str

baz(bot, bot)
//│ ⊥

:te
baz(1, "World")
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int ≤ Str → α.
//│ Typing error tree:
//│   Int → Int ≤ Str → α
//│     Str ≤ Int

:te
baz(1, top)
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int ≤ ⊤ → α.
//│ Typing error tree:
//│   Int → Int ≤ ⊤ → α
//│     ⊤ ≤ Int
