:ctml

([A] -> A -> A) == ([A] -> A -> A)
//│ OK

([A] -> A -> A) <:< (Int -> Int)
//│ OK

(Int -> Int) <:< ([A extends Int] -> A -> Int)
//│ OK

([A extends Int] -> A -> Int) <:< (Int -> Int)
//│ OK

(Int -> Int) <:< ([A restricts Int] -> Int -> A)
//│ OK

([A restricts Int] -> Int -> A) <:< (Int -> Int)
//│ OK

:te
(Int -> Int) <:< ([A] -> A -> A)
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int ≤ ∀A. A → A.
//│ Typing error tree:
//│   Int → Int ≤ ∀A. A → A
//│     Int → Int ≤ α → α
//│       α ≤ Int
//│         ⊤ ≤ Int

:te
([A extends Str] -> A -> A) <:< (Int -> Int)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀A. {A ≤ Str} ⟹ A → A ≤ Int → Int.
//│ Typing error tree:
//│   ∀A. {A ≤ Str} ⟹ A → A ≤ Int → Int
//│     {α ≤ Str} ⟹ α → α ≤ Int → Int
//│       α → α ≤ Int → Int
//│         Int ≤ α
//│           Int ≤ Str
