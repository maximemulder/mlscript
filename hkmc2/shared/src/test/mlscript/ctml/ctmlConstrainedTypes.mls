:ctml

fun id(x) = x
//│ id: ∀β ⇐ {}. β → β

fun idInt(x) = (x as Int)
//│ idInt: Int → Int

id(1)
//│ Int

idInt(1)
//│ Int

id("")
//│ Str

idInt("")
