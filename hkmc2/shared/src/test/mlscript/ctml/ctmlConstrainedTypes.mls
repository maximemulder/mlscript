:ctml

fun id(x) = x
//│ id: ∀α. α → α

id(1)
//│ Int

id("Hello")
//│ Str

fun idInt(x) = (x as Int)
//│ idInt: Int → Int

idInt(1)
//│ Int

:e
idInt("Hello")
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ Str → 7.
//│ Typing error tree:
//│   Int → Int ≤ Str → 7
//│     Str ≤ Int
//│       ⊤ ≤ Int
//│         ⊤ ≤ ⊥

// FIXME: Force new bounds on explicit type annotations ?
:fixme
val inc: [T extends Int] -> T -> Int = (x) => x + 1
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ ∀T. {T ≤ Int} ⟹ T → Int.
//│ Typing error tree:
//│   Int → Int ≤ ∀T. {T ≤ Int} ⟹ T → Int
//│     Int → Int ≤ {11 ≤ Int} ⟹ 11 → Int
//│       11 ≤ Int
//│         ⊤ ≤ Int
//│           ⊤ ≤ ⊥

:e
val incError: [T extends Int] -> T -> Int = (x) => x ++ 1
//│ ═══[ERROR] Cannot solve judgment Str → Str ≤ Int → 13.
//│ Typing error tree:
//│   Str → Str ≤ Int → 13
//│     Int ≤ Str
//│       Int ≤ ⊥
//│         ⊤ ≤ ⊥

// FIXME: Force new bounds on explicit type annotations ?
:fixme
val idInt: [T extends Int] -> T -> Int = (x) => x
//│ ═══[ERROR] Cannot solve judgment ∀α. α → α ≤ ∀T. {T ≤ Int} ⟹ T → Int.
//│ Typing error tree:
//│   ∀α. α → α ≤ ∀T. {T ≤ Int} ⟹ T → Int
//│     ∀α. α → α ≤ {16 ≤ Int} ⟹ 16 → Int
//│       17 → 17 ≤ {16 ≤ Int} ⟹ 16 → Int
//│         16 ≤ Int
//│           ⊤ ≤ Int
//│             ⊤ ≤ ⊥

idInt(1)
//│ Int

:e
idInt("Hello")
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ Str → 19.
//│ Typing error tree:
//│   Int → Int ≤ Str → 19
//│     Str ≤ Int
//│       ⊤ ≤ Int
//│         ⊤ ≤ ⊥
