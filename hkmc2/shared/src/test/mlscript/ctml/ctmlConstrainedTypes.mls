:ctml

fun id(x) = x
//│ id: ∀α. α → α

id(1)
//│ ⊥

id("Hello")
//│ ⊥

val idInt: [T extends Int] -> T -> Int = id
//│ idInt: ∀T. {T ≤ Int} ⟹ T → Int

idInt(1)
//│ Int

:te
idInt("Hello")
//│ ═══[TYPE ERROR] Cannot solve judgment ∀T. {T ≤ Int} ⟹ T → Int ≤ Str → α.
//│ Typing error tree:
//│   ∀T. {T ≤ Int} ⟹ T → Int ≤ Str → α
//│     {β ≤ Int} ⟹ β → Int ≤ Str → α
//│       β → Int ≤ Str → α
//│         Str ≤ β
//│           Str ≤ Int

val idConflictingBounds: [A extends Int restricts Str] -> A -> A = id
//│ idConflictingBounds: ∀A. {A ≤ Int, A ≥ Str} ⟹ A → A

val inc: [T extends Int] -> T -> Int = (x) => x + 1
//│ inc: ∀T. {T ≤ Int} ⟹ T → Int

inc(1)
//│ Int

:te
inc("Hello")
//│ ═══[TYPE ERROR] Cannot solve judgment ∀T. {T ≤ Int} ⟹ T → Int ≤ Str → α.
//│ Typing error tree:
//│   ∀T. {T ≤ Int} ⟹ T → Int ≤ Str → α
//│     {β ≤ Int} ⟹ β → Int ≤ Str → α
//│       β → Int ≤ Str → α
//│         Str ≤ β
//│           Str ≤ Int

:te
val incError: [T extends Int] -> T -> Int = (x) => x ++ 1
//│ ═══[TYPE ERROR] Cannot solve judgment Str → Str ≤ Int → α.
//│ Typing error tree:
//│   Str → Str ≤ Int → α
//│     Int ≤ Str
