:ctml

fun id(x) = x
//│ id: ∀α ◁ {}. α → α

id(1)
//│ Int

id("Hello")
//│ Str

fun idInt(x) = (x as Int)
//│ idInt: Int → Int

idInt(1)
//│ Int

:e
idInt("Hello")
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ Str → ζ.
//│ Typing error tree:
//│   Int → Int ≤ Str → ζ
//│     Str ≤ Int
//│       Str ≤ ⊥
//│         ⊤ ≤ ⊥
