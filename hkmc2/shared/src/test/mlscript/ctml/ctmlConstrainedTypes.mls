:ctml

fun id(x) = x
//│ infer ELam(x,EVar(x))
//│   infer EVar(x)
//│   OK α ⇝ ∅
//│ OK ∀α ◁ {}. α → α ⇝ ∅
//│ id: ∀α ◁ {}. α → α

id(1)
//│ infer EApp(EVar(id),EVar(int))
//│   infer EVar(id)
//│   OK ∀α ◁ {}. α → α ⇝ ∅
//│   infer EVar(int)
//│   OK Int ⇝ ∅
