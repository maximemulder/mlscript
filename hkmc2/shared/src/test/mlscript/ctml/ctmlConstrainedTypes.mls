fun idInt(x) = (x as Int)
//│ infer ELam(x,EAscr(EVar(x),Int))
//│   infer EAscr(EVar(x),Int)
//│     infer EVar(x)
//│     OK δ ⇝ ∅
//│     constrain δ ≤ Int IN x: δ, δ fresh, id: ∀α ◁ {}. α → α, string: Str, num: Num, int: Int, bool: Bool, unit: Unit, bot: ⊥, top: ⊤, Num rigid, Int rigid, Bool rigid, Unit rigid, Bot rigid, Top rigid, untyped rigid, Str rigid, Function rigid, Object rigid
//│       constrain ⊥ ≤ Int IN δ ≤ Int, x: δ, δ fresh, id: ∀α ◁ {}. α → α, string: Str, num: Num, int: Int, bool: Bool, unit: Unit, bot: ⊥, top: ⊤, Num rigid, Int rigid, Bool rigid, Unit rigid, Bot rigid, Top rigid, untyped rigid, Str rigid, Function rigid, Object rigid
//│       OK ⇝ ∅
//│     OK ⇝ δ ≤ Int
//│   OK Int ⇝ δ ≤ Int
//│ OK Int → Int ⇝ ∅
//│ idInt: Int → Int

idInt(1)
//│ infer EApp(EVar(idInt),EVar(int))
//│   infer EVar(idInt)
//│   OK Int → Int ⇝ ∅
//│   infer EVar(int)
//│   OK Int ⇝ ∅
//│   constrain Int → Int ≤ Int → ε IN ε fresh, idInt: Int → Int, id: ∀α ◁ {}. α → α, string: Str, num: Num, int: Int, bool: Bool, unit: Unit, bot: ⊥, top: ⊤, Num rigid, Int rigid, Bool rigid, Unit rigid, Bot rigid, Top rigid, untyped rigid, Str rigid, Function rigid, Object rigid
//│     constrain Int ≤ Int IN ε fresh, idInt: Int → Int, id: ∀α ◁ {}. α → α, string: Str, num: Num, int: Int, bool: Bool, unit: Unit, bot: ⊥, top: ⊤, Num rigid, Int rigid, Bool rigid, Unit rigid, Bot rigid, Top rigid, untyped rigid, Str rigid, Function rigid, Object rigid
//│     OK ⇝ ∅
//│     constrain Int ≤ ε IN ε fresh, idInt: Int → Int, id: ∀α ◁ {}. α → α, string: Str, num: Num, int: Int, bool: Bool, unit: Unit, bot: ⊥, top: ⊤, Num rigid, Int rigid, Bool rigid, Unit rigid, Bot rigid, Top rigid, untyped rigid, Str rigid, Function rigid, Object rigid
//│       constrain Int ≤ ⊤ IN ε ≥ Int, ε fresh, idInt: Int → Int, id: ∀α ◁ {}. α → α, string: Str, num: Num, int: Int, bool: Bool, unit: Unit, bot: ⊥, top: ⊤, Num rigid, Int rigid, Bool rigid, Unit rigid, Bot rigid, Top rigid, untyped rigid, Str rigid, Function rigid, Object rigid
//│       OK ⇝ ∅
//│     OK ⇝ ε ≥ Int
//│   OK ⇝ ε ≥ Int
//│ OK Int ⇝ ∅
//│ Int

