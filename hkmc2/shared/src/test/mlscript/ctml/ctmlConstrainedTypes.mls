:ctml

fun id(x) = x
//│ id: ∀α ◁ {}. α → α

id(1)
//│ β
//│ β fresh

id("Hello")
//│ γ
//│ γ fresh

fun idInt(x) = (x as Int)
//│ idInt: Int → Int

idInt(1)
//│ Int

:e
idInt("Hello")
