:ctml

fun id(x) = x
//│ id: ∀α. α → α

id(1)
//│ Int

id("Hello")
//│ Str

val idInt: [T extends Int] -> T -> Int = id
//│ idInt: Int → Int

idInt(1)
//│ Int

:te
idInt("Hello")
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int ≤ Str → α.
//│ Typing error tree:
//│   Int → Int ≤ Str → α
//│     Str ≤ Int

val idConflictingBounds: [A extends Int restricts Str] -> A -> A = id
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:71)
//│ ═══[TYPE ERROR] Cannot solve judgment Str ≤ A.
//│ Typing error tree:
//│   Str ≤ A
//│     Str ≤ Int

val inc: [T extends Int] -> T -> Int = (x) => x + 1
//│ inc: Int → Int

inc(1)
//│ Int

:te
inc("Hello")
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int ≤ Str → α.
//│ Typing error tree:
//│   Int → Int ≤ Str → α
//│     Str ≤ Int

:te
val incError: [T extends Int] -> T -> Int = (x) => x ++ 1
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Int → β.
//│ Typing error tree:
//│   α ≤ Int → β
