:ctml

fun id(x) = x
//│ id: ∀α. α → α

id(1)
//│ Int

id("Hello")
//│ Str

fun idInt(x) = (x as Int)
//│ idInt: Int → Int

idInt(1)
//│ Int

:e
idInt("Hello")
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ Str → θ.
//│ Typing error tree:
//│   Int → Int ≤ Str → θ
//│     Str ≤ Int
//│       ⊤ ≤ Int
//│         ⊤ ≤ ⊥

// FIXME: Force new bounds on explicit type annotations ?
:fixme
val inc: [T extends Int] -> T -> Int = (x) => x + 1
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ ∀T. {T ≤ Int} ⟹ T → Int.
//│ Typing error tree:
//│   Int → Int ≤ ∀T. {T ≤ Int} ⟹ T → Int
//│     Int → Int ≤ {μ ≤ Int} ⟹ μ → Int
//│       μ ≤ Int
//│         ⊤ ≤ Int
//│           ⊤ ≤ ⊥

:e
val incError: [T extends Int] -> T -> Int = (x) => x ++ 1
//│ ═══[ERROR] Cannot solve judgment Str → Str ≤ Int → ξ.
//│ Typing error tree:
//│   Str → Str ≤ Int → ξ
//│     Int ≤ Str
//│       Int ≤ ⊥
//│         ⊤ ≤ ⊥

// FIXME: Force new bounds on explicit type annotations ?
:fixme
val idInt: [T extends Int] -> T -> Int = (x) => x
//│ ═══[ERROR] Cannot solve judgment ∀π. π → π ≤ ∀T. {T ≤ Int} ⟹ T → Int.
//│ Typing error tree:
//│   ∀π. π → π ≤ ∀T. {T ≤ Int} ⟹ T → Int
//│     ∀π. π → π ≤ {ρ ≤ Int} ⟹ ρ → Int
//│       σ → σ ≤ {ρ ≤ Int} ⟹ ρ → Int
//│         ρ ≤ Int
//│           ⊤ ≤ Int
//│             ⊤ ≤ ⊥

idInt(1)
//│ Int

:e
idInt("Hello")
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ Str → υ.
//│ Typing error tree:
//│   Int → Int ≤ Str → υ
//│     Str ≤ Int
//│       ⊤ ≤ Int
//│         ⊤ ≤ ⊥
