:ctml

fun id(x) = x
//│ id: ∀β ◁ {}. β → β

fun idInt(x) = (x as Int)
//│ idInt: Int → Int

id(1)
//│ Int

idInt(1)
//│ Int

id("")
//│ Str

idInt("")
//│ TYPE ERROR: Cannot solve type equation Int → Int ≤ Str → β.
//│ Typing error tree:
//│   Int → Int ≤ Str → β
//│     Str ≤ Int

val a = 1
//│ a: Int

a as Str
//│ TYPE ERROR: Cannot solve type equation Int ≤ Str.
//│ Typing error tree:
//│   Int ≤ Str
