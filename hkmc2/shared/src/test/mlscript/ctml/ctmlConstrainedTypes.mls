val inc: [T extends Int] -> T -> Int = (x) => x + 1
//│ inc: ∀T. {T ≤ Int} ⟹ T → Int

inc(1)
//│ Int

:te
inc("Hello")
//│ ═══[TYPE ERROR] Cannot solve judgment ∀T. {T ≤ Int} ⟹ T → Int ≤ Str → α.
//│ Typing error tree:
//│   ∀T. {T ≤ Int} ⟹ T → Int ≤ Str → α
//│     {β ≤ Int} ⟹ β → Int ≤ Str → α
//│       β → Int ≤ Str → α
//│         Str ≤ β
//│           Str ≤ Int

:te
val incError: [T extends Int] -> T -> Int = (x) => x ++ 1
