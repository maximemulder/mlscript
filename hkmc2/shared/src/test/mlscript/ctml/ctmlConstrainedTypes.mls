//│       constrain Int ≤ α IN α fresh, β fresh, id: ∀α ◁ {}. α → α, string: Str, num: Num, int: Int, bool: Bool, unit: Unit, bot: ⊥, top: ⊤, Num rigid, Int rigid, Bool rigid, Unit rigid, Bot rigid, Top rigid, untyped rigid, Str rigid, Function rigid, Object rigid
//│         constrain Int ≤ ⊤ IN α ≥ Int, α fresh, β fresh, id: ∀α ◁ {}. α → α, string: Str, num: Num, int: Int, bool: Bool, unit: Unit, bot: ⊥, top: ⊤, Num rigid, Int rigid, Bool rigid, Unit rigid, Bot rigid, Top rigid, untyped rigid, Str rigid, Function rigid, Object rigid
//│         OK ⇝ ∅
//│       OK ⇝ α ≥ Int
//│       constrain α ≤ β IN α fresh, β fresh, id: ∀α ◁ {}. α → α, string: Str, num: Num, int: Int, bool: Bool, unit: Unit, bot: ⊥, top: ⊤, Num rigid, Int rigid, Bool rigid, Unit rigid, Bot rigid, Top rigid, untyped rigid, Str rigid, Function rigid, Object rigid
//│         constrain ⊥ ≤ β IN α ≤ β, α fresh, β fresh, id: ∀α ◁ {}. α → α, string: Str, num: Num, int: Int, bool: Bool, unit: Unit, bot: ⊥, top: ⊤, Num rigid, Int rigid, Bool rigid, Unit rigid, Bot rigid, Top rigid, untyped rigid, Str rigid, Function rigid, Object rigid
//│         OK ⇝ ∅
