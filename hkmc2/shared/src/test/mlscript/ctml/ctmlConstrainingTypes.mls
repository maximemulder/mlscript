fun bar(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ bar: ∀α, β, γ. {α ≤ (Int ⟹ {β ≤ Int} ⟹ {γ ≥ Int}) ∨ (⊤ ⟹ {β ≤ Str} ⟹ {γ ≥ Str})} ⟹ {β ≤ (Int ⟹ {α ≤ Int} ⟹ {γ ≥ Int}) ∨ (Str ⟹ {γ ≥ Str})} ⟹ {γ ≥ (Int ⟹ {α ≤ Int} ⟹ {β ≤ Int}) ∨ (Str ⟹ {β ≤ Str})} ⟹ α → β → γ

bar(1, 1)
//│ Int

bar(1, "")
//│ Str

bar("", "")
//│ Str

bar(true, "")
//│ Str

:e
bar(true, 1)
//│ ═══[ERROR] Cannot solve judgment Str → Str ≤ Int → α.
//│ Typing error tree:
//│   Str → Str ≤ Int → α
//│     Int ≤ Str
//│       Int ≤ ⊥
//│         ⊤ ≤ ⊥

:e
