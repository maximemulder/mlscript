//│     ∀β, γ. {70 ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {β ≤ Str, γ ≥ Str}), β ≤ (Int ⟹ {70 ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {70 ≤ Str, γ ≥ Str}), γ ≥ (Int ⟹ {70 ≤ Int, β ≤ Int}) ∨ (Str ⟹ {70 ≤ Str, β ≤ Str})} ⟹ 70 → β → γ ≤ Bool → Bool → Bool
//│       ∀γ. {70 ≤ (Int ⟹ {71 ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {71 ≤ Str, γ ≥ Str}), 71 ≤ (Int ⟹ {70 ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {70 ≤ Str, γ ≥ Str}), γ ≥ (Int ⟹ {70 ≤ Int, 71 ≤ Int}) ∨ (Str ⟹ {70 ≤ Str, 71 ≤ Str})} ⟹ 70 → 71 → γ ≤ Bool → Bool → Bool
