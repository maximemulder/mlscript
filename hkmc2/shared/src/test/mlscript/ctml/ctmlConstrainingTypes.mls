fun bar(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ bar: ∀24. {24 ≥ (Int ⟹ {ψ ≤ Int, ω ≤ Int}) ∨ (Str ⟹ {ω ≤ Str})} ⟹ ∀ω. {ω ≤ (Int ⟹ {ψ ≤ Int, 24 ≥ Int}) ∨ (Str ⟹ {24 ≥ Str})} ⟹ ∀ψ. {ψ ≤ (Int ⟹ {ω ≤ Int, 24 ≥ Int}) ∨ (⊤ ⟹ {ω ≤ Str, 24 ≥ Str})} ⟹ ψ → ω → 24

bar(1, 1)
//│ ∀30. {30 ≥ Int, 30 ≤ (Int ⟹ {27 ≥ Int}) ∨ (Str ⟹ {27 ≥ Str})} ⟹ (Int ⟹ {30 ≤ Int}) ∨ (Str ⟹ {30 ≤ Str})
//│ 27 ≥ Int

bar(1, "")
//│ ∀37. {37 ≥ Str, 37 ≤ (Int ⟹ {34 ≥ Int}) ∨ (Str ⟹ {34 ≥ Str})} ⟹ (Int ⟹ {37 ≤ Int}) ∨ (Str ⟹ {37 ≤ Str})
//│ 34 ≥ Str

bar("", "")
//│ Str

bar(true, "")
//│ Str

