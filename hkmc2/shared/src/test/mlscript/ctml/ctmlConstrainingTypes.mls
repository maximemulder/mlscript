:ctml

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀α, β, γ ◁ {α ≤ (Int ▷ {β ≤ Int, γ ≥ Int}) ∨ (Str ▷ {β ≤ Str, γ ≥ Str}), β ≤ (Int ▷ {α ≤ Int, γ ≥ Int}) ∨ (Str ▷ {α ≤ Str, γ ≥ Str}), γ ≥ (Int ▷ {α ≤ Int, β ≤ Int}) ∨ (Str ▷ {α ≤ Str, β ≤ Str})}. α → β → γ

foo(1, 2)
//│ Int

:e
foo(1, "")
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ Str → ζ.
//│ Typing error tree:
//│   Int → Int ≤ Str → ζ
//│     Str ≤ Int
//│       ⊤ ≤ Int
//│         ⊤ ≤ ⊥

:e
foo(true, false)
//│ ═══[ERROR] Cannot solve judgment ∀α, β, γ ◁ {α ≤ (Int ▷ {β ≤ Int, γ ≥ Int}) ∨ (Str ▷ {β ≤ Str, γ ≥ Str}), β ≤ (Int ▷ {α ≤ Int, γ ≥ Int}) ∨ (Str ▷ {α ≤ Str, γ ≥ Str}), γ ≥ (Int ▷ {α ≤ Int, β ≤ Int}) ∨ (Str ▷ {α ≤ Str, β ≤ Str})}. α → β → γ ≤ Bool → ι.
//│ Typing error tree:
//│   ∀α, β, γ ◁ {α ≤ (Int ▷ {β ≤ Int, γ ≥ Int}) ∨ (Str ▷ {β ≤ Str, γ ≥ Str}), β ≤ (Int ▷ {α ≤ Int, γ ≥ Int}) ∨ (Str ▷ {α ≤ Str, γ ≥ Str}), γ ≥ (Int ▷ {α ≤ Int, β ≤ Int}) ∨ (Str ▷ {α ≤ Str, β ≤ Str})}. α → β → γ ≤ Bool → ι
//│     α → β → γ ≤ Bool → ι
//│       Bool ≤ α
//│         Bool ≤ (Int ▷ {β ≤ Int, γ ≥ Int}) ∨ (Str ▷ {β ≤ Str, γ ≥ Str})
//│           Bool ≤ Int ▷ {β ≤ Int, γ ≥ Int}
//│             Bool ≤ Int
//│               Bool ≤ ⊥
//│                 ⊤ ≤ ⊥
//│           Bool ≤ Str ▷ {β ≤ Str, γ ≥ Str}
//│             Bool ≤ Str
//│               Bool ≤ ⊥
//│                 ⊤ ≤ ⊥

fun bar(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ bar: ∀κ, λ, μ ◁ {κ ≤ (Int ▷ {λ ≤ Int, μ ≥ Int}) ∨ (⊤ ▷ {λ ≤ Str, μ ≥ Str}), λ ≤ (Int ▷ {κ ≤ Int, μ ≥ Int}) ∨ (Str ▷ {μ ≥ Str}), μ ≥ (Int ▷ {κ ≤ Int, λ ≤ Int}) ∨ (Str ▷ {λ ≤ Str})}. κ → λ → μ

bar(1, 1)
//│ Int

bar(1, "")
//│ Str

bar("", "")
//│ Str

bar(true, "")
//│ Str

:e
bar(true, 1)
//│ ═══[ERROR] Cannot solve judgment Str → Str ≤ Int → φ.
//│ Typing error tree:
//│   Str → Str ≤ Int → φ
//│     Int ≤ Str
//│       Int ≤ ⊥
//│         ⊤ ≤ ⊥

:e
bar(true, true)
//│ ═══[ERROR] Cannot solve judgment Str → Str ≤ Bool → ψ.
//│ Typing error tree:
//│   Str → Str ≤ Bool → ψ
//│     Bool ≤ Str
//│       Bool ≤ ⊥
//│         ⊤ ≤ ⊥



