:ctml

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str})} ⟹ α → β → γ

foo(1, 2)
//│ Int

:e
foo(1, "")
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ Str → α.
//│ Typing error tree:
//│   Int → Int ≤ Str → α
//│     Str ≤ Int
//│       ⊤ ≤ Int
//│         ⊤ ≤ ⊥

:e
foo(true, false)
//│ ═══[ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str})} ⟹ α → β → γ ≤ Bool → δ.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str})} ⟹ α → β → γ ≤ Bool → δ
//│     ∀β, γ. {ε ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, ε ≤ Str})} ⟹ ε → β → γ ≤ Bool → δ
//│       ∀γ. {ε ≤ (Int ⟹ {γ ≥ Int, ζ ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, ζ ≤ Str}), ζ ≤ (Int ⟹ {γ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, ε ≤ Str})} ⟹ ε → ζ → γ ≤ Bool → δ
//│         {ε ≤ (Int ⟹ {η ≥ Int, ζ ≤ Int}) ∨ (Str ⟹ {η ≥ Str, ζ ≤ Str}), ζ ≤ (Int ⟹ {η ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {η ≥ Str, ε ≤ Str})} ⟹ ε → ζ → η ≤ Bool → δ
//│           {ζ ≤ (Int ⟹ {η ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {η ≥ Str, ε ≤ Str})} ⟹ ε → ζ → η ≤ Bool → δ
//│             ε → ζ → η ≤ Bool → δ
//│               Bool ≤ ε
//│                 Bool ≤ (Int ⟹ {η ≥ Int, ζ ≤ Int}) ∨ (Str ⟹ {η ≥ Str, ζ ≤ Str})
//│                   Bool ≤ Int ⟹ {η ≥ Int, ζ ≤ Int}
//│                     Bool ≤ Int
//│                       Bool ≤ ⊥
//│                         ⊤ ≤ ⊥
//│                   Bool ≤ Str ⟹ {η ≥ Str, ζ ≤ Str}
//│                     Bool ≤ Str
//│                       Bool ≤ ⊥
//│                         ⊤ ≤ ⊥

fun bar(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ bar: ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (⊤ ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str})} ⟹ α → β → γ

bar(1, 1)
//│ Int

bar(1, "")
//│ Str

bar("", "")
//│ Str

bar(true, "")
//│ Str

:e
bar(true, 1)
//│ ═══[ERROR] Cannot solve judgment Str → Str ≤ Int → α.
//│ Typing error tree:
//│   Str → Str ≤ Int → α
//│     Int ≤ Str
//│       Int ≤ ⊥
//│         ⊤ ≤ ⊥

:e
bar(true, true)
//│ ═══[ERROR] Cannot solve judgment Str → Str ≤ Bool → α.
//│ Typing error tree:
//│   Str → Str ≤ Bool → α
//│     Bool ≤ Str
//│       Bool ≤ ⊥
//│         ⊤ ≤ ⊥

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)
//│ α ≤ Str, β ≥ Str, α ≥ Str, β ≤ Str, γ ≥ Str, β ≤ (Int ⟹ {α ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {α ≥ Str, γ ≤ Str}), γ ≤ (Int ⟹ {α ≥ Int, β ≤ Int}) ∨ (Str ⟹ {α ≥ Str, β ≤ Str}), α flex, β flex, γ flex, η ≤ Int, θ ≥ Int, η ≥ Int, θ ≤ Int, ι ≥ Int, θ ≤ (Int ⟹ {η ≥ Int, ι ≤ Int}) ∨ (Str ⟹ {η ≥ Str, ι ≤ Str}), ι ≤ (Int ⟹ {η ≥ Int, θ ≤ Int}) ∨ (Str ⟹ {η ≥ Str, θ ≤ Str}), η flex, θ flex, ι flex

foo as (Int -> Int -> Int)
//│ Int → Int → Int
//│ α ≤ Int, β ≥ Int, α ≥ Int, β ≤ Int, γ ≥ Int, β ≤ (Int ⟹ {α ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {α ≥ Str, γ ≤ Str}), γ ≤ (Int ⟹ {α ≥ Int, β ≤ Int}) ∨ (Str ⟹ {α ≥ Str, β ≤ Str}), α flex, β flex, γ flex

foo as (Str -> Str -> Str)
//│ Str → Str → Str
//│ α ≤ Str, β ≥ Str, α ≥ Str, β ≤ Str, γ ≥ Str, β ≤ (Int ⟹ {α ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {α ≥ Str, γ ≤ Str}), γ ≤ (Int ⟹ {α ≥ Int, β ≤ Int}) ∨ (Str ⟹ {α ≥ Str, β ≤ Str}), α flex, β flex, γ flex

foo as (Bot -> Bot -> Top)
//│ ⊥ → ⊥ → ⊤
//│ α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str}), γ flex, α flex, β flex

:e
foo as (Bool -> Bool -> Bool)
//│ ═══[ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str})} ⟹ α → β → γ ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str})} ⟹ α → β → γ ≤ Bool → Bool → Bool
//│     ∀β, γ. {δ ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, δ ≤ Str})} ⟹ δ → β → γ ≤ Bool → Bool → Bool
//│       ∀γ. {δ ≤ (Int ⟹ {γ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, ε ≤ Str}), ε ≤ (Int ⟹ {γ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, δ ≤ Str})} ⟹ δ → ε → γ ≤ Bool → Bool → Bool
//│         {δ ≤ (Int ⟹ {ζ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, ε ≤ Str}), ε ≤ (Int ⟹ {ζ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, δ ≤ Str})} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│           {ε ≤ (Int ⟹ {ζ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, δ ≤ Str})} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│             δ → ε → ζ ≤ Bool → Bool → Bool
//│               Bool ≤ δ
//│                 Bool ≤ (Int ⟹ {ζ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, ε ≤ Str})
//│                   Bool ≤ Int ⟹ {ζ ≥ Int, ε ≤ Int}
//│                     Bool ≤ Int
//│                       Bool ≤ ⊥
//│                         ⊤ ≤ ⊥
//│                   Bool ≤ Str ⟹ {ζ ≥ Str, ε ≤ Str}
//│                     Bool ≤ Str
//│                       Bool ≤ ⊥
//│                         ⊤ ≤ ⊥

:e
foo as ((Int | Str) -> (Int | Str) -> (Int | Str))
//│ ═══[ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str})} ⟹ α → β → γ ≤ (Int ∨ Str) → (Int ∨ Str) → (Int ∨ Str).
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str})} ⟹ α → β → γ ≤ (Int ∨ Str) → (Int ∨ Str) → (Int ∨ Str)
//│     ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str})} ⟹ α → β → γ ≤ Int → (Int ∨ Str) → (Int ∨ Str)
//│       ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str})} ⟹ α → β → γ ≤ Int → Str → (Int ∨ Str)
//│         ∀β, γ. {δ ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, δ ≤ Str})} ⟹ δ → β → γ ≤ Int → Str → (Int ∨ Str)
//│           ∀γ. {δ ≤ (Int ⟹ {γ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, ε ≤ Str}), ε ≤ (Int ⟹ {γ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, δ ≤ Str})} ⟹ δ → ε → γ ≤ Int → Str → (Int ∨ Str)
//│             {δ ≤ (Int ⟹ {ζ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, ε ≤ Str}), ε ≤ (Int ⟹ {ζ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, δ ≤ Str})} ⟹ δ → ε → ζ ≤ Int → Str → (Int ∨ Str)
//│               {ε ≤ (Int ⟹ {ζ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, δ ≤ Str})} ⟹ δ → ε → ζ ≤ Int → Str → (Int ∨ Str)
//│                 δ → ε → ζ ≤ Int → Str → (Int ∨ Str)
//│                   ε → ζ ≤ Str → (Int ∨ Str)
//│                     Str ≤ ε
//│                       Str ≤ Int
//│                         ⊤ ≤ Int
//│                           ⊤ ≤ ⊥

:e
foo as (Top -> Top -> Top)
//│ ═══[ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str})} ⟹ α → β → γ ≤ ⊤ → ⊤ → ⊤.
