:ctml

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀α, β, γ ◁ {α ≤ (Int ▷ {γ ≥ Int, β ≤ Int}) ∨ (Str ▷ {γ ≥ Str, β ≤ Str}), β ≤ (Int ▷ {γ ≥ Int, α ≤ Int}) ∨ (Str ▷ {γ ≥ Str, α ≤ Str}), γ ≥ (Int ▷ {β ≤ Int, α ≤ Int}) ∨ (Str ▷ {β ≤ Str, α ≤ Str})}. α → β → γ

foo(1, 2)
//│ Int

:e
foo(1, "")
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ Str → ζ.
//│ Typing error tree:
//│   Int → Int ≤ Str → ζ
//│     Str ≤ Int
//│       Str ≤ ⊥
//│         ⊤ ≤ ⊥

:e
foo(true, false)
//│ ═══[ERROR] Cannot solve judgment ∀α, β, γ ◁ {α ≤ (Int ▷ {γ ≥ Int, β ≤ Int}) ∨ (Str ▷ {γ ≥ Str, β ≤ Str}), β ≤ (Int ▷ {γ ≥ Int, α ≤ Int}) ∨ (Str ▷ {γ ≥ Str, α ≤ Str}), γ ≥ (Int ▷ {β ≤ Int, α ≤ Int}) ∨ (Str ▷ {β ≤ Str, α ≤ Str})}. α → β → γ ≤ Bool → ι.
//│ Typing error tree:
//│   ∀α, β, γ ◁ {α ≤ (Int ▷ {γ ≥ Int, β ≤ Int}) ∨ (Str ▷ {γ ≥ Str, β ≤ Str}), β ≤ (Int ▷ {γ ≥ Int, α ≤ Int}) ∨ (Str ▷ {γ ≥ Str, α ≤ Str}), γ ≥ (Int ▷ {β ≤ Int, α ≤ Int}) ∨ (Str ▷ {β ≤ Str, α ≤ Str})}. α → β → γ ≤ Bool → ι
//│     α → β → γ ≤ Bool → ι
//│       Bool ≤ α
//│         Bool ≤ (Int ▷ {γ ≥ Int, β ≤ Int}) ∨ (Str ▷ {γ ≥ Str, β ≤ Str})
//│           Bool ≤ Str ▷ {γ ≥ Str, β ≤ Str}
//│             Bool ≤ Str
//│               ⊤ ≤ Str
//│                 ⊤ ≤ ⊥
//│           Bool ≤ Int ▷ {γ ≥ Int, β ≤ Int}
//│             Bool ≤ Int
//│               Bool ≤ ⊥
//│                 ⊤ ≤ ⊥

fun bar(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ bar: ∀κ, λ, μ ◁ {κ ≤ (Int ▷ {μ ≥ Int, λ ≤ Int}) ∨ (⊤ ▷ {μ ≥ Str, λ ≤ Str}), λ ≤ (Int ▷ {μ ≥ Int, κ ≤ Int}) ∨ (Str ▷ {μ ≥ Str}), μ ≥ (Int ▷ {λ ≤ Int, κ ≤ Int}) ∨ (Str ▷ {λ ≤ Str})}. κ → λ → μ

bar(1, 1)
//│ Str ∨ Int

bar(1, "")
//│ Str ∨ Int

bar("", "")
//│ Str

bar(true, "")
//│ Str

:e
bar(true, 1)
//│ ═══[ERROR] Cannot solve judgment Str → Str ≤ Int → φ.
//│ Typing error tree:
//│   Str → Str ≤ Int → φ
//│     Int ≤ Str
//│       ⊤ ≤ Str
//│         ⊤ ≤ ⊥

:e
bar(true, true)
//│ ═══[ERROR] Cannot solve judgment Str → Str ≤ Bool → ψ.
//│ Typing error tree:
//│   Str → Str ≤ Bool → ψ
//│     Bool ≤ Str
//│       ⊤ ≤ Str
//│         ⊤ ≤ ⊥



// TODO from last meeting:

// fun baz: ((Int, Int) -> Int) & ((Str, Str) -> Str) // TODO
// fun baz: (Int -> Int -> Int) & (Str -> Str -> Str) // TODO
fun baz(a, b) =
  let x = foo(a, b)
  if x is
    Int then x + a
    Str then x
//│ baz: ∀24, 27 ◁ {24 ≤ (Int ∨ (⊤ ▷ {27 ≤ Str})) ∨ (Str ∨ (Int ▷ {27 ≤ Int, 27 ≤ Int})) ∨ Str ∨ (⊤ ▷ {27 ≤ Str}), 27 ≤ (Int ▷ {24 ≤ Int}) ∨ Str}. 24 → ⊤ → ((Int ▷ {24 ≤ Int, 27 ≤ Int, 27 ≤ Int}) ∨ (27 ▷ {27 ≤ Str}))

baz(0, 1)
//│ ∀27 ◁ {}. (Int ▷ {27 ≤ Int, 27 ≤ Int}) ∨ (27 ▷ {27 ≤ Str})

baz("0", "1")
//│ ∀27 ◁ {}. (Int ▷ {27 ≤ Int, 27 ≤ Int}) ∨ (27 ▷ {27 ≤ Str})
