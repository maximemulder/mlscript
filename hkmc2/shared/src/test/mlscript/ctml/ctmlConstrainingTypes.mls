:ctml

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀γ. {γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})} ⟹ ∀β. {β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {α ≤ Str, γ ≥ Str})} ⟹ ∀α. {α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {β ≤ Str, γ ≥ Str})} ⟹ α → β → γ

foo(1, 2)
//│ Int

:e
foo(1, "")
//│ ═══[ERROR] Cannot solve judgment ∀ξ. {ξ ≤ Int} ⟹ ∀ν. {ν ≥ Int} ⟹ ξ → ν ≤ Str → λ.
//│ Typing error tree:
//│   ∀ξ. {ξ ≤ Int} ⟹ ∀ν. {ν ≥ Int} ⟹ ξ → ν ≤ Str → λ
//│     {π ≤ Int} ⟹ ∀ν. {ν ≥ Int} ⟹ π → ν ≤ Str → λ
//│       ∀ν. {ν ≥ Int} ⟹ π → ν ≤ Str → λ
//│         {ρ ≥ Int} ⟹ π → ρ ≤ Str → λ
//│           π → ρ ≤ Str → λ
//│             Str ≤ π
//│               Str ≤ Int
//│                 ⊤ ≤ Int
//│                   ⊤ ≤ ⊥

:e
foo(true, false)
//│ ═══[ERROR] Cannot solve judgment ∀γ. {γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})} ⟹ ∀β. {β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {α ≤ Str, γ ≥ Str})} ⟹ ∀α. {α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {β ≤ Str, γ ≥ Str})} ⟹ α → β → γ ≤ Bool → τ.
//│ Typing error tree:
//│   ∀γ. {γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})} ⟹ ∀β. {β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {α ≤ Str, γ ≥ Str})} ⟹ ∀α. {α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {β ≤ Str, γ ≥ Str})} ⟹ α → β → γ ≤ Bool → τ
//│     {υ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})} ⟹ ∀β. {β ≤ (Int ⟹ {α ≤ Int, υ ≥ Int}) ∨ (Str ⟹ {α ≤ Str, υ ≥ Str})} ⟹ ∀α. {α ≤ (Int ⟹ {β ≤ Int, υ ≥ Int}) ∨ (Str ⟹ {β ≤ Str, υ ≥ Str})} ⟹ α → β → υ ≤ Bool → τ
//│       ∀β. {β ≤ (Int ⟹ {α ≤ Int, υ ≥ Int}) ∨ (Str ⟹ {α ≤ Str, υ ≥ Str})} ⟹ ∀α. {α ≤ (Int ⟹ {β ≤ Int, υ ≥ Int}) ∨ (Str ⟹ {β ≤ Str, υ ≥ Str})} ⟹ α → β → υ ≤ Bool → τ
//│         {φ ≤ (Int ⟹ {α ≤ Int, υ ≥ Int}) ∨ (Str ⟹ {α ≤ Str, υ ≥ Str})} ⟹ ∀α. {α ≤ (Int ⟹ {φ ≤ Int, υ ≥ Int}) ∨ (Str ⟹ {φ ≤ Str, υ ≥ Str})} ⟹ α → φ → υ ≤ Bool → τ
//│           ∀α. {α ≤ (Int ⟹ {φ ≤ Int, υ ≥ Int}) ∨ (Str ⟹ {φ ≤ Str, υ ≥ Str})} ⟹ α → φ → υ ≤ Bool → τ
//│             {χ ≤ (Int ⟹ {φ ≤ Int, υ ≥ Int}) ∨ (Str ⟹ {φ ≤ Str, υ ≥ Str})} ⟹ χ → φ → υ ≤ Bool → τ
