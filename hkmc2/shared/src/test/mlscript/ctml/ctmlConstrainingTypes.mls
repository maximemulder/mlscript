//│ Str → Str → Str
//│ 66 ≤ Str, 65 ≥ Str, 66 ≥ Str, 65 ≤ Str, 64 ≥ Str, 66 ≥ (Int ⟹ {64 ≤ Int, 65 ≤ Int}) ∨ (Str ⟹ {64 ≤ Str, 65 ≤ Str}), 65 ≤ (Int ⟹ {64 ≤ Int, 66 ≥ Int}) ∨ (Str ⟹ {64 ≤ Str, 66 ≥ Str}), 64 ≤ (Int ⟹ {65 ≤ Int, 66 ≥ Int}) ∨ (Str ⟹ {65 ≤ Str, 66 ≥ Str}), 66 fresh, 65 fresh, 64 fresh

