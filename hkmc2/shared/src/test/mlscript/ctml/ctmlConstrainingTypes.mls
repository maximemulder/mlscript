:ctml

fun foo(a, b) =
    if a is
        Int then (b as Int)
        Str then (b as Str)
//│ foo: ∀α, β ◁ {α ≤ (Int ▷ {β ≤ Int}) ∨ (Str ▷ {β ≤ Str}), β ≤ (Int ▷ {α ≤ Int}) ∨ (Str ▷ {α ≤ Str})}. α → β → (Int ∨ Str)

foo(1, 2)
//│ Int ∨ Str
//│ α ≤ Int, β ≥ Int, β ≤ Int, α ≥ Int, β ≤ (Int ▷ {α ≤ Int}) ∨ (Str ▷ {α ≤ Str}), α ≤ (Int ▷ {β ≤ Int}) ∨ (Str ▷ {β ≤ Str}), β fresh, α fresh

:e
foo(1, "")
//│ ═══[ERROR] Cannot solve type equation β → (Int ∨ Str) ≤ Str → ε.
//│ Typing error tree:
//│   β → (Int ∨ Str) ≤ Str → ε
//│     Str ≤ β
//│       Str ≤ Int ∧ ((Int ▷ {α ≤ Int}) ∨ (Str ▷ {α ≤ Str}))
//│         Str ≤ Int ∧ (Str ▷ {α ≤ Str})
//│           Str ≤ Int
//│             Str ≤ ⊥
//│               ⊤ ≤ ⊥
//│         Str ≤ Int ∧ (Int ▷ {α ≤ Int})
//│           Str ≤ Int
//│             Str ≤ ⊥
//│               ⊤ ≤ ⊥

:e
foo(true, false)
//│ ═══[ERROR] Cannot solve type equation ∀α, β ◁ {α ≤ (Int ▷ {β ≤ Int}) ∨ (Str ▷ {β ≤ Str}), β ≤ (Int ▷ {α ≤ Int}) ∨ (Str ▷ {α ≤ Str})}. α → β → (Int ∨ Str) ≤ Bool → θ.
//│ Typing error tree:
//│   ∀α, β ◁ {α ≤ (Int ▷ {β ≤ Int}) ∨ (Str ▷ {β ≤ Str}), β ≤ (Int ▷ {α ≤ Int}) ∨ (Str ▷ {α ≤ Str})}. α → β → (Int ∨ Str) ≤ Bool → θ
//│     α → β → (Int ∨ Str) ≤ Bool → θ
//│       Bool ≤ α
//│         Bool ≤ (Int ▷ {β ≤ Int}) ∨ (Str ▷ {β ≤ Str})
//│           Bool ≤ Str ▷ {β ≤ Str}
//│             Bool ≤ Str
//│               ⊤ ≤ Str
//│                 ⊤ ≤ ⊥
//│           Bool ≤ Int ▷ {β ≤ Int}
//│             Bool ≤ Int
//│               Bool ≤ ⊥
//│                 ⊤ ≤ ⊥

fun bar(a, b) =
    if a is
        Int then (b as Int)
        Top then (b as Str)
//│ bar: ∀ι, κ ◁ {ι ≤ (Int ▷ {κ ≤ Int}) ∨ (⊤ ▷ {κ ≤ Str}), κ ≤ (Int ▷ {ι ≤ Int}) ∨ Str}. ι → κ → (Int ∨ Str)

bar(1, 1)
//│ Int ∨ Str
//│ ι ≤ Int, κ ≥ Int, κ ≤ Str ∨ Int, ι ≥ Int, κ ≤ (Int ▷ {ι ≤ Int}) ∨ Str, ι ≤ (Int ▷ {κ ≤ Int}) ∨ (⊤ ▷ {κ ≤ Str}), κ fresh, ι fresh

bar(1, "")
//│ Int ∨ Str
//│ κ ≥ Str, κ ≤ Str ∨ Int, ι ≥ Int, κ ≤ (Int ▷ {ι ≤ Int}) ∨ Str, ι ≤ (Int ▷ {κ ≤ Int}) ∨ (⊤ ▷ {κ ≤ Str}), κ fresh, ι fresh

bar("", "")
//│ Int ∨ Str
//│ κ ≥ Str, κ ≤ Str, ι ≥ Str, κ ≤ (Int ▷ {ι ≤ Int}) ∨ Str, ι ≤ (Int ▷ {κ ≤ Int}) ∨ (⊤ ▷ {κ ≤ Str}), κ fresh, ι fresh

bar(true, "")
//│ Int ∨ Str
//│ κ ≥ Str, κ ≤ Str, ι ≥ Bool, κ ≤ (Int ▷ {ι ≤ Int}) ∨ Str, ι ≤ (Int ▷ {κ ≤ Int}) ∨ (⊤ ▷ {κ ≤ Str}), κ fresh, ι fresh

:e
bar(true, 1)
//│ ═══[ERROR] Cannot solve type equation κ → (Int ∨ Str) ≤ Int → τ.
//│ Typing error tree:
//│   κ → (Int ∨ Str) ≤ Int → τ
//│     Int ≤ κ
//│       Int ≤ Str
//│         ⊤ ≤ Str
//│           ⊤ ≤ ⊥

:e
bar(true, true)
//│ ═══[ERROR] Cannot solve type equation κ → (Int ∨ Str) ≤ Bool → φ.
//│ Typing error tree:
//│   κ → (Int ∨ Str) ≤ Bool → φ
//│     Bool ≤ κ
//│       Bool ≤ Str
//│         ⊤ ≤ Str
//│           ⊤ ≤ ⊥
