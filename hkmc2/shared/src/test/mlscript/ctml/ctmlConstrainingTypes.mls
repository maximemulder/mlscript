:ctml

fun foo(a, b) =
    if a is
        Int then (b as Int)
        Str then (b as Str)
//│ foo: ∀α, β ◁ {α ≤ (Int ▷ {β ≤ Int}) ∨ (Str ▷ {β ≤ Str}), β ≤ (Int ▷ {α ≤ Int}) ∨ (Str ▷ {α ≤ Str})}. α → β → (Int ∨ Str)

foo(1, 2)
//│ Int ∨ Str
//│ β ≥ Int, α ≥ Int, β ≤ (Int ▷ {α ≤ Int}) ∨ (Str ▷ {α ≤ Str}), α ≤ (Int ▷ {β ≤ Int}) ∨ (Str ▷ {β ≤ Str}), β fresh, α fresh

2
//│ Int
3
//│ Int
