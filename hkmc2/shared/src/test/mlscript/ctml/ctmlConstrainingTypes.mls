:ctml

fun foo(a, b) =
    if a is
        Int then (b as Int)
        Str then (b as Str)
//│ foo: ∀β ◁ {β ≤ Int ∨ Str}. β → ((Int ▷ {β ≤ Int}) ∨ (Str ▷ {β ≤ Str})) → (Int ∨ Str)

foo(1, 2)
//│ ∀β ◁ {β ≥ Int ▷ {δ ≥ (Int ▷ {β ≤ Int}) → (Int ∨ Str), β ≥ Int}}. β
//│ δ ≤ Int → β, δ ≥ ((Str ▷ {β ≤ Str}) → (Int ∨ Str) ▷ {β ≥ Int}) ∨ ((Int ▷ {β ≤ Int}) → (Int ∨ Str) ▷ {β ≥ Int}), δ fresh

10
//│ Int
