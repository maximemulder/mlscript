:ctml

fun foo(a, b) =
    if a is
        Int then (b as Int)
        Str then (b as Str)
//│ foo: ∀β ⇐ {β ≤ Int ∨ Str}. β → Int ⇒ {δ ≤ Int, β ≤ Int} ∨ Str ⇒ {δ ≤ Str, β ≤ Str} → Int ∨ Str

foo(1, 2)
//│ TYPE ERROR: No alternative for any.
//│   constrain β → Int ⇒ {δ ≤ Int, β ≤ Int} ∨ Str ⇒ {δ ≤ Str, β ≤ Str} → Int ∨ Str ≤ Int → δ
//│   constrain ∀β ⇐ {β ≤ Int ∨ Str}. β → Int ⇒ {δ ≤ Int, β ≤ Int} ∨ Str ⇒ {δ ≤ Str, β ≤ Str} → Int ∨ Str ≤ Int → δ
