:ctml

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀β, γ ◁ {β ≤ (Int ▷ {γ ≥ Int, α ≤ Int}) ∨ (Str ▷ {γ ≥ Str, α ≤ Str}), γ ≥ (Int ▷ {β ≤ Int, α ≤ Int}) ∨ (Str ▷ {β ≤ Str, α ≤ Str})}. ((Int ▷ {γ ≥ Int, β ≤ Int}) ∨ (Str ▷ {γ ≥ Str, β ≤ Str})) → β → γ

foo(1, 2)
//│ Int

:e
foo(1, "")
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ Str → ζ.
//│ Typing error tree:
//│   Int → Int ≤ Str → ζ
//│     Str ≤ Int
//│       ⊤ ≤ Int
//│         ⊤ ≤ ⊥

:e
foo(true, false)
//│ ═══[ERROR] Cannot solve judgment ∀β, γ ◁ {β ≤ (Int ▷ {γ ≥ Int, α ≤ Int}) ∨ (Str ▷ {γ ≥ Str, α ≤ Str}), γ ≥ (Int ▷ {β ≤ Int, α ≤ Int}) ∨ (Str ▷ {β ≤ Str, α ≤ Str})}. ((Int ▷ {γ ≥ Int, β ≤ Int}) ∨ (Str ▷ {γ ≥ Str, β ≤ Str})) → β → γ ≤ Bool → ι.
//│ Typing error tree:
//│   ∀β, γ ◁ {β ≤ (Int ▷ {γ ≥ Int, α ≤ Int}) ∨ (Str ▷ {γ ≥ Str, α ≤ Str}), γ ≥ (Int ▷ {β ≤ Int, α ≤ Int}) ∨ (Str ▷ {β ≤ Str, α ≤ Str})}. ((Int ▷ {γ ≥ Int, β ≤ Int}) ∨ (Str ▷ {γ ≥ Str, β ≤ Str})) → β → γ ≤ Bool → ι
//│     ((Int ▷ {γ ≥ Int, β ≤ Int}) ∨ (Str ▷ {γ ≥ Str, β ≤ Str})) → β → γ ≤ Bool → ι
//│       (Int ▷ {γ ≥ Int, β ≤ Int}) → β → γ ≤ Bool → ι
//│         Bool ≤ Int ▷ {γ ≥ Int, β ≤ Int}
//│           Bool ≤ Int
//│             Bool ≤ ⊥
//│               ⊤ ≤ ⊥
//│       (Str ▷ {γ ≥ Str, β ≤ Str}) → β → γ ≤ Bool → ι
//│         Bool ≤ Str ▷ {γ ≥ Str, β ≤ Str}
//│           Bool ≤ Str
//│             Bool ≤ ⊥
//│               ⊤ ≤ ⊥

fun bar(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ bar: ∀λ, μ ◁ {λ ≤ (Int ▷ {μ ≥ Int, κ ≤ Int}) ∨ (Str ▷ {μ ≥ Str}), μ ≥ (Int ▷ {λ ≤ Int, κ ≤ Int}) ∨ (Str ▷ {λ ≤ Str})}. ((Int ▷ {μ ≥ Int, λ ≤ Int}) ∨ (⊤ ▷ {μ ≥ Str, λ ≤ Str})) → λ → μ

bar(1, 1)
//│ Int
//│ ξ ≥ λ → μ, ξ ≥ λ → μ
//│
//│
//│

bar(1, "")
//│ Str
//│ π ≥ λ → μ, π ≥ λ → μ

bar("", "")
//│ Str

bar(true, "")
//│ Str

:e
bar(true, 1)
//│ ═══[ERROR] Cannot solve judgment Str → Str ≤ Int → φ.
//│ Typing error tree:
//│   Str → Str ≤ Int → φ
//│     Int ≤ Str
//│       Int ≤ ⊥
//│         ⊤ ≤ ⊥

:e
bar(true, true)
//│ ═══[ERROR] Cannot solve judgment Str → Str ≤ Bool → ψ.
//│ Typing error tree:
//│   Str → Str ≤ Bool → ψ
//│     Bool ≤ Str
//│       Bool ≤ ⊥
//│         ⊤ ≤ ⊥



