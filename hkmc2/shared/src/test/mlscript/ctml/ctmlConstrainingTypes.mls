fun bar(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ bar: ∀κ, λ, μ ◁ {κ ≤ (Int ▷ {μ ≥ Int, λ ≤ Int}) ∨ (⊤ ▷ {μ ≥ Str, λ ≤ Str}), λ ≤ (Int ▷ {μ ≥ Int, κ ≤ Int}) ∨ (Str ▷ {μ ≥ Str}), μ ≥ (Int ▷ {λ ≤ Int, κ ≤ Int}) ∨ (Str ▷ {λ ≤ Str})}. κ → λ → μ

bar(1, 1)
//│ ∀κ, λ ◁ {κ ≥ Int, κ ≤ (Int ▷ {λ ≤ Int}) ∨ (Int ▷ {λ ≤ Str}), λ ≥ Int, λ ≤ (Int ▷ {κ ≤ Int}) ∨ Str}. Int ∨ (((Str ▷ {λ ≤ Str}) ∨ (Int ▷ {λ ≤ Int})) ∨ (Int ▷ {λ ≤ Int, κ ≤ Int}) ∨ (Str ▷ {λ ≤ Str})) ∨ (Str ▷ {λ ≤ Str}) ∨ (Int ▷ {λ ≤ Int})

bar(1, "")
//│ ∀κ, λ ◁ {κ ≥ Int, κ ≤ (Int ▷ {λ ≤ Int}) ∨ (⊤ ▷ {λ ≤ Str}), λ ≥ Str, λ ≤ (Int ▷ {κ ≤ Int}) ∨ Str}. Str ∨ (((Str ▷ {λ ≤ Str}) ∨ (Int ▷ {λ ≤ Int})) ∨ (Int ▷ {λ ≤ Int, κ ≤ Int}) ∨ (Str ▷ {λ ≤ Str})) ∨ (Str ▷ {λ ≤ Str}) ∨ (Int ▷ {λ ≤ Int})

bar("", "")
