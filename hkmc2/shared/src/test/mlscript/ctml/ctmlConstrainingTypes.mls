:ctml

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀α, β, γ ◁ {α ≤ (Int ▷ {β ≤ Int, γ ≥ Int}) ∨ (Str ▷ {β ≤ Str, γ ≥ Str}), β ≤ (Int ▷ {α ≤ Int, γ ≥ Int}) ∨ (Str ▷ {α ≤ Str, γ ≥ Str}), γ ≥ (Int ▷ {α ≤ Int, β ≤ Int}) ∨ (Str ▷ {α ≤ Str, β ≤ Str})}. α → β → γ

foo(1, 2)
//│ Int

:e
foo(1, "")
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ Str → ι.
//│ Typing error tree:
//│   Int → Int ≤ Str → ι
//│     Str ≤ Int
//│       ⊤ ≤ Int
//│         ⊤ ≤ ⊥

:e
foo(true, false)
//│ ═══[ERROR] Cannot solve judgment ∀α, β, γ ◁ {α ≤ (Int ▷ {β ≤ Int, γ ≥ Int}) ∨ (Str ▷ {β ≤ Str, γ ≥ Str}), β ≤ (Int ▷ {α ≤ Int, γ ≥ Int}) ∨ (Str ▷ {α ≤ Str, γ ≥ Str}), γ ≥ (Int ▷ {α ≤ Int, β ≤ Int}) ∨ (Str ▷ {α ≤ Str, β ≤ Str})}. α → β → γ ≤ Bool → ο.
//│ Typing error tree:
//│   ∀α, β, γ ◁ {α ≤ (Int ▷ {β ≤ Int, γ ≥ Int}) ∨ (Str ▷ {β ≤ Str, γ ≥ Str}), β ≤ (Int ▷ {α ≤ Int, γ ≥ Int}) ∨ (Str ▷ {α ≤ Str, γ ≥ Str}), γ ≥ (Int ▷ {α ≤ Int, β ≤ Int}) ∨ (Str ▷ {α ≤ Str, β ≤ Str})}. α → β → γ ≤ Bool → ο
//│     π → ρ → σ ≤ Bool → ο
//│       Bool ≤ π
//│         Bool ≤ (Int ▷ {ρ ≤ Int, σ ≥ Int}) ∨ (Str ▷ {ρ ≤ Str, σ ≥ Str})
//│           Bool ≤ Int ▷ {ρ ≤ Int, σ ≥ Int}
//│             Bool ≤ Int
//│               Bool ≤ ⊥
//│                 ⊤ ≤ ⊥
//│           Bool ≤ Str ▷ {ρ ≤ Str, σ ≥ Str}
//│             Bool ≤ Str
//│               Bool ≤ ⊥
//│                 ⊤ ≤ ⊥

fun bar(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ bar: ∀τ, υ, φ ◁ {τ ≤ (Int ▷ {υ ≤ Int, φ ≥ Int}) ∨ (⊤ ▷ {υ ≤ Str, φ ≥ Str}), υ ≤ (Int ▷ {τ ≤ Int, φ ≥ Int}) ∨ (Str ▷ {φ ≥ Str}), φ ≥ (Int ▷ {τ ≤ Int, υ ≤ Int}) ∨ (Str ▷ {υ ≤ Str})}. τ → υ → φ

bar(1, 1)
//│ Int

bar(1, "")
//│ Str

bar("", "")
//│ Str

bar(true, "")
//│ Str

:e
bar(true, 1)
//│ ═══[ERROR] Cannot solve judgment Str → Str ≤ Int → 45.
//│ Typing error tree:
//│   Str → Str ≤ Int → 45
//│     Int ≤ Str
//│       Int ≤ ⊥
//│         ⊤ ≤ ⊥

:e
bar(true, true)
//│ ═══[ERROR] Cannot solve judgment Str → Str ≤ Bool → 50.
//│ Typing error tree:
//│   Str → Str ≤ Bool → 50
//│     Bool ≤ Str
//│       Bool ≤ ⊥
//│         ⊤ ≤ ⊥

