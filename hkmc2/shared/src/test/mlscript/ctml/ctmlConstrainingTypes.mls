:ctml

fun foo(a, b) =
    if a is
        Int then (b as Int)
        Str then (b as Str)
//│ foo: ∀β ◁ {β ≤ Int ∨ Str}. β → ((Int ▷ {δ ≤ Int, β ≤ Int}) ∨ (Str ▷ {δ ≤ Str, β ≤ Str})) → (Int ∨ Str)

foo(1, 2)
//│ TYPE ERROR: Cannot solve type equation ((Str ▷ {δ ≤ Str, β ≤ Str}) → (Int ∨ Str) ▷ {δ ≥ (Str ▷ {δ ≤ Str, β ≤ Str}) → (Int ∨ Str), β ≥ Int}) ∨ ((Int ▷ {δ ≤ Int, β ≤ Int}) → (Int ∨ Str) ▷ {δ ≥ (Int ▷ {δ ≤ Int, β ≤ Int}) → (Int ∨ Str), β ≥ Int}) ≤ Int → β.
//│ Typing error tree:
//│   ((Str ▷ {δ ≤ Str, β ≤ Str}) → (Int ∨ Str) ▷ {δ ≥ (Str ▷ {δ ≤ Str, β ≤ Str}) → (Int ∨ Str), β ≥ Int}) ∨ ((Int ▷ {δ ≤ Int, β ≤ Int}) → (Int ∨ Str) ▷ {δ ≥ (Int ▷ {δ ≤ Int, β ≤ Int}) → (Int ∨ Str), β ≥ Int}) ≤ Int → β
//│     (Str ▷ {δ ≤ Str, β ≤ Str}) → (Int ∨ Str) ▷ {δ ≥ (Str ▷ {δ ≤ Str, β ≤ Str}) → (Int ∨ Str), β ≥ Int} ≤ Int → β
//│       (Str ▷ {δ ≤ Str, β ≤ Str}) → (Int ∨ Str) ≤ Int → β
//│         Int ≤ Str ▷ {δ ≤ Str, β ≤ Str}
//│           Int ≤ Str
//│             ⊤ ≤ Str
//│               ⊤ ≤ ⊥
