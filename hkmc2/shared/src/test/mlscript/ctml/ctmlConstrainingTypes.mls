:ctml

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀α, β, γ. {α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {β ≤ Str, γ ≥ Str}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {α ≤ Str, γ ≥ Str}), γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})} ⟹ α → β → γ

foo(1, 2)
//│ Int

:e
foo(1, "")
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ Str → ι.
//│ Typing error tree:
//│   Int → Int ≤ Str → ι
//│     Str ≤ Int
//│       ⊤ ≤ Int
//│         ⊤ ≤ ⊥

:e
foo(true, false)
//│ ═══[ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {β ≤ Str, γ ≥ Str}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {α ≤ Str, γ ≥ Str}), γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})} ⟹ α → β → γ ≤ Bool → ο.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {β ≤ Str, γ ≥ Str}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {α ≤ Str, γ ≥ Str}), γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})} ⟹ α → β → γ ≤ Bool → ο
//│     ∀β, γ. {π ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {β ≤ Str, γ ≥ Str}), β ≤ (Int ⟹ {π ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {π ≤ Str, γ ≥ Str}), γ ≥ (Int ⟹ {π ≤ Int, β ≤ Int}) ∨ (Str ⟹ {π ≤ Str, β ≤ Str})} ⟹ π → β → γ ≤ Bool → ο
//│       ∀γ. {π ≤ (Int ⟹ {ρ ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {ρ ≤ Str, γ ≥ Str}), ρ ≤ (Int ⟹ {π ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {π ≤ Str, γ ≥ Str}), γ ≥ (Int ⟹ {π ≤ Int, ρ ≤ Int}) ∨ (Str ⟹ {π ≤ Str, ρ ≤ Str})} ⟹ π → ρ → γ ≤ Bool → ο
//│         {π ≤ (Int ⟹ {ρ ≤ Int, σ ≥ Int}) ∨ (Str ⟹ {ρ ≤ Str, σ ≥ Str}), ρ ≤ (Int ⟹ {π ≤ Int, σ ≥ Int}) ∨ (Str ⟹ {π ≤ Str, σ ≥ Str}), σ ≥ (Int ⟹ {π ≤ Int, ρ ≤ Int}) ∨ (Str ⟹ {π ≤ Str, ρ ≤ Str})} ⟹ π → ρ → σ ≤ Bool → ο
//│           π → ρ → σ ≤ Bool → ο
//│             Bool ≤ π
//│               Bool ≤ (Int ⟹ {ρ ≤ Int, σ ≥ Int}) ∨ (Str ⟹ {ρ ≤ Str, σ ≥ Str})
//│                 Bool ≤ Int ⟹ {ρ ≤ Int, σ ≥ Int}
//│                   Bool ≤ Int
//│                     Bool ≤ ⊥
//│                       ⊤ ≤ ⊥
//│                 Bool ≤ Str ⟹ {ρ ≤ Str, σ ≥ Str}
//│                   Bool ≤ Str
//│                     Bool ≤ ⊥
//│                       ⊤ ≤ ⊥

fun bar(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ bar: ∀τ, υ, φ. {τ ≤ (Int ⟹ {υ ≤ Int, φ ≥ Int}) ∨ (⊤ ⟹ {υ ≤ Str, φ ≥ Str}), υ ≤ (Int ⟹ {τ ≤ Int, φ ≥ Int}) ∨ (Str ⟹ {φ ≥ Str}), φ ≥ (Int ⟹ {τ ≤ Int, υ ≤ Int}) ∨ (Str ⟹ {υ ≤ Str})} ⟹ τ → υ → φ

bar(1, 1)
//│ Int

bar(1, "")
//│ Str

bar("", "")
//│ Str

bar(true, "")
//│ Str

:e
bar(true, 1)
//│ ═══[ERROR] Cannot solve judgment Str → Str ≤ Int → 45.
//│ Typing error tree:
//│   Str → Str ≤ Int → 45
//│     Int ≤ Str
//│       Int ≤ ⊥
//│         ⊤ ≤ ⊥

:e
bar(true, true)
//│ ═══[ERROR] Cannot solve judgment Str → Str ≤ Bool → 50.
//│ Typing error tree:
//│   Str → Str ≤ Bool → 50
//│     Bool ≤ Str
//│       Bool ≤ ⊥
//│         ⊤ ≤ ⊥

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)
//│ 60 ≤ Str, 59 ≥ Str, 60 ≥ Str, 59 ≤ Str, 58 ≥ Str, 60 ≥ (Int ⟹ {58 ≤ Int, 59 ≤ Int}) ∨ (Str ⟹ {58 ≤ Str, 59 ≤ Str}), 59 ≤ (Int ⟹ {58 ≤ Int, 60 ≥ Int}) ∨ (Str ⟹ {58 ≤ Str, 60 ≥ Str}), 58 ≤ (Int ⟹ {59 ≤ Int, 60 ≥ Int}) ∨ (Str ⟹ {59 ≤ Str, 60 ≥ Str}), 60 fresh, 59 fresh, 58 fresh, 57 ≤ Int, 56 ≥ Int, 57 ≥ Int, 56 ≤ Int, 55 ≥ Int, 57 ≥ (Int ⟹ {55 ≤ Int, 56 ≤ Int}) ∨ (Str ⟹ {55 ≤ Str, 56 ≤ Str}), 56 ≤ (Int ⟹ {55 ≤ Int, 57 ≥ Int}) ∨ (Str ⟹ {55 ≤ Str, 57 ≥ Str}), 55 ≤ (Int ⟹ {56 ≤ Int, 57 ≥ Int}) ∨ (Str ⟹ {56 ≤ Str, 57 ≥ Str}), 57 fresh, 56 fresh, 55 fresh

foo as (Int -> Int -> Int)
//│ Int → Int → Int
//│ 63 ≤ Int, 62 ≥ Int, 63 ≥ Int, 62 ≤ Int, 61 ≥ Int, 63 ≥ (Int ⟹ {61 ≤ Int, 62 ≤ Int}) ∨ (Str ⟹ {61 ≤ Str, 62 ≤ Str}), 62 ≤ (Int ⟹ {61 ≤ Int, 63 ≥ Int}) ∨ (Str ⟹ {61 ≤ Str, 63 ≥ Str}), 61 ≤ (Int ⟹ {62 ≤ Int, 63 ≥ Int}) ∨ (Str ⟹ {62 ≤ Str, 63 ≥ Str}), 63 fresh, 62 fresh, 61 fresh

foo as (Str -> Str -> Str)
//│ Str → Str → Str
//│ 66 ≤ Str, 65 ≥ Str, 66 ≥ Str, 65 ≤ Str, 64 ≥ Str, 66 ≥ (Int ⟹ {64 ≤ Int, 65 ≤ Int}) ∨ (Str ⟹ {64 ≤ Str, 65 ≤ Str}), 65 ≤ (Int ⟹ {64 ≤ Int, 66 ≥ Int}) ∨ (Str ⟹ {64 ≤ Str, 66 ≥ Str}), 64 ≤ (Int ⟹ {65 ≤ Int, 66 ≥ Int}) ∨ (Str ⟹ {65 ≤ Str, 66 ≥ Str}), 66 fresh, 65 fresh, 64 fresh

