:ctml

fun foo(a, b) =
    if a is
        Int then (b as Int)
        Str then (b as Str)
//│ foo: ∀α, β ◁ {α ≤ (Int ▷ {β ≤ Int}) ∨ (Str ▷ {β ≤ Str}), β ≤ (Int ▷ {α ≤ Int}) ∨ (Str ▷ {α ≤ Str})}. α → β → (Int ∨ Str)

foo(1, 2)
//│ TYPE ERROR: Type variable 'β' not found in the clauses.
//│ Typing error tree:
//│   β → (Int ∨ Str) ≤ Int → α
//│     Int ≤ β

""
//│ Str
