:ctml

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀α, β, γ ◁ {α ≤ (Int ▷ {γ ≥ Int, β ≤ Int}) ∨ (Str ▷ {γ ≥ Str, β ≤ Str}), β ≤ (Int ▷ {γ ≥ Int, α ≤ Int}) ∨ (Str ▷ {γ ≥ Str, α ≤ Str}), γ ≥ (Int ▷ {β ≤ Int, α ≤ Int}) ∨ (Str ▷ {β ≤ Str, α ≤ Str})}. α → β → γ

foo(1, 2)
//│ ∀α, β ◁ {α ≥ Int, α ≤ Int ∨ (Int ▷ {β ≤ Int}) ∨ (Str ▷ {β ≤ Str}), β ≥ Int, β ≤ Int ∨ (Int ▷ {α ≤ Int}) ∨ (Str ▷ {α ≤ Str})}. Int ∨ (Int ▷ {β ≤ Int, α ≤ Int}) ∨ (Str ▷ {β ≤ Str, α ≤ Str})

:e
foo(1, "")
//│ ═══[ERROR] Cannot solve type equation ∀α, β, γ ◁ {α ≥ Int, α ≤ (Int ▷ {γ ≥ Int, β ≤ Int}) ∨ (Str ▷ {γ ≥ Str, β ≤ Str}), β ≤ Int ∧ ((Int ▷ {γ ≥ Int, α ≤ Int}) ∨ (Str ▷ {γ ≥ Str, α ≤ Str})), γ ≥ Int ∨ (Int ▷ {β ≤ Int, α ≤ Int}) ∨ (Str ▷ {β ≤ Str, α ≤ Str})}. β → γ ≤ Str → ζ.
//│ Typing error tree:
//│   ∀α, β, γ ◁ {α ≥ Int, α ≤ (Int ▷ {γ ≥ Int, β ≤ Int}) ∨ (Str ▷ {γ ≥ Str, β ≤ Str}), β ≤ Int ∧ ((Int ▷ {γ ≥ Int, α ≤ Int}) ∨ (Str ▷ {γ ≥ Str, α ≤ Str})), γ ≥ Int ∨ (Int ▷ {β ≤ Int, α ≤ Int}) ∨ (Str ▷ {β ≤ Str, α ≤ Str})}. β → γ ≤ Str → ζ
//│     β → γ ≤ Str → ζ
//│       Str ≤ β
//│         Str ≤ Int ∧ ((Int ▷ {γ ≥ Int, α ≤ Int}) ∨ (Str ▷ {γ ≥ Str, α ≤ Str}))
//│           Str ≤ Int ∧ (Str ▷ {γ ≥ Str, α ≤ Str})
//│             Str ≤ Int
//│               Str ≤ ⊥
//│                 ⊤ ≤ ⊥
//│           Str ≤ Int ∧ (Int ▷ {γ ≥ Int, α ≤ Int})
//│             Str ≤ Int
//│               Str ≤ ⊥
//│                 ⊤ ≤ ⊥

:e
foo(true, false)
//│ ═══[ERROR] Cannot solve type equation ∀α, β, γ ◁ {α ≤ (Int ▷ {γ ≥ Int, β ≤ Int}) ∨ (Str ▷ {γ ≥ Str, β ≤ Str}), β ≤ (Int ▷ {γ ≥ Int, α ≤ Int}) ∨ (Str ▷ {γ ≥ Str, α ≤ Str}), γ ≥ (Int ▷ {β ≤ Int, α ≤ Int}) ∨ (Str ▷ {β ≤ Str, α ≤ Str})}. α → β → γ ≤ Bool → ι.
//│ Typing error tree:
//│   ∀α, β, γ ◁ {α ≤ (Int ▷ {γ ≥ Int, β ≤ Int}) ∨ (Str ▷ {γ ≥ Str, β ≤ Str}), β ≤ (Int ▷ {γ ≥ Int, α ≤ Int}) ∨ (Str ▷ {γ ≥ Str, α ≤ Str}), γ ≥ (Int ▷ {β ≤ Int, α ≤ Int}) ∨ (Str ▷ {β ≤ Str, α ≤ Str})}. α → β → γ ≤ Bool → ι
//│     α → β → γ ≤ Bool → ι
//│       Bool ≤ α
//│         Bool ≤ (Int ▷ {γ ≥ Int, β ≤ Int}) ∨ (Str ▷ {γ ≥ Str, β ≤ Str})
//│           Bool ≤ Str ▷ {γ ≥ Str, β ≤ Str}
//│             Bool ≤ Str
//│               ⊤ ≤ Str
//│                 ⊤ ≤ ⊥
//│           Bool ≤ Int ▷ {γ ≥ Int, β ≤ Int}
//│             Bool ≤ Int
//│               Bool ≤ ⊥
//│                 ⊤ ≤ ⊥

fun bar(a, b) =
  if a is
    Int then (b as Int)
    Top then (b as Str)
//│ bar: ∀κ, λ, μ ◁ {κ ≤ (Int ▷ {μ ≥ Int, λ ≤ Int}) ∨ (⊤ ▷ {μ ≥ Str, λ ≤ Str}), λ ≤ (Int ▷ {μ ≥ Int, κ ≤ Int}) ∨ (Str ▷ {μ ≥ Str}), μ ≥ (Int ▷ {λ ≤ Int, κ ≤ Int}) ∨ (Str ▷ {λ ≤ Str})}. κ → λ → μ

bar(1, 1)
//│ ∀κ, λ ◁ {κ ≥ Int, κ ≤ Int ∨ (Int ▷ {λ ≤ Int}) ∨ (⊤ ▷ {λ ≤ Str}), λ ≥ Int, λ ≤ (Int ▷ {κ ≤ Int}) ∨ Str}. Int ∨ ((Str ▷ {λ ≤ Str}) ∨ (Int ▷ {λ ≤ Int})) ∨ (Int ▷ {λ ≤ Int, κ ≤ Int}) ∨ (Str ▷ {λ ≤ Str})

bar(1, "")
//│ ∀κ, λ ◁ {κ ≥ Int, κ ≤ (Int ▷ {λ ≤ Int}) ∨ (⊤ ▷ {λ ≤ Str}), λ ≥ Str, λ ≤ (Int ▷ {κ ≤ Int}) ∨ Str}. Str ∨ ((Str ▷ {λ ≤ Str}) ∨ (Int ▷ {λ ≤ Int})) ∨ (Int ▷ {λ ≤ Int, κ ≤ Int}) ∨ (Str ▷ {λ ≤ Str})

bar("", "")
//│ ∀κ, λ ◁ {κ ≥ Str, κ ≤ (Int ▷ {λ ≤ Int}) ∨ (⊤ ▷ {λ ≤ Str}), λ ≥ Str, λ ≤ Str}. Str ∨ (Int ▷ {λ ≤ Int, κ ≤ Int}) ∨ (Str ▷ {λ ≤ Str})

bar(true, "")
//│ ∀κ, λ ◁ {κ ≥ Bool, κ ≤ (Int ▷ {λ ≤ Int}) ∨ (⊤ ▷ {λ ≤ Str}), λ ≥ Str, λ ≤ Str}. Str ∨ (Int ▷ {λ ≤ Int, κ ≤ Int}) ∨ (Str ▷ {λ ≤ Str})

:e
bar(true, 1)
//│ ═══[ERROR] Cannot solve type equation ∀κ, λ, μ ◁ {κ ≥ Bool, κ ≤ (Int ▷ {μ ≥ Int, λ ≤ Int}) ∨ (⊤ ▷ {μ ≥ Str, λ ≤ Str}), λ ≤ Str, μ ≥ Str ∨ (Int ▷ {λ ≤ Int, κ ≤ Int}) ∨ (Str ▷ {λ ≤ Str})}. λ → μ ≤ Int → φ.
//│ Typing error tree:
//│   ∀κ, λ, μ ◁ {κ ≥ Bool, κ ≤ (Int ▷ {μ ≥ Int, λ ≤ Int}) ∨ (⊤ ▷ {μ ≥ Str, λ ≤ Str}), λ ≤ Str, μ ≥ Str ∨ (Int ▷ {λ ≤ Int, κ ≤ Int}) ∨ (Str ▷ {λ ≤ Str})}. λ → μ ≤ Int → φ
//│     λ → μ ≤ Int → φ
//│       Int ≤ λ
//│         Int ≤ Str
//│           ⊤ ≤ Str
//│             ⊤ ≤ ⊥

:e
bar(true, true)
//│ ═══[ERROR] Cannot solve type equation ∀κ, λ, μ ◁ {κ ≥ Bool, κ ≤ (Int ▷ {μ ≥ Int, λ ≤ Int}) ∨ (⊤ ▷ {μ ≥ Str, λ ≤ Str}), λ ≤ Str, μ ≥ Str ∨ (Int ▷ {λ ≤ Int, κ ≤ Int}) ∨ (Str ▷ {λ ≤ Str})}. λ → μ ≤ Bool → ψ.
//│ Typing error tree:
//│   ∀κ, λ, μ ◁ {κ ≥ Bool, κ ≤ (Int ▷ {μ ≥ Int, λ ≤ Int}) ∨ (⊤ ▷ {μ ≥ Str, λ ≤ Str}), λ ≤ Str, μ ≥ Str ∨ (Int ▷ {λ ≤ Int, κ ≤ Int}) ∨ (Str ▷ {λ ≤ Str})}. λ → μ ≤ Bool → ψ
//│     λ → μ ≤ Bool → ψ
//│       Bool ≤ λ
//│         Bool ≤ Str
//│           ⊤ ≤ Str
//│             ⊤ ≤ ⊥
