:ctml

fun foo(a, b) =
    if a is
        Int then (b as Int)
        Str then (b as Str)
//│ INLINE NEGATIVE β fresh IN β → δ → (Int ∨ Str) WITH Int ∨ Str
//│ QUANTIFY δ fresh IN (Int ∨ Str) → δ → (Int ∨ Str)
//│ foo: ∀δ ◁ {δ ≤ (Int ▷ {δ ≤ Int, β ≤ Int}) ∨ (Str ▷ {δ ≤ Str, β ≤ Str})}. (Int ∨ Str) → δ → (Int ∨ Str)

foo(1, 2)
//│ INLINE POSITIVE δ fresh IN δ WITH δ → (Int ∨ Str)
