//│     ∀α, β. {70 ≤ (Int ⟹ {α ≤ Int, β ≥ Int}) ∨ (Str ⟹ {α ≤ Str, β ≥ Str}), α ≤ (Int ⟹ {70 ≤ Int, β ≥ Int}) ∨ (Str ⟹ {70 ≤ Str, β ≥ Str}), β ≥ (Int ⟹ {70 ≤ Int, α ≤ Int}) ∨ (Str ⟹ {70 ≤ Str, α ≤ Str})} ⟹ 70 → α → β ≤ Bool → Bool → Bool
//│       ∀α. {70 ≤ (Int ⟹ {71 ≤ Int, α ≥ Int}) ∨ (Str ⟹ {71 ≤ Str, α ≥ Str}), 71 ≤ (Int ⟹ {70 ≤ Int, α ≥ Int}) ∨ (Str ⟹ {70 ≤ Str, α ≥ Str}), α ≥ (Int ⟹ {70 ≤ Int, 71 ≤ Int}) ∨ (Str ⟹ {70 ≤ Str, 71 ≤ Str})} ⟹ 70 → 71 → α ≤ Bool → Bool → Bool
