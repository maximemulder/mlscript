:ctml

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀α, β, γ. {α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {β ≤ Str, γ ≥ Str}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {α ≤ Str, γ ≥ Str}), γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})} ⟹ α → β → γ

foo(1, 2)
//│ Int

:e
foo(1, "")
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ Str → α.
//│ Typing error tree:
//│   Int → Int ≤ Str → α
//│     Str ≤ Int
//│       ⊤ ≤ Int
//│         ⊤ ≤ ⊥

:e
foo(true, false)
//│ ═══[ERROR] Cannot solve judgment Str → Str ≤ Bool → α.
//│ Typing error tree:
//│   Str → Str ≤ Bool → α
//│     Bool ≤ Str
//│       Bool ≤ ⊥
//│         ⊤ ≤ ⊥

fun bar(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ bar: ∀α, β, γ. {α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (⊤ ⟹ {β ≤ Str, γ ≥ Str}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {γ ≥ Str}), γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {β ≤ Str})} ⟹ α → β → γ

bar(1, 1)
//│ Int

bar(1, "")
//│ Str

bar("", "")
//│ Str

bar(true, "")
//│ Str

:e
bar(true, 1)
