//│ ⊥ → ⊥ → ⊤
//│ 69 ≥ (Int ⟹ {67 ≤ Int, 68 ≤ Int}) ∨ (Str ⟹ {67 ≤ Str, 68 ≤ Str}), 68 ≤ (Int ⟹ {67 ≤ Int, 69 ≥ Int}) ∨ (Str ⟹ {67 ≤ Str, 69 ≥ Str}), 67 ≤ (Int ⟹ {68 ≤ Int, 69 ≥ Int}) ∨ (Str ⟹ {68 ≤ Str, 69 ≥ Str}), 69 fresh, 68 fresh, 67 fresh

:e
foo as (Bool -> Bool -> Bool)
//│ ═══[ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {β ≤ Str, γ ≥ Str}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {α ≤ Str, γ ≥ Str}), γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})} ⟹ α → β → γ ≤ Bool → Bool → Bool.
