:ctml

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀α, β, γ. {α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {β ≤ Str, γ ≥ Str}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {α ≤ Str, γ ≥ Str}), γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})} ⟹ α → β → γ

foo(1, 2)
//│ Int

:e
foo(1, "")
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ Str → 8.
//│ Typing error tree:
//│   Int → Int ≤ Str → 8
//│     Str ≤ Int
//│       ⊤ ≤ Int
//│         ⊤ ≤ ⊥

:e
foo(true, false)
//│ ═══[ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {β ≤ Str, γ ≥ Str}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {α ≤ Str, γ ≥ Str}), γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})} ⟹ α → β → γ ≤ Bool → 14.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {β ≤ Str, γ ≥ Str}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {α ≤ Str, γ ≥ Str}), γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})} ⟹ α → β → γ ≤ Bool → 14
//│     ∀α, β. {15 ≤ (Int ⟹ {α ≤ Int, β ≥ Int}) ∨ (Str ⟹ {α ≤ Str, β ≥ Str}), α ≤ (Int ⟹ {15 ≤ Int, β ≥ Int}) ∨ (Str ⟹ {15 ≤ Str, β ≥ Str}), β ≥ (Int ⟹ {15 ≤ Int, α ≤ Int}) ∨ (Str ⟹ {15 ≤ Str, α ≤ Str})} ⟹ 15 → α → β ≤ Bool → 14
//│       ∀α. {15 ≤ (Int ⟹ {16 ≤ Int, α ≥ Int}) ∨ (Str ⟹ {16 ≤ Str, α ≥ Str}), 16 ≤ (Int ⟹ {15 ≤ Int, α ≥ Int}) ∨ (Str ⟹ {15 ≤ Str, α ≥ Str}), α ≥ (Int ⟹ {15 ≤ Int, 16 ≤ Int}) ∨ (Str ⟹ {15 ≤ Str, 16 ≤ Str})} ⟹ 15 → 16 → α ≤ Bool → 14
//│         {15 ≤ (Int ⟹ {16 ≤ Int, 17 ≥ Int}) ∨ (Str ⟹ {16 ≤ Str, 17 ≥ Str}), 16 ≤ (Int ⟹ {15 ≤ Int, 17 ≥ Int}) ∨ (Str ⟹ {15 ≤ Str, 17 ≥ Str}), 17 ≥ (Int ⟹ {15 ≤ Int, 16 ≤ Int}) ∨ (Str ⟹ {15 ≤ Str, 16 ≤ Str})} ⟹ 15 → 16 → 17 ≤ Bool → 14
//│           15 → 16 → 17 ≤ Bool → 14
//│             Bool ≤ 15
//│               Bool ≤ (Int ⟹ {16 ≤ Int, 17 ≥ Int}) ∨ (Str ⟹ {16 ≤ Str, 17 ≥ Str})
//│                 Bool ≤ Int ⟹ {16 ≤ Int, 17 ≥ Int}
//│                   Bool ≤ Int
//│                     Bool ≤ ⊥
//│                       ⊤ ≤ ⊥
//│                 Bool ≤ Str ⟹ {16 ≤ Str, 17 ≥ Str}
//│                   Bool ≤ Str
//│                     Bool ≤ ⊥
//│                       ⊤ ≤ ⊥

fun bar(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ bar: ∀α, β, γ. {α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (⊤ ⟹ {β ≤ Str, γ ≥ Str}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {γ ≥ Str}), γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {β ≤ Str})} ⟹ α → β → γ

bar(1, 1)
//│ Int

bar(1, "")
//│ Str

bar("", "")
//│ Str

bar(true, "")
//│ Str

:e
bar(true, 1)
//│ ═══[ERROR] Cannot solve judgment Str → Str ≤ Int → 45.
//│ Typing error tree:
//│   Str → Str ≤ Int → 45
//│     Int ≤ Str
//│       Int ≤ ⊥
//│         ⊤ ≤ ⊥

:e
bar(true, true)
//│ ═══[ERROR] Cannot solve judgment Str → Str ≤ Bool → 50.
//│ Typing error tree:
//│   Str → Str ≤ Bool → 50
//│     Bool ≤ Str
//│       Bool ≤ ⊥
//│         ⊤ ≤ ⊥

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)
//│ 60 ≤ Str, 59 ≥ Str, 60 ≥ Str, 59 ≤ Str, 58 ≥ Str, 60 ≥ (Int ⟹ {58 ≤ Int, 59 ≤ Int}) ∨ (Str ⟹ {58 ≤ Str, 59 ≤ Str}), 59 ≤ (Int ⟹ {58 ≤ Int, 60 ≥ Int}) ∨ (Str ⟹ {58 ≤ Str, 60 ≥ Str}), 58 ≤ (Int ⟹ {59 ≤ Int, 60 ≥ Int}) ∨ (Str ⟹ {59 ≤ Str, 60 ≥ Str}), 60 fresh, 59 fresh, 58 fresh, 57 ≤ Int, 56 ≥ Int, 57 ≥ Int, 56 ≤ Int, 55 ≥ Int, 57 ≥ (Int ⟹ {55 ≤ Int, 56 ≤ Int}) ∨ (Str ⟹ {55 ≤ Str, 56 ≤ Str}), 56 ≤ (Int ⟹ {55 ≤ Int, 57 ≥ Int}) ∨ (Str ⟹ {55 ≤ Str, 57 ≥ Str}), 55 ≤ (Int ⟹ {56 ≤ Int, 57 ≥ Int}) ∨ (Str ⟹ {56 ≤ Str, 57 ≥ Str}), 57 fresh, 56 fresh, 55 fresh

foo as (Int -> Int -> Int)
//│ Int → Int → Int
//│ 63 ≤ Int, 62 ≥ Int, 63 ≥ Int, 62 ≤ Int, 61 ≥ Int, 63 ≥ (Int ⟹ {61 ≤ Int, 62 ≤ Int}) ∨ (Str ⟹ {61 ≤ Str, 62 ≤ Str}), 62 ≤ (Int ⟹ {61 ≤ Int, 63 ≥ Int}) ∨ (Str ⟹ {61 ≤ Str, 63 ≥ Str}), 61 ≤ (Int ⟹ {62 ≤ Int, 63 ≥ Int}) ∨ (Str ⟹ {62 ≤ Str, 63 ≥ Str}), 63 fresh, 62 fresh, 61 fresh

