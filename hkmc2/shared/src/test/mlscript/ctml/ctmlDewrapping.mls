:ctml

:ctml-cfg error-absurd-constred no-wrap-ifs dewrap-ucs-ifs

// Removing CTML's variable wrapper lets bounds reach the enclosing source lambda.

fun direct(a) = if a is Int then 1 else "s"
//│ direct: ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Str), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ Int)} ⟹ α → β

direct(1) as Int
//│ Int

direct("s") as Str
//│ Str

direct as (Int -> Int) & (Str -> Str)
//│ (Int → Int) ∧ (Str → Str)

:te
direct as (Int -> Str)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Str), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ Int)} ⟹ α → β ≤ Int → Str.
//│ Typing error tree:
//│   ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Str), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ Int)} ⟹ α → β ≤ Int → Str
//│     {δ ≥ ({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ ¬Int} ⟹ Str), γ ≤ ¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≥ Str} ⟹ Int)} ⟹ γ → δ ≤ Int → Str
//│       {γ ≤ ¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≥ Str} ⟹ Int)} ⟹ γ → δ ≤ Int → Str
//│         γ ≤ ¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≥ Str} ⟹ Int)
//│           Int ≤ ¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≥ Str} ⟹ Int)
//│             Int ≤ ¬({δ ≥ Int} ⟹ ¬Int)
//│               Int ≤ δ
//│                 Int ≤ Str
//│             Int ≤ ¬({δ ≥ Str} ⟹ Int)
//│               Int ≤ ¬Int

// A single-use UCS binding can be removed even when its argument is a computation.

fun id(a) = a
//│ id: ∀α. α → α

fun computed(a) = if id(a) is Int then 1 else "s"
//│ computed: ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Str), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ Int)} ⟹ α → β

computed(1) as Int
//│ Int

computed("s") as Str
//│ Str

computed(true) as Str
//│ Str

computed as (Int -> Int) & (Str -> Str)
//│ (Int → Int) ∧ (Str → Str)

:te
computed as (Int -> Str)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Str), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ Int)} ⟹ α → β ≤ Int → Str.
//│ Typing error tree:
//│   ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Str), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ Int)} ⟹ α → β ≤ Int → Str
//│     {δ ≥ ({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ ¬Int} ⟹ Str), γ ≤ ¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≥ Str} ⟹ Int)} ⟹ γ → δ ≤ Int → Str
//│       {γ ≤ ¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≥ Str} ⟹ Int)} ⟹ γ → δ ≤ Int → Str
//│         γ ≤ ¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≥ Str} ⟹ Int)
//│           Int ≤ ¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≥ Str} ⟹ Int)
//│             Int ≤ ¬({δ ≥ Int} ⟹ ¬Int)
//│               Int ≤ δ
//│                 Int ≤ Str
//│             Int ≤ ¬({δ ≥ Str} ⟹ Int)
//│               Int ≤ ¬Int

// Removing a UCS binding exposes the ascribed concrete type instead of a flexible proxy.

:fixme // FIXME: De-wrapping a concrete union scrutinee loses its refinable proxy.
if (1 as Int | Str) is Int then 1 else "s"
//│ ═══[TYPE ERROR] Cannot solve judgment Int ∨ Str ≤ Int.
//│ Typing error tree:
//│   Int ∨ Str ≤ Int
//│     Str ≤ Int

// A concrete literal also lacks a proxy for recording an impossible alternative's bound.

:fixme // FIXME: De-wrapping checks the unreachable Str alternative against the concrete Int.
if 1 is
  Int then 1
  Str then "s"
//│ ═══[TYPE ERROR] Cannot solve judgment Int ≤ ¬Int.
//│ Typing error tree:
//│   Int ≤ ¬Int

// Keeping UCS bindings restores the accepted union match, independently of CTML's wrapper.

:ctml-cfg wrap-ucs-ifs

if (1 as Int | Str) is Int then 1 else "s"
//│ Int ∨ Str

:ctml-cfg dewrap-ucs-ifs

// Repeated tests of a computed scrutinee retain the UCS binding and its single evaluation.

fun multi(a) = if id(a) is
  Int then 1
  Str then "s"
//│ multi: ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ ¬Str)} ⟹ α → β

multi(1) as Int
//│ Int

multi("s") as Str
//│ Str

:te
multi(true)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ ¬Str)} ⟹ α → β ≤ Bool → γ.
//│ Typing error tree:
//│   ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ ¬Str)} ⟹ α → β ≤ Bool → γ
//│     {ε ≥ ({δ ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str), δ ≤ ¬({ε ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≥ Str} ⟹ ¬Str)} ⟹ δ → ε ≤ Bool → γ
//│       {δ ≤ ¬({ε ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≥ Str} ⟹ ¬Str)} ⟹ δ → ε ≤ Bool → γ
//│         δ ≤ ¬({ε ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≥ Str} ⟹ ¬Str)
//│           Bool ≤ ¬({ε ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≥ Str} ⟹ ¬Str)
//│             Bool ≤ ¬({ε ≥ Int} ⟹ ¬Int)
//│               ¬Int ≤ ¬Bool
//│                 Bool ≤ Int
//│             Bool ≤ ¬({ε ≥ Str} ⟹ ¬Str)
//│               ¬Str ≤ ¬Bool
//│                 Bool ≤ Str

// Shadowing in a branch remains local when an ascribed variable scrutinee is substituted.

fun shadow(a) = if (a as Int) is Int then (a => a)("s")
//│ shadow: Int → Str

shadow(1) as Str
//│ Str

// A lambda application supplied by the user keeps its own inference boundary.

fun explicit(a) = (u => (if a is Int then 1 else "s"))(unit)
//│ explicit: ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Str), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ Int)} ⟹ α → β

explicit(1) as Int
//│ Int

explicit("s") as Str
//│ Str

// An ordinary source let preserves its binding, independently of conditional de-wrapping.

fun sourceLet(a) =
  let x = id(a)
  if x is Int then 1 else "s"
//│ sourceLet: ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Str), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ Int)} ⟹ α → β

sourceLet(1) as Int
//│ Int

sourceLet("s") as Str
//│ Str

// Traces distinguish direct UCS scrutinees from computations whose bindings must be retained.

:ctml-dbg infer depth 0

if 1 is Int then 1
//│ ...
//│ infer EMatch(EVar(int),Int,EVar(int),None)
//│ ...
//│ OK Int ⇝ ∅
//│ ...
//│ LEVEL CLAUSES (1) Int OUT ∅
//│ ...
//│ LEVEL UNWRAP Int OUT ∅
//│ ...
//│ LEVEL SIMPLIFY TYPE Int OUT ∅
//│ ...
//│ LEVEL WRAP TYPE Int
//│ ...
//│ LEVEL SIMPLIFY Int OUT ∅
//│ ...
//│ LEVEL RESULT Int
//│ Int

if id(1) is Int then 1
//│ ...
//│ infer EMatch(EApp(EVar(id),EVar(int)),Int,EVar(int),None)
//│ ...
//│ OK Int ⇝ eff 117 ≤ Int, 117 ≤ Int, eff 119 ≤ 117, 119 ≤ 117, eff 117 ≥ Int, 117 ≥ Int, eff 119 ≥ Int, 119 ≥ Int, 119 flex (2), 117 flex (1)
//│ ...
//│ LEVEL CLAUSES (1) Int OUT 117 ≤ Int, 119 ≤ 117, 117 ≥ Int, 119 ≥ Int, 119 flex (2), 117 flex (1)
//│ ...
//│ LEVEL UNWRAP Int OUT ∅
//│ ...
//│ LEVEL SIMPLIFY TYPE Int OUT ∅
//│ ...
//│ LEVEL WRAP TYPE Int
//│ ...
//│ LEVEL SIMPLIFY Int OUT ∅
//│ ...
//│ LEVEL RESULT Int
//│ Int

if id(1) is
  Int then 1
  Str then "s"
//│ ...
//│ infer EApp(ELam(Some(LambdaParam(scrut,None)),EMatch(EVar(scrut),Int,EVar(int),Some(EMatch(EVar(scrut),Str,EVar(string),None)))),EApp(EVar(id),EVar(int)))
//│ ...
//│ OK 125 ⇝ eff 127 ≤ ¬({128 ≥ Int} ⟹ ¬Int) ∨ ¬({128 ≥ Str} ⟹ ¬(Str ∧ ¬Int)), 127 ≤ ¬({128 ≥ Int} ⟹ ¬Int) ∨ ¬({128 ≥ Str} ⟹ ¬(Str ∧ ¬Int)), eff 122 ≤ ¬({128 ≥ Int} ⟹ ¬Int) ∨ ¬({128 ≥ Str} ⟹ ¬(Str ∧ ¬Int)), 122 ≤ ¬({128 ≥ Int} ⟹ ¬Int) ∨ ¬({128 ≥ Str} ⟹ ¬(Str ∧ ¬Int)), eff 128 ≥ (({127 ≤ Int} ⟹ Int) ∧ ({127 ≤ Str ∧ ¬Int} ⟹ Str)) ∨ Int, 128 ≥ Int, eff 125 ≥ (({127 ≤ Int} ⟹ Int) ∧ ({127 ≤ Str ∧ ¬Int} ⟹ Str)) ∨ Int, 125 ≥ Int, eff 128 ≥ ({127 ≤ Int} ⟹ Int) ∧ ({127 ≤ Str ∧ ¬Int} ⟹ Str), 128 ≥ ({127 ≤ Int} ⟹ Int) ∧ ({127 ≤ Str ∧ ¬Int} ⟹ Str), eff 125 ≥ ({127 ≤ Int} ⟹ Int) ∧ ({127 ≤ Str ∧ ¬Int} ⟹ Str), 125 ≥ ({127 ≤ Int} ⟹ Int) ∧ ({127 ≤ Str ∧ ¬Int} ⟹ Str), eff 128 ≤ 125, 128 ≤ 125, eff 127 ≥ 122, 127 ≥ 122, 128 flex (2), 127 flex (2), 125 flex (1), eff 124 ≤ 122, 124 ≤ 122, eff 122 ≥ Int, 122 ≥ Int, eff 124 ≥ Int, 124 ≥ Int, 124 flex (2), 122 flex (1)
//│ ...
//│ LEVEL CLAUSES (1) 125 OUT 127 ≤ ¬({128 ≥ Int} ⟹ ¬Int) ∨ ¬({128 ≥ Str} ⟹ ¬(Str ∧ ¬Int)), 122 ≤ ¬({128 ≥ Int} ⟹ ¬Int) ∨ ¬({128 ≥ Str} ⟹ ¬(Str ∧ ¬Int)), 128 ≥ (({127 ≤ Int} ⟹ Int) ∧ ({127 ≤ Str ∧ ¬Int} ⟹ Str)) ∨ Int, 125 ≥ (({127 ≤ Int} ⟹ Int) ∧ ({127 ≤ Str ∧ ¬Int} ⟹ Str)) ∨ Int, 128 ≤ 125, 127 ≥ 122, 128 flex (2), 127 flex (2), 125 flex (1), 124 ≤ 122, 122 ≥ Int, 124 ≥ Int, 124 flex (2), 122 flex (1)
//│ ...
//│ LEVEL UNWRAP 125 OUT ∅
//│ ...
//│ LEVEL SIMPLIFY TYPE 125 OUT ∅
//│ ...
//│ LEVEL WRAP TYPE 125
//│ ...
//│ LEVEL SIMPLIFY Int OUT ∅
//│ ...
//│ LEVEL RESULT Int
//│ Int
