:ctml

type Z
type S

fun wf: ((Z, Z) -> Z) & ((Z, S) -> S) & ((S, Z | S) -> S)
//│ wf: ((Z → Z → Z) ∧ (Z → S → S)) ∧ (S → (Z ∨ S) → S)

val zs: Z | S
//│ zs: Z ∨ S

wf(zs, zs)
//│ ∀α, β, γ. {γ ≤ S → α, γ ≥ (((Z → Z) ∧ (S → S)) ∨ (Z → S)) ∧ (S → S), β ≤ Z → α, α ≥ Z ∨ S, α ≥ Z, β ≥ (((Z → Z) ∧ (S → S)) ∨ (Z → S)) ∧ (S → S)} ⟹ α
//│1

type A
type B
type C
type D

(A -> (B & C)) == ((A -> B) & (A -> C))
//│ OK

((A | B) -> C) == ((A -> C) & (B -> C))
//│ OK

((A | B) -> (C & D)) <:< ((A -> C) & (B -> D))
//│ OK

((A -> C) & (B -> D)) <:< ((A | B) -> (C | D))
//│ OK

((A -> C) & (B -> D)) <:< ((A & B) -> (C | D))
//│ OK

((A -> C) & (B -> D)) <:< ((A & B) -> (C & D))
//│ OK

:te
((A -> C) & (B -> D)) <:< ((A | B) -> (C & D))
//│ ═══[TYPE ERROR] Cannot solve judgment (A → C) ∧ (B → D) ≤ (A ∨ B) → (C ∧ D).
//│ Typing error tree:
//│   (A → C) ∧ (B → D) ≤ (A ∨ B) → (C ∧ D)
//│     (A → C) ∧ (B → D) ≤ A → (C ∧ D)
//│       (A → C) ∧ (B → D) ≤ A → D
//│         A → C ≤ A → D
//│           C ≤ D
//│             C ≤ ⊥
//│               ⊤ ≤ ⊥
//│         B → D ≤ A → D
//│           A ≤ B
//│             A ≤ ⊥
//│               ⊤ ≤ ⊥

:te
((A | B) -> (C | D)) <:< ((A -> C) & (B -> D))
//│ ═══[TYPE ERROR] Cannot solve judgment (A ∨ B) → (C ∨ D) ≤ (A → C) ∧ (B → D).
//│ Typing error tree:
//│   (A ∨ B) → (C ∨ D) ≤ (A → C) ∧ (B → D)
//│     (A ∨ B) → (C ∨ D) ≤ A → C
//│       A → (C ∨ D) ≤ A → C
//│         C ∨ D ≤ C
//│           D ≤ C
//│             ⊤ ≤ C
//│               ⊤ ≤ ⊥
//│       B → (C ∨ D) ≤ A → C
//│         A ≤ B
//│           A ≤ ⊥
//│             ⊤ ≤ ⊥

:te
((A & B) -> (C | D)) <:< ((A -> C) & (B -> D))
//│ ═══[TYPE ERROR] Cannot solve judgment (A ∧ B) → (C ∨ D) ≤ (A → C) ∧ (B → D).
//│ Typing error tree:
//│   (A ∧ B) → (C ∨ D) ≤ (A → C) ∧ (B → D)
//│     (A ∧ B) → (C ∨ D) ≤ A → C
//│       A ≤ A ∧ B
//│         A ≤ B
//│           A ≤ ⊥
//│             ⊤ ≤ ⊥

:te
((A & B) -> (C & D)) <:< ((A -> C) & (B -> D))
//│ ═══[TYPE ERROR] Cannot solve judgment (A ∧ B) → (C ∧ D) ≤ (A → C) ∧ (B → D).
//│ Typing error tree:
//│   (A ∧ B) → (C ∧ D) ≤ (A → C) ∧ (B → D)
//│     (A ∧ B) → (C ∧ D) ≤ A → C
//│       (A ∧ B) → C ≤ A → C
//│         A ≤ A ∧ B
//│           A ≤ B
//│             A ≤ ⊥
//│               ⊤ ≤ ⊥
//│       (A ∧ B) → D ≤ A → C
//│         A ≤ A ∧ B
//│           A ≤ B
//│             A ≤ ⊥
//│               ⊤ ≤ ⊥
