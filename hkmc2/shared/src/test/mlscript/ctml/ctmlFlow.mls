//│     ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬({β ≥ Str} ⟹ ¬Str)} ⟹ Str ∧ ({α ≤ ⊥} ⟹ ⊥)), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥), β ≥ Str} ⟹ ¬Str)} ⟹ α → β ≤ Bool → Bool
//│       {δ ≥ ({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ ¬({δ ≥ Str} ⟹ ¬Str)} ⟹ Str ∧ ({γ ≤ ⊥} ⟹ ⊥)), γ ≤ ¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({γ ≤ ⊥} ⟹ ⊥), δ ≥ Str} ⟹ ¬Str)} ⟹ γ → δ ≤ Bool → Bool
//│         {γ ≤ ¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({γ ≤ ⊥} ⟹ ⊥), δ ≥ Str} ⟹ ¬Str)} ⟹ γ → δ ≤ Bool → Bool
//│           γ → δ ≤ Bool → Bool
