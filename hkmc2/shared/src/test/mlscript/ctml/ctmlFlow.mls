:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence

// Unique parameter

// Function definitions

fun foo(a) =
  if a is
    Int then (a as Int)
    Str then (a as Str)
//│ foo: ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬({β ≥ Str} ⟹ ¬Str)} ⟹ Str ∧ ({α ≤ ⊥} ⟹ ⊥)), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥), β ≥ Str} ⟹ ¬Str)} ⟹ α → β

// FIXME: The inferred type is not simplified to `Int → Int`.
fun bar(a) =
  foo(a) as Int
//│ bar: ∀α, β, γ. {β ≥ α, γ ≤ Int, β ≤ ¬({α ≤ Int} ⟹ ¬Int) ∧ ¬({γ ≥ Int} ⟹ ¬Int), γ ≥ Int} ⟹ α → Int

// Function overloads

foo as (Int -> Int) & (Str -> Str)
//│ (Int → Int) ∧ (Str → Str)

// Function applications

val int_or_string: Int | Str
//│ int_or_string: Int ∨ Str

foo(1)
//│ Int

foo("Hello")
//│ Str

foo(bot)
//│ ⊥

foo(int_or_string)
//│ Int ∨ Str

