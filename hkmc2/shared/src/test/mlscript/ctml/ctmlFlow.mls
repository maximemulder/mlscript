// Same return

fun fooI(a, b) =
  let _ = if a is
    Int then (b as Int)
    Str then (b as Str)
  1
//│ fooI: ∀α, β. {β ≤ ¬({α ≤ Int} ⟹ ¬Int) ∨ ¬({α ≤ ¬({β ≤ Str} ⟹ ¬Str)} ⟹ ¬(Str ∨ ¬({α ≤ ⊥} ⟹ ⊥))), α ≤ ¬({β ≤ Int} ⟹ ¬Int) ∨ ¬({β ≤ Str ∨ ¬({α ≤ ⊥} ⟹ ⊥), β ≤ Str} ⟹ ¬Str)} ⟹ α → β → Int

fooI(1, 2)
//│ Int

