:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence

// Unique parameter

// Function definitions

fun foo(a) =
  if a is
    Int then (a as Int)
    Str then (a as Str)
//│ foo: ∀α, β, γ. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬({γ ≥ Str} ⟹ ¬Str)} ⟹ γ), γ ≥ ({α ≤ Int, β ≥ Int} ⟹ ⊥) ∧ ({α ≤ ¬({γ ≥ Str} ⟹ ¬Str), β ≥ γ} ⟹ Str ∧ ({α ≤ ⊥} ⟹ ⊥)), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ ¬({γ ≥ Str} ⟹ ¬Str), β ≥ γ} ⟹ ¬Str)} ⟹ α → β

// FIXME: Takes about 7 s, and the inferred type is not simplified to `Int → Int`.
// fun bar(a) =
//   foo(a) as Int
// //│ bar: ∀α, β, γ, δ. {γ ≥ ({β ≤ Int} ⟹ Int) ∧ ({β ≤ ¬({δ ≥ Str} ⟹ ¬Str)} ⟹ δ), δ ≥ ({β ≤ Int, γ ≥ Int} ⟹ ⊥) ∧ ({β ≤ ¬({δ ≥ Str} ⟹ ¬Str), γ ≥ δ} ⟹ Str ∧ ({β ≤ ⊥} ⟹ ⊥)), β ≥ α, γ ≤ Int, α ≤ ¬({γ ≥ Int} ⟹ ¬Int), β ≤ ¬({γ ≥ Int} ⟹ ¬Int)} ⟹ α → Int

// Function overloads

foo as (Int -> Int) & (Str -> Str)
//│ (Int → Int) ∧ (Str → Str)

// Function applications

val int_or_string: Int | Str
//│ int_or_string: Int ∨ Str

foo(1)
//│ Int

foo("Hello")
//│ Str

foo(bot)
//│ ∀α, β. {α ≥ Int ∧ β, β ≥ ({α ≥ Int} ⟹ ⊥) ∧ ({α ≥ β} ⟹ ⊥)} ⟹ α

foo(int_or_string)
//│ Int ∨ Str

