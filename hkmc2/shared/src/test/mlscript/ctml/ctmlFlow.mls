:ctml

:ctml-cfg error-absurd-constred

// Unique parameter

// Function definitions

fun foo(a) =
  if a is
    Int then (a as Int)
    Str then (a as Str)
//│ foo: ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ ¬Str)} ⟹ α → β

fun bar(a) =
  foo(a) as Int
//│ bar: Int → Int

// Function overloads

foo as (Int -> Int) & (Str -> Str)
//│ (Int → Int) ∧ (Str → Str)

// Function applications

val int_or_string: Int | Str
//│ int_or_string: Int ∨ Str

foo(1)
//│ Int

foo("Hello")
//│ Str

foo(bot)
//│ ⊥

foo(int_or_string)
//│ Int ∨ Str

// Errors

:te
foo as (Int -> Int) & (Str -> Str) & (Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ ¬Str)} ⟹ α → β ≤ ((Int → Int) ∧ (Str → Str)) ∧ (Bool → Bool).
//│ Typing error tree:
//│   ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ ¬Str)} ⟹ α → β ≤ ((Int → Int) ∧ (Str → Str)) ∧ (Bool → Bool)
//│     ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ ¬Str)} ⟹ α → β ≤ Bool → Bool
//│       {δ ≥ ({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ Str} ⟹ Str), γ ≤ ¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≥ Str} ⟹ ¬Str)} ⟹ γ → δ ≤ Bool → Bool
//│         {γ ≤ ¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≥ Str} ⟹ ¬Str)} ⟹ γ → δ ≤ Bool → Bool
//│           γ → δ ≤ Bool → Bool
//│             Bool ≤ γ
//│               Bool ≤ ¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≥ Str} ⟹ ¬Str)
//│                 Bool ≤ ¬({δ ≥ Int} ⟹ ¬Int)
//│                   {δ ≥ Int} ⟹ ¬Int ≤ ¬Bool
//│                     ¬Int ≤ ¬Bool
//│                       Bool ≤ Int
//│                 Bool ≤ ¬({δ ≥ Str} ⟹ ¬Str)
//│                   {δ ≥ Str} ⟹ ¬Str ≤ ¬Bool
//│                     ¬Str ≤ ¬Bool
//│                       Bool ≤ Str

:te
foo(true)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ ¬Str)} ⟹ α → β ≤ Bool → γ.
//│ Typing error tree:
//│   ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ ¬Str)} ⟹ α → β ≤ Bool → γ
//│     {ε ≥ ({δ ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str), δ ≤ ¬({ε ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≥ Str} ⟹ ¬Str)} ⟹ δ → ε ≤ Bool → γ
//│       {δ ≤ ¬({ε ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≥ Str} ⟹ ¬Str)} ⟹ δ → ε ≤ Bool → γ
//│         δ → ε ≤ Bool → γ
//│           Bool ≤ δ
//│             Bool ≤ ¬({ε ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≥ Str} ⟹ ¬Str)
//│               Bool ≤ ¬({ε ≥ Int} ⟹ ¬Int)
//│                 {ε ≥ Int} ⟹ ¬Int ≤ ¬Bool
//│                   ¬Int ≤ ¬Bool
//│                     Bool ≤ Int
//│               Bool ≤ ¬({ε ≥ Str} ⟹ ¬Str)
//│                 {ε ≥ Str} ⟹ ¬Str ≤ ¬Bool
//│                   ¬Str ≤ ¬Bool
//│                     Bool ≤ Str

// Multiple parameters

// Function definitons

fun foo2(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo2: ∀α, β, γ. {β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ Str, γ ≥ Str} ⟹ ¬Str), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({β ≤ Str, γ ≥ Str} ⟹ ¬Str), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ Str, β ≤ Str} ⟹ Str)} ⟹ α → β → γ

fun bar2(a, b) =
  foo2(a, b) as Int
//│ bar2: Int → Int → Int

// Function overloads

foo2 as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

foo2 as (Int -> Int -> Int)
//│ Int → Int → Int

foo2 as (Str -> Str -> Str)
//│ Str → Str → Str

foo2 as (Bot -> Bot -> Top)
//│ ⊥ → ⊥ → ⊤

// Function applications

foo2(1, 2)
//│ Int

foo2("Hello", "World")
//│ Str

foo2(bot, bot)
//│ ⊥

// Errors

:te
foo2(1, "World")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
//│ Typing error tree:
//│   α ≤ Str → β
//│     γ → δ ≤ Str → β
//│       Str ≤ γ
//│         Str ≤ (¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, δ ≥ Str} ⟹ ¬Str)) ∧ Int
//│           Str ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, δ ≥ Str} ⟹ ¬Str)
//│             Str ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int)
//│               {ε ≤ Int, δ ≥ Int} ⟹ ¬Int ≤ ¬Str
//│                 {δ ≥ Int} ⟹ ¬Int ≤ ¬Str
//│                   ¬Int ≤ ¬Str
//│                     Str ≤ Int
//│             Str ≤ ¬({ε ≤ Str, δ ≥ Str} ⟹ ¬Str)
//│               {ε ≤ Str, δ ≥ Str} ⟹ ¬Str ≤ ¬Str
//│                 ε ≤ Str
//│                   Int ≤ Str

:te
foo2(1, int_or_string)
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ (Int ∨ Str) → β.
//│ Typing error tree:
//│   α ≤ (Int ∨ Str) → β
//│     γ → δ ≤ (Int ∨ Str) → β
//│       Int ∨ Str ≤ γ
//│         Int ∨ Str ≤ (¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, δ ≥ Str} ⟹ ¬Str)) ∧ Int
//│           Str ≤ (¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, δ ≥ Str} ⟹ ¬Str)) ∧ Int
//│             Str ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, δ ≥ Str} ⟹ ¬Str)
//│               Str ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int)
//│                 {ε ≤ Int, δ ≥ Int} ⟹ ¬Int ≤ ¬Str
//│                   {δ ≥ Int} ⟹ ¬Int ≤ ¬Str
//│                     ¬Int ≤ ¬Str
//│                       Str ≤ Int
//│               Str ≤ ¬({ε ≤ Str, δ ≥ Str} ⟹ ¬Str)
//│                 {ε ≤ Str, δ ≥ Str} ⟹ ¬Str ≤ ¬Str
//│                   ε ≤ Str
//│                     Int ≤ Str

:te
foo2 as (Bool -> Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ Str, γ ≥ Str} ⟹ ¬Str), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({β ≤ Str, γ ≥ Str} ⟹ ¬Str), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ Str, β ≤ Str} ⟹ Str)} ⟹ α → β → γ ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α, β, γ. {β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ Str, γ ≥ Str} ⟹ ¬Str), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({β ≤ Str, γ ≥ Str} ⟹ ¬Str), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ Str, β ≤ Str} ⟹ Str)} ⟹ α → β → γ ≤ Bool → Bool → Bool
//│     {ε ≤ ¬({δ ≤ Int, ζ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≤ Str, ζ ≥ Str} ⟹ ¬Str), δ ≤ ¬({ε ≤ Int, ζ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, ζ ≥ Str} ⟹ ¬Str), ζ ≥ ({δ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({δ ≤ Str, ε ≤ Str} ⟹ Str)} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│       {δ ≤ ¬({ε ≤ Int, ζ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, ζ ≥ Str} ⟹ ¬Str), ζ ≥ ({δ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({δ ≤ Str, ε ≤ Str} ⟹ Str)} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│         {ζ ≥ ({δ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({δ ≤ Str, ε ≤ Str} ⟹ Str)} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│           δ → ε → ζ ≤ Bool → Bool → Bool
//│             Bool ≤ δ
//│               Bool ≤ ¬({ε ≤ Int, ζ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, ζ ≥ Str} ⟹ ¬Str)
//│                 Bool ≤ ¬({ε ≤ Int, ζ ≥ Int} ⟹ ¬Int)
//│                   {ε ≤ Int, ζ ≥ Int} ⟹ ¬Int ≤ ¬Bool
//│                     {ζ ≥ Int} ⟹ ¬Int ≤ ¬Bool
//│                       ¬Int ≤ ¬Bool
//│                         Bool ≤ Int
//│                 Bool ≤ ¬({ε ≤ Str, ζ ≥ Str} ⟹ ¬Str)
//│                   {ε ≤ Str, ζ ≥ Str} ⟹ ¬Str ≤ ¬Bool
//│                     {ζ ≥ Str} ⟹ ¬Str ≤ ¬Bool
//│                       ¬Str ≤ ¬Bool
//│                         Bool ≤ Str

:te
foo2 as ((Int | Str) -> (Int | Str) -> (Int | Str))
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ Str, γ ≥ Str} ⟹ ¬Str), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({β ≤ Str, γ ≥ Str} ⟹ ¬Str), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ Str, β ≤ Str} ⟹ Str)} ⟹ α → β → γ ≤ (Int ∨ Str) → (Int ∨ Str) → (Int ∨ Str).
//│ Typing error tree:
//│   ∀α, β, γ. {β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ Str, γ ≥ Str} ⟹ ¬Str), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({β ≤ Str, γ ≥ Str} ⟹ ¬Str), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ Str, β ≤ Str} ⟹ Str)} ⟹ α → β → γ ≤ (Int ∨ Str) → (Int ∨ Str) → (Int ∨ Str)
//│     ∀α, β, γ. {β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ Str, γ ≥ Str} ⟹ ¬Str), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({β ≤ Str, γ ≥ Str} ⟹ ¬Str), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ Str, β ≤ Str} ⟹ Str)} ⟹ α → β → γ ≤ Int → (Int ∨ Str) → (Int ∨ Str)
//│       ∀α, β, γ. {β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ Str, γ ≥ Str} ⟹ ¬Str), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({β ≤ Str, γ ≥ Str} ⟹ ¬Str), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ Str, β ≤ Str} ⟹ Str)} ⟹ α → β → γ ≤ Int → Str → (Int ∨ Str)
//│         {ε ≤ ¬({δ ≤ Int, ζ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≤ Str, ζ ≥ Str} ⟹ ¬Str), δ ≤ ¬({ε ≤ Int, ζ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, ζ ≥ Str} ⟹ ¬Str), ζ ≥ ({δ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({δ ≤ Str, ε ≤ Str} ⟹ Str)} ⟹ δ → ε → ζ ≤ Int → Str → (Int ∨ Str)
//│           {δ ≤ ¬({ε ≤ Int, ζ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, ζ ≥ Str} ⟹ ¬Str), ζ ≥ ({δ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({δ ≤ Str, ε ≤ Str} ⟹ Str)} ⟹ δ → ε → ζ ≤ Int → Str → (Int ∨ Str)
//│             {ζ ≥ ({δ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({δ ≤ Str, ε ≤ Str} ⟹ Str)} ⟹ δ → ε → ζ ≤ Int → Str → (Int ∨ Str)
//│               δ → ε → ζ ≤ Int → Str → (Int ∨ Str)
//│                 ε → ζ ≤ Str → (Int ∨ Str)
//│                   Str ≤ ε
//│                     Str ≤ (¬({δ ≤ Int, ζ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≤ Str, ζ ≥ Str} ⟹ ¬Str)) ∧ Int
//│                       Str ≤ ¬({δ ≤ Int, ζ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≤ Str, ζ ≥ Str} ⟹ ¬Str)
//│                         Str ≤ ¬({δ ≤ Int, ζ ≥ Int} ⟹ ¬Int)
//│                           {δ ≤ Int, ζ ≥ Int} ⟹ ¬Int ≤ ¬Str
//│                             {ζ ≥ Int} ⟹ ¬Int ≤ ¬Str
//│                               ¬Int ≤ ¬Str
//│                                 Str ≤ Int
//│                         Str ≤ ¬({δ ≤ Str, ζ ≥ Str} ⟹ ¬Str)
//│                           {δ ≤ Str, ζ ≥ Str} ⟹ ¬Str ≤ ¬Str
//│                             δ ≤ Str
//│                               Int ≤ Str

:te
foo2 as (Top -> Top -> Bot)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ Str, γ ≥ Str} ⟹ ¬Str), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({β ≤ Str, γ ≥ Str} ⟹ ¬Str), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ Str, β ≤ Str} ⟹ Str)} ⟹ α → β → γ ≤ ⊤ → ⊤ → ⊥.
//│ Typing error tree:
//│   ∀α, β, γ. {β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ Str, γ ≥ Str} ⟹ ¬Str), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({β ≤ Str, γ ≥ Str} ⟹ ¬Str), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ Str, β ≤ Str} ⟹ Str)} ⟹ α → β → γ ≤ ⊤ → ⊤ → ⊥
//│     {ε ≤ ¬({δ ≤ Int, ζ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≤ Str, ζ ≥ Str} ⟹ ¬Str), δ ≤ ¬({ε ≤ Int, ζ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, ζ ≥ Str} ⟹ ¬Str), ζ ≥ ({δ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({δ ≤ Str, ε ≤ Str} ⟹ Str)} ⟹ δ → ε → ζ ≤ ⊤ → ⊤ → ⊥
//│       {δ ≤ ¬({ε ≤ Int, ζ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, ζ ≥ Str} ⟹ ¬Str), ζ ≥ ({δ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({δ ≤ Str, ε ≤ Str} ⟹ Str)} ⟹ δ → ε → ζ ≤ ⊤ → ⊤ → ⊥
//│         {ζ ≥ ({δ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({δ ≤ Str, ε ≤ Str} ⟹ Str)} ⟹ δ → ε → ζ ≤ ⊤ → ⊤ → ⊥
//│           δ → ε → ζ ≤ ⊤ → ⊤ → ⊥
//│             ⊤ ≤ δ
//│               ⊤ ≤ ¬({ε ≤ Int, ζ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, ζ ≥ Str} ⟹ ¬Str)
//│                 ⊤ ≤ ¬({ε ≤ Int, ζ ≥ Int} ⟹ ¬Int)
//│                   {ε ≤ Int, ζ ≥ Int} ⟹ ¬Int ≤ ⊥
//│                     {ζ ≥ Int} ⟹ ¬Int ≤ ⊥
//│                       ¬Int ≤ ⊥
//│                 ⊤ ≤ ¬({ε ≤ Str, ζ ≥ Str} ⟹ ¬Str)
//│                   {ε ≤ Str, ζ ≥ Str} ⟹ ¬Str ≤ ⊥
//│                     {ζ ≥ Str} ⟹ ¬Str ≤ ⊥
//│                       ¬Str ≤ ⊥

// Same return

fun fooI(a, b) =
  let _ = if a is
    Int then (b as Int)
    Str then (b as Str)
  1
//│ fooI: ∀α, β. {β ≤ ¬({α ≤ Int} ⟹ ¬Int) ∨ ¬({α ≤ Str} ⟹ ¬Str), α ≤ ¬({β ≤ Int} ⟹ ¬Int) ∨ ¬({β ≤ Str} ⟹ ¬Str)} ⟹ α → β → Int

fooI(1, 2)
//│ Int

:te
fooI(1, "World")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
//│ Typing error tree:
//│   α ≤ Str → β
//│     γ → Int ≤ Str → β
//│       Str ≤ γ
//│         Str ≤ (¬({δ ≤ Int} ⟹ ¬Int) ∨ ¬({δ ≤ Str} ⟹ ¬Str)) ∧ Int
//│           Str ≤ ¬({δ ≤ Int} ⟹ ¬Int) ∨ ¬({δ ≤ Str} ⟹ ¬Str)
//│             Str ≤ ¬({δ ≤ Int} ⟹ ¬Int)
//│               {δ ≤ Int} ⟹ ¬Int ≤ ¬Str
//│                 ¬Int ≤ ¬Str
//│                   Str ≤ Int
//│             Str ≤ ¬({δ ≤ Str} ⟹ ¬Str)
//│               {δ ≤ Str} ⟹ ¬Str ≤ ¬Str
//│                 δ ≤ Str
//│                   Int ≤ Str

:te
fooI("Hello", 2)
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Int → β.
//│ Typing error tree:
//│   α ≤ Int → β
//│     γ → Int ≤ Int → β
//│       Int ≤ γ
//│         Int ≤ (¬({δ ≤ Int} ⟹ ¬Int) ∨ ¬({δ ≤ Str} ⟹ ¬Str)) ∧ Str
//│           Int ≤ ¬({δ ≤ Int} ⟹ ¬Int) ∨ ¬({δ ≤ Str} ⟹ ¬Str)
//│             Int ≤ ¬({δ ≤ Int} ⟹ ¬Int)
//│               {δ ≤ Int} ⟹ ¬Int ≤ ¬Int
//│                 δ ≤ Int
//│                   Str ≤ Int
//│             Int ≤ ¬({δ ≤ Str} ⟹ ¬Str)
//│               {δ ≤ Str} ⟹ ¬Str ≤ ¬Int
//│                 ¬Str ≤ ¬Int
//│                   Int ≤ Str

fooI("Hello", "World")
//│ Int
