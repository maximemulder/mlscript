:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence

// Unique parameter

// Function definitions

fun foo(a) =
  if a is
    Int then (a as Int)
    Str then (a as Str)
//│ foo: ∀α, β. α → ({α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str)} ⟹ β)

fun bar(a) =
  foo(a) as Int
//│ bar: Int → Int

// Function overloads

foo as (Int -> Int) & (Str -> Str)
//│ (Int → Int) ∧ (Str → Str)

// Function applications

val int_or_string: Int | Str
//│ int_or_string: Int ∨ Str

foo(1)
//│ ∀α. {α ≥ Int} ⟹ α

foo("Hello")
//│ ∀α. {α ≥ Str} ⟹ α

foo(bot)
//│ ∀α. α

foo(int_or_string)
//│ ∀α, β. ({α ≥ Int} ⟹ α) ∨ ({β ≥ Str} ⟹ β)

// Errors

:te
foo as (Int -> Int) & (Str -> Str) & (Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. α → ({α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str)} ⟹ β) ≤ ((Int → Int) ∧ (Str → Str)) ∧ (Bool → Bool).
//│ Typing error tree:
//│   ∀α, β. α → ({α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str)} ⟹ β) ≤ ((Int → Int) ∧ (Str → Str)) ∧ (Bool → Bool)
//│     ∀α, β. α → ({α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str)} ⟹ β) ≤ Bool → Bool
//│       γ → ({γ ≤ ({δ ≥ Int} ⟹ Int) ∨ ({δ ≥ Str} ⟹ Str), δ ≥ ({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ Str} ⟹ Str)} ⟹ δ) ≤ Bool → Bool
//│         {γ ≤ ({δ ≥ Int} ⟹ Int) ∨ ({δ ≥ Str} ⟹ Str), δ ≥ ({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ Str} ⟹ Str)} ⟹ δ ≤ Bool
//│           {δ ≥ ({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ Str} ⟹ Str)} ⟹ δ ≤ Bool
//│             δ ≤ Bool
//│               ({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ Str} ⟹ Str) ≤ Bool
//│                 {γ ≤ Int} ⟹ Int ≤ Bool
//│                   γ ≤ Int
//│                     Bool ≤ Int
//│                 {γ ≤ Str} ⟹ Str ≤ Bool
//│                   γ ≤ Str
//│                     Bool ≤ Str

:te
foo(true)
//│ ∀α. {Bool ≤ ({α ≥ Int} ⟹ Int) ∨ ({α ≥ Str} ⟹ Str), α ≥ {Bool ≤ Str} ⟹ Str} ⟹ α
//│ FAILURE: Unexpected lack of type error

// Multiple parameters

// Function definitons

fun foo2(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo2: ∀α, β, γ. α → β → ({β ≤ ({γ ≥ Int, α ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, α ≤ Str} ⟹ Str), α ≤ ({γ ≥ Int, β ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, β ≤ Str} ⟹ Str), γ ≥ ({β ≤ Int, α ≤ Int} ⟹ Int) ∧ ({β ≤ Str, α ≤ Str} ⟹ Str)} ⟹ γ)

fun bar2(a, b) =
  foo2(a, b) as Int
//│ bar2: Int → Int → Int

// Function overloads

foo2 as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

// Function applications

foo2(1, 2)
//│ ∀α. {α ≥ Int} ⟹ α

foo2("Hello", "World")
//│ ∀α. {α ≥ Str} ⟹ α

foo2(bot, bot)
//│ ∀α. α

// Errors

:te
foo2(1, "World")
//│ ∀α. {α ≥ {Str ≤ Int} ⟹ Int} ⟹ α
//│ FAILURE: Unexpected lack of type error
