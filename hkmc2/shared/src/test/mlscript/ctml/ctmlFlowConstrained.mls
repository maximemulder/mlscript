:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence

// Unique parameter

// Function definitions

fun foo(a) =
  if a is
    Int then (a as Int)
    Str then (a as Str)
//│ foo: ∀α, β. {α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ ∀γ. {α ≤ {γ ≥ Str} ⟹ Str, γ ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ γ} ⟹ ¬Int), β ≥ ({α ≤ Int} ⟹ Int) ∧ (∀γ. {α ≤ ¬Int, α ≤ {γ ≥ Str} ⟹ Str, γ ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ γ)} ⟹ α → β

fun bar(a) =
  foo(a) as Int
//│ bar: ∀α. {α ≤ Int ∨ ({{α ≤ Int, α ≤ Int} ⟹ ⊥ ≤ Int} ⟹ ⊥)} ⟹ α → Int

// Function overloads

foo as (Int -> Int) & (Str -> Str)
//│ (Int → Int) ∧ (Str → Str)

// Function applications

val int_or_string: Int | Str
//│ int_or_string: Int ∨ Str

foo(1)
//│ Int

foo("Hello")
//│ ∀α. {α ≥ Str} ⟹ α

foo(bot)
//│ ∀α. α

foo(int_or_string)
//│ Int ∨ (∀α. {α ≥ Str} ⟹ α)

// Errors

:te
foo as (Int -> Int) & (Str -> Str) & (Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ ∀γ. {α ≤ {γ ≥ Str} ⟹ Str, γ ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ γ} ⟹ ¬Int), β ≥ ({α ≤ Int} ⟹ Int) ∧ (∀γ. {α ≤ ¬Int, α ≤ {γ ≥ Str} ⟹ Str, γ ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ γ)} ⟹ α → β ≤ ((Int → Int) ∧ (Str → Str)) ∧ (Bool → Bool).
//│ Typing error tree:
//│   ∀α, β. {α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ ∀γ. {α ≤ {γ ≥ Str} ⟹ Str, γ ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ γ} ⟹ ¬Int), β ≥ ({α ≤ Int} ⟹ Int) ∧ (∀γ. {α ≤ ¬Int, α ≤ {γ ≥ Str} ⟹ Str, γ ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ γ)} ⟹ α → β ≤ ((Int → Int) ∧ (Str → Str)) ∧ (Bool → Bool)
//│     ∀α, β. {α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ ∀γ. {α ≤ {γ ≥ Str} ⟹ Str, γ ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ γ} ⟹ ¬Int), β ≥ ({α ≤ Int} ⟹ Int) ∧ (∀γ. {α ≤ ¬Int, α ≤ {γ ≥ Str} ⟹ Str, γ ≥ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ γ)} ⟹ α → β ≤ Bool → Bool
//│       {δ ≤ ({ε ≥ Int} ⟹ Int) ∨ ({ε ≥ ∀γ. {δ ≤ {γ ≥ Str} ⟹ Str, γ ≥ ({δ ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ γ} ⟹ ¬Int), ε ≥ ({δ ≤ Int} ⟹ Int) ∧ (∀γ. {δ ≤ ¬Int, δ ≤ {γ ≥ Str} ⟹ Str, γ ≥ ({δ ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ γ)} ⟹ δ → ε ≤ Bool → Bool
//│         {ε ≥ ({δ ≤ Int} ⟹ Int) ∧ (∀γ. {δ ≤ ¬Int, δ ≤ {γ ≥ Str} ⟹ Str, γ ≥ ({δ ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ γ)} ⟹ δ → ε ≤ Bool → Bool
//│           δ → ε ≤ Bool → Bool
//│             ε ≤ Bool
//│               ({δ ≤ Int} ⟹ Int) ∧ (∀γ. {δ ≤ ¬Int, δ ≤ {γ ≥ Str} ⟹ Str, γ ≥ ({δ ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ γ) ≤ Bool
//│                 {δ ≤ Int} ⟹ Int ≤ Bool
//│                   δ ≤ Int
//│                     Bool ≤ Int
//│                 ∀γ. {δ ≤ ¬Int, δ ≤ {γ ≥ Str} ⟹ Str, γ ≥ ({δ ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ γ ≤ Bool
//│                   {δ ≤ ¬Int, δ ≤ {ζ ≥ Str} ⟹ Str, ζ ≥ ({δ ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ ζ ≤ Bool
//│                     {δ ≤ {ζ ≥ Str} ⟹ Str, ζ ≥ ({δ ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ ζ ≤ Bool
//│                       {ζ ≥ ({δ ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ ζ ≤ Bool
//│                         ζ ≤ Bool
//│                           ({δ ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥) ≤ Bool
//│                             {δ ≤ Str} ⟹ Str ≤ Bool
//│                               δ ≤ Str
//│                                 Bool ≤ Str
//│                             {δ ≤ ⊥} ⟹ ⊥ ≤ Bool
//│                               δ ≤ ⊥
//│                                 Bool ≤ ⊥

foo(true)
//│ ∀α. {Bool ≤ {α ≥ Str} ⟹ Str, α ≥ {Bool ≤ ⊥} ⟹ ⊥} ⟹ α

// Multiple parameters

// Function definitons

fun foo2(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo2: ∀α, β, γ. {α ≤ ({β ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({γ ≥ ∀δ. {α ≤ {β ≤ Str, δ ≥ Str} ⟹ Str, δ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ δ} ⟹ ¬Int), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ (∀δ. {α ≤ ¬Int, α ≤ {β ≤ Str, δ ≥ Str} ⟹ Str, δ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ δ)} ⟹ α → β → γ

// FIXME: Applying the inferred multi-branch constrained type below currently exposes a separate
// context leak in nested constrained-type subtyping.
// fun bar2(a, b) =
//   foo2(a, b) as Int

// Function overloads

foo2 as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

// Function applications

foo2(1, 2)
//│ Int

foo2("Hello", "World")
//│ ∀α. {α ≥ Str} ⟹ α

foo2(bot, bot)
//│ ∀α. α

// Errors

foo2(1, "World")
//│ ∀α. {Int ≤ ¬Int, Int ≤ {α ≥ Str} ⟹ Str, α ≥ {Int ≤ ⊥} ⟹ ⊥} ⟹ α

// Same return

fun fooI(a, b) =
  let _ = if a is
    Int then (b as Int)
    Str then (b as Str)
  1
//│ fooI: ⊤ → ⊤ → Int
