:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence

// Unique parameter

// Function definitions

fun foo(a) =
  if a is
    Int then (a as Int)
    Str then (a as Str)
//│ foo: ∀α, β. {α ≤ (Int ⟹ {β ≥ Int}) ∨ (¬Int ⟹ {β ≥ ∀γ. {α ≤ (Str ⟹ {γ ≥ Str}) ∨ ⊥, γ ≥ (Str ⟹ {α ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ γ}), β ≥ (Int ⟹ {α ≤ Int}) ∧ (∀γ. {α ≤ (Str ⟹ {γ ≥ Str}) ∨ ⊥, γ ≥ (Str ⟹ {α ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ γ ⟹ {α ≤ ¬Int})} ⟹ α → β

fun bar(a) =
  foo(a) as Int
//│ bar: Int → Int

// Function overloads

foo as (Int -> Int) & (Str -> Str)
//│ (Int → Int) ∧ (Str → Str)

// Function applications

val int_or_string: Int | Str
//│ int_or_string: Int ∨ Str

foo(1)
//│ Int

foo("Hello")
//│ ∀α. {Str ≤ (Str ⟹ {α ≥ Str}) ∨ ⊥, α ≥ Str ∧ (⊥ ⟹ {Str ≤ ⊥})} ⟹ α

foo(bot)
//│ ∀α. α

foo(int_or_string)
//│ Int ∨ (∀α. {Str ≤ (Str ⟹ {α ≥ Str}) ∨ ⊥, α ≥ Str ∧ (⊥ ⟹ {Str ≤ ⊥})} ⟹ α)

// Errors

:te
foo as (Int -> Int) & (Str -> Str) & (Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {α ≤ (Int ⟹ {β ≥ Int}) ∨ (¬Int ⟹ {β ≥ ∀γ. {α ≤ (Str ⟹ {γ ≥ Str}) ∨ ⊥, γ ≥ (Str ⟹ {α ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ γ}), β ≥ (Int ⟹ {α ≤ Int}) ∧ (∀γ. {α ≤ (Str ⟹ {γ ≥ Str}) ∨ ⊥, γ ≥ (Str ⟹ {α ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ γ ⟹ {α ≤ ¬Int})} ⟹ α → β ≤ ((Int → Int) ∧ (Str → Str)) ∧ (Bool → Bool).
//│ Typing error tree:
//│   ∀α, β. {α ≤ (Int ⟹ {β ≥ Int}) ∨ (¬Int ⟹ {β ≥ ∀γ. {α ≤ (Str ⟹ {γ ≥ Str}) ∨ ⊥, γ ≥ (Str ⟹ {α ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ γ}), β ≥ (Int ⟹ {α ≤ Int}) ∧ (∀γ. {α ≤ (Str ⟹ {γ ≥ Str}) ∨ ⊥, γ ≥ (Str ⟹ {α ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ γ ⟹ {α ≤ ¬Int})} ⟹ α → β ≤ ((Int → Int) ∧ (Str → Str)) ∧ (Bool → Bool)
//│     ∀α, β. {α ≤ (Int ⟹ {β ≥ Int}) ∨ (¬Int ⟹ {β ≥ ∀γ. {α ≤ (Str ⟹ {γ ≥ Str}) ∨ ⊥, γ ≥ (Str ⟹ {α ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ γ}), β ≥ (Int ⟹ {α ≤ Int}) ∧ (∀γ. {α ≤ (Str ⟹ {γ ≥ Str}) ∨ ⊥, γ ≥ (Str ⟹ {α ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ γ ⟹ {α ≤ ¬Int})} ⟹ α → β ≤ Bool → Bool
//│       {δ ≤ (Int ⟹ {ε ≥ Int}) ∨ (¬Int ⟹ {ε ≥ ∀γ. {δ ≤ (Str ⟹ {γ ≥ Str}) ∨ ⊥, γ ≥ (Str ⟹ {δ ≤ Str}) ∧ (⊥ ⟹ {δ ≤ ⊥})} ⟹ γ}), ε ≥ (Int ⟹ {δ ≤ Int}) ∧ (∀γ. {δ ≤ (Str ⟹ {γ ≥ Str}) ∨ ⊥, γ ≥ (Str ⟹ {δ ≤ Str}) ∧ (⊥ ⟹ {δ ≤ ⊥})} ⟹ γ ⟹ {δ ≤ ¬Int})} ⟹ δ → ε ≤ Bool → Bool
//│         {ε ≥ (Int ⟹ {δ ≤ Int}) ∧ (∀γ. {δ ≤ (Str ⟹ {γ ≥ Str}) ∨ ⊥, γ ≥ (Str ⟹ {δ ≤ Str}) ∧ (⊥ ⟹ {δ ≤ ⊥})} ⟹ γ ⟹ {δ ≤ ¬Int})} ⟹ δ → ε ≤ Bool → Bool
//│           δ → ε ≤ Bool → Bool
//│             ε ≤ Bool
//│               ((Int ⟹ {δ ≤ Int}) ∧ (∀γ. {δ ≤ (Str ⟹ {γ ≥ Str}) ∨ ⊥, γ ≥ (Str ⟹ {δ ≤ Str}) ∧ (⊥ ⟹ {δ ≤ ⊥})} ⟹ γ ⟹ {δ ≤ ¬Int})) ∨ (∀γ. {δ ≤ (Str ⟹ {γ ≥ Str}) ∨ ⊥, γ ≥ (Str ⟹ {δ ≤ Str}) ∧ (⊥ ⟹ {δ ≤ ⊥})} ⟹ γ) ≤ Bool
//│                 (Int ⟹ {δ ≤ Int}) ∧ (∀γ. {δ ≤ (Str ⟹ {γ ≥ Str}) ∨ ⊥, γ ≥ (Str ⟹ {δ ≤ Str}) ∧ (⊥ ⟹ {δ ≤ ⊥})} ⟹ γ ⟹ {δ ≤ ¬Int}) ≤ Bool
//│                   Int ⟹ {δ ≤ Int} ≤ Bool
//│                     Int ≤ Bool
//│                   ∀γ. {δ ≤ (Str ⟹ {γ ≥ Str}) ∨ ⊥, γ ≥ (Str ⟹ {δ ≤ Str}) ∧ (⊥ ⟹ {δ ≤ ⊥})} ⟹ γ ⟹ {δ ≤ ¬Int} ≤ Bool
//│                     {δ ≤ (Str ⟹ {ζ ≥ Str}) ∨ ⊥, ζ ≥ (Str ⟹ {δ ≤ Str}) ∧ (⊥ ⟹ {δ ≤ ⊥})} ⟹ ζ ⟹ {δ ≤ ¬Int} ≤ Bool
//│                       {δ ≤ (Str ⟹ {ζ ≥ Str}) ∨ ⊥, ζ ≥ (Str ⟹ {δ ≤ Str}) ∧ (⊥ ⟹ {δ ≤ ⊥})} ⟹ ζ ≤ Bool
//│                         δ ≤ (Str ⟹ {ζ ≥ Str}) ∨ ⊥
//│                           Bool ≤ (Str ⟹ {ζ ≥ Str}) ∨ ⊥
//│                             Bool ≤ Str ⟹ {ζ ≥ Str}
//│                               Bool ≤ Str
//│                             Bool ≤ ⊥

foo(true)
//│ ∀α. {Bool ≤ (Str ⟹ {α ≥ Str}) ∨ ⊥, α ≥ (Str ⟹ {Bool ≤ Str}) ∧ (⊥ ⟹ {Bool ≤ ⊥})} ⟹ α

// Multiple parameters

// Function definitons

fun foo2(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo2: ∀α, β, γ. {α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (¬Int ⟹ {γ ≥ ∀δ. {α ≤ (Str ⟹ {β ≤ Str, δ ≥ Str}) ∨ ⊥, β ≤ (Str ⟹ {α ≤ Str, δ ≥ Str}) ∨ (⊤ ⟹ {α ≤ ⊥}), δ ≥ (Str ⟹ {α ≤ Str, β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ δ}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (⊤ ⟹ {α ≤ ¬Int, γ ≥ ∀δ. {α ≤ (Str ⟹ {β ≤ Str, δ ≥ Str}) ∨ ⊥, β ≤ (Str ⟹ {α ≤ Str, δ ≥ Str}) ∨ (⊤ ⟹ {α ≤ ⊥}), δ ≥ (Str ⟹ {α ≤ Str, β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ δ}), γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∧ (∀δ. {α ≤ (Str ⟹ {β ≤ Str, δ ≥ Str}) ∨ ⊥, β ≤ (Str ⟹ {α ≤ Str, δ ≥ Str}) ∨ (⊤ ⟹ {α ≤ ⊥}), δ ≥ (Str ⟹ {α ≤ Str, β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ δ ⟹ {α ≤ ¬Int})} ⟹ α → β → γ

// FIXME: Applying the inferred multi-branch constrained type below currently exposes a separate
// context leak in nested constrained-type subtyping.
// fun bar2(a, b) =
//   foo2(a, b) as Int

// Function overloads

foo2 as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

// Function applications

foo2(1, 2)
//│ Int

foo2("Hello", "World")
//│ ∀α. {Str ≤ (Str ⟹ {α ≥ Str}) ∨ ⊥, Str ≤ (Str ⟹ {α ≥ Str}) ∨ (⊤ ⟹ {Str ≤ ⊥}), α ≥ Str ∧ (⊥ ⟹ {Str ≤ ⊥})} ⟹ α

foo2(bot, bot)
//│ ∀α. α

// Errors

foo2(1, "World")
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:71)
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
//│ Typing error tree:
//│   α ≤ Str → β
//│     γ → δ ≤ Str → β
//│       Str ≤ γ
//│         Str ≤ ((Int ⟹ {ε ≤ Int, δ ≥ Int}) ∨ (⊤ ⟹ {ε ≤ ¬Int, δ ≥ ∀ζ. {ε ≤ (Str ⟹ {γ ≤ Str, ζ ≥ Str}) ∨ ⊥, γ ≤ (Str ⟹ {ε ≤ Str, ζ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), ζ ≥ (Str ⟹ {ε ≤ Str, γ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ ζ})) ∧ Int
//│           Str ≤ (Int ⟹ {ε ≤ Int, δ ≥ Int}) ∧ Int
//│             Str ≤ Int ⟹ {ε ≤ Int, δ ≥ Int}
//│               Str ≤ Int ⟹ {δ ≥ Int}
//│                 Str ≤ Int
//│           Str ≤ (⊤ ⟹ {ε ≤ ¬Int, δ ≥ ∀ζ. {ε ≤ (Str ⟹ {γ ≤ Str, ζ ≥ Str}) ∨ ⊥, γ ≤ (Str ⟹ {ε ≤ Str, ζ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), ζ ≥ (Str ⟹ {ε ≤ Str, γ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ ζ}) ∧ Int
//│             Str ≤ ⊤ ⟹ {ε ≤ ¬Int, δ ≥ ∀ζ. {ε ≤ (Str ⟹ {γ ≤ Str, ζ ≥ Str}) ∨ ⊥, γ ≤ (Str ⟹ {ε ≤ Str, ζ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), ζ ≥ (Str ⟹ {ε ≤ Str, γ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ ζ}
//│               ε ≤ ¬Int
//│                 Int ≤ ¬Int

// Same return

fun fooI(a, b) =
  let _ = if a is
    Int then (b as Int)
    Str then (b as Str)
  1
//│ fooI: ⊤ → ⊤ → Int
