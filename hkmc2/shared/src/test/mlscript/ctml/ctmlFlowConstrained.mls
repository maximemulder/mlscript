:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence

// Unique parameter

// Function definitions

fun foo(a) =
  if a is
    Int then (a as Int)
    Str then (a as Str)
//│ foo: ∀α, β. {α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ {α ≤ Str} ⟹ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ ¬Int), β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int, α ≤ Str} ⟹ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥))} ⟹ α → β

fun bar(a) =
  foo(a) as Int
//│ bar: Int → Int

// Function overloads

foo as (Int -> Int) & (Str -> Str)
//│ (Int → Int) ∧ (Str → Str)

// Function applications

val int_or_string: Int | Str
//│ int_or_string: Int ∨ Str

foo(1)
//│ Int

foo("Hello")
//│ Str

foo(bot)
//│ ⊥

foo(int_or_string)
//│ Int ∨ Str

// Errors

:te
foo as (Int -> Int) & (Str -> Str) & (Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ {α ≤ Str} ⟹ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ ¬Int), β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int, α ≤ Str} ⟹ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥))} ⟹ α → β ≤ ((Int → Int) ∧ (Str → Str)) ∧ (Bool → Bool).
//│ Typing error tree:
//│   ∀α, β. {α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ {α ≤ Str} ⟹ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ ¬Int), β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int, α ≤ Str} ⟹ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥))} ⟹ α → β ≤ ((Int → Int) ∧ (Str → Str)) ∧ (Bool → Bool)
//│     ∀α, β. {α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ {α ≤ Str} ⟹ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ ¬Int), β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int, α ≤ Str} ⟹ ({α ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥))} ⟹ α → β ≤ Bool → Bool
//│       {γ ≤ ({δ ≥ Int} ⟹ Int) ∨ ({δ ≥ {γ ≤ Str} ⟹ ({γ ≤ Str} ⟹ Str) ∧ ({γ ≤ ⊥} ⟹ ⊥)} ⟹ ¬Int), δ ≥ ({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ ¬Int, γ ≤ Str} ⟹ ({γ ≤ Str} ⟹ Str) ∧ ({γ ≤ ⊥} ⟹ ⊥))} ⟹ γ → δ ≤ Bool → Bool
//│         {δ ≥ ({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ ¬Int, γ ≤ Str} ⟹ ({γ ≤ Str} ⟹ Str) ∧ ({γ ≤ ⊥} ⟹ ⊥))} ⟹ γ → δ ≤ Bool → Bool
//│           γ → δ ≤ Bool → Bool
//│             δ ≤ Bool
//│               ({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ ¬Int, γ ≤ Str} ⟹ ({γ ≤ Str} ⟹ Str) ∧ ({γ ≤ ⊥} ⟹ ⊥)) ≤ Bool
//│                 {γ ≤ Int} ⟹ Int ≤ Bool
//│                   γ ≤ Int
//│                     Bool ≤ Int
//│                 {γ ≤ ¬Int, γ ≤ Str} ⟹ ({γ ≤ Str} ⟹ Str) ∧ ({γ ≤ ⊥} ⟹ ⊥) ≤ Bool
//│                   {γ ≤ Str} ⟹ ({γ ≤ Str} ⟹ Str) ∧ ({γ ≤ ⊥} ⟹ ⊥) ≤ Bool
//│                     γ ≤ Str
//│                       Bool ≤ Str

:te
foo(true)
//│ ═══[TYPE ERROR] Cannot solve judgment Bool ≤ Str.
//│ Typing error tree:
//│   Bool ≤ Str

// Multiple parameters

// Function definitons

fun foo2(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo2: ∀α, β, γ. {γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int, α ≤ {β ≤ Str} ⟹ Str} ⟹ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)), α ≤ ({β ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({γ ≥ {α ≤ {β ≤ Str} ⟹ Str} ⟹ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ ¬Int)} ⟹ α → β → γ

// FIXME: Applying the inferred multi-branch constrained type below currently exposes a separate
// context leak in nested constrained-type subtyping.
// fun bar2(a, b) =
//   foo2(a, b) as Int

// Function overloads

foo2 as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

// Function applications

foo2(1, 2)
//│ Int

foo2("Hello", "World")
//│ Str

foo2(bot, bot)
//│ ⊥

// Errors

foo2(1, "World")
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:71)
//│ ═══[TYPE ERROR] Cannot solve judgment Int ≤ ¬Int.
//│ Typing error tree:
//│   Int ≤ ¬Int

// Same return

fun fooI(a, b) =
  let _ = if a is
    Int then (b as Int)
    Str then (b as Str)
  1
//│ fooI: ⊤ → ⊤ → Int
