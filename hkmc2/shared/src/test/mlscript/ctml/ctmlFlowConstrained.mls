:ctml

:ctml-cfg constrained

// Unique parameter

// Function definitions

fun foo(a) =
  if a is
    Int then (a as Int)
    Str then (a as Str)
//│ foo: ∀α, β. {α ≥ ({β ≤ Int} ⟹ Int) ∧ ({β ≤ Str} ⟹ Str), β ≤ ({α ≥ Int} ⟹ Int) ∨ ({α ≥ Str} ⟹ Str)} ⟹ β → α

fun bar(a) =
  foo(a) as Int
//│ bar: Int → Int

// Function overloads

foo as (Int -> Int) & (Str -> Str)
//│ (Int → Int) ∧ (Str → Str)

// Function applications

val int_or_string: Int | Str
//│ int_or_string: Int ∨ Str

foo(1)
//│ Int

foo("Hello")
//│ Str

foo(bot)
//│ ⊥

foo(int_or_string)
//│ Str ∨ Int

// Errors

:e
foo as (Int -> Int) & (Str -> Str) & (Bool -> Bool)
//│ ═══[ERROR] Cannot solve judgment ∀α, β. {α ≥ ({β ≤ Int} ⟹ Int) ∧ ({β ≤ Str} ⟹ Str), β ≤ ({α ≥ Int} ⟹ Int) ∨ ({α ≥ Str} ⟹ Str)} ⟹ β → α ≤ ((Int → Int) ∧ (Str → Str)) ∧ (Bool → Bool).
//│ Typing error tree:
//│   ∀α, β. {α ≥ ({β ≤ Int} ⟹ Int) ∧ ({β ≤ Str} ⟹ Str), β ≤ ({α ≥ Int} ⟹ Int) ∨ ({α ≥ Str} ⟹ Str)} ⟹ β → α ≤ ((Int → Int) ∧ (Str → Str)) ∧ (Bool → Bool)
//│     ∀α, β. {α ≥ ({β ≤ Int} ⟹ Int) ∧ ({β ≤ Str} ⟹ Str), β ≤ ({α ≥ Int} ⟹ Int) ∨ ({α ≥ Str} ⟹ Str)} ⟹ β → α ≤ Bool → Bool
//│       ∀β. {γ ≥ ({β ≤ Int} ⟹ Int) ∧ ({β ≤ Str} ⟹ Str), β ≤ ({γ ≥ Int} ⟹ Int) ∨ ({γ ≥ Str} ⟹ Str)} ⟹ β → γ ≤ Bool → Bool
//│         {γ ≥ ({δ ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str), δ ≤ ({γ ≥ Int} ⟹ Int) ∨ ({γ ≥ Str} ⟹ Str)} ⟹ δ → γ ≤ Bool → Bool
//│           {δ ≤ ({γ ≥ Int} ⟹ Int) ∨ ({γ ≥ Str} ⟹ Str)} ⟹ δ → γ ≤ Bool → Bool
//│             δ → γ ≤ Bool → Bool
//│               Bool ≤ δ
//│                 Bool ≤ ({γ ≥ Int} ⟹ Int) ∨ ({γ ≥ Str} ⟹ Str)
//│                   Bool ≤ {γ ≥ Int} ⟹ Int
//│                     Bool ≤ Int
//│                   Bool ≤ {γ ≥ Str} ⟹ Str
//│                     Bool ≤ Str

:e
foo(true)
//│ ═══[ERROR] Cannot solve judgment ∀α, β. {α ≥ ({β ≤ Int} ⟹ Int) ∧ ({β ≤ Str} ⟹ Str), β ≤ ({α ≥ Int} ⟹ Int) ∨ ({α ≥ Str} ⟹ Str)} ⟹ β → α ≤ Bool → γ.
//│ Typing error tree:
//│   ∀α, β. {α ≥ ({β ≤ Int} ⟹ Int) ∧ ({β ≤ Str} ⟹ Str), β ≤ ({α ≥ Int} ⟹ Int) ∨ ({α ≥ Str} ⟹ Str)} ⟹ β → α ≤ Bool → γ
//│     ∀β. {δ ≥ ({β ≤ Int} ⟹ Int) ∧ ({β ≤ Str} ⟹ Str), β ≤ ({δ ≥ Int} ⟹ Int) ∨ ({δ ≥ Str} ⟹ Str)} ⟹ β → δ ≤ Bool → γ
//│       {δ ≥ ({ε ≤ Int} ⟹ Int) ∧ ({ε ≤ Str} ⟹ Str), ε ≤ ({δ ≥ Int} ⟹ Int) ∨ ({δ ≥ Str} ⟹ Str)} ⟹ ε → δ ≤ Bool → γ
//│         {ε ≤ ({δ ≥ Int} ⟹ Int) ∨ ({δ ≥ Str} ⟹ Str)} ⟹ ε → δ ≤ Bool → γ
//│           ε → δ ≤ Bool → γ
//│             Bool ≤ ε
//│               Bool ≤ ({δ ≥ Int} ⟹ Int) ∨ ({δ ≥ Str} ⟹ Str)
//│                 Bool ≤ {δ ≥ Int} ⟹ Int
//│                   Bool ≤ Int
//│                 Bool ≤ {δ ≥ Str} ⟹ Str
//│                   Bool ≤ Str

// Multiple parameters

// Function definitons

fun foo2(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo2: ∀α, β, γ. {α ≤ ({β ≥ Int, γ ≤ Int} ⟹ Int) ∨ ({β ≥ Str, γ ≤ Str} ⟹ Str), β ≥ ({α ≤ Int, γ ≤ Int} ⟹ Int) ∧ ({α ≤ Str, γ ≤ Str} ⟹ Str), γ ≤ ({β ≥ Int, α ≤ Int} ⟹ Int) ∨ ({β ≥ Str, α ≤ Str} ⟹ Str)} ⟹ γ → α → β

fun bar2(a, b) =
  foo2(a, b) as Int
//│ bar2: Int → Int → Int

// Function overloads

foo2 as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

// Function applications

foo2(1, 2)
//│ Int

foo2("Hello", "World")
//│ Str

foo2(bot, bot)
//│ ⊥

// Errors

:e
foo2(1, "World")
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ Str → α.
//│ Typing error tree:
//│   Int → Int ≤ Str → α
//│     Str ≤ Int
