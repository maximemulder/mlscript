:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred

// Unique parameter

// Function definitions

fun foo(a) =
  if a is
    Int then (a as Int)
    Str then (a as Str)
//│ foo: ∀α, β. {α ≥ {β ≤ Int} ⟹ Int, β ≤ {β ≤ Str, γ ≥ Str, α ≥ Str} ⟹ ¬Int} ⟹ β → α

fun bar(a) =
  foo(a) as Int
//│ bar: Int → Int

// Function overloads

foo as (Int -> Int) & (Str -> Str)
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:65)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {α ≥ {β ≤ Int} ⟹ Int, β ≤ {β ≤ Str, γ ≥ Str, α ≥ Str} ⟹ ¬Int} ⟹ β → α ≤ (Int → Int) ∧ (Str → Str).
//│ Typing error tree:
//│   ∀α, β. {α ≥ {β ≤ Int} ⟹ Int, β ≤ {β ≤ Str, γ ≥ Str, α ≥ Str} ⟹ ¬Int} ⟹ β → α ≤ (Int → Int) ∧ (Str → Str)
//│     ∀α, β. {α ≥ {β ≤ Int} ⟹ Int, β ≤ {β ≤ Str, γ ≥ Str, α ≥ Str} ⟹ ¬Int} ⟹ β → α ≤ Str → Str
//│       ∀β. {δ ≥ {β ≤ Int} ⟹ Int, β ≤ {β ≤ Str, γ ≥ Str, δ ≥ Str} ⟹ ¬Int} ⟹ β → δ ≤ Str → Str
//│         {δ ≥ {ε ≤ Int} ⟹ Int, ε ≤ {ε ≤ Str, γ ≥ Str, δ ≥ Str} ⟹ ¬Int} ⟹ ε → δ ≤ Str → Str
//│           {ε ≤ {ε ≤ Str, γ ≥ Str, δ ≥ Str} ⟹ ¬Int} ⟹ ε → δ ≤ Str → Str
//│             ε → δ ≤ Str → Str
//│               δ ≤ Str
//│                 {ε ≤ Int} ⟹ Int ≤ Str
//│                   ε ≤ Int
//│                     Str ≤ Int

// Function applications

val int_or_string: Int | Str
//│ int_or_string: Int ∨ Str

foo(1)
//│ Int

foo("Hello")
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:65)
//│ ═══[TYPE ERROR] Cannot solve judgment Str ≤ Int.
//│ Typing error tree:
//│   Str ≤ Int

foo(bot)
//│ Int

foo(int_or_string)
//│ Int

// Errors

:te
foo as (Int -> Int) & (Str -> Str) & (Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {α ≥ {β ≤ Int} ⟹ Int, β ≤ {β ≤ Str, γ ≥ Str, α ≥ Str} ⟹ ¬Int} ⟹ β → α ≤ ((Int → Int) ∧ (Str → Str)) ∧ (Bool → Bool).
//│ Typing error tree:
//│   ∀α, β. {α ≥ {β ≤ Int} ⟹ Int, β ≤ {β ≤ Str, γ ≥ Str, α ≥ Str} ⟹ ¬Int} ⟹ β → α ≤ ((Int → Int) ∧ (Str → Str)) ∧ (Bool → Bool)
//│     ∀α, β. {α ≥ {β ≤ Int} ⟹ Int, β ≤ {β ≤ Str, γ ≥ Str, α ≥ Str} ⟹ ¬Int} ⟹ β → α ≤ (Int → Int) ∧ (Str → Str)
//│       ∀α, β. {α ≥ {β ≤ Int} ⟹ Int, β ≤ {β ≤ Str, γ ≥ Str, α ≥ Str} ⟹ ¬Int} ⟹ β → α ≤ Str → Str
//│         ∀β. {δ ≥ {β ≤ Int} ⟹ Int, β ≤ {β ≤ Str, γ ≥ Str, δ ≥ Str} ⟹ ¬Int} ⟹ β → δ ≤ Str → Str
//│           {δ ≥ {ε ≤ Int} ⟹ Int, ε ≤ {ε ≤ Str, γ ≥ Str, δ ≥ Str} ⟹ ¬Int} ⟹ ε → δ ≤ Str → Str
//│             {ε ≤ {ε ≤ Str, γ ≥ Str, δ ≥ Str} ⟹ ¬Int} ⟹ ε → δ ≤ Str → Str
//│               ε → δ ≤ Str → Str
//│                 δ ≤ Str
//│                   {ε ≤ Int} ⟹ Int ≤ Str
//│                     ε ≤ Int
//│                       Str ≤ Int

:te
foo(true)
//│ ═══[TYPE ERROR] Cannot solve judgment Bool ≤ Int.
//│ Typing error tree:
//│   Bool ≤ Int

// Multiple parameters

// Function definitons

fun foo2(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo2: ∀α, β, γ. {α ≥ {γ ≤ Int, β ≤ Int} ⟹ Int, β ≤ {γ ≤ ¬Int, γ ≤ Str, δ ≥ Str, α ≥ Str} ⟹ Str, γ ≤ {γ ≤ Str, β ≤ Str, δ ≥ Str, α ≥ Str} ⟹ ¬Int} ⟹ γ → β → α

fun bar2(a, b) =
  foo2(a, b) as Int
//│ bar2: Int → Int → Int

// Function overloads

foo2 as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:65)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {α ≥ {γ ≤ Int, β ≤ Int} ⟹ Int, β ≤ {γ ≤ ¬Int, γ ≤ Str, δ ≥ Str, α ≥ Str} ⟹ Str, γ ≤ {γ ≤ Str, β ≤ Str, δ ≥ Str, α ≥ Str} ⟹ ¬Int} ⟹ γ → β → α ≤ (Int → Int → Int) ∧ (Str → Str → Str).
//│ Typing error tree:
//│   ∀α, β, γ. {α ≥ {γ ≤ Int, β ≤ Int} ⟹ Int, β ≤ {γ ≤ ¬Int, γ ≤ Str, δ ≥ Str, α ≥ Str} ⟹ Str, γ ≤ {γ ≤ Str, β ≤ Str, δ ≥ Str, α ≥ Str} ⟹ ¬Int} ⟹ γ → β → α ≤ (Int → Int → Int) ∧ (Str → Str → Str)
//│     ∀α, β, γ. {α ≥ {γ ≤ Int, β ≤ Int} ⟹ Int, β ≤ {γ ≤ ¬Int, γ ≤ Str, δ ≥ Str, α ≥ Str} ⟹ Str, γ ≤ {γ ≤ Str, β ≤ Str, δ ≥ Str, α ≥ Str} ⟹ ¬Int} ⟹ γ → β → α ≤ Str → Str → Str
//│       ∀β, γ. {ε ≥ {γ ≤ Int, β ≤ Int} ⟹ Int, β ≤ {γ ≤ ¬Int, γ ≤ Str, δ ≥ Str, ε ≥ Str} ⟹ Str, γ ≤ {γ ≤ Str, β ≤ Str, δ ≥ Str, ε ≥ Str} ⟹ ¬Int} ⟹ γ → β → ε ≤ Str → Str → Str
//│         ∀γ. {ε ≥ {γ ≤ Int, ζ ≤ Int} ⟹ Int, ζ ≤ {γ ≤ ¬Int, γ ≤ Str, δ ≥ Str, ε ≥ Str} ⟹ Str, γ ≤ {γ ≤ Str, ζ ≤ Str, δ ≥ Str, ε ≥ Str} ⟹ ¬Int} ⟹ γ → ζ → ε ≤ Str → Str → Str
//│           {ε ≥ {η ≤ Int, ζ ≤ Int} ⟹ Int, ζ ≤ {η ≤ ¬Int, η ≤ Str, δ ≥ Str, ε ≥ Str} ⟹ Str, η ≤ {η ≤ Str, ζ ≤ Str, δ ≥ Str, ε ≥ Str} ⟹ ¬Int} ⟹ η → ζ → ε ≤ Str → Str → Str
//│             {ζ ≤ {η ≤ ¬Int, η ≤ Str, δ ≥ Str, ε ≥ Str} ⟹ Str, η ≤ {η ≤ Str, ζ ≤ Str, δ ≥ Str, ε ≥ Str} ⟹ ¬Int} ⟹ η → ζ → ε ≤ Str → Str → Str
//│               {η ≤ {η ≤ Str, ζ ≤ Str, δ ≥ Str, ε ≥ Str} ⟹ ¬Int} ⟹ η → ζ → ε ≤ Str → Str → Str
//│                 η → ζ → ε ≤ Str → Str → Str
//│                   ζ → ε ≤ Str → Str
//│                     ε ≤ Str
//│                       {η ≤ Int, ζ ≤ Int} ⟹ Int ≤ Str
//│                         η ≤ Int
//│                           Str ≤ Int

// Function applications

foo2(1, 2)
//│ Int

foo2("Hello", "World")
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:65)
//│ ═══[TYPE ERROR] Cannot solve judgment Str ≤ Int.
//│ Typing error tree:
//│   Str ≤ Int

foo2(bot, bot)
//│ Int

// Errors

:te
foo2(1, "World")
//│ ═══[TYPE ERROR] Cannot solve judgment Str ≤ Int.
//│ Typing error tree:
//│   Str ≤ Int
