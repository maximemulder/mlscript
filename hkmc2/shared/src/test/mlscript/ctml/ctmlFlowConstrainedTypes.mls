:ctml

:ctml-cfg constrained

// Function definitions

fun foo(a) =
  if a is
    Int then (a as Int)
    Str then (a as Str)
//│ foo: ∀α, β. {α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str)} ⟹ α → β

fun bar(a) =
  foo(a) as Int
//│ bar: Int → Int

// Function overloads

foo as (Int -> Int) & (Str -> Str)
//│ (Int → Int) ∧ (Str → Str)
//│ α ≤ Str, α ≥ Str, β ≥ Str, α ≥ ({β ≤ Int} ⟹ Int) ∧ ({β ≤ Str} ⟹ Str), β ≤ ({α ≥ Int} ⟹ Int) ∨ ({α ≥ Str} ⟹ Str), α flex, β flex, ε ≤ Int, ε ≥ Int, ζ ≥ Int, ε ≥ ({ζ ≤ Int} ⟹ Int) ∧ ({ζ ≤ Str} ⟹ Str), ζ ≤ ({ε ≥ Int} ⟹ Int) ∨ ({ε ≥ Str} ⟹ Str), ε flex, ζ flex

// Function applications

val int_or_string: Int | Str
//│ int_or_string: Int ∨ Str

foo(1)
//│ Int

foo("Hello")
//│ Str

foo(int_or_string)
//│ Str ∨ Int

// Errors

:e
foo as (Int -> Int) & (Str -> Str) & (Bool -> Bool)
//│ ═══[ERROR] Cannot solve judgment ∀α, β. {α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str)} ⟹ α → β ≤ ((Int → Int) ∧ (Str → Str)) ∧ (Bool → Bool).
//│ Typing error tree:
//│   ∀α, β. {α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str)} ⟹ α → β ≤ ((Int → Int) ∧ (Str → Str)) ∧ (Bool → Bool)
//│     ∀α, β. {α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str)} ⟹ α → β ≤ Bool → Bool
//│       ∀β. {γ ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ Str} ⟹ Str)} ⟹ γ → β ≤ Bool → Bool
//│         {γ ≤ ({δ ≥ Int} ⟹ Int) ∨ ({δ ≥ Str} ⟹ Str), δ ≥ ({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ Str} ⟹ Str)} ⟹ γ → δ ≤ Bool → Bool
//│           {δ ≥ ({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ Str} ⟹ Str)} ⟹ γ → δ ≤ Bool → Bool
//│             γ → δ ≤ Bool → Bool
//│               Bool ≤ γ
//│                 Bool ≤ ({δ ≥ Int} ⟹ Int) ∨ ({δ ≥ Str} ⟹ Str)
//│                   Bool ≤ {δ ≥ Int} ⟹ Int
//│                     Bool ≤ Int
//│                       Bool ≤ ⊥
//│                         ⊤ ≤ ⊥
//│                   Bool ≤ {δ ≥ Str} ⟹ Str
//│                     Bool ≤ Str
//│                       Bool ≤ ⊥
//│                         ⊤ ≤ ⊥

:e
foo(true)
//│ ═══[ERROR] Cannot solve judgment ∀α, β. {α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str)} ⟹ α → β ≤ Bool → γ.
//│ Typing error tree:
//│   ∀α, β. {α ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str)} ⟹ α → β ≤ Bool → γ
//│     ∀β. {δ ≤ ({β ≥ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({δ ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str)} ⟹ δ → β ≤ Bool → γ
//│       {δ ≤ ({ε ≥ Int} ⟹ Int) ∨ ({ε ≥ Str} ⟹ Str), ε ≥ ({δ ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str)} ⟹ δ → ε ≤ Bool → γ
//│         {ε ≥ ({δ ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str)} ⟹ δ → ε ≤ Bool → γ
//│           δ → ε ≤ Bool → γ
//│             Bool ≤ δ
//│               Bool ≤ ({ε ≥ Int} ⟹ Int) ∨ ({ε ≥ Str} ⟹ Str)
//│                 Bool ≤ {ε ≥ Int} ⟹ Int
//│                   Bool ≤ Int
//│                     Bool ≤ ⊥
//│                       ⊤ ≤ ⊥
//│                 Bool ≤ {ε ≥ Str} ⟹ Str
//│                   Bool ≤ Str
//│                     Bool ≤ ⊥
//│                       ⊤ ≤ ⊥
