// Function applications

val int_or_string: Int | Str
//│ int_or_string: Int ∨ Str

foo(1)
//│ ∀α. {α ≥ (({Int ∨ ({α ≥ Str} ⟹ Str) ≤ Int} ⟹ Int) ∧ ({Int ∨ ({α ≥ Str} ⟹ Str) ≤ Str} ⟹ Str)) ∨ Int} ⟹ α

foo("Hello")
//│ ∀α. {α ≥ (({({α ≥ Int} ⟹ Int) ∨ Str ≤ Int} ⟹ Int) ∧ ({({α ≥ Int} ⟹ Int) ∨ Str ≤ Str} ⟹ Str)) ∨ Str} ⟹ α

foo(int_or_string)
//│ ∀α, β. {α ≥ (({({α ≥ Int} ⟹ Int) ∨ Str ≤ Int} ⟹ Int) ∧ ({({α ≥ Int} ⟹ Int) ∨ Str ≤ Str} ⟹ Str)) ∨ Str, β ≥ (({Int ∨ ({β ≥ Str} ⟹ Str) ≤ Int} ⟹ Int) ∧ ({Int ∨ ({β ≥ Str} ⟹ Str) ≤ Str} ⟹ Str)) ∨ Int} ⟹ α ∨ β

