:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence arbitrary-patterns

// Function definitions

fun foo(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ foo: ∀α, β, γ. {α ≤ ({γ ≤ Int, β ≥ Int} ⟹ Int) ∨ ({γ ≤ Str, β ≥ Str} ⟹ ¬Int), β ≥ ({α ≤ Int, γ ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int, γ ≤ Str} ⟹ Str), γ ≤ ({α ≤ Int, β ≥ Int} ⟹ Int) ∨ ({α ≤ ¬Int, β ≥ Str} ⟹ Str)} ⟹ α → γ → β

// Function overloads

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

// Function applications

foo(1, 1)
//│ Int

foo("Hello", "World")
//│ Str

foo(true, "")
//│ Str

foo(bot, bot)
//│ ⊥

// Errors

:te
foo as (Bool -> Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ ({γ ≤ Int, β ≥ Int} ⟹ Int) ∨ ({γ ≤ Str, β ≥ Str} ⟹ ¬Int), β ≥ ({α ≤ Int, γ ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int, γ ≤ Str} ⟹ Str), γ ≤ ({α ≤ Int, β ≥ Int} ⟹ Int) ∨ ({α ≤ ¬Int, β ≥ Str} ⟹ Str)} ⟹ α → γ → β ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ ({γ ≤ Int, β ≥ Int} ⟹ Int) ∨ ({γ ≤ Str, β ≥ Str} ⟹ ¬Int), β ≥ ({α ≤ Int, γ ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int, γ ≤ Str} ⟹ Str), γ ≤ ({α ≤ Int, β ≥ Int} ⟹ Int) ∨ ({α ≤ ¬Int, β ≥ Str} ⟹ Str)} ⟹ α → γ → β ≤ Bool → Bool → Bool
//│     {δ ≤ ({ε ≤ Int, ζ ≥ Int} ⟹ Int) ∨ ({ε ≤ Str, ζ ≥ Str} ⟹ ¬Int), ζ ≥ ({δ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({δ ≤ ¬Int, ε ≤ Str} ⟹ Str), ε ≤ ({δ ≤ Int, ζ ≥ Int} ⟹ Int) ∨ ({δ ≤ ¬Int, ζ ≥ Str} ⟹ Str)} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│       {ζ ≥ ({δ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({δ ≤ ¬Int, ε ≤ Str} ⟹ Str), ε ≤ ({δ ≤ Int, ζ ≥ Int} ⟹ Int) ∨ ({δ ≤ ¬Int, ζ ≥ Str} ⟹ Str)} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│         {ε ≤ ({δ ≤ Int, ζ ≥ Int} ⟹ Int) ∨ ({δ ≤ ¬Int, ζ ≥ Str} ⟹ Str)} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│           δ → ε → ζ ≤ Bool → Bool → Bool
//│             ε → ζ ≤ Bool → Bool
//│               ζ ≤ Bool
//│                 ({δ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({δ ≤ ¬Int, ε ≤ Str} ⟹ Str) ≤ Bool
//│                   {δ ≤ Int, ε ≤ Int} ⟹ Int ≤ Bool
//│                     δ ≤ Int
//│                       Bool ≤ Int
//│                   {δ ≤ ¬Int, ε ≤ Str} ⟹ Str ≤ Bool
//│                     {ε ≤ Str} ⟹ Str ≤ Bool
//│                       ε ≤ Str
//│                         Bool ≤ Str

:te
foo(true, 1)
//│ ═══[TYPE ERROR] Cannot solve judgment Int ≤ Str.
//│ Typing error tree:
//│   Int ≤ Str

:te
foo(true, true)
//│ ═══[TYPE ERROR] Cannot solve judgment Bool ≤ Str.
//│ Typing error tree:
//│   Bool ≤ Str

:te
foo(1, "World")
//│ ═══[TYPE ERROR] Cannot solve judgment Str ≤ Int.
//│ Typing error tree:
//│   Str ≤ Int
