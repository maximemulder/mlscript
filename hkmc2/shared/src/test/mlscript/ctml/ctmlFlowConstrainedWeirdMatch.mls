:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence arbitrary-patterns

// Function definitions

fun foo(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ foo: ∀α, β, γ. {α ≤ ({β ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({γ ≥ ∀δ. {α ≤ {β ≤ Str, δ ≥ Str} ⟹ ⊤, δ ≥ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ δ} ⟹ ¬Int), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ (∀δ. {α ≤ ¬Int, α ≤ {β ≤ Str, δ ≥ Str} ⟹ ⊤, δ ≥ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ δ)} ⟹ α → β → γ

// Function overloads

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

// Function applications

foo(1, 1)
//│ Int

foo("Hello", "World")
//│ ∀α. {α ≥ Str} ⟹ α

foo(true, "")
//│ ∀α. {α ≥ Str} ⟹ α

foo(bot, bot)
//│ ∀α. α

// Errors

:te
foo as (Bool -> Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ ({β ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({γ ≥ ∀δ. {α ≤ {β ≤ Str, δ ≥ Str} ⟹ ⊤, δ ≥ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ δ} ⟹ ¬Int), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ (∀δ. {α ≤ ¬Int, α ≤ {β ≤ Str, δ ≥ Str} ⟹ ⊤, δ ≥ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ δ)} ⟹ α → β → γ ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ ({β ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({γ ≥ ∀δ. {α ≤ {β ≤ Str, δ ≥ Str} ⟹ ⊤, δ ≥ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ δ} ⟹ ¬Int), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ (∀δ. {α ≤ ¬Int, α ≤ {β ≤ Str, δ ≥ Str} ⟹ ⊤, δ ≥ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ δ)} ⟹ α → β → γ ≤ Bool → Bool → Bool
//│     {ε ≤ ({ζ ≤ Int, η ≥ Int} ⟹ Int) ∨ ({η ≥ ∀δ. {ε ≤ {ζ ≤ Str, δ ≥ Str} ⟹ ⊤, δ ≥ ({ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ δ} ⟹ ¬Int), η ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ (∀δ. {ε ≤ ¬Int, ε ≤ {ζ ≤ Str, δ ≥ Str} ⟹ ⊤, δ ≥ ({ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ δ)} ⟹ ε → ζ → η ≤ Bool → Bool → Bool
//│       {η ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ (∀δ. {ε ≤ ¬Int, ε ≤ {ζ ≤ Str, δ ≥ Str} ⟹ ⊤, δ ≥ ({ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ δ)} ⟹ ε → ζ → η ≤ Bool → Bool → Bool
//│         ε → ζ → η ≤ Bool → Bool → Bool
//│           ζ → η ≤ Bool → Bool
//│             η ≤ Bool
//│               ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ (∀δ. {ε ≤ ¬Int, ε ≤ {ζ ≤ Str, δ ≥ Str} ⟹ ⊤, δ ≥ ({ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ δ) ≤ Bool
//│                 {ε ≤ Int, ζ ≤ Int} ⟹ Int ≤ Bool
//│                   ε ≤ Int
//│                     Bool ≤ Int
//│                 ∀δ. {ε ≤ ¬Int, ε ≤ {ζ ≤ Str, δ ≥ Str} ⟹ ⊤, δ ≥ ({ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ δ ≤ Bool
//│                   {ε ≤ ¬Int, ε ≤ {ζ ≤ Str, θ ≥ Str} ⟹ ⊤, θ ≥ ({ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ θ ≤ Bool
//│                     {ε ≤ {ζ ≤ Str, θ ≥ Str} ⟹ ⊤, θ ≥ ({ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ θ ≤ Bool
//│                       {θ ≥ ({ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ θ ≤ Bool
//│                         θ ≤ Bool
//│                           ({ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥) ≤ Bool
//│                             {ζ ≤ Str} ⟹ Str ≤ Bool
//│                               ζ ≤ Str
//│                                 Bool ≤ Str
//│                             {ε ≤ ⊥} ⟹ ⊥ ≤ Bool
//│                               ε ≤ ⊥
//│                                 Bool ≤ ⊥

foo(true, 1)
//│ ∀α. {α ≥ {Bool ≤ ⊥} ⟹ ⊥} ⟹ α

foo(true, true)
//│ ∀α. {α ≥ {Bool ≤ ⊥} ⟹ ⊥} ⟹ α

foo(1, "World")
//│ ∀α. {Int ≤ ¬Int, α ≥ Str} ⟹ α
