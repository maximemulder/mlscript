:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence arbitrary-patterns

// Function definitions

fun foo(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ foo: ∀α, β, γ. {γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)), α ≤ ({β ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({γ ≥ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ ¬Int)} ⟹ α → β → γ

// Function overloads

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

// Function applications

foo(1, 1)
//│ Int

foo("Hello", "World")
//│ Str

foo(true, "")
//│ Str

foo(bot, bot)
//│ ⊥

// Errors

:te
foo as (Bool -> Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)), α ≤ ({β ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({γ ≥ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ ¬Int)} ⟹ α → β → γ ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α, β, γ. {γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)), α ≤ ({β ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({γ ≥ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ ¬Int)} ⟹ α → β → γ ≤ Bool → Bool → Bool
//│     {ζ ≥ ({δ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({δ ≤ ¬Int} ⟹ ({ε ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)), δ ≤ ({ε ≤ Int, ζ ≥ Int} ⟹ Int) ∨ ({ζ ≥ ({ε ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ ¬Int)} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│       {δ ≤ ({ε ≤ Int, ζ ≥ Int} ⟹ Int) ∨ ({ζ ≥ ({ε ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ ¬Int)} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│         δ → ε → ζ ≤ Bool → Bool → Bool
//│           ε → ζ ≤ Bool → Bool
//│             ζ ≤ Bool
//│               ({δ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({δ ≤ ¬Int} ⟹ ({ε ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)) ≤ Bool
//│                 {δ ≤ Int, ε ≤ Int} ⟹ Int ≤ Bool
//│                   δ ≤ Int
//│                     Bool ≤ Int
//│                 {δ ≤ ¬Int} ⟹ ({ε ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥) ≤ Bool
//│                   ({ε ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥) ≤ Bool
//│                     {ε ≤ Str} ⟹ Str ≤ Bool
//│                       ε ≤ Str
//│                         Bool ≤ Str
//│                     {δ ≤ ⊥} ⟹ ⊥ ≤ Bool
//│                       δ ≤ ⊥
//│                         Bool ≤ ⊥

:te
foo(true, 1)
//│ ═══[TYPE ERROR] Cannot solve judgment Bool ≤ ⊥.
//│ Typing error tree:
//│   Bool ≤ ⊥

:te
foo(true, true)
//│ ═══[TYPE ERROR] Cannot solve judgment Bool ≤ ⊥.
//│ Typing error tree:
//│   Bool ≤ ⊥

:te
foo(1, "World")
//│ ═══[TYPE ERROR] Cannot solve judgment Int ≤ ¬Int.
//│ Typing error tree:
//│   Int ≤ ¬Int
