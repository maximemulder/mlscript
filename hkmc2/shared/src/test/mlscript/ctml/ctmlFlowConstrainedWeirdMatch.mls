:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence arbitrary-patterns

// Function definitions

fun foo(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ foo: ∀α. α → (∀β. β → (∀γ. {β ≤ ({γ ≥ Int, α ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, α ≤ ¬Int} ⟹ Str), α ≤ ({γ ≥ Int, β ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, β ≤ Str} ⟹ ¬Int), γ ≥ ({β ≤ Int, α ≤ Int} ⟹ Int) ∧ ({β ≤ Str, α ≤ ¬Int} ⟹ Str)} ⟹ γ))

// Function overloads

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

// Function applications

foo(1, 1)
//│ ∀α. {α ≥ Int} ⟹ α

foo("Hello", "World")
//│ ∀α. {α ≥ Str} ⟹ α

foo(true, "")
//│ ∀α. {α ≥ Str} ⟹ α

foo(bot, bot)
//│ ∀α. α

// Errors

:te
foo as (Bool -> Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α. α → (∀β. β → (∀γ. {β ≤ ({γ ≥ Int, α ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, α ≤ ¬Int} ⟹ Str), α ≤ ({γ ≥ Int, β ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, β ≤ Str} ⟹ ¬Int), γ ≥ ({β ≤ Int, α ≤ Int} ⟹ Int) ∧ ({β ≤ Str, α ≤ ¬Int} ⟹ Str)} ⟹ γ)) ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α. α → (∀β. β → (∀γ. {β ≤ ({γ ≥ Int, α ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, α ≤ ¬Int} ⟹ Str), α ≤ ({γ ≥ Int, β ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, β ≤ Str} ⟹ ¬Int), γ ≥ ({β ≤ Int, α ≤ Int} ⟹ Int) ∧ ({β ≤ Str, α ≤ ¬Int} ⟹ Str)} ⟹ γ)) ≤ Bool → Bool → Bool
//│     δ → (∀β. β → (∀γ. {β ≤ ({γ ≥ Int, δ ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, δ ≤ ¬Int} ⟹ Str), δ ≤ ({γ ≥ Int, β ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, β ≤ Str} ⟹ ¬Int), γ ≥ ({β ≤ Int, δ ≤ Int} ⟹ Int) ∧ ({β ≤ Str, δ ≤ ¬Int} ⟹ Str)} ⟹ γ)) ≤ Bool → Bool → Bool
//│       ∀β. β → (∀γ. {β ≤ ({γ ≥ Int, δ ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, δ ≤ ¬Int} ⟹ Str), δ ≤ ({γ ≥ Int, β ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, β ≤ Str} ⟹ ¬Int), γ ≥ ({β ≤ Int, δ ≤ Int} ⟹ Int) ∧ ({β ≤ Str, δ ≤ ¬Int} ⟹ Str)} ⟹ γ) ≤ Bool → Bool
//│         ε → (∀γ. {ε ≤ ({γ ≥ Int, δ ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, δ ≤ ¬Int} ⟹ Str), δ ≤ ({γ ≥ Int, ε ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, ε ≤ Str} ⟹ ¬Int), γ ≥ ({ε ≤ Int, δ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, δ ≤ ¬Int} ⟹ Str)} ⟹ γ) ≤ Bool → Bool
//│           ∀γ. {ε ≤ ({γ ≥ Int, δ ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, δ ≤ ¬Int} ⟹ Str), δ ≤ ({γ ≥ Int, ε ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, ε ≤ Str} ⟹ ¬Int), γ ≥ ({ε ≤ Int, δ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, δ ≤ ¬Int} ⟹ Str)} ⟹ γ ≤ Bool
//│             {ε ≤ ({ζ ≥ Int, δ ≤ Int} ⟹ Int) ∨ ({ζ ≥ Str, δ ≤ ¬Int} ⟹ Str), δ ≤ ({ζ ≥ Int, ε ≤ Int} ⟹ Int) ∨ ({ζ ≥ Str, ε ≤ Str} ⟹ ¬Int), ζ ≥ ({ε ≤ Int, δ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, δ ≤ ¬Int} ⟹ Str)} ⟹ ζ ≤ Bool
//│               {δ ≤ ({ζ ≥ Int, ε ≤ Int} ⟹ Int) ∨ ({ζ ≥ Str, ε ≤ Str} ⟹ ¬Int), ζ ≥ ({ε ≤ Int, δ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, δ ≤ ¬Int} ⟹ Str)} ⟹ ζ ≤ Bool
//│                 {ζ ≥ ({ε ≤ Int, δ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, δ ≤ ¬Int} ⟹ Str)} ⟹ ζ ≤ Bool
//│                   ζ ≤ Bool
//│                     ({ε ≤ Int, δ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, δ ≤ ¬Int} ⟹ Str) ≤ Bool
//│                       {ε ≤ Int, δ ≤ Int} ⟹ Int ≤ Bool
//│                         ε ≤ Int
//│                           Bool ∨ η ≤ Int
//│                             Bool ≤ Int
//│                       {ε ≤ Str, δ ≤ ¬Int} ⟹ Str ≤ Bool
//│                         ε ≤ Str
//│                           Bool ∨ η ≤ Str
//│                             Bool ≤ Str

:te
foo(true, 1)
//│ ∀α. {α ≥ {Int ≤ Str} ⟹ Str} ⟹ α
//│ FAILURE: Unexpected lack of type error

:te
foo(true, true)
//│ ∀α. {α ≥ {Bool ≤ Str} ⟹ Str} ⟹ α
//│ FAILURE: Unexpected lack of type error

:te
foo(1, "World")
//│ ∀α. {α ≥ {Str ≤ Int} ⟹ Int} ⟹ α
//│ FAILURE: Unexpected lack of type error
