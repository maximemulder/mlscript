:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence arbitrary-patterns

// Function definitions

fun foo(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ foo: ∀α, β, γ, δ. {δ ≥ ({α ≤ Int, β ≤ Int, γ ≥ Int} ⟹ ⊥) ∧ ({γ ≥ δ} ⟹ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({δ ≥ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ δ)} ⟹ α → β → γ

// Function overloads

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

// Function applications

foo(1, 1)
//│ Int

foo("Hello", "World")
//│ Str

foo(true, "")
//│ Str

foo(bot, bot)
//│ ∀α, β. {β ≥ Int ∧ α, α ≥ ({β ≥ Int} ⟹ ⊥) ∧ ({β ≥ α} ⟹ ⊥)} ⟹ β

// Errors

:te
foo as (Bool -> Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ, δ. {δ ≥ ({α ≤ Int, β ≤ Int, γ ≥ Int} ⟹ ⊥) ∧ ({γ ≥ δ} ⟹ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({δ ≥ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ δ)} ⟹ α → β → γ ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α, β, γ, δ. {δ ≥ ({α ≤ Int, β ≤ Int, γ ≥ Int} ⟹ ⊥) ∧ ({γ ≥ δ} ⟹ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({δ ≥ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ δ)} ⟹ α → β → γ ≤ Bool → Bool → Bool
//│     {θ ≥ ({ε ≤ Int, ζ ≤ Int, η ≥ Int} ⟹ ⊥) ∧ ({η ≥ θ} ⟹ ({ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)), η ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({θ ≥ ({ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ θ)} ⟹ ε → ζ → η ≤ Bool → Bool → Bool
//│       {η ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({θ ≥ ({ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ θ)} ⟹ ε → ζ → η ≤ Bool → Bool → Bool
//│         ε → ζ → η ≤ Bool → Bool → Bool
//│           ζ → η ≤ Bool → Bool
//│             η ≤ Bool
//│               ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({θ ≥ ({ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ θ) ≤ Bool
//│                 {ε ≤ Int, ζ ≤ Int} ⟹ Int ≤ Bool
//│                   ε ≤ Int
//│                     Bool ≤ Int
//│                 {θ ≥ ({ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ θ ≤ Bool
//│                   θ ≤ Bool
//│                     ({ε ≤ Int, ζ ≤ Int, η ≥ Int} ⟹ ⊥) ∧ ({η ≥ θ} ⟹ ({ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)) ≤ Bool
//│                       {ε ≤ Int, ζ ≤ Int, η ≥ Int} ⟹ ⊥ ≤ Bool
//│                         ε ≤ Int
//│                           Bool ≤ Int
//│                       {η ≥ θ} ⟹ ({ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥) ≤ Bool
//│                         ({ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥) ≤ Bool
//│                           {ζ ≤ Str} ⟹ Str ≤ Bool
//│                             ζ ≤ Str
//│                               Bool ≤ Str
//│                           {ε ≤ ⊥} ⟹ ⊥ ≤ Bool
//│                             ε ≤ ⊥
//│                               Bool ≤ ⊥

:te
foo(true, 1)
//│ ═══[TYPE ERROR] Cannot solve judgment Bool ≤ ⊥.
//│ Typing error tree:
//│   Bool ≤ ⊥

:te
foo(true, true)
//│ ═══[TYPE ERROR] Cannot solve judgment Bool ≤ ⊥.
//│ Typing error tree:
//│   Bool ≤ ⊥

:te
foo(1, "World")
//│ Str
//│ FAILURE: Unexpected lack of type error
