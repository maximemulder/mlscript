:ctml

:ctml-cfg constrained weird-match

// Function definitions

fun foo(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ foo: ∀α, β, γ. {α ≤ ({β ≥ Int, γ ≤ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int, γ ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str), γ ≤ {β ≥ Str, α ≤ Str} ⟹ ⊤} ⟹ γ → α → β

// Function overloads

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

// Function applications

foo(1, 1)
//│ Int

foo("Hello", "World")
//│ Str

foo(true, "")
//│ Str

foo(bot, bot)
//│ ⊥

// Errors

:e
foo as (Bool -> Bool -> Bool)
//│ ═══[ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ ({β ≥ Int, γ ≤ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int, γ ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str), γ ≤ {β ≥ Str, α ≤ Str} ⟹ ⊤} ⟹ γ → α → β ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ ({β ≥ Int, γ ≤ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int, γ ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str), γ ≤ {β ≥ Str, α ≤ Str} ⟹ ⊤} ⟹ γ → α → β ≤ Bool → Bool → Bool
//│     ∀β, γ. {δ ≤ ({β ≥ Int, γ ≤ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({δ ≤ Int, γ ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str), γ ≤ {β ≥ Str, δ ≤ Str} ⟹ ⊤} ⟹ γ → δ → β ≤ Bool → Bool → Bool
//│       ∀γ. {δ ≤ ({ε ≥ Int, γ ≤ Int} ⟹ Int) ∨ ({ε ≥ Str} ⟹ Str), ε ≥ ({δ ≤ Int, γ ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str), γ ≤ {ε ≥ Str, δ ≤ Str} ⟹ ⊤} ⟹ γ → δ → ε ≤ Bool → Bool → Bool
//│         {δ ≤ ({ε ≥ Int, ζ ≤ Int} ⟹ Int) ∨ ({ε ≥ Str} ⟹ Str), ε ≥ ({δ ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str), ζ ≤ {ε ≥ Str, δ ≤ Str} ⟹ ⊤} ⟹ ζ → δ → ε ≤ Bool → Bool → Bool
//│           {ε ≥ ({δ ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str), ζ ≤ {ε ≥ Str, δ ≤ Str} ⟹ ⊤} ⟹ ζ → δ → ε ≤ Bool → Bool → Bool
//│             {ζ ≤ {ε ≥ Str, δ ≤ Str} ⟹ ⊤} ⟹ ζ → δ → ε ≤ Bool → Bool → Bool
//│               ζ → δ → ε ≤ Bool → Bool → Bool
//│                 δ → ε ≤ Bool → Bool
//│                   Bool ≤ δ
//│                     Bool ≤ ({ε ≥ Int, ζ ≤ Int} ⟹ Int) ∨ ({ε ≥ Str} ⟹ Str)
//│                       Bool ≤ {ε ≥ Int, ζ ≤ Int} ⟹ Int
//│                         Bool ≤ {ζ ≤ Int} ⟹ Int
//│                           ζ ≤ Int
//│                             Bool ≤ Int
//│                       Bool ≤ {ε ≥ Str} ⟹ Str
//│                         Bool ≤ Str

:e
foo(true, 1)
//│ ═══[ERROR] Cannot solve judgment ∀α, β. {α ≤ ({β ≥ Int, Bool ≤ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int, Bool ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str)} ⟹ α → β ≤ Int → γ.
//│ Typing error tree:
//│   ∀α, β. {α ≤ ({β ≥ Int, Bool ≤ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int, Bool ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str)} ⟹ α → β ≤ Int → γ
//│     ∀β. {δ ≤ ({β ≥ Int, Bool ≤ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({δ ≤ Int, Bool ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str)} ⟹ δ → β ≤ Int → γ
//│       {δ ≤ ({ε ≥ Int, Bool ≤ Int} ⟹ Int) ∨ ({ε ≥ Str} ⟹ Str), ε ≥ ({δ ≤ Int, Bool ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str)} ⟹ δ → ε ≤ Int → γ
//│         {ε ≥ ({δ ≤ Int, Bool ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str)} ⟹ δ → ε ≤ Int → γ
//│           δ → ε ≤ Int → γ
//│             Int ≤ δ
//│               Int ≤ ({ε ≥ Int, Bool ≤ Int} ⟹ Int) ∨ ({ε ≥ Str} ⟹ Str)
//│                 Int ≤ {ε ≥ Int, Bool ≤ Int} ⟹ Int
//│                   Int ≤ {Bool ≤ Int} ⟹ Int
//│                     Bool ≤ Int
//│                 Int ≤ {ε ≥ Str} ⟹ Str
//│                   Int ≤ Str

:e
foo(true, true)
//│ ═══[ERROR] Cannot solve judgment ∀α, β. {α ≤ ({β ≥ Int, Bool ≤ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int, Bool ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str)} ⟹ α → β ≤ Bool → γ.
//│ Typing error tree:
//│   ∀α, β. {α ≤ ({β ≥ Int, Bool ≤ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int, Bool ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str)} ⟹ α → β ≤ Bool → γ
//│     ∀β. {δ ≤ ({β ≥ Int, Bool ≤ Int} ⟹ Int) ∨ ({β ≥ Str} ⟹ Str), β ≥ ({δ ≤ Int, Bool ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str)} ⟹ δ → β ≤ Bool → γ
//│       {δ ≤ ({ε ≥ Int, Bool ≤ Int} ⟹ Int) ∨ ({ε ≥ Str} ⟹ Str), ε ≥ ({δ ≤ Int, Bool ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str)} ⟹ δ → ε ≤ Bool → γ
//│         {ε ≥ ({δ ≤ Int, Bool ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str)} ⟹ δ → ε ≤ Bool → γ
//│           δ → ε ≤ Bool → γ
//│             Bool ≤ δ
//│               Bool ≤ ({ε ≥ Int, Bool ≤ Int} ⟹ Int) ∨ ({ε ≥ Str} ⟹ Str)
//│                 Bool ≤ {ε ≥ Int, Bool ≤ Int} ⟹ Int
//│                   Bool ≤ {Bool ≤ Int} ⟹ Int
//│                     Bool ≤ Int
//│                 Bool ≤ {ε ≥ Str} ⟹ Str
//│                   Bool ≤ Str


// There seems to be a problem with variable being inlined too eagerly.
:breakme
foo(1, "World")
//│ Str
