:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred arbitrary-patterns

// Function definitions

fun foo(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ foo: ∀α, β, γ. {α ≥ {γ ≤ Int, β ≤ Int} ⟹ Int, β ≤ {γ ≤ ¬Int, δ ≥ Str, α ≥ Str} ⟹ Str, γ ≤ {β ≤ Str, δ ≥ Str, α ≥ Str} ⟹ ¬Int} ⟹ γ → β → α

// Function overloads

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:65)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {α ≥ {γ ≤ Int, β ≤ Int} ⟹ Int, β ≤ {γ ≤ ¬Int, δ ≥ Str, α ≥ Str} ⟹ Str, γ ≤ {β ≤ Str, δ ≥ Str, α ≥ Str} ⟹ ¬Int} ⟹ γ → β → α ≤ (Int → Int → Int) ∧ (Str → Str → Str).
//│ Typing error tree:
//│   ∀α, β, γ. {α ≥ {γ ≤ Int, β ≤ Int} ⟹ Int, β ≤ {γ ≤ ¬Int, δ ≥ Str, α ≥ Str} ⟹ Str, γ ≤ {β ≤ Str, δ ≥ Str, α ≥ Str} ⟹ ¬Int} ⟹ γ → β → α ≤ (Int → Int → Int) ∧ (Str → Str → Str)
//│     ∀α, β, γ. {α ≥ {γ ≤ Int, β ≤ Int} ⟹ Int, β ≤ {γ ≤ ¬Int, δ ≥ Str, α ≥ Str} ⟹ Str, γ ≤ {β ≤ Str, δ ≥ Str, α ≥ Str} ⟹ ¬Int} ⟹ γ → β → α ≤ Str → Str → Str
//│       ∀β, γ. {ε ≥ {γ ≤ Int, β ≤ Int} ⟹ Int, β ≤ {γ ≤ ¬Int, δ ≥ Str, ε ≥ Str} ⟹ Str, γ ≤ {β ≤ Str, δ ≥ Str, ε ≥ Str} ⟹ ¬Int} ⟹ γ → β → ε ≤ Str → Str → Str
//│         ∀γ. {ε ≥ {γ ≤ Int, ζ ≤ Int} ⟹ Int, ζ ≤ {γ ≤ ¬Int, δ ≥ Str, ε ≥ Str} ⟹ Str, γ ≤ {ζ ≤ Str, δ ≥ Str, ε ≥ Str} ⟹ ¬Int} ⟹ γ → ζ → ε ≤ Str → Str → Str
//│           {ε ≥ {η ≤ Int, ζ ≤ Int} ⟹ Int, ζ ≤ {η ≤ ¬Int, δ ≥ Str, ε ≥ Str} ⟹ Str, η ≤ {ζ ≤ Str, δ ≥ Str, ε ≥ Str} ⟹ ¬Int} ⟹ η → ζ → ε ≤ Str → Str → Str
//│             {ζ ≤ {η ≤ ¬Int, δ ≥ Str, ε ≥ Str} ⟹ Str, η ≤ {ζ ≤ Str, δ ≥ Str, ε ≥ Str} ⟹ ¬Int} ⟹ η → ζ → ε ≤ Str → Str → Str
//│               {η ≤ {ζ ≤ Str, δ ≥ Str, ε ≥ Str} ⟹ ¬Int} ⟹ η → ζ → ε ≤ Str → Str → Str
//│                 η → ζ → ε ≤ Str → Str → Str
//│                   ζ → ε ≤ Str → Str
//│                     ε ≤ Str
//│                       {η ≤ Int, ζ ≤ Int} ⟹ Int ≤ Str
//│                         η ≤ Int
//│                           Str ≤ Int

// Function applications

foo(1, 1)
//│ Int

foo("Hello", "World")
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:65)
//│ ═══[TYPE ERROR] Cannot solve judgment Str ≤ Int.
//│ Typing error tree:
//│   Str ≤ Int

foo(true, "")
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:65)
//│ ═══[TYPE ERROR] Cannot solve judgment Bool ≤ Int.
//│ Typing error tree:
//│   Bool ≤ Int

foo(bot, bot)
//│ Int

// Errors

:te
foo as (Bool -> Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {α ≥ {γ ≤ Int, β ≤ Int} ⟹ Int, β ≤ {γ ≤ ¬Int, δ ≥ Str, α ≥ Str} ⟹ Str, γ ≤ {β ≤ Str, δ ≥ Str, α ≥ Str} ⟹ ¬Int} ⟹ γ → β → α ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≥ {γ ≤ Int, β ≤ Int} ⟹ Int, β ≤ {γ ≤ ¬Int, δ ≥ Str, α ≥ Str} ⟹ Str, γ ≤ {β ≤ Str, δ ≥ Str, α ≥ Str} ⟹ ¬Int} ⟹ γ → β → α ≤ Bool → Bool → Bool
//│     ∀β, γ. {ε ≥ {γ ≤ Int, β ≤ Int} ⟹ Int, β ≤ {γ ≤ ¬Int, δ ≥ Str, ε ≥ Str} ⟹ Str, γ ≤ {β ≤ Str, δ ≥ Str, ε ≥ Str} ⟹ ¬Int} ⟹ γ → β → ε ≤ Bool → Bool → Bool
//│       ∀γ. {ε ≥ {γ ≤ Int, ζ ≤ Int} ⟹ Int, ζ ≤ {γ ≤ ¬Int, δ ≥ Str, ε ≥ Str} ⟹ Str, γ ≤ {ζ ≤ Str, δ ≥ Str, ε ≥ Str} ⟹ ¬Int} ⟹ γ → ζ → ε ≤ Bool → Bool → Bool
//│         {ε ≥ {η ≤ Int, ζ ≤ Int} ⟹ Int, ζ ≤ {η ≤ ¬Int, δ ≥ Str, ε ≥ Str} ⟹ Str, η ≤ {ζ ≤ Str, δ ≥ Str, ε ≥ Str} ⟹ ¬Int} ⟹ η → ζ → ε ≤ Bool → Bool → Bool
//│           {ζ ≤ {η ≤ ¬Int, δ ≥ Str, ε ≥ Str} ⟹ Str, η ≤ {ζ ≤ Str, δ ≥ Str, ε ≥ Str} ⟹ ¬Int} ⟹ η → ζ → ε ≤ Bool → Bool → Bool
//│             {η ≤ {ζ ≤ Str, δ ≥ Str, ε ≥ Str} ⟹ ¬Int} ⟹ η → ζ → ε ≤ Bool → Bool → Bool
//│               η → ζ → ε ≤ Bool → Bool → Bool
//│                 ζ → ε ≤ Bool → Bool
//│                   ε ≤ Bool
//│                     {η ≤ Int, ζ ≤ Int} ⟹ Int ≤ Bool
//│                       η ≤ Int
//│                         Bool ≤ Int

:te
foo(true, 1)
//│ ═══[TYPE ERROR] Cannot solve judgment Bool ≤ Int.
//│ Typing error tree:
//│   Bool ≤ Int

:te
foo(true, true)
//│ ═══[TYPE ERROR] Cannot solve judgment Bool ≤ Int.
//│ Typing error tree:
//│   Bool ≤ Int

:te
foo(1, "World")
//│ ═══[TYPE ERROR] Cannot solve judgment Str ≤ Int.
//│ Typing error tree:
//│   Str ≤ Int
