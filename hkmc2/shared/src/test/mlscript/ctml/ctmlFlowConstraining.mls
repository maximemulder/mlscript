:ctml

:ctml-cfg merge-constring

// Function definitions

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str, α ≤ ¬Int}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ Str, α ≤ ¬Int})} ⟹ α → β → γ

fun bar(a, b) =
  foo(a, b) as Int
//│ bar: Int → Int → Int

// Function overloads

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

foo as (Int -> Int -> Int)
//│ Int → Int → Int

foo as (Str -> Str -> Str)
//│ Str → Str → Str

foo as (Bot -> Bot -> Top)
//│ ⊥ → ⊥ → ⊤

// Function applications

foo(1, 1)
//│ Int

foo("Hello", "World")
//│ Str

foo(bot, bot)
//│ ⊥

// Errors

:te
foo as (Bool -> Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str, α ≤ ¬Int}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ Str, α ≤ ¬Int})} ⟹ α → β → γ ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str, α ≤ ¬Int}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ Str, α ≤ ¬Int})} ⟹ α → β → γ ≤ Bool → Bool → Bool
//│     ∀β, γ. {δ ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, δ ≤ Str, δ ≤ ¬Int}), γ ≥ (Int ⟹ {β ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {β ≤ Str, δ ≤ Str, δ ≤ ¬Int})} ⟹ δ → β → γ ≤ Bool → Bool → Bool
//│       ∀γ. {δ ≤ (Int ⟹ {γ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, ε ≤ Str}), ε ≤ (Int ⟹ {γ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, δ ≤ Str, δ ≤ ¬Int}), γ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ Str, δ ≤ ¬Int})} ⟹ δ → ε → γ ≤ Bool → Bool → Bool
//│         {δ ≤ (Int ⟹ {ζ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, ε ≤ Str}), ε ≤ (Int ⟹ {ζ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, δ ≤ Str, δ ≤ ¬Int}), ζ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ Str, δ ≤ ¬Int})} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│           {ε ≤ (Int ⟹ {ζ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, δ ≤ Str, δ ≤ ¬Int}), ζ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ Str, δ ≤ ¬Int})} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│             {ζ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ Str, δ ≤ ¬Int})} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│               δ → ε → ζ ≤ Bool → Bool → Bool
//│                 Bool ≤ δ
//│                   Bool ≤ ((Int ⟹ {ζ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, ε ≤ Str})) ∧ η
//│                     Bool ≤ (Int ⟹ {ζ ≥ Int, ε ≤ Int}) ∧ η
//│                       Bool ≤ Int ⟹ {ζ ≥ Int, ε ≤ Int}
//│                         Bool ≤ Int ⟹ {ε ≤ Int}
//│                           Bool ≤ Int
//│                     Bool ≤ (Str ⟹ {ζ ≥ Str, ε ≤ Str}) ∧ η
//│                       Bool ≤ Str ⟹ {ζ ≥ Str, ε ≤ Str}
//│                         Bool ≤ Str ⟹ {ε ≤ Str}
//│                           Bool ≤ Str

:te
foo as ((Int | Str) -> (Int | Str) -> (Int | Str))
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str, α ≤ ¬Int}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ Str, α ≤ ¬Int})} ⟹ α → β → γ ≤ (Int ∨ Str) → (Int ∨ Str) → (Int ∨ Str).
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str, α ≤ ¬Int}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ Str, α ≤ ¬Int})} ⟹ α → β → γ ≤ (Int ∨ Str) → (Int ∨ Str) → (Int ∨ Str)
//│     ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str, α ≤ ¬Int}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ Str, α ≤ ¬Int})} ⟹ α → β → γ ≤ Int → (Int ∨ Str) → (Int ∨ Str)
//│       ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str, α ≤ ¬Int}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ Str, α ≤ ¬Int})} ⟹ α → β → γ ≤ Int → Str → (Int ∨ Str)
//│         ∀β, γ. {δ ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, δ ≤ Str, δ ≤ ¬Int}), γ ≥ (Int ⟹ {β ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {β ≤ Str, δ ≤ Str, δ ≤ ¬Int})} ⟹ δ → β → γ ≤ Int → Str → (Int ∨ Str)
//│           ∀γ. {δ ≤ (Int ⟹ {γ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, ε ≤ Str}), ε ≤ (Int ⟹ {γ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, δ ≤ Str, δ ≤ ¬Int}), γ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ Str, δ ≤ ¬Int})} ⟹ δ → ε → γ ≤ Int → Str → (Int ∨ Str)
//│             {δ ≤ (Int ⟹ {ζ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, ε ≤ Str}), ε ≤ (Int ⟹ {ζ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, δ ≤ Str, δ ≤ ¬Int}), ζ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ Str, δ ≤ ¬Int})} ⟹ δ → ε → ζ ≤ Int → Str → (Int ∨ Str)
//│               {ε ≤ (Int ⟹ {ζ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, δ ≤ Str, δ ≤ ¬Int}), ζ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ Str, δ ≤ ¬Int})} ⟹ δ → ε → ζ ≤ Int → Str → (Int ∨ Str)
//│                 {ζ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ Str, δ ≤ ¬Int})} ⟹ δ → ε → ζ ≤ Int → Str → (Int ∨ Str)
//│                   δ → ε → ζ ≤ Int → Str → (Int ∨ Str)
//│                     ε → ζ ≤ Str → (Int ∨ Str)
//│                       Str ≤ ε
//│                         Str ≤ (((Int ⟹ {ζ ≥ Int, η ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, η ≤ Str, η ≤ ¬Int})) ∧ θ) ∧ Int
//│                           Str ≤ ((Int ⟹ {ζ ≥ Int, η ≤ Int}) ∧ θ) ∧ Int
//│                             Str ≤ (Int ⟹ {ζ ≥ Int, η ≤ Int}) ∧ θ
//│                               Str ≤ Int ⟹ {ζ ≥ Int, η ≤ Int}
//│                                 Str ≤ Int ⟹ {η ≤ Int}
//│                                   Str ≤ Int
//│                           Str ≤ ((Str ⟹ {ζ ≥ Str, η ≤ Str, η ≤ ¬Int}) ∧ θ) ∧ Int
//│                             Str ≤ Int

