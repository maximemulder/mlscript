:ctml

// Function definitions

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀α, β, γ. {α ≤ (Int ⟹ {β ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {β ≥ Str, γ ≤ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {β ≥ Int, α ≤ Int}) ∨ (Str ⟹ {β ≥ Str, α ≤ Str})} ⟹ γ → α → β

fun bar(a, b) =
  foo(a, b) as Int
//│ bar: Int → Int → Int

// Function overloads

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

foo as (Int -> Int -> Int)
//│ Int → Int → Int

foo as (Str -> Str -> Str)
//│ Str → Str → Str

foo as (Bot -> Bot -> Top)
//│ ⊥ → ⊥ → ⊤

// Function applications

foo(1, 1)
//│ Int

foo("Hello", "World")
//│ Str

foo(bot, bot)
//│ ⊥

// Errors

:e
foo as (Bool -> Bool -> Bool)
//│ ═══[ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ (Int ⟹ {β ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {β ≥ Str, γ ≤ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {β ≥ Int, α ≤ Int}) ∨ (Str ⟹ {β ≥ Str, α ≤ Str})} ⟹ γ → α → β ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ (Int ⟹ {β ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {β ≥ Str, γ ≤ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {β ≥ Int, α ≤ Int}) ∨ (Str ⟹ {β ≥ Str, α ≤ Str})} ⟹ γ → α → β ≤ Bool → Bool → Bool
//│     ∀β, γ. {δ ≤ (Int ⟹ {β ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {β ≥ Str, γ ≤ Str}), β ≥ (Int ⟹ {δ ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {δ ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {β ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {β ≥ Str, δ ≤ Str})} ⟹ γ → δ → β ≤ Bool → Bool → Bool
//│       ∀γ. {δ ≤ (Int ⟹ {ε ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, γ ≤ Str}), ε ≥ (Int ⟹ {δ ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {δ ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {ε ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, δ ≤ Str})} ⟹ γ → δ → ε ≤ Bool → Bool → Bool
//│         {δ ≤ (Int ⟹ {ε ≥ Int, ζ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, ζ ≤ Str}), ε ≥ (Int ⟹ {δ ≤ Int, ζ ≤ Int}) ∧ (Str ⟹ {δ ≤ Str, ζ ≤ Str}), ζ ≤ (Int ⟹ {ε ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, δ ≤ Str})} ⟹ ζ → δ → ε ≤ Bool → Bool → Bool
//│           {ε ≥ (Int ⟹ {δ ≤ Int, ζ ≤ Int}) ∧ (Str ⟹ {δ ≤ Str, ζ ≤ Str}), ζ ≤ (Int ⟹ {ε ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, δ ≤ Str})} ⟹ ζ → δ → ε ≤ Bool → Bool → Bool
//│             {ζ ≤ (Int ⟹ {ε ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, δ ≤ Str})} ⟹ ζ → δ → ε ≤ Bool → Bool → Bool
//│               ζ → δ → ε ≤ Bool → Bool → Bool
//│                 Bool ≤ ζ
//│                   Bool ≤ (Int ⟹ {ε ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, δ ≤ Str})
//│                     Bool ≤ Int ⟹ {ε ≥ Int, δ ≤ Int}
//│                       Bool ≤ Int ⟹ {δ ≤ Int}
//│                         Bool ≤ Int
//│                     Bool ≤ Str ⟹ {ε ≥ Str, δ ≤ Str}
//│                       Bool ≤ Str ⟹ {δ ≤ Str}
//│                         Bool ≤ Str

:e
foo as ((Int | Str) -> (Int | Str) -> (Int | Str))
//│ ═══[ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ (Int ⟹ {β ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {β ≥ Str, γ ≤ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {β ≥ Int, α ≤ Int}) ∨ (Str ⟹ {β ≥ Str, α ≤ Str})} ⟹ γ → α → β ≤ (Int ∨ Str) → (Int ∨ Str) → (Int ∨ Str).
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ (Int ⟹ {β ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {β ≥ Str, γ ≤ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {β ≥ Int, α ≤ Int}) ∨ (Str ⟹ {β ≥ Str, α ≤ Str})} ⟹ γ → α → β ≤ (Int ∨ Str) → (Int ∨ Str) → (Int ∨ Str)
//│     ∀α, β, γ. {α ≤ (Int ⟹ {β ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {β ≥ Str, γ ≤ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {β ≥ Int, α ≤ Int}) ∨ (Str ⟹ {β ≥ Str, α ≤ Str})} ⟹ γ → α → β ≤ Int → (Int ∨ Str) → (Int ∨ Str)
//│       ∀α, β, γ. {α ≤ (Int ⟹ {β ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {β ≥ Str, γ ≤ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {β ≥ Int, α ≤ Int}) ∨ (Str ⟹ {β ≥ Str, α ≤ Str})} ⟹ γ → α → β ≤ Int → Str → (Int ∨ Str)
//│         ∀β, γ. {δ ≤ (Int ⟹ {β ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {β ≥ Str, γ ≤ Str}), β ≥ (Int ⟹ {δ ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {δ ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {β ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {β ≥ Str, δ ≤ Str})} ⟹ γ → δ → β ≤ Int → Str → (Int ∨ Str)
//│           ∀γ. {δ ≤ (Int ⟹ {ε ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, γ ≤ Str}), ε ≥ (Int ⟹ {δ ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {δ ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {ε ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, δ ≤ Str})} ⟹ γ → δ → ε ≤ Int → Str → (Int ∨ Str)
//│             {δ ≤ (Int ⟹ {ε ≥ Int, ζ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, ζ ≤ Str}), ε ≥ (Int ⟹ {δ ≤ Int, ζ ≤ Int}) ∧ (Str ⟹ {δ ≤ Str, ζ ≤ Str}), ζ ≤ (Int ⟹ {ε ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, δ ≤ Str})} ⟹ ζ → δ → ε ≤ Int → Str → (Int ∨ Str)
//│               {ε ≥ (Int ⟹ {δ ≤ Int, ζ ≤ Int}) ∧ (Str ⟹ {δ ≤ Str, ζ ≤ Str}), ζ ≤ (Int ⟹ {ε ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, δ ≤ Str})} ⟹ ζ → δ → ε ≤ Int → Str → (Int ∨ Str)
//│                 {ζ ≤ (Int ⟹ {ε ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, δ ≤ Str})} ⟹ ζ → δ → ε ≤ Int → Str → (Int ∨ Str)
//│                   ζ → δ → ε ≤ Int → Str → (Int ∨ Str)
//│                     δ → ε ≤ Str → (Int ∨ Str)
//│                       Str ≤ δ
//│                         Str ≤ ((Int ⟹ {ε ≥ Int, ζ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, ζ ≤ Str})) ∧ Int
//│                           Str ≤ (Int ⟹ {ε ≥ Int, ζ ≤ Int}) ∧ Int
//│                             Str ≤ Int ⟹ {ε ≥ Int, ζ ≤ Int}
//│                               Str ≤ Int ⟹ {ζ ≤ Int}
//│                                 Str ≤ Int
//│                           Str ≤ (Str ⟹ {ε ≥ Str, ζ ≤ Str}) ∧ Int
//│                             Str ≤ Str ⟹ {ε ≥ Str, ζ ≤ Str}
//│                               Str ≤ Str ⟹ {ζ ≤ Str}
//│                                 ζ ≤ Str
//│                                   Int ≤ Str

:e
foo as (Top -> Top -> Bot)
//│ ═══[ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ (Int ⟹ {β ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {β ≥ Str, γ ≤ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {β ≥ Int, α ≤ Int}) ∨ (Str ⟹ {β ≥ Str, α ≤ Str})} ⟹ γ → α → β ≤ ⊤ → ⊤ → ⊥.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ (Int ⟹ {β ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {β ≥ Str, γ ≤ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {β ≥ Int, α ≤ Int}) ∨ (Str ⟹ {β ≥ Str, α ≤ Str})} ⟹ γ → α → β ≤ ⊤ → ⊤ → ⊥
//│     ∀β, γ. {δ ≤ (Int ⟹ {β ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {β ≥ Str, γ ≤ Str}), β ≥ (Int ⟹ {δ ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {δ ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {β ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {β ≥ Str, δ ≤ Str})} ⟹ γ → δ → β ≤ ⊤ → ⊤ → ⊥
//│       ∀γ. {δ ≤ (Int ⟹ {ε ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, γ ≤ Str}), ε ≥ (Int ⟹ {δ ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {δ ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {ε ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, δ ≤ Str})} ⟹ γ → δ → ε ≤ ⊤ → ⊤ → ⊥
//│         {δ ≤ (Int ⟹ {ε ≥ Int, ζ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, ζ ≤ Str}), ε ≥ (Int ⟹ {δ ≤ Int, ζ ≤ Int}) ∧ (Str ⟹ {δ ≤ Str, ζ ≤ Str}), ζ ≤ (Int ⟹ {ε ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, δ ≤ Str})} ⟹ ζ → δ → ε ≤ ⊤ → ⊤ → ⊥
//│           {ε ≥ (Int ⟹ {δ ≤ Int, ζ ≤ Int}) ∧ (Str ⟹ {δ ≤ Str, ζ ≤ Str}), ζ ≤ (Int ⟹ {ε ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, δ ≤ Str})} ⟹ ζ → δ → ε ≤ ⊤ → ⊤ → ⊥
//│             {ζ ≤ (Int ⟹ {ε ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, δ ≤ Str})} ⟹ ζ → δ → ε ≤ ⊤ → ⊤ → ⊥
//│               ζ → δ → ε ≤ ⊤ → ⊤ → ⊥
//│                 ⊤ ≤ ζ
//│                   ⊤ ≤ (Int ⟹ {ε ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str, δ ≤ Str})
//│                     ⊤ ≤ Int ⟹ {ε ≥ Int, δ ≤ Int}
//│                       ⊤ ≤ Int ⟹ {δ ≤ Int}
//│                         ⊤ ≤ Int
//│                     ⊤ ≤ Str ⟹ {ε ≥ Str, δ ≤ Str}
//│                       ⊤ ≤ Str ⟹ {δ ≤ Str}
//│                         ⊤ ≤ Str

val int_or_string: Int | Str
//│ int_or_string: Int ∨ Str

:e
foo(1, "")
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ Str → α.
//│ Typing error tree:
//│   Int → Int ≤ Str → α
//│     Str ≤ Int

:e
foo(1, int_or_string)
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ (Int ∨ Str) → α.
//│ Typing error tree:
//│   Int → Int ≤ (Int ∨ Str) → α
//│     Int → Int ≤ Str → α
//│       Str ≤ Int
