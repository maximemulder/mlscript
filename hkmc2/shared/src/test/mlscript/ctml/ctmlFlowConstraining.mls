:ctml

:ctml-cfg merge-constring

// Function definitions

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀α, β, γ. {α ≥ (Int ⟹ {γ ≤ Int, β ≤ Int}) ∧ (Str ⟹ {γ ≤ ¬Int, γ ≤ Str, β ≤ Str, δ ≥ Str}), β ≤ (Int ⟹ {γ ≤ Int, α ≥ Int}) ∨ (Str ⟹ {γ ≤ ¬Int, γ ≤ Str, δ ≥ Str, α ≥ Str}), γ ≤ (Int ⟹ {β ≤ Int, α ≥ Int}) ∨ (¬Int ⟹ {γ ≤ Str, β ≤ Str, δ ≥ Str, α ≥ Str})} ⟹ γ → β → α

fun bar(a, b) =
  foo(a, b) as Int
//│ bar: ∀α. {α ≤ Int} ⟹ α → Int → Int

