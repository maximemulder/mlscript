:ctml

:ctml-cfg merge-constring

// Function definitions

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀α, β, γ. {α ≤ (Int ⟹ {γ ≤ Int, β ≥ Int}) ∨ (Str ⟹ {γ ≤ Str, β ≥ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {α ≤ Int, β ≥ Int}) ∨ (Str ⟹ {α ≤ Str, β ≥ Str})} ⟹ α → γ → β

fun bar(a, b) =
  foo(a, b) as Int
//│ bar: Int → Int → Int

// Function overloads

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

foo as (Int -> Int -> Int)
//│ Int → Int → Int

foo as (Str -> Str -> Str)
//│ Str → Str → Str

foo as (Bot -> Bot -> Top)
//│ ⊥ → ⊥ → ⊤

// Function applications

foo(1, 1)
//│ Int

foo("Hello", "World")
//│ Str

foo(bot, bot)
//│ ⊥

// Errors

:te
foo as (Bool -> Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ (Int ⟹ {γ ≤ Int, β ≥ Int}) ∨ (Str ⟹ {γ ≤ Str, β ≥ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {α ≤ Int, β ≥ Int}) ∨ (Str ⟹ {α ≤ Str, β ≥ Str})} ⟹ α → γ → β ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ (Int ⟹ {γ ≤ Int, β ≥ Int}) ∨ (Str ⟹ {γ ≤ Str, β ≥ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {α ≤ Int, β ≥ Int}) ∨ (Str ⟹ {α ≤ Str, β ≥ Str})} ⟹ α → γ → β ≤ Bool → Bool → Bool
//│     {δ ≤ (Int ⟹ {ε ≤ Int, ζ ≥ Int}) ∨ (Str ⟹ {ε ≤ Str, ζ ≥ Str}), ζ ≥ (Int ⟹ {δ ≤ Int, ε ≤ Int}) ∧ (Str ⟹ {δ ≤ Str, ε ≤ Str}), ε ≤ (Int ⟹ {δ ≤ Int, ζ ≥ Int}) ∨ (Str ⟹ {δ ≤ Str, ζ ≥ Str})} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│       {ζ ≥ (Int ⟹ {δ ≤ Int, ε ≤ Int}) ∧ (Str ⟹ {δ ≤ Str, ε ≤ Str}), ε ≤ (Int ⟹ {δ ≤ Int, ζ ≥ Int}) ∨ (Str ⟹ {δ ≤ Str, ζ ≥ Str})} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│         {ε ≤ (Int ⟹ {δ ≤ Int, ζ ≥ Int}) ∨ (Str ⟹ {δ ≤ Str, ζ ≥ Str})} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│           δ → ε → ζ ≤ Bool → Bool → Bool
//│             Bool ≤ δ
//│               Bool ≤ (Int ⟹ {ε ≤ Int, ζ ≥ Int}) ∨ (Str ⟹ {ε ≤ Str, ζ ≥ Str})
//│                 Bool ≤ Int ⟹ {ε ≤ Int, ζ ≥ Int}
//│                   Bool ≤ Int ⟹ {ζ ≥ Int}
//│                     Bool ≤ Int
//│                 Bool ≤ Str ⟹ {ε ≤ Str, ζ ≥ Str}
//│                   Bool ≤ Str ⟹ {ζ ≥ Str}
//│                     Bool ≤ Str

:te
foo as ((Int | Str) -> (Int | Str) -> (Int | Str))
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ (Int ⟹ {γ ≤ Int, β ≥ Int}) ∨ (Str ⟹ {γ ≤ Str, β ≥ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {α ≤ Int, β ≥ Int}) ∨ (Str ⟹ {α ≤ Str, β ≥ Str})} ⟹ α → γ → β ≤ (Int ∨ Str) → (Int ∨ Str) → (Int ∨ Str).
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ (Int ⟹ {γ ≤ Int, β ≥ Int}) ∨ (Str ⟹ {γ ≤ Str, β ≥ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {α ≤ Int, β ≥ Int}) ∨ (Str ⟹ {α ≤ Str, β ≥ Str})} ⟹ α → γ → β ≤ (Int ∨ Str) → (Int ∨ Str) → (Int ∨ Str)
//│     ∀α, β, γ. {α ≤ (Int ⟹ {γ ≤ Int, β ≥ Int}) ∨ (Str ⟹ {γ ≤ Str, β ≥ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {α ≤ Int, β ≥ Int}) ∨ (Str ⟹ {α ≤ Str, β ≥ Str})} ⟹ α → γ → β ≤ Int → (Int ∨ Str) → (Int ∨ Str)
//│       ∀α, β, γ. {α ≤ (Int ⟹ {γ ≤ Int, β ≥ Int}) ∨ (Str ⟹ {γ ≤ Str, β ≥ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {α ≤ Int, β ≥ Int}) ∨ (Str ⟹ {α ≤ Str, β ≥ Str})} ⟹ α → γ → β ≤ Int → Str → (Int ∨ Str)
//│         {δ ≤ (Int ⟹ {ε ≤ Int, ζ ≥ Int}) ∨ (Str ⟹ {ε ≤ Str, ζ ≥ Str}), ζ ≥ (Int ⟹ {δ ≤ Int, ε ≤ Int}) ∧ (Str ⟹ {δ ≤ Str, ε ≤ Str}), ε ≤ (Int ⟹ {δ ≤ Int, ζ ≥ Int}) ∨ (Str ⟹ {δ ≤ Str, ζ ≥ Str})} ⟹ δ → ε → ζ ≤ Int → Str → (Int ∨ Str)
//│           {ζ ≥ (Int ⟹ {δ ≤ Int, ε ≤ Int}) ∧ (Str ⟹ {δ ≤ Str, ε ≤ Str}), ε ≤ (Int ⟹ {δ ≤ Int, ζ ≥ Int}) ∨ (Str ⟹ {δ ≤ Str, ζ ≥ Str})} ⟹ δ → ε → ζ ≤ Int → Str → (Int ∨ Str)
//│             {ε ≤ (Int ⟹ {δ ≤ Int, ζ ≥ Int}) ∨ (Str ⟹ {δ ≤ Str, ζ ≥ Str})} ⟹ δ → ε → ζ ≤ Int → Str → (Int ∨ Str)
//│               δ → ε → ζ ≤ Int → Str → (Int ∨ Str)
//│                 ε → ζ ≤ Str → (Int ∨ Str)
//│                   Str ≤ ε
//│                     Str ≤ ((Int ⟹ {δ ≤ Int, ζ ≥ Int}) ∨ (Str ⟹ {δ ≤ Str, ζ ≥ Str})) ∧ Int
//│                       Str ≤ (Int ⟹ {δ ≤ Int, ζ ≥ Int}) ∧ Int
//│                         Str ≤ Int ⟹ {δ ≤ Int, ζ ≥ Int}
//│                           Str ≤ Int ⟹ {ζ ≥ Int}
//│                             Str ≤ Int
//│                       Str ≤ (Str ⟹ {δ ≤ Str, ζ ≥ Str}) ∧ Int
//│                         Str ≤ Str ⟹ {δ ≤ Str, ζ ≥ Str}
//│                           δ ≤ Str
//│                             Int ≤ Str

:te
foo as (Top -> Top -> Bot)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ (Int ⟹ {γ ≤ Int, β ≥ Int}) ∨ (Str ⟹ {γ ≤ Str, β ≥ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {α ≤ Int, β ≥ Int}) ∨ (Str ⟹ {α ≤ Str, β ≥ Str})} ⟹ α → γ → β ≤ ⊤ → ⊤ → ⊥.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ (Int ⟹ {γ ≤ Int, β ≥ Int}) ∨ (Str ⟹ {γ ≤ Str, β ≥ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str, γ ≤ Str}), γ ≤ (Int ⟹ {α ≤ Int, β ≥ Int}) ∨ (Str ⟹ {α ≤ Str, β ≥ Str})} ⟹ α → γ → β ≤ ⊤ → ⊤ → ⊥
//│     {δ ≤ (Int ⟹ {ε ≤ Int, ζ ≥ Int}) ∨ (Str ⟹ {ε ≤ Str, ζ ≥ Str}), ζ ≥ (Int ⟹ {δ ≤ Int, ε ≤ Int}) ∧ (Str ⟹ {δ ≤ Str, ε ≤ Str}), ε ≤ (Int ⟹ {δ ≤ Int, ζ ≥ Int}) ∨ (Str ⟹ {δ ≤ Str, ζ ≥ Str})} ⟹ δ → ε → ζ ≤ ⊤ → ⊤ → ⊥
//│       {ζ ≥ (Int ⟹ {δ ≤ Int, ε ≤ Int}) ∧ (Str ⟹ {δ ≤ Str, ε ≤ Str}), ε ≤ (Int ⟹ {δ ≤ Int, ζ ≥ Int}) ∨ (Str ⟹ {δ ≤ Str, ζ ≥ Str})} ⟹ δ → ε → ζ ≤ ⊤ → ⊤ → ⊥
//│         {ε ≤ (Int ⟹ {δ ≤ Int, ζ ≥ Int}) ∨ (Str ⟹ {δ ≤ Str, ζ ≥ Str})} ⟹ δ → ε → ζ ≤ ⊤ → ⊤ → ⊥
//│           δ → ε → ζ ≤ ⊤ → ⊤ → ⊥
//│             ⊤ ≤ δ
//│               ⊤ ≤ (Int ⟹ {ε ≤ Int, ζ ≥ Int}) ∨ (Str ⟹ {ε ≤ Str, ζ ≥ Str})
//│                 ⊤ ≤ Int ⟹ {ε ≤ Int, ζ ≥ Int}
//│                   ⊤ ≤ Int ⟹ {ζ ≥ Int}
//│                     ⊤ ≤ Int
//│                 ⊤ ≤ Str ⟹ {ε ≤ Str, ζ ≥ Str}
//│                   ⊤ ≤ Str ⟹ {ζ ≥ Str}
//│                     ⊤ ≤ Str

val int_or_string: Int | Str
//│ int_or_string: Int ∨ Str

:te
foo(1, "")
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int ≤ Str → α.
//│ Typing error tree:
//│   Int → Int ≤ Str → α
//│     Str ≤ Int

:te
foo(1, int_or_string)
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int ≤ (Int ∨ Str) → α.
//│ Typing error tree:
//│   Int → Int ≤ (Int ∨ Str) → α
//│     Int → Int ≤ Str → α
//│       Str ≤ Int
