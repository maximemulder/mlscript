:ctml

:ctml-cfg merge-constring

// Function definitions

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀α. α → (∀β. β → (∀γ. {β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str}), α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ Str})} ⟹ γ))

fun bar(a, b) =
  foo(a, b) as Int
//│ bar: Int → Int → Int

// Function overloads

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

foo as (Int -> Int -> Int)
//│ Int → Int → Int

foo as (Str -> Str -> Str)
//│ Str → Str → Str

foo as (Bot -> Bot -> Top)
//│ ⊥ → ⊥ → ⊤

// Function applications

foo(1, 1)
//│ ∀α. {Int ≤ (Int ⟹ {α ≥ Int}) ∨ (Str ⟹ {α ≥ Str, Int ≤ Str}), Int ≤ (Int ⟹ {α ≥ Int}) ∨ (Str ⟹ {α ≥ Str, Int ≤ Str}), α ≥ Int ∧ (Str ⟹ {Int ≤ Str, Int ≤ Str})} ⟹ α

foo("Hello", "World")
//│ ∀α. {Str ≤ (Int ⟹ {α ≥ Int, Str ≤ Int}) ∨ (Str ⟹ {α ≥ Str}), Str ≤ (Int ⟹ {α ≥ Int, Str ≤ Int}) ∨ (Str ⟹ {α ≥ Str}), α ≥ (Int ⟹ {Str ≤ Int, Str ≤ Int}) ∧ Str} ⟹ α

foo(bot, bot)
//│ ∀α. α

// Errors

:te
foo as (Bool -> Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α. α → (∀β. β → (∀γ. {β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str}), α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ Str})} ⟹ γ)) ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α. α → (∀β. β → (∀γ. {β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str}), α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ Str})} ⟹ γ)) ≤ Bool → Bool → Bool
//│     δ → (∀β. β → (∀γ. {β ≤ (Int ⟹ {γ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, δ ≤ Str}), δ ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), γ ≥ (Int ⟹ {β ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {β ≤ Str, δ ≤ Str})} ⟹ γ)) ≤ Bool → Bool → Bool
//│       ∀β. β → (∀γ. {β ≤ (Int ⟹ {γ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, δ ≤ Str}), δ ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), γ ≥ (Int ⟹ {β ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {β ≤ Str, δ ≤ Str})} ⟹ γ) ≤ Bool → Bool
//│         ε → (∀γ. {ε ≤ (Int ⟹ {γ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, δ ≤ Str}), δ ≤ (Int ⟹ {γ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, ε ≤ Str}), γ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ Str})} ⟹ γ) ≤ Bool → Bool
//│           ∀γ. {ε ≤ (Int ⟹ {γ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, δ ≤ Str}), δ ≤ (Int ⟹ {γ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, ε ≤ Str}), γ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ Str})} ⟹ γ ≤ Bool
//│             {ε ≤ (Int ⟹ {ζ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, δ ≤ Str}), δ ≤ (Int ⟹ {ζ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, ε ≤ Str}), ζ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ Str})} ⟹ ζ ≤ Bool
//│               ε ≤ (Int ⟹ {ζ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, δ ≤ Str})
//│                 Bool ≤ (Int ⟹ {η ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {η ≥ Str, δ ≤ Str})
//│                   Bool ≤ Int ⟹ {η ≥ Int, δ ≤ Int}
//│                     Bool ≤ Int ⟹ {δ ≤ Int}
//│                       Bool ≤ Int
//│                   Bool ≤ Str ⟹ {η ≥ Str, δ ≤ Str}
//│                     Bool ≤ Str ⟹ {δ ≤ Str}
//│                       Bool ≤ Str

:te
