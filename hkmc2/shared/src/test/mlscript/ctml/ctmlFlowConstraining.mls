val int_or_string: Int | Str
//│ int_or_string: Int ∨ Str

:te
foo(1, "")
//│ ∀α. {Str ≤ (Int ⟹ {α ≥ Int}) ∨ (Str ⟹ {α ≥ Str, Int ≤ Str}), Int ≤ (Int ⟹ {α ≥ Int, Str ≤ Int}) ∨ (Str ⟹ {α ≥ Str}), α ≥ (Int ⟹ {Str ≤ Int}) ∧ (Str ⟹ {Int ≤ Str})} ⟹ α
//│ FAILURE: Unexpected lack of type error

:te
foo(1, int_or_string)
//│ ∀α, β. ({Int ≤ (Int ⟹ {α ≥ Int}) ∨ (Str ⟹ {α ≥ Str, Int ≤ Str}), Int ≤ (Int ⟹ {α ≥ Int}) ∨ (Str ⟹ {α ≥ Str, Int ≤ Str}), α ≥ Int ∧ (Str ⟹ {Int ≤ Str, Int ≤ Str})} ⟹ α) ∨ ({Str ≤ (Int ⟹ {β ≥ Int}) ∨ (Str ⟹ {β ≥ Str, Int ≤ Str}), Int ≤ (Int ⟹ {β ≥ Int, Str ≤ Int}) ∨ (Str ⟹ {β ≥ Str}), β ≥ (Int ⟹ {Str ≤ Int}) ∧ (Str ⟹ {Int ≤ Str})} ⟹ β)
//│ FAILURE: Unexpected lack of type error
