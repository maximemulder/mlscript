val int_or_string: Int | Str
//│ int_or_string: Int ∨ Str

:te
foo(1, "")
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {α ≥ ((Int ⟹ {β ≤ Int}) ∧ (Str ⟹ {β ≤ Str, Int ≤ Str, Int ≤ ¬Int})) ∨ Int} ⟹ (((Int ∨ (Str ⟹ {α ≥ Str})) ∧ β) ∧ Int) → α ≤ Str → γ.
//│ Typing error tree:
//│   ∀α, β. {α ≥ ((Int ⟹ {β ≤ Int}) ∧ (Str ⟹ {β ≤ Str, Int ≤ Str, Int ≤ ¬Int})) ∨ Int} ⟹ (((Int ∨ (Str ⟹ {α ≥ Str})) ∧ β) ∧ Int) → α ≤ Str → γ
//│     ∀β. {δ ≥ ((Int ⟹ {β ≤ Int}) ∧ (Str ⟹ {β ≤ Str, Int ≤ Str, Int ≤ ¬Int})) ∨ Int} ⟹ (((Int ∨ (Str ⟹ {δ ≥ Str})) ∧ β) ∧ Int) → δ ≤ Str → γ
//│       {δ ≥ ((Int ⟹ {ε ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, Int ≤ Str, Int ≤ ¬Int})) ∨ Int} ⟹ (((Int ∨ (Str ⟹ {δ ≥ Str})) ∧ ε) ∧ Int) → δ ≤ Str → γ
//│         (((Int ∨ (Str ⟹ {δ ≥ Str})) ∧ ε) ∧ Int) → δ ≤ Str → γ
//│           ((Int ∧ ε) ∧ Int) → δ ≤ Str → γ
//│             Str ≤ (Int ∧ ε) ∧ Int
//│               Str ≤ Int ∧ ε
//│                 Str ≤ Int
//│           (((Str ⟹ {δ ≥ Str}) ∧ ε) ∧ Int) → δ ≤ Str → γ
//│             Str ≤ ((Str ⟹ {δ ≥ Str}) ∧ ε) ∧ Int
//│               Str ≤ Int

