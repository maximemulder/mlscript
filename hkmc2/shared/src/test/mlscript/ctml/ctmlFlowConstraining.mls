:ctml

:ctml-cfg merge-constring

// Function definitions

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀α, β, γ. α → β → ({β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str, α ≤ ¬Int}), α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ Str, α ≤ ¬Int})} ⟹ γ)

fun bar(a, b) =
  foo(a, b) as Int
//│ bar: ∀α, β, γ, δ, ε, ζ, η, θ, ι, κ, λ. {α ≤ ((Int ⟹ {β ≥ Int}) ∨ (Str ⟹ {β ≥ Str})) ∧ Int, β ≤ Int, α ≤ (Int ⟹ {β ≥ Int}) ∨ (Str ⟹ {β ≥ Str})} ⟹ α → ({η ≤ Int, γ ≤ ((Int ⟹ {δ ≥ Int}) ∨ (Str ⟹ {δ ≥ Str, ε ≤ Str, ε ≤ ¬Int})) ∧ Int, θ ≤ Int, ε ≤ ((Int ⟹ {ζ ≥ Int}) ∨ (Str ⟹ {ζ ≥ Str, γ ≤ Str})) ∧ Int, ζ ≤ Int, δ ≤ Int, η ≥ ((δ ∨ β) ∨ ζ) ∨ (Int ∧ (Str ⟹ {γ ≤ Str, θ ≤ Str, θ ≤ ¬Int})), θ ≥ α ∨ ε, ι ≤ ((Int ⟹ {η ≥ Int}) ∨ (Str ⟹ {η ≥ Str, γ ≤ Str})) ∧ θ, ι ≤ (Int ⟹ {η ≥ Int}) ∨ (Str ⟹ {η ≥ Str, γ ≤ Str}), ε ≤ (Int ⟹ {ζ ≥ Int}) ∨ (Str ⟹ {ζ ≥ Str, γ ≤ Str}), η ≥ (δ ∨ β) ∨ ζ, η ≥ δ ∨ β, γ ≤ (Int ⟹ {δ ≥ Int}) ∨ (Str ⟹ {δ ≥ Str, ε ≤ Str, ε ≤ ¬Int}), ι ≥ α ∨ ε, η ≥ δ, κ ≥ α, ι ≥ α, λ ≤ κ, κ ≥ α, ι ≥ α, κ ≥ α, ι ≥ α, λ ≥ α, κ ≤ ι, ι ≥ α} ⟹ Int → Int)

// Function overloads

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

foo as (Int -> Int -> Int)
//│ Int → Int → Int

foo as (Str -> Str -> Str)
//│ Str → Str → Str

foo as (Bot -> Bot -> Top)
//│ ⊥ → ⊥ → ⊤

// Function applications

foo(1, 1)
//│ ∀α. {Int ≤ (Int ⟹ {α ≥ Int}) ∨ (Str ⟹ {α ≥ Str, Int ≤ Str, Int ≤ ¬Int}), Int ≤ (Int ⟹ {α ≥ Int}) ∨ (Str ⟹ {α ≥ Str, Int ≤ Str}), α ≥ Int ∧ (Str ⟹ {Int ≤ Str, Int ≤ Str, Int ≤ ¬Int})} ⟹ α

foo("Hello", "World")
//│ ∀α. {Str ≤ (Int ⟹ {α ≥ Int, Str ≤ Int}) ∨ (Str ⟹ {α ≥ Str}), Str ≤ (Int ⟹ {α ≥ Int, Str ≤ Int}) ∨ (Str ⟹ {α ≥ Str}), α ≥ (Int ⟹ {Str ≤ Int, Str ≤ Int}) ∧ Str} ⟹ α

foo(bot, bot)
//│ ∀α. α

