:ctml

:ctml-cfg merge-constring arbitrary-patterns

// Function definitions

fun foo(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ foo: ∀α, β, γ. {γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∧ (∀δ. {α ≤ (⊤ ⟹ {β ≤ Str, δ ≥ Str}) ∨ ⊥, β ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {α ≤ ⊥}), δ ≥ (Str ⟹ {β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ δ ⟹ {α ≤ ¬Int}), α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (¬Int ⟹ {γ ≥ {β ≤ Str ∨ (⊤ ⟹ {α ≤ ⊥}), α ≤ (⊤ ⟹ {β ≤ Str}) ∨ ⊥} ⟹ (Str ⟹ {β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (⊤ ⟹ {α ≤ ¬Int, γ ≥ {β ≤ Str ∨ (⊤ ⟹ {α ≤ ⊥}), α ≤ (⊤ ⟹ {β ≤ Str}) ∨ ⊥} ⟹ (Str ⟹ {β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})})} ⟹ α → β → γ

// Function overloads

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

// Function applications

foo(1, 1)
//│ Int

foo("Hello", "World")
//│ ((Int ⟹ {Str ≤ Int}) ∧ Str) ∨ (Str ∧ (⊥ ⟹ {Str ≤ ⊥}))

foo(true, "")
//│ ((Int ⟹ {Bool ≤ Int, Str ≤ Int}) ∧ Str) ∨ (Str ∧ (⊥ ⟹ {Bool ≤ ⊥}))

foo(bot, bot)
//│ ⊥

// Errors

:te
foo as (Bool -> Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∧ (∀δ. {α ≤ (⊤ ⟹ {β ≤ Str, δ ≥ Str}) ∨ ⊥, β ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {α ≤ ⊥}), δ ≥ (Str ⟹ {β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ δ ⟹ {α ≤ ¬Int}), α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (¬Int ⟹ {γ ≥ {β ≤ Str ∨ (⊤ ⟹ {α ≤ ⊥}), α ≤ (⊤ ⟹ {β ≤ Str}) ∨ ⊥} ⟹ (Str ⟹ {β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (⊤ ⟹ {α ≤ ¬Int, γ ≥ {β ≤ Str ∨ (⊤ ⟹ {α ≤ ⊥}), α ≤ (⊤ ⟹ {β ≤ Str}) ∨ ⊥} ⟹ (Str ⟹ {β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})})} ⟹ α → β → γ ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α, β, γ. {γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∧ (∀δ. {α ≤ (⊤ ⟹ {β ≤ Str, δ ≥ Str}) ∨ ⊥, β ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {α ≤ ⊥}), δ ≥ (Str ⟹ {β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ δ ⟹ {α ≤ ¬Int}), α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (¬Int ⟹ {γ ≥ {β ≤ Str ∨ (⊤ ⟹ {α ≤ ⊥}), α ≤ (⊤ ⟹ {β ≤ Str}) ∨ ⊥} ⟹ (Str ⟹ {β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (⊤ ⟹ {α ≤ ¬Int, γ ≥ {β ≤ Str ∨ (⊤ ⟹ {α ≤ ⊥}), α ≤ (⊤ ⟹ {β ≤ Str}) ∨ ⊥} ⟹ (Str ⟹ {β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})})} ⟹ α → β → γ ≤ Bool → Bool → Bool
//│     {η ≥ (Int ⟹ {ε ≤ Int, ζ ≤ Int}) ∧ (∀δ. {ε ≤ (⊤ ⟹ {ζ ≤ Str, δ ≥ Str}) ∨ ⊥, ζ ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), δ ≥ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ δ ⟹ {ε ≤ ¬Int}), ε ≤ (Int ⟹ {ζ ≤ Int, η ≥ Int}) ∨ (¬Int ⟹ {η ≥ {ζ ≤ Str ∨ (⊤ ⟹ {ε ≤ ⊥}), ε ≤ (⊤ ⟹ {ζ ≤ Str}) ∨ ⊥} ⟹ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})}), ζ ≤ (Int ⟹ {ε ≤ Int, η ≥ Int}) ∨ (⊤ ⟹ {ε ≤ ¬Int, η ≥ {ζ ≤ Str ∨ (⊤ ⟹ {ε ≤ ⊥}), ε ≤ (⊤ ⟹ {ζ ≤ Str}) ∨ ⊥} ⟹ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})})} ⟹ ε → ζ → η ≤ Bool → Bool → Bool
//│       {ε ≤ (Int ⟹ {ζ ≤ Int, η ≥ Int}) ∨ (¬Int ⟹ {η ≥ {ζ ≤ Str ∨ (⊤ ⟹ {ε ≤ ⊥}), ε ≤ (⊤ ⟹ {ζ ≤ Str}) ∨ ⊥} ⟹ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})}), ζ ≤ (Int ⟹ {ε ≤ Int, η ≥ Int}) ∨ (⊤ ⟹ {ε ≤ ¬Int, η ≥ {ζ ≤ Str ∨ (⊤ ⟹ {ε ≤ ⊥}), ε ≤ (⊤ ⟹ {ζ ≤ Str}) ∨ ⊥} ⟹ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})})} ⟹ ε → ζ → η ≤ Bool → Bool → Bool
//│         {ζ ≤ (Int ⟹ {ε ≤ Int, η ≥ Int}) ∨ (⊤ ⟹ {ε ≤ ¬Int, η ≥ {ζ ≤ Str ∨ (⊤ ⟹ {ε ≤ ⊥}), ε ≤ (⊤ ⟹ {ζ ≤ Str}) ∨ ⊥} ⟹ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})})} ⟹ ε → ζ → η ≤ Bool → Bool → Bool
//│           ε → ζ → η ≤ Bool → Bool → Bool
//│             ζ → η ≤ Bool → Bool
//│               η ≤ Bool
//│                 ((Int ⟹ {ε ≤ Int, ζ ≤ Int}) ∧ (∀δ. {ε ≤ (⊤ ⟹ {ζ ≤ Str, δ ≥ Str}) ∨ ⊥, ζ ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), δ ≥ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ δ ⟹ {ε ≤ ¬Int})) ∨ ({ζ ≤ Str ∨ (⊤ ⟹ {ε ≤ ⊥}), ε ≤ (⊤ ⟹ {ζ ≤ Str}) ∨ ⊥} ⟹ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})) ≤ Bool
//│                   (Int ⟹ {ε ≤ Int, ζ ≤ Int}) ∧ (∀δ. {ε ≤ (⊤ ⟹ {ζ ≤ Str, δ ≥ Str}) ∨ ⊥, ζ ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), δ ≥ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ δ ⟹ {ε ≤ ¬Int}) ≤ Bool
//│                     Int ⟹ {ε ≤ Int, ζ ≤ Int} ≤ Bool
//│                       Int ⟹ {ζ ≤ Int} ≤ Bool
//│                         Int ≤ Bool
//│                     ∀δ. {ε ≤ (⊤ ⟹ {ζ ≤ Str, δ ≥ Str}) ∨ ⊥, ζ ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), δ ≥ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ δ ⟹ {ε ≤ ¬Int} ≤ Bool
//│                       {ε ≤ (⊤ ⟹ {ζ ≤ Str, θ ≥ Str}) ∨ ⊥, ζ ≤ (Str ⟹ {θ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), θ ≥ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ θ ⟹ {ε ≤ ¬Int} ≤ Bool
//│                         {ε ≤ (⊤ ⟹ {ζ ≤ Str, θ ≥ Str}) ∨ ⊥, ζ ≤ (Str ⟹ {θ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), θ ≥ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ θ ≤ Bool
//│                           ε ≤ (⊤ ⟹ {ζ ≤ Str, θ ≥ Str}) ∨ ⊥
//│                             Bool ≤ (⊤ ⟹ {ζ ≤ Str, θ ≥ Str}) ∨ ⊥
//│                               Bool ≤ ⊤ ⟹ {ζ ≤ Str, θ ≥ Str}
//│                                 ζ ≤ Str
//│                                   Bool ≤ Str
//│                               Bool ≤ ⊥

:te
foo(true, 1)
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ (⊤ ⟹ {Int ≤ Str, β ≥ Str}) ∨ ⊥.
//│ Typing error tree:
//│   α ≤ (⊤ ⟹ {Int ≤ Str, β ≥ Str}) ∨ ⊥
//│     Bool ≤ (⊤ ⟹ {Int ≤ Str, β ≥ Str}) ∨ ⊥
//│       Bool ≤ ⊤ ⟹ {Int ≤ Str, β ≥ Str}
//│         Int ≤ Str
//│       Bool ≤ ⊥

:te
foo(true, true)
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ (⊤ ⟹ {Bool ≤ Str, β ≥ Str}) ∨ ⊥.
//│ Typing error tree:
//│   α ≤ (⊤ ⟹ {Bool ≤ Str, β ≥ Str}) ∨ ⊥
//│     Bool ≤ (⊤ ⟹ {Bool ≤ Str, β ≥ Str}) ∨ ⊥
//│       Bool ≤ ⊤ ⟹ {Bool ≤ Str, β ≥ Str}
//│         Bool ≤ Str
//│       Bool ≤ ⊥

:te
foo(1, "World")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
//│ Typing error tree:
//│   α ≤ Str → β
//│     γ → δ ≤ Str → β
//│       Str ≤ γ
//│         Str ≤ ((Int ⟹ {ε ≤ Int, δ ≥ Int}) ∨ (⊤ ⟹ {ε ≤ ¬Int, δ ≥ {γ ≤ Str ∨ (⊤ ⟹ {ε ≤ ⊥}), ε ≤ (⊤ ⟹ {γ ≤ Str}) ∨ ⊥} ⟹ (Str ⟹ {γ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})})) ∧ Int
//│           Str ≤ (Int ⟹ {ε ≤ Int, δ ≥ Int}) ∧ Int
//│             Str ≤ Int ⟹ {ε ≤ Int, δ ≥ Int}
//│               Str ≤ Int ⟹ {δ ≥ Int}
//│                 Str ≤ Int
//│           Str ≤ (⊤ ⟹ {ε ≤ ¬Int, δ ≥ {γ ≤ Str ∨ (⊤ ⟹ {ε ≤ ⊥}), ε ≤ (⊤ ⟹ {γ ≤ Str}) ∨ ⊥} ⟹ (Str ⟹ {γ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})}) ∧ Int
//│             Str ≤ ⊤ ⟹ {ε ≤ ¬Int, δ ≥ {γ ≤ Str ∨ (⊤ ⟹ {ε ≤ ⊥}), ε ≤ (⊤ ⟹ {γ ≤ Str}) ∨ ⊥} ⟹ (Str ⟹ {γ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})}
//│               ε ≤ ¬Int
//│                 Int ≤ ¬Int
