//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ, δ. {β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ ¬({β ≤ Str, δ ≥ Str} ⟹ ⊥), γ ≥ δ} ⟹ ¬(Str ∨ ¬({α ≤ ⊥} ⟹ ⊥))), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ ¬({β ≤ Str, δ ≥ Str} ⟹ ⊥), γ ≥ δ} ⟹ ⊥), δ ≥ ({α ≤ Int, β ≤ Int, γ ≥ Int} ⟹ ⊥) ∧ ({α ≤ ¬({β ≤ Str, δ ≥ Str} ⟹ ⊥), γ ≥ δ} ⟹ Str ∧ ({α ≤ ⊥} ⟹ ⊥)), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ ¬({β ≤ Str, δ ≥ Str} ⟹ ⊥)} ⟹ δ)} ⟹ α → β → γ ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α, β, γ, δ. {β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ ¬({β ≤ Str, δ ≥ Str} ⟹ ⊥), γ ≥ δ} ⟹ ¬(Str ∨ ¬({α ≤ ⊥} ⟹ ⊥))), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ ¬({β ≤ Str, δ ≥ Str} ⟹ ⊥), γ ≥ δ} ⟹ ⊥), δ ≥ ({α ≤ Int, β ≤ Int, γ ≥ Int} ⟹ ⊥) ∧ ({α ≤ ¬({β ≤ Str, δ ≥ Str} ⟹ ⊥), γ ≥ δ} ⟹ Str ∧ ({α ≤ ⊥} ⟹ ⊥)), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ ¬({β ≤ Str, δ ≥ Str} ⟹ ⊥)} ⟹ δ)} ⟹ α → β → γ ≤ Bool → Bool → Bool
//│     {ζ ≤ ¬({ε ≤ Int, η ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({ζ ≤ Str, θ ≥ Str} ⟹ ⊥), η ≥ θ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥))), ε ≤ ¬({ζ ≤ Int, η ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({ζ ≤ Str, θ ≥ Str} ⟹ ⊥), η ≥ θ} ⟹ ⊥), θ ≥ ({ε ≤ Int, ζ ≤ Int, η ≥ Int} ⟹ ⊥) ∧ ({ε ≤ ¬({ζ ≤ Str, θ ≥ Str} ⟹ ⊥), η ≥ θ} ⟹ Str ∧ ({ε ≤ ⊥} ⟹ ⊥)), η ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ ¬({ζ ≤ Str, θ ≥ Str} ⟹ ⊥)} ⟹ θ)} ⟹ ε → ζ → η ≤ Bool → Bool → Bool
//│       {ε ≤ ¬({ζ ≤ Int, η ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({ζ ≤ Str, θ ≥ Str} ⟹ ⊥), η ≥ θ} ⟹ ⊥), θ ≥ ({ε ≤ Int, ζ ≤ Int, η ≥ Int} ⟹ ⊥) ∧ ({ε ≤ ¬({ζ ≤ Str, θ ≥ Str} ⟹ ⊥), η ≥ θ} ⟹ Str ∧ ({ε ≤ ⊥} ⟹ ⊥)), η ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ ¬({ζ ≤ Str, θ ≥ Str} ⟹ ⊥)} ⟹ θ)} ⟹ ε → ζ → η ≤ Bool → Bool → Bool
//│         {θ ≥ ({ε ≤ Int, ζ ≤ Int, η ≥ Int} ⟹ ⊥) ∧ ({ε ≤ ¬({ζ ≤ Str, θ ≥ Str} ⟹ ⊥), η ≥ θ} ⟹ Str ∧ ({ε ≤ ⊥} ⟹ ⊥)), η ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ ¬({ζ ≤ Str, θ ≥ Str} ⟹ ⊥)} ⟹ θ)} ⟹ ε → ζ → η ≤ Bool → Bool → Bool
//│           {η ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ ¬({ζ ≤ Str, θ ≥ Str} ⟹ ⊥)} ⟹ θ)} ⟹ ε → ζ → η ≤ Bool → Bool → Bool
//│             ε → ζ → η ≤ Bool → Bool → Bool
//│               ζ → η ≤ Bool → Bool
//│                 Bool ≤ ζ
//│                   Bool ≤ (¬({ε ≤ Int, η ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({ζ ≤ Str, θ ≥ Str} ⟹ ⊥), η ≥ θ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))) ∧ Str
//│                     Bool ≤ ¬({ε ≤ Int, η ≥ Int} ⟹ ¬Int) ∧ Str
//│                       Bool ≤ ¬({ε ≤ Int, η ≥ Int} ⟹ ¬Int)
//│                         {ε ≤ Int, η ≥ Int} ⟹ ¬Int ≤ ¬Bool
//│                           ε ≤ Int
//│                             Bool ≤ Int
//│                     Bool ≤ ¬({ε ≤ ¬({ζ ≤ Str, θ ≥ Str} ⟹ ⊥), η ≥ θ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥))) ∧ Str
//│                       Bool ≤ ¬({ε ≤ ¬({ζ ≤ Str, θ ≥ Str} ⟹ ⊥), η ≥ θ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))
//│                         {ε ≤ ¬({ζ ≤ Str, θ ≥ Str} ⟹ ⊥), η ≥ θ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Bool
//│                           {η ≥ θ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Bool
//│                             ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Bool
//│                               Bool ≤ Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)
//│                                 Bool ≤ Str
//│                                 Bool ≤ ¬({ε ≤ ⊥} ⟹ ⊥)
//│                                   {ε ≤ ⊥} ⟹ ⊥ ≤ ¬Bool
//│                                     ε ≤ ⊥
//│                                       Bool ≤ ⊥

:te
foo(true, 1)
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Int → β.
//│ Typing error tree:
//│   α ≤ Int → β
//│     γ → δ ≤ Int → β
//│       Int ≤ γ
//│         Int ≤ (¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({γ ≤ Str, ζ ≥ Str} ⟹ ⊥), δ ≥ ζ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))) ∧ Str
//│           Int ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∧ Str
//│             Int ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int)
//│               {ε ≤ Int, δ ≥ Int} ⟹ ¬Int ≤ ¬Int
//│                 ε ≤ Int
//│                   Bool ≤ Int
//│           Int ≤ ¬({ε ≤ ¬({γ ≤ Str, ζ ≥ Str} ⟹ ⊥), δ ≥ ζ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥))) ∧ Str
//│             Int ≤ ¬({ε ≤ ¬({γ ≤ Str, ζ ≥ Str} ⟹ ⊥), δ ≥ ζ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))
//│               {ε ≤ ¬({γ ≤ Str, ζ ≥ Str} ⟹ ⊥), δ ≥ ζ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Int
//│                 {δ ≥ ζ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Int
//│                   ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Int
//│                     Int ≤ Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)
//│                       Int ≤ Str
//│                       Int ≤ ¬({ε ≤ ⊥} ⟹ ⊥)
//│                         {ε ≤ ⊥} ⟹ ⊥ ≤ ¬Int
//│                           ε ≤ ⊥
//│                             Bool ≤ ⊥

:te
