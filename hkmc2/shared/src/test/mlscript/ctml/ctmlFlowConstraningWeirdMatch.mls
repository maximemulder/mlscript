:ctml

:ctml-cfg merge-constring arbitrary-patterns

// Function definitions

fun foo(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ foo: ∀α, β, γ. {γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∧ (∀δ. {α ≤ (⊤ ⟹ {β ≤ Str, δ ≥ Str}) ∨ ⊥, β ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {α ≤ ⊥}), δ ≥ (Str ⟹ {β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ δ ⟹ {α ≤ ¬Int}), α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (¬Int ⟹ {γ ≥ ∀δ. {α ≤ (⊤ ⟹ {β ≤ Str, δ ≥ Str}) ∨ ⊥, β ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {α ≤ ⊥}), δ ≥ (Str ⟹ {β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ δ}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (⊤ ⟹ {α ≤ ¬Int, γ ≥ ∀δ. {α ≤ (⊤ ⟹ {β ≤ Str, δ ≥ Str}) ∨ ⊥, β ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {α ≤ ⊥}), δ ≥ (Str ⟹ {β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ δ})} ⟹ α → β → γ

// Function overloads

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

// Function applications

foo(1, 1)
//│ Int

foo("Hello", "World")
//│ ∀α. {Str ≤ (⊤ ⟹ {α ≥ Str}) ∨ ⊥, Str ≤ (Str ⟹ {α ≥ Str}) ∨ (⊤ ⟹ {Str ≤ ⊥}), α ≥ Str ∧ (⊥ ⟹ {Str ≤ ⊥})} ⟹ α

foo(true, "")
//│ ∀α. {Bool ≤ (⊤ ⟹ {α ≥ Str}) ∨ ⊥, Str ≤ (Str ⟹ {α ≥ Str}) ∨ (⊤ ⟹ {Bool ≤ ⊥}), α ≥ Str ∧ (⊥ ⟹ {Bool ≤ ⊥})} ⟹ α

foo(bot, bot)
//│ ∀α. α

// Errors

:te
foo as (Bool -> Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∧ (∀δ. {α ≤ (⊤ ⟹ {β ≤ Str, δ ≥ Str}) ∨ ⊥, β ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {α ≤ ⊥}), δ ≥ (Str ⟹ {β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ δ ⟹ {α ≤ ¬Int}), α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (¬Int ⟹ {γ ≥ ∀δ. {α ≤ (⊤ ⟹ {β ≤ Str, δ ≥ Str}) ∨ ⊥, β ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {α ≤ ⊥}), δ ≥ (Str ⟹ {β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ δ}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (⊤ ⟹ {α ≤ ¬Int, γ ≥ ∀δ. {α ≤ (⊤ ⟹ {β ≤ Str, δ ≥ Str}) ∨ ⊥, β ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {α ≤ ⊥}), δ ≥ (Str ⟹ {β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ δ})} ⟹ α → β → γ ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α, β, γ. {γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∧ (∀δ. {α ≤ (⊤ ⟹ {β ≤ Str, δ ≥ Str}) ∨ ⊥, β ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {α ≤ ⊥}), δ ≥ (Str ⟹ {β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ δ ⟹ {α ≤ ¬Int}), α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (¬Int ⟹ {γ ≥ ∀δ. {α ≤ (⊤ ⟹ {β ≤ Str, δ ≥ Str}) ∨ ⊥, β ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {α ≤ ⊥}), δ ≥ (Str ⟹ {β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ δ}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (⊤ ⟹ {α ≤ ¬Int, γ ≥ ∀δ. {α ≤ (⊤ ⟹ {β ≤ Str, δ ≥ Str}) ∨ ⊥, β ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {α ≤ ⊥}), δ ≥ (Str ⟹ {β ≤ Str}) ∧ (⊥ ⟹ {α ≤ ⊥})} ⟹ δ})} ⟹ α → β → γ ≤ Bool → Bool → Bool
//│     {η ≥ (Int ⟹ {ε ≤ Int, ζ ≤ Int}) ∧ (∀δ. {ε ≤ (⊤ ⟹ {ζ ≤ Str, δ ≥ Str}) ∨ ⊥, ζ ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), δ ≥ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ δ ⟹ {ε ≤ ¬Int}), ε ≤ (Int ⟹ {ζ ≤ Int, η ≥ Int}) ∨ (¬Int ⟹ {η ≥ ∀δ. {ε ≤ (⊤ ⟹ {ζ ≤ Str, δ ≥ Str}) ∨ ⊥, ζ ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), δ ≥ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ δ}), ζ ≤ (Int ⟹ {ε ≤ Int, η ≥ Int}) ∨ (⊤ ⟹ {ε ≤ ¬Int, η ≥ ∀δ. {ε ≤ (⊤ ⟹ {ζ ≤ Str, δ ≥ Str}) ∨ ⊥, ζ ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), δ ≥ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ δ})} ⟹ ε → ζ → η ≤ Bool → Bool → Bool
//│       {ε ≤ (Int ⟹ {ζ ≤ Int, η ≥ Int}) ∨ (¬Int ⟹ {η ≥ ∀δ. {ε ≤ (⊤ ⟹ {ζ ≤ Str, δ ≥ Str}) ∨ ⊥, ζ ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), δ ≥ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ δ}), ζ ≤ (Int ⟹ {ε ≤ Int, η ≥ Int}) ∨ (⊤ ⟹ {ε ≤ ¬Int, η ≥ ∀δ. {ε ≤ (⊤ ⟹ {ζ ≤ Str, δ ≥ Str}) ∨ ⊥, ζ ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), δ ≥ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ δ})} ⟹ ε → ζ → η ≤ Bool → Bool → Bool
//│         {ζ ≤ (Int ⟹ {ε ≤ Int, η ≥ Int}) ∨ (⊤ ⟹ {ε ≤ ¬Int, η ≥ ∀δ. {ε ≤ (⊤ ⟹ {ζ ≤ Str, δ ≥ Str}) ∨ ⊥, ζ ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), δ ≥ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ δ})} ⟹ ε → ζ → η ≤ Bool → Bool → Bool
//│           ε → ζ → η ≤ Bool → Bool → Bool
//│             ζ → η ≤ Bool → Bool
//│               η ≤ Bool
//│                 ((Int ⟹ {ε ≤ Int, ζ ≤ Int}) ∧ (∀δ. {ε ≤ (⊤ ⟹ {ζ ≤ Str, δ ≥ Str}) ∨ ⊥, ζ ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), δ ≥ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ δ ⟹ {ε ≤ ¬Int})) ∨ (∀δ. {ε ≤ (⊤ ⟹ {ζ ≤ Str, δ ≥ Str}) ∨ ⊥, ζ ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), δ ≥ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ δ) ≤ Bool
//│                   (Int ⟹ {ε ≤ Int, ζ ≤ Int}) ∧ (∀δ. {ε ≤ (⊤ ⟹ {ζ ≤ Str, δ ≥ Str}) ∨ ⊥, ζ ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), δ ≥ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ δ ⟹ {ε ≤ ¬Int}) ≤ Bool
//│                     Int ⟹ {ε ≤ Int, ζ ≤ Int} ≤ Bool
//│                       Int ⟹ {ζ ≤ Int} ≤ Bool
//│                         Int ≤ Bool
//│                     ∀δ. {ε ≤ (⊤ ⟹ {ζ ≤ Str, δ ≥ Str}) ∨ ⊥, ζ ≤ (Str ⟹ {δ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), δ ≥ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ δ ⟹ {ε ≤ ¬Int} ≤ Bool
//│                       {ε ≤ (⊤ ⟹ {ζ ≤ Str, θ ≥ Str}) ∨ ⊥, ζ ≤ (Str ⟹ {θ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), θ ≥ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ θ ⟹ {ε ≤ ¬Int} ≤ Bool
//│                         {ε ≤ (⊤ ⟹ {ζ ≤ Str, θ ≥ Str}) ∨ ⊥, ζ ≤ (Str ⟹ {θ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), θ ≥ (Str ⟹ {ζ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ θ ≤ Bool
//│                           ε ≤ (⊤ ⟹ {ζ ≤ Str, θ ≥ Str}) ∨ ⊥
//│                             Bool ≤ (⊤ ⟹ {ζ ≤ Str, θ ≥ Str}) ∨ ⊥
//│                               Bool ≤ ⊤ ⟹ {ζ ≤ Str, θ ≥ Str}
//│                                 ζ ≤ Str
//│                                   Bool ≤ Str
//│                               Bool ≤ ⊥

:te
foo(true, 1)
//│ ∀α. {Bool ≤ (⊤ ⟹ {Int ≤ Str, α ≥ Str}) ∨ ⊥, Int ≤ (Str ⟹ {α ≥ Str}) ∨ (⊤ ⟹ {Bool ≤ ⊥}), α ≥ (Str ⟹ {Int ≤ Str}) ∧ (⊥ ⟹ {Bool ≤ ⊥})} ⟹ α
//│ FAILURE: Unexpected lack of type error

:te
foo(true, true)
//│ ∀α. {Bool ≤ (⊤ ⟹ {Bool ≤ Str, α ≥ Str}) ∨ ⊥, Bool ≤ (Str ⟹ {α ≥ Str}) ∨ (⊤ ⟹ {Bool ≤ ⊥}), α ≥ (Str ⟹ {Bool ≤ Str}) ∧ (⊥ ⟹ {Bool ≤ ⊥})} ⟹ α
//│ FAILURE: Unexpected lack of type error

:te
foo(1, "World")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
//│ Typing error tree:
//│   α ≤ Str → β
//│     γ → δ ≤ Str → β
//│       Str ≤ γ
//│         Str ≤ ((Int ⟹ {ε ≤ Int, δ ≥ Int}) ∨ (⊤ ⟹ {ε ≤ ¬Int, δ ≥ ∀ζ. {ε ≤ (⊤ ⟹ {γ ≤ Str, ζ ≥ Str}) ∨ ⊥, γ ≤ (Str ⟹ {ζ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), ζ ≥ (Str ⟹ {γ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ ζ})) ∧ Int
//│           Str ≤ (Int ⟹ {ε ≤ Int, δ ≥ Int}) ∧ Int
//│             Str ≤ Int ⟹ {ε ≤ Int, δ ≥ Int}
//│               Str ≤ Int ⟹ {δ ≥ Int}
//│                 Str ≤ Int
//│           Str ≤ (⊤ ⟹ {ε ≤ ¬Int, δ ≥ ∀ζ. {ε ≤ (⊤ ⟹ {γ ≤ Str, ζ ≥ Str}) ∨ ⊥, γ ≤ (Str ⟹ {ζ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), ζ ≥ (Str ⟹ {γ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ ζ}) ∧ Int
//│             Str ≤ ⊤ ⟹ {ε ≤ ¬Int, δ ≥ ∀ζ. {ε ≤ (⊤ ⟹ {γ ≤ Str, ζ ≥ Str}) ∨ ⊥, γ ≤ (Str ⟹ {ζ ≥ Str}) ∨ (⊤ ⟹ {ε ≤ ⊥}), ζ ≥ (Str ⟹ {γ ≤ Str}) ∧ (⊥ ⟹ {ε ≤ ⊥})} ⟹ ζ}
//│               ε ≤ ¬Int
//│                 Int ≤ ¬Int
