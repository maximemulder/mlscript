:ctml

:ctml-cfg merge-constring arbitrary-patterns

// Function definitions

fun foo(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ foo: ∀α, β, γ. {α ≤ (Int ⟹ {γ ≤ Int, β ≥ Int}) ∨ (Str ⟹ {γ ≤ ¬Int, β ≥ Str}), β ≥ (Int ⟹ {γ ≤ Int, α ≤ Int}) ∧ (Str ⟹ {γ ≤ ¬Int, α ≤ Str}), γ ≤ (Int ⟹ {α ≤ Int, β ≥ Int}) ∨ (¬Int ⟹ {α ≤ Str, β ≥ Str})} ⟹ γ → α → β

// Function overloads

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

// Function applications

foo(1, 1)
//│ Int

foo("Hello", "World")
//│ Str

foo(true, "")
//│ Str

foo(bot, bot)
//│ ⊥

// Errors

:te
foo as (Bool -> Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ (Int ⟹ {γ ≤ Int, β ≥ Int}) ∨ (Str ⟹ {γ ≤ ¬Int, β ≥ Str}), β ≥ (Int ⟹ {γ ≤ Int, α ≤ Int}) ∧ (Str ⟹ {γ ≤ ¬Int, α ≤ Str}), γ ≤ (Int ⟹ {α ≤ Int, β ≥ Int}) ∨ (¬Int ⟹ {α ≤ Str, β ≥ Str})} ⟹ γ → α → β ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ (Int ⟹ {γ ≤ Int, β ≥ Int}) ∨ (Str ⟹ {γ ≤ ¬Int, β ≥ Str}), β ≥ (Int ⟹ {γ ≤ Int, α ≤ Int}) ∧ (Str ⟹ {γ ≤ ¬Int, α ≤ Str}), γ ≤ (Int ⟹ {α ≤ Int, β ≥ Int}) ∨ (¬Int ⟹ {α ≤ Str, β ≥ Str})} ⟹ γ → α → β ≤ Bool → Bool → Bool
//│     {ε ≤ (Int ⟹ {δ ≤ Int, ζ ≥ Int}) ∨ (Str ⟹ {δ ≤ ¬Int, ζ ≥ Str}), ζ ≥ (Int ⟹ {δ ≤ Int, ε ≤ Int}) ∧ (Str ⟹ {δ ≤ ¬Int, ε ≤ Str}), δ ≤ (Int ⟹ {ε ≤ Int, ζ ≥ Int}) ∨ (¬Int ⟹ {ε ≤ Str, ζ ≥ Str})} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│       {ζ ≥ (Int ⟹ {δ ≤ Int, ε ≤ Int}) ∧ (Str ⟹ {δ ≤ ¬Int, ε ≤ Str}), δ ≤ (Int ⟹ {ε ≤ Int, ζ ≥ Int}) ∨ (¬Int ⟹ {ε ≤ Str, ζ ≥ Str})} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│         {δ ≤ (Int ⟹ {ε ≤ Int, ζ ≥ Int}) ∨ (¬Int ⟹ {ε ≤ Str, ζ ≥ Str})} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│           δ → ε → ζ ≤ Bool → Bool → Bool
//│             ε → ζ ≤ Bool → Bool
//│               Bool ≤ ε
//│                 Bool ≤ ((Int ⟹ {δ ≤ Int, ζ ≥ Int}) ∨ (Str ⟹ {δ ≤ ¬Int, ζ ≥ Str})) ∧ Str
//│                   Bool ≤ (Int ⟹ {δ ≤ Int, ζ ≥ Int}) ∧ Str
//│                     Bool ≤ Int ⟹ {δ ≤ Int, ζ ≥ Int}
//│                       Bool ≤ Int ⟹ {ζ ≥ Int}
//│                         Bool ≤ Int
//│                   Bool ≤ (Str ⟹ {δ ≤ ¬Int, ζ ≥ Str}) ∧ Str
//│                     Bool ≤ Str ⟹ {δ ≤ ¬Int, ζ ≥ Str}
//│                       Bool ≤ Str ⟹ {ζ ≥ Str}
//│                         Bool ≤ Str

:te
foo(true, 1)
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Int → β.
//│ Typing error tree:
//│   α ≤ Int → β
//│     γ → δ ≤ Int → β
//│       Int ≤ γ
//│         Int ≤ ((Int ⟹ {ε ≤ Int, δ ≥ Int}) ∨ (Str ⟹ {ε ≤ ¬Int, δ ≥ Str})) ∧ Str
//│           Int ≤ (Int ⟹ {ε ≤ Int, δ ≥ Int}) ∧ Str
//│             Int ≤ Int ⟹ {ε ≤ Int, δ ≥ Int}
//│               ε ≤ Int
//│                 Bool ≤ Int
//│           Int ≤ (Str ⟹ {ε ≤ ¬Int, δ ≥ Str}) ∧ Str
//│             Int ≤ Str ⟹ {ε ≤ ¬Int, δ ≥ Str}
//│               Int ≤ Str ⟹ {δ ≥ Str}
//│                 Int ≤ Str

:te
foo(true, true)
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Bool → β.
//│ Typing error tree:
//│   α ≤ Bool → β
//│     γ → δ ≤ Bool → β
//│       Bool ≤ γ
//│         Bool ≤ ((Int ⟹ {ε ≤ Int, δ ≥ Int}) ∨ (Str ⟹ {ε ≤ ¬Int, δ ≥ Str})) ∧ Str
//│           Bool ≤ (Int ⟹ {ε ≤ Int, δ ≥ Int}) ∧ Str
//│             Bool ≤ Int ⟹ {ε ≤ Int, δ ≥ Int}
//│               Bool ≤ Int ⟹ {δ ≥ Int}
//│                 Bool ≤ Int
//│           Bool ≤ (Str ⟹ {ε ≤ ¬Int, δ ≥ Str}) ∧ Str
//│             Bool ≤ Str ⟹ {ε ≤ ¬Int, δ ≥ Str}
//│               Bool ≤ Str ⟹ {δ ≥ Str}
//│                 Bool ≤ Str

:te
foo(1, "World")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
//│ Typing error tree:
//│   α ≤ Str → β
//│     γ → δ ≤ Str → β
//│       Str ≤ γ
//│         Str ≤ ((Int ⟹ {ε ≤ Int, δ ≥ Int}) ∨ (Str ⟹ {ε ≤ ¬Int, δ ≥ Str})) ∧ Int
//│           Str ≤ (Int ⟹ {ε ≤ Int, δ ≥ Int}) ∧ Int
//│             Str ≤ Int ⟹ {ε ≤ Int, δ ≥ Int}
//│               Str ≤ Int ⟹ {δ ≥ Int}
//│                 Str ≤ Int
//│           Str ≤ (Str ⟹ {ε ≤ ¬Int, δ ≥ Str}) ∧ Int
//│             Str ≤ Str ⟹ {ε ≤ ¬Int, δ ≥ Str}
//│               ε ≤ ¬Int
//│                 Int ≤ ¬Int
