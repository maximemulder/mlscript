:ctml

:ctml-cfg weird-match

// Function definitions

fun foo(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ foo: ∀α, β, γ. {α ≤ (Int ⟹ {β ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {β ≥ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str}), γ ≤ (Int ⟹ {β ≥ Int, α ≤ Int}) ∨ (⊤ ⟹ {β ≥ Str, α ≤ Str})} ⟹ γ → α → β

// Function overloads

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

// Function applications

foo(1, 1)
//│ ∀α, β. {α ≥ Int, α ≤ Int, β ≥ Int} ⟹ β

foo("Hello", "World")
//│ Str

foo(true, "")
//│ Str

foo(bot, bot)
//│ ⊥

// Errors

:e
foo as (Bool -> Bool -> Bool)
//│ ═══[ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ (Int ⟹ {β ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {β ≥ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str}), γ ≤ (Int ⟹ {β ≥ Int, α ≤ Int}) ∨ (⊤ ⟹ {β ≥ Str, α ≤ Str})} ⟹ γ → α → β ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ (Int ⟹ {β ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {β ≥ Str}), β ≥ (Int ⟹ {α ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {α ≤ Str}), γ ≤ (Int ⟹ {β ≥ Int, α ≤ Int}) ∨ (⊤ ⟹ {β ≥ Str, α ≤ Str})} ⟹ γ → α → β ≤ Bool → Bool → Bool
//│     ∀β, γ. {δ ≤ (Int ⟹ {β ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {β ≥ Str}), β ≥ (Int ⟹ {δ ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {δ ≤ Str}), γ ≤ (Int ⟹ {β ≥ Int, δ ≤ Int}) ∨ (⊤ ⟹ {β ≥ Str, δ ≤ Str})} ⟹ γ → δ → β ≤ Bool → Bool → Bool
//│       ∀γ. {δ ≤ (Int ⟹ {ε ≥ Int, γ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str}), ε ≥ (Int ⟹ {δ ≤ Int, γ ≤ Int}) ∧ (Str ⟹ {δ ≤ Str}), γ ≤ (Int ⟹ {ε ≥ Int, δ ≤ Int}) ∨ (⊤ ⟹ {ε ≥ Str, δ ≤ Str})} ⟹ γ → δ → ε ≤ Bool → Bool → Bool
//│         {δ ≤ (Int ⟹ {ε ≥ Int, ζ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str}), ε ≥ (Int ⟹ {δ ≤ Int, ζ ≤ Int}) ∧ (Str ⟹ {δ ≤ Str}), ζ ≤ (Int ⟹ {ε ≥ Int, δ ≤ Int}) ∨ (⊤ ⟹ {ε ≥ Str, δ ≤ Str})} ⟹ ζ → δ → ε ≤ Bool → Bool → Bool
//│           {ε ≥ (Int ⟹ {δ ≤ Int, ζ ≤ Int}) ∧ (Str ⟹ {δ ≤ Str}), ζ ≤ (Int ⟹ {ε ≥ Int, δ ≤ Int}) ∨ (⊤ ⟹ {ε ≥ Str, δ ≤ Str})} ⟹ ζ → δ → ε ≤ Bool → Bool → Bool
//│             {ζ ≤ (Int ⟹ {ε ≥ Int, δ ≤ Int}) ∨ (⊤ ⟹ {ε ≥ Str, δ ≤ Str})} ⟹ ζ → δ → ε ≤ Bool → Bool → Bool
//│               ζ → δ → ε ≤ Bool → Bool → Bool
//│                 δ → ε ≤ Bool → Bool
//│                   Bool ≤ δ
//│                     Bool ≤ ((Int ⟹ {ε ≥ Int, ζ ≤ Int}) ∨ (Str ⟹ {ε ≥ Str})) ∧ Str
//│                       Bool ≤ (Int ⟹ {ε ≥ Int, ζ ≤ Int}) ∧ Str
//│                         Bool ≤ Int ⟹ {ε ≥ Int, ζ ≤ Int}
//│                           Bool ≤ Int ⟹ {ζ ≤ Int}
//│                             Bool ≤ Int
//│                       Bool ≤ (Str ⟹ {ε ≥ Str}) ∧ Str
//│                         Bool ≤ Str ⟹ {ε ≥ Str}
//│                           Bool ≤ Str

:e
foo(true, 1)
//│ ═══[ERROR] Cannot solve judgment Str → Str ≤ Int → α.
//│ Typing error tree:
//│   Str → Str ≤ Int → α
//│     Int ≤ Str

:e
foo(true, true)
//│ ═══[ERROR] Cannot solve judgment Str → Str ≤ Bool → α.
//│ Typing error tree:
//│   Str → Str ≤ Bool → α
//│     Bool ≤ Str

// There seems to be a problem with variable being inlined too eagerly.
:breakme
foo(1, "World")
//│ ∀α, β. {α ≥ Str, α ≤ Str, β ≥ Str} ⟹ β
