:ctml

:ctml-cfg merge-constring arbitrary-patterns

// Function definitions

fun foo(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ foo: ∀α, β, γ. {α ≥ (Int ⟹ {γ ≤ Int, β ≤ Int}) ∧ (Str ⟹ {γ ≤ ¬Int, β ≤ Str, δ ≥ Str}), β ≤ (Int ⟹ {γ ≤ Int, α ≥ Int}) ∨ (Str ⟹ {γ ≤ ¬Int, δ ≥ Str, α ≥ Str}), γ ≤ (Int ⟹ {β ≤ Int, α ≥ Int}) ∨ (¬Int ⟹ {β ≤ Str, δ ≥ Str, α ≥ Str})} ⟹ γ → β → α

