:ctml

:ctml-cfg merge-constring arbitrary-patterns

// Function definitions

fun foo(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ LEVEL ERROR 2 4 2
//│ LEVEL ERROR 1 3 2
