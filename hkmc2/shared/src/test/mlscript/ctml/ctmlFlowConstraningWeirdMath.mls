:ctml

:ctml-cfg merge-constring arbitrary-patterns

// Function definitions

fun foo(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ foo: ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (¬Int ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ ¬Int}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ ¬Int})} ⟹ α → β → γ

// Function overloads

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

// Function applications

foo(1, 1)
//│ ⊥

foo("Hello", "World")
//│ ⊥

foo(true, "")
//│ ⊥

foo(bot, bot)
//│ ⊥

// Errors

:te
foo as (Bool -> Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (¬Int ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ ¬Int}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ ¬Int})} ⟹ α → β → γ ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (¬Int ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ ¬Int}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ ¬Int})} ⟹ α → β → γ ≤ Bool → Bool → Bool
//│     ∀β, γ. {δ ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (¬Int ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, δ ≤ ¬Int}), γ ≥ (Int ⟹ {β ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {β ≤ Str, δ ≤ ¬Int})} ⟹ δ → β → γ ≤ Bool → Bool → Bool
//│       ∀γ. {δ ≤ (Int ⟹ {γ ≥ Int, ε ≤ Int}) ∨ (¬Int ⟹ {γ ≥ Str, ε ≤ Str}), ε ≤ (Int ⟹ {γ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, δ ≤ ¬Int}), γ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ ¬Int})} ⟹ δ → ε → γ ≤ Bool → Bool → Bool
//│         {δ ≤ (Int ⟹ {ζ ≥ Int, ε ≤ Int}) ∨ (¬Int ⟹ {ζ ≥ Str, ε ≤ Str}), ε ≤ (Int ⟹ {ζ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, δ ≤ ¬Int}), ζ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ ¬Int})} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│           {ε ≤ (Int ⟹ {ζ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, δ ≤ ¬Int}), ζ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ ¬Int})} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│             {ζ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ ¬Int})} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│               δ → ε → ζ ≤ Bool → Bool → Bool
//│                 ε → ζ ≤ Bool → Bool
//│                   Bool ≤ ε
//│                     Bool ≤ ((Int ⟹ {ζ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, δ ≤ ¬Int})) ∧ Str
//│                       Bool ≤ (Int ⟹ {ζ ≥ Int, δ ≤ Int}) ∧ Str
//│                         Bool ≤ Int ⟹ {ζ ≥ Int, δ ≤ Int}
//│                           Bool ≤ Int ⟹ {δ ≤ Int}
//│                             Bool ≤ Int
//│                       Bool ≤ (Str ⟹ {ζ ≥ Str, δ ≤ ¬Int}) ∧ Str
//│                         Bool ≤ Str ⟹ {ζ ≥ Str, δ ≤ ¬Int}
//│                           Bool ≤ Str ⟹ {δ ≤ ¬Int}
//│                             Bool ≤ Str

:te
foo(true, 1)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {α ≤ Str, β ≥ Str} ⟹ α → β ≤ Int → γ.
//│ Typing error tree:
//│   ∀α, β. {α ≤ Str, β ≥ Str} ⟹ α → β ≤ Int → γ
//│     ∀β. {δ ≤ Str, β ≥ Str} ⟹ δ → β ≤ Int → γ
//│       {δ ≤ Str, ε ≥ Str} ⟹ δ → ε ≤ Int → γ
//│         {ε ≥ Str} ⟹ δ → ε ≤ Int → γ
//│           δ → ε ≤ Int → γ
//│             Int ≤ δ
//│               Int ≤ Str

:te
foo(true, true)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {α ≤ Str, β ≥ Str} ⟹ α → β ≤ Bool → γ.
//│ Typing error tree:
//│   ∀α, β. {α ≤ Str, β ≥ Str} ⟹ α → β ≤ Bool → γ
//│     ∀β. {δ ≤ Str, β ≥ Str} ⟹ δ → β ≤ Bool → γ
//│       {δ ≤ Str, ε ≥ Str} ⟹ δ → ε ≤ Bool → γ
//│         {ε ≥ Str} ⟹ δ → ε ≤ Bool → γ
//│           δ → ε ≤ Bool → γ
//│             Bool ≤ δ
//│               Bool ≤ Str

:te
foo(1, "World")
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {α ≤ Int, β ≥ Int} ⟹ α → β ≤ Str → γ.
//│ Typing error tree:
//│   ∀α, β. {α ≤ Int, β ≥ Int} ⟹ α → β ≤ Str → γ
//│     ∀β. {δ ≤ Int, β ≥ Int} ⟹ δ → β ≤ Str → γ
//│       {δ ≤ Int, ε ≥ Int} ⟹ δ → ε ≤ Str → γ
//│         {ε ≥ Int} ⟹ δ → ε ≤ Str → γ
//│           δ → ε ≤ Str → γ
//│             Str ≤ δ
//│               Str ≤ Int
