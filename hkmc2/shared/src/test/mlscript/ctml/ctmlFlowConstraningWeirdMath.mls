:ctml

:ctml-cfg merge-constring arbitrary-patterns

// Function definitions

fun foo(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ foo: ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (¬Int ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ ¬Int}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ ¬Int})} ⟹ α → β → γ

// Function overloads

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

// Function applications

foo(1, 1)
//│ Int

foo("Hello", "World")
//│ Str

foo(true, "")
//│ Str

foo(bot, bot)
//│ ⊥

// Errors

:te
foo as (Bool -> Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (¬Int ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ ¬Int}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ ¬Int})} ⟹ α → β → γ ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (¬Int ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ ¬Int}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ ¬Int})} ⟹ α → β → γ ≤ Bool → Bool → Bool
//│     ∀β, γ. {δ ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (¬Int ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, δ ≤ ¬Int}), γ ≥ (Int ⟹ {β ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {β ≤ Str, δ ≤ ¬Int})} ⟹ δ → β → γ ≤ Bool → Bool → Bool
//│       ∀γ. {δ ≤ (Int ⟹ {γ ≥ Int, ε ≤ Int}) ∨ (¬Int ⟹ {γ ≥ Str, ε ≤ Str}), ε ≤ (Int ⟹ {γ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, δ ≤ ¬Int}), γ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ ¬Int})} ⟹ δ → ε → γ ≤ Bool → Bool → Bool
//│         {δ ≤ (Int ⟹ {ζ ≥ Int, ε ≤ Int}) ∨ (¬Int ⟹ {ζ ≥ Str, ε ≤ Str}), ε ≤ (Int ⟹ {ζ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, δ ≤ ¬Int}), ζ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ ¬Int})} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│           {ε ≤ (Int ⟹ {ζ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, δ ≤ ¬Int}), ζ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ ¬Int})} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│             {ζ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ ¬Int})} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│               δ → ε → ζ ≤ Bool → Bool → Bool
//│                 ε → ζ ≤ Bool → Bool
//│                   Bool ≤ ε
//│                     Bool ≤ (((Int ⟹ {ζ ≥ Int, η ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, η ≤ ¬Int})) ∧ θ) ∧ Str
//│                       Bool ≤ ((Int ⟹ {ζ ≥ Int, η ≤ Int}) ∧ θ) ∧ Str
//│                         Bool ≤ (Int ⟹ {ζ ≥ Int, η ≤ Int}) ∧ θ
//│                           Bool ≤ Int ⟹ {ζ ≥ Int, η ≤ Int}
//│                             Bool ≤ Int ⟹ {η ≤ Int}
//│                               Bool ≤ Int
//│                       Bool ≤ ((Str ⟹ {ζ ≥ Str, η ≤ ¬Int}) ∧ θ) ∧ Str
//│                         Bool ≤ (Str ⟹ {ζ ≥ Str, η ≤ ¬Int}) ∧ θ
//│                           Bool ≤ Str ⟹ {ζ ≥ Str, η ≤ ¬Int}
//│                             Bool ≤ Str ⟹ {η ≤ ¬Int}
//│                               Bool ≤ Str

:te
foo(true, 1)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {α ≥ ((Int ⟹ {β ≤ Int, Bool ≤ Int}) ∧ (Str ⟹ {β ≤ Str})) ∨ Str} ⟹ ((((Int ⟹ {α ≥ Int}) ∨ Str) ∧ β) ∧ Str) → α ≤ Int → γ.
//│ Typing error tree:
//│   ∀α, β. {α ≥ ((Int ⟹ {β ≤ Int, Bool ≤ Int}) ∧ (Str ⟹ {β ≤ Str})) ∨ Str} ⟹ ((((Int ⟹ {α ≥ Int}) ∨ Str) ∧ β) ∧ Str) → α ≤ Int → γ
//│     ∀β. {δ ≥ ((Int ⟹ {β ≤ Int, Bool ≤ Int}) ∧ (Str ⟹ {β ≤ Str})) ∨ Str} ⟹ ((((Int ⟹ {δ ≥ Int}) ∨ Str) ∧ β) ∧ Str) → δ ≤ Int → γ
//│       {δ ≥ ((Int ⟹ {ε ≤ Int, Bool ≤ Int}) ∧ (Str ⟹ {ε ≤ Str})) ∨ Str} ⟹ ((((Int ⟹ {δ ≥ Int}) ∨ Str) ∧ ε) ∧ Str) → δ ≤ Int → γ
//│         ((((Int ⟹ {δ ≥ Int}) ∨ Str) ∧ ε) ∧ Str) → δ ≤ Int → γ
//│           (((Int ⟹ {δ ≥ Int}) ∧ ε) ∧ Str) → δ ≤ Int → γ
//│             Int ≤ ((Int ⟹ {δ ≥ Int}) ∧ ε) ∧ Str
//│               Int ≤ Str
//│           ((Str ∧ ε) ∧ Str) → δ ≤ Int → γ
//│             Int ≤ (Str ∧ ε) ∧ Str
//│               Int ≤ Str ∧ ε
//│                 Int ≤ Str

:te
foo(true, true)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {α ≥ ((Int ⟹ {β ≤ Int, Bool ≤ Int}) ∧ (Str ⟹ {β ≤ Str})) ∨ Str} ⟹ ((((Int ⟹ {α ≥ Int}) ∨ Str) ∧ β) ∧ Str) → α ≤ Bool → γ.
//│ Typing error tree:
//│   ∀α, β. {α ≥ ((Int ⟹ {β ≤ Int, Bool ≤ Int}) ∧ (Str ⟹ {β ≤ Str})) ∨ Str} ⟹ ((((Int ⟹ {α ≥ Int}) ∨ Str) ∧ β) ∧ Str) → α ≤ Bool → γ
//│     ∀β. {δ ≥ ((Int ⟹ {β ≤ Int, Bool ≤ Int}) ∧ (Str ⟹ {β ≤ Str})) ∨ Str} ⟹ ((((Int ⟹ {δ ≥ Int}) ∨ Str) ∧ β) ∧ Str) → δ ≤ Bool → γ
//│       {δ ≥ ((Int ⟹ {ε ≤ Int, Bool ≤ Int}) ∧ (Str ⟹ {ε ≤ Str})) ∨ Str} ⟹ ((((Int ⟹ {δ ≥ Int}) ∨ Str) ∧ ε) ∧ Str) → δ ≤ Bool → γ
//│         ((((Int ⟹ {δ ≥ Int}) ∨ Str) ∧ ε) ∧ Str) → δ ≤ Bool → γ
//│           (((Int ⟹ {δ ≥ Int}) ∧ ε) ∧ Str) → δ ≤ Bool → γ
//│             Bool ≤ ((Int ⟹ {δ ≥ Int}) ∧ ε) ∧ Str
//│               Bool ≤ (Int ⟹ {δ ≥ Int}) ∧ ε
//│                 Bool ≤ Int ⟹ {δ ≥ Int}
//│                   Bool ≤ Int
//│           ((Str ∧ ε) ∧ Str) → δ ≤ Bool → γ
//│             Bool ≤ (Str ∧ ε) ∧ Str
//│               Bool ≤ Str ∧ ε
//│                 Bool ≤ Str

:te
foo(1, "World")
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {α ≥ ((Int ⟹ {β ≤ Int}) ∧ (Str ⟹ {β ≤ Str, Int ≤ ¬Int})) ∨ Int} ⟹ (((Int ∨ (Str ⟹ {α ≥ Str})) ∧ β) ∧ Int) → α ≤ Str → γ.
//│ Typing error tree:
//│   ∀α, β. {α ≥ ((Int ⟹ {β ≤ Int}) ∧ (Str ⟹ {β ≤ Str, Int ≤ ¬Int})) ∨ Int} ⟹ (((Int ∨ (Str ⟹ {α ≥ Str})) ∧ β) ∧ Int) → α ≤ Str → γ
//│     ∀β. {δ ≥ ((Int ⟹ {β ≤ Int}) ∧ (Str ⟹ {β ≤ Str, Int ≤ ¬Int})) ∨ Int} ⟹ (((Int ∨ (Str ⟹ {δ ≥ Str})) ∧ β) ∧ Int) → δ ≤ Str → γ
//│       {δ ≥ ((Int ⟹ {ε ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, Int ≤ ¬Int})) ∨ Int} ⟹ (((Int ∨ (Str ⟹ {δ ≥ Str})) ∧ ε) ∧ Int) → δ ≤ Str → γ
//│         (((Int ∨ (Str ⟹ {δ ≥ Str})) ∧ ε) ∧ Int) → δ ≤ Str → γ
//│           ((Int ∧ ε) ∧ Int) → δ ≤ Str → γ
//│             Str ≤ (Int ∧ ε) ∧ Int
//│               Str ≤ Int ∧ ε
//│                 Str ≤ Int
//│           (((Str ⟹ {δ ≥ Str}) ∧ ε) ∧ Int) → δ ≤ Str → γ
//│             Str ≤ ((Str ⟹ {δ ≥ Str}) ∧ ε) ∧ Int
//│               Str ≤ Int
