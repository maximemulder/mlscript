:ctml

:ctml-cfg merge-constring arbitrary-patterns

// Function definitions

fun foo(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ foo: ∀α, β, γ. {β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ ¬Int}), α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (¬Int ⟹ {γ ≥ Str, β ≤ Str}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ ¬Int})} ⟹ α → β → γ

// Function overloads

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

// Function applications

foo(1, 1)
//│ Int

foo("Hello", "World")
//│ Str

foo(true, "")
//│ Str

foo(bot, bot)
//│ ⊥

// Errors

:te
foo as (Bool -> Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ ¬Int}), α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (¬Int ⟹ {γ ≥ Str, β ≤ Str}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ ¬Int})} ⟹ α → β → γ ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α, β, γ. {β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ ¬Int}), α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (¬Int ⟹ {γ ≥ Str, β ≤ Str}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ ¬Int})} ⟹ α → β → γ ≤ Bool → Bool → Bool
//│     {ε ≤ (Int ⟹ {ζ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, δ ≤ ¬Int}), δ ≤ (Int ⟹ {ζ ≥ Int, ε ≤ Int}) ∨ (¬Int ⟹ {ζ ≥ Str, ε ≤ Str}), ζ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ ¬Int})} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│       {δ ≤ (Int ⟹ {ζ ≥ Int, ε ≤ Int}) ∨ (¬Int ⟹ {ζ ≥ Str, ε ≤ Str}), ζ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ ¬Int})} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│         {ζ ≥ (Int ⟹ {ε ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {ε ≤ Str, δ ≤ ¬Int})} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│           δ → ε → ζ ≤ Bool → Bool → Bool
//│             ε → ζ ≤ Bool → Bool
//│               Bool ≤ ε
//│                 Bool ≤ ((Int ⟹ {ζ ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ζ ≥ Str, δ ≤ ¬Int})) ∧ Str
//│                   Bool ≤ (Int ⟹ {ζ ≥ Int, δ ≤ Int}) ∧ Str
//│                     Bool ≤ Int ⟹ {ζ ≥ Int, δ ≤ Int}
//│                       Bool ≤ Int ⟹ {δ ≤ Int}
//│                         Bool ≤ Int
//│                   Bool ≤ (Str ⟹ {ζ ≥ Str, δ ≤ ¬Int}) ∧ Str
//│                     Bool ≤ Str ⟹ {ζ ≥ Str, δ ≤ ¬Int}
//│                       Bool ≤ Str ⟹ {δ ≤ ¬Int}
//│                         Bool ≤ Str

:te
foo(true, 1)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {β ≥ Str, α ≤ Str} ⟹ α → β ≤ Int → γ.
//│ Typing error tree:
//│   ∀α, β. {β ≥ Str, α ≤ Str} ⟹ α → β ≤ Int → γ
//│     {ε ≥ Str, δ ≤ Str} ⟹ δ → ε ≤ Int → γ
//│       {δ ≤ Str} ⟹ δ → ε ≤ Int → γ
//│         δ → ε ≤ Int → γ
//│           Int ≤ δ
//│             Int ≤ Str

:te
foo(true, true)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {β ≥ Str, α ≤ Str} ⟹ α → β ≤ Bool → γ.
//│ Typing error tree:
//│   ∀α, β. {β ≥ Str, α ≤ Str} ⟹ α → β ≤ Bool → γ
//│     {ε ≥ Str, δ ≤ Str} ⟹ δ → ε ≤ Bool → γ
//│       {δ ≤ Str} ⟹ δ → ε ≤ Bool → γ
//│         δ → ε ≤ Bool → γ
//│           Bool ≤ δ
//│             Bool ≤ Str

:te
foo(1, "World")
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {β ≥ Int, α ≤ Int} ⟹ α → β ≤ Str → γ.
//│ Typing error tree:
//│   ∀α, β. {β ≥ Int, α ≤ Int} ⟹ α → β ≤ Str → γ
//│     {ε ≥ Int, δ ≤ Int} ⟹ δ → ε ≤ Str → γ
//│       {δ ≤ Int} ⟹ δ → ε ≤ Str → γ
//│         δ → ε ≤ Str → γ
//│           Str ≤ δ
//│             Str ≤ Int
