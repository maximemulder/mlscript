:te
h2((x) => x + 1, int_or_string)
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ (Int ∨ Str) → β.
//│ Typing error tree:
//│   α ≤ (Int ∨ Str) → β
//│     γ → δ ≤ (Int ∨ Str) → β
//│       Int ∨ Str ≤ γ
//│         Int ∨ Str ≤ ¬({δ ≥ Int} ⟹ ¬Int)
//│           ¬Int ≤ ¬(Int ∨ Str)
//│             Int ∨ Str ≤ Int
//│               Str ≤ Int

// Functions as scrutinees

// A function is an instance of the negation of every class.

fun h3(a) = if a is Int then a + 1 else a
//│ h3: ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ α), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬Int} ⟹ α → β

h3((x) => x)
//│ ∀α. α → α
