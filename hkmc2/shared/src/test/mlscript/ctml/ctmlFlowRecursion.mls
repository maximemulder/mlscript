:ctml

:ctml-cfg error-absurd-constred

// A recursive call passes its argument to the parameter of the function itself, which is not
// generalized in the body of the function: the argument `1` of the recursive call bounds the
// parameter from below by `Int` in the else branch, where it is bounded from above by `¬Int`, so
// that the else branch is absurd and the parameter is bounded by `Int`.

fun r1(a) = if a is Int then a else r1(1)
//│ r1: ∀α. {α ≤ Int} ⟹ α → α

// The promises of the absurd else branch are guarded by `Int ≤ ¬Int`, which makes `Int` empty, so
// that they are absorbed by `Int` (see `holdsByAtoms`).

r1(1)
//│ Int

:te
r1("Hello")
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α. {α ≤ Int} ⟹ α → α ≤ Str → β.
//│ Typing error tree:
//│   ∀α. {α ≤ Int} ⟹ α → α ≤ Str → β
//│     {γ ≤ Int} ⟹ γ → γ ≤ Str → β
//│       γ → γ ≤ Str → β
//│         Str ≤ γ
//│           Str ≤ Int

fun r2(a, n) = if a is Int then a + n else r2(n, n)
//│ r2: ∀α, β, γ. {γ ≤ ¬({α ≥ Int, β ≤ Int} ⟹ ¬Int) ∨ ¬({β ≤ ¬({γ → β → α ≤ β → β → α} ⟹ Int), γ ≥ β, β ≤ β ∧ γ} ⟹ Int), β ≤ ¬({α ≥ Int, γ ≤ Int} ⟹ ¬Int) ∨ ¬({γ ≥ β, γ ≤ ¬Int} ⟹ Int), γ ≥ ({α ≥ Int, β ≤ Int, γ ≤ Int} ⟹ ⊥) ∧ ({β ≤ ¬({γ → β → α ≤ β → β → α} ⟹ Int), γ ≤ ¬Int, β ≤ β ∧ γ} ⟹ β), α ≥ ({β ≤ Int, γ ≤ Int} ⟹ Int) ∧ ({β ≤ ¬({γ → β → α ≤ β → β → ⊤} ⟹ Int), γ ≥ β, γ ≤ ¬Int, β ≤ β ∧ γ} ⟹ ⊥)} ⟹ γ → β → α

r2(1, 1)
//│ ∀α, β, γ. {β ≥ Int, γ ≤ Int, β ≤ ¬({γ ≤ Int} ⟹ ⊥) ∧ (¬({α ≥ Int, γ ≤ Int} ⟹ ¬Int) ∨ ¬({γ ≥ β, γ ≤ ¬Int} ⟹ Int)) ∧ Int, γ ≥ ({γ ≤ Int} ⟹ ⊥) ∨ Int ∨ (({α ≥ Int, β ≤ Int, γ ≤ Int} ⟹ ⊥) ∧ ({β ≤ ¬({γ → β → α ≤ β → β → α} ⟹ Int), γ ≤ ¬Int, β ≤ β ∧ γ} ⟹ β)), α ≥ (({β ≤ Int, γ ≤ Int} ⟹ Int) ∧ ({β ≤ ¬({γ → β → α ≤ β → β → ⊤} ⟹ Int), γ ≥ β, γ ≤ ¬Int, β ≤ β ∧ γ} ⟹ ⊥)) ∨ Int} ⟹ α

// Applying the recursive type supplies the parameter bounds before its guarded bounds are paid.
// The result is an integer, and the second argument must support integer addition.

r2(1, 1) as Int
//│ ∀α, β, γ. {β ≥ Int, γ ≤ Int, β ≤ ¬({γ ≤ Int} ⟹ ⊥) ∧ (¬({α ≥ Int, γ ≤ Int} ⟹ ¬Int) ∨ ¬({γ ≥ β, γ ≤ ¬Int} ⟹ Int)) ∧ Int, γ ≥ ({γ ≤ Int} ⟹ ⊥) ∨ Int ∨ (({α ≥ Int, β ≤ Int, γ ≤ Int} ⟹ ⊥) ∧ ({β ≤ ¬({γ → β → α ≤ β → β → α} ⟹ Int), γ ≤ ¬Int, β ≤ β ∧ γ} ⟹ β)), α ≥ (({β ≤ Int, γ ≤ Int} ⟹ Int) ∧ ({β ≤ ¬({γ → β → α ≤ β → β → ⊤} ⟹ Int), γ ≥ β, γ ≤ ¬Int, β ≤ β ∧ γ} ⟹ ⊥)) ∨ Int} ⟹ Int

:te
r2(1, 1) as Str
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str.
//│ Typing error tree:
//│   α ≤ Str
//│     (({γ ≤ Int, β ≤ Int} ⟹ Int) ∧ ({γ ≤ ¬({β → γ → δ ≤ γ → γ → ⊤} ⟹ Int), β ≥ γ, β ≤ ¬Int, γ ≤ γ ∧ β} ⟹ ⊥)) ∨ Int ≤ Str
//│       ({γ ≤ Int, β ≤ Int} ⟹ Int) ∧ ({γ ≤ ¬({β → γ → δ ≤ γ → γ → ⊤} ⟹ Int), β ≥ γ, β ≤ ¬Int, γ ≤ γ ∧ β} ⟹ ⊥) ≤ Str
//│         {γ ≤ Int, β ≤ Int} ⟹ Int ≤ Str
//│           {β ≤ Int} ⟹ Int ≤ Str
//│             Int ≤ Str
//│         {γ ≤ ¬({β → γ → δ ≤ γ → γ → ⊤} ⟹ Int), β ≥ γ, β ≤ ¬Int, γ ≤ γ ∧ β} ⟹ ⊥ ≤ Str
//│           {β ≥ γ, β ≤ ¬Int, γ ≤ γ ∧ β} ⟹ ⊥ ≤ Str
//│             {β ≤ ¬Int, γ ≤ γ ∧ β} ⟹ ⊥ ≤ Str
//│               β ≤ ¬Int
//│                 ({β ≤ Int} ⟹ ⊥) ∨ Int ∨ (({δ ≥ Int, γ ≤ Int, β ≤ Int} ⟹ ⊥) ∧ ({γ ≤ ¬({β → γ → δ ≤ γ → γ → δ} ⟹ Int), β ≤ ¬Int, γ ≤ γ ∧ β} ⟹ γ)) ≤ ¬Int
//│                   Int ∨ (({δ ≥ Int, γ ≤ Int, β ≤ Int} ⟹ ⊥) ∧ ({γ ≤ ¬({β → γ → δ ≤ γ → γ → δ} ⟹ Int), β ≤ ¬Int, γ ≤ γ ∧ β} ⟹ γ)) ≤ ¬Int
//│                     Int ≤ ¬Int

:te
r2(1, "Hello")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
//│ Typing error tree:
//│   α ≤ Str → β
//│     γ → δ ≤ Str → β
//│       Str ≤ γ
//│         Str ≤ ¬({ε ≤ Int} ⟹ ⊥) ∧ (¬({δ ≥ Int, ε ≤ Int} ⟹ ¬Int) ∨ ¬({ε ≥ γ, ε ≤ ¬Int} ⟹ Int)) ∧ Int
//│           Str ≤ (¬({δ ≥ Int, ε ≤ Int} ⟹ ¬Int) ∨ ¬({ε ≥ γ, ε ≤ ¬Int} ⟹ Int)) ∧ Int
//│             Str ≤ ¬({δ ≥ Int, ε ≤ Int} ⟹ ¬Int) ∨ ¬({ε ≥ γ, ε ≤ ¬Int} ⟹ Int)
//│               Str ≤ ¬({δ ≥ Int, ε ≤ Int} ⟹ ¬Int)
//│                 {ε ≤ Int} ⟹ ¬Int ≤ ¬Str
//│                   ¬Int ≤ ¬Str
//│                     Str ≤ Int
//│               Str ≤ ¬({ε ≥ γ, ε ≤ ¬Int} ⟹ Int)
//│                 {ε ≤ ¬Int} ⟹ Int ≤ ¬Str
//│                   ε ≤ ¬Int
//│                     ({ε ≤ Int} ⟹ ⊥) ∨ Int ∨ (({δ ≥ Int, γ ≤ Int, ε ≤ Int} ⟹ ⊥) ∧ ({γ ≤ ¬({ε → γ → δ ≤ γ → γ → δ} ⟹ Int), ε ≤ ¬Int, γ ≤ γ ∧ ε} ⟹ γ)) ≤ ¬Int
//│                       Int ∨ (({δ ≥ Int, γ ≤ Int, ε ≤ Int} ⟹ ⊥) ∧ ({γ ≤ ¬({ε → γ → δ ≤ γ → γ → δ} ⟹ Int), ε ≤ ¬Int, γ ≤ γ ∧ ε} ⟹ γ)) ≤ ¬Int
//│                         Int ≤ ¬Int
