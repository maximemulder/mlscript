:ctml

:ctml-cfg error-absurd-constred

// A recursive call passes its argument to the parameter of the function itself, which is not
// generalized in the body of the function: the argument `1` of the recursive call bounds the
// parameter from below by `Int` in the else branch, where it is bounded from above by `¬Int`, so
// that the else branch is absurd and the parameter is bounded by `Int`.

fun r1(a) = if a is Int then a else r1(1)
//│ r1: ∀α. {α ≤ Int} ⟹ α → α

// The promises of the absurd else branch are guarded by `Int ≤ ¬Int`, which makes `Int` empty, so
// that they are absorbed by `Int` (see `holdsByAtoms`).

r1(1)
//│ Int

:te
r1("Hello")
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α. {α ≤ Int} ⟹ α → α ≤ Str → β.
//│ Typing error tree:
//│   ∀α. {α ≤ Int} ⟹ α → α ≤ Str → β
//│     {γ ≤ Int} ⟹ γ → γ ≤ Str → β
//│       γ → γ ≤ Str → β
//│         Str ≤ γ
//│           Str ≤ Int

fun r2(a, n) = if a is Int then a + n else r2(n, n)
//│ r2: ∀α, β, γ. {β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≥ β, α ≤ ¬Int, α → β → γ ≤ β → β → γ} ⟹ Int), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≥ β, β ≤ ¬({α → β → γ ≤ β → β → γ} ⟹ Int)} ⟹ Int), α ≥ ({α ≤ Int, β ≤ Int, γ ≥ Int} ⟹ ⊥) ∧ ({α ≤ ¬Int, β ≤ ¬({α → β → γ ≤ β → β → γ} ⟹ Int)} ⟹ β), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≥ β, α ≤ ¬Int, β ≤ ¬({α → β → γ ≤ β → β → γ} ⟹ Int)} ⟹ ⊥)} ⟹ α → β → γ

r2(1, 1)
//│ ∀α, β, γ. {β ≥ Int, α ≤ Int, β ≤ (¬({α ≤ Int} ⟹ ⊥) ∧ Int) ∧ (¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≥ β, α ≤ ¬Int, α → β → γ ≤ β → β → γ} ⟹ Int)), α ≥ ({α ≤ Int} ⟹ ⊥) ∨ Int ∨ (({α ≤ Int, β ≤ Int, γ ≥ Int} ⟹ ⊥) ∧ ({α ≤ ¬Int, β ≤ ¬({α → β → γ ≤ β → β → γ} ⟹ Int)} ⟹ β)), γ ≥ (({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≥ β, α ≤ ¬Int, β ≤ ¬({α → β → γ ≤ β → β → γ} ⟹ Int)} ⟹ ⊥)) ∨ Int} ⟹ γ

// Applying the recursive type supplies the parameter bounds before its guarded bounds are paid.
// The result is an integer, and the second argument must support integer addition.

r2(1, 1) as Int
//│ ∀α, β, γ. {β ≥ Int, α ≤ Int, β ≤ (¬({α ≤ Int} ⟹ ⊥) ∧ Int) ∧ (¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≥ β, α ≤ ¬Int, α → β → γ ≤ β → β → γ} ⟹ Int)), α ≥ ({α ≤ Int} ⟹ ⊥) ∨ Int ∨ (({α ≤ Int, β ≤ Int, γ ≥ Int} ⟹ ⊥) ∧ ({α ≤ ¬Int, β ≤ ¬({α → β → γ ≤ β → β → γ} ⟹ Int)} ⟹ β)), γ ≥ (({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≥ β, α ≤ ¬Int, β ≤ ¬({α → β → γ ≤ β → β → γ} ⟹ Int)} ⟹ ⊥)) ∨ Int} ⟹ Int

:te
r2(1, 1) as Str
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str.
//│ Typing error tree:
//│   α ≤ Str
//│     (({γ ≤ Int, β ≤ Int} ⟹ Int) ∧ ({γ ≥ β, γ ≤ ¬Int, β ≤ ¬({γ → β → δ ≤ β → β → δ} ⟹ Int)} ⟹ ⊥)) ∨ Int ≤ Str
//│       ({γ ≤ Int, β ≤ Int} ⟹ Int) ∧ ({γ ≥ β, γ ≤ ¬Int, β ≤ ¬({γ → β → δ ≤ β → β → δ} ⟹ Int)} ⟹ ⊥) ≤ Str
//│         {γ ≤ Int, β ≤ Int} ⟹ Int ≤ Str
//│           γ ≤ Int
//│             ({γ ≤ Int} ⟹ ⊥) ∨ Int ∨ (({γ ≤ Int, β ≤ Int, δ ≥ Int} ⟹ ⊥) ∧ ({γ ≤ ¬Int, β ≤ ¬({γ → β → δ ≤ β → β → δ} ⟹ Int)} ⟹ β)) ≤ Int
//│               Int ∨ (({γ ≤ Int, β ≤ Int, δ ≥ Int} ⟹ ⊥) ∧ ({γ ≤ ¬Int, β ≤ ¬({γ → β → δ ≤ β → β → δ} ⟹ Int)} ⟹ β)) ≤ Int
//│                 ({γ ≤ Int, β ≤ Int, δ ≥ Int} ⟹ ⊥) ∧ ({γ ≤ ¬Int, β ≤ ¬({γ → β → δ ≤ β → β → δ} ⟹ Int)} ⟹ β) ≤ Int
//│                   {γ ≤ Int, β ≤ Int, δ ≥ Int} ⟹ ⊥ ≤ Int
//│                     {β ≤ Int, δ ≥ Int} ⟹ ⊥ ≤ Int
//│                       {δ ≥ Int} ⟹ ⊥ ≤ Int
//│                         Int ≤ δ
//│                           Int ≤ α
//│                             Int ≤ Str
//│                   {γ ≤ ¬Int, β ≤ ¬({γ → β → δ ≤ β → β → δ} ⟹ Int)} ⟹ β ≤ Int
//│                     γ ≤ ¬Int
//│                       ({γ ≤ Int} ⟹ ⊥) ∨ Int ∨ (({γ ≤ Int, β ≤ Int, δ ≥ Int} ⟹ ⊥) ∧ ({γ ≤ ¬Int, β ≤ ¬({γ → β → δ ≤ β → β → δ} ⟹ Int)} ⟹ β)) ≤ ¬Int
//│                         Int ∨ (({γ ≤ Int, β ≤ Int, δ ≥ Int} ⟹ ⊥) ∧ ({γ ≤ ¬Int, β ≤ ¬({γ → β → δ ≤ β → β → δ} ⟹ Int)} ⟹ β)) ≤ ¬Int
//│                           Int ≤ ¬Int
//│         {γ ≥ β, γ ≤ ¬Int, β ≤ ¬({γ → β → δ ≤ β → β → δ} ⟹ Int)} ⟹ ⊥ ≤ Str
//│           {γ ≤ ¬Int, β ≤ ¬({γ → β → δ ≤ β → β → δ} ⟹ Int)} ⟹ ⊥ ≤ Str
//│             γ ≤ ¬Int
//│               ({γ ≤ Int} ⟹ ⊥) ∨ Int ∨ (({γ ≤ Int, β ≤ Int, δ ≥ Int} ⟹ ⊥) ∧ ({γ ≤ ¬Int, β ≤ ¬({γ → β → δ ≤ β → β → δ} ⟹ Int)} ⟹ β)) ≤ ¬Int
//│                 {γ ≤ Int} ⟹ ⊥ ≤ ¬Int
//│                   γ ≤ Int
//│                     ({γ ≤ Int} ⟹ ⊥) ∨ Int ∨ (({γ ≤ Int, β ≤ Int, δ ≥ Int} ⟹ ⊥) ∧ ({γ ≤ ¬Int, β ≤ ¬({γ → β → δ ≤ β → β → δ} ⟹ Int)} ⟹ β)) ≤ Int
//│                       Int ∨ (({γ ≤ Int, β ≤ Int, δ ≥ Int} ⟹ ⊥) ∧ ({γ ≤ ¬Int, β ≤ ¬({γ → β → δ ≤ β → β → δ} ⟹ Int)} ⟹ β)) ≤ Int
//│                         ({γ ≤ Int, β ≤ Int, δ ≥ Int} ⟹ ⊥) ∧ ({γ ≤ ¬Int, β ≤ ¬({γ → β → δ ≤ β → β → δ} ⟹ Int)} ⟹ β) ≤ Int
//│                           {γ ≤ Int, β ≤ Int, δ ≥ Int} ⟹ ⊥ ≤ Int
//│                             {β ≤ Int, δ ≥ Int} ⟹ ⊥ ≤ Int
//│                               {δ ≥ Int} ⟹ ⊥ ≤ Int
//│                                 Int ≤ δ
//│                                   Int ≤ α
//│                                     Int ≤ Str
//│                           {γ ≤ ¬Int, β ≤ ¬({γ → β → δ ≤ β → β → δ} ⟹ Int)} ⟹ β ≤ Int
//│                             {β ≤ ¬({γ → β → δ ≤ β → β → δ} ⟹ Int)} ⟹ β ≤ Int
//│                               β ≤ ¬({γ → β → δ ≤ β → β → δ} ⟹ Int)
//│                                 γ → β → δ ≤ β → β → δ
//│                                   β ≤ γ
//│                                     β ≤ ¬Int ∧ Int
//│                                       Int ≤ ¬Int ∧ Int
//│                                         Int ≤ ¬Int

:te
r2(1, "Hello")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
//│ Typing error tree:
//│   α ≤ Str → β
//│     γ → δ ≤ Str → β
//│       Str ≤ γ
//│         Str ≤ (¬({ε ≤ Int} ⟹ ⊥) ∧ Int) ∧ (¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≥ γ, ε ≤ ¬Int, ε → γ → δ ≤ γ → γ → δ} ⟹ Int))
//│           Str ≤ ¬({ε ≤ Int} ⟹ ⊥) ∧ Int
//│             Str ≤ ¬({ε ≤ Int} ⟹ ⊥)
//│               ε ≤ Int
//│                 ({ε ≤ Int} ⟹ ⊥) ∨ Int ∨ (({ε ≤ Int, γ ≤ Int, δ ≥ Int} ⟹ ⊥) ∧ ({ε ≤ ¬Int, γ ≤ ¬({ε → γ → δ ≤ γ → γ → δ} ⟹ Int)} ⟹ γ)) ≤ Int
//│                   Int ∨ (({ε ≤ Int, γ ≤ Int, δ ≥ Int} ⟹ ⊥) ∧ ({ε ≤ ¬Int, γ ≤ ¬({ε → γ → δ ≤ γ → γ → δ} ⟹ Int)} ⟹ γ)) ≤ Int
//│                     ({ε ≤ Int, γ ≤ Int, δ ≥ Int} ⟹ ⊥) ∧ ({ε ≤ ¬Int, γ ≤ ¬({ε → γ → δ ≤ γ → γ → δ} ⟹ Int)} ⟹ γ) ≤ Int
//│                       {ε ≤ Int, γ ≤ Int, δ ≥ Int} ⟹ ⊥ ≤ Int
//│                         {γ ≤ Int, δ ≥ Int} ⟹ ⊥ ≤ Int
//│                           γ ≤ Int
//│                             Str ≤ Int
//│                       {ε ≤ ¬Int, γ ≤ ¬({ε → γ → δ ≤ γ → γ → δ} ⟹ Int)} ⟹ γ ≤ Int
//│                         ε ≤ ¬Int
//│                           ({ε ≤ Int} ⟹ ⊥) ∨ Int ∨ (({ε ≤ Int, γ ≤ Int, δ ≥ Int} ⟹ ⊥) ∧ ({ε ≤ ¬Int, γ ≤ ¬({ε → γ → δ ≤ γ → γ → δ} ⟹ Int)} ⟹ γ)) ≤ ¬Int
//│                             Int ∨ (({ε ≤ Int, γ ≤ Int, δ ≥ Int} ⟹ ⊥) ∧ ({ε ≤ ¬Int, γ ≤ ¬({ε → γ → δ ≤ γ → γ → δ} ⟹ Int)} ⟹ γ)) ≤ ¬Int
//│                               Int ≤ ¬Int
