:ctml

:ctml-cfg error-absurd-constred

val nat: Nat
//│ nat: Nat

val int_or_string: Int | Str
//│ int_or_string: Int ∨ Str

// Else branches

// The else branch types the scrutinee at the negation of the pattern, so that a parameter returned
// by the else branch keeps the type of the argument.

fun f1(a) = if a is Int then a + 1 else a
//│ f1: ∀α, β, γ. {γ ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ γ} ⟹ Int), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ γ} ⟹ Int), γ ≥ α, β ≥ ({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ ¬Int} ⟹ γ)} ⟹ α → β

f1(1)
//│ Int

f1("Hello")
//│ Str

f1(int_or_string)
//│ Int ∨ Str

f1(nat)
//│ Int

// A parameter returned by the then branch keeps the type of the argument as well.

fun f2(a) = if a is Int then a else 0
//│ f2: ∀α, β, γ. {γ ≤ ¬({β ≥ γ} ⟹ ¬Int) ∨ ¬({β ≥ Int} ⟹ Int), α ≤ ¬({β ≥ γ} ⟹ ¬Int) ∨ ¬({β ≥ Int} ⟹ Int), γ ≥ α, β ≥ ({γ ≤ Int} ⟹ γ) ∧ ({γ ≤ ¬Int} ⟹ Int)} ⟹ α → β

f2(nat)
//│ Nat

f2("Hello")
//│ Int

// An else branch that uses the scrutinee as an instance of the pattern is dead for every argument,
// so that only the arguments of the pattern are accepted.

fun f3(a) = if a is Int then a + 1 else a + 1
//│ f3: Int → Int

f3(1)
//│ Int

:te
f3("Hello")
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int ≤ Str → α.
//│ Typing error tree:
//│   Int → Int ≤ Str → α
//│     Str ≤ Int

// Multiway matches

fun f4(a) =
  if a is
    Int then a + 1
    Str then a ++ "!"
    Bool then a && true
//│ f4: ∀α, β, γ. {β ≤ ¬({γ ≥ Int} ⟹ ¬Int) ∨ ¬({γ ≥ ({β ≤ Str} ⟹ Str) ∧ ({β ≤ Bool} ⟹ Bool)} ⟹ ¬(¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({γ ≥ Bool} ⟹ ¬Bool))), γ ≥ ({β ≤ Int} ⟹ Int) ∧ ({β ≤ ¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({γ ≥ Bool} ⟹ ¬Bool)} ⟹ ({β ≤ Str} ⟹ Str) ∧ ({β ≤ Bool} ⟹ Bool)), α ≤ ¬({γ ≥ Int} ⟹ ¬Int) ∨ ¬({γ ≥ ({β ≤ Str} ⟹ Str) ∧ ({β ≤ Bool} ⟹ Bool)} ⟹ ¬(¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({γ ≥ Bool} ⟹ ¬Bool))), β ≥ α} ⟹ α → (γ ∨ (({β ≤ Int} ⟹ Int) ∧ ({β ≤ ¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({γ ≥ Bool} ⟹ ¬Bool)} ⟹ ({β ≤ Str} ⟹ Str) ∧ ({β ≤ Bool} ⟹ Bool))))

f4(1)
//│ Int

f4("Hello")
//│ Str

f4(true)
//│ Bool

:te
f4(unit)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {β ≤ ¬({γ ≥ Int} ⟹ ¬Int) ∨ ¬({γ ≥ ({β ≤ Str} ⟹ Str) ∧ ({β ≤ Bool} ⟹ Bool)} ⟹ ¬(¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({γ ≥ Bool} ⟹ ¬Bool))), γ ≥ ({β ≤ Int} ⟹ Int) ∧ ({β ≤ ¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({γ ≥ Bool} ⟹ ¬Bool)} ⟹ ({β ≤ Str} ⟹ Str) ∧ ({β ≤ Bool} ⟹ Bool)), α ≤ ¬({γ ≥ Int} ⟹ ¬Int) ∨ ¬({γ ≥ ({β ≤ Str} ⟹ Str) ∧ ({β ≤ Bool} ⟹ Bool)} ⟹ ¬(¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({γ ≥ Bool} ⟹ ¬Bool))), β ≥ α} ⟹ α → (γ ∨ (({β ≤ Int} ⟹ Int) ∧ ({β ≤ ¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({γ ≥ Bool} ⟹ ¬Bool)} ⟹ ({β ≤ Str} ⟹ Str) ∧ ({β ≤ Bool} ⟹ Bool)))) ≤ Unit → δ.
//│ Typing error tree:
//│   ∀α, β, γ. {β ≤ ¬({γ ≥ Int} ⟹ ¬Int) ∨ ¬({γ ≥ ({β ≤ Str} ⟹ Str) ∧ ({β ≤ Bool} ⟹ Bool)} ⟹ ¬(¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({γ ≥ Bool} ⟹ ¬Bool))), γ ≥ ({β ≤ Int} ⟹ Int) ∧ ({β ≤ ¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({γ ≥ Bool} ⟹ ¬Bool)} ⟹ ({β ≤ Str} ⟹ Str) ∧ ({β ≤ Bool} ⟹ Bool)), α ≤ ¬({γ ≥ Int} ⟹ ¬Int) ∨ ¬({γ ≥ ({β ≤ Str} ⟹ Str) ∧ ({β ≤ Bool} ⟹ Bool)} ⟹ ¬(¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({γ ≥ Bool} ⟹ ¬Bool))), β ≥ α} ⟹ α → (γ ∨ (({β ≤ Int} ⟹ Int) ∧ ({β ≤ ¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({γ ≥ Bool} ⟹ ¬Bool)} ⟹ ({β ≤ Str} ⟹ Str) ∧ ({β ≤ Bool} ⟹ Bool)))) ≤ Unit → δ
//│     {η ≤ ¬({ζ ≥ Int} ⟹ ¬Int) ∨ ¬({ζ ≥ ({η ≤ Str} ⟹ Str) ∧ ({η ≤ Bool} ⟹ Bool)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ζ ≥ Bool} ⟹ ¬Bool))), ζ ≥ ({η ≤ Int} ⟹ Int) ∧ ({η ≤ ¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ζ ≥ Bool} ⟹ ¬Bool)} ⟹ ({η ≤ Str} ⟹ Str) ∧ ({η ≤ Bool} ⟹ Bool)), ε ≤ ¬({ζ ≥ Int} ⟹ ¬Int) ∨ ¬({ζ ≥ ({η ≤ Str} ⟹ Str) ∧ ({η ≤ Bool} ⟹ Bool)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ζ ≥ Bool} ⟹ ¬Bool))), η ≥ ε} ⟹ ε → (ζ ∨ (({η ≤ Int} ⟹ Int) ∧ ({η ≤ ¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ζ ≥ Bool} ⟹ ¬Bool)} ⟹ ({η ≤ Str} ⟹ Str) ∧ ({η ≤ Bool} ⟹ Bool)))) ≤ Unit → δ
//│       {ζ ≥ ({η ≤ Int} ⟹ Int) ∧ ({η ≤ ¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ζ ≥ Bool} ⟹ ¬Bool)} ⟹ ({η ≤ Str} ⟹ Str) ∧ ({η ≤ Bool} ⟹ Bool)), ε ≤ ¬({ζ ≥ Int} ⟹ ¬Int) ∨ ¬({ζ ≥ ({η ≤ Str} ⟹ Str) ∧ ({η ≤ Bool} ⟹ Bool)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ζ ≥ Bool} ⟹ ¬Bool))), η ≥ ε} ⟹ ε → (ζ ∨ (({η ≤ Int} ⟹ Int) ∧ ({η ≤ ¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ζ ≥ Bool} ⟹ ¬Bool)} ⟹ ({η ≤ Str} ⟹ Str) ∧ ({η ≤ Bool} ⟹ Bool)))) ≤ Unit → δ
//│         {ε ≤ ¬({ζ ≥ Int} ⟹ ¬Int) ∨ ¬({ζ ≥ ({η ≤ Str} ⟹ Str) ∧ ({η ≤ Bool} ⟹ Bool)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ζ ≥ Bool} ⟹ ¬Bool))), η ≥ ε} ⟹ ε → (ζ ∨ (({η ≤ Int} ⟹ Int) ∧ ({η ≤ ¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ζ ≥ Bool} ⟹ ¬Bool)} ⟹ ({η ≤ Str} ⟹ Str) ∧ ({η ≤ Bool} ⟹ Bool)))) ≤ Unit → δ
//│           {η ≥ ε} ⟹ ε → (ζ ∨ (({η ≤ Int} ⟹ Int) ∧ ({η ≤ ¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ζ ≥ Bool} ⟹ ¬Bool)} ⟹ ({η ≤ Str} ⟹ Str) ∧ ({η ≤ Bool} ⟹ Bool)))) ≤ Unit → δ
//│             ε → (ζ ∨ (({η ≤ Int} ⟹ Int) ∧ ({η ≤ ¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ζ ≥ Bool} ⟹ ¬Bool)} ⟹ ({η ≤ Str} ⟹ Str) ∧ ({η ≤ Bool} ⟹ Bool)))) ≤ Unit → δ
//│               Unit ≤ ε
//│                 Unit ≤ ¬({ζ ≥ Int} ⟹ ¬Int) ∨ ¬({ζ ≥ ({η ≤ Str} ⟹ Str) ∧ ({η ≤ Bool} ⟹ Bool)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ζ ≥ Bool} ⟹ ¬Bool)))
//│                   Unit ≤ ¬({ζ ≥ Int} ⟹ ¬Int)
//│                     ¬Int ≤ ¬Unit
//│                       Unit ≤ Int
//│                   Unit ≤ ¬({ζ ≥ ({η ≤ Str} ⟹ Str) ∧ ({η ≤ Bool} ⟹ Bool)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ζ ≥ Bool} ⟹ ¬Bool)))
//│                     ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ζ ≥ Bool} ⟹ ¬Bool)) ≤ ¬Unit
//│                       Unit ≤ ¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ζ ≥ Bool} ⟹ ¬Bool)
//│                         Unit ≤ ¬({ζ ≥ Str} ⟹ ¬Str)
//│                           ¬Str ≤ ¬Unit
//│                             Unit ≤ Str
//│                         Unit ≤ ¬({ζ ≥ Bool} ⟹ ¬Bool)
//│                           ¬Bool ≤ ¬Unit
//│                             Unit ≤ Bool

f4 as (Int -> Int) & (Str -> Str) & (Bool -> Bool)
//│ ((Int → Int) ∧ (Str → Str)) ∧ (Bool → Bool)

// Negated patterns

fun f5(a) = if a is ~Int then a else "int"
//│ f5: ∀α, β, γ. {γ ≤ ¬({β ≥ γ} ⟹ Int) ∨ ¬({β ≥ Str} ⟹ ¬Int), α ≤ ¬({β ≥ γ} ⟹ Int) ∨ ¬({β ≥ Str} ⟹ ¬Int), γ ≥ α, β ≥ ({γ ≤ ¬Int} ⟹ γ) ∧ ({γ ≤ Int} ⟹ Str)} ⟹ α → β

f5(1)
//│ Str

f5(true)
//│ Bool

// Nested matches

// A nested match on the same scrutinee is typed under the bound of the enclosing branch: the then
// branch of the inner match is dead, since no value is both an `Int` and a `Str`.

fun f6(a) = if a is Int then (if a is Str then a as Bool else a) else a
//│ f6: ∀α. α → (({α ≤ Int} ⟹ α) ∧ ({α ≤ ¬Int} ⟹ α))

f6(1)
//│ Int

f6("Hello")
//│ Str

// A nested match on a subclass refines the scrutinee further.

fun f7(a) = if a is Int then (if a is Nat then "nat" else a) else unit
//│ f7: ∀α, β, γ. {β ≤ ¬({γ ≥ ({β ≤ Nat} ⟹ Str) ∧ ({β ≤ ¬Nat} ⟹ β)} ⟹ ¬((¬({γ ≥ Str} ⟹ ¬Nat) ∨ ¬Nat) ∧ Int)) ∨ ¬({γ ≥ Unit} ⟹ Int), γ ≥ ({β ≤ (¬({γ ≥ Str} ⟹ ¬Nat) ∨ ¬Nat) ∧ Int} ⟹ ({β ≤ Nat} ⟹ Str) ∧ ({β ≤ ¬Nat} ⟹ β)) ∧ ({β ≤ ¬Int} ⟹ Unit), α ≤ ¬({γ ≥ ({β ≤ Nat} ⟹ Str) ∧ ({β ≤ ¬Nat} ⟹ β)} ⟹ ¬((¬({γ ≥ Str} ⟹ ¬Nat) ∨ ¬Nat) ∧ Int)) ∨ ¬({γ ≥ Unit} ⟹ Int), β ≥ α} ⟹ α → (γ ∨ (({β ≤ (¬({γ ≥ Str} ⟹ ¬Nat) ∨ ¬Nat) ∧ Int} ⟹ ({β ≤ Nat} ⟹ Str) ∧ ({β ≤ ¬Nat} ⟹ β)) ∧ ({β ≤ ¬Int} ⟹ Unit)))

f7(nat)
//│ Str

f7(1)
//│ Str ∨ (Int ∧ ¬Nat)

f7("Hello")
//│ Unit

// Subclass patterns

// A match on a subclass and then on its superclass types the second branch at the difference of
// the classes. An argument of the superclass may take either branch, so that its result is the
// union of the results of both branches.

fun f8(a) =
  if a is
    Nat then "nat"
    Int then 0
//│ f8: ∀α, β. {α ≤ ¬({β ≥ Str} ⟹ ¬Nat) ∨ ¬({β ≥ Int} ⟹ ¬(Int ∧ ¬Nat)), β ≥ ({α ≤ Nat} ⟹ Str) ∧ ({α ≤ Int ∧ ¬Nat} ⟹ Int)} ⟹ α → β

f8(nat)
//│ Str

f8(1)
//│ Str ∨ Int

:te
f8("Hello")
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {α ≤ ¬({β ≥ Str} ⟹ ¬Nat) ∨ ¬({β ≥ Int} ⟹ ¬(Int ∧ ¬Nat)), β ≥ ({α ≤ Nat} ⟹ Str) ∧ ({α ≤ Int ∧ ¬Nat} ⟹ Int)} ⟹ α → β ≤ Str → γ.
//│ Typing error tree:
//│   ∀α, β. {α ≤ ¬({β ≥ Str} ⟹ ¬Nat) ∨ ¬({β ≥ Int} ⟹ ¬(Int ∧ ¬Nat)), β ≥ ({α ≤ Nat} ⟹ Str) ∧ ({α ≤ Int ∧ ¬Nat} ⟹ Int)} ⟹ α → β ≤ Str → γ
//│     {δ ≤ ¬({ε ≥ Str} ⟹ ¬Nat) ∨ ¬({ε ≥ Int} ⟹ ¬(Int ∧ ¬Nat)), ε ≥ ({δ ≤ Nat} ⟹ Str) ∧ ({δ ≤ Int ∧ ¬Nat} ⟹ Int)} ⟹ δ → ε ≤ Str → γ
//│       {ε ≥ ({δ ≤ Nat} ⟹ Str) ∧ ({δ ≤ Int ∧ ¬Nat} ⟹ Int)} ⟹ δ → ε ≤ Str → γ
//│         δ → ε ≤ Str → γ
//│           Str ≤ δ
//│             Str ≤ ¬({ε ≥ Str} ⟹ ¬Nat) ∨ ¬({ε ≥ Int} ⟹ ¬(Int ∧ ¬Nat))
//│               Str ≤ ¬({ε ≥ Str} ⟹ ¬Nat)
//│                 ¬Nat ≤ ¬Str
//│                   Str ≤ Nat
//│               Str ≤ ¬({ε ≥ Int} ⟹ ¬(Int ∧ ¬Nat))
//│                 ¬(Int ∧ ¬Nat) ≤ ¬Str
//│                   Str ≤ Int ∧ ¬Nat
//│                     Str ≤ Int

// Abstract types

// An argument of an abstract type may take either branch, so that it is split by the classes of the
// bound of the parameter.

type T

declare val t: T
//│ t: T

fun f9(a) = if a is Int then 1 else 2
//│ f9: ∀α. α → (({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Int))

:fixme // FIXME: The bound of the parameter is simplified away, so that `T` is not split.
f9(t) as Int
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Int.
//│ Typing error tree:
//│   α ≤ Int
//│     ({β ≤ Int} ⟹ Int) ∧ ({β ≤ ¬Int} ⟹ Int) ≤ Int
//│       {β ≤ Int} ⟹ Int ≤ Int
//│         β ≤ Int
//│           T ≤ Int
//│             ⊤ ≤ Int
//│       {β ≤ ¬Int} ⟹ Int ≤ Int
//│         β ≤ ¬Int
//│           T ≤ ¬Int
//│             ⊤ ≤ ¬Int

fun f10(a) = if a is Int then a else 2
//│ f10: ∀α, β, γ. {γ ≤ ¬({β ≥ γ} ⟹ ¬Int) ∨ ¬({β ≥ Int} ⟹ Int), α ≤ ¬({β ≥ γ} ⟹ ¬Int) ∨ ¬({β ≥ Int} ⟹ Int), γ ≥ α, β ≥ ({γ ≤ Int} ⟹ γ) ∧ ({γ ≤ ¬Int} ⟹ Int)} ⟹ α → β

f10(t)
//│ Int
