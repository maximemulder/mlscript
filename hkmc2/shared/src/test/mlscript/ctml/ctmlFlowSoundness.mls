:ctml

:ctml-cfg error-absurd-constred

// The counterexamples to the soundness of context joins (see the paper and the Lean
// mechanization): each one is a program whose joined bounds would accept an argument that one
// branch rejects.

val int_or_string: Int | Str
//│ int_or_string: Int ∨ Str

// A branch that does not bound a parameter: the joined upper bound of `b` must still reject a `Str`
// when `x` is an `Int` (`t_bad`).

fun tbad(x, b) = if x is Int then b + 1 else 0
//│ tbad: ∀α, β, γ. {α ≤ ¬({β ≤ Int} ⟹ ¬Int) ∨ ¬Int, γ ≥ ({β ≤ Int, α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Int), β ≤ ¬({α ≤ Int} ⟹ ¬Int) ∨ ¬({α ≤ ¬Int} ⟹ ⊥)} ⟹ α → β → γ

tbad(1, 1)
//│ Int

tbad("Hello", "World")
//│ Int

tbad(int_or_string, 1)
//│ Int

:te
tbad(1, "World")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
//│ Typing error tree:
//│   α ≤ Str → β
//│     γ → δ ≤ Str → β
//│       Str ≤ γ
//│         Str ≤ (¬({ε ≤ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬Int} ⟹ ⊥)) ∧ Int
//│           Str ≤ ¬({ε ≤ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬Int} ⟹ ⊥)
//│             Str ≤ ¬({ε ≤ Int} ⟹ ¬Int)
//│               ¬Int ≤ ¬Str
//│                 Str ≤ Int
//│             Str ≤ ¬({ε ≤ ¬Int} ⟹ ⊥)
//│               ε ≤ ¬Int
//│                 Int ≤ ¬Int

:te
tbad(int_or_string, "World")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
//│ Typing error tree:
//│   α ≤ Str → β
//│     (γ → δ) ∨ (ε → ζ) ≤ Str → β
//│       γ → δ ≤ Str → β
//│         Str ≤ γ
//│           Str ≤ (¬({η ≤ Int} ⟹ ¬Int) ∨ ¬({η ≤ ¬Int} ⟹ ⊥)) ∧ Int
//│             Str ≤ ¬({η ≤ Int} ⟹ ¬Int) ∨ ¬({η ≤ ¬Int} ⟹ ⊥)
//│               Str ≤ ¬({η ≤ Int} ⟹ ¬Int)
//│                 ¬Int ≤ ¬Str
//│                   Str ≤ Int
//│               Str ≤ ¬({η ≤ ¬Int} ⟹ ⊥)
//│                 η ≤ ¬Int
//│                   Int ≤ ¬Int

// A scrutinee passed to a function: the function must accept it in the branch that applies it.

fun tpass(x, f) = if x is Int then f(x) else 0
//│ tpass: ∀α, β, γ, δ. {γ ≥ α, α ≤ ¬({β ≤ γ → δ} ⟹ ¬Int) ∨ ¬({δ ≥ Int} ⟹ Int), δ ≥ ({β ≤ γ → δ, γ ≤ Int} ⟹ ⊥) ∧ ({γ ≤ ¬Int} ⟹ Int), β ≤ ¬({γ ≤ Int} ⟹ ¬(γ → δ)) ∨ ¬({γ ≤ ¬Int, δ ≥ Int} ⟹ ⊥), γ ≤ ¬({β ≤ γ → δ} ⟹ ¬Int) ∨ ¬({δ ≥ Int} ⟹ Int)} ⟹ α → β → (δ ∨ (({β ≤ γ → δ, γ ≤ Int} ⟹ ⊥) ∧ ({γ ≤ ¬Int} ⟹ Int)))

tpass(1, (y) => y + 1)
//│ Int

tpass("Hello", (y) => y ++ "!")
//│ Int

:te
tpass(1, (y) => y ++ "!")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ (Str → Str) → β.
//│ Typing error tree:
//│   α ≤ (Str → Str) → β
//│     γ → (δ ∨ (({γ ≤ ε → δ, ε ≤ Int} ⟹ ⊥) ∧ ({ε ≤ ¬Int} ⟹ Int))) ≤ (Str → Str) → β
//│       Str → Str ≤ γ
//│         Str → Str ≤ (¬({ε ≤ Int} ⟹ ¬(ε → δ)) ∨ ¬({ε ≤ ¬Int, δ ≥ Int} ⟹ ⊥)) ∧ (ε → δ)
//│           Str → Str ≤ ¬({ε ≤ Int} ⟹ ¬(ε → δ)) ∨ ¬({ε ≤ ¬Int, δ ≥ Int} ⟹ ⊥)
//│             Str → Str ≤ ¬({ε ≤ Int} ⟹ ¬(ε → δ))
//│               ¬(ε → δ) ≤ ¬(Str → Str)
//│                 Str → Str ≤ ε → δ
//│                   ε ≤ Str
//│                     ζ ≤ Str
//│                       Int ≤ Str
//│             Str → Str ≤ ¬({ε ≤ ¬Int, δ ≥ Int} ⟹ ⊥)
//│               ε ≤ ¬Int
//│                 ζ ≤ ¬Int
//│                   Int ≤ ¬Int

:te
tpass(int_or_string, (y) => y ++ "!")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ (Str → Str) → β.
//│ Typing error tree:
//│   α ≤ (Str → Str) → β
//│     (γ → (δ ∨ (({γ ≤ ε → δ, ε ≤ Int} ⟹ ⊥) ∧ ({ε ≤ ¬Int} ⟹ Int)))) ∨ (ζ → (η ∨ (({ζ ≤ θ → η, θ ≤ Int} ⟹ ⊥) ∧ ({θ ≤ ¬Int} ⟹ Int)))) ≤ (Str → Str) → β
//│       γ → (δ ∨ (({γ ≤ ε → δ, ε ≤ Int} ⟹ ⊥) ∧ ({ε ≤ ¬Int} ⟹ Int))) ≤ (Str → Str) → β
//│         Str → Str ≤ γ
//│           Str → Str ≤ (¬({ε ≤ Int} ⟹ ¬(ε → δ)) ∨ ¬({ε ≤ ¬Int, δ ≥ Int} ⟹ ⊥)) ∧ (ε → δ)
//│             Str → Str ≤ ¬({ε ≤ Int} ⟹ ¬(ε → δ)) ∨ ¬({ε ≤ ¬Int, δ ≥ Int} ⟹ ⊥)
//│               Str → Str ≤ ¬({ε ≤ Int} ⟹ ¬(ε → δ))
//│                 ¬(ε → δ) ≤ ¬(Str → Str)
//│                   Str → Str ≤ ε → δ
//│                     ε ≤ Str
//│                       ι ≤ Str
//│                         Int ≤ Str
//│               Str → Str ≤ ¬({ε ≤ ¬Int, δ ≥ Int} ⟹ ⊥)
//│                 ε ≤ ¬Int
//│                   ι ≤ ¬Int
//│                     Int ≤ ¬Int

// A nested match decided by the bound of the enclosing branch (`t_sel`).

fun tsel(a, b) = if a is Int then (if b is Int then 1 else (a as Str)) else 1
//│ tsel: ∀α, β, γ, δ. {γ ≥ α, α ≤ ¬({β ≤ ¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({γ ≤ Str, δ ≥ Str} ⟹ Int), δ ≥ ({β ≤ Int} ⟹ Int) ∧ ({γ ≤ Str, β ≤ ¬Int} ⟹ Str)} ⟹ ¬((¬({β ≤ Int, δ ≥ Int} ⟹ ⊥) ∨ ¬({β ≤ ¬Int, δ ≥ Str} ⟹ ¬Str)) ∧ Int)) ∨ ¬({δ ≥ Int} ⟹ Int), δ ≥ ({β ≤ ¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({γ ≤ Str, δ ≥ Str} ⟹ Int), γ ≤ (¬({β ≤ Int, δ ≥ Int} ⟹ ⊥) ∨ ¬({β ≤ ¬Int, δ ≥ Str} ⟹ ¬Str)) ∧ Int} ⟹ ({β ≤ Int} ⟹ Int) ∧ ({γ ≤ Str, β ≤ ¬Int} ⟹ Str)) ∧ ({γ ≤ ¬Int} ⟹ Int), β ≤ ¬({γ ≤ (¬({β ≤ Int, δ ≥ Int} ⟹ ⊥) ∨ ¬({β ≤ ¬Int, δ ≥ Str} ⟹ ¬Str)) ∧ Int, δ ≥ ({β ≤ Int} ⟹ Int) ∧ ({γ ≤ Str, β ≤ ¬Int} ⟹ Str)} ⟹ ¬(¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({γ ≤ Str, δ ≥ Str} ⟹ Int))) ∨ ¬({γ ≤ ¬Int, δ ≥ Int} ⟹ ⊥), γ ≤ ¬({β ≤ ¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({γ ≤ Str, δ ≥ Str} ⟹ Int), δ ≥ ({β ≤ Int} ⟹ Int) ∧ ({γ ≤ Str, β ≤ ¬Int} ⟹ Str)} ⟹ ¬((¬({β ≤ Int, δ ≥ Int} ⟹ ⊥) ∨ ¬({β ≤ ¬Int, δ ≥ Str} ⟹ ¬Str)) ∧ Int)) ∨ ¬({δ ≥ Int} ⟹ Int)} ⟹ α → β → (δ ∨ (({β ≤ ¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({γ ≤ Str, δ ≥ Str} ⟹ Int), γ ≤ (¬({β ≤ Int, δ ≥ Int} ⟹ ⊥) ∨ ¬({β ≤ ¬Int, δ ≥ Str} ⟹ ¬Str)) ∧ Int} ⟹ ({β ≤ Int} ⟹ Int) ∧ ({γ ≤ Str, β ≤ ¬Int} ⟹ Str)) ∧ ({γ ≤ ¬Int} ⟹ Int)))

tsel(1, 1)
//│ Int

tsel("Hello", "World")
//│ Int

:te
tsel(1, "World")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
//│ Typing error tree:
//│   α ≤ Str → β
//│     γ → (δ ∨ (({γ ≤ ¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, δ ≥ Str} ⟹ Int), ε ≤ (¬({γ ≤ Int, δ ≥ Int} ⟹ ⊥) ∨ ¬({γ ≤ ¬Int, δ ≥ Str} ⟹ ¬Str)) ∧ Int} ⟹ ({γ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, γ ≤ ¬Int} ⟹ Str)) ∧ ({ε ≤ ¬Int} ⟹ Int))) ≤ Str → β
//│       Str ≤ γ
//│         Str ≤ ((¬({ε ≤ (¬({γ ≤ Int, δ ≥ Int} ⟹ ⊥) ∨ ¬({γ ≤ ¬Int, δ ≥ Str} ⟹ ¬Str)) ∧ Int, δ ≥ ({γ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, γ ≤ ¬Int} ⟹ Str)} ⟹ ¬(¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, δ ≥ Str} ⟹ Int))) ∨ ¬({ε ≤ ¬Int, δ ≥ Int} ⟹ ⊥)) ∧ (¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, δ ≥ Str} ⟹ Int))) ∧ Int
//│           Str ≤ (¬({ε ≤ (¬({γ ≤ Int, δ ≥ Int} ⟹ ⊥) ∨ ¬({γ ≤ ¬Int, δ ≥ Str} ⟹ ¬Str)) ∧ Int, δ ≥ ({γ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, γ ≤ ¬Int} ⟹ Str)} ⟹ ¬(¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, δ ≥ Str} ⟹ Int))) ∨ ¬({ε ≤ ¬Int, δ ≥ Int} ⟹ ⊥)) ∧ (¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, δ ≥ Str} ⟹ Int))
//│             Str ≤ ¬({ε ≤ (¬({γ ≤ Int, δ ≥ Int} ⟹ ⊥) ∨ ¬({γ ≤ ¬Int, δ ≥ Str} ⟹ ¬Str)) ∧ Int, δ ≥ ({γ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, γ ≤ ¬Int} ⟹ Str)} ⟹ ¬(¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, δ ≥ Str} ⟹ Int))) ∨ ¬({ε ≤ ¬Int, δ ≥ Int} ⟹ ⊥)
//│               Str ≤ ¬({ε ≤ (¬({γ ≤ Int, δ ≥ Int} ⟹ ⊥) ∨ ¬({γ ≤ ¬Int, δ ≥ Str} ⟹ ¬Str)) ∧ Int, δ ≥ ({γ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, γ ≤ ¬Int} ⟹ Str)} ⟹ ¬(¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, δ ≥ Str} ⟹ Int)))
//│                 {δ ≥ ({γ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, γ ≤ ¬Int} ⟹ Str)} ⟹ ¬(¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, δ ≥ Str} ⟹ Int)) ≤ ¬Str
//│                   ¬(¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, δ ≥ Str} ⟹ Int)) ≤ ¬Str
//│                     Str ≤ ¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ Str, δ ≥ Str} ⟹ Int)
//│                       Str ≤ ¬({δ ≥ Int} ⟹ ¬Int)
//│                         ¬Int ≤ ¬Str
//│                           Str ≤ Int
//│                       Str ≤ ¬({ε ≤ Str, δ ≥ Str} ⟹ Int)
//│                         ε ≤ Str
//│                           ζ ≤ Str
//│                             Int ≤ Str
//│               Str ≤ ¬({ε ≤ ¬Int, δ ≥ Int} ⟹ ⊥)
//│                 ε ≤ ¬Int
//│                   ζ ≤ ¬Int
//│                     Int ≤ ¬Int
