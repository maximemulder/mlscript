//│                   {ε ≤ ¬({γ ≤ Str, ζ ≥ Str} ⟹ ⊥) ∧ ¬Int, δ ≥ ζ, ζ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Int
//│                     {δ ≥ ζ, ζ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Int
//│                       {ζ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Int
//│                         ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Int
//│                           Int ≤ ¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)
//│                             Int ≤ ¬({ζ ≥ Str} ⟹ ¬Str)
//│                               {ζ ≥ Str} ⟹ ¬Str ≤ ¬Int
//│                                 ¬Str ≤ ¬Int
//│                                   Int ≤ Str
//│                             Int ≤ ¬({ε ≤ ⊥} ⟹ ⊥)
//│                               {ε ≤ ⊥} ⟹ ⊥ ≤ ¬Int
//│                                 ε ≤ ⊥
//│                                   Bool ≤ ⊥

:te
foo(true, true)
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Bool → β.
//│ Typing error tree:
//│   α ≤ Bool → β
//│     γ → δ ≤ Bool → β
//│       Bool ≤ γ
//│         Bool ≤ ((¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({γ ≤ Str, ζ ≥ Str} ⟹ ⊥) ∧ ¬Int, δ ≥ ζ, ζ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))) ∧ (¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥))) ∧ Str
//│           Bool ≤ (¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∧ (¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥))) ∧ Str
//│             Bool ≤ (¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∧ ¬({ζ ≥ Str} ⟹ ¬Str)) ∧ Str
//│               Bool ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∧ ¬({ζ ≥ Str} ⟹ ¬Str)
