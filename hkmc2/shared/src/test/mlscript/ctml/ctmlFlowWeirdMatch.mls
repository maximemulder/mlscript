//│                                   Bool ≤ ⊥

:te
foo(1, "World")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
//│ Typing error tree:
//│   α ≤ Str → β
//│     γ → δ ≤ Str → β
//│       Str ≤ γ
//│         Str ≤ (¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({γ ≤ Str, ζ ≥ Str} ⟹ ⊥) ∧ ¬Int, δ ≥ ζ, ζ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))) ∧ Int
//│           Str ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∧ Int
//│             Str ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int)
//│               {ε ≤ Int, δ ≥ Int} ⟹ ¬Int ≤ ¬Str
//│                 {δ ≥ Int} ⟹ ¬Int ≤ ¬Str
//│                   ¬Int ≤ ¬Str
//│                     Str ≤ Int
//│           Str ≤ ¬({ε ≤ ¬({γ ≤ Str, ζ ≥ Str} ⟹ ⊥) ∧ ¬Int, δ ≥ ζ, ζ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥))) ∧ Int
//│             Str ≤ ¬({ε ≤ ¬({γ ≤ Str, ζ ≥ Str} ⟹ ⊥) ∧ ¬Int, δ ≥ ζ, ζ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))
//│               {ε ≤ ¬({γ ≤ Str, ζ ≥ Str} ⟹ ⊥) ∧ ¬Int, δ ≥ ζ, ζ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Str
//│                 ε ≤ ¬({γ ≤ Str, ζ ≥ Str} ⟹ ⊥) ∧ ¬Int
//│                   Int ≤ ¬({γ ≤ Str, ζ ≥ Str} ⟹ ⊥) ∧ ¬Int
//│                     Int ≤ ¬Int
