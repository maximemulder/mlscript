:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence arbitrary-patterns

// Function definitions

fun foo(a, b) =
  if a is
    Int then b as Int
    Top then b as Str
//│ foo: ∀α, β, γ. {β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ ¬({β ≤ Str, γ ≥ Str} ⟹ ⊥) ∧ ¬Int, γ ≥ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({α ≤ ⊥} ⟹ ⊥))), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({β ≤ ¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({α ≤ ⊥} ⟹ ⊥), γ ≥ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({β ≤ Str, γ ≥ Str} ⟹ ⊥) ∧ ¬Int)), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ ¬({β ≤ Str, γ ≥ Str} ⟹ ⊥) ∧ ¬Int, β ≤ ¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({α ≤ ⊥} ⟹ ⊥)} ⟹ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥))} ⟹ α → β → γ

// FIXME: The inferred type is not simplified to `Int → Int → Int`, and the block takes several
// seconds: the simplification of the level of `bar` checks intersections of constrained types,
// and each check explores every alternative of the unions of constraining types in their guards,
// which nest deeply. Splitting right intersections before right unions (see `subtypeImpl`) makes
// this exploration linear in the number of unions of an intersection, but the rules of left
// intersections and right unions also run subtyping checks of their own (in `meetMerge`,
// `subtractStep` and `joinMerge`), which nest in each other and explore these alternatives again.
fun bar(a, b) =
  foo(a, b) as Int
//│ bar: ∀α, β, γ, δ. {δ ≤ Int, α ≤ ¬({γ ≤ Int, δ ≥ Int} ⟹ ¬Int) ∧ ¬({β ≤ Int, γ ≤ Int} ⟹ ¬Int), γ ≤ (¬({β ≤ Int} ⟹ ¬Int) ∧ ¬({δ ≥ Int} ⟹ ¬Int)) ∨ (¬({α ≤ ⊥} ⟹ ⊥) ∧ ¬({δ ≥ Int} ⟹ ¬Int)), β ≤ (¬({γ ≤ Int} ⟹ ¬Int) ∧ ¬({δ ≥ Int} ⟹ ¬Int)) ∨ (¬({α ≤ ⊥} ⟹ ⊥) ∧ ¬({δ ≥ Int} ⟹ ¬Int)), γ ≥ β, δ ≥ {γ ≤ Int} ⟹ Int} ⟹ α → β → Int

// Function overloads

foo as (Int -> Int -> Int) & (Str -> Str -> Str)
//│ (Int → Int → Int) ∧ (Str → Str → Str)

// Function applications

foo(1, 1)
//│ Int

// Times out if right unions are split before right intersections (see `subtypeImpl`).
foo(1, 1) as Int
//│ Int

foo("Hello", "World")
//│ Str

foo(true, "")
//│ Str

foo(bot, bot)
//│ ∀α, β, γ, δ. {γ ≤ δ, δ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ ¬({β ≤ Str, γ ≥ Str} ⟹ ⊥) ∧ ¬Int, β ≤ ¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({α ≤ ⊥} ⟹ ⊥)} ⟹ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ ¬({β ≤ Str, γ ≥ Str} ⟹ ⊥) ∧ ¬Int, β ≤ ¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({α ≤ ⊥} ⟹ ⊥)} ⟹ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({β ≤ ¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({α ≤ ⊥} ⟹ ⊥), γ ≥ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({β ≤ Str, γ ≥ Str} ⟹ ⊥) ∧ ¬Int)), β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ ¬({β ≤ Str, γ ≥ Str} ⟹ ⊥) ∧ ¬Int, γ ≥ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({α ≤ ⊥} ⟹ ⊥)))} ⟹ δ

// Errors

:te
foo as (Bool -> Bool -> Bool)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ ¬({β ≤ Str, γ ≥ Str} ⟹ ⊥) ∧ ¬Int, γ ≥ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({α ≤ ⊥} ⟹ ⊥))), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({β ≤ ¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({α ≤ ⊥} ⟹ ⊥), γ ≥ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({β ≤ Str, γ ≥ Str} ⟹ ⊥) ∧ ¬Int)), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ ¬({β ≤ Str, γ ≥ Str} ⟹ ⊥) ∧ ¬Int, β ≤ ¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({α ≤ ⊥} ⟹ ⊥)} ⟹ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥))} ⟹ α → β → γ ≤ Bool → Bool → Bool.
//│ Typing error tree:
//│   ∀α, β, γ. {β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ ¬({β ≤ Str, γ ≥ Str} ⟹ ⊥) ∧ ¬Int, γ ≥ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({α ≤ ⊥} ⟹ ⊥))), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({β ≤ ¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({α ≤ ⊥} ⟹ ⊥), γ ≥ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({β ≤ Str, γ ≥ Str} ⟹ ⊥) ∧ ¬Int)), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ ¬({β ≤ Str, γ ≥ Str} ⟹ ⊥) ∧ ¬Int, β ≤ ¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({α ≤ ⊥} ⟹ ⊥)} ⟹ ({β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥))} ⟹ α → β → γ ≤ Bool → Bool → Bool
//│     {ε ≤ ¬({δ ≤ Int, ζ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≤ ¬({ε ≤ Str, ζ ≥ Str} ⟹ ⊥) ∧ ¬Int, ζ ≥ ({ε ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({δ ≤ ⊥} ⟹ ⊥))), δ ≤ ¬({ε ≤ Int, ζ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({δ ≤ ⊥} ⟹ ⊥), ζ ≥ ({ε ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({ε ≤ Str, ζ ≥ Str} ⟹ ⊥) ∧ ¬Int)), ζ ≥ ({δ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({δ ≤ ¬({ε ≤ Str, ζ ≥ Str} ⟹ ⊥) ∧ ¬Int, ε ≤ ¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({δ ≤ ⊥} ⟹ ⊥)} ⟹ ({ε ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥))} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│       {δ ≤ ¬({ε ≤ Int, ζ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({δ ≤ ⊥} ⟹ ⊥), ζ ≥ ({ε ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({ε ≤ Str, ζ ≥ Str} ⟹ ⊥) ∧ ¬Int)), ζ ≥ ({δ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({δ ≤ ¬({ε ≤ Str, ζ ≥ Str} ⟹ ⊥) ∧ ¬Int, ε ≤ ¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({δ ≤ ⊥} ⟹ ⊥)} ⟹ ({ε ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥))} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│         {ζ ≥ ({δ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({δ ≤ ¬({ε ≤ Str, ζ ≥ Str} ⟹ ⊥) ∧ ¬Int, ε ≤ ¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({δ ≤ ⊥} ⟹ ⊥)} ⟹ ({ε ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥))} ⟹ δ → ε → ζ ≤ Bool → Bool → Bool
//│           δ → ε → ζ ≤ Bool → Bool → Bool
//│             ε → ζ ≤ Bool → Bool
//│               Bool ≤ ε
//│                 Bool ≤ ((¬({δ ≤ Int, ζ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≤ ¬({ε ≤ Str, ζ ≥ Str} ⟹ ⊥) ∧ ¬Int, ζ ≥ ({ε ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({δ ≤ ⊥} ⟹ ⊥)))) ∧ (¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({δ ≤ ⊥} ⟹ ⊥))) ∧ Str
//│                   Bool ≤ (¬({δ ≤ Int, ζ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≤ ¬({ε ≤ Str, ζ ≥ Str} ⟹ ⊥) ∧ ¬Int, ζ ≥ ({ε ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({δ ≤ ⊥} ⟹ ⊥)))) ∧ (¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({δ ≤ ⊥} ⟹ ⊥))
//│                     Bool ≤ ¬({δ ≤ Int, ζ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≤ ¬({ε ≤ Str, ζ ≥ Str} ⟹ ⊥) ∧ ¬Int, ζ ≥ ({ε ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({δ ≤ ⊥} ⟹ ⊥)))
//│                       Bool ≤ ¬({δ ≤ Int, ζ ≥ Int} ⟹ ¬Int)
//│                         {δ ≤ Int, ζ ≥ Int} ⟹ ¬Int ≤ ¬Bool
//│                           δ ≤ Int
//│                             Bool ≤ Int
//│                       Bool ≤ ¬({δ ≤ ¬({ε ≤ Str, ζ ≥ Str} ⟹ ⊥) ∧ ¬Int, ζ ≥ ({ε ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({δ ≤ ⊥} ⟹ ⊥)))
//│                         {δ ≤ ¬({ε ≤ Str, ζ ≥ Str} ⟹ ⊥) ∧ ¬Int, ζ ≥ ({ε ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({δ ≤ ⊥} ⟹ ⊥)) ≤ ¬Bool
//│                           {ζ ≥ ({ε ≤ Str} ⟹ Str) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({δ ≤ ⊥} ⟹ ⊥)) ≤ ¬Bool
//│                             ¬(¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({δ ≤ ⊥} ⟹ ⊥)) ≤ ¬Bool
//│                               Bool ≤ ¬({ζ ≥ Str} ⟹ ¬Str) ∨ ¬({δ ≤ ⊥} ⟹ ⊥)
//│                                 Bool ≤ ¬({ζ ≥ Str} ⟹ ¬Str)
//│                                   {ζ ≥ Str} ⟹ ¬Str ≤ ¬Bool
//│                                     ¬Str ≤ ¬Bool
//│                                       Bool ≤ Str
//│                                 Bool ≤ ¬({δ ≤ ⊥} ⟹ ⊥)
//│                                   {δ ≤ ⊥} ⟹ ⊥ ≤ ¬Bool
//│                                     δ ≤ ⊥
//│                                       Bool ≤ ⊥

:te
foo(true, 1)
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Int → β.
//│ Typing error tree:
//│   α ≤ Int → β
//│     γ → δ ≤ Int → β
//│       Int ≤ γ
//│         Int ≤ ((¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ⊥) ∧ ¬Int, δ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))) ∧ (¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥))) ∧ Str
//│           Int ≤ (¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ⊥) ∧ ¬Int, δ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))) ∧ (¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥))
//│             Int ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ⊥) ∧ ¬Int, δ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))
//│               Int ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int)
//│                 {ε ≤ Int, δ ≥ Int} ⟹ ¬Int ≤ ¬Int
//│                   ε ≤ Int
//│                     Bool ≤ Int
//│               Int ≤ ¬({ε ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ⊥) ∧ ¬Int, δ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))
//│                 {ε ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ⊥) ∧ ¬Int, δ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Int
//│                   {δ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Int
//│                     ¬(¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Int
//│                       Int ≤ ¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)
//│                         Int ≤ ¬({δ ≥ Str} ⟹ ¬Str)
//│                           {δ ≥ Str} ⟹ ¬Str ≤ ¬Int
//│                             ¬Str ≤ ¬Int
//│                               Int ≤ Str
//│                         Int ≤ ¬({ε ≤ ⊥} ⟹ ⊥)
//│                           {ε ≤ ⊥} ⟹ ⊥ ≤ ¬Int
//│                             ε ≤ ⊥
//│                               Bool ≤ ⊥

:te
foo(true, true)
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Bool → β.
//│ Typing error tree:
//│   α ≤ Bool → β
//│     γ → δ ≤ Bool → β
//│       Bool ≤ γ
//│         Bool ≤ ((¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ⊥) ∧ ¬Int, δ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))) ∧ (¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥))) ∧ Str
//│           Bool ≤ (¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ⊥) ∧ ¬Int, δ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))) ∧ (¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥))
//│             Bool ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ⊥) ∧ ¬Int, δ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))
//│               Bool ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int)
//│                 {ε ≤ Int, δ ≥ Int} ⟹ ¬Int ≤ ¬Bool
//│                   ε ≤ Int
//│                     Bool ≤ Int
//│               Bool ≤ ¬({ε ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ⊥) ∧ ¬Int, δ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))
//│                 {ε ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ⊥) ∧ ¬Int, δ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Bool
//│                   {δ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Bool
//│                     ¬(¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Bool
//│                       Bool ≤ ¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)
//│                         Bool ≤ ¬({δ ≥ Str} ⟹ ¬Str)
//│                           {δ ≥ Str} ⟹ ¬Str ≤ ¬Bool
//│                             ¬Str ≤ ¬Bool
//│                               Bool ≤ Str
//│                         Bool ≤ ¬({ε ≤ ⊥} ⟹ ⊥)
//│                           {ε ≤ ⊥} ⟹ ⊥ ≤ ¬Bool
//│                             ε ≤ ⊥
//│                               Bool ≤ ⊥

:te
foo(1, "World")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
//│ Typing error tree:
//│   α ≤ Str → β
//│     γ → δ ≤ Str → β
//│       Str ≤ γ
//│         Str ≤ (¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ⊥) ∧ ¬Int, δ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))) ∧ Int
//│           Str ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ⊥) ∧ ¬Int, δ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))
//│             Str ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int)
//│               {ε ≤ Int, δ ≥ Int} ⟹ ¬Int ≤ ¬Str
//│                 {δ ≥ Int} ⟹ ¬Int ≤ ¬Str
//│                   ¬Int ≤ ¬Str
//│                     Str ≤ Int
//│             Str ≤ ¬({ε ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ⊥) ∧ ¬Int, δ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))
//│               {ε ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ⊥) ∧ ¬Int, δ ≥ ({γ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥)} ⟹ ¬(¬({δ ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Str
//│                 ε ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ⊥) ∧ ¬Int
//│                   Int ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ⊥) ∧ ¬Int
//│                     Int ≤ ¬Int
