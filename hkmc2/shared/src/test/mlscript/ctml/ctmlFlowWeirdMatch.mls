//│     γ → δ ≤ Int → β
//│       Int ≤ γ
//│         Int ≤ (¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({γ ≤ Str, ζ ≥ Str} ⟹ ⊥), δ ≥ ζ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))) ∧ Str
//│           Int ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∧ Str
//│             Int ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int)
//│               {ε ≤ Int, δ ≥ Int} ⟹ ¬Int ≤ ¬Int
//│                 ε ≤ Int
//│                   Bool ≤ Int
//│           Int ≤ ¬({ε ≤ ¬({γ ≤ Str, ζ ≥ Str} ⟹ ⊥), δ ≥ ζ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥))) ∧ Str
//│             Int ≤ ¬({ε ≤ ¬({γ ≤ Str, ζ ≥ Str} ⟹ ⊥), δ ≥ ζ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))
//│               {ε ≤ ¬({γ ≤ Str, ζ ≥ Str} ⟹ ⊥), δ ≥ ζ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Int
//│                 {δ ≥ ζ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Int
//│                   ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Int
//│                     Int ≤ Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)
//│                       Int ≤ Str
//│                       Int ≤ ¬({ε ≤ ⊥} ⟹ ⊥)
//│                         {ε ≤ ⊥} ⟹ ⊥ ≤ ¬Int
//│                           ε ≤ ⊥
//│                             Bool ≤ ⊥

:te
foo(true, true)
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Bool → β.
//│ Typing error tree:
//│   α ≤ Bool → β
//│     γ → δ ≤ Bool → β
//│       Bool ≤ γ
//│         Bool ≤ (¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({γ ≤ Str, ζ ≥ Str} ⟹ ⊥), δ ≥ ζ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))) ∧ Str
//│           Bool ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∧ Str
//│             Bool ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int)
//│               {ε ≤ Int, δ ≥ Int} ⟹ ¬Int ≤ ¬Bool
//│                 ε ≤ Int
//│                   Bool ≤ Int
//│           Bool ≤ ¬({ε ≤ ¬({γ ≤ Str, ζ ≥ Str} ⟹ ⊥), δ ≥ ζ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥))) ∧ Str
//│             Bool ≤ ¬({ε ≤ ¬({γ ≤ Str, ζ ≥ Str} ⟹ ⊥), δ ≥ ζ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))
//│               {ε ≤ ¬({γ ≤ Str, ζ ≥ Str} ⟹ ⊥), δ ≥ ζ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Bool
//│                 {δ ≥ ζ} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Bool
//│                   ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Bool
//│                     Bool ≤ Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)
//│                       Bool ≤ Str
//│                       Bool ≤ ¬({ε ≤ ⊥} ⟹ ⊥)
//│                         {ε ≤ ⊥} ⟹ ⊥ ≤ ¬Bool
//│                           ε ≤ ⊥
//│                             Bool ≤ ⊥

:te
foo(1, "World")
//│ Str
//│ FAILURE: Unexpected lack of type error
