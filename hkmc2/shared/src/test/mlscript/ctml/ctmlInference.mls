:ctml

declare class A
declare class B
declare class C

declare val a: A
//│ a: A

declare val b: B
//│ b: B

declare val c: C
//│ c: C

declare val d: A | B
//│ d: A ∨ B

declare val e: A & B
//│ e: A ∧ B

declare val foo: (A -> A) & (B -> B)
//│ foo: (A → A) ∧ (B → B)

foo(a)
//│ A

foo(b)
//│ B

:e
foo(c)
//│ B
//│ FAILURE: Unexpected lack of type error

foo(d)
//│ A ∨ B

foo(e)
//│ A ∨ B
