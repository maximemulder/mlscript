:ctml

:ctml-cfg error-absurd-constred no-wrap-ifs

// A direct split lets its joined bounds reach the enclosing source lambda.

fun direct(a) = if a is Int then 1 else "s"
//│ direct: ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Str), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ Int)} ⟹ α → β

// An unused-parameter wrapper packages the same bounds at a local lambda application.

fun dummy(a) = (u => (if a is Int then 1 else "s"))(unit)
//│ dummy: ∀α, β. {α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ Int), β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Str)} ⟹ α → β

direct(1) as Int
//│ Int

dummy(1) as Int
//│ Int

direct("s") as Str
//│ Str

dummy("s") as Str
//│ Str

dummy as (Int -> Int) & (Str -> Str)
//│ (Int → Int) ∧ (Str → Str)

:te
dummy as (Int -> Str)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ Int), β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Str)} ⟹ α → β ≤ Int → Str.
//│ Typing error tree:
//│   ∀α, β. {α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬({β ≥ Str} ⟹ Int), β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Str)} ⟹ α → β ≤ Int → Str
//│     {γ ≤ ¬({δ ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≥ Str} ⟹ Int), δ ≥ ({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ ¬Int} ⟹ Str)} ⟹ γ → δ ≤ Int → Str
//│       {δ ≥ ({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ ¬Int} ⟹ Str)} ⟹ γ → δ ≤ Int → Str
//│         γ → δ ≤ Int → Str
//│           δ ≤ Str
//│             (({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ ¬Int} ⟹ Str)) ∨ Int ≤ Str
//│               ({γ ≤ Int} ⟹ Int) ∧ ({γ ≤ ¬Int} ⟹ Str) ≤ Str
//│                 {γ ≤ Int} ⟹ Int ≤ Str
//│                   Int ≤ Str
//│                 {γ ≤ ¬Int} ⟹ Str ≤ Str
//│                   γ ≤ ¬Int
//│                     Int ≤ ¬Int

// Wrapping retains the correlation between a tested argument and a different argument.

fun correlated(a, b) = (u => (if a is Int then (b as Int) else (b as Str)))(unit)
//│ correlated: ∀α, β, γ. {γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int, β ≤ Str} ⟹ Str), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({β ≤ Str, γ ≥ Str} ⟹ Int), β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ ¬Int, γ ≥ Str} ⟹ ¬Str)} ⟹ α → β → γ

correlated(1, 1) as Int
//│ Int

correlated("s", "s") as Str
//│ Str

:te
correlated(1, "s")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
//│ Typing error tree:
//│   α ≤ Str → β
//│     γ → δ ≤ Str → β
//│       Str ≤ γ
//│         Str ≤ (¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬Int, δ ≥ Str} ⟹ ¬Str)) ∧ Int
//│           Str ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬Int, δ ≥ Str} ⟹ ¬Str)
//│             Str ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int)
//│               {δ ≥ Int} ⟹ ¬Int ≤ ¬Str
//│                 ¬Int ≤ ¬Str
//│                   Str ≤ Int
//│             Str ≤ ¬({ε ≤ ¬Int, δ ≥ Str} ⟹ ¬Str)
//│               ε ≤ ¬Int
//│                 Int ≤ ¬Int

val intOrStr: Int | Str
//│ intOrStr: Int ∨ Str

:te
correlated((1 as Int | Str), ("s" as Int | Str))
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ (Int ∨ Str) → β.
//│ Typing error tree:
//│   α ≤ (Int ∨ Str) → β
//│     (γ → δ) ∨ (ε → ζ) ≤ (Int ∨ Str) → β
//│       γ → δ ≤ (Int ∨ Str) → β
//│         Int ∨ Str ≤ γ
//│           Int ∨ Str ≤ (¬({η ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({η ≤ ¬Int, δ ≥ Str} ⟹ ¬Str)) ∧ Int
//│             Str ≤ (¬({η ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({η ≤ ¬Int, δ ≥ Str} ⟹ ¬Str)) ∧ Int
//│               Str ≤ ¬({η ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({η ≤ ¬Int, δ ≥ Str} ⟹ ¬Str)
//│                 Str ≤ ¬({η ≤ Int, δ ≥ Int} ⟹ ¬Int)
//│                   {δ ≥ Int} ⟹ ¬Int ≤ ¬Str
//│                     ¬Int ≤ ¬Str
//│                       Str ≤ Int
//│                 Str ≤ ¬({η ≤ ¬Int, δ ≥ Str} ⟹ ¬Str)
//│                   η ≤ ¬Int
//│                     Int ≤ ¬Int

// A let-bound wrapped function can be instantiated at both branch types.

fun both(x) =
  let f = a => (u => (if a is Int then (a as Int) else (a as Str)))(unit)
  (f(1), f("s"))
//│ both: ⊤ → ⟨Int, Str⟩

both(unit)
//│ ⟨Int, Str⟩

// An unused wrapper does not give a concrete union scrutinee a refinable type variable.

:fixme // FIXME: Dummy wrapping cannot infer the valid match of a concrete union scrutinee.
(u => (if intOrStr is Int then 1 else "s"))(unit)
//│ ═══[TYPE ERROR] Cannot solve judgment Int ∨ Str ≤ Int.
//│ Typing error tree:
//│   Int ∨ Str ≤ Int
//│     Str ≤ Int

// Rebinding the scrutinee supplies that variable and refines its branch occurrences.

(a => (if a is Int then (a as Int) else (a as Str)))(intOrStr)
//│ Int ∨ Str

// A nested wrapped split rejects a caller that enters its explicit absurd branch.

fun nested(a, b) =
  (u => (if a is Int then (v => (if b is Int then 1 else (b as Bot)))(unit) else 1))(unit)
//│ nested: ∀α, β, γ. {γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ Int), α ≤ ¬({β ≤ Int} ⟹ ¬Int) ∨ ¬Int, β ≤ ¬({α ≤ Int} ⟹ ¬Int) ∨ ¬({α ≤ ¬Int} ⟹ ⊥)} ⟹ α → β → γ

nested(1, 1) as Int
//│ Int

nested("s", true) as Int
//│ Int

:te
nested(1, true)
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Bool → β.
//│ Typing error tree:
//│   α ≤ Bool → β
//│     γ → δ ≤ Bool → β
//│       Bool ≤ γ
//│         Bool ≤ (¬({ε ≤ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬Int} ⟹ ⊥)) ∧ Int
//│           Bool ≤ ¬({ε ≤ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬Int} ⟹ ⊥)
//│             Bool ≤ ¬({ε ≤ Int} ⟹ ¬Int)
//│               ¬Int ≤ ¬Bool
//│                 Bool ≤ Int
//│             Bool ≤ ¬({ε ≤ ¬Int} ⟹ ⊥)
//│               ε ≤ ¬Int
//│                 Int ≤ ¬Int
