bop(0, "1")
//│ ∀α, β. {α ≤ β, β ≥ ∀γ, δ, ε, ζ, η, θ, ι. {ζ ≥ Int, θ ≤ ζ, ε ≥ Str, η ≤ ε, η ≥ Str, ι ≥ Int, θ ≥ Int, ι ≤ θ, θ ≥ Int, γ ≤ δ, δ ≥ ∀κ. {ε ≤ ({κ ≥ Int, ζ ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str), ζ ≤ ({κ ≥ Int, ε ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ε ≤ Str} ⟹ Str), κ ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str)} ⟹ κ, γ ≥ ∀κ. {ε ≤ ({κ ≥ Int, ζ ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str), ζ ≤ ({κ ≥ Int, ε ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ε ≤ Str} ⟹ Str), κ ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str)} ⟹ κ} ⟹ δ, α ≥ ∀γ, δ, ε, ζ, η, θ, ι. {ζ ≥ Int, θ ≤ ζ, ε ≥ Str, η ≤ ε, η ≥ Str, ι ≥ Int, θ ≥ Int, ι ≤ θ, θ ≥ Int, γ ≤ δ, δ ≥ ∀κ. {ε ≤ ({κ ≥ Int, ζ ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str), ζ ≤ ({κ ≥ Int, ε ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ε ≤ Str} ⟹ Str), κ ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str)} ⟹ κ, γ ≥ ∀κ. {ε ≤ ({κ ≥ Int, ζ ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str), ζ ≤ ({κ ≥ Int, ε ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ε ≤ Str} ⟹ Str), κ ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str)} ⟹ κ} ⟹ δ} ⟹ β
