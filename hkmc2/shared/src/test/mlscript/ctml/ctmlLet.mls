:ctml

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α. α → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀α, β, γ. {α ≤ ({γ ≤ Int, β ≥ Int} ⟹ Int) ∨ ({γ ≤ Str, β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int, γ ≤ Int} ⟹ Int) ∧ ({α ≤ Str, γ ≤ Str} ⟹ Str), γ ≤ ({α ≤ Int, β ≥ Int} ⟹ Int) ∨ ({α ≤ Str, β ≥ Str} ⟹ Str)} ⟹ α → γ → β

baz(1, 1)
//│ Int ∧ ({Int ≤ Str, Int ≤ Str} ⟹ Str)

baz("", "")
//│ ({Str ≤ Int, Str ≤ Int} ⟹ Int) ∧ Str

baz(bot, bot)
//│ ⊥

:te
baz(1, "")
//│ ({Str ≤ Int} ⟹ Int) ∧ ({Int ≤ Str} ⟹ Str)
//│ FAILURE: Unexpected lack of type error

:te
baz(true, false)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ ({γ ≤ Int, β ≥ Int} ⟹ Int) ∨ ({γ ≤ Str, β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int, γ ≤ Int} ⟹ Int) ∧ ({α ≤ Str, γ ≤ Str} ⟹ Str), γ ≤ ({α ≤ Int, β ≥ Int} ⟹ Int) ∨ ({α ≤ Str, β ≥ Str} ⟹ Str)} ⟹ α → γ → β ≤ Bool → δ.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ ({γ ≤ Int, β ≥ Int} ⟹ Int) ∨ ({γ ≤ Str, β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int, γ ≤ Int} ⟹ Int) ∧ ({α ≤ Str, γ ≤ Str} ⟹ Str), γ ≤ ({α ≤ Int, β ≥ Int} ⟹ Int) ∨ ({α ≤ Str, β ≥ Str} ⟹ Str)} ⟹ α → γ → β ≤ Bool → δ
//│     {ε ≤ ({ζ ≤ Int, η ≥ Int} ⟹ Int) ∨ ({ζ ≤ Str, η ≥ Str} ⟹ Str), η ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, ζ ≤ Str} ⟹ Str), ζ ≤ ({ε ≤ Int, η ≥ Int} ⟹ Int) ∨ ({ε ≤ Str, η ≥ Str} ⟹ Str)} ⟹ ε → ζ → η ≤ Bool → δ
//│       {η ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, ζ ≤ Str} ⟹ Str), ζ ≤ ({ε ≤ Int, η ≥ Int} ⟹ Int) ∨ ({ε ≤ Str, η ≥ Str} ⟹ Str)} ⟹ ε → ζ → η ≤ Bool → δ
//│         {ζ ≤ ({ε ≤ Int, η ≥ Int} ⟹ Int) ∨ ({ε ≤ Str, η ≥ Str} ⟹ Str)} ⟹ ε → ζ → η ≤ Bool → δ
//│           ε → ζ → η ≤ Bool → δ
//│             Bool ≤ ε
//│               Bool ≤ ({ζ ≤ Int, η ≥ Int} ⟹ Int) ∨ ({ζ ≤ Str, η ≥ Str} ⟹ Str)
//│                 Bool ≤ {ζ ≤ Int, η ≥ Int} ⟹ Int
//│                   Bool ≤ {η ≥ Int} ⟹ Int
//│                     Bool ≤ Int
//│                 Bool ≤ {ζ ≤ Str, η ≥ Str} ⟹ Str
//│                   Bool ≤ {η ≥ Str} ⟹ Str
//│                     Bool ≤ Str

fun bop(a, b) =
  let x = baz(a, b)
  x
//│ bop: ∀α, β, γ. {α ≤ ({γ ≤ Int, β ≥ Int} ⟹ Int) ∨ ({γ ≤ Str, β ≥ Str} ⟹ Str), β ≥ ({α ≤ Int, γ ≤ Int} ⟹ Int) ∧ ({α ≤ Str, γ ≤ Str} ⟹ Str), γ ≤ ({α ≤ Int, β ≥ Int} ⟹ Int) ∨ ({α ≤ Str, β ≥ Str} ⟹ Str)} ⟹ α → γ → β

:fixme
bop(0, 1)
//│ Int ∧ ({Int ≤ Str, Int ≤ Str} ⟹ Str)
//│ FAILURE: Unexpected lack of error to fix

:fixme
bop("0", "1")
//│ ({Str ≤ Int, Str ≤ Int} ⟹ Int) ∧ Str
//│ FAILURE: Unexpected lack of error to fix

:fixme
:te
bop(0, "1")
//│ ({Str ≤ Int} ⟹ Int) ∧ ({Int ≤ Str} ⟹ Str)
//│ FAILURE: Unexpected lack of type error
//│ FAILURE: Unexpected lack of error to fix
