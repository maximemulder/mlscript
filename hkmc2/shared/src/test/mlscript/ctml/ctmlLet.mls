:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α, β, γ, δ, ε. {α ≥ β, β ≥ γ, β ≤ α, γ ≥ δ, γ ≤ β, δ ≥ ε, δ ≤ γ, ε ≤ δ} ⟹ ε → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀α, β, γ, δ, ε. {α ≥ β, β ≥ γ, β ≤ α, γ ≥ {ε ≤ Int, δ ≤ Int} ⟹ Int, γ ≤ β, δ ≤ {ε ≤ ¬Int, ε ≤ Str, ζ ≥ Str, γ ≥ Str} ⟹ Str, ε ≤ {ε ≤ Str, δ ≤ Str, ζ ≥ Str, γ ≥ Str} ⟹ ¬Int} ⟹ ε → δ → α

baz(1, 1)
//│ Int

baz("", "")
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:65)
//│ ═══[TYPE ERROR] Cannot solve judgment Str ≤ Int.
//│ Typing error tree:
//│   Str ≤ Int

baz(bot, bot)
//│ Int

:te
baz(1, "")
//│ ═══[TYPE ERROR] Cannot solve judgment Str ≤ Int.
//│ Typing error tree:
//│   Str ≤ Int

:te
baz(true, false)
//│ ═══[TYPE ERROR] Cannot solve judgment Bool ≤ Int.
//│ Typing error tree:
//│   Bool ≤ Int

fun bop(a, b) =
  let x = baz(a, b)
  x
//│ bop: ∀α, β. {α ≥ β, β ≤ α} ⟹ β → (∀γ, δ. {γ ≥ δ, δ ≤ γ} ⟹ δ → ({α ≤ Int, γ ≤ Int} ⟹ Int))

bop(0, 1)
//│ Int

bop("0", "1")
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:65)
//│ ═══[TYPE ERROR] Cannot solve judgment Str ≤ Int.
//│ Typing error tree:
//│   Str ≤ Int

:te
bop(0, "1")
//│ ═══[TYPE ERROR] Cannot solve judgment Str ≤ Int.
//│ Typing error tree:
//│   Str ≤ Int
