:ctml

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α. α → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: Str → Str → (Int ∨ Str)

baz(1, 1)
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:54)
//│ ═══[ERROR] Cannot solve judgment Str → Str → (Int ∨ Str) ≤ Int → τ.
//│ Typing error tree:
//│   Str → Str → (Int ∨ Str) ≤ Int → τ
//│     Int ≤ Str
//│       Int ≤ ⊥
//│         ⊤ ≤ ⊥

baz("", "")
//│ Int ∨ Str

baz(bot, bot)
//│ Int ∨ Str

:e
baz(1, "")
//│ ═══[ERROR] Cannot solve judgment Str → Str → (Int ∨ Str) ≤ Int → 24.
//│ Typing error tree:
//│   Str → Str → (Int ∨ Str) ≤ Int → 24
//│     Int ≤ Str
//│       Int ≤ ⊥
//│         ⊤ ≤ ⊥

:e
baz(true, false)
//│ ═══[ERROR] Cannot solve judgment Str → Str → (Int ∨ Str) ≤ Bool → 26.
//│ Typing error tree:
//│   Str → Str → (Int ∨ Str) ≤ Bool → 26
//│     Bool ≤ Str
//│       Bool ≤ ⊥
//│         ⊤ ≤ ⊥
