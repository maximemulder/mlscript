:ctml

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α ◁ {}. α → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  if a is
    Int then a + b
    Str then b + b
//│ baz: ∀ν, ξ, ρ ◁ {ν ≤ ((Int ▷ {ρ ≥ Int, ξ ≤ Int}) ∨ ⊥ ▷ {ξ ≤ (Int ▷ {ρ ≥ Int, ν ≤ Int, ν ≤ Int}) ∨ (Int ▷ {ρ ≥ Int, ν ≤ Str}), ν ≤ (Int ▷ {ρ ≥ Int, ξ ≤ Int}) ∨ ⊥}) ∨ (⊥ ∨ (Str ▷ {ρ ≥ Int, ξ ≤ Int, ξ ≤ Int}) ▷ {ξ ≤ ⊥, ν ≤ ⊥ ∨ (Str ▷ {ρ ≥ Int, ξ ≤ Int, ξ ≤ Int})}), ξ ≤ ((Int ▷ {ρ ≥ Int, ν ≤ Int, ν ≤ Int}) ∨ (Int ▷ {ρ ≥ Int, ν ≤ Str}) ▷ {ξ ≤ (Int ▷ {ρ ≥ Int, ν ≤ Int, ν ≤ Int}) ∨ (Int ▷ {ρ ≥ Int, ν ≤ Str}), ν ≤ (Int ▷ {ρ ≥ Int, ξ ≤ Int}) ∨ ⊥}) ∨ (⊥ ▷ {ν ≤ ⊥ ∨ (Str ▷ {ρ ≥ Int, ξ ≤ Int, ξ ≤ Int})}), ρ ≥ (Int ▷ {ξ ≤ Int, ν ≤ Int, ν ≤ Int}) ∨ (Int ▷ {ξ ≤ Int, ξ ≤ Int, ν ≤ Str}), ρ ≤ ο}. ν → ξ → ((Int ▷ {ξ ≤ Int, ν ≤ Int, ν ≤ Int}) ∨ (Int ▷ {ξ ≤ Int, ξ ≤ Int, ν ≤ Str}))
