:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α. α → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀α, β, γ. {β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ ¬({β ≤ Str, γ ≥ Str} ⟹ ¬Str)} ⟹ ¬(Str ∨ ¬({α ≤ ⊥} ⟹ ⊥))), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({β ≤ ¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({α ≤ ⊥} ⟹ ⊥), γ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥), β ≤ Str, γ ≥ Str} ⟹ ¬Str), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ ¬({β ≤ Str, γ ≥ Str} ⟹ ¬Str)} ⟹ Str ∧ ({α ≤ ⊥} ⟹ ⊥))} ⟹ α → β → γ

baz(1, 1)
//│ Int

baz("", "")
//│ Str

baz(bot, bot)
//│ ∀α, β, γ, δ. {γ ≤ δ, δ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ ¬({β ≤ Str, γ ≥ Str} ⟹ ¬Str)} ⟹ Str ∧ ({α ≤ ⊥} ⟹ ⊥)), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ ¬({β ≤ Str, γ ≥ Str} ⟹ ¬Str)} ⟹ Str ∧ ({α ≤ ⊥} ⟹ ⊥)), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({β ≤ ¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({α ≤ ⊥} ⟹ ⊥), γ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥), β ≤ Str, γ ≥ Str} ⟹ ¬Str), β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ ¬({β ≤ Str, γ ≥ Str} ⟹ ¬Str)} ⟹ ¬(Str ∨ ¬({α ≤ ⊥} ⟹ ⊥)))} ⟹ δ

:te
baz(1, "")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
//│ Typing error tree:
//│   α ≤ Str → β
//│     γ → δ ≤ Str → β
//│       Str ≤ γ
//│         Str ≤ (¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ¬Str)} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))) ∧ Int
//│           Str ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ¬Str)} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))
//│             Str ≤ ¬({ε ≤ Int, δ ≥ Int} ⟹ ¬Int)
//│               {ε ≤ Int, δ ≥ Int} ⟹ ¬Int ≤ ¬Str
//│                 {δ ≥ Int} ⟹ ¬Int ≤ ¬Str
//│                   ¬Int ≤ ¬Str
//│                     Str ≤ Int
//│             Str ≤ ¬({ε ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ¬Str)} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)))
//│               {ε ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ¬Str)} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥)) ≤ ¬Str
//│                 ε ≤ ¬({γ ≤ Str, δ ≥ Str} ⟹ ¬Str)
//│                   {γ ≤ Str, δ ≥ Str} ⟹ ¬Str ≤ ¬ε
//│                     {δ ≥ Str} ⟹ ¬Str ≤ ¬ε
//│                       ¬Str ≤ ¬ε
//│                         ε ≤ Str
//│                           Int ≤ Str

:te
baz(true, false)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ ¬({β ≤ Str, γ ≥ Str} ⟹ ¬Str)} ⟹ ¬(Str ∨ ¬({α ≤ ⊥} ⟹ ⊥))), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({β ≤ ¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({α ≤ ⊥} ⟹ ⊥), γ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥), β ≤ Str, γ ≥ Str} ⟹ ¬Str), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ ¬({β ≤ Str, γ ≥ Str} ⟹ ¬Str)} ⟹ Str ∧ ({α ≤ ⊥} ⟹ ⊥))} ⟹ α → β → γ ≤ Bool → δ.
//│ Typing error tree:
//│   ∀α, β, γ. {β ≤ ¬({α ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({α ≤ ¬({β ≤ Str, γ ≥ Str} ⟹ ¬Str)} ⟹ ¬(Str ∨ ¬({α ≤ ⊥} ⟹ ⊥))), α ≤ ¬({β ≤ Int, γ ≥ Int} ⟹ ¬Int) ∨ ¬({β ≤ ¬({γ ≥ Str} ⟹ ¬Str) ∨ ¬({α ≤ ⊥} ⟹ ⊥), γ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥), β ≤ Str, γ ≥ Str} ⟹ ¬Str), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ ¬({β ≤ Str, γ ≥ Str} ⟹ ¬Str)} ⟹ Str ∧ ({α ≤ ⊥} ⟹ ⊥))} ⟹ α → β → γ ≤ Bool → δ
//│     {ζ ≤ ¬({ε ≤ Int, η ≥ Int} ⟹ ¬Int) ∨ ¬({ε ≤ ¬({ζ ≤ Str, η ≥ Str} ⟹ ¬Str)} ⟹ ¬(Str ∨ ¬({ε ≤ ⊥} ⟹ ⊥))), ε ≤ ¬({ζ ≤ Int, η ≥ Int} ⟹ ¬Int) ∨ ¬({ζ ≤ ¬({η ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥), η ≥ ({ε ≤ Str, ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥), ζ ≤ Str, η ≥ Str} ⟹ ¬Str), η ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ ¬({ζ ≤ Str, η ≥ Str} ⟹ ¬Str)} ⟹ Str ∧ ({ε ≤ ⊥} ⟹ ⊥))} ⟹ ε → ζ → η ≤ Bool → δ
//│       {ε ≤ ¬({ζ ≤ Int, η ≥ Int} ⟹ ¬Int) ∨ ¬({ζ ≤ ¬({η ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥), η ≥ ({ε ≤ Str, ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥), ζ ≤ Str, η ≥ Str} ⟹ ¬Str), η ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ ¬({ζ ≤ Str, η ≥ Str} ⟹ ¬Str)} ⟹ Str ∧ ({ε ≤ ⊥} ⟹ ⊥))} ⟹ ε → ζ → η ≤ Bool → δ
//│         {η ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ ¬({ζ ≤ Str, η ≥ Str} ⟹ ¬Str)} ⟹ Str ∧ ({ε ≤ ⊥} ⟹ ⊥))} ⟹ ε → ζ → η ≤ Bool → δ
//│           ε → ζ → η ≤ Bool → δ
//│             Bool ≤ ε
//│               Bool ≤ ¬({ζ ≤ Int, η ≥ Int} ⟹ ¬Int) ∨ ¬({ζ ≤ ¬({η ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥), η ≥ ({ε ≤ Str, ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥), ζ ≤ Str, η ≥ Str} ⟹ ¬Str)
//│                 Bool ≤ ¬({ζ ≤ Int, η ≥ Int} ⟹ ¬Int)
//│                   {ζ ≤ Int, η ≥ Int} ⟹ ¬Int ≤ ¬Bool
//│                     {η ≥ Int} ⟹ ¬Int ≤ ¬Bool
//│                       ¬Int ≤ ¬Bool
//│                         Bool ≤ Int
//│                 Bool ≤ ¬({ζ ≤ ¬({η ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥), η ≥ ({ε ≤ Str, ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥), ζ ≤ Str, η ≥ Str} ⟹ ¬Str)
//│                   {ζ ≤ ¬({η ≥ Str} ⟹ ¬Str) ∨ ¬({ε ≤ ⊥} ⟹ ⊥), η ≥ ({ε ≤ Str, ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥), ζ ≤ Str, η ≥ Str} ⟹ ¬Str ≤ ¬Bool
//│                     {η ≥ ({ε ≤ Str, ζ ≤ Str} ⟹ Str) ∧ ({ε ≤ ⊥} ⟹ ⊥), ζ ≤ Str, η ≥ Str} ⟹ ¬Str ≤ ¬Bool
//│                       {ζ ≤ Str, η ≥ Str} ⟹ ¬Str ≤ ¬Bool
//│                         {η ≥ Str} ⟹ ¬Str ≤ ¬Bool
//│                           ¬Str ≤ ¬Bool
//│                             Bool ≤ Str

fun bop(a, b) =
  let x = baz(a, b)
  x
//│ bop: ∀α, β, γ, δ, ε. {δ ≥ β, β ≤ ¬({γ ≤ Int, ε ≥ Int} ⟹ ¬Int) ∨ ¬({γ ≤ ¬({δ ≤ Str, ε ≥ Str} ⟹ ¬Str)} ⟹ ¬(Str ∨ ¬({γ ≤ ⊥} ⟹ ⊥))), γ ≥ α, α ≤ ¬({δ ≤ Int, ε ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≤ ¬({ε ≥ Str} ⟹ ¬Str) ∨ ¬({γ ≤ ⊥} ⟹ ⊥), ε ≥ ({γ ≤ Str, δ ≤ Str} ⟹ Str) ∧ ({γ ≤ ⊥} ⟹ ⊥), δ ≤ Str, ε ≥ Str} ⟹ ¬Str), ε ≥ ({γ ≤ Int, δ ≤ Int} ⟹ Int) ∧ ({γ ≤ ¬({δ ≤ Str, ε ≥ Str} ⟹ ¬Str)} ⟹ Str ∧ ({γ ≤ ⊥} ⟹ ⊥)), γ ≤ ¬({δ ≤ Int, ε ≥ Int} ⟹ ¬Int) ∨ ¬({δ ≤ ¬({ε ≥ Str} ⟹ ¬Str) ∨ ¬({γ ≤ ⊥} ⟹ ⊥), ε ≥ ({γ ≤ Str, δ ≤ Str} ⟹ Str) ∧ ({γ ≤ ⊥} ⟹ ⊥), δ ≤ Str, ε ≥ Str} ⟹ ¬Str), δ ≤ ¬({γ ≤ Int, ε ≥ Int} ⟹ ¬Int) ∨ ¬({γ ≤ ¬({δ ≤ Str, ε ≥ Str} ⟹ ¬Str)} ⟹ ¬(Str ∨ ¬({γ ≤ ⊥} ⟹ ⊥)))} ⟹ α → β → (ε ∨ (({γ ≤ Int, δ ≤ Int} ⟹ Int) ∧ ({γ ≤ ¬({δ ≤ Str, ε ≥ Str} ⟹ ¬Str)} ⟹ Str ∧ ({γ ≤ ⊥} ⟹ ⊥))))

bop(0, 1)
//│ Int

bop("0", "1")
//│ Str

:te
bop(0, "1")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
//│ Typing error tree:
//│   α ≤ Str → β
//│     γ → (δ ∨ (({ζ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({ζ ≤ ¬({ε ≤ Str, δ ≥ Str} ⟹ ¬Str)} ⟹ Str ∧ ({ζ ≤ ⊥} ⟹ ⊥)))) ≤ Str → β
//│       Str ≤ γ
//│         Str ≤ (¬({ζ ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ζ ≤ ¬({ε ≤ Str, δ ≥ Str} ⟹ ¬Str)} ⟹ ¬(Str ∨ ¬({ζ ≤ ⊥} ⟹ ⊥)))) ∧ Int
//│           Str ≤ ¬({ζ ≤ Int, δ ≥ Int} ⟹ ¬Int) ∨ ¬({ζ ≤ ¬({ε ≤ Str, δ ≥ Str} ⟹ ¬Str)} ⟹ ¬(Str ∨ ¬({ζ ≤ ⊥} ⟹ ⊥)))
//│             Str ≤ ¬({ζ ≤ Int, δ ≥ Int} ⟹ ¬Int)
//│               {ζ ≤ Int, δ ≥ Int} ⟹ ¬Int ≤ ¬Str
//│                 {δ ≥ Int} ⟹ ¬Int ≤ ¬Str
//│                   ¬Int ≤ ¬Str
//│                     Str ≤ Int
//│             Str ≤ ¬({ζ ≤ ¬({ε ≤ Str, δ ≥ Str} ⟹ ¬Str)} ⟹ ¬(Str ∨ ¬({ζ ≤ ⊥} ⟹ ⊥)))
//│               {ζ ≤ ¬({ε ≤ Str, δ ≥ Str} ⟹ ¬Str)} ⟹ ¬(Str ∨ ¬({ζ ≤ ⊥} ⟹ ⊥)) ≤ ¬Str
//│                 ζ ≤ ¬({ε ≤ Str, δ ≥ Str} ⟹ ¬Str)
//│                   {ε ≤ Str, δ ≥ Str} ⟹ ¬Str ≤ ¬ζ
//│                     {δ ≥ Str} ⟹ ¬Str ≤ ¬ζ
//│                       ¬Str ≤ ¬ζ
//│                         ζ ≤ Str
//│                           η ≤ Str
//│                             Int ≤ Str
