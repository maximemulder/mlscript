:ctml

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α, β, γ, δ, ε. {α ≥ β, β ≤ α, β ≥ γ, γ ≤ β, γ ≥ ε, δ ≤ ε, ε ≤ γ, ε ≥ δ} ⟹ δ → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀α, β, γ. {α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {β ≤ Str, γ ≥ Str}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {α ≤ Str, γ ≥ Str}), γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})} ⟹ α → β → ((((Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})) ∨ γ) ∨ ((Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})) ∨ γ)

baz(1, 1)
//│ (((Int ⟹ {α ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})) ∨ Int) ∨ ((Int ⟹ {α ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})) ∨ Int

baz("", "")
//│ (((Int ⟹ {β ≤ Int, α ≤ Int}) ∨ (Str ⟹ {β ≤ Str})) ∨ Str) ∨ ((Int ⟹ {β ≤ Int, α ≤ Int}) ∨ (Str ⟹ {β ≤ Str})) ∨ Str

baz(bot, bot)
//│ ∀α, β. (((Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})) ∨ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})) ∨ ((Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})) ∨ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})

:e
baz(1, "")
//│ ═══[ERROR] Cannot solve judgment ∀α. {α ≤ Int} ⟹ α → ((((Int ⟹ {β ≤ Int}) ∨ (Str ⟹ {β ≤ Str, α ≤ Str})) ∨ Int) ∨ ((Int ⟹ {β ≤ Int}) ∨ (Str ⟹ {β ≤ Str, α ≤ Str})) ∨ Int) ≤ Str → γ.
//│ Typing error tree:
//│   ∀α. {α ≤ Int} ⟹ α → ((((Int ⟹ {β ≤ Int}) ∨ (Str ⟹ {β ≤ Str, α ≤ Str})) ∨ Int) ∨ ((Int ⟹ {β ≤ Int}) ∨ (Str ⟹ {β ≤ Str, α ≤ Str})) ∨ Int) ≤ Str → γ
//│     {δ ≤ Int} ⟹ δ → ((((Int ⟹ {β ≤ Int}) ∨ (Str ⟹ {β ≤ Str, δ ≤ Str})) ∨ Int) ∨ ((Int ⟹ {β ≤ Int}) ∨ (Str ⟹ {β ≤ Str, δ ≤ Str})) ∨ Int) ≤ Str → γ
//│       δ → ((((Int ⟹ {β ≤ Int}) ∨ (Str ⟹ {β ≤ Str, δ ≤ Str})) ∨ Int) ∨ ((Int ⟹ {β ≤ Int}) ∨ (Str ⟹ {β ≤ Str, δ ≤ Str})) ∨ Int) ≤ Str → γ
//│         Str ≤ δ
//│           Str ≤ Int
//│             ⊤ ≤ Int
//│               ⊤ ≤ ⊥

:e
baz(true, false)
//│ ═══[ERROR] Cannot solve judgment ∀α. {α ≤ Str} ⟹ α → ((((Int ⟹ {β ≤ Int, α ≤ Int}) ∨ (Str ⟹ {β ≤ Str})) ∨ Str) ∨ ((Int ⟹ {β ≤ Int, α ≤ Int}) ∨ (Str ⟹ {β ≤ Str})) ∨ Str) ≤ Bool → γ.
//│ Typing error tree:
//│   ∀α. {α ≤ Str} ⟹ α → ((((Int ⟹ {β ≤ Int, α ≤ Int}) ∨ (Str ⟹ {β ≤ Str})) ∨ Str) ∨ ((Int ⟹ {β ≤ Int, α ≤ Int}) ∨ (Str ⟹ {β ≤ Str})) ∨ Str) ≤ Bool → γ
//│     {δ ≤ Str} ⟹ δ → ((((Int ⟹ {β ≤ Int, δ ≤ Int}) ∨ (Str ⟹ {β ≤ Str})) ∨ Str) ∨ ((Int ⟹ {β ≤ Int, δ ≤ Int}) ∨ (Str ⟹ {β ≤ Str})) ∨ Str) ≤ Bool → γ
//│       δ → ((((Int ⟹ {β ≤ Int, δ ≤ Int}) ∨ (Str ⟹ {β ≤ Str})) ∨ Str) ∨ ((Int ⟹ {β ≤ Int, δ ≤ Int}) ∨ (Str ⟹ {β ≤ Str})) ∨ Str) ≤ Bool → γ
//│         Bool ≤ δ
//│           Bool ≤ Str
//│             Bool ≤ ⊥
//│               ⊤ ≤ ⊥
