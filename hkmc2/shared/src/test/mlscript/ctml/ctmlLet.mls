:ctml

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α ◁ {}. α → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀ν, ξ ◁ {ν ≤ (Int ▷ {ξ ≤ Int}) ∨ (Str ▷ {ξ ≤ Str}), ξ ≤ (Int ▷ {ν ≤ Int}) ∨ (Str ▷ {ν ≤ Str})}. ν → ξ → ((Int ▷ {ξ ≤ Int, ν ≤ Int}) ∨ (Str ▷ {ξ ≤ Str, ν ≤ Str}))

baz(1, 1)
//│ Int ∨ Str

baz("", "")
//│ Int ∨ Str

baz(bot, bot)
//│ ∀ν, ξ ◁ {ν ≤ (Int ▷ {ξ ≤ Int}) ∨ (Str ▷ {ξ ≤ Str}), ξ ≤ (Int ▷ {ν ≤ Int}) ∨ (Str ▷ {ν ≤ Str})}. (Int ▷ {ξ ≤ Int, ν ≤ Int}) ∨ (Str ▷ {ξ ≤ Str, ν ≤ Str})

:e
baz(1, "")
//│ ═══[ERROR] Cannot solve judgment Int → (Int ∨ Str) ≤ Str → ω.
//│ Typing error tree:
//│   Int → (Int ∨ Str) ≤ Str → ω
//│     Str ≤ Int
//│       ⊤ ≤ Int
//│         ⊤ ≤ ⊥

:e
baz(true, false)
//│ ═══[ERROR] Cannot solve judgment ∀ν, ξ ◁ {ν ≤ (Int ▷ {ξ ≤ Int}) ∨ (Str ▷ {ξ ≤ Str}), ξ ≤ (Int ▷ {ν ≤ Int}) ∨ (Str ▷ {ν ≤ Str})}. ν → ξ → ((Int ▷ {ξ ≤ Int, ν ≤ Int}) ∨ (Str ▷ {ξ ≤ Str, ν ≤ Str})) ≤ Bool → 26.
//│ Typing error tree:
//│   ∀ν, ξ ◁ {ν ≤ (Int ▷ {ξ ≤ Int}) ∨ (Str ▷ {ξ ≤ Str}), ξ ≤ (Int ▷ {ν ≤ Int}) ∨ (Str ▷ {ν ≤ Str})}. ν → ξ → ((Int ▷ {ξ ≤ Int, ν ≤ Int}) ∨ (Str ▷ {ξ ≤ Str, ν ≤ Str})) ≤ Bool → 26
//│     ν → ξ → ((Int ▷ {ξ ≤ Int, ν ≤ Int}) ∨ (Str ▷ {ξ ≤ Str, ν ≤ Str})) ≤ Bool → 26
//│       Bool ≤ ν
//│         Bool ≤ (Int ▷ {ξ ≤ Int}) ∨ (Str ▷ {ξ ≤ Str})
//│           Bool ≤ Int ▷ {ξ ≤ Int}
//│             Bool ≤ Int
//│               Bool ≤ ⊥
//│                 ⊤ ≤ ⊥
//│           Bool ≤ Str ▷ {ξ ≤ Str}
//│             Bool ≤ Str
//│               Bool ≤ ⊥
//│                 ⊤ ≤ ⊥
