:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α. α → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ⊥ → ⊥ → ⊥

:fixme // FIXME: Semantic variable inlining currently collapses `baz` to bottom.
baz(1, 1)
//│ ═══[TYPE ERROR] Cannot solve judgment ⊥ → ⊥ → ⊥ ≤ Int → α.
//│ Typing error tree:
//│   ⊥ → ⊥ → ⊥ ≤ Int → α
//│     Int ≤ ⊥

:fixme // FIXME: Semantic variable inlining currently collapses `baz` to bottom.
baz("", "")
//│ ═══[TYPE ERROR] Cannot solve judgment ⊥ → ⊥ → ⊥ ≤ Str → α.
//│ Typing error tree:
//│   ⊥ → ⊥ → ⊥ ≤ Str → α
//│     Str ≤ ⊥

baz(bot, bot)
//│ ⊥

:te
baz(1, "")
//│ ═══[TYPE ERROR] Cannot solve judgment ⊥ → ⊥ → ⊥ ≤ Int → α.
//│ Typing error tree:
//│   ⊥ → ⊥ → ⊥ ≤ Int → α
//│     Int ≤ ⊥

:te
baz(true, false)
//│ ═══[TYPE ERROR] Cannot solve judgment ⊥ → ⊥ → ⊥ ≤ Bool → α.
//│ Typing error tree:
//│   ⊥ → ⊥ → ⊥ ≤ Bool → α
//│     Bool ≤ ⊥

