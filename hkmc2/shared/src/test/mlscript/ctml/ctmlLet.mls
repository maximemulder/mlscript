:ctml

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α. α → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀α, β. {α ≤ (Int ⟹ {β ≤ Int, 18 ≥ Int}) ∨ (Str ⟹ {β ≤ Str, 18 ≥ Str}), β ≤ (Int ⟹ {α ≤ Int, 18 ≥ Int}) ∨ (Str ⟹ {α ≤ Str, 18 ≥ Str})} ⟹ α → β → ((Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str}))

baz(1, 1)
//│ (Int ⟹ {22 ≤ Int}) ∨ (Str ⟹ {22 ≤ Str, 23 ≤ Str})
//│ 18 ≥ Int

baz("", "")
//│ (Int ⟹ {26 ≤ Int, 27 ≤ Int}) ∨ (Str ⟹ {26 ≤ Str})
//│ 18 ≥ Str

baz(bot, bot)
//│ ∀α, β. {α ≤ (Int ⟹ {β ≤ Int, 18 ≥ Int}) ∨ (Str ⟹ {β ≤ Str, 18 ≥ Str}), β ≤ (Int ⟹ {α ≤ Int, 18 ≥ Int}) ∨ (Str ⟹ {α ≤ Str, 18 ≥ Str})} ⟹ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})

:e
baz(1, "")
//│ ═══[ERROR] Cannot solve judgment Int → ((Int ⟹ {36 ≤ Int}) ∨ (Str ⟹ {36 ≤ Str, 37 ≤ Str})) ≤ Str → 34.
//│ Typing error tree:
//│   Int → ((Int ⟹ {36 ≤ Int}) ∨ (Str ⟹ {36 ≤ Str, 37 ≤ Str})) ≤ Str → 34
//│     Str ≤ Int
//│       ⊤ ≤ Int
//│         ⊤ ≤ ⊥

:e
baz(true, false)
//│ ═══[ERROR] Cannot solve judgment ∀α, β. {α ≤ (Int ⟹ {β ≤ Int, 18 ≥ Int}) ∨ (Str ⟹ {β ≤ Str, 18 ≥ Str}), β ≤ (Int ⟹ {α ≤ Int, 18 ≥ Int}) ∨ (Str ⟹ {α ≤ Str, 18 ≥ Str})} ⟹ α → β → ((Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})) ≤ Bool → 39.
//│ Typing error tree:
//│   ∀α, β. {α ≤ (Int ⟹ {β ≤ Int, 18 ≥ Int}) ∨ (Str ⟹ {β ≤ Str, 18 ≥ Str}), β ≤ (Int ⟹ {α ≤ Int, 18 ≥ Int}) ∨ (Str ⟹ {α ≤ Str, 18 ≥ Str})} ⟹ α → β → ((Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})) ≤ Bool → 39
//│     ∀α. {40 ≤ (Int ⟹ {α ≤ Int, 18 ≥ Int}) ∨ (Str ⟹ {α ≤ Str, 18 ≥ Str}), α ≤ (Int ⟹ {40 ≤ Int, 18 ≥ Int}) ∨ (Str ⟹ {40 ≤ Str, 18 ≥ Str})} ⟹ 40 → α → ((Int ⟹ {40 ≤ Int, α ≤ Int}) ∨ (Str ⟹ {40 ≤ Str, α ≤ Str})) ≤ Bool → 39
//│       {40 ≤ (Int ⟹ {41 ≤ Int, 18 ≥ Int}) ∨ (Str ⟹ {41 ≤ Str, 18 ≥ Str}), 41 ≤ (Int ⟹ {40 ≤ Int, 18 ≥ Int}) ∨ (Str ⟹ {40 ≤ Str, 18 ≥ Str})} ⟹ 40 → 41 → ((Int ⟹ {40 ≤ Int, 41 ≤ Int}) ∨ (Str ⟹ {40 ≤ Str, 41 ≤ Str})) ≤ Bool → 39
//│         40 → 41 → ((Int ⟹ {40 ≤ Int, 41 ≤ Int}) ∨ (Str ⟹ {40 ≤ Str, 41 ≤ Str})) ≤ Bool → 39
//│           Bool ≤ 40
//│             Bool ≤ (Int ⟹ {41 ≤ Int, 18 ≥ Int}) ∨ (Str ⟹ {41 ≤ Str, 18 ≥ Str})
//│               Bool ≤ Int ⟹ {41 ≤ Int, 18 ≥ Int}
//│                 Bool ≤ Int
//│                   Bool ≤ ⊥
//│                     ⊤ ≤ ⊥
//│               Bool ≤ Str ⟹ {41 ≤ Str, 18 ≥ Str}
//│                 Bool ≤ Str
//│                   Bool ≤ ⊥
//│                     ⊤ ≤ ⊥
