:ctml

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α, β, γ, δ, ε. {α ≥ β, β ≥ γ, β ≤ α, γ ≥ ε, γ ≤ β, δ ≤ ε, ε ≥ δ, ε ≤ γ} ⟹ δ → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀α, β, γ, δ, ε. {α ≤ (Int ⟹ {γ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, ε ≤ Str}), β ≥ δ, γ ≥ (Int ⟹ {α ≤ Int, ε ≤ Int}) ∧ (Str ⟹ {α ≤ Str, ε ≤ Str}), γ ≤ δ, δ ≥ γ, δ ≤ β, ε ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str})} ⟹ ε → α → β

baz(1, 1)
//│ Int

baz("", "")
//│ Str

baz(bot, bot)
//│ ⊥

:e
baz(1, "")
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ Str → α.
//│ Typing error tree:
//│   Int → Int ≤ Str → α
//│     Str ≤ Int

:e
baz(true, false)
//│ ═══[ERROR] Cannot solve judgment ∀α, β, γ, δ, ε. {α ≤ (Int ⟹ {γ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, ε ≤ Str}), β ≥ δ, γ ≥ (Int ⟹ {α ≤ Int, ε ≤ Int}) ∧ (Str ⟹ {α ≤ Str, ε ≤ Str}), γ ≤ δ, δ ≥ γ, δ ≤ β, ε ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str})} ⟹ ε → α → β ≤ Bool → ζ.
//│ Typing error tree:
//│   ∀α, β, γ, δ, ε. {α ≤ (Int ⟹ {γ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, ε ≤ Str}), β ≥ δ, γ ≥ (Int ⟹ {α ≤ Int, ε ≤ Int}) ∧ (Str ⟹ {α ≤ Str, ε ≤ Str}), γ ≤ δ, δ ≥ γ, δ ≤ β, ε ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str})} ⟹ ε → α → β ≤ Bool → ζ
//│     ∀β, γ, δ, ε. {η ≤ (Int ⟹ {γ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, ε ≤ Str}), β ≥ δ, γ ≥ (Int ⟹ {η ≤ Int, ε ≤ Int}) ∧ (Str ⟹ {η ≤ Str, ε ≤ Str}), γ ≤ δ, δ ≥ γ, δ ≤ β, ε ≤ (Int ⟹ {γ ≥ Int, η ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, η ≤ Str})} ⟹ ε → η → β ≤ Bool → ζ
//│       ∀γ, δ, ε. {η ≤ (Int ⟹ {γ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, ε ≤ Str}), θ ≥ δ, γ ≥ (Int ⟹ {η ≤ Int, ε ≤ Int}) ∧ (Str ⟹ {η ≤ Str, ε ≤ Str}), γ ≤ δ, δ ≥ γ, δ ≤ θ, ε ≤ (Int ⟹ {γ ≥ Int, η ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, η ≤ Str})} ⟹ ε → η → θ ≤ Bool → ζ
//│         ∀δ, ε. {η ≤ (Int ⟹ {ι ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {ι ≥ Str, ε ≤ Str}), θ ≥ δ, ι ≥ (Int ⟹ {η ≤ Int, ε ≤ Int}) ∧ (Str ⟹ {η ≤ Str, ε ≤ Str}), ι ≤ δ, δ ≥ ι, δ ≤ θ, ε ≤ (Int ⟹ {ι ≥ Int, η ≤ Int}) ∨ (Str ⟹ {ι ≥ Str, η ≤ Str})} ⟹ ε → η → θ ≤ Bool → ζ
//│           ∀ε. {η ≤ (Int ⟹ {ι ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {ι ≥ Str, ε ≤ Str}), θ ≥ κ, ι ≥ (Int ⟹ {η ≤ Int, ε ≤ Int}) ∧ (Str ⟹ {η ≤ Str, ε ≤ Str}), ι ≤ κ, κ ≥ ι, κ ≤ θ, ε ≤ (Int ⟹ {ι ≥ Int, η ≤ Int}) ∨ (Str ⟹ {ι ≥ Str, η ≤ Str})} ⟹ ε → η → θ ≤ Bool → ζ
//│             {η ≤ (Int ⟹ {ι ≥ Int, λ ≤ Int}) ∨ (Str ⟹ {ι ≥ Str, λ ≤ Str}), θ ≥ κ, ι ≥ (Int ⟹ {η ≤ Int, λ ≤ Int}) ∧ (Str ⟹ {η ≤ Str, λ ≤ Str}), ι ≤ κ, κ ≥ ι, κ ≤ θ, λ ≤ (Int ⟹ {ι ≥ Int, η ≤ Int}) ∨ (Str ⟹ {ι ≥ Str, η ≤ Str})} ⟹ λ → η → θ ≤ Bool → ζ
//│               {θ ≥ κ, ι ≥ (Int ⟹ {η ≤ Int, λ ≤ Int}) ∧ (Str ⟹ {η ≤ Str, λ ≤ Str}), ι ≤ κ, κ ≥ ι, κ ≤ θ, λ ≤ (Int ⟹ {ι ≥ Int, η ≤ Int}) ∨ (Str ⟹ {ι ≥ Str, η ≤ Str})} ⟹ λ → η → θ ≤ Bool → ζ
//│                 {ι ≥ (Int ⟹ {η ≤ Int, λ ≤ Int}) ∧ (Str ⟹ {η ≤ Str, λ ≤ Str}), ι ≤ κ, κ ≥ ι, κ ≤ θ, λ ≤ (Int ⟹ {ι ≥ Int, η ≤ Int}) ∨ (Str ⟹ {ι ≥ Str, η ≤ Str})} ⟹ λ → η → θ ≤ Bool → ζ
//│                   {ι ≤ κ, κ ≥ ι, κ ≤ θ, λ ≤ (Int ⟹ {ι ≥ Int, η ≤ Int}) ∨ (Str ⟹ {ι ≥ Str, η ≤ Str})} ⟹ λ → η → θ ≤ Bool → ζ
//│                     {κ ≥ ι, κ ≤ θ, λ ≤ (Int ⟹ {ι ≥ Int, η ≤ Int}) ∨ (Str ⟹ {ι ≥ Str, η ≤ Str})} ⟹ λ → η → θ ≤ Bool → ζ
//│                       {κ ≤ θ, λ ≤ (Int ⟹ {ι ≥ Int, η ≤ Int}) ∨ (Str ⟹ {ι ≥ Str, η ≤ Str})} ⟹ λ → η → θ ≤ Bool → ζ
//│                         {λ ≤ (Int ⟹ {ι ≥ Int, η ≤ Int}) ∨ (Str ⟹ {ι ≥ Str, η ≤ Str})} ⟹ λ → η → θ ≤ Bool → ζ
//│                           λ → η → θ ≤ Bool → ζ
//│                             Bool ≤ λ
//│                               Bool ≤ (Int ⟹ {ι ≥ Int, η ≤ Int}) ∨ (Str ⟹ {ι ≥ Str, η ≤ Str})
//│                                 Bool ≤ Int ⟹ {ι ≥ Int, η ≤ Int}
//│                                   Bool ≤ Int ⟹ {η ≤ Int}
//│                                     Bool ≤ Int
//│                                 Bool ≤ Str ⟹ {ι ≥ Str, η ≤ Str}
//│                                   Bool ≤ Str ⟹ {η ≤ Str}
//│                                     Bool ≤ Str

fun bop(a, b) =
  let x = baz(a, b)
  x
//│ bop: ∀α, β, γ, δ, ε, ζ, η, θ, ι, κ. {α ≤ β, β ≥ α, β ≤ (Int ⟹ {ι ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ι ≥ Str, δ ≤ Str}), γ ≤ δ, δ ≥ γ, δ ≤ (Int ⟹ {ι ≥ Int, β ≤ Int}) ∨ (Str ⟹ {ι ≥ Str, β ≤ Str}), ε ≥ ζ, ζ ≥ η, ζ ≤ ε, η ≥ θ, η ≤ ζ, θ ≥ κ, θ ≤ η, ι ≥ (Int ⟹ {β ≤ Int, δ ≤ Int}) ∧ (Str ⟹ {β ≤ Str, δ ≤ Str}), ι ≤ κ, κ ≥ ι, κ ≤ θ} ⟹ γ → α → ε

bop(0, 1)
//│ Int

bop("0", "1")
//│ Str

:e
bop(0, "1")
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ Str → α.
//│ Typing error tree:
//│   Int → Int ≤ Str → α
//│     Str ≤ Int
