:ctml

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α. α → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀ο, π. {ο ≤ (Int ⟹ {π ≤ Int}) ∨ (Str ⟹ {π ≤ Str}), π ≤ (Int ⟹ {ο ≤ Int}) ∨ (Str ⟹ {ο ≤ Str})} ⟹ ο → π → ((Int ⟹ {ο ≤ Int, π ≤ Int}) ∨ (Str ⟹ {ο ≤ Str, π ≤ Str}))

baz(1, 1)
//│ Int ∨ Str

baz("", "")
//│ Int ∨ Str

baz(bot, bot)
//│ ∀32, 33. {32 ≤ (Int ⟹ {33 ≤ Int}) ∨ (Str ⟹ {33 ≤ Str}), 33 ≤ (Int ⟹ {32 ≤ Int}) ∨ (Str ⟹ {32 ≤ Str})} ⟹ (Int ⟹ {32 ≤ Int, 33 ≤ Int}) ∨ (Str ⟹ {32 ≤ Str, 33 ≤ Str})

:e
baz(1, "")
//│ ═══[ERROR] Cannot solve judgment Int → (Int ∨ Str) ≤ Str → 34.
//│ Typing error tree:
//│   Int → (Int ∨ Str) ≤ Str → 34
//│     Str ≤ Int
//│       ⊤ ≤ Int
//│         ⊤ ≤ ⊥

:e
baz(true, false)
//│ ═══[ERROR] Cannot solve judgment ∀ο, π. {ο ≤ (Int ⟹ {π ≤ Int}) ∨ (Str ⟹ {π ≤ Str}), π ≤ (Int ⟹ {ο ≤ Int}) ∨ (Str ⟹ {ο ≤ Str})} ⟹ ο → π → ((Int ⟹ {ο ≤ Int, π ≤ Int}) ∨ (Str ⟹ {ο ≤ Str, π ≤ Str})) ≤ Bool → 39.
//│ Typing error tree:
//│   ∀ο, π. {ο ≤ (Int ⟹ {π ≤ Int}) ∨ (Str ⟹ {π ≤ Str}), π ≤ (Int ⟹ {ο ≤ Int}) ∨ (Str ⟹ {ο ≤ Str})} ⟹ ο → π → ((Int ⟹ {ο ≤ Int, π ≤ Int}) ∨ (Str ⟹ {ο ≤ Str, π ≤ Str})) ≤ Bool → 39
//│     ∀π. {40 ≤ (Int ⟹ {π ≤ Int}) ∨ (Str ⟹ {π ≤ Str}), π ≤ (Int ⟹ {40 ≤ Int}) ∨ (Str ⟹ {40 ≤ Str})} ⟹ 40 → π → ((Int ⟹ {40 ≤ Int, π ≤ Int}) ∨ (Str ⟹ {40 ≤ Str, π ≤ Str})) ≤ Bool → 39
//│       {40 ≤ (Int ⟹ {41 ≤ Int}) ∨ (Str ⟹ {41 ≤ Str}), 41 ≤ (Int ⟹ {40 ≤ Int}) ∨ (Str ⟹ {40 ≤ Str})} ⟹ 40 → 41 → ((Int ⟹ {40 ≤ Int, 41 ≤ Int}) ∨ (Str ⟹ {40 ≤ Str, 41 ≤ Str})) ≤ Bool → 39
//│         40 → 41 → ((Int ⟹ {40 ≤ Int, 41 ≤ Int}) ∨ (Str ⟹ {40 ≤ Str, 41 ≤ Str})) ≤ Bool → 39
//│           Bool ≤ 40
//│             Bool ≤ (Int ⟹ {41 ≤ Int}) ∨ (Str ⟹ {41 ≤ Str})
//│               Bool ≤ Int ⟹ {41 ≤ Int}
//│                 Bool ≤ Int
//│                   Bool ≤ ⊥
//│                     ⊤ ≤ ⊥
//│               Bool ≤ Str ⟹ {41 ≤ Str}
//│                 Bool ≤ Str
//│                   Bool ≤ ⊥
//│                     ⊤ ≤ ⊥
