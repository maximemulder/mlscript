:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ⊤ → ⊥

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀α, β. {α ≤ ({β ≤ Int} ⟹ Int) ∨ ({β ≤ Str} ⟹ Str), β ≤ ({α ≤ Int} ⟹ Int) ∨ ({α ≤ Str, α ≤ ¬Int} ⟹ Str)} ⟹ α → β → ⊥

baz(1, 1)
//│ ⊥

baz("", "")
//│ ⊥

baz(bot, bot)
//│ ⊥

:te
baz(1, "")
//│ ⊥
//│ FAILURE: Unexpected lack of type error

:te
baz(true, false)
//│ ⊥
//│ FAILURE: Unexpected lack of type error

fun bop(a, b) =
  let x = baz(a, b)
  x
//│ bop: ∀α. α → (({α ≤ Int} ⟹ Int) ∨ ({α ≤ Str, α ≤ ¬Int} ⟹ Str)) → ⊥

bop(0, 1)
//│ ⊥

bop("0", "1")
//│ ⊥

:te
bop(0, "1")
//│ ⊥
//│ FAILURE: Unexpected lack of type error
