:ctml

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α, β, γ, δ, ε. {α ≥ β, β ≥ γ, β ≤ α, γ ≥ ε, γ ≤ β, δ ≤ ε, ε ≥ δ, ε ≤ γ} ⟹ δ → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str})} ⟹ α → β → γ

baz(1, 1)
//│ Int

baz("", "")
//│ Str

baz(bot, bot)
//│ ⊥

:e
baz(1, "")
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ Str → α.
//│ Typing error tree:
//│   Int → Int ≤ Str → α
//│     Str ≤ Int
//│       ⊤ ≤ Int
//│         ⊤ ≤ ⊥

:e
baz(true, false)
//│ ═══[ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str})} ⟹ α → β → γ ≤ Bool → δ.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str})} ⟹ α → β → γ ≤ Bool → δ
//│     ∀β, γ. {ε ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, ε ≤ Str})} ⟹ ε → β → γ ≤ Bool → δ
//│       ∀γ. {ε ≤ (Int ⟹ {γ ≥ Int, ζ ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, ζ ≤ Str}), ζ ≤ (Int ⟹ {γ ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, ε ≤ Str})} ⟹ ε → ζ → γ ≤ Bool → δ
//│         {ε ≤ (Int ⟹ {η ≥ Int, ζ ≤ Int}) ∨ (Str ⟹ {η ≥ Str, ζ ≤ Str}), ζ ≤ (Int ⟹ {η ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {η ≥ Str, ε ≤ Str})} ⟹ ε → ζ → η ≤ Bool → δ
//│           {ζ ≤ (Int ⟹ {η ≥ Int, ε ≤ Int}) ∨ (Str ⟹ {η ≥ Str, ε ≤ Str})} ⟹ ε → ζ → η ≤ Bool → δ
//│             ε → ζ → η ≤ Bool → δ
//│               Bool ≤ ε
//│                 Bool ≤ (Int ⟹ {η ≥ Int, ζ ≤ Int}) ∨ (Str ⟹ {η ≥ Str, ζ ≤ Str})
//│                   Bool ≤ Int ⟹ {η ≥ Int, ζ ≤ Int}
//│                     Bool ≤ Int
//│                       Bool ≤ ⊥
//│                         ⊤ ≤ ⊥
//│                   Bool ≤ Str ⟹ {η ≥ Str, ζ ≤ Str}
//│                     Bool ≤ Str
//│                       Bool ≤ ⊥
//│                         ⊤ ≤ ⊥

fun bop(a, b) =
  let x = baz(a, b)
  x
//│ bop: ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str})} ⟹ α → β → γ

bop(0, 1)
//│ Int

bop("0", "1")
//│ Str

:e
bop(0, "1")
//│ ═══[ERROR] Cannot solve judgment Int → Int ≤ Str → α.
//│ Typing error tree:
//│   Int → Int ≤ Str → α
//│     Str ≤ Int
//│       ⊤ ≤ Int
//│         ⊤ ≤ ⊥
