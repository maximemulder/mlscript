:ctml

:ctml-cfg cache-all

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α. α → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀α, β, γ. {β ≤ ({γ ≥ Int, α ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, α ≤ Str} ⟹ Str), α ≤ ({γ ≥ Int, β ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, β ≤ Str} ⟹ Str), γ ≥ ({β ≤ Int, α ≤ Int} ⟹ Int) ∧ ({β ≤ Str, α ≤ Str} ⟹ Str)} ⟹ α → β → γ

baz(1, 1)
//│ Int ∧ ({Int ≤ Str, Int ≤ Str} ⟹ Str)
//│

baz("", "")
//│ ({Str ≤ Int, Str ≤ Int} ⟹ Int) ∧ Str
//│

baz(bot, bot)
//│ ⊥
//│

:te
baz(1, "")
//│ ({Str ≤ Int} ⟹ Int) ∧ ({Int ≤ Str} ⟹ Str)
//│ FAILURE: Unexpected lack of type error
//│

:te
baz(true, false)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {β ≤ ({γ ≥ Int, α ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, α ≤ Str} ⟹ Str), α ≤ ({γ ≥ Int, β ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, β ≤ Str} ⟹ Str), γ ≥ ({β ≤ Int, α ≤ Int} ⟹ Int) ∧ ({β ≤ Str, α ≤ Str} ⟹ Str)} ⟹ α → β → γ ≤ Bool → δ.
//│ Typing error tree:
//│   ∀α, β, γ. {β ≤ ({γ ≥ Int, α ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, α ≤ Str} ⟹ Str), α ≤ ({γ ≥ Int, β ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, β ≤ Str} ⟹ Str), γ ≥ ({β ≤ Int, α ≤ Int} ⟹ Int) ∧ ({β ≤ Str, α ≤ Str} ⟹ Str)} ⟹ α → β → γ ≤ Bool → δ
//│     {ζ ≤ ({η ≥ Int, ε ≤ Int} ⟹ Int) ∨ ({η ≥ Str, ε ≤ Str} ⟹ Str), ε ≤ ({η ≥ Int, ζ ≤ Int} ⟹ Int) ∨ ({η ≥ Str, ζ ≤ Str} ⟹ Str), η ≥ ({ζ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({ζ ≤ Str, ε ≤ Str} ⟹ Str)} ⟹ ε → ζ → η ≤ Bool → δ
//│       {ε ≤ ({η ≥ Int, ζ ≤ Int} ⟹ Int) ∨ ({η ≥ Str, ζ ≤ Str} ⟹ Str), η ≥ ({ζ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({ζ ≤ Str, ε ≤ Str} ⟹ Str)} ⟹ ε → ζ → η ≤ Bool → δ
//│         {η ≥ ({ζ ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({ζ ≤ Str, ε ≤ Str} ⟹ Str)} ⟹ ε → ζ → η ≤ Bool → δ
//│           ε → ζ → η ≤ Bool → δ
//│             Bool ≤ ε
//│               Bool ≤ ({η ≥ Int, ζ ≤ Int} ⟹ Int) ∨ ({η ≥ Str, ζ ≤ Str} ⟹ Str)
//│                 Bool ≤ {η ≥ Int, ζ ≤ Int} ⟹ Int
//│                   Bool ≤ {ζ ≤ Int} ⟹ Int
//│                     Bool ≤ Int
//│                 Bool ≤ {η ≥ Str, ζ ≤ Str} ⟹ Str
//│                   Bool ≤ {ζ ≤ Str} ⟹ Str
//│                     Bool ≤ Str
//│

fun bop(a, b) =
  let x = baz(a, b)
  x
//│ bop: ∀α, β, γ, δ. {β ≤ ({δ ≥ Int, α ≤ Int} ⟹ Int) ∨ ({δ ≥ Str, α ≤ Str} ⟹ Str), γ ≤ ({δ ≥ Int, α ≤ Int} ⟹ Int) ∨ ({δ ≥ Str, α ≤ Str} ⟹ Str), δ ≥ ({γ ≤ Int, α ≤ Int} ⟹ Int) ∧ ({γ ≤ Str, α ≤ Str} ⟹ Str), α ≤ ({δ ≥ Int, γ ≤ Int} ⟹ Int) ∨ ({δ ≥ Str, γ ≤ Str} ⟹ Str), γ ≥ β} ⟹ α → β → (({γ ≤ Int, α ≤ Int} ⟹ Int) ∧ ({γ ≤ Str, α ≤ Str} ⟹ Str))
//│

:fixme
// bop(0, 1)
//│

:fixme
// bop("0", "1")
//│

:fixme
:te
// bop(0, "1")
//│
