:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α. α → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀α, β, γ, δ. {α ≤ ({β ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({γ ≥ δ, δ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥), β ≤ Str, δ ≥ Str} ⟹ Str), δ ≥ ({α ≤ Int, β ≤ Int, γ ≥ Int} ⟹ ⊥) ∧ ({α ≤ {β ≤ Str, δ ≥ Str} ⟹ Str, γ ≥ δ} ⟹ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ {β ≤ Str, δ ≥ Str} ⟹ Str, δ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ δ)} ⟹ α → β → γ

baz(1, 1)
//│ Int

baz("", "")
//│ Str

baz(bot, bot)
//│ ∀α, β. {β ≥ Int ∧ α, α ≥ ({β ≥ Int} ⟹ ⊥) ∧ ({β ≥ α} ⟹ ⊥)} ⟹ β

:te
baz(1, "")
//│ ═══[TYPE ERROR] Cannot solve judgment Int ≤ Str.
//│ Typing error tree:
//│   Int ≤ Str

:te
baz(true, false)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ, δ. {α ≤ ({β ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({γ ≥ δ, δ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥), β ≤ Str, δ ≥ Str} ⟹ Str), δ ≥ ({α ≤ Int, β ≤ Int, γ ≥ Int} ⟹ ⊥) ∧ ({α ≤ {β ≤ Str, δ ≥ Str} ⟹ Str, γ ≥ δ} ⟹ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ {β ≤ Str, δ ≥ Str} ⟹ Str, δ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ δ)} ⟹ α → β → γ ≤ Bool → ε.
//│ Typing error tree:
//│   ∀α, β, γ, δ. {α ≤ ({β ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({γ ≥ δ, δ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥), β ≤ Str, δ ≥ Str} ⟹ Str), δ ≥ ({α ≤ Int, β ≤ Int, γ ≥ Int} ⟹ ⊥) ∧ ({α ≤ {β ≤ Str, δ ≥ Str} ⟹ Str, γ ≥ δ} ⟹ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ {β ≤ Str, δ ≥ Str} ⟹ Str, δ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ δ)} ⟹ α → β → γ ≤ Bool → ε
//│     {ζ ≤ ({η ≤ Int, θ ≥ Int} ⟹ Int) ∨ ({θ ≥ ι, ι ≥ ({ζ ≤ Str, η ≤ Str} ⟹ Str) ∧ ({ζ ≤ ⊥} ⟹ ⊥), η ≤ Str, ι ≥ Str} ⟹ Str), ι ≥ ({ζ ≤ Int, η ≤ Int, θ ≥ Int} ⟹ ⊥) ∧ ({ζ ≤ {η ≤ Str, ι ≥ Str} ⟹ Str, θ ≥ ι} ⟹ ({ζ ≤ Str, η ≤ Str} ⟹ Str) ∧ ({ζ ≤ ⊥} ⟹ ⊥)), θ ≥ ({ζ ≤ Int, η ≤ Int} ⟹ Int) ∧ ({ζ ≤ {η ≤ Str, ι ≥ Str} ⟹ Str, ι ≥ ({ζ ≤ Str, η ≤ Str} ⟹ Str) ∧ ({ζ ≤ ⊥} ⟹ ⊥)} ⟹ ι)} ⟹ ζ → η → θ ≤ Bool → ε
//│       {ι ≥ ({ζ ≤ Int, η ≤ Int, θ ≥ Int} ⟹ ⊥) ∧ ({ζ ≤ {η ≤ Str, ι ≥ Str} ⟹ Str, θ ≥ ι} ⟹ ({ζ ≤ Str, η ≤ Str} ⟹ Str) ∧ ({ζ ≤ ⊥} ⟹ ⊥)), θ ≥ ({ζ ≤ Int, η ≤ Int} ⟹ Int) ∧ ({ζ ≤ {η ≤ Str, ι ≥ Str} ⟹ Str, ι ≥ ({ζ ≤ Str, η ≤ Str} ⟹ Str) ∧ ({ζ ≤ ⊥} ⟹ ⊥)} ⟹ ι)} ⟹ ζ → η → θ ≤ Bool → ε
//│         {θ ≥ ({ζ ≤ Int, η ≤ Int} ⟹ Int) ∧ ({ζ ≤ {η ≤ Str, ι ≥ Str} ⟹ Str, ι ≥ ({ζ ≤ Str, η ≤ Str} ⟹ Str) ∧ ({ζ ≤ ⊥} ⟹ ⊥)} ⟹ ι)} ⟹ ζ → η → θ ≤ Bool → ε
//│           ζ → η → θ ≤ Bool → ε
//│             Bool ≤ ζ
//│               Bool ≤ ({η ≤ Int, θ ≥ Int} ⟹ Int) ∨ ({θ ≥ ι, ι ≥ ({ζ ≤ Str, η ≤ Str} ⟹ Str) ∧ ({ζ ≤ ⊥} ⟹ ⊥), η ≤ Str, ι ≥ Str} ⟹ Str)
//│                 Bool ≤ {η ≤ Int, θ ≥ Int} ⟹ Int
//│                   Bool ≤ {θ ≥ Int} ⟹ Int
//│                     Bool ≤ Int
//│                 Bool ≤ {θ ≥ ι, ι ≥ ({ζ ≤ Str, η ≤ Str} ⟹ Str) ∧ ({ζ ≤ ⊥} ⟹ ⊥), η ≤ Str, ι ≥ Str} ⟹ Str
//│                   Bool ≤ {ι ≥ ({ζ ≤ Str, η ≤ Str} ⟹ Str) ∧ ({ζ ≤ ⊥} ⟹ ⊥), η ≤ Str, ι ≥ Str} ⟹ Str
//│                     Bool ≤ {η ≤ Str, ι ≥ Str} ⟹ Str
//│                       Bool ≤ {ι ≥ Str} ⟹ Str
//│                         Bool ≤ Str

fun bop(a, b) =
  let x = baz(a, b)
  x
//│ bop: ∀α, β, γ, δ, ε. {γ ≥ α, α ≤ ({β ≤ Int, δ ≥ Int} ⟹ Int) ∨ ({δ ≥ ε, ε ≥ ({γ ≤ Str, β ≤ Str} ⟹ Str) ∧ ({γ ≤ ⊥} ⟹ ⊥), β ≤ Str, ε ≥ Str} ⟹ Str), δ ≥ ({γ ≤ Int, β ≤ Int} ⟹ Int) ∧ ({γ ≤ {β ≤ Str, ε ≥ Str} ⟹ Str, ε ≥ ({γ ≤ Str, β ≤ Str} ⟹ Str) ∧ ({γ ≤ ⊥} ⟹ ⊥)} ⟹ ε), ε ≥ ({γ ≤ Int, β ≤ Int, δ ≥ Int} ⟹ ⊥) ∧ ({γ ≤ {β ≤ Str, ε ≥ Str} ⟹ Str, δ ≥ ε} ⟹ ({γ ≤ Str, β ≤ Str} ⟹ Str) ∧ ({γ ≤ ⊥} ⟹ ⊥)), γ ≤ ({β ≤ Int, δ ≥ Int} ⟹ Int) ∨ ({δ ≥ ε, ε ≥ ({γ ≤ Str, β ≤ Str} ⟹ Str) ∧ ({γ ≤ ⊥} ⟹ ⊥), β ≤ Str, ε ≥ Str} ⟹ Str)} ⟹ α → β → δ

bop(0, 1)
//│ Int

bop("0", "1")
//│ ∀α, β. {β ≥ α, α ≥ {β ≥ α} ⟹ Str} ⟹ β

:te
bop(0, "1")
//│ ═══[TYPE ERROR] Cannot solve judgment Int ≤ Str.
//│ Typing error tree:
//│   Int ≤ Str
