:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α. α → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀α, β, γ. α → β → ({β ≤ ({γ ≥ Int, α ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, α ≤ Str} ⟹ Str), α ≤ ({γ ≥ Int, β ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, β ≤ Str} ⟹ Str), γ ≥ ({β ≤ Int, α ≤ Int} ⟹ Int) ∧ ({β ≤ Str, α ≤ Str} ⟹ Str)} ⟹ γ)

baz(1, 1)
//│ ∀α. {α ≥ Int} ⟹ α
//│

baz("", "")
//│ ∀α. {α ≥ Str} ⟹ α
//│

baz(bot, bot)
//│ ∀α. α
//│

:te
baz(1, "")
//│ ∀α. {α ≥ {Str ≤ Int} ⟹ Int} ⟹ α
//│ FAILURE: Unexpected lack of type error
//│

:te
baz(true, false)
//│ ∀α. {Bool ≤ ({α ≥ Int} ⟹ Int) ∨ ({α ≥ Str} ⟹ Str), Bool ≤ ({α ≥ Int} ⟹ Int) ∨ ({α ≥ Str} ⟹ Str), α ≥ {Bool ≤ Str, Bool ≤ Str} ⟹ Str} ⟹ α
//│ FAILURE: Unexpected lack of type error
//│

fun bop(a, b) =
  let x = baz(a, b)
  x
//│ bop: ∀α, β, γ. α → β → ({β ≤ ({γ ≥ Int} ⟹ Int) ∨ ({γ ≥ Str} ⟹ Str), α ≤ ({γ ≥ Int} ⟹ Int) ∨ ({γ ≥ Str} ⟹ Str), γ ≥ ({β ≤ Int, α ≤ Int} ⟹ Int) ∧ ({β ≤ Str, α ≤ Str} ⟹ Str)} ⟹ γ)
//│

bop(0, 1)
//│ ∀α. {α ≥ Int} ⟹ α
//│

bop("0", "1")
//│ ∀α. {α ≥ Str} ⟹ α
//│

:te
bop(0, "1")
//│ ∀α. {α ≥ {Str ≤ Int} ⟹ Int} ⟹ α
//│ FAILURE: Unexpected lack of type error
//│
