:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α. α → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀α, β, γ. {β ≤ ({γ ≥ Int, α ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, α ≤ Str} ⟹ Str), α ≤ ({γ ≥ Int, β ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, β ≤ Str} ⟹ Str), γ ≥ ({β ≤ Int, α ≤ Int} ⟹ Int) ∧ ({β ≤ Str, α ≤ Str} ⟹ Str)} ⟹ α → β → γ

baz(1, 1)
//│ Int
//│

baz("", "")
//│ Str
//│

baz(bot, bot)
//│ ⊥
//│

:te
baz(1, "")
//│ ═══[TYPE ERROR] Cannot solve judgment Str ≤ Int.
//│ Typing error tree:
//│   Str ≤ Int
//│

:te
baz(true, false)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α. {α ≤ {Bool ≤ Str} ⟹ Str, α ≤ Str, Bool ≤ Str} ⟹ α → Str ≤ Bool → β.
//│ Typing error tree:
//│   ∀α. {α ≤ {Bool ≤ Str} ⟹ Str, α ≤ Str, Bool ≤ Str} ⟹ α → Str ≤ Bool → β
//│     {γ ≤ {Bool ≤ Str} ⟹ Str, γ ≤ Str, Bool ≤ Str} ⟹ γ → Str ≤ Bool → β
//│       {γ ≤ Str, Bool ≤ Str} ⟹ γ → Str ≤ Bool → β
//│         {Bool ≤ Str} ⟹ γ → Str ≤ Bool → β
//│           Bool ≤ Str
//│

fun bop(a, b) =
  let x = baz(a, b)
  x
//│ bop: ∀α, β, γ, δ. {β ≤ ({δ ≥ Int, α ≤ Int} ⟹ Int) ∨ ({δ ≥ Str, α ≤ Str} ⟹ Str), γ ≤ ({δ ≥ Int, α ≤ Int} ⟹ Int) ∨ ({δ ≥ Str, α ≤ Str} ⟹ Str), δ ≥ ({γ ≤ Int, α ≤ Int} ⟹ Int) ∧ ({γ ≤ Str, α ≤ Str} ⟹ Str), α ≤ ({δ ≥ Int, γ ≤ Int} ⟹ Int) ∨ ({δ ≥ Str, γ ≤ Str} ⟹ Str), γ ≥ β} ⟹ α → β → (({γ ≤ Int, α ≤ Int} ⟹ Int) ∧ ({γ ≤ Str, α ≤ Str} ⟹ Str))
//│

