:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α. α → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀α, β, γ. {α ≤ ({β ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({γ ≥ ∀δ. {α ≤ {β ≤ Str, δ ≥ Str} ⟹ Str, δ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ δ} ⟹ ¬Int), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ (∀δ. {α ≤ ¬Int, α ≤ {β ≤ Str, δ ≥ Str} ⟹ Str, δ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ δ)} ⟹ α → β → γ

baz(1, 1)
//│ Int

baz("", "")
//│ ∀α. {α ≥ Str} ⟹ α

baz(bot, bot)
//│ ∀α. α

:te
baz(1, "")
//│ ∀α. {Int ≤ ¬Int, Int ≤ {α ≥ Str} ⟹ Str, α ≥ {Int ≤ ⊥} ⟹ ⊥} ⟹ α
//│ FAILURE: Unexpected lack of type error

:te
baz(true, false)
//│ ∀α. {α ≥ {Bool ≤ ⊥} ⟹ ⊥} ⟹ α
//│ FAILURE: Unexpected lack of type error

fun bop(a, b) =
  let x = baz(a, b)
  x
//│ bop: ∀α, β. α → β → (({α ≤ Int, β ≤ Int} ⟹ Int) ∧ (∀γ. {α ≤ ¬Int, α ≤ {β ≤ Str, γ ≥ Str} ⟹ Str, γ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ γ))

bop(0, 1)
//│ ∀α, β, γ. {α ≥ {Int → γ ≥ β → ({α ≤ Int, β ≤ Int} ⟹ Int)} ⟹ Int, β ≥ ({γ ≥ {α ≤ Int, β ≤ Int} ⟹ Int} ⟹ Int) ∧ ({γ ≥ ∀δ. {α ≤ ¬Int, α ≤ {β ≤ Str, δ ≥ Str} ⟹ Str, δ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ δ} ⟹ Int), γ ≥ ({β ≥ Int, α ≤ Int, β ≤ Int} ⟹ Int) ∧ (∀δ. {β ≥ Int, α ≤ ¬Int, α ≤ {β ≤ Str, δ ≥ Str} ⟹ Str, δ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ δ)} ⟹ γ

bop("0", "1")
//│ ∀α. {α ≥ Str} ⟹ α

:te
bop(0, "1")
