:ctml

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α. α → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀α, β, γ. α → β → ({α ≤ ({β ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({β ≤ Str, γ ≥ Str} ⟹ Str), β ≤ ({α ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({α ≤ Str, γ ≥ Str} ⟹ Str), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ Str, β ≤ Str} ⟹ Str)} ⟹ γ)

baz(1, 1)
//│ ∀α. {α ≥ Int ∧ ({Int ≤ Str, Int ≤ Str} ⟹ Str)} ⟹ α

baz("", "")
//│ ∀α. {α ≥ ({Str ≤ Int, Str ≤ Int} ⟹ Int) ∧ Str} ⟹ α

baz(bot, bot)
//│ ⊥

:te
baz(1, "")
//│ ∀α. {α ≥ ({Str ≤ Int} ⟹ Int) ∧ ({Int ≤ Str} ⟹ Str)} ⟹ α
//│ FAILURE: Unexpected lack of type error

:te
baz(true, false)
//│ ∀α. {Bool ≤ ({Bool ≤ Int, α ≥ Int} ⟹ Int) ∨ ({Bool ≤ Str, α ≥ Str} ⟹ Str), Bool ≤ ({Bool ≤ Int, α ≥ Int} ⟹ Int) ∨ ({Bool ≤ Str, α ≥ Str} ⟹ Str), α ≥ ({Bool ≤ Int, Bool ≤ Int} ⟹ Int) ∧ ({Bool ≤ Str, Bool ≤ Str} ⟹ Str)} ⟹ α
//│ FAILURE: Unexpected lack of type error

fun bop(a, b) =
  let x = baz(a, b)
  x
//│ bop: ∀α, β, γ. α → β → ({α ≤ ({β ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({β ≤ Str, γ ≥ Str} ⟹ Str), β ≤ ({α ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({α ≤ Str, γ ≥ Str} ⟹ Str), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ Str, β ≤ Str} ⟹ Str)} ⟹ γ)

:fixme
bop(0, 1)
//│ ∀α. {α ≥ Int ∧ ({Int ≤ Str, Int ≤ Str} ⟹ Str)} ⟹ α
//│ FAILURE: Unexpected lack of error to fix

:fixme
bop("0", "1")
//│ ∀α. {α ≥ ({Str ≤ Int, Str ≤ Int} ⟹ Int) ∧ Str} ⟹ α
//│ FAILURE: Unexpected lack of error to fix

:fixme
:te
bop(0, "1")
//│ ∀α. {α ≥ ({Str ≤ Int} ⟹ Int) ∧ ({Int ≤ Str} ⟹ Str)} ⟹ α
//│ FAILURE: Unexpected lack of type error
//│ FAILURE: Unexpected lack of error to fix
