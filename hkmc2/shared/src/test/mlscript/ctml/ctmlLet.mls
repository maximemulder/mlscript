:ctml

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α, β, γ, δ, ε. {α ≥ β, β ≥ γ, β ≤ α, γ ≥ ε, γ ≤ β, δ ≤ ε, ε ≥ δ, ε ≤ γ} ⟹ δ → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀α, β, γ, δ, ε. {α ≤ (Int ⟹ {δ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {δ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {δ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {δ ≥ Str, α ≤ Str}), γ ≥ ε, δ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ Str}), δ ≤ ε, ε ≥ δ, ε ≤ γ} ⟹ α → β → γ

baz(1, 1)
//│ Int

baz("", "")
//│ Str

baz(bot, bot)
//│ ⊥

:e
baz(1, "")
//│ ═══[ERROR] Cannot solve judgment ∀α, β, γ, δ. {α ≤ Int ⟹ {Int ∨ (Str ⟹ {γ ≥ Str, α ≤ Str}) ≤ Int}, β ≥ δ, γ ≥ Int, γ ≤ δ, δ ≥ γ, δ ≤ β} ⟹ α → β ≤ Str → ε.
//│ Typing error tree:
//│   ∀α, β, γ, δ. {α ≤ Int ⟹ {Int ∨ (Str ⟹ {γ ≥ Str, α ≤ Str}) ≤ Int}, β ≥ δ, γ ≥ Int, γ ≤ δ, δ ≥ γ, δ ≤ β} ⟹ α → β ≤ Str → ε
//│     ∀β, γ, δ. {ζ ≤ Int ⟹ {Int ∨ (Str ⟹ {γ ≥ Str, ζ ≤ Str}) ≤ Int}, β ≥ δ, γ ≥ Int, γ ≤ δ, δ ≥ γ, δ ≤ β} ⟹ ζ → β ≤ Str → ε
//│       ∀γ, δ. {ζ ≤ Int ⟹ {Int ∨ (Str ⟹ {γ ≥ Str, ζ ≤ Str}) ≤ Int}, η ≥ δ, γ ≥ Int, γ ≤ δ, δ ≥ γ, δ ≤ η} ⟹ ζ → η ≤ Str → ε
//│         ∀δ. {ζ ≤ Int ⟹ {Int ∨ (Str ⟹ {θ ≥ Str, ζ ≤ Str}) ≤ Int}, η ≥ δ, θ ≥ Int, θ ≤ δ, δ ≥ θ, δ ≤ η} ⟹ ζ → η ≤ Str → ε
//│           {ζ ≤ Int ⟹ {Int ∨ (Str ⟹ {θ ≥ Str, ζ ≤ Str}) ≤ Int}, η ≥ ι, θ ≥ Int, θ ≤ ι, ι ≥ θ, ι ≤ η} ⟹ ζ → η ≤ Str → ε
//│             {η ≥ ι, θ ≥ Int, θ ≤ ι, ι ≥ θ, ι ≤ η} ⟹ ζ → η ≤ Str → ε
//│               {θ ≥ Int, θ ≤ ι, ι ≥ θ, ι ≤ η} ⟹ ζ → η ≤ Str → ε
//│                 {θ ≤ ι, ι ≥ θ, ι ≤ η} ⟹ ζ → η ≤ Str → ε
//│                   {ι ≥ θ, ι ≤ η} ⟹ ζ → η ≤ Str → ε
//│                     {ι ≤ η} ⟹ ζ → η ≤ Str → ε
//│                       ζ → η ≤ Str → ε
//│                         Str ≤ ζ
//│                           Str ≤ Int

:e
baz(true, false)
//│ ═══[ERROR] Cannot solve judgment ∀α, β, γ, δ, ε. {α ≤ (Int ⟹ {δ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {δ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {δ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {δ ≥ Str, α ≤ Str}), γ ≥ ε, δ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ Str}), δ ≤ ε, ε ≥ δ, ε ≤ γ} ⟹ α → β → γ ≤ Bool → ζ.
//│ Typing error tree:
//│   ∀α, β, γ, δ, ε. {α ≤ (Int ⟹ {δ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {δ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {δ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {δ ≥ Str, α ≤ Str}), γ ≥ ε, δ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∧ (Str ⟹ {β ≤ Str, α ≤ Str}), δ ≤ ε, ε ≥ δ, ε ≤ γ} ⟹ α → β → γ ≤ Bool → ζ
//│     ∀β, γ, δ, ε. {η ≤ (Int ⟹ {δ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {δ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {δ ≥ Int, η ≤ Int}) ∨ (Str ⟹ {δ ≥ Str, η ≤ Str}), γ ≥ ε, δ ≥ (Int ⟹ {β ≤ Int, η ≤ Int}) ∧ (Str ⟹ {β ≤ Str, η ≤ Str}), δ ≤ ε, ε ≥ δ, ε ≤ γ} ⟹ η → β → γ ≤ Bool → ζ
//│       ∀γ, δ, ε. {η ≤ (Int ⟹ {δ ≥ Int, θ ≤ Int}) ∨ (Str ⟹ {δ ≥ Str, θ ≤ Str}), θ ≤ (Int ⟹ {δ ≥ Int, η ≤ Int}) ∨ (Str ⟹ {δ ≥ Str, η ≤ Str}), γ ≥ ε, δ ≥ (Int ⟹ {θ ≤ Int, η ≤ Int}) ∧ (Str ⟹ {θ ≤ Str, η ≤ Str}), δ ≤ ε, ε ≥ δ, ε ≤ γ} ⟹ η → θ → γ ≤ Bool → ζ
//│         ∀δ, ε. {η ≤ (Int ⟹ {δ ≥ Int, θ ≤ Int}) ∨ (Str ⟹ {δ ≥ Str, θ ≤ Str}), θ ≤ (Int ⟹ {δ ≥ Int, η ≤ Int}) ∨ (Str ⟹ {δ ≥ Str, η ≤ Str}), ι ≥ ε, δ ≥ (Int ⟹ {θ ≤ Int, η ≤ Int}) ∧ (Str ⟹ {θ ≤ Str, η ≤ Str}), δ ≤ ε, ε ≥ δ, ε ≤ ι} ⟹ η → θ → ι ≤ Bool → ζ
//│           ∀ε. {η ≤ (Int ⟹ {κ ≥ Int, θ ≤ Int}) ∨ (Str ⟹ {κ ≥ Str, θ ≤ Str}), θ ≤ (Int ⟹ {κ ≥ Int, η ≤ Int}) ∨ (Str ⟹ {κ ≥ Str, η ≤ Str}), ι ≥ ε, κ ≥ (Int ⟹ {θ ≤ Int, η ≤ Int}) ∧ (Str ⟹ {θ ≤ Str, η ≤ Str}), κ ≤ ε, ε ≥ κ, ε ≤ ι} ⟹ η → θ → ι ≤ Bool → ζ
//│             {η ≤ (Int ⟹ {κ ≥ Int, θ ≤ Int}) ∨ (Str ⟹ {κ ≥ Str, θ ≤ Str}), θ ≤ (Int ⟹ {κ ≥ Int, η ≤ Int}) ∨ (Str ⟹ {κ ≥ Str, η ≤ Str}), ι ≥ λ, κ ≥ (Int ⟹ {θ ≤ Int, η ≤ Int}) ∧ (Str ⟹ {θ ≤ Str, η ≤ Str}), κ ≤ λ, λ ≥ κ, λ ≤ ι} ⟹ η → θ → ι ≤ Bool → ζ
//│               {θ ≤ (Int ⟹ {κ ≥ Int, η ≤ Int}) ∨ (Str ⟹ {κ ≥ Str, η ≤ Str}), ι ≥ λ, κ ≥ (Int ⟹ {θ ≤ Int, η ≤ Int}) ∧ (Str ⟹ {θ ≤ Str, η ≤ Str}), κ ≤ λ, λ ≥ κ, λ ≤ ι} ⟹ η → θ → ι ≤ Bool → ζ
//│                 {ι ≥ λ, κ ≥ (Int ⟹ {θ ≤ Int, η ≤ Int}) ∧ (Str ⟹ {θ ≤ Str, η ≤ Str}), κ ≤ λ, λ ≥ κ, λ ≤ ι} ⟹ η → θ → ι ≤ Bool → ζ
//│                   {κ ≥ (Int ⟹ {θ ≤ Int, η ≤ Int}) ∧ (Str ⟹ {θ ≤ Str, η ≤ Str}), κ ≤ λ, λ ≥ κ, λ ≤ ι} ⟹ η → θ → ι ≤ Bool → ζ
//│                     {κ ≤ λ, λ ≥ κ, λ ≤ ι} ⟹ η → θ → ι ≤ Bool → ζ
//│                       {λ ≥ κ, λ ≤ ι} ⟹ η → θ → ι ≤ Bool → ζ
//│                         {λ ≤ ι} ⟹ η → θ → ι ≤ Bool → ζ
//│                           η → θ → ι ≤ Bool → ζ
//│                             Bool ≤ η
//│                               Bool ≤ (Int ⟹ {κ ≥ Int, θ ≤ Int}) ∨ (Str ⟹ {κ ≥ Str, θ ≤ Str})
//│                                 Bool ≤ Int ⟹ {κ ≥ Int, θ ≤ Int}
//│                                   Bool ≤ Int ⟹ {θ ≤ Int}
//│                                     Bool ≤ Int
//│                                 Bool ≤ Str ⟹ {κ ≥ Str, θ ≤ Str}
//│                                   Bool ≤ Str ⟹ {θ ≤ Str}
//│                                     Bool ≤ Str

fun bop(a, b) =
  let x = baz(a, b)
  x
//│ bop: ∀α, β, γ, δ, ε, ζ, η, θ, ι, κ. {α ≤ β, β ≥ α, β ≤ (Int ⟹ {ι ≥ Int, δ ≤ Int}) ∨ (Str ⟹ {ι ≥ Str, δ ≤ Str}), γ ≤ δ, δ ≥ γ, δ ≤ (Int ⟹ {ι ≥ Int, β ≤ Int}) ∨ (Str ⟹ {ι ≥ Str, β ≤ Str}), ε ≥ ζ, ζ ≥ η, ζ ≤ ε, η ≥ θ, η ≤ ζ, θ ≥ κ, θ ≤ η, ι ≥ (Int ⟹ {δ ≤ Int, β ≤ Int}) ∧ (Str ⟹ {δ ≤ Str, β ≤ Str}), ι ≤ κ, κ ≥ ι, κ ≤ θ} ⟹ α → γ → ε

bop(0, 1)
//│ Int

bop("0", "1")
//│ Str

:e
bop(0, "1")
//│ ═══[ERROR] Cannot solve judgment ∀α, β, γ, δ, ε, ζ, η. {α ≤ Int ⟹ {Int ∨ (Str ⟹ {ζ ≥ Str, α ≤ Str}) ≤ Int}, β ≥ γ, γ ≥ δ, γ ≤ β, δ ≥ ε, δ ≤ γ, ε ≥ η, ε ≤ δ, ζ ≥ Int, ζ ≤ η, η ≥ ζ, η ≤ ε} ⟹ α → β ≤ Str → θ.
//│ Typing error tree:
//│   ∀α, β, γ, δ, ε, ζ, η. {α ≤ Int ⟹ {Int ∨ (Str ⟹ {ζ ≥ Str, α ≤ Str}) ≤ Int}, β ≥ γ, γ ≥ δ, γ ≤ β, δ ≥ ε, δ ≤ γ, ε ≥ η, ε ≤ δ, ζ ≥ Int, ζ ≤ η, η ≥ ζ, η ≤ ε} ⟹ α → β ≤ Str → θ
//│     ∀β, γ, δ, ε, ζ, η. {ι ≤ Int ⟹ {Int ∨ (Str ⟹ {ζ ≥ Str, ι ≤ Str}) ≤ Int}, β ≥ γ, γ ≥ δ, γ ≤ β, δ ≥ ε, δ ≤ γ, ε ≥ η, ε ≤ δ, ζ ≥ Int, ζ ≤ η, η ≥ ζ, η ≤ ε} ⟹ ι → β ≤ Str → θ
//│       ∀γ, δ, ε, ζ, η. {ι ≤ Int ⟹ {Int ∨ (Str ⟹ {ζ ≥ Str, ι ≤ Str}) ≤ Int}, κ ≥ γ, γ ≥ δ, γ ≤ κ, δ ≥ ε, δ ≤ γ, ε ≥ η, ε ≤ δ, ζ ≥ Int, ζ ≤ η, η ≥ ζ, η ≤ ε} ⟹ ι → κ ≤ Str → θ
//│         ∀δ, ε, ζ, η. {ι ≤ Int ⟹ {Int ∨ (Str ⟹ {ζ ≥ Str, ι ≤ Str}) ≤ Int}, κ ≥ λ, λ ≥ δ, λ ≤ κ, δ ≥ ε, δ ≤ λ, ε ≥ η, ε ≤ δ, ζ ≥ Int, ζ ≤ η, η ≥ ζ, η ≤ ε} ⟹ ι → κ ≤ Str → θ
//│           ∀ε, ζ, η. {ι ≤ Int ⟹ {Int ∨ (Str ⟹ {ζ ≥ Str, ι ≤ Str}) ≤ Int}, κ ≥ λ, λ ≥ μ, λ ≤ κ, μ ≥ ε, μ ≤ λ, ε ≥ η, ε ≤ μ, ζ ≥ Int, ζ ≤ η, η ≥ ζ, η ≤ ε} ⟹ ι → κ ≤ Str → θ
//│             ∀ζ, η. {ι ≤ Int ⟹ {Int ∨ (Str ⟹ {ζ ≥ Str, ι ≤ Str}) ≤ Int}, κ ≥ λ, λ ≥ μ, λ ≤ κ, μ ≥ ν, μ ≤ λ, ν ≥ η, ν ≤ μ, ζ ≥ Int, ζ ≤ η, η ≥ ζ, η ≤ ν} ⟹ ι → κ ≤ Str → θ
//│               ∀η. {ι ≤ Int ⟹ {Int ∨ (Str ⟹ {ξ ≥ Str, ι ≤ Str}) ≤ Int}, κ ≥ λ, λ ≥ μ, λ ≤ κ, μ ≥ ν, μ ≤ λ, ν ≥ η, ν ≤ μ, ξ ≥ Int, ξ ≤ η, η ≥ ξ, η ≤ ν} ⟹ ι → κ ≤ Str → θ
//│                 {ι ≤ Int ⟹ {Int ∨ (Str ⟹ {ξ ≥ Str, ι ≤ Str}) ≤ Int}, κ ≥ λ, λ ≥ μ, λ ≤ κ, μ ≥ ν, μ ≤ λ, ν ≥ ο, ν ≤ μ, ξ ≥ Int, ξ ≤ ο, ο ≥ ξ, ο ≤ ν} ⟹ ι → κ ≤ Str → θ
//│                   {κ ≥ λ, λ ≥ μ, λ ≤ κ, μ ≥ ν, μ ≤ λ, ν ≥ ο, ν ≤ μ, ξ ≥ Int, ξ ≤ ο, ο ≥ ξ, ο ≤ ν} ⟹ ι → κ ≤ Str → θ
//│                     {λ ≥ μ, λ ≤ κ, μ ≥ ν, μ ≤ λ, ν ≥ ο, ν ≤ μ, ξ ≥ Int, ξ ≤ ο, ο ≥ ξ, ο ≤ ν} ⟹ ι → κ ≤ Str → θ
//│                       {λ ≤ κ, μ ≥ ν, μ ≤ λ, ν ≥ ο, ν ≤ μ, ξ ≥ Int, ξ ≤ ο, ο ≥ ξ, ο ≤ ν} ⟹ ι → κ ≤ Str → θ
//│                         {μ ≥ ν, μ ≤ λ, ν ≥ ο, ν ≤ μ, ξ ≥ Int, ξ ≤ ο, ο ≥ ξ, ο ≤ ν} ⟹ ι → κ ≤ Str → θ
//│                           {μ ≤ λ, ν ≥ ο, ν ≤ μ, ξ ≥ Int, ξ ≤ ο, ο ≥ ξ, ο ≤ ν} ⟹ ι → κ ≤ Str → θ
//│                             {ν ≥ ο, ν ≤ μ, ξ ≥ Int, ξ ≤ ο, ο ≥ ξ, ο ≤ ν} ⟹ ι → κ ≤ Str → θ
//│                               {ν ≤ μ, ξ ≥ Int, ξ ≤ ο, ο ≥ ξ, ο ≤ ν} ⟹ ι → κ ≤ Str → θ
//│                                 {ξ ≥ Int, ξ ≤ ο, ο ≥ ξ, ο ≤ ν} ⟹ ι → κ ≤ Str → θ
//│                                   {ξ ≤ ο, ο ≥ ξ, ο ≤ ν} ⟹ ι → κ ≤ Str → θ
//│                                     {ο ≥ ξ, ο ≤ ν} ⟹ ι → κ ≤ Str → θ
//│                                       {ο ≤ ν} ⟹ ι → κ ≤ Str → θ
//│                                         ι → κ ≤ Str → θ
//│                                           Str ≤ ι
//│                                             Str ≤ Int
