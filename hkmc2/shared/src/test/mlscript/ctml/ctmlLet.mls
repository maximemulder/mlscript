:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α. α → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀α, β, γ. {α ≤ ({γ ≥ Int, β ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, β ≤ Str} ⟹ Str), β ≤ ({γ ≥ Int, α ≤ Int} ⟹ Int) ∨ ({γ ≥ Str, α ≤ Str, α ≤ ¬Int} ⟹ Str), γ ≥ ({β ≤ Int, α ≤ Int} ⟹ Int) ∧ ({β ≤ Str, α ≤ Str, α ≤ ¬Int} ⟹ Str)} ⟹ α → β → γ

baz(1, 1)
//│ ⊥

baz("", "")
//│ ⊥

baz(bot, bot)
//│ ⊥

:te
baz(1, "")
//│ ⊥1313
//│ FAILURE: Unexpected lack of type error

:te
baz(true, false)
//│ ⊥
//│ FAILURE: Unexpected lack of type error

fun bop(a, b) =
  let x = baz(a, b)
  x
//│ bop: ∀α. (({α ≥ Int} ⟹ Int) ∨ ({α ≥ Str} ⟹ Str)) → ⊤ → α

bop(0, 1)
//│ ⊥

bop("0", "1")
//│ ⊥

:te
bop(0, "1")
//│ ⊥
//│ FAILURE: Unexpected lack of type error
