:ctml

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α. α → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀π. {π ≤ (Int ⟹ {ο ≤ Int}) ∨ (Str ⟹ {ο ≤ Str})} ⟹ ∀ο. {ο ≤ (Int ⟹ {π ≤ Int}) ∨ (Str ⟹ {π ≤ Str})} ⟹ ο → π → ((Int ⟹ {ο ≤ Int, π ≤ Int}) ∨ (Str ⟹ {ο ≤ Str, π ≤ Str}))

baz(1, 1)
//│ Int ∨ Str

baz("", "")
//│ Int ∨ Str

baz(bot, bot)
//│ Int ∨ Str

:e
baz(1, "")
//│ ═══[ERROR] Cannot solve judgment ∀37. {37 ≤ Int} ⟹ 37 → ((Int ⟹ {37 ≤ Int}) ∨ (Str ⟹ {37 ≤ Str})) ≤ Str → 35.
//│ Typing error tree:
//│   ∀37. {37 ≤ Int} ⟹ 37 → ((Int ⟹ {37 ≤ Int}) ∨ (Str ⟹ {37 ≤ Str})) ≤ Str → 35
//│     {39 ≤ Int} ⟹ 39 → ((Int ⟹ {39 ≤ Int}) ∨ (Str ⟹ {39 ≤ Str})) ≤ Str → 35
//│       39 → ((Int ⟹ {39 ≤ Int}) ∨ (Str ⟹ {39 ≤ Str})) ≤ Str → 35
//│         Str ≤ 39
//│           Str ≤ Int
//│             ⊤ ≤ Int
//│               ⊤ ≤ ⊥

:e
baz(true, false)
//│ ═══[ERROR] Cannot solve judgment ∀π. {π ≤ (Int ⟹ {ο ≤ Int}) ∨ (Str ⟹ {ο ≤ Str})} ⟹ ∀ο. {ο ≤ (Int ⟹ {π ≤ Int}) ∨ (Str ⟹ {π ≤ Str})} ⟹ ο → π → ((Int ⟹ {ο ≤ Int, π ≤ Int}) ∨ (Str ⟹ {ο ≤ Str, π ≤ Str})) ≤ Bool → 41.
//│ Typing error tree:
//│   ∀π. {π ≤ (Int ⟹ {ο ≤ Int}) ∨ (Str ⟹ {ο ≤ Str})} ⟹ ∀ο. {ο ≤ (Int ⟹ {π ≤ Int}) ∨ (Str ⟹ {π ≤ Str})} ⟹ ο → π → ((Int ⟹ {ο ≤ Int, π ≤ Int}) ∨ (Str ⟹ {ο ≤ Str, π ≤ Str})) ≤ Bool → 41
//│     {42 ≤ (Int ⟹ {ο ≤ Int}) ∨ (Str ⟹ {ο ≤ Str})} ⟹ ∀ο. {ο ≤ (Int ⟹ {42 ≤ Int}) ∨ (Str ⟹ {42 ≤ Str})} ⟹ ο → 42 → ((Int ⟹ {ο ≤ Int, 42 ≤ Int}) ∨ (Str ⟹ {ο ≤ Str, 42 ≤ Str})) ≤ Bool → 41
//│       ∀ο. {ο ≤ (Int ⟹ {42 ≤ Int}) ∨ (Str ⟹ {42 ≤ Str})} ⟹ ο → 42 → ((Int ⟹ {ο ≤ Int, 42 ≤ Int}) ∨ (Str ⟹ {ο ≤ Str, 42 ≤ Str})) ≤ Bool → 41
//│         {43 ≤ (Int ⟹ {42 ≤ Int}) ∨ (Str ⟹ {42 ≤ Str})} ⟹ 43 → 42 → ((Int ⟹ {43 ≤ Int, 42 ≤ Int}) ∨ (Str ⟹ {43 ≤ Str, 42 ≤ Str})) ≤ Bool → 41
//│           43 → 42 → ((Int ⟹ {43 ≤ Int, 42 ≤ Int}) ∨ (Str ⟹ {43 ≤ Str, 42 ≤ Str})) ≤ Bool → 41
//│             Bool ≤ 43
//│               Bool ≤ (Int ⟹ {42 ≤ Int}) ∨ (Str ⟹ {42 ≤ Str})
//│                 Bool ≤ Int ⟹ {42 ≤ Int}
//│                   Bool ≤ Int
//│                     Bool ≤ ⊥
//│                       ⊤ ≤ ⊥
//│                 Bool ≤ Str ⟹ {42 ≤ Str}
//│                   Bool ≤ Str
//│                     Bool ≤ ⊥
//│                       ⊤ ≤ ⊥
