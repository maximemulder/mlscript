:ctml

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α ◁ {}. α → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  if a is
    Int then a + b
    Str then b + b
//│ baz: ∀ν, ξ ◁ {ν ≤ (Int ∨ (Str ▷ {ξ ≤ Int, ξ ≤ Int})) ∨ ((Str ▷ {ξ ≤ Str}) ∨ (Int ▷ {ξ ≤ Int})) ∨ (Str ▷ {ξ ≤ Str}) ∨ (Str ▷ {ξ ≤ Int, ξ ≤ Int}), ξ ≤ ((Int ▷ {ν ≤ Int, ν ≤ Int}) ∨ (Int ▷ {ν ≤ Int}) ∨ (Int ▷ {ν ≤ Str})) ∨ ((Str ▷ {ν ≤ Str}) ∨ (Int ▷ {ν ≤ Int, ν ≤ Int})) ∨ (Str ▷ {ν ≤ Str}) ∨ (Int ▷ {ν ≤ Str})}. ν → ξ → ((Int ▷ {ξ ≤ Int, ν ≤ Int, ν ≤ Int}) ∨ (Int ▷ {ξ ≤ Int, ξ ≤ Int, ν ≤ Str}))
