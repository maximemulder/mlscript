:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α. α → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀α, β, γ. {α ≤ ({β ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({γ ≥ {α ≤ {β ≤ Str} ⟹ Str} ⟹ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ ¬Int), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int, α ≤ {β ≤ Str} ⟹ Str} ⟹ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥))} ⟹ α → β → γ

baz(1, 1)
//│ Int

baz("", "")
//│ Str

baz(bot, bot)
//│ ⊥

:te
baz(1, "")
//│ ═══[TYPE ERROR] Cannot solve judgment Int ≤ ¬Int.
//│ Typing error tree:
//│   Int ≤ ¬Int

:te
baz(true, false)
//│ ═══[TYPE ERROR] Cannot solve judgment Bool ≤ ⊥.
//│ Typing error tree:
//│   Bool ≤ ⊥

