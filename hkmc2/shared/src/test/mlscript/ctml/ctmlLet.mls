:ctml

fun foo(a) =
  let b = a
  let c = b
  c
//│ SUBTYPE CONSTRAINED {6 ≥ 8, 7 ≤ 8, 8 ≥ 7, 8 ≤ 6} ⟹ 7 → 6 ≤ 0 → 1
//│ SUBTYPE BOUND 6 ≥ 8
//│ SUBTYPE CONSTRAINED {7 ≤ 8, 8 ≥ 7, 8 ≤ 6} ⟹ 7 → 6 ≤ 0 → 1
//│ SUBTYPE BOUND 7 ≤ 8
//│ SUBTYPE CONSTRAINED {8 ≥ 7, 8 ≤ 6} ⟹ 7 → 6 ≤ 0 → 1
//│ SUBTYPE BOUND 8 ≥ 7
//│ SUBTYPE CONSTRAINED {8 ≤ 6} ⟹ 7 → 6 ≤ 0 → 1
//│ SUBTYPE BOUND 8 ≤ 6
//│ foo: ∀α, β, γ, δ, ε. {α ≥ β, β ≥ γ, β ≤ α, γ ≥ ε, γ ≤ β, δ ≤ ε, ε ≥ δ, ε ≤ γ} ⟹ δ → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀α, β, γ. {α ≤ (Int ⟹ {γ ≥ Int, β ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, β ≤ Str}), β ≤ (Int ⟹ {γ ≥ Int, α ≤ Int}) ∨ (Str ⟹ {γ ≥ Str, α ≤ Str}), γ ≥ (Int ⟹ {β ≤ Int, α ≤ Int}) ∨ (Str ⟹ {β ≤ Str, α ≤ Str})} ⟹ α → β → γ
//│

baz(1, 1)
//│ SUBTYPE CONSTRAINED {24 ≤ (Int ⟹ {26 ≥ Int, 25 ≤ Int}) ∨ (Str ⟹ {26 ≥ Str, 25 ≤ Str}), 25 ≤ (Int ⟹ {26 ≥ Int, 24 ≤ Int}) ∨ (Str ⟹ {26 ≥ Str, 24 ≤ Str}), 26 ≥ (Int ⟹ {25 ≤ Int, 24 ≤ Int}) ∨ (Str ⟹ {25 ≤ Str, 24 ≤ Str})} ⟹ 24 → 25 → 26 ≤ Int → 23
