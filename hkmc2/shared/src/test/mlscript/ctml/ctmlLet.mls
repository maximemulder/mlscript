:ctml

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α. α → α

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀α, β, γ. {α ≤ ({β ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({β ≤ Str, γ ≥ Str} ⟹ Str), β ≤ ({α ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({α ≤ Str, γ ≥ Str} ⟹ Str), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ Str, β ≤ Str} ⟹ Str)} ⟹ α → β → γ

baz(1, 1)
//│ Int ∧ ({Int ≤ Str, Int ≤ Str} ⟹ Str)

baz("", "")
//│ ({Str ≤ Int, Str ≤ Int} ⟹ Int) ∧ Str

baz(bot, bot)
//│ ⊥

:te
baz(1, "")
//│ ({Str ≤ Int} ⟹ Int) ∧ ({Int ≤ Str} ⟹ Str)
//│ FAILURE: Unexpected lack of type error

:te
baz(true, false)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ ({β ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({β ≤ Str, γ ≥ Str} ⟹ Str), β ≤ ({α ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({α ≤ Str, γ ≥ Str} ⟹ Str), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ Str, β ≤ Str} ⟹ Str)} ⟹ α → β → γ ≤ Bool → δ.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ ({β ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({β ≤ Str, γ ≥ Str} ⟹ Str), β ≤ ({α ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({α ≤ Str, γ ≥ Str} ⟹ Str), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ Str, β ≤ Str} ⟹ Str)} ⟹ α → β → γ ≤ Bool → δ
//│     {ε ≤ ({ζ ≤ Int, η ≥ Int} ⟹ Int) ∨ ({ζ ≤ Str, η ≥ Str} ⟹ Str), ζ ≤ ({ε ≤ Int, η ≥ Int} ⟹ Int) ∨ ({ε ≤ Str, η ≥ Str} ⟹ Str), η ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, ζ ≤ Str} ⟹ Str)} ⟹ ε → ζ → η ≤ Bool → δ
//│       {ζ ≤ ({ε ≤ Int, η ≥ Int} ⟹ Int) ∨ ({ε ≤ Str, η ≥ Str} ⟹ Str), η ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, ζ ≤ Str} ⟹ Str)} ⟹ ε → ζ → η ≤ Bool → δ
//│         {η ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, ζ ≤ Str} ⟹ Str)} ⟹ ε → ζ → η ≤ Bool → δ
//│           ε → ζ → η ≤ Bool → δ
//│             Bool ≤ ε
//│               Bool ≤ ({ζ ≤ Int, η ≥ Int} ⟹ Int) ∨ ({ζ ≤ Str, η ≥ Str} ⟹ Str)
//│                 Bool ≤ {ζ ≤ Int, η ≥ Int} ⟹ Int
//│                   Bool ≤ {η ≥ Int} ⟹ Int
//│                     Bool ≤ Int
//│                 Bool ≤ {ζ ≤ Str, η ≥ Str} ⟹ Str
//│                   Bool ≤ {η ≥ Str} ⟹ Str
//│                     Bool ≤ Str

fun bop(a, b) =
  let x = baz(a, b)
  x
//│ bop: ∀α, β, γ, δ. {α ≤ ({γ ≤ Int, δ ≥ Int} ⟹ Int) ∨ ({γ ≤ Str, δ ≥ Str} ⟹ Str), β ≤ ({α ≤ Int, δ ≥ Int} ⟹ Int) ∨ ({α ≤ Str, δ ≥ Str} ⟹ Str), γ ≥ β, γ ≤ ({α ≤ Int, δ ≥ Int} ⟹ Int) ∨ ({α ≤ Str, δ ≥ Str} ⟹ Str), δ ≥ ({α ≤ Int, γ ≤ Int} ⟹ Int) ∧ ({α ≤ Str, γ ≤ Str} ⟹ Str)} ⟹ α → β → (({α ≤ Int, γ ≤ Int} ⟹ Int) ∧ ({α ≤ Str, γ ≤ Str} ⟹ Str))

:fixme
// bop(0, 1)

:fixme
// bop("0", "1")

:fixme
:te
// bop(0, "1")
