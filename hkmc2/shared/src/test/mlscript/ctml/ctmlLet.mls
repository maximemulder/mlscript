//│   ∀α, β, γ, δ. {α ≤ ({β ≤ Int, γ ≥ Int} ⟹ Int) ∨ ({γ ≥ δ, δ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥), β ≤ Str, δ ≥ Str} ⟹ Str), δ ≥ ({α ≤ Int, β ≤ Int, γ ≥ Int} ⟹ ⊥) ∧ ({α ≤ {β ≤ Str, δ ≥ Str} ⟹ Str, γ ≥ δ} ⟹ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)), γ ≥ ({α ≤ Int, β ≤ Int} ⟹ Int) ∧ ({α ≤ {β ≤ Str, δ ≥ Str} ⟹ Str, δ ≥ ({α ≤ Str, β ≤ Str} ⟹ Str) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ δ)} ⟹ α → β → γ ≤ Bool → ε
//│     {ζ ≤ ({η ≤ Int, θ ≥ Int} ⟹ Int) ∨ ({θ ≥ ι, ι ≥ ({ζ ≤ Str, η ≤ Str} ⟹ Str) ∧ ({ζ ≤ ⊥} ⟹ ⊥), η ≤ Str, ι ≥ Str} ⟹ Str), ι ≥ ({ζ ≤ Int, η ≤ Int, θ ≥ Int} ⟹ ⊥) ∧ ({ζ ≤ {η ≤ Str, ι ≥ Str} ⟹ Str, θ ≥ ι} ⟹ ({ζ ≤ Str, η ≤ Str} ⟹ Str) ∧ ({ζ ≤ ⊥} ⟹ ⊥)), θ ≥ ({ζ ≤ Int, η ≤ Int} ⟹ Int) ∧ ({ζ ≤ {η ≤ Str, ι ≥ Str} ⟹ Str, ι ≥ ({ζ ≤ Str, η ≤ Str} ⟹ Str) ∧ ({ζ ≤ ⊥} ⟹ ⊥)} ⟹ ι)} ⟹ ζ → η → θ ≤ Bool → ε
