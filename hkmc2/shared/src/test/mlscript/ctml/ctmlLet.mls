:ctml

:ctml-cfg subtype-absurd-constred error-absurd-constred reconstruct-coherence

fun foo(a) =
  let b = a
  let c = b
  c
//│ foo: ∀α, β, γ, δ, ε. α → ({δ ≥ α, ε ≤ δ, ε ≥ α, β ≤ γ, γ ≥ δ, β ≥ δ} ⟹ γ)

fun bar(a) =
  let b = 1
  let c = 1
  b + c
//│ bar: ⊤ → Int

fun baz(a, b) =
  let c = if a is
    Int then (b as Int)
    Str then (b as Str)
  c
//│ baz: ∀α, β, γ, δ. α → β → ({δ ≤ γ, γ ≥ ∀ε. {β ≤ ({ε ≥ Int, α ≤ Int} ⟹ Int) ∨ ({ε ≥ Str, α ≤ Str, α ≤ ¬Int} ⟹ Str), α ≤ ({ε ≥ Int, β ≤ Int} ⟹ Int) ∨ ({ε ≥ Str, β ≤ Str} ⟹ Str), ε ≥ ({β ≤ Int, α ≤ Int} ⟹ Int) ∧ ({β ≤ Str, α ≤ Str, α ≤ ¬Int} ⟹ Str)} ⟹ ε, δ ≥ ∀ε. {β ≤ ({ε ≥ Int, α ≤ Int} ⟹ Int) ∨ ({ε ≥ Str, α ≤ Str, α ≤ ¬Int} ⟹ Str), α ≤ ({ε ≥ Int, β ≤ Int} ⟹ Int) ∨ ({ε ≥ Str, β ≤ Str} ⟹ Str), ε ≥ ({β ≤ Int, α ≤ Int} ⟹ Int) ∧ ({β ≤ Str, α ≤ Str, α ≤ ¬Int} ⟹ Str)} ⟹ ε} ⟹ γ)

baz(1, 1)
//│ ∀α, β. {α ≤ β, β ≥ ∀γ. {γ ≥ Int} ⟹ γ, α ≥ ∀γ. {γ ≥ Int} ⟹ γ} ⟹ β

baz("", "")
//│ ∀α, β. {α ≤ β, β ≥ ∀γ. {γ ≥ Str} ⟹ γ, α ≥ ∀γ. {γ ≥ Str} ⟹ γ} ⟹ β

baz(bot, bot)
//│ ∀α. α

:te
baz(1, "")
//│ ∀α, β. {α ≤ β, β ≥ ∀γ. {γ ≥ {Str ≤ Int} ⟹ Int} ⟹ γ, α ≥ ∀γ. {γ ≥ {Str ≤ Int} ⟹ Int} ⟹ γ} ⟹ β
//│ FAILURE: Unexpected lack of type error

:te
baz(true, false)
//│ ∀α, β. {α ≤ β, β ≥ ∀γ. {γ ≥ {Bool ≤ Str, Bool ≤ Str} ⟹ Str} ⟹ γ, α ≥ ∀γ. {γ ≥ {Bool ≤ Str, Bool ≤ Str} ⟹ Str} ⟹ γ} ⟹ β
//│ FAILURE: Unexpected lack of type error

fun bop(a, b) =
  let x = baz(a, b)
  x
//│ bop: ∀α, β, γ, δ. α → β → ({δ ≤ γ, γ ≥ ∀ε, ζ, η, θ, ι, κ, λ. {θ ≥ α, κ ≤ θ, η ≥ β, ι ≤ η, ι ≥ β, λ ≥ α, κ ≥ α, λ ≤ κ, κ ≥ α, ε ≤ ζ, ζ ≥ ∀μ. {η ≤ ({μ ≥ Int, θ ≤ Int} ⟹ Int) ∨ ({μ ≥ Str, θ ≤ Str, θ ≤ ¬Int} ⟹ Str), θ ≤ ({μ ≥ Int, η ≤ Int} ⟹ Int) ∨ ({μ ≥ Str, η ≤ Str} ⟹ Str), μ ≥ ({η ≤ Int, θ ≤ Int} ⟹ Int) ∧ ({η ≤ Str, θ ≤ Str, θ ≤ ¬Int} ⟹ Str)} ⟹ μ, ε ≥ ∀μ. {η ≤ ({μ ≥ Int, θ ≤ Int} ⟹ Int) ∨ ({μ ≥ Str, θ ≤ Str, θ ≤ ¬Int} ⟹ Str), θ ≤ ({μ ≥ Int, η ≤ Int} ⟹ Int) ∨ ({μ ≥ Str, η ≤ Str} ⟹ Str), μ ≥ ({η ≤ Int, θ ≤ Int} ⟹ Int) ∧ ({η ≤ Str, θ ≤ Str, θ ≤ ¬Int} ⟹ Str)} ⟹ μ} ⟹ ζ, δ ≥ ∀ε, ζ, η, θ, ι, κ, λ. {θ ≥ α, κ ≤ θ, η ≥ β, ι ≤ η, ι ≥ β, λ ≥ α, κ ≥ α, λ ≤ κ, κ ≥ α, ε ≤ ζ, ζ ≥ ∀μ. {η ≤ ({μ ≥ Int, θ ≤ Int} ⟹ Int) ∨ ({μ ≥ Str, θ ≤ Str, θ ≤ ¬Int} ⟹ Str), θ ≤ ({μ ≥ Int, η ≤ Int} ⟹ Int) ∨ ({μ ≥ Str, η ≤ Str} ⟹ Str), μ ≥ ({η ≤ Int, θ ≤ Int} ⟹ Int) ∧ ({η ≤ Str, θ ≤ Str, θ ≤ ¬Int} ⟹ Str)} ⟹ μ, ε ≥ ∀μ. {η ≤ ({μ ≥ Int, θ ≤ Int} ⟹ Int) ∨ ({μ ≥ Str, θ ≤ Str, θ ≤ ¬Int} ⟹ Str), θ ≤ ({μ ≥ Int, η ≤ Int} ⟹ Int) ∨ ({μ ≥ Str, η ≤ Str} ⟹ Str), μ ≥ ({η ≤ Int, θ ≤ Int} ⟹ Int) ∧ ({η ≤ Str, θ ≤ Str, θ ≤ ¬Int} ⟹ Str)} ⟹ μ} ⟹ ζ} ⟹ γ)

bop(0, 1)
//│ ∀α, β. {α ≤ β, β ≥ ∀γ, δ, ε, ζ, η, θ, ι. {ζ ≥ Int, θ ≤ ζ, ε ≥ Int, η ≤ ε, η ≥ Int, ι ≥ Int, θ ≥ Int, ι ≤ θ, θ ≥ Int, γ ≤ δ, δ ≥ ∀κ. {ε ≤ ({κ ≥ Int, ζ ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str), ζ ≤ ({κ ≥ Int, ε ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ε ≤ Str} ⟹ Str), κ ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str)} ⟹ κ, γ ≥ ∀κ. {ε ≤ ({κ ≥ Int, ζ ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str), ζ ≤ ({κ ≥ Int, ε ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ε ≤ Str} ⟹ Str), κ ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str)} ⟹ κ} ⟹ δ, α ≥ ∀γ, δ, ε, ζ, η, θ, ι. {ζ ≥ Int, θ ≤ ζ, ε ≥ Int, η ≤ ε, η ≥ Int, ι ≥ Int, θ ≥ Int, ι ≤ θ, θ ≥ Int, γ ≤ δ, δ ≥ ∀κ. {ε ≤ ({κ ≥ Int, ζ ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str), ζ ≤ ({κ ≥ Int, ε ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ε ≤ Str} ⟹ Str), κ ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str)} ⟹ κ, γ ≥ ∀κ. {ε ≤ ({κ ≥ Int, ζ ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str), ζ ≤ ({κ ≥ Int, ε ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ε ≤ Str} ⟹ Str), κ ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str)} ⟹ κ} ⟹ δ} ⟹ β

bop("0", "1")
//│ ∀α, β. {α ≤ β, β ≥ ∀γ, δ, ε, ζ, η, θ, ι. {ζ ≥ Str, θ ≤ ζ, ε ≥ Str, η ≤ ε, η ≥ Str, ι ≥ Str, θ ≥ Str, ι ≤ θ, θ ≥ Str, γ ≤ δ, δ ≥ ∀κ. {ε ≤ ({κ ≥ Int, ζ ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str), ζ ≤ ({κ ≥ Int, ε ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ε ≤ Str} ⟹ Str), κ ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str)} ⟹ κ, γ ≥ ∀κ. {ε ≤ ({κ ≥ Int, ζ ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str), ζ ≤ ({κ ≥ Int, ε ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ε ≤ Str} ⟹ Str), κ ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str)} ⟹ κ} ⟹ δ, α ≥ ∀γ, δ, ε, ζ, η, θ, ι. {ζ ≥ Str, θ ≤ ζ, ε ≥ Str, η ≤ ε, η ≥ Str, ι ≥ Str, θ ≥ Str, ι ≤ θ, θ ≥ Str, γ ≤ δ, δ ≥ ∀κ. {ε ≤ ({κ ≥ Int, ζ ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str), ζ ≤ ({κ ≥ Int, ε ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ε ≤ Str} ⟹ Str), κ ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str)} ⟹ κ, γ ≥ ∀κ. {ε ≤ ({κ ≥ Int, ζ ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str), ζ ≤ ({κ ≥ Int, ε ≤ Int} ⟹ Int) ∨ ({κ ≥ Str, ε ≤ Str} ⟹ Str), κ ≥ ({ε ≤ Int, ζ ≤ Int} ⟹ Int) ∧ ({ε ≤ Str, ζ ≤ Str, ζ ≤ ¬Int} ⟹ Str)} ⟹ κ} ⟹ δ} ⟹ β

