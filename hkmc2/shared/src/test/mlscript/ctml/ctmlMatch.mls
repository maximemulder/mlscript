:ctml

:ctml-cfg subtype-absurd-constred reconstruct-coherence

if 1 is
  Int then 1
//│ Int

if 1 is
  Int then 1
  Str then "Hello"
//│ Int

if (1 as Int | Str) is
  Int then 1
  Str then "Hello"
//│ Int ∨ Str

:te
if (1 as Int) is
  Str then 1
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {β ≥ ({α ≤ Str} ⟹ Int) ∧ ({α ≤ ⊥} ⟹ ⊥), α ≤ {β ≥ Int} ⟹ Str} ⟹ α → β ≤ Int → γ.
//│ Typing error tree:
//│   ∀α, β. {β ≥ ({α ≤ Str} ⟹ Int) ∧ ({α ≤ ⊥} ⟹ ⊥), α ≤ {β ≥ Int} ⟹ Str} ⟹ α → β ≤ Int → γ
//│     {ε ≥ ({δ ≤ Str} ⟹ Int) ∧ ({δ ≤ ⊥} ⟹ ⊥), δ ≤ {ε ≥ Int} ⟹ Str} ⟹ δ → ε ≤ Int → γ
//│       {δ ≤ {ε ≥ Int} ⟹ Str} ⟹ δ → ε ≤ Int → γ
//│         δ → ε ≤ Int → γ
//│           Int ≤ δ
//│             Int ≤ {ε ≥ Int} ⟹ Str
//│               Int ≤ Str

:te
if (1 as Int | Str) is
  Int then 1
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ⊥} ⟹ ⊥), α ≤ {β ≥ Int} ⟹ Int} ⟹ α → β ≤ (Int ∨ Str) → γ.
//│ Typing error tree:
//│   ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ⊥} ⟹ ⊥), α ≤ {β ≥ Int} ⟹ Int} ⟹ α → β ≤ (Int ∨ Str) → γ
//│     ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ⊥} ⟹ ⊥), α ≤ {β ≥ Int} ⟹ Int} ⟹ α → β ≤ Str → γ
//│       {ε ≥ ({δ ≤ Int} ⟹ Int) ∧ ({δ ≤ ⊥} ⟹ ⊥), δ ≤ {ε ≥ Int} ⟹ Int} ⟹ δ → ε ≤ Str → γ
//│         {δ ≤ {ε ≥ Int} ⟹ Int} ⟹ δ → ε ≤ Str → γ
//│           δ → ε ≤ Str → γ
//│             Str ≤ δ
//│               Str ≤ {ε ≥ Int} ⟹ Int
//│                 Str ≤ Int
