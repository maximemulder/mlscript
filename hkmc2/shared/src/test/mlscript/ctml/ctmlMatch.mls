:ctml

:ctml-cfg subtype-absurd-constred reconstruct-coherence

if 1 is
  Int then 1
//│ Int

if 1 is
  Int then 1
  Str then "Hello"
//│ ∀α. {α ≥ Int} ⟹ α

if (1 as Int | Str) is
  Int then 1
  Str then "Hello"
//│ ∀α, β. {α ≥ Int ∨ β, β ≥ Str, α ≥ Int} ⟹ α

:te
if (1 as Int) is
  Str then 1
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {α ≤ {β ≥ Int} ⟹ Str, β ≥ ({α ≤ Str} ⟹ Int) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ α → β ≤ Int → γ.
//│ Typing error tree:
//│   ∀α, β. {α ≤ {β ≥ Int} ⟹ Str, β ≥ ({α ≤ Str} ⟹ Int) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ α → β ≤ Int → γ
//│     {δ ≤ {ε ≥ Int} ⟹ Str, ε ≥ ({δ ≤ Str} ⟹ Int) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ δ → ε ≤ Int → γ
//│       {ε ≥ ({δ ≤ Str} ⟹ Int) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ δ → ε ≤ Int → γ
//│         δ → ε ≤ Int → γ
//│           Int ≤ δ
//│             Int ≤ {ε ≥ Int} ⟹ Str
//│               Int ≤ Str

:te
if (1 as Int | Str) is
  Int then 1
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {α ≤ {β ≥ Int} ⟹ Int, β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ α → β ≤ (Int ∨ Str) → γ.
//│ Typing error tree:
//│   ∀α, β. {α ≤ {β ≥ Int} ⟹ Int, β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ α → β ≤ (Int ∨ Str) → γ
//│     ∀α, β. {α ≤ {β ≥ Int} ⟹ Int, β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ⊥} ⟹ ⊥)} ⟹ α → β ≤ Str → γ
//│       {δ ≤ {ε ≥ Int} ⟹ Int, ε ≥ ({δ ≤ Int} ⟹ Int) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ δ → ε ≤ Str → γ
//│         {ε ≥ ({δ ≤ Int} ⟹ Int) ∧ ({δ ≤ ⊥} ⟹ ⊥)} ⟹ δ → ε ≤ Str → γ
//│           δ → ε ≤ Str → γ
//│             Str ≤ δ
//│               Str ≤ {ε ≥ Int} ⟹ Int
//│                 Str ≤ Int
