:ctml

:ctml-cfg subtype-absurd-constred reconstruct-coherence

if 1 is
  Int then 1
//│ Int

if 1 is
  Int then 1
  Str then "Hello"
//│ Int

if (1 as Int | Str) is
  Int then 1
  Str then "Hello"
//│ {Int ∨ Str ≤ Str} ⟹ Str

:te
if (1 as Int) is
  Str then 1
//│ ═══[TYPE ERROR] Cannot solve judgment α → Int ≤ Int → β.
//│ Typing error tree:
//│   α → Int ≤ Int → β
//│     Int ≤ α
//│       Int ≤ Str

:te
if (1 as Int | Str) is
  Int then 1
//│ ═══[TYPE ERROR] Cannot solve judgment α → Int ≤ (Int ∨ Str) → β.
//│ Typing error tree:
//│   α → Int ≤ (Int ∨ Str) → β
//│     α → Int ≤ Str → β
//│       Str ≤ α
//│         Str ≤ Int
