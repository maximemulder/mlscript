:ctml

:ctml-cfg constrained constrained-absurd

if 1 is
  Int then 1
//│ Int

if 1 is
  Int then 1
  Str then "Hello"
//│ Int

if (1 as Int | Str) is
  Int then 1
  Str then "Hello"
//│ Str ∨ Int

:te
if (1 as Int) is
  Str then 1
//│ ═══[TYPE ERROR] Cannot solve judgment Str → Int ≤ Int → α.
//│ Typing error tree:
//│   Str → Int ≤ Int → α
//│     Int ≤ Str

:te
if (1 as Int | Str) is
  Int then 1
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int ≤ (Int ∨ Str) → α.
//│ Typing error tree:
//│   Int → Int ≤ (Int ∨ Str) → α
//│     Int → Int ≤ Str → α
//│       Str ≤ Int
