:ctml

:ctml-cfg error-absurd-constred

val value: Int | Str
//│ value: Int ∨ Str

val scrutinee: Int
//│ scrutinee: Int

// A variable scrutinee is bound before matching, so either member of its union type is accepted.

if value is Int then 1 else "s"
//│ Int ∨ Str

// Both branches refine occurrences of the scrutinee through the new binding.

if value is Int then value + 1 else value ++ "!"
//│ Int ∨ Str

// UCS supplies the binding for a non-variable scrutinee.

if (value as Int | Str) is Int then 1 else "s"
//│ Int ∨ Str

// A split with several patterns shares one binding of its scrutinee.

if value is
  Int then value + 1
  Str then value ++ "!"
//│ Int ∨ Str

// Matches without an else branch still require an exhaustive pattern.

if int is Int then int + 1
//│ Int

:te
if value is Int then value + 1
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int ≤ (Int ∨ Str) → α.
//│ Typing error tree:
//│   Int → Int ≤ (Int ∨ Str) → α
//│     Int ∨ Str ≤ Int
//│       Str ≤ Int

// An operation incompatible with the selected pattern is rejected.

:te
if value is Int then value ++ "!" else value
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {α ≤ ¬({β ≥ α} ⟹ Int), β ≥ {α ≤ ¬Int} ⟹ α} ⟹ α → β ≤ (Int ∨ Str) → γ.
//│ Typing error tree:
//│   ∀α, β. {α ≤ ¬({β ≥ α} ⟹ Int), β ≥ {α ≤ ¬Int} ⟹ α} ⟹ α → β ≤ (Int ∨ Str) → γ
//│     ∀α, β. {α ≤ ¬({β ≥ α} ⟹ Int), β ≥ {α ≤ ¬Int} ⟹ α} ⟹ α → β ≤ Int → γ
//│       {δ ≤ ¬({ε ≥ δ} ⟹ Int), ε ≥ {δ ≤ ¬Int} ⟹ δ} ⟹ δ → ε ≤ Int → γ
//│         δ ≤ ¬({ε ≥ δ} ⟹ Int)
//│           Int ≤ ¬δ
//│             δ ≤ ¬Int
//│               Int ≤ ¬Int

// A nested conditional rebinds the same scrutinee without capturing other variables.

if value is Int then (if value is Nat then "nat" else value + 1) else value ++ "!"
//│ (Str ∨ (({Int ∧ ¬Nat ≤ Nat} ⟹ Str) ∧ Int)) ∨ Int

// A branch may shadow the scrutinee with a local variable.

if value is Int then
  let value = "shadow"
  value ++ "!"
else value
//│ Str

// Disabling wrapping exposes the variable's union type directly to the branch check.

:ctml-cfg no-wrap-ifs

:te
if value is Int then 1 else "s"
//│ ═══[TYPE ERROR] Cannot solve judgment Int ∨ Str ≤ Int.
//│ Typing error tree:
//│   Int ∨ Str ≤ Int
//│     Str ≤ Int

// UCS bindings remain present with wrapping disabled.

if (value as Int | Str) is Int then 1 else "s"
//│ Int ∨ Str

:ctml-cfg wrap-ifs

if value is Int then 1 else "s"
//│ Int ∨ Str

// Inference traces distinguish the parser's binding, the UCS binding, and an unwrapped match.

:ctml-dbg infer depth 0

if scrutinee is Int then 1
//│ ...
//│ infer EApp(ELam(Some(LambdaParam(scrutinee,None)),EMatch(EVar(scrutinee),Int,EVar(int),None)),EVar(scrutinee))
//│ ...
//│ OK 136 ⇝ eff 136 ≥ Int, 136 ≥ Int, 136 flex (1)
//│ ...
//│ LEVEL CLAUSES (1) 136 OUT 136 ≥ Int, 136 flex (1)
//│ ...
//│ LEVEL UNWRAP 136 OUT ∅
//│ ...
//│ LEVEL SIMPLIFY TYPE 136 OUT ∅
//│ ...
//│ LEVEL WRAP TYPE 136
//│ ...
//│ LEVEL SIMPLIFY Int OUT ∅
//│ ...
//│ LEVEL RESULT Int
//│ Int

if 1 is Int then 1
//│ ...
//│ infer EApp(ELam(Some(LambdaParam(scrut,None)),EMatch(EVar(scrut),Int,EVar(int),None)),EVar(int))
//│ ...
//│ OK 138 ⇝ eff 138 ≥ Int, 138 ≥ Int, 138 flex (1)
//│ ...
//│ LEVEL CLAUSES (1) 138 OUT 138 ≥ Int, 138 flex (1)
//│ ...
//│ LEVEL UNWRAP 138 OUT ∅
//│ ...
//│ LEVEL SIMPLIFY TYPE 138 OUT ∅
//│ ...
//│ LEVEL WRAP TYPE 138
//│ ...
//│ LEVEL SIMPLIFY Int OUT ∅
//│ ...
//│ LEVEL RESULT Int
//│ Int

:ctml-cfg no-wrap-ifs

if scrutinee is Int then 1
//│ ...
//│ infer EMatch(EVar(scrutinee),Int,EVar(int),None)
//│ ...
//│ OK Int ⇝ ∅
//│ ...
//│ LEVEL CLAUSES (1) Int OUT ∅
//│ ...
//│ LEVEL UNWRAP Int OUT ∅
//│ ...
//│ LEVEL SIMPLIFY TYPE Int OUT ∅
//│ ...
//│ LEVEL WRAP TYPE Int
//│ ...
//│ LEVEL SIMPLIFY Int OUT ∅
//│ ...
//│ LEVEL RESULT Int
//│ Int

if 1 is Int then 1
//│ ...
//│ infer EApp(ELam(Some(LambdaParam(scrut,None)),EMatch(EVar(scrut),Int,EVar(int),None)),EVar(int))
//│ ...
//│ OK 140 ⇝ eff 140 ≥ Int, 140 ≥ Int, 140 flex (1)
//│ ...
//│ LEVEL CLAUSES (1) 140 OUT 140 ≥ Int, 140 flex (1)
//│ ...
//│ LEVEL UNWRAP 140 OUT ∅
//│ ...
//│ LEVEL SIMPLIFY TYPE 140 OUT ∅
//│ ...
//│ LEVEL WRAP TYPE 140
//│ ...
//│ LEVEL SIMPLIFY Int OUT ∅
//│ ...
//│ LEVEL RESULT Int
//│ Int
