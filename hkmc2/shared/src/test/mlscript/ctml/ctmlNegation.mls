:ctml

1 as ~Bot
//│ ⊤

1 as ~Bool
//│ ¬Bool

1 as ~(~Int)
//│ Int

1 as ~(~(~(~Int)))
//│ Int

:te
1 as ~Int
//│ ═══[TYPE ERROR] Cannot solve judgment Int ≤ ¬Int.
//│ Typing error tree:
//│   Int ≤ ¬Int

:te
1 as ~(~(~Int))
//│ ═══[TYPE ERROR] Cannot solve judgment Int ≤ ¬¬¬Int.
//│ Typing error tree:
//│   Int ≤ ¬¬¬Int
//│     Int ≤ ¬Int

// Functions are typed at the negation of every class.

((x) => x) as ~Int
//│ ¬Int

// A function typed at both `Int → τ` and `¬Int → τ` is typed at `⊤ → τ`, by distribution over its
// parameter and excluded middle at `Int`.

fun k(x) = (y) => x
//│ k: ∀α. α → ⊤ → α

(k as ((Int -> ((Top -> Int) | (Top -> ~Int))) & (~Int -> ((Top -> Int) | (Top -> ~Int))))) as (Top -> ((Top -> Int) | (Top -> ~Int)))
//│ ⊤ → ((⊤ → Int) ∨ (⊤ → ¬Int))
