:ctml

fun id(x) =
  x
//│ id: ∀α. α → α

id(1)
//│ Int

fun apply(f, x) =
  f(x)
//│ apply: ∀α, β, γ. {α ≤ β → γ} ⟹ α → β → γ

fun double(f, x) =
  f(f(x))
//│ double: ∀α, β, γ. {α ≤ (∀δ. {α ≤ β → δ} ⟹ δ) → γ} ⟹ α → β → γ

double(id, 1)
//│ ∀α, β. {α ≤ (∀δ. {α ≤ Int → δ} ⟹ δ) → ⊤, α ≥ ∀γ. γ → γ, α ≤ Int → β} ⟹ β

fun foo(a, b) =
  a(1, b)
//│ foo: ∀α, β, γ. {α ≤ Int → γ, γ ≤ β → ⊤} ⟹ α → β → ⊥

foo((+), 1)
//│ ⊥

:te
foo((++), 1)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {α ≤ Int → γ, γ ≤ β → ⊤} ⟹ α → β → ⊥ ≤ (Str → Str → Str) → δ.
//│ Typing error tree:
//│   ∀α, β, γ. {α ≤ Int → γ, γ ≤ β → ⊤} ⟹ α → β → ⊥ ≤ (Str → Str → Str) → δ
//│     {ε ≤ Int → η, η ≤ ζ → ⊤} ⟹ ε → ζ → ⊥ ≤ (Str → Str → Str) → δ
//│       {η ≤ ζ → ⊤} ⟹ ε → ζ → ⊥ ≤ (Str → Str → Str) → δ
//│         ε → ζ → ⊥ ≤ (Str → Str → Str) → δ
//│           Str → Str → Str ≤ ε
//│             Str → Str → Str ≤ Int → η
//│               Int ≤ Str
