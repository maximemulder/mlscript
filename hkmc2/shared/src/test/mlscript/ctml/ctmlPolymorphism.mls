:ctml

fun id(x) =
  x
//│ id: ∀α. α → α

id(1)
//│ Int

fun apply(f, x) =
  f(x)
//│ apply: ∀α, β. (β → α) → β → α

fun double(f, x) =
  f(f(x))
//│ double: ∀α, β, γ. ((γ → β) ∧ (β → α)) → γ → α

double(id, 1)
//│ Int

fun foo(a, b) =
  a(1, b)
//│ foo: ∀α, β. (Int → β → α) → β → α

foo((+), 1)
//│ Int

:te
foo((++), 1)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. (Int → β → α) → β → α ≤ (Str → Str → Str) → γ.
//│ Typing error tree:
//│   ∀α, β. (Int → β → α) → β → α ≤ (Str → Str → Str) → γ
//│     (Int → δ → ε) → δ → ε ≤ (Str → Str → Str) → γ
//│       Str → Str → Str ≤ Int → δ → ε
//│         Int ≤ Str
