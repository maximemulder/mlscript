:ctml

fun id(x) =
  x
//│ id: ∀α. α → α

id(1)
//│ Int

val idInt = id as (Int -> Int)
//│ idInt: Int → Int

fun apply(f, x) =
  f(x)
//│ apply: ∀α, β. (α → β) → α → β

fun double(f, x) =
  f(f(x))
//│ double: ∀α, β, γ. ((α → β) ∧ (β → γ)) → α → γ

double(id, 1)
//│ Int

double(idInt, 1)
//│ Int

:te
double(idInt, "Hello")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
//│ Typing error tree:
//│   α ≤ Str → β
//│     γ → δ ≤ Str → β
//│       Str ≤ γ
//│         Str ≤ Int

fun foo(a, b) =
  a(1, b)
//│ foo: ∀α, β. (Int → α → β) → α → β

foo((+), 1)
//│ Int

:te
foo((++), 1)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. (Int → α → β) → α → β ≤ (Str → Str → Str) → γ.
//│ Typing error tree:
//│   ∀α, β. (Int → α → β) → α → β ≤ (Str → Str → Str) → γ
//│     (Int → δ → ε) → δ → ε ≤ (Str → Str → Str) → γ
//│       Str → Str → Str ≤ Int → δ → ε
//│         Int ≤ Str
