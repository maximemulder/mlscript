:ctml

fun id(x) =
  x
//│ id: ∀α. α → α

id(1)
//│ Int

fun apply(f, x) =
  f(x)
//│ apply: ∀α, β. (α → β) → α → β

fun double(f, x) =
  f(f(x))
//│ double: ∀α, β, γ. ((α → γ) ∧ (γ → β)) → α → β

double(id, 1)
//│ Int

fun foo(a, b) =
  a(1, b)
//│ foo: ∀α, β. (Int → α → β) → α → β

foo((+), 1)
//│ Int

:e
foo((++), 1)
//│ ═══[ERROR] Cannot solve judgment ∀α, β. (Int → α → β) → α → β ≤ (Str → Str → Str) → 27.
//│ Typing error tree:
//│   ∀α, β. (Int → α → β) → α → β ≤ (Str → Str → Str) → 27
//│     ∀α. (Int → 28 → α) → 28 → α ≤ (Str → Str → Str) → 27
//│       (Int → 28 → 29) → 28 → 29 ≤ (Str → Str → Str) → 27
//│         Str → Str → Str ≤ Int → 28 → 29
//│           Int ≤ Str
//│             Int ≤ ⊥
//│               ⊤ ≤ ⊥
