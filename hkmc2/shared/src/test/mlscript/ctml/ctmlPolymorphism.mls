:ctml

fun id(x) =
  x
//│ id: ∀α. α → α

id(1)
//│ Int

fun apply(f, x) =
  f(x)
//│ apply: ∀α, β, γ, δ. (α → β) → ({γ ≤ α} ⟹ γ → ({δ ≥ β} ⟹ δ))

fun double(f, x) =
  f(f(x))
//│ double: ∀α, β, γ, δ, ε. ((α → β) ∧ ((∀ζ. {ζ ≥ β} ⟹ ζ) → γ)) → ({δ ≤ α} ⟹ δ → ({ε ≥ γ} ⟹ ε))

double(id, 1)
//│ ∀α. {α ≥ ∀β. {β ≥ Int} ⟹ β} ⟹ α

fun foo(a, b) =
  a(1, b)
//│ foo: ∀α, β, γ, δ, ε, ζ. {α ≤ β → γ} ⟹ (Int → α) → ({δ ≤ β} ⟹ δ → ({ζ ≤ δ → ε, ε ≥ γ, ζ ≥ α} ⟹ ε))

foo((+), 1)
//│ ∀α, β. {α ≤ ⊥ → β, β ≥ Int, α ≥ Int → Int} ⟹ β

:te
foo((++), 1)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ, δ, ε, ζ. {α ≤ β → γ} ⟹ (Int → α) → ({δ ≤ β} ⟹ δ → ({ζ ≤ δ → ε, ε ≥ γ, ζ ≥ α} ⟹ ε)) ≤ (Str → Str → Str) → η.
//│ Typing error tree:
//│   ∀α, β, γ, δ, ε, ζ. {α ≤ β → γ} ⟹ (Int → α) → ({δ ≤ β} ⟹ δ → ({ζ ≤ δ → ε, ε ≥ γ, ζ ≥ α} ⟹ ε)) ≤ (Str → Str → Str) → η
//│     ∀β, γ, δ, ε, ζ. {θ ≤ β → γ} ⟹ (Int → θ) → ({δ ≤ β} ⟹ δ → ({ζ ≤ δ → ε, ε ≥ γ, ζ ≥ θ} ⟹ ε)) ≤ (Str → Str → Str) → η
//│       ∀γ, δ, ε, ζ. {θ ≤ ι → γ} ⟹ (Int → θ) → ({δ ≤ ι} ⟹ δ → ({ζ ≤ δ → ε, ε ≥ γ, ζ ≥ θ} ⟹ ε)) ≤ (Str → Str → Str) → η
//│         ∀δ, ε, ζ. {θ ≤ ι → κ} ⟹ (Int → θ) → ({δ ≤ ι} ⟹ δ → ({ζ ≤ δ → ε, ε ≥ κ, ζ ≥ θ} ⟹ ε)) ≤ (Str → Str → Str) → η
//│           ∀ε, ζ. {θ ≤ ι → κ} ⟹ (Int → θ) → ({λ ≤ ι} ⟹ λ → ({ζ ≤ λ → ε, ε ≥ κ, ζ ≥ θ} ⟹ ε)) ≤ (Str → Str → Str) → η
//│             ∀ζ. {θ ≤ ι → κ} ⟹ (Int → θ) → ({λ ≤ ι} ⟹ λ → ({ζ ≤ λ → μ, μ ≥ κ, ζ ≥ θ} ⟹ μ)) ≤ (Str → Str → Str) → η
//│               {θ ≤ ι → κ} ⟹ (Int → θ) → ({λ ≤ ι} ⟹ λ → ({ν ≤ λ → μ, μ ≥ κ, ν ≥ θ} ⟹ μ)) ≤ (Str → Str → Str) → η
//│                 (Int → θ) → ({λ ≤ ι} ⟹ λ → ({ν ≤ λ → μ, μ ≥ κ, ν ≥ θ} ⟹ μ)) ≤ (Str → Str → Str) → η
//│                   Str → Str → Str ≤ Int → θ
//│                     Int ≤ Str
