:ctml

fun id(x) =
  x
//│ id: ∀α. α → α

id(1)
//│ Int

fun apply(f, x) =
  f(x)
//│ apply: ∀α, β. (β → α) → β → α

fun double(f, x) =
  f(f(x))
//│ double: ∀α, β, γ. {α ≤ (∀δ. {α ≤ γ → δ} ⟹ δ) → β} ⟹ α → γ → β

double(id, 1)
//│ Int

fun foo(a, b) =
  a(1, b)
//│ foo: (Int → ⊥ → ⊤) → ⊤ → ⊥

foo((+), 1)
//│ ⊥

:te
foo((++), 1)
//│ ═══[TYPE ERROR] Cannot solve judgment (Int → ⊥ → ⊤) → ⊤ → ⊥ ≤ (Str → Str → Str) → α.
//│ Typing error tree:
//│   (Int → ⊥ → ⊤) → ⊤ → ⊥ ≤ (Str → Str → Str) → α
//│     Str → Str → Str ≤ Int → ⊥ → ⊤
//│       Int ≤ Str
