:ctml

fun id(x) =
  x
//│ id: ∀α. α → α

id(1)
//│ Int

fun apply(f, x) =
  f(x)
//│ apply: ∀δ, ε. (δ → ε) → δ → ε

fun double(f, x) =
  f(f(x))
//│ double: ∀η, θ, ι. ((η → ι) ∧ (ι → θ)) → η → θ

