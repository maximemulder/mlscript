:ctml

fun id(x) =
  x
//│ id: ∀α. α → α

id(1)
//│ ⊥

fun apply(f, x) =
  f(x)
//│ apply: ∀α, β. (α → β) → α → β

fun double(f, x) =
  f(f(x))
//│ double: ∀α, β, γ. ((α → β) ∧ (β → γ)) → α → γ

double(id, 1)
//│ ⊥

fun foo(a, b) =
  a(1, b)
//│ foo: ∀α. (Int → α → ⊤) → α → ⊥

foo((+), 1)
//│ ⊥

:te
foo((++), 1)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α. (Int → α → ⊤) → α → ⊥ ≤ (Str → Str → Str) → β.
//│ Typing error tree:
//│   ∀α. (Int → α → ⊤) → α → ⊥ ≤ (Str → Str → Str) → β
//│     (Int → γ → ⊤) → γ → ⊥ ≤ (Str → Str → Str) → β
//│       Str → Str → Str ≤ Int → γ → ⊤
//│         Int ≤ Str
