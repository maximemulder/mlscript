// Primitive MLScript definitions.
class Object
class Function
class untyped

val equals

// CTML top and bottom types.
class Top
class Bot

class Unit
class Bool
class Int
class Nat extends Int
class Num
class Str

val top: Top
val bot: Bot

val unit   : Unit
val bool   : Bool
val int    : Int
val num    : Num
val string : Str

val _if_: [A] -> Bool -> A -> A -> A
val fix:  [A] -> (A -> A) -> A

val (+):  Int -> Int -> Int
val (-):  Int -> Int -> Int
val (++): Str -> Str -> Str
val (==): [A] -> A -> A -> Bool
val (&&): Bool -> Bool -> Bool
val (||): Bool -> Bool -> Bool

abstract class (<:<) Sub[A, B] with
  fun apply(x: A): B
abstract class (=:=) Eq[A, B] extends Sub[A, B] with
  fun apply(x: A): B
object Refl[A] extends Eq[A, A] with
  fun apply(x: A): A = x

type (>:>) Sup[A, B]
