declare class Object
declare class Function
declare class untyped

// CTML top and bottom types.

declare class Top
declare class Bot

declare class Unit
declare class True
declare class False
declare class Int
declare class Num
declare class Str

type Bool = True | False

val top: Top
val bot: Bot

val unit   : Unit
val true_  : True
val false_ : False
val bool   : Bool
val int    : Int
val num    : Num
val string : Str

declare fun if_: [A, B] -> (True -> A -> Top -> A) & (False -> Top -> B -> B)

declare val (+): Int -> Int -> Int
declare val (-): Int -> Int -> Int

declare val (++): Str -> Str -> Str
