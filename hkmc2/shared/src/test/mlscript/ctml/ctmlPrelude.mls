// Primitive MLScript classes.
class Object
class Function
class untyped

// CTML top and bottom types.
class Top
class Bot

class Unit
class Bool
class Int
class Num
class Str

val top: Top
val bot: Bot

val unit   : Unit
val bool   : Bool
val int    : Int
val num    : Num
val string : Str

val _if_: [A] -> Bool -> A -> A -> A
val fix:  [A] -> (A -> A) -> A

val (+):  Int -> Int -> Int
val (-):  Int -> Int -> Int
val (++): Str -> Str -> Str
val (==): [A] -> A -> A -> Bool
val (&&): Bool -> Bool -> Bool
val (||): Bool -> Bool -> Bool
