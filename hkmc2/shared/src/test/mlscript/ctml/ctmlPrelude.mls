// Primitive MLScript classes.
declare class Object
declare class Function
declare class untyped

// CTML top and bottom types.
declare class Top
declare class Bot

declare class Unit
declare class Bool
declare class Int
declare class Num
declare class Str

val top: Top
val bot: Bot

val unit   : Unit
val bool   : Bool
val int    : Int
val num    : Num
val string : Str

val _if_: [A] -> Bool -> A -> A -> A
val fix:  [A] -> (A -> A) -> A

val (+):  Int -> Int -> Int
val (-):  Int -> Int -> Int
val (++): Str -> Str -> Str
val (==): [A] -> A -> A -> Bool
val (&&): Bool -> Bool -> Bool
val (||): Bool -> Bool -> Bool
