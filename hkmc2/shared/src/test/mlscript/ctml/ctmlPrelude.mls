// Primitive MLScript classes.
declare class Object
declare class Function
declare class untyped

// CTML top and bottom types.
declare type Top
declare type Bot

declare class Unit
declare class Bool
declare class Int
declare class Num
declare class Str

val top: Top
val bot: Bot

val unit   : Unit
val bool   : Bool
val int    : Int
val num    : Num
val string : Str

declare val (+): Int -> Int -> Int
declare val (-): Int -> Int -> Int
