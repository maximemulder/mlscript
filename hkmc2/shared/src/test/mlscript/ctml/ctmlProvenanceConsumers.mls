fun lengthStep(self, xs) = if xs is
  LNil() then 0
  LCons(_, t) then 1 + self(t)
//│ @ctml-search calls=3383 checks=3261 fresh=10 infer=11 origins=4 groups=5 max-per-group=2 exact=0 abstract=0 cuts=41 max-clauses=51 max-goal-nodes=103
//│ lengthStep: ∀α, β, γ. {α ≤ ¬({β ≤ LNil} ⟹ ⊥) ∨ ¬({β ≤ ({tail: γ} ∧ LCons) ∧ {head: ⊤}} ⟹ ¬(γ → Int)), β ≤ LNil ∨ ¬({α ≤ γ → Int} ⟹ ¬(({tail: γ} ∧ LCons) ∧ {head: ⊤}))} ⟹ α → β → (({β ≤ LNil} ⟹ Int) ∧ ({α ≤ γ → Int, β ≤ ({tail: γ} ∧ LCons) ∧ {head: ⊤}} ⟹ Int))

:fixme // FIXME: Closing length exhausts the solver budget in guarded-bound comparisons.
val length = fix(lengthStep)
