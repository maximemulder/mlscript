:ctml
:ctml-cfg provenance-cut profile-search search-steps 20000 check-steps 128

// Bounded optional queries expose finite guarded recursive schemes. The nonempty-list calls
// remain known inference failures: finishing a definition is not evidence of a useful contract.

/** Empty list. */
data class LNil()
/** A list cell. */
data class LCons(head, tail)
//│ @ctml-search calls=0 checks=0 fresh=0 infer=0 origins=0 groups=0 max-per-group=0 exact=0 abstract=0 cuts=0 max-clauses=0 max-goal-nodes=0
//│ LNil: Unit → LNil
//│ @ctml-search calls=94 checks=94 fresh=0 infer=2 origins=0 groups=0 max-per-group=0 exact=0 abstract=0 cuts=0 max-clauses=31 max-goal-nodes=6
//│ LCons: ∀α, β. α → β → ((LCons ∧ {head: α}) ∧ {tail: β})

fun walkStep(self, xs) = if xs is
  LNil() then 0
  LCons(_, t) then self(t)
//│ @ctml-search calls=3538 checks=3433 fresh=10 infer=9 origins=4 groups=5 max-per-group=2 exact=0 abstract=0 cuts=65 max-clauses=49 max-goal-nodes=97
//│ walkStep: ∀α, β, γ, δ. {α ≤ ¬({β ≤ LNil, γ ≥ Int} ⟹ ⊥) ∨ ¬({β ≤ ({tail: δ} ∧ LCons) ∧ {head: ⊤}} ⟹ ¬(δ → γ)), β ≤ ¬({γ ≥ Int} ⟹ ¬LNil) ∨ ¬({α ≤ δ → γ} ⟹ ¬(({tail: δ} ∧ LCons) ∧ {head: ⊤})), γ ≥ ({β ≤ LNil} ⟹ Int) ∧ ({α ≤ δ → γ, β ≤ ({tail: δ} ∧ LCons) ∧ {head: ⊤}} ⟹ ⊥)} ⟹ α → β → γ

val walk = fix(walkStep)
//│ @ctml-search calls=4182 checks=4145 fresh=10 infer=1 origins=5 groups=5 max-per-group=2 exact=99 abstract=0 cuts=244 max-clauses=60 max-goal-nodes=87
