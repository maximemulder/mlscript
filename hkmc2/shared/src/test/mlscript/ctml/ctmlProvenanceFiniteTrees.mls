//│                                                   PCons ≤ ⊥
//│                                                   {head: (PNode ∧ {label: Str}) ∧ {children: PNil}} ≤ ⊥
//│                                                     (PNode ∧ {label: Str}) ∧ {children: PNil} ≤ ⊥
//│                                                       PNode ∧ {label: Str} ≤ ⊥
//│                                                         PNode ≤ ⊥
//│                                                         {label: Str} ≤ ⊥
//│                                                           Str ≤ ⊥
//│                                                       {children: PNil} ≤ ⊥
//│                                                         PNil ≤ ⊥
//│                                                 {tail: PNil} ≤ ⊥
//│                                                   PNil ≤ ⊥
//│                                 {tail: PNil} ≤ ⊥
//│                                   PNil ≤ ⊥

// A simpler nested-field encoding exercises the same policy without the tree constructors.
type FieldChain = [X restricts (Int | {next: X})] -> X
//│ FieldChain = ∀X. {X ≥ Int ∨ {next: X}} ⟹ X

type GoodChain = {next: {next: {next: {next: {next: {next: {next: {next: {next: {next: Int}}}}}}}}}}
//│ GoodChain = {next: {next: {next: {next: {next: {next: {next: {next: {next: {next: Int}}}}}}}}}}

GoodChain <:< FieldChain
//│ @ctml-search calls=91 checks=0 fresh=1 infer=0 origins=1 groups=1 max-per-group=1 exact=0 abstract=2 cuts=0 max-clauses=41 max-goal-nodes=19
//│ OK

type BadChain = {next: {next: {next: {next: {next: {next: {next: {next: {next: {next: Str}}}}}}}}}}
