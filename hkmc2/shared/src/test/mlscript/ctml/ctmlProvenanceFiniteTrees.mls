:ctml

// Finite source structures can revisit a coarse key while their literal syntax decreases.
/** Empty child list. */
data class PNil()
//│ PNil: Unit → PNil

/** A child and the remainder of its ordered list. */
data class PCons(head, tail)
//│ PCons: ∀α, β. α → β → ((PCons ∧ {head: α}) ∧ {tail: β})

/** A string-labeled node and its children. */
data class PNode(label, children)
//│ PNode: ∀α, β. α → β → ((PNode ∧ {label: α}) ∧ {children: β})

/** Construct a binary node without prescribing a recursive invariant. */
fun binary(left, right) = PNode("node", PCons(left, PCons(right, PNil())))
//│ binary: ∀α, β. α → β → ((PNode ∧ {label: Str}) ∧ {children: (PCons ∧ {head: α}) ∧ {tail: (PCons ∧ {head: β}) ∧ {tail: PNil}}})

val leaf = PNode("leaf", PNil())
val pair = binary(leaf, leaf)
val child = binary(pair, leaf)
val tree = binary(child, pair)
//│ leaf: (PNode ∧ {label: Str}) ∧ {children: PNil}
//│ pair: (PNode ∧ {label: Str}) ∧ {children: (PCons ∧ {head: (PNode ∧ {label: Str}) ∧ {children: PNil}}) ∧ {tail: (PCons ∧ {head: (PNode ∧ {label: Str}) ∧ {children: PNil}}) ∧ {tail: PNil}}}
//│ child: (PNode ∧ {label: Str}) ∧ {children: (PCons ∧ {head: (PNode ∧ {label: Str}) ∧ {children: (PCons ∧ {head: (PNode ∧ {label: Str}) ∧ {children: PNil}}) ∧ {tail: (PCons ∧ {head: (PNode ∧ {label: Str}) ∧ {children: PNil}}) ∧ {tail: PNil}}}}) ∧ {tail: (PCons ∧ {head: (PNode ∧ {label: Str}) ∧ {children: PNil}}) ∧ {tail: PNil}}}
//│ tree: (PNode ∧ {label: Str}) ∧ {children: (PCons ∧ {head: (PNode ∧ {label: Str}) ∧ {children: (PCons ∧ {head: (PNode ∧ {label: Str}) ∧ {children: (PCons ∧ {head: (PNode ∧ {label: Str}) ∧ {children: PNil}}) ∧ {tail: (PCons ∧ {head: (PNode ∧ {label: Str}) ∧ {children: PNil}}) ∧ {tail: PNil}}}}) ∧ {tail: (PCons ∧ {head: (PNode ∧ {label: Str}) ∧ {children: PNil}}) ∧ {tail: PNil}}}}) ∧ {tail: (PCons ∧ {head: (PNode ∧ {label: Str}) ∧ {children: (PCons ∧ {head: (PNode ∧ {label: Str}) ∧ {children: PNil}}) ∧ {tail: (PCons ∧ {head: (PNode ∧ {label: Str}) ∧ {children: PNil}}) ∧ {tail: PNil}}}}) ∧ {tail: PNil}}}

// The invariant is a result assertion; ordinary source definitions remain unannotated.
type PTree = [T restricts (PNode & {label: Str} & {children: ([L restricts (PNil | (PCons & {head: T} & {tail: L}))] -> L)})] -> T
//│ PTree = ∀T. {T ≥ (PNode ∧ {label: Str}) ∧ {children: ∀L. {L ≥ PNil ∨ ((PCons ∧ {head: T}) ∧ {tail: L})} ⟹ L}} ⟹ T

:ctml-cfg profile-search search-steps 5000

leaf as PTree
//│ @ctml-search calls=15 checks=0 fresh=2 infer=0 origins=2 groups=2 max-per-group=1 exact=0 abstract=0 cuts=0 max-clauses=37 max-goal-nodes=30
//│ PTree

pair as PTree
//│ @ctml-search calls=133 checks=0 fresh=4 infer=0 origins=2 groups=2 max-per-group=3 exact=0 abstract=0 cuts=0 max-clauses=40 max-goal-nodes=54
//│ PTree

tree as PTree
//│ @ctml-search calls=727 checks=0 fresh=10 infer=0 origins=2 groups=2 max-per-group=9 exact=0 abstract=1 cuts=0 max-clauses=47 max-goal-nodes=126
//│ PTree

// Wrong labels and children must fail by subtyping, not merely by a recurring search cut.
:te
PNode(1, PNil()) as PTree
//│ @ctml-search calls=41 checks=8 fresh=3 infer=3 origins=3 groups=3 max-per-group=1 exact=0 abstract=0 cuts=0 max-clauses=55 max-goal-nodes=30
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ PTree.
//│ Typing error tree:
//│   α ≤ PTree
//│     (PNode ∧ {label: β}) ∧ {children: γ} ≤ PTree
//│       (PNode ∧ {label: β}) ∧ {children: γ} ≤ ∀T. {T ≥ (PNode ∧ {label: Str}) ∧ {children: ∀L. {L ≥ PNil ∨ ((PCons ∧ {head: T}) ∧ {tail: L})} ⟹ L}} ⟹ T
//│         (PNode ∧ {label: β}) ∧ {children: γ} ≤ {δ ≥ (PNode ∧ {label: Str}) ∧ {children: ∀L. {L ≥ PNil ∨ ((PCons ∧ {head: δ}) ∧ {tail: L})} ⟹ L}} ⟹ δ
//│           (PNode ∧ {label: β}) ∧ {children: γ} ≤ δ
//│             (PNode ∧ {label: β}) ∧ {children: γ} ≤ PNode ∧ {label: Str}
//│               (PNode ∧ {label: β}) ∧ {children: γ} ≤ {label: Str}
//│                 PNode ∧ {label: β} ≤ {label: Str}
//│                   PNode ≤ {label: Str}
//│                   {label: β} ≤ {label: Str}
//│                     β ≤ Str
//│                       Int ≤ Str
//│                 {children: γ} ≤ {label: Str}
//│                   γ ≤ ⊥
//│                     ε ≤ ⊥
//│                       PNil ≤ ⊥

:te
PNode("node", 1) as PTree
//│ @ctml-search calls=49 checks=6 fresh=4 infer=2 origins=4 groups=4 max-per-group=1 exact=0 abstract=0 cuts=0 max-clauses=55 max-goal-nodes=30
