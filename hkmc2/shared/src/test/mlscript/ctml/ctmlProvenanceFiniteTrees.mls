//│                                                       Str ≤ ⊥
//│                                                   {children: PNil} ≤ ⊥
//│                                                     PNil ≤ ⊥
//│                                             {tail: (PCons ∧ {head: (PNode ∧ {label: Str}) ∧ {children: PNil}}) ∧ {tail: PNil}} ≤ ⊥
//│                                               (PCons ∧ {head: (PNode ∧ {label: Str}) ∧ {children: PNil}}) ∧ {tail: PNil} ≤ ⊥
