//│         (PNode ∧ {label: β}) ∧ {children: γ} ≤ {δ ≥ (PNode ∧ {label: Str}) ∧ {children: ∀L. {L ≥ PNil ∨ ((PCons ∧ {head: δ}) ∧ {tail: L})} ⟹ L}} ⟹ δ
//│           (PNode ∧ {label: β}) ∧ {children: γ} ≤ δ
//│             (PNode ∧ {label: β}) ∧ {children: γ} ≤ {children: ∀L. {L ≥ PNil ∨ ((PCons ∧ {head: δ}) ∧ {tail: L})} ⟹ L}
//│               PNode ∧ {label: β} ≤ {children: ∀L. {L ≥ PNil ∨ ((PCons ∧ {head: δ}) ∧ {tail: L})} ⟹ L}
//│                 PNode ≤ {children: ∀L. {L ≥ PNil ∨ ((PCons ∧ {head: δ}) ∧ {tail: L})} ⟹ L}
//│                 {label: β} ≤ {children: ∀L. {L ≥ PNil ∨ ((PCons ∧ {head: δ}) ∧ {tail: L})} ⟹ L}
//│                   β ≤ ⊥
//│                     Str ≤ ⊥
//│               {children: γ} ≤ {children: ∀L. {L ≥ PNil ∨ ((PCons ∧ {head: δ}) ∧ {tail: L})} ⟹ L}
//│                 γ ≤ ∀L. {L ≥ PNil ∨ ((PCons ∧ {head: δ}) ∧ {tail: L})} ⟹ L
//│                   Int ≤ ∀L. {L ≥ PNil ∨ ((PCons ∧ {head: δ}) ∧ {tail: L})} ⟹ L
//│                     Int ≤ {ε ≥ PNil ∨ ((PCons ∧ {head: δ}) ∧ {tail: ε})} ⟹ ε
//│                       Int ≤ ε
//│                         Int ≤ PNil
//│                         Int ≤ (PCons ∧ {head: δ}) ∧ {tail: ε}
//│                           Int ≤ PCons ∧ {head: δ}
//│                             Int ≤ PCons

:te
PNode("node", PCons(1, PNil())) as PTree
//│ @ctml-search calls=107 checks=16 fresh=6 infer=5 origins=6 groups=6 max-per-group=1 exact=0 abstract=0 cuts=0 max-clauses=75 max-goal-nodes=30
