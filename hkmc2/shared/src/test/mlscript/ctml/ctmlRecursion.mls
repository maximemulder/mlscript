:ctml

fun fibonacci(n) =
  if n == 0 || n == 1 then
    n
  else
    fibonacci(n - 2) + fibonacci(n - 1)
//│ fibonacci: ∀α, β, γ, δ. {α ≥ Int → ({β ≤ (Int → γ) ∧ (Int → δ), γ ≤ Int, δ ≤ Int} ⟹ Int), β ≥ α} ⟹ α

fun zero(i) =
  if i == 0
    then i
    else zero(i - 1)
//│ zero: ∀α, β. {α ≥ ∀γ. Int → ({β ≤ Int → γ} ⟹ γ), β ≥ α} ⟹ α

val infinite = infinite + 1
//│ infinite: Int

fun recursive(x) =
  recursive(x)
//│ recursive: ⊤ → ⊥

val never = never
//│ never: ⊥
