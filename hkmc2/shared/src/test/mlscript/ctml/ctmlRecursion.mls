:ctml

fun fibonacci(n) =
  if n == 0 || n == 1 then
    n
  else
    fibonacci(n - 2) + fibonacci(n - 1)
//│ fibonacci: Int → Int

fun zero(i) =
  if i == 0
    then i
    else zero(i - 1)
//│ zero: Int → Int

// Recursive values require an initialization semantics; only functions can be recursive.

:pe
val infinite = infinite + 1
//│ ═══[PARSE ERROR] Recursive bindings require a function initializer.

fun recursive(x) =
  recursive(x)
//│ recursive: ⊤ → ⊥

:pe
val never = never
//│ ═══[PARSE ERROR] Recursive bindings require a function initializer.
