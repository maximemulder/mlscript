:ctml

fun fibonacci(n) =
  if n == 0 || n == 1 then
    n
  else
    fibonacci(n - 2) + fibonacci(n - 1)
//│ fibonacci: Int → Int

fun zero(i) =
  if i == 0
    then i
    else zero(i - 1)
