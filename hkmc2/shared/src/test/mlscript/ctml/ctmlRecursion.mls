:ctml

fun fibonacci(n) =
  if n == 0 || n == 1 then
    n
  else
    fibonacci(n - 2) + fibonacci(n - 1)
//│ fibonacci: ∀α, β, γ, δ. {α ≥ Int → ({δ ≤ (Int → γ) ∧ (Int → β), γ ≤ Int, β ≤ Int} ⟹ Int), δ ≥ α, δ ≤ (Int → γ) ∧ (Int → β), γ ≤ Int, β ≤ Int} ⟹ Int → Int

fun zero(i) =
  if i == 0
    then i
    else zero(i - 1)
//│ zero: ∀α, β, γ. {α ≥ ∀δ. β → ({γ ≤ Int → δ} ⟹ δ), β ≤ Int, γ ≥ α} ⟹ β → (β ∨ (∀δ. {γ ≤ Int → δ} ⟹ δ))

val infinite = infinite + 1
//│ infinite: Int

fun recursive(x) =
  recursive(x)
//│ recursive: ⊤ → ⊥

val never = never
//│ never: ⊥
