:ctml

type F
type Rec = [X restricts F[X]] -> X
type Based = [X restricts (Str | F[X])] -> X
type Separate = [X restricts F[X]] -> ([Str <:< X] => Int -> X)
type Reversed = [X restricts Str] -> ([F[X] <:< X] => Int -> X)
//│ Rec = ∀X. {X ≥ F[X]} ⟹ X
//│ Based = ∀X. {X ≥ Str ∨ F[X]} ⟹ X
//│ Separate = ∀X. {X ≥ F[X], Str ≤ X} ⟹ Int → X
//│ Reversed = ∀X. {X ≥ Str, F[X] ≤ X} ⟹ Int → X

Separate <:< (Int -> Based)
//│ OK

Reversed <:< (Int -> Based)
//│ OK

declare fun separate: Separate
separate[Based] as (Int -> Based)
//│ separate: Separate
//│ Int → Based

:te
Separate <:< (Int -> Rec)
//│ ═══[TYPE ERROR] Cannot solve judgment Separate ≤ Int → Rec.
//│ Typing error tree:
//│   Separate ≤ Int → Rec
//│     ∀X. {X ≥ F[X], Str ≤ X} ⟹ Int → X ≤ Int → Rec
//│       Int → (∀X. {X ≥ F[X], Str ≤ X} ⟹ X) ≤ Int → Rec
//│         ∀X. {X ≥ F[X], Str ≤ X} ⟹ X ≤ Rec
//│           ∀X. {X ≥ F[X], Str ≤ X} ⟹ X ≤ ∀X. {X ≥ F[X]} ⟹ X
//│             ∀X. {X ≥ F[X], Str ≤ X} ⟹ X ≤ {α ≥ F[α]} ⟹ α
//│               ∀X. {X ≥ F[X], Str ≤ X} ⟹ X ≤ α
//│                 ∀X. {X ≥ F[X], Str ≤ X} ⟹ X ≤ F[α]
//│                   {β ≥ F[β], Str ≤ β} ⟹ β ≤ F[α]
//│                     {Str ≤ β} ⟹ β ≤ F[α]
//│                       β ≤ F[α]
//│                         F[β] ∨ Str ≤ F[α]
//│                           F[β] ≤ F[α]
//│                             β ≤ α
//│                               F[β] ∨ Str ≤ α
//│                                 Str ≤ α
//│                                   Str ≤ F[α]

type G
type Both = [X restricts (F[X] | G[X])] -> X
type TwoSteps = [X restricts F[X]] -> ([G[X] <:< X] => Int -> X)
//│ Both = ∀X. {X ≥ F[X] ∨ G[X]} ⟹ X
//│ TwoSteps = ∀X. {X ≥ F[X], G[X] ≤ X} ⟹ Int → X

TwoSteps <:< (Int -> Both)
//│ OK

:te
TwoSteps <:< (Int -> Rec)
//│ ═══[TYPE ERROR] Cannot solve judgment TwoSteps ≤ Int → Rec.
//│ Typing error tree:
//│   TwoSteps ≤ Int → Rec
//│     ∀X. {X ≥ F[X], G[X] ≤ X} ⟹ Int → X ≤ Int → Rec
//│       Int → (∀X. {X ≥ F[X], G[X] ≤ X} ⟹ X) ≤ Int → Rec
//│         ∀X. {X ≥ F[X], G[X] ≤ X} ⟹ X ≤ Rec
//│           ∀X. {X ≥ F[X], G[X] ≤ X} ⟹ X ≤ ∀X. {X ≥ F[X]} ⟹ X
//│             ∀X. {X ≥ F[X], G[X] ≤ X} ⟹ X ≤ {α ≥ F[α]} ⟹ α
//│               ∀X. {X ≥ F[X], G[X] ≤ X} ⟹ X ≤ α
//│                 ∀X. {X ≥ F[X], G[X] ≤ X} ⟹ X ≤ F[α]
//│                   {β ≥ F[β], G[β] ≤ β} ⟹ β ≤ F[α]
//│                     {G[β] ≤ β} ⟹ β ≤ F[α]
//│                       β ≤ F[α]
//│                         F[β] ∨ G[β] ≤ F[α]
//│                           F[β] ≤ F[α]
//│                             β ≤ α
//│                               F[β] ∨ G[β] ≤ α
//│                                 G[β] ≤ α
//│                                   G[β] ≤ F[α]
//│                                     G ≤ F
//│                                       G ≤ ⊥
//│                                         ⊤ ≤ ⊥

// The parameter bound remains an obligation after closing the result carrier.
type Parameter = [A, X restricts F[X]] -> ([A <:< Int] => A -> X)
//│ Parameter = ∀A, X. {X ≥ F[X], A ≤ Int} ⟹ A → X

Parameter <:< (Int -> Rec)
//│ OK

:te
Parameter <:< (Str -> Rec)
//│ ═══[TYPE ERROR] Cannot solve judgment Parameter ≤ Str → Rec.
//│ Typing error tree:
//│   Parameter ≤ Str → Rec
//│     ∀A, X. {X ≥ F[X], A ≤ Int} ⟹ A → X ≤ Str → Rec
//│       ∀A. {A ≤ Int} ⟹ A → (∀X. {X ≥ F[X]} ⟹ X) ≤ Str → Rec
//│         {α ≤ Int} ⟹ α → (∀X. {X ≥ F[X]} ⟹ X) ≤ Str → Rec
//│           α → (∀X. {X ≥ F[X]} ⟹ X) ≤ Str → Rec
//│             Str ≤ α
//│               Str ≤ Int

declare fun parameter: Parameter
//│ parameter: Parameter

parameter[Int, Rec] as (Int -> Rec)
//│ Int → Rec

type Mutual = [X, Y] -> ([F[Y] <:< X] => ([G[X] <:< Y] => Int -> X))
type Combined = [Z restricts F[G[Z]]] -> Z
//│ Mutual = ∀X, Y. {F[Y] ≤ X, G[X] ≤ Y} ⟹ Int → X
//│ Combined = ∀Z. {Z ≥ F[G[Z]]} ⟹ Z

:fixme // FIXME: Implicit instantiation does not synthesize a carrier for coupled bounds.
Mutual <:< (Int -> Combined)
//│ ═══[TYPE ERROR] Judgment F[18] ≤ 19 repeats a judgment in progress through a cycle of bounds.
//│ Typing error tree:
//│   Mutual ≤ Int → Combined
//│     ∀X, Y. {F[Y] ≤ X, G[X] ≤ Y} ⟹ Int → X ≤ Int → Combined
//│       {F[β] ≤ α, G[α] ≤ β} ⟹ Int → α ≤ Int → Combined
//│         {G[α] ≤ β} ⟹ Int → α ≤ Int → Combined
//│           Int → α ≤ Int → Combined
//│             α ≤ Combined
//│               F[β] ≤ Combined
//│                 F[β] ≤ ∀Z. {Z ≥ F[G[Z]]} ⟹ Z
//│                   F[β] ≤ {γ ≥ F[G[γ]]} ⟹ γ
//│                     F[β] ≤ γ
//│                       F[β] ≤ F[G[γ]]
//│                         β ≤ G[γ]
//│                           G[α] ≤ G[γ]
//│                             α ≤ γ
//│                               F[β] ≤ γ

declare fun mutual: Mutual
//│ mutual: Mutual

mutual[Combined, G[Combined]] as (Int -> Combined)
//│ Int → Combined

:te
mutual[Str, Int] as (Int -> Combined)
//│ ═══[TYPE ERROR] Cannot solve judgment G[Str] ≤ Int.
//│ Typing error tree:
//│   G[Str] ≤ Int

/** Both result components are closed under the same covariant layer. */
type Shared = [X, Y] -> ([F[[X, Y]] <:< X] => ([F[[X, Y]] <:< Y] => Int -> [X, Y]))
type Tree = [Z restricts F[[Z, Z]]] -> Z
//│ Shared = ∀X, Y. {F[⟨X, Y⟩] ≤ X, F[⟨X, Y⟩] ≤ Y} ⟹ Int → ⟨X, Y⟩
//│ Tree = ∀Z. {Z ≥ F[⟨Z, Z⟩]} ⟹ Z

Shared <:< (Int -> [Tree, Tree])
//│ OK

:te
Shared <:< (Int -> [Tree, Str])
//│ ═══[TYPE ERROR] Cannot solve judgment Shared ≤ Int → ⟨Tree, Str⟩.
//│ Typing error tree:
//│   Shared ≤ Int → ⟨Tree, Str⟩
//│     ∀X, Y. {F[⟨X, Y⟩] ≤ X, F[⟨X, Y⟩] ≤ Y} ⟹ Int → ⟨X, Y⟩ ≤ Int → ⟨Tree, Str⟩
//│       Int → ⟨∀X. {X ≥ F[⟨X, X⟩]} ⟹ X, ∀X. {X ≥ F[⟨X, X⟩]} ⟹ X⟩ ≤ Int → ⟨Tree, Str⟩
//│         ⟨∀X. {X ≥ F[⟨X, X⟩]} ⟹ X, ∀X. {X ≥ F[⟨X, X⟩]} ⟹ X⟩ ≤ ⟨Tree, Str⟩
//│           ∀X. {X ≥ F[⟨X, X⟩]} ⟹ X ≤ Str
//│             {α ≥ F[⟨α, α⟩]} ⟹ α ≤ Str
//│               α ≤ Str
//│                 F[⟨α, α⟩] ≤ Str

/** The extra lower bound on Y must also hold at the chosen instance. */
type SharedBase = [X, Y] -> ([F[[X, Y]] <:< X] => ([F[[X, Y]] <:< Y] => ([Str <:< Y] => Int -> Y)))
//│ SharedBase = ∀X, Y. {F[⟨X, Y⟩] ≤ X, F[⟨X, Y⟩] ≤ Y, Str ≤ Y} ⟹ Int → Y

:te
SharedBase <:< (Int -> Tree)
//│ ═══[TYPE ERROR] Cannot solve judgment SharedBase ≤ Int → Tree.
//│ Typing error tree:
//│   SharedBase ≤ Int → Tree
//│     ∀X, Y. {F[⟨X, Y⟩] ≤ X, F[⟨X, Y⟩] ≤ Y, Str ≤ Y} ⟹ Int → Y ≤ Int → Tree
//│       Int → (Str ∨ (∀X. {X ≥ F[⟨X, Str ∨ X⟩]} ⟹ X)) ≤ Int → Tree
//│         Str ∨ (∀X. {X ≥ F[⟨X, Str ∨ X⟩]} ⟹ X) ≤ Tree
//│           Str ∨ (∀X. {X ≥ F[⟨X, Str ∨ X⟩]} ⟹ X) ≤ ∀Z. {Z ≥ F[⟨Z, Z⟩]} ⟹ Z
//│             Str ∨ (∀X. {X ≥ F[⟨X, Str ∨ X⟩]} ⟹ X) ≤ {α ≥ F[⟨α, α⟩]} ⟹ α
//│               Str ∨ (∀X. {X ≥ F[⟨X, Str ∨ X⟩]} ⟹ X) ≤ α
//│                 Str ≤ α
//│                   Str ≤ F[⟨α, α⟩]

/** The result carrier and the argument may require different instances. */
type SharedDomain = [X, Y] -> ([F[[X, Y]] <:< X] => ([F[[X, Y]] <:< Y] => Y -> X))
//│ SharedDomain = ∀X, Y. {F[⟨X, Y⟩] ≤ X, F[⟨X, Y⟩] ≤ Y} ⟹ Y → X

declare fun sharedDomain: SharedDomain
//│ sharedDomain: SharedDomain

sharedDomain[Top, Top] as (Str -> Top)
//│ Str → ⊤

SharedDomain <:< (Str -> Top)
//│ OK

/** A carrier can share a recursive bound without occurring in its layer. */
type SharedTail = [X, Y] -> ([F[X] <:< Y] => ([F[X] <:< X] => Int -> Y))
//│ SharedTail = ∀X, Y. {F[X] ≤ Y, F[X] ≤ X} ⟹ Int → Y

SharedTail <:< (Int -> Rec)
//│ OK

/** Every instance must also place Y below Str. */
type SharedUpper = [X, Y] -> ([F[[X, Y]] <:< X] => ([F[[X, Y]] <:< Y] => ([Y <:< Str] => Int -> X)))
//│ SharedUpper = ∀X, Y. {F[⟨X, Y⟩] ≤ X, F[⟨X, Y⟩] ≤ Y, Y ≤ Str} ⟹ Int → X

:te
SharedUpper <:< (Int -> Tree)
//│ ═══[TYPE ERROR] Cannot solve judgment SharedUpper ≤ Int → Tree.
//│ Typing error tree:
//│   SharedUpper ≤ Int → Tree
//│     ∀X, Y. {F[⟨X, Y⟩] ≤ X, F[⟨X, Y⟩] ≤ Y, Y ≤ Str} ⟹ Int → X ≤ Int → Tree
//│       {F[⟨α, β⟩] ≤ α, F[⟨α, β⟩] ≤ β, β ≤ Str} ⟹ Int → α ≤ Int → Tree
//│         {F[⟨α, β⟩] ≤ β, β ≤ Str} ⟹ Int → α ≤ Int → Tree
//│           {β ≤ Str} ⟹ Int → α ≤ Int → Tree
//│             β ≤ Str
//│               F[⟨α, β⟩] ≤ Str

/** Only the second component needs the string base. Both contain the recursive layer. */
type Offset = [Z restricts F[[Z, (Str | Z)]]] -> Z
type Unequal = [X, Y] -> ([F[[X, Y]] <:< (X & Y)] => ([Str <:< Y] => Int -> [X, Y]))
//│ Offset = ∀Z. {Z ≥ F[⟨Z, Str ∨ Z⟩]} ⟹ Z
//│ Unequal = ∀X, Y. {F[⟨X, Y⟩] ≤ X ∧ Y, Str ≤ Y} ⟹ Int → ⟨X, Y⟩

Unequal <:< (Int -> [Offset, (Str | Offset)])
//│ OK

:te
Unequal <:< (Int -> [Offset, Offset])
//│ ═══[TYPE ERROR] Cannot solve judgment Unequal ≤ Int → ⟨Offset, Offset⟩.
//│ Typing error tree:
//│   Unequal ≤ Int → ⟨Offset, Offset⟩
//│     ∀X, Y. {F[⟨X, Y⟩] ≤ X ∧ Y, Str ≤ Y} ⟹ Int → ⟨X, Y⟩ ≤ Int → ⟨Offset, Offset⟩
//│       Int → ⟨∀X. {X ≥ F[⟨X, Str ∨ X⟩]} ⟹ X, Str ∨ (∀X. {X ≥ F[⟨X, Str ∨ X⟩]} ⟹ X)⟩ ≤ Int → ⟨Offset, Offset⟩
//│         ⟨∀X. {X ≥ F[⟨X, Str ∨ X⟩]} ⟹ X, Str ∨ (∀X. {X ≥ F[⟨X, Str ∨ X⟩]} ⟹ X)⟩ ≤ ⟨Offset, Offset⟩
//│           Str ∨ (∀X. {X ≥ F[⟨X, Str ∨ X⟩]} ⟹ X) ≤ Offset
//│             Str ∨ (∀X. {X ≥ F[⟨X, Str ∨ X⟩]} ⟹ X) ≤ ∀Z. {Z ≥ F[⟨Z, Str ∨ Z⟩]} ⟹ Z
//│               Str ∨ (∀X. {X ≥ F[⟨X, Str ∨ X⟩]} ⟹ X) ≤ {α ≥ F[⟨α, Str ∨ α⟩]} ⟹ α
//│                 Str ∨ (∀X. {X ≥ F[⟨X, Str ∨ X⟩]} ⟹ X) ≤ α
//│                   Str ≤ α
//│                     Str ≤ F[⟨α, Str ∨ α⟩]

/** A union on the lower side gives the same obligations as separate guards. */
type Packed = [X, Y] -> ([F[[X, Y]] <:< X] => ([(Str | F[[X, Y]]) <:< Y] => Int -> [X, Y]))
//│ Packed = ∀X, Y. {F[⟨X, Y⟩] ≤ X, Str ∨ F[⟨X, Y⟩] ≤ Y} ⟹ Int → ⟨X, Y⟩

Packed <:< (Int -> [Offset, (Str | Offset)])
//│ OK

/** Each component retains its own base when closing the common recursive layer. */
type Distinct = [X, Y] -> ([(Int | F[[X, Y]]) <:< X] => ([(Str | F[[X, Y]]) <:< Y] => Int -> [X, Y]))
type Core = [Z restricts F[[(Int | Z), (Str | Z)]]] -> Z
//│ Distinct = ∀X, Y. {Int ∨ F[⟨X, Y⟩] ≤ X, Str ∨ F[⟨X, Y⟩] ≤ Y} ⟹ Int → ⟨X, Y⟩
//│ Core = ∀Z. {Z ≥ F[⟨Int ∨ Z, Str ∨ Z⟩]} ⟹ Z

Distinct <:< (Int -> [(Int | Core), (Str | Core)])
//│ OK

/** A union in a field payload gives both carriers the same recursive lower bounds. */
type FieldTree = [Z restricts (Str | {tail: Z})] -> Z
type FieldPair = [X, Y] -> ([{tail: X | Y} <:< X] => ([{tail: X} <:< Y] => ([{tail: Y} <:< Y] => ([Str <:< (X & Y)] => Int -> [X, Y]))))
//│ FieldTree = ∀Z. {Z ≥ Str ∨ {tail: Z}} ⟹ Z
//│ FieldPair = ∀X, Y. {{tail: X ∨ Y} ≤ X, {tail: X} ≤ Y, {tail: Y} ≤ Y, Str ≤ X ∧ Y} ⟹ Int → ⟨X, Y⟩

FieldPair <:< (Int -> [FieldTree, FieldTree])
//│ OK

:te
FieldPair <:< (Int -> [FieldTree, {tail: Top}])
//│ ═══[TYPE ERROR] Cannot solve judgment FieldPair ≤ Int → ⟨FieldTree, {tail: ⊤}⟩.
//│ Typing error tree:
//│   FieldPair ≤ Int → ⟨FieldTree, {tail: ⊤}⟩
//│     ∀X, Y. {{tail: X ∨ Y} ≤ X, {tail: X} ≤ Y, {tail: Y} ≤ Y, Str ≤ X ∧ Y} ⟹ Int → ⟨X, Y⟩ ≤ Int → ⟨FieldTree, {tail: ⊤}⟩
//│       Int → ⟨∀X. {X ≥ {tail: X}, X ≥ Str} ⟹ X, ∀X. {X ≥ {tail: X}, X ≥ Str} ⟹ X⟩ ≤ Int → ⟨FieldTree, {tail: ⊤}⟩
//│         ⟨∀X. {X ≥ {tail: X}, X ≥ Str} ⟹ X, ∀X. {X ≥ {tail: X}, X ≥ Str} ⟹ X⟩ ≤ ⟨FieldTree, {tail: ⊤}⟩
//│           ∀X. {X ≥ {tail: X}, X ≥ Str} ⟹ X ≤ {tail: ⊤}
//│             {α ≥ {tail: α}, α ≥ Str} ⟹ α ≤ {tail: ⊤}
//│               {α ≥ Str} ⟹ α ≤ {tail: ⊤}
//│                 α ≤ {tail: ⊤}
//│                   {tail: α} ∨ Str ≤ {tail: ⊤}
//│                     Str ≤ {tail: ⊤}

/** De Morgan exposes the two owners of the same recursive lower bound. */
type BothOwners = [X, Y] -> ([F[[X, Y]] <:< ~(~X | ~Y)] => Int -> [X, Y])
//│ BothOwners = ∀X, Y. {F[⟨X, Y⟩] ≤ ¬(¬X ∨ ¬Y)} ⟹ Int → ⟨X, Y⟩

BothOwners <:< (Int -> [Tree, Tree])
//│ OK
