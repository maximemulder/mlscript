:ctml

// Recursive consumer diagnostics; no encoded recursive type is needed for the timeout.

/** Empty list. */
data class LNil()
/** A list cell with unrestricted constructor fields. */
data class LCons(head, tail)
//│ LNil: Unit → LNil
//│ LCons: ∀α, β. α → β → ((LCons ∧ {head: α}) ∧ {tail: β})

/** Traverse a list using a supplied recursive call, without arithmetic or reconstruction. */
fun walkStep(self, xs) = if xs is
  LNil() then 0
  LCons(_, t) then self(t)
//│ walkStep: ∀α, β, γ, δ. {α ≤ ¬({β ≤ LNil, γ ≥ Int} ⟹ ⊥) ∨ ¬({β ≤ ({tail: δ} ∧ LCons) ∧ {head: ⊤}} ⟹ ¬(δ → γ)), β ≤ ¬({γ ≥ Int} ⟹ ¬LNil) ∨ ¬({α ≤ δ → γ} ⟹ ¬(({tail: δ} ∧ LCons) ∧ {head: ⊤})), γ ≥ ({β ≤ LNil} ⟹ Int) ∧ ({α ≤ δ → γ, β ≤ ({tail: δ} ∧ LCons) ∧ {head: ⊤}} ⟹ ⊥)} ⟹ α → β → γ

/** Count cells using a supplied recursive call. */
fun lengthStep(self, xs) = if xs is
  LNil() then 0
  LCons(_, t) then 1 + self(t)
//│ lengthStep: ∀α, β, γ. {α ≤ ¬({β ≤ LNil} ⟹ ⊥) ∨ ¬({β ≤ ({tail: γ} ∧ LCons) ∧ {head: ⊤}} ⟹ ¬(γ → Int)), β ≤ LNil ∨ ¬({α ≤ γ → Int} ⟹ ¬(({tail: γ} ∧ LCons) ∧ {head: ⊤}))} ⟹ α → β → (({β ≤ LNil} ⟹ Int) ∧ ({α ≤ γ → Int, β ≤ ({tail: γ} ∧ LCons) ∧ {head: ⊤}} ⟹ Int))

/** Reconstruct cells using a supplied recursive call. */
fun copyStep(self, xs) = if xs is
  LNil() then LNil()
  LCons(h, t) then LCons(h, self(t))
//│ copyStep: ∀α, β, γ, δ, ε, ζ. {α ≤ ¬({β ≤ LNil, γ ≥ LNil} ⟹ ⊥) ∨ ¬({β ≤ ({head: δ} ∧ {tail: ε}) ∧ LCons, γ ≥ (LCons ∧ {head: δ}) ∧ {tail: ζ}} ⟹ ¬(ε → ζ)), β ≤ ¬({γ ≥ LNil} ⟹ ¬LNil) ∨ ¬({α ≤ ε → ζ, γ ≥ (LCons ∧ {head: δ}) ∧ {tail: ζ}} ⟹ ¬(({head: δ} ∧ {tail: ε}) ∧ LCons)), γ ≥ ({β ≤ LNil} ⟹ LNil) ∧ ({α ≤ ε → ζ, β ≤ ({head: δ} ∧ {tail: ε}) ∧ LCons} ⟹ (LCons ∧ {head: δ}) ∧ {tail: ζ})} ⟹ α → β → γ

/** Map elements using a supplied recursive call. */
fun mapStep(self, f, xs) = if xs is
  LNil() then LNil()
  LCons(h, t) then LCons(f(h), self(f, t))
//│ mapStep: ∀α, β, γ, δ, ε, ζ, η, θ. {δ ≥ ({γ ≤ LNil} ⟹ LNil) ∧ ({α ≤ β → ζ → θ, β ≤ ε → η, γ ≤ ({head: ε} ∧ {tail: ζ}) ∧ LCons} ⟹ (LCons ∧ {head: η}) ∧ {tail: θ}), γ ≤ ¬({δ ≥ LNil} ⟹ ¬LNil) ∨ ¬({α ≤ β → ζ → θ, β ≤ ε → η, δ ≥ (LCons ∧ {head: η}) ∧ {tail: θ}} ⟹ ¬(({head: ε} ∧ {tail: ζ}) ∧ LCons)), α ≤ ¬({γ ≤ LNil, δ ≥ LNil} ⟹ ⊥) ∨ ¬({β ≤ ε → η, γ ≤ ({head: ε} ∧ {tail: ζ}) ∧ LCons, δ ≥ (LCons ∧ {head: η}) ∧ {tail: θ}} ⟹ ¬(β → ζ → θ)), β ≤ ¬({γ ≤ LNil, δ ≥ LNil} ⟹ ⊥) ∨ ¬({α ≤ β → ζ → θ, γ ≤ ({head: ε} ∧ {tail: ζ}) ∧ LCons, δ ≥ (LCons ∧ {head: η}) ∧ {tail: θ}} ⟹ ¬(ε → η))} ⟹ α → β → γ → δ

