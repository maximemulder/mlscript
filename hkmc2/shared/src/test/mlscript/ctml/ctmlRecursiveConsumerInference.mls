/** Recursive field access without a branch retains a compact recursive constraint. */
fun spin(xs) = spin(xs.tail)
//│ spin: ∀α. {α ≤ {tail: α}} ⟹ {tail: α} → ⊥

/** Ordinary integer recursion supplies a nonstructural control. */
fun countdown(n) = if n == 0 then 0 else countdown(n - 1)
//│ countdown: Int → Int

// Explicit recursive invariants are a separate checking control.
/** Encoded integer lists for the explicit-invariant control. */
type IntList = [X restricts (LNil | (LCons & {head: Int} & {tail: X}))] -> X
/** One exposed layer of an integer list. */
type IntLayer = LNil | (LCons & {head: Int} & {tail: IntList})
//│ IntList = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X
//│ IntLayer = LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: IntList})

/** Check the traversal body with an explicit invariant and one exposed list layer. */
val checkedWalk = fix[IntList -> Int]((self: IntList -> Int) => xs =>
  if (xs as IntLayer) is
    LNil() then 0
    LCons(_, t) then (self as (IntList -> Int))(t))
//│ checkedWalk: IntList → Int

checkedWalk(LCons(1, LCons(2, LNil()))) as Int
//│ Int

:te
checkedWalk(LCons(1, false))
//│ ═══[TYPE ERROR] Cannot solve judgment IntList → Int ≤ α → β.
//│ Typing error tree:
//│   IntList → Int ≤ α → β
//│     α ≤ IntList
//│       (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ IntList
//│         (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X
//│           (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ {ε ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ε})} ⟹ ε
//│             (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ ε
//│               (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ LNil
//│                 LCons ∧ {head: γ} ≤ LNil
//│                   LCons ≤ LNil
//│                   {head: γ} ≤ LNil
//│                     γ ≤ ⊥
//│                       Int ≤ ⊥
//│                 {tail: δ} ≤ LNil
//│                   δ ≤ ⊥
//│                     Bool ≤ ⊥
//│               (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ (LCons ∧ {head: Int}) ∧ {tail: ε}
//│                 (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ {tail: ε}
//│                   LCons ∧ {head: γ} ≤ {tail: ε}
//│                     LCons ≤ {tail: ε}
//│                     {head: γ} ≤ {tail: ε}
//│                       γ ≤ ⊥
//│                         Int ≤ ⊥
//│                   {tail: δ} ≤ {tail: ε}
//│                     δ ≤ ε
//│                       Bool ≤ ε
//│                         Bool ≤ LNil
//│                         Bool ≤ (LCons ∧ {head: Int}) ∧ {tail: ε}
//│                           Bool ≤ LCons ∧ {head: Int}
//│                             Bool ≤ LCons
