//│               LNil ≤ (¬({δ ≤ LNil} ⟹ ¬LNil) ∨ ¬({δ ≤ ({head: Int} ∧ LCons) ∧ {tail: ⊤}} ⟹ ¬(({head: Int} ∧ LCons) ∧ {tail: ⊤}))) ∧ IntLayer
