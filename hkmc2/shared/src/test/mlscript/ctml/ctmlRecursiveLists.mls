// Generic map is checked for arbitrary rigid input and output element types.
type A
type B
type ListA = [X restricts (LNil | (LCons & {head: A} & {tail: X}))] -> X
type ListB = [X restricts (LNil | (LCons & {head: B} & {tail: X}))] -> X
type LayerA = LNil | (LCons & {head: A} & {tail: ListA})
//│ ListA = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: X})} ⟹ X
//│ ListB = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: B}) ∧ {tail: X})} ⟹ X
//│ LayerA = LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: ListA})

type MapAB = (A -> B) -> ListA -> ListB
//│ MapAB = (A → B) → ListA → ListB

val map = fix[MapAB]((self: MapAB) =>
  (f: A -> B) => xs =>
  if (xs as LayerA) is
    LNil() then LNil()
    LCons(head, tail) then LCons((f as (A -> B))(head), (self as MapAB)(f, tail)))
//│ map: MapAB

map as ((A -> B) -> ListA -> ListB)
//│ (A → B) → ListA → ListB

/** The supplied recursion invariant for the shared Nofib append. */
type AppendA = ListA -> ListA -> ListA
//│ AppendA = ListA → ListA → ListA

/** Check that append preserves the element type and the recursive tail invariant. */
val append = fix[AppendA]((self: AppendA) => xs => (ys: ListA) =>
  if (xs as LayerA) is
    LNil() then ys
    LCons(x, rest) then LCons(x, (self as AppendA)(rest, ys)))
//│ append: AppendA

/** The supplied recursion invariant for the accumulator in the shared Nofib listLen. */
type CountA = ListA -> Int -> Int
//│ CountA = ListA → Int → Int

/** Check the source accumulator traversal for arbitrary list elements. */
fun listLen(xs: ListA): Int =
  /** Count the remaining elements starting from the supplied offset. */
  let loop = fix[CountA]((self: CountA) => rest => (n: Int) =>
    if (rest as LayerA) is
      LNil() then n
      LCons(_, tail) then (self as CountA)(tail, n + 1))
  (loop as CountA)(xs, 0)
//│ listLen: ListA → Int

// A left scan always produces the initial accumulator, even when the input is empty.
/** A nonempty list of accumulator values for a scan over rigid element types A and B. */
type ScanResult = LCons & {head: B} & {tail: ListB}
//│ ScanResult = (LCons ∧ {head: B}) ∧ {tail: ListB}

/** The supplied recursion invariant for the shared Nofib scanl. */
type ScanAB = (B -> A -> B) -> B -> ListA -> ScanResult
//│ ScanAB = (B → A → B) → B → ListA → ScanResult

/** Check the scanl implementation with the recursive list invariant supplied. */
val scanl = fix[ScanAB]((self: ScanAB) =>
  (f: B -> A -> B) => (q: B) => xs =>
  if (xs as LayerA) is
    LNil() then LCons(q, LNil())
    LCons(x, tail) then LCons(q, (self as ScanAB)(f, (f as (B -> A -> B))(q, x), tail)))
//│ scanl: ScanAB

// The compact recursive spelling needs the list invariant while checking its pattern branches.
:fixme // FIXME: Recursive signature inference does not recover the required list invariant.
fun inferredLength(xs: IntList): Int = if xs is
  LNil() then 0
  LCons(_, tail) then 1 + inferredLength(tail)
