:ctml

data class LNil()
data class LCons(head, tail)
//│ LNil: Unit → LNil
//│ LCons: ∀α, β. α → β → ((LCons ∧ {head: α}) ∧ {tail: β})

type IntList = [X restricts (LNil | (LCons & {head: Int} & {tail: X}))] -> X
type IntLayer = LNil | (LCons & {head: Int} & {tail: IntList})
//│ IntList = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X
//│ IntLayer = LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: IntList})

// These helpers are checked identity functions, not trusted declarations.
fun unroll(xs: IntList): IntLayer = (xs as IntList)[IntLayer]
fun roll(xs: IntLayer): IntList = xs
//│ unroll: IntList → IntLayer
//│ roll: IntLayer → IntList

fun head(xs: LCons & {head: Int} & {tail: IntList}): Int = xs.head
fun tail(xs: LCons & {head: Int} & {tail: IntList}): IntList = xs.tail
//│ head: (({head: Int} ∧ LCons) ∧ {tail: IntList}) → Int
//│ tail: (({tail: IntList} ∧ LCons) ∧ {head: Int}) → IntList

val pair: IntList = LCons(1, LCons(2, LNil()))
roll(unroll(pair)) as IntList
//│ pair: IntList
//│ IntList

fun firstOrZero(xs: IntLayer): Int = if xs is
  LNil() then 0
  LCons(head, _) then head
//│ firstOrZero: IntLayer → Int

firstOrZero(unroll(pair)) as Int
//│ Int

val enumFromTo = fix[Int -> Int -> IntList](self => a => b =>
  if a == b then LNil() else LCons(a, self(a + 1, b)))
//│ enumFromTo: Int → Int → IntList

enumFromTo(1, 5) as IntList
//│ IntList

// The supplied fixed-point type checks recursion without inferring its invariant.
val length = fix[IntList -> Int]((self: IntList -> Int) => xs => if (xs as IntLayer) is
  LNil() then 0
  LCons(_, tail) then 1 + (self as (IntList -> Int))(tail))
//│ length: IntList → Int

length(enumFromTo(1, 5)) as Int
//│ Int

type IntMap = (Int -> Int) -> IntList -> IntList
//│ IntMap = (Int → Int) → IntList → IntList

val mapInt = fix[IntMap]((self: IntMap) =>
  (f: Int -> Int) => xs =>
  if (xs as IntLayer) is
    LNil() then LNil()
    LCons(head, tail) then LCons((f as (Int -> Int))(head), (self as IntMap)(f, tail)))
//│ mapInt: IntMap

length(mapInt(x => x + 1, enumFromTo(1, 5))) as Int
//│ Int

:te
length(LCons(1, false))
//│ ═══[TYPE ERROR] Cannot solve judgment IntList → Int ≤ α → β.
//│ Typing error tree:
//│   IntList → Int ≤ α → β
//│     α ≤ IntList
//│       (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ IntList
//│         (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X
//│           (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ {ε ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ε})} ⟹ ε
//│             (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ ε
//│               (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ LNil
//│                 LCons ∧ {head: γ} ≤ LNil
//│                   LCons ≤ LNil
//│                   {head: γ} ≤ LNil
//│                     γ ≤ ⊥
//│                       Int ≤ ⊥
//│                 {tail: δ} ≤ LNil
//│                   δ ≤ ⊥
//│                     Bool ≤ ⊥
//│               (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ (LCons ∧ {head: Int}) ∧ {tail: ε}
//│                 (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ {tail: ε}
//│                   LCons ∧ {head: γ} ≤ {tail: ε}
//│                     LCons ≤ {tail: ε}
//│                     {head: γ} ≤ {tail: ε}
//│                       γ ≤ ⊥
//│                         Int ≤ ⊥
//│                   {tail: δ} ≤ {tail: ε}
//│                     δ ≤ ε
//│                       Bool ≤ ε
//│                         Bool ≤ LNil
//│                         Bool ≤ (LCons ∧ {head: Int}) ∧ {tail: ε}
//│                           Bool ≤ LCons ∧ {head: Int}
//│                             Bool ≤ LCons

:te
mapInt(x => "bad", pair)
//│ ═══[TYPE ERROR] Cannot solve judgment IntMap ≤ (⊤ → Str) → α.
//│ Typing error tree:
//│   IntMap ≤ (⊤ → Str) → α
//│     (Int → Int) → IntList → IntList ≤ (⊤ → Str) → α
//│       ⊤ → Str ≤ Int → Int
//│         Str ≤ Int

// Generic map is checked for arbitrary rigid input and output element types.
type A
type B
type ListA = [X restricts (LNil | (LCons & {head: A} & {tail: X}))] -> X
type ListB = [X restricts (LNil | (LCons & {head: B} & {tail: X}))] -> X
type LayerA = LNil | (LCons & {head: A} & {tail: ListA})
//│ ListA = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: X})} ⟹ X
//│ ListB = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: B}) ∧ {tail: X})} ⟹ X
//│ LayerA = LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: ListA})

type MapAB = (A -> B) -> ListA -> ListB
//│ MapAB = (A → B) → ListA → ListB

val map = fix[MapAB]((self: MapAB) =>
  (f: A -> B) => xs =>
  if (xs as LayerA) is
    LNil() then LNil()
    LCons(head, tail) then LCons((f as (A -> B))(head), (self as MapAB)(f, tail)))
//│ map: MapAB

map as ((A -> B) -> ListA -> ListB)
//│ (A → B) → ListA → ListB

// The compact recursive spelling needs the list invariant while checking its pattern branches.
:fixme // FIXME: Recursive signature inference does not recover the required list invariant.
fun inferredLength(xs: IntList): Int = if xs is
  LNil() then 0
  LCons(_, tail) then 1 + inferredLength(tail)
