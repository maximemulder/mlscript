//│                         {ζ ≤ λ → Int, θ ≤ {tail: λ} ∧ ((LCons ∧ {head: ⊤}) ∧ {tail: ⊤}) ∧ ¬LNil} ⟹ Int ≤ Int
//│                           {θ ≤ {tail: λ} ∧ ((LCons ∧ {head: ⊤}) ∧ {tail: ⊤}) ∧ ¬LNil} ⟹ Int ≤ Int
//│                             θ ≤ {tail: λ} ∧ ((LCons ∧ {head: ⊤}) ∧ {tail: ⊤}) ∧ ¬LNil
//│                               η ≤ {tail: λ} ∧ ((LCons ∧ {head: ⊤}) ∧ {tail: ⊤}) ∧ ¬LNil
//│                                 (IntList ∧ ¬LNil) ∧ LCons ≤ {tail: λ} ∧ ((LCons ∧ {head: ⊤}) ∧ {tail: ⊤}) ∧ ¬LNil
//│                                   (IntList ∧ ¬LNil) ∧ LCons ≤ {tail: λ}
//│                                     IntList ∧ ¬LNil ≤ {tail: λ}
//│                                       IntList ≤ {tail: λ}
//│                                         ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X ≤ {tail: λ}
//│                                           {ν ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ν})} ⟹ ν ≤ {tail: λ}
//│                                             ν ≤ {tail: λ}
//│                                               LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ν}) ≤ {tail: λ}
//│                                                 LNil ≤ {tail: λ}
//│                                       ¬LNil ≤ {tail: λ}
//│                                     LCons ≤ {tail: λ}

