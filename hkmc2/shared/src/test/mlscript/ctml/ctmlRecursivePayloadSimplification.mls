:ctml

/** Empty list. */
data class LNil()
/** A structural list cell. */
data class LCons(head, tail)
//│ LNil: Unit → LNil
//│ LCons: ∀α, β. α → β → ((LCons ∧ {head: α}) ∧ {tail: β})

/** A precise contract isolates payload simplification from recursive implementation inference. */
declare fun copy[A]: ([X restricts (LNil | (LCons & {head: A} & {tail: X}))] -> X) -> ([Y restricts (LNil | (LCons & {head: A} & {tail: Y}))] -> Y)
//│ copy: ∀A. (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: X})} ⟹ X) → (∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: Y})} ⟹ Y)

/** Generalization must retain the payload shared by the nested input and output carriers. */
val forwarded = copy
//│ forwarded: ∀A, Y. {Y ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: Y})} ⟹ (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: X})} ⟹ X) → Y

type IntList = [X restricts (LNil | (LCons & {head: Int} & {tail: X}))] -> X
//│ IntList = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X

// Supply the result witness to test payload preservation independently of witness selection.
forwarded[Int][IntList](LCons(1, LNil())) as IntList
//│ IntList

:te
forwarded[Int][IntList](LCons("bad", LNil()))
//│ ═══[TYPE ERROR] Cannot solve judgment (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X) → IntList ≤ α → β.
//│ Typing error tree:
//│   (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X) → IntList ≤ α → β
//│     α ≤ ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X
//│       (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X
//│         (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ {ε ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ε})} ⟹ ε
//│           (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ ε
//│             (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ LNil
//│               LCons ∧ {head: γ} ≤ LNil
//│                 LCons ≤ LNil
//│                 {head: γ} ≤ LNil
//│                   γ ≤ ⊥
//│                     Str ≤ ⊥
//│               {tail: δ} ≤ LNil
//│                 δ ≤ ⊥
//│                   ζ ≤ ⊥
//│                     LNil ≤ ⊥
//│             (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ (LCons ∧ {head: Int}) ∧ {tail: ε}
//│               (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ LCons ∧ {head: Int}
//│                 (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ {head: Int}
//│                   LCons ∧ {head: γ} ≤ {head: Int}
//│                     LCons ≤ {head: Int}
//│                     {head: γ} ≤ {head: Int}
//│                       γ ≤ Int
//│                         Str ≤ Int
//│                   {tail: δ} ≤ {head: Int}
//│                     δ ≤ ⊥
//│                       ζ ≤ ⊥
//│                         LNil ≤ ⊥

/** Copy the list produced by a callback. Its element type flows through the result guard. */
fun copyResult(x, produce) = copy(produce(x))
//│ copyResult: ∀α, β, Y. {Y ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Y})} ⟹ α → (∀X. α → ({X ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: X})} ⟹ X)) → Y

/** Supply the same arguments in callback-first order. */
fun copyResultFrom(produce, x) = copy(produce(x))
//│ copyResultFrom: ∀α, β, Y. {Y ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Y})} ⟹ (∀X. α → ({X ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: X})} ⟹ X)) → α → Y

copyResult(1, n => LCons(n, LNil())) as IntList
copyResultFrom(n => LCons(n, LNil()), 1) as IntList
//│ IntList
//│ IntList

:te
copyResult("bad", s => LCons(s, LNil())) as IntList
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ IntList.
//│ Typing error tree:
//│   α ≤ IntList
//│     ∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Y})} ⟹ Y ≤ IntList
//│       ∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Y})} ⟹ Y ≤ ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X
//│         ∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Y})} ⟹ Y ≤ {γ ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: γ})} ⟹ γ
//│           ∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Y})} ⟹ Y ≤ γ
//│             ∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Y})} ⟹ Y ≤ LNil
//│               {δ ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: δ})} ⟹ δ ≤ LNil
//│                 δ ≤ LNil
//│                   LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: δ}) ≤ LNil
//│                     (LCons ∧ {head: β}) ∧ {tail: δ} ≤ LNil
//│                       LCons ∧ {head: β} ≤ LNil
//│                         LCons ≤ LNil
//│                         {head: β} ≤ LNil
//│                           β ≤ ⊥
//│                             ε ≤ ⊥
//│                               Str ≤ ⊥
//│                       {tail: δ} ≤ LNil
//│                         δ ≤ ⊥
//│                           LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: δ}) ≤ ⊥
//│                             LNil ≤ ⊥
//│             ∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Y})} ⟹ Y ≤ (LCons ∧ {head: Int}) ∧ {tail: γ}
//│               ∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Y})} ⟹ Y ≤ LCons ∧ {head: Int}
//│                 ∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Y})} ⟹ Y ≤ LCons
//│                   {ζ ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: ζ})} ⟹ ζ ≤ LCons
//│                     ζ ≤ LCons
//│                       LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: ζ}) ≤ LCons
//│                         LNil ≤ LCons
