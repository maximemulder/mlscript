:ctml

/** Empty list. */
data class LNil()
/** A structural list cell. */
data class LCons(head, tail)
//│ LNil: Unit → LNil
//│ LCons: ∀α, β. α → β → ((LCons ∧ {head: α}) ∧ {tail: β})

/** A precise contract isolates payload simplification from recursive implementation inference. */
declare fun copy[A]: ([X restricts (LNil | (LCons & {head: A} & {tail: X}))] -> X) -> ([Y restricts (LNil | (LCons & {head: A} & {tail: Y}))] -> Y)
//│ copy: ∀A. (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: X})} ⟹ X) → (∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: Y})} ⟹ Y)

/** Generalization must retain the payload shared by the nested input and output carriers. */
val forwarded = copy
//│ forwarded: ∀A, Y. {Y ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: Y})} ⟹ (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: X})} ⟹ X) → Y

type IntList = [X restricts (LNil | (LCons & {head: Int} & {tail: X}))] -> X
//│ IntList = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X

// Supply the result witness to test payload preservation independently of witness selection.
forwarded[Int][IntList](LCons(1, LNil())) as IntList
//│ IntList

:te
forwarded[Int][IntList](LCons("bad", LNil()))
//│ ═══[TYPE ERROR] Cannot solve judgment (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X) → IntList ≤ α → β.
//│ Typing error tree:
//│   (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X) → IntList ≤ α → β
//│     α ≤ ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X
//│       (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X
//│         (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ {ε ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ε})} ⟹ ε
//│           (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ ε
//│             (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ LNil
//│               LCons ∧ {head: γ} ≤ LNil
//│                 LCons ≤ LNil
//│                 {head: γ} ≤ LNil
//│                   γ ≤ ⊥
//│                     Str ≤ ⊥
//│               {tail: δ} ≤ LNil
//│                 δ ≤ ⊥
//│                   ζ ≤ ⊥
//│                     LNil ≤ ⊥
//│             (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ (LCons ∧ {head: Int}) ∧ {tail: ε}
//│               (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ LCons ∧ {head: Int}
//│                 (LCons ∧ {head: γ}) ∧ {tail: δ} ≤ {head: Int}
//│                   LCons ∧ {head: γ} ≤ {head: Int}
//│                     LCons ≤ {head: Int}
//│                     {head: γ} ≤ {head: Int}
//│                       γ ≤ Int
//│                         Str ≤ Int
//│                   {tail: δ} ≤ {head: Int}
//│                     δ ≤ ⊥
//│                       ζ ≤ ⊥
//│                         LNil ≤ ⊥
