:ctml

data class Nil()
data class Cons(head, tail)
type R = [X restricts (Nil | (Cons & {head: Int} & {tail: X}))] -> X
type P = [X restricts (Nil | (Cons & {head: Int} & {tail: X}))] ->
  Int -> (Nil | (Cons & {head: Int} & {tail: X}))
declare fun p: P
//│ Nil: Unit → Nil
//│ Cons: ∀α, β. α → β → ((Cons ∧ {head: α}) ∧ {tail: β})
//│ R = ∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X})} ⟹ X
//│ P = ∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X})} ⟹ Int → (Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X}))
//│ p: P

p[R] as (Int -> R)
p[R](1) as R
p(1) as R
//│ Int → R
//│ R
//│ R

:te
p("bad")
//│ ═══[TYPE ERROR] Cannot solve judgment P ≤ Str → α.
//│ Typing error tree:
//│   P ≤ Str → α
//│     ∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X})} ⟹ Int → (Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X})) ≤ Str → α
//│       Int → (Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: ∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X})} ⟹ X})) ≤ Str → α
//│         Str ≤ Int

// A further lower bound changes the set of admissible carriers.
type WithBase = [X restricts (Nil | (Cons & {head: Int} & {tail: X}))] ->
  ([Str <:< X] => Int -> X)
//│ WithBase = ∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X}), Str ≤ X} ⟹ Int → X

:te
WithBase <:< (Int -> R)
//│ ═══[TYPE ERROR] Cannot solve judgment WithBase ≤ Int → R.
//│ Typing error tree:
//│   WithBase ≤ Int → R
//│     ∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X}), Str ≤ X} ⟹ Int → X ≤ Int → R
//│       Int → (∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X}), X ≥ Str} ⟹ X) ≤ Int → R
//│         ∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X}), X ≥ Str} ⟹ X ≤ R
//│           ∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X}), X ≥ Str} ⟹ X ≤ ∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X})} ⟹ X
//│             ∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X}), X ≥ Str} ⟹ X ≤ {α ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: α})} ⟹ α
//│               ∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X}), X ≥ Str} ⟹ X ≤ α
//│                 ∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X}), X ≥ Str} ⟹ X ≤ Nil
//│                   {β ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: β}), β ≥ Str} ⟹ β ≤ Nil
//│                     {β ≥ Str} ⟹ β ≤ Nil
//│                       β ≤ Nil
//│                         (Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: β})) ∨ Str ≤ Nil
//│                           Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: β}) ≤ Nil
//│                             (Cons ∧ {head: Int}) ∧ {tail: β} ≤ Nil
//│                               Cons ∧ {head: Int} ≤ Nil
//│                                 Cons ≤ Nil
//│                                 {head: Int} ≤ Nil
//│                                   Int ≤ ⊥
//│                               {tail: β} ≤ Nil
//│                                 β ≤ ⊥
//│                                   (Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: β})) ∨ Str ≤ ⊥
//│                                     Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: β}) ≤ ⊥
//│                                       Nil ≤ ⊥
//│                 ∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X}), X ≥ Str} ⟹ X ≤ (Cons ∧ {head: Int}) ∧ {tail: α}
//│                   ∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X}), X ≥ Str} ⟹ X ≤ Cons ∧ {head: Int}
//│                     ∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X}), X ≥ Str} ⟹ X ≤ Cons
//│                       {γ ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: γ}), γ ≥ Str} ⟹ γ ≤ Cons
//│                         {γ ≥ Str} ⟹ γ ≤ Cons
//│                           γ ≤ Cons
//│                             (Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: γ})) ∨ Str ≤ Cons
//│                               Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: γ}) ≤ Cons
//│                                 Nil ≤ Cons

// The mixed-variance result may need the larger witness Top.
type Endo = [X restricts (Nil | (Cons & {head: Int} & {tail: X}))] -> X -> X
Endo <:< (Top -> Top)
//│ Endo = ∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X})} ⟹ X → X
//│ OK

// Close the two record coordinates at their simultaneous least solution.
type Root = [T restricts (Nil | {next: {back: T}})] -> T
type Pair = [X, Y] ->
  ([(Nil | {next: Y}) <:< X] => ([{back: X} <:< Y] => Int -> ({left: X} & {right: Y})))
Pair <:< (Int -> ({left: Root} & {right: {back: Root}}))
//│ Root = ∀T. {T ≥ Nil ∨ {next: {back: T}}} ⟹ T
//│ Pair = ∀X, Y. {Nil ∨ {next: Y} ≤ X, {back: X} ≤ Y} ⟹ Int → ({left: X} ∧ {right: Y})
//│ OK

declare fun both: Pair
both[Root, {back: Root}] as (Int -> ({left: Root} & {right: {back: Root}}))
//│ both: Pair
//│ Int → ({left: Root} ∧ {right: {back: Root}})

// Each admissible first coordinate includes Nil.

:te
Pair <:< (Int -> ({left: Str} & {right: {back: Root}}))
//│ ═══[TYPE ERROR] Cannot solve judgment Pair ≤ Int → ({left: Str} ∧ {right: {back: Root}}).
//│ Typing error tree:
//│   Pair ≤ Int → ({left: Str} ∧ {right: {back: Root}})
//│     ∀X, Y. {Nil ∨ {next: Y} ≤ X, {back: X} ≤ Y} ⟹ Int → ({left: X} ∧ {right: Y}) ≤ Int → ({left: Str} ∧ {right: {back: Root}})
//│       Int → ({left: Nil ∨ {next: ∀Y. {Y ≥ {back: Nil ∨ {next: Y}}} ⟹ Y}} ∧ {right: ∀Y. {Y ≥ {back: Nil ∨ {next: Y}}} ⟹ Y}) ≤ Int → ({left: Str} ∧ {right: {back: Root}})
//│         {left: Nil ∨ {next: ∀Y. {Y ≥ {back: Nil ∨ {next: Y}}} ⟹ Y}} ∧ {right: ∀Y. {Y ≥ {back: Nil ∨ {next: Y}}} ⟹ Y} ≤ {left: Str} ∧ {right: {back: Root}}
//│           {left: Nil} ∧ {right: ∀Y. {Y ≥ {back: Nil ∨ {next: Y}}} ⟹ Y} ≤ {left: Str} ∧ {right: {back: Root}}
//│             {left: Nil} ∧ {right: ∀Y. {Y ≥ {back: Nil ∨ {next: Y}}} ⟹ Y} ≤ {left: Str}
//│               {left: Nil} ≤ {left: Str}
//│                 Nil ≤ Str
//│               {right: ∀Y. {Y ≥ {back: Nil ∨ {next: Y}}} ⟹ Y} ≤ {left: Str}
//│                 ∀Y. {Y ≥ {back: Nil ∨ {next: Y}}} ⟹ Y ≤ ⊥
//│                   {α ≥ {back: Nil ∨ {next: α}}} ⟹ α ≤ ⊥
//│                     α ≤ ⊥
//│                       {back: Nil ∨ {next: α}} ≤ ⊥
//│                         {back: Nil} ≤ ⊥
//│                           Nil ≤ ⊥

type Swapped = [Y, X] ->
  ([{back: X} <:< Y] => ([(Nil | {next: Y}) <:< X] => Int -> ({left: X} & {right: Y})))
Swapped <:< (Int -> ({left: Root} & {right: {back: Root}}))
//│ Swapped = ∀Y, X. {{back: X} ≤ Y, Nil ∨ {next: Y} ≤ X} ⟹ Int → ({left: X} ∧ {right: Y})
//│ OK

// Follow the fields around the ring once, then observe the tag at its root.
data class First(next)
data class Second(middle)
data class Third(back)
type Ring3 = [X, Y, Z] ->
  ([(Nil | (First & {next: Y})) <:< X] => ([(Second & {middle: Z}) <:< Y] =>
    ([(Third & {back: X}) <:< Z] => Int -> ({x: X} & {y: Y} & {z: Z}))))
type Root3 = Nil | (First & {next: (Second & {middle: (Third & {back: (Nil | First)})})})
type Z3 = Third & {back: Root3}
type Y3 = Second & {middle: Z3}
type Result3 = Int -> ({x: Root3} & {y: Y3} & {z: Z3})
Ring3 <:< Result3
//│ First: ∀α. α → (First ∧ {next: α})
//│ Second: ∀β. β → (Second ∧ {middle: β})
//│ Third: ∀γ. γ → (Third ∧ {back: γ})
//│ Ring3 = ∀X, Y, Z. {Nil ∨ (First ∧ {next: Y}) ≤ X, Second ∧ {middle: Z} ≤ Y, Third ∧ {back: X} ≤ Z} ⟹ Int → (({x: X} ∧ {y: Y}) ∧ {z: Z})
//│ Root3 = Nil ∨ (First ∧ {next: Second ∧ {middle: Third ∧ {back: Nil ∨ First}}})
//│ Z3 = Third ∧ {back: Root3}
//│ Y3 = Second ∧ {middle: Z3}
//│ Result3 = Int → (({x: Root3} ∧ {y: Y3}) ∧ {z: Z3})
//│ OK

// Rotate both the quantifiers and the guards while observing the same result coordinates.
type Rotated3 = [Z, X, Y] ->
  ([(Second & {middle: Z}) <:< Y] => ([(Third & {back: X}) <:< Z] =>
    ([(Nil | (First & {next: Y})) <:< X] => Int -> ({x: X} & {y: Y} & {z: Z}))))
Rotated3 <:< Result3
//│ Rotated3 = ∀Z, X, Y. {Second ∧ {middle: Z} ≤ Y, Third ∧ {back: X} ≤ Z, Nil ∨ (First ∧ {next: Y}) ≤ X} ⟹ Int → (({x: X} ∧ {y: Y}) ∧ {z: Z})
//│ OK

// This exact target closes the ring at x. Compare explicit and inferred witnesses.
type FoldX = [T restricts (Nil | (First & {next: (Second & {middle: (Third & {back: T})})}))] -> T
type FoldZ = Third & {back: FoldX}
type FoldY = Second & {middle: FoldZ}
type Folded3 = Int -> ({x: FoldX} & {y: FoldY} & {z: FoldZ})
declare fun three: Ring3
three[FoldX, FoldY, FoldZ] as Folded3
//│ FoldX = ∀T. {T ≥ Nil ∨ (First ∧ {next: Second ∧ {middle: Third ∧ {back: T}}})} ⟹ T
//│ FoldZ = Third ∧ {back: FoldX}
//│ FoldY = Second ∧ {middle: FoldZ}
//│ Folded3 = Int → (({x: FoldX} ∧ {y: FoldY}) ∧ {z: FoldZ})
//│ three: Ring3
//│ Folded3

Ring3 <:< Folded3
//│ OK

// Close the same three coordinates at z.
type AtZ = [T restricts (Third & {back: (Nil | (First & {next: (Second & {middle: T})}))})] -> T
type AtY = Second & {middle: AtZ}
type AtX = Nil | (First & {next: AtY})
Ring3 <:< (Int -> ({x: AtX} & {y: AtY} & {z: AtZ}))
//│ AtZ = ∀T. {T ≥ Third ∧ {back: Nil ∨ (First ∧ {next: Second ∧ {middle: T}})}} ⟹ T
//│ AtY = Second ∧ {middle: AtZ}
//│ AtX = Nil ∨ (First ∧ {next: AtY})
//│ OK

// The x coordinate of every admissible tuple includes the Nil seed.

:te
Ring3 <:< (Int -> ({x: Str}))
//│ ═══[TYPE ERROR] Cannot solve judgment Ring3 ≤ Int → {x: Str}.
//│ Typing error tree:
//│   Ring3 ≤ Int → {x: Str}
//│     ∀X, Y, Z. {Nil ∨ (First ∧ {next: Y}) ≤ X, Second ∧ {middle: Z} ≤ Y, Third ∧ {back: X} ≤ Z} ⟹ Int → (({x: X} ∧ {y: Y}) ∧ {z: Z}) ≤ Int → {x: Str}
//│       Int → (({x: Nil ∨ (First ∧ {next: Second ∧ {middle: ∀Z. {Z ≥ Third ∧ {back: Nil ∨ (First ∧ {next: Second ∧ {middle: Z}})}} ⟹ Z}})} ∧ {y: Second ∧ {middle: ∀Z. {Z ≥ Third ∧ {back: Nil ∨ (First ∧ {next: Second ∧ {middle: Z}})}} ⟹ Z}}) ∧ {z: ∀Z. {Z ≥ Third ∧ {back: Nil ∨ (First ∧ {next: Second ∧ {middle: Z}})}} ⟹ Z}) ≤ Int → {x: Str}
//│         ({x: Nil ∨ (First ∧ {next: Second ∧ {middle: ∀Z. {Z ≥ Third ∧ {back: Nil ∨ (First ∧ {next: Second ∧ {middle: Z}})}} ⟹ Z}})} ∧ {y: Second ∧ {middle: ∀Z. {Z ≥ Third ∧ {back: Nil ∨ (First ∧ {next: Second ∧ {middle: Z}})}} ⟹ Z}}) ∧ {z: ∀Z. {Z ≥ Third ∧ {back: Nil ∨ (First ∧ {next: Second ∧ {middle: Z}})}} ⟹ Z} ≤ {x: Str}
//│           ({x: Nil} ∧ {y: Second ∧ {middle: ∀Z. {Z ≥ Third ∧ {back: Nil ∨ (First ∧ {next: Second ∧ {middle: Z}})}} ⟹ Z}}) ∧ {z: ∀Z. {Z ≥ Third ∧ {back: Nil ∨ (First ∧ {next: Second ∧ {middle: Z}})}} ⟹ Z} ≤ {x: Str}
//│             {x: Nil} ∧ {y: Second ∧ {middle: ∀Z. {Z ≥ Third ∧ {back: Nil ∨ (First ∧ {next: Second ∧ {middle: Z}})}} ⟹ Z}} ≤ {x: Str}
//│               {x: Nil} ≤ {x: Str}
//│                 Nil ≤ Str
//│               {y: Second ∧ {middle: ∀Z. {Z ≥ Third ∧ {back: Nil ∨ (First ∧ {next: Second ∧ {middle: Z}})}} ⟹ Z}} ≤ {x: Str}
//│                 Second ∧ {middle: ∀Z. {Z ≥ Third ∧ {back: Nil ∨ (First ∧ {next: Second ∧ {middle: Z}})}} ⟹ Z} ≤ ⊥
//│                   Second ≤ ⊥
//│                   {middle: ∀Z. {Z ≥ Third ∧ {back: Nil ∨ (First ∧ {next: Second ∧ {middle: Z}})}} ⟹ Z} ≤ ⊥
//│                     ∀Z. {Z ≥ Third ∧ {back: Nil ∨ (First ∧ {next: Second ∧ {middle: Z}})}} ⟹ Z ≤ ⊥
//│                       {α ≥ Third ∧ {back: Nil ∨ (First ∧ {next: Second ∧ {middle: α}})}} ⟹ α ≤ ⊥
//│                         α ≤ ⊥
//│                           Third ∧ {back: Nil ∨ (First ∧ {next: Second ∧ {middle: α}})} ≤ ⊥
//│                             Third ∧ {back: Nil} ≤ ⊥
//│                               Third ≤ ⊥
//│                               {back: Nil} ≤ ⊥
//│                                 Nil ≤ ⊥
//│             {z: ∀Z. {Z ≥ Third ∧ {back: Nil ∨ (First ∧ {next: Second ∧ {middle: Z}})}} ⟹ Z} ≤ {x: Str}
//│               ∀Z. {Z ≥ Third ∧ {back: Nil ∨ (First ∧ {next: Second ∧ {middle: Z}})}} ⟹ Z ≤ ⊥
//│                 {β ≥ Third ∧ {back: Nil ∨ (First ∧ {next: Second ∧ {middle: β}})}} ⟹ β ≤ ⊥
//│                   β ≤ ⊥
//│                     Third ∧ {back: Nil ∨ (First ∧ {next: Second ∧ {middle: β}})} ≤ ⊥
//│                       Third ∧ {back: Nil} ≤ ⊥
//│                         Third ≤ ⊥
//│                         {back: Nil} ≤ ⊥
//│                           Nil ≤ ⊥

data class Fourth(last)
type Ring4 = [X, Y, Z, W] ->
  ([(Nil | (First & {next: Y})) <:< X] => ([(Second & {middle: Z}) <:< Y] =>
    ([(Third & {back: W}) <:< Z] => ([(Fourth & {last: X}) <:< W] =>
      Int -> ({x: X} & {y: Y} & {z: Z} & {w: W})))))
type Root4 = Nil | (First & {next: (Second & {middle: (Third & {back: (Fourth & {last: (Nil | First)})})})})
type W4 = Fourth & {last: Root4}
type Z4 = Third & {back: W4}
type Y4 = Second & {middle: Z4}
Ring4 <:< (Int -> ({x: Root4} & {y: Y4} & {z: Z4} & {w: W4}))
//│ Fourth: ∀α. α → (Fourth ∧ {last: α})
//│ Ring4 = ∀X, Y, Z, W. {Nil ∨ (First ∧ {next: Y}) ≤ X, Second ∧ {middle: Z} ≤ Y, Third ∧ {back: W} ≤ Z, Fourth ∧ {last: X} ≤ W} ⟹ Int → ((({x: X} ∧ {y: Y}) ∧ {z: Z}) ∧ {w: W})
//│ Root4 = Nil ∨ (First ∧ {next: Second ∧ {middle: Third ∧ {back: Fourth ∧ {last: Nil ∨ First}}}})
//│ W4 = Fourth ∧ {last: Root4}
//│ Z4 = Third ∧ {back: W4}
//│ Y4 = Second ∧ {middle: Z4}
//│ OK

// Membership outside X turns the first summand of this lower bound into Nil.
type BooleanBase = [X restricts ((~X & Nil) | (Cons & {head: Int} & {tail: X}))] ->
  Int -> X
BooleanBase <:< (Int -> R)
//│ BooleanBase = ∀X. {X ≥ (¬X ∧ Nil) ∨ ((Cons ∧ {head: Int}) ∧ {tail: X})} ⟹ Int → X
//│ OK

:te
BooleanBase <:< (Int -> Bot)
//│ ═══[TYPE ERROR] Cannot solve judgment BooleanBase ≤ Int → ⊥.
//│ Typing error tree:
//│   BooleanBase ≤ Int → ⊥
//│     ∀X. {X ≥ (¬X ∧ Nil) ∨ ((Cons ∧ {head: Int}) ∧ {tail: X})} ⟹ Int → X ≤ Int → ⊥
//│       Int → (∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X})} ⟹ X) ≤ Int → ⊥
//│         ∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X})} ⟹ X ≤ ⊥
//│           {α ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: α})} ⟹ α ≤ ⊥
//│             α ≤ ⊥
//│               Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: α}) ≤ ⊥
//│                 Nil ≤ ⊥

// The two separate lower bounds define the same list carrier.
type Split = [X restricts Nil] -> ([(Cons & {head: Int} & {tail: X}) <:< X] => Int -> X)
Split <:< (Int -> R)
//│ Split = ∀X. {X ≥ Nil, (Cons ∧ {head: Int}) ∧ {tail: X} ≤ X} ⟹ Int → X
//│ OK

// A polymorphic choice of thunks exercises generation without a class test.
declare fun choose[A]: (Unit -> A) -> (Unit -> A) -> A
fun grow(n) = choose(() => Nil(), () => Cons(n, grow(n + 1)))
//│ choose: ∀A. (Unit → A) → (Unit → A) → A
//│ grow: ∀α. {α ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: α})} ⟹ Int → (Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: α}))

grow(1) as R
//│ R

:te
grow("bad")
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α. {α ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: α})} ⟹ Int → (Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: α})) ≤ Str → β.
//│ Typing error tree:
//│   ∀α. {α ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: α})} ⟹ Int → (Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: α})) ≤ Str → β
//│     Int → (Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: ∀α. {α ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: α})} ⟹ α})) ≤ Str → β
//│       Str ≤ Int

// P supplies the seed of X and the argument type. Every instance must satisfy P <: Int.
type Seeded = [X, P, Y] ->
  ([(P | {next: Y}) <:< X] => ([P <:< Int] => ([{back: X} <:< Y] =>
    P -> ({left: X} & {right: Y}))))
type IntRoot = [T restricts (Int | {next: {back: T}})] -> T
type IntPair = Int -> ({left: IntRoot} & {right: {back: IntRoot}})
declare fun seeded: Seeded
seeded[IntRoot, Int, {back: IntRoot}] as IntPair
//│ Seeded = ∀X, P, Y. {P ∨ {next: Y} ≤ X, P ≤ Int, {back: X} ≤ Y} ⟹ P → ({left: X} ∧ {right: Y})
//│ IntRoot = ∀T. {T ≥ Int ∨ {next: {back: T}}} ⟹ T
//│ IntPair = Int → ({left: IntRoot} ∧ {right: {back: IntRoot}})
//│ seeded: Seeded
//│ IntPair

:ctml-dbg output
// The closed comparison emits no obligations. The open result retains a lower bound.
declare type Result
P <:< (Int -> R)
P <:< (Int -> Result)
//│ α rigid (1)
//│ OK
//│ eff Result ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: ∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X})} ⟹ X}), Result ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: ∀X. {X ≥ Nil ∨ ((Cons ∧ {head: Int}) ∧ {tail: X})} ⟹ X})
//│ OK

Seeded <:< IntPair
//│ α rigid (2), β rigid (2), γ rigid (2), δ rigid (2), eff ε ≥ Int, ε ≥ Int, eff ε ≤ Int, ε ≤ Int, ε flex (1), ζ rigid (2), η rigid (2), eff θ ≥ Int, θ ≥ Int, eff θ ≤ Int, θ ≤ Int, θ flex (1)
//│ OK

type PermutedSeed = [Y, X, P] ->
  ([{back: X} <:< Y] => ([(P | {next: Y}) <:< X] => ([P <:< Int] =>
    P -> ({left: X} & {right: Y}))))
PermutedSeed <:< IntPair
//│ PermutedSeed = ∀Y, X, P. {{back: X} ≤ Y, P ∨ {next: Y} ≤ X, P ≤ Int} ⟹ P → ({left: X} ∧ {right: Y})
//│ α rigid (2), β rigid (2), eff γ ≥ Int, γ ≥ Int, eff γ ≤ Int, γ ≤ Int, γ flex (1), δ rigid (2), ε rigid (2), eff ζ ≥ Int, ζ ≥ Int, eff ζ ≤ Int, ζ ≤ Int, ζ flex (1)
//│ OK

// Close the same cycle at Y, with P fixed to Int by the argument and guard.
type BackRoot = [T restricts {back: (Int | {next: T})}] -> T
PermutedSeed <:< (Int -> ({left: (Int | {next: BackRoot})} & {right: BackRoot}))
//│ BackRoot = ∀T. {T ≥ {back: Int ∨ {next: T}}} ⟹ T
//│ α rigid (2), eff β ≥ Int, β ≥ Int, eff β ≤ Int, β ≤ Int, β flex (1), γ rigid (2), δ rigid (2), eff ε ≥ Int, ε ≥ Int, eff ε ≤ Int, ε ≤ Int, ε flex (1)
//│ OK

// The argument would force Str <: P while the original guard requires P <: Int.

:te
Seeded <:< (Str -> Top)
//│ ═══[TYPE ERROR] Cannot solve judgment Seeded ≤ Str → ⊤.
//│ Typing error tree:
//│   Seeded ≤ Str → ⊤
//│     ∀X, P, Y. {P ∨ {next: Y} ≤ X, P ≤ Int, {back: X} ≤ Y} ⟹ P → ({left: X} ∧ {right: Y}) ≤ Str → ⊤
//│       ∀P. {P ≤ Int} ⟹ P → ({left: P ∨ {next: ∀Y. {Y ≥ {back: P ∨ {next: Y}}} ⟹ Y}} ∧ {right: ∀Y. {Y ≥ {back: P ∨ {next: Y}}} ⟹ Y}) ≤ Str → ⊤
//│         {α ≤ Int} ⟹ α → ({left: α ∨ {next: ∀Y. {Y ≥ {back: α ∨ {next: Y}}} ⟹ Y}} ∧ {right: ∀Y. {Y ≥ {back: α ∨ {next: Y}}} ⟹ Y}) ≤ Str → ⊤
//│           α → ({left: α ∨ {next: ∀Y. {Y ≥ {back: α ∨ {next: Y}}} ⟹ Y}} ∧ {right: ∀Y. {Y ≥ {back: α ∨ {next: Y}}} ⟹ Y}) ≤ Str → ⊤
//│             Str ≤ α
//│               Str ≤ Int

// Int <: P <: X follows from the argument and the seed, and contradicts this result.

:te
Seeded <:< (Int -> ({left: Str}))
//│ ═══[TYPE ERROR] Cannot solve judgment Seeded ≤ Int → {left: Str}.
//│ Typing error tree:
//│   Seeded ≤ Int → {left: Str}
//│     ∀X, P, Y. {P ∨ {next: Y} ≤ X, P ≤ Int, {back: X} ≤ Y} ⟹ P → ({left: X} ∧ {right: Y}) ≤ Int → {left: Str}
//│       ∀P. {P ≤ Int} ⟹ P → ({left: P ∨ {next: ∀Y. {Y ≥ {back: P ∨ {next: Y}}} ⟹ Y}} ∧ {right: ∀Y. {Y ≥ {back: P ∨ {next: Y}}} ⟹ Y}) ≤ Int → {left: Str}
//│         {α ≤ Int} ⟹ α → ({left: α ∨ {next: ∀Y. {Y ≥ {back: α ∨ {next: Y}}} ⟹ Y}} ∧ {right: ∀Y. {Y ≥ {back: α ∨ {next: Y}}} ⟹ Y}) ≤ Int → {left: Str}
//│           α → ({left: α ∨ {next: ∀Y. {Y ≥ {back: α ∨ {next: Y}}} ⟹ Y}} ∧ {right: ∀Y. {Y ≥ {back: α ∨ {next: Y}}} ⟹ Y}) ≤ Int → {left: Str}
//│             {left: α ∨ {next: ∀Y. {Y ≥ {back: α ∨ {next: Y}}} ⟹ Y}} ∧ {right: ∀Y. {Y ≥ {back: α ∨ {next: Y}}} ⟹ Y} ≤ {left: Str}
//│               {left: α} ∧ {right: ∀Y. {Y ≥ {back: α ∨ {next: Y}}} ⟹ Y} ≤ {left: Str}
//│                 {left: α} ≤ {left: Str}
//│                   α ≤ Str
//│                     Int ≤ Str
//│                 {right: ∀Y. {Y ≥ {back: α ∨ {next: Y}}} ⟹ Y} ≤ {left: Str}
//│                   ∀Y. {Y ≥ {back: α ∨ {next: Y}}} ⟹ Y ≤ ⊥
//│                     {β ≥ {back: α ∨ {next: β}}} ⟹ β ≤ ⊥
//│                       β ≤ ⊥
//│                         {back: α ∨ {next: β}} ≤ ⊥
//│                           {back: α} ≤ ⊥
//│                             α ≤ ⊥
//│                               Int ≤ ⊥

// Each independent cycle has its own base and distinct recursive fields.
type Independent = [X, U, Y, V] ->
  ([(Nil | {next: Y}) <:< X] => ([(Str | {rest: V}) <:< U] =>
    ([{back: X} <:< Y] => ([{prev: U} <:< V] => Int -> ({left: X} & {right: U})))))
type StrRoot = [T restricts (Str | {rest: {prev: T}})] -> T
Independent <:< (Int -> ({left: Root} & {right: StrRoot}))
//│ Independent = ∀X, U, Y, V. {Nil ∨ {next: Y} ≤ X, Str ∨ {rest: V} ≤ U, {back: X} ≤ Y, {prev: U} ≤ V} ⟹ Int → ({left: X} ∧ {right: U})
//│ StrRoot = ∀T. {T ≥ Str ∨ {rest: {prev: T}}} ⟹ T
//│ α rigid (1), β rigid (1), γ rigid (1), δ rigid (1)
//│ OK
