//│       Int → Int → (LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: β})) ≤ Int → Int → IntList
//│         Int → (LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: β})) ≤ Int → IntList
