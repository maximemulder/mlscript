:ctml

data class LNil()
data class LCons(head, tail)
//│ LNil: Unit → LNil
//│ LCons: ∀α, β. α → β → ((LCons ∧ {head: α}) ∧ {tail: β})

val (<=): Int -> Int -> Bool
//│ <=: Int → Int → Bool

// The source Nofib range is inclusive and returns empty when a > b.
// Its definition has no type annotations or explicit instantiations.
fun enumFromTo(a, b) =
  if a <= b then LCons(a, enumFromTo(a + 1, b)) else LNil()
//│ enumFromTo: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: α})} ⟹ Int → Int → (LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: α}))

type IntList = [X restricts (LNil | (LCons & {head: Int} & {tail: X}))] -> X
//│ IntList = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X

// Explicit uses are diagnostic controls, not annotations on the producer.
enumFromTo[IntList] as (Int -> Int -> IntList)
//│ Int → Int → IntList

enumFromTo[IntList](1, 5) as IntList
//│ IntList

enumFromTo as (Int -> Int -> IntList)
//│ Int → Int → IntList

enumFromTo(1, 5) as IntList
//│ IntList

val inferredRange = enumFromTo(1, 5)
//│ inferredRange: LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ∀α. {LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: α}) ≤ α} ⟹ α})

inferredRange as IntList
//│ IntList

:te
enumFromTo("bad", 5)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: α})} ⟹ Int → Int → (LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: α})) ≤ Str → β.
//│ Typing error tree:
//│   ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: α})} ⟹ Int → Int → (LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: α})) ≤ Str → β
//│     Int → Int → (LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ∀γ. {(LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: γ})) ∨ δ ≤ γ} ⟹ γ})) ≤ Str → β
//│       Str ≤ Int

:te
enumFromTo(1, "bad")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
//│ Typing error tree:
//│   α ≤ Str → β
//│     Int → (LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ∀γ. {(LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: γ})) ∨ δ ≤ γ} ⟹ γ})) ≤ Str → β
//│       Str ≤ Int

fun firstOrZero(xs) = if xs is
  LNil() then 0
  LCons(head, _) then head
//│ firstOrZero: ∀α, β. {β ≥ ({α ≤ LNil} ⟹ Int) ∧ ({α ≤ ({head: β} ∧ LCons) ∧ {tail: ⊤}} ⟹ ⊥), α ≤ ¬({β ≥ Int} ⟹ ¬LNil) ∨ (({head: β} ∧ LCons) ∧ {tail: ⊤})} ⟹ α → β

:fixme // FIXME: Case splitting skips the flexible argument produced by the range application.
firstOrZero(enumFromTo(1, 5)) as Int
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Int.
//│ Typing error tree:
//│   α ≤ Int
//│     Int ∨ (({β ≤ LNil} ⟹ Int) ∧ ({β ≤ ({head: γ} ∧ LCons) ∧ {tail: ⊤}} ⟹ ⊥)) ≤ Int
//│       ({β ≤ LNil} ⟹ Int) ∧ ({β ≤ ({head: γ} ∧ LCons) ∧ {tail: ⊤}} ⟹ ⊥) ≤ Int
//│         {β ≤ LNil} ⟹ Int ≤ Int
//│           β ≤ LNil
//│             δ ≤ LNil
//│               LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ∀ε. {(LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ε})) ∨ ζ ≤ ε} ⟹ ε}) ≤ LNil
//│                 (LCons ∧ {head: Int}) ∧ {tail: ∀ε. {(LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ε})) ∨ ζ ≤ ε} ⟹ ε} ≤ LNil
//│                   LCons ∧ {head: Int} ≤ LNil
//│                     LCons ≤ LNil
//│                     {head: Int} ≤ LNil
//│                       Int ≤ ⊥
//│                   {tail: ∀ε. {(LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ε})) ∨ ζ ≤ ε} ⟹ ε} ≤ LNil
//│                     ∀ε. {(LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ε})) ∨ ζ ≤ ε} ⟹ ε ≤ ⊥
//│                       ∀η. {((LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: η})) ∨ ζ) ∨ θ ≤ η} ⟹ η ≤ ⊥
//│                         {((LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ι})) ∨ ζ) ∨ θ ≤ ι} ⟹ ι ≤ ⊥
//│                           ι ≤ ⊥
//│                             ((LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ι})) ∨ ζ) ∨ θ ≤ ⊥
//│                               (LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ι})) ∨ ζ ≤ ⊥
//│                                 LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ι}) ≤ ⊥
//│                                   LNil ≤ ⊥
//│         {β ≤ ({head: γ} ∧ LCons) ∧ {tail: ⊤}} ⟹ ⊥ ≤ Int
//│           β ≤ ({head: γ} ∧ LCons) ∧ {tail: ⊤}
//│             δ ≤ ({head: γ} ∧ LCons) ∧ {tail: ⊤}
//│               LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ∀ε. {(LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ε})) ∨ ζ ≤ ε} ⟹ ε}) ≤ ({head: γ} ∧ LCons) ∧ {tail: ⊤}
//│                 LNil ≤ ({head: γ} ∧ LCons) ∧ {tail: ⊤}
//│                   LNil ≤ {head: γ} ∧ LCons
//│                     LNil ≤ {head: γ}

firstOrZero(LNil()) as Int
//│ Int

firstOrZero(LCons(1, LNil())) as Int
//│ Int

