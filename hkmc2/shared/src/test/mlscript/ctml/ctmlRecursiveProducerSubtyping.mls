:ctml

type F
type Rec = [X restricts F[X]] -> X
type LayerRec = [X restricts F[X]] -> F[X]
type Producer = [X restricts F[X]] -> Int -> F[X]
type WidenedProducer = [X restricts F[X]] -> Int -> X
//│ Rec = ∀X. {X ≥ F[X]} ⟹ X
//│ LayerRec = ∀X. {X ≥ F[X]} ⟹ F[X]
//│ Producer = ∀X. {X ≥ F[X]} ⟹ Int → F[X]
//│ WidenedProducer = ∀X. {X ≥ F[X]} ⟹ Int → X

LayerRec <:< Rec
//│ OK

Rec <:< LayerRec
//│ OK

Producer <:< (Int -> Rec)
//│ OK

WidenedProducer <:< (Int -> Rec)
//│ OK

// A nonrecursive guard distinguishes the cycle from arrow instantiation.
type PlainProducer = [X restricts Int] -> Int -> X
//│ PlainProducer = ∀X. {X ≥ Int} ⟹ Int → X

PlainProducer <:< (Int -> Int)
//│ OK

// The explicit carrier gives the same producer comparison.
declare fun producer: Producer
//│ producer: Producer

producer[Rec] as (Int -> Rec)
//│ Int → Rec

// The corresponding declared list-shaped scheme isolates inference from subtyping.
data class LNil()
data class LCons(head, tail)
type IntList = [X restricts (LNil | (LCons & {head: Int} & {tail: X}))] -> X
type ListScheme = [X restricts (LNil | (LCons & {head: Int} & {tail: X}))] ->
  LNil | (LCons & {head: Int} & {tail: X})
//│ LNil: Unit → LNil
//│ LCons: ∀α, β. α → β → ((LCons ∧ {head: α}) ∧ {tail: β})
//│ IntList = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X
//│ ListScheme = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})

ListScheme <:< IntList
//│ OK

declare fun listValue: ListScheme
//│ listValue: ListScheme

listValue[IntList] as IntList
//│ IntList

// A carrier used as a function parameter can require a larger instance.
type Endo = [X restricts F[X]] -> X -> X
Endo <:< (Top -> Top)
//│ Endo = ∀X. {X ≥ F[X]} ⟹ X → X
//│ OK

// Closing a recursive carrier must retain independent obligations on that carrier.
type WithBase = [X restricts F[X]] -> ([Str <:< X] => Int -> X)
//│ WithBase = ∀X. {X ≥ F[X], Str ≤ X} ⟹ Int → X

:te
WithBase <:< (Int -> Rec)
//│ ═══[TYPE ERROR] Cannot solve judgment WithBase ≤ Int → Rec.
//│ Typing error tree:
//│   WithBase ≤ Int → Rec
//│     ∀X. {X ≥ F[X], Str ≤ X} ⟹ Int → X ≤ Int → Rec
//│       Int → (∀X. {X ≥ F[X], Str ≤ X} ⟹ X) ≤ Int → Rec
//│         ∀X. {X ≥ F[X], Str ≤ X} ⟹ X ≤ Rec
//│           ∀X. {X ≥ F[X], Str ≤ X} ⟹ X ≤ ∀X. {X ≥ F[X]} ⟹ X
//│             ∀X. {X ≥ F[X], Str ≤ X} ⟹ X ≤ {α ≥ F[α]} ⟹ α
//│               ∀X. {X ≥ F[X], Str ≤ X} ⟹ X ≤ α
//│                 ∀X. {X ≥ F[X], Str ≤ X} ⟹ X ≤ F[α]
//│                   {β ≥ F[β], Str ≤ β} ⟹ β ≤ F[α]
//│                     {Str ≤ β} ⟹ β ≤ F[α]
//│                       β ≤ F[α]
//│                         F[β] ∨ Str ≤ F[α]
//│                           F[β] ≤ F[α]
//│                             β ≤ α
//│                               F[β] ∨ Str ≤ α
//│                                 Str ≤ α
//│                                   Str ≤ F[α]

// A negative occurrence in the defining guard need not satisfy a positive fixed-point law.
type NegativeProducer = [X restricts ~X] -> Int -> X
//│ NegativeProducer = ∀X. {X ≥ ¬X} ⟹ Int → X

:te
NegativeProducer <:< (Int -> Bot)
//│ ═══[TYPE ERROR] Cannot solve judgment NegativeProducer ≤ Int → ⊥.
//│ Typing error tree:
//│   NegativeProducer ≤ Int → ⊥
//│     ∀X. {X ≥ ¬X} ⟹ Int → X ≤ Int → ⊥
//│       {α ≥ ¬α} ⟹ Int → α ≤ Int → ⊥
//│         Int → α ≤ Int → ⊥
//│           α ≤ ⊥
//│             ⊤ ≤ ⊥
