:ctml

type F
type Rec = [X restricts F[X]] -> X
type LayerRec = [X restricts F[X]] -> F[X]
type Producer = [X restricts F[X]] -> Int -> F[X]
type WidenedProducer = [X restricts F[X]] -> Int -> X
//│ Rec = ∀X. {X ≥ F[X]} ⟹ X
//│ LayerRec = ∀X. {X ≥ F[X]} ⟹ F[X]
//│ Producer = ∀X. {X ≥ F[X]} ⟹ Int → F[X]
//│ WidenedProducer = ∀X. {X ≥ F[X]} ⟹ Int → X

LayerRec <:< Rec
//│ OK

Rec <:< LayerRec
//│ OK

Producer <:< (Int -> Rec)
//│ OK

WidenedProducer <:< (Int -> Rec)
//│ OK

// A result-only parameter can be instantiated at the entire recursive union.

type Values = [X restricts (Int | F[X])] -> X
type GuardedResult = [X] -> Int -> ([(Int | F[X]) <:< X] => X)
//│ Values = ∀X. {X ≥ Int ∨ F[X]} ⟹ X
//│ GuardedResult = ∀X. Int → ({Int ∨ F[X] ≤ X} ⟹ X)

GuardedResult <:< (Int -> Values)
//│ OK

declare fun guardedProducer: GuardedResult
//│ guardedProducer: GuardedResult

guardedProducer[Values](1) as Values
//│ Values

// Both the input and any enclosing guard retain their constraints on the result variable.

type SharedInput = [X] -> X -> ([Int <:< X] => X)
type SharedGuard = [X restricts Str] -> Int -> ([Int <:< X] => X)
//│ SharedInput = ∀X. X → ({Int ≤ X} ⟹ X)
//│ SharedGuard = ∀X. {X ≥ Str} ⟹ Int → ({Int ≤ X} ⟹ X)

:te
SharedInput <:< (Str -> Int)
//│ ═══[TYPE ERROR] Cannot solve judgment SharedInput ≤ Str → Int.
//│ Typing error tree:
//│   SharedInput ≤ Str → Int
//│     ∀X. X → ({Int ≤ X} ⟹ X) ≤ Str → Int
//│       α → ({Int ≤ α} ⟹ α) ≤ Str → Int
//│         {Int ≤ α} ⟹ α ≤ Int
//│           α ≤ Int
//│             Str ∨ Int ≤ Int
//│               Str ≤ Int

:te
SharedGuard <:< (Int -> Int)
//│ ═══[TYPE ERROR] Cannot solve judgment SharedGuard ≤ Int → Int.
//│ Typing error tree:
//│   SharedGuard ≤ Int → Int
//│     ∀X. {X ≥ Str} ⟹ Int → ({Int ≤ X} ⟹ X) ≤ Int → Int
//│       {α ≥ Str} ⟹ Int → ({Int ≤ α} ⟹ α) ≤ Int → Int
//│         Int → ({Int ≤ α} ⟹ α) ≤ Int → Int
//│           {Int ≤ α} ⟹ α ≤ Int
//│             α ≤ Int
//│               Str ∨ Int ≤ Int
//│                 Str ≤ Int

// A nonrecursive guard distinguishes the cycle from arrow instantiation.
type PlainProducer = [X restricts Int] -> Int -> X
//│ PlainProducer = ∀X. {X ≥ Int} ⟹ Int → X

PlainProducer <:< (Int -> Int)
//│ OK

// The explicit carrier gives the same producer comparison.
declare fun producer: Producer
//│ producer: Producer

producer[Rec] as (Int -> Rec)
//│ Int → Rec

// The corresponding declared list-shaped scheme isolates inference from subtyping.
data class LNil()
data class LCons(head, tail)
type IntList = [X restricts (LNil | (LCons & {head: Int} & {tail: X}))] -> X
type ListScheme = [X restricts (LNil | (LCons & {head: Int} & {tail: X}))] ->
  LNil | (LCons & {head: Int} & {tail: X})
//│ LNil: Unit → LNil
//│ LCons: ∀α, β. α → β → ((LCons ∧ {head: α}) ∧ {tail: β})
//│ IntList = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X
//│ ListScheme = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})

ListScheme <:< IntList
//│ OK

declare fun listValue: ListScheme
//│ listValue: ListScheme

listValue[IntList] as IntList
//│ IntList

// A carrier used as a function parameter can require a larger instance.
type Endo = [X restricts F[X]] -> X -> X
Endo <:< (Top -> Top)
//│ Endo = ∀X. {X ≥ F[X]} ⟹ X → X
//│ OK

// Closing a recursive carrier must retain independent obligations on that carrier.
type WithBase = [X restricts F[X]] -> ([Str <:< X] => Int -> X)
//│ WithBase = ∀X. {X ≥ F[X], Str ≤ X} ⟹ Int → X

:te
WithBase <:< (Int -> Rec)
//│ ═══[TYPE ERROR] Cannot solve judgment WithBase ≤ Int → Rec.
//│ Typing error tree:
//│   WithBase ≤ Int → Rec
//│     ∀X. {X ≥ F[X], Str ≤ X} ⟹ Int → X ≤ Int → Rec
//│       Int → (∀X. {X ≥ F[X], X ≥ Str} ⟹ X) ≤ Int → Rec
//│         ∀X. {X ≥ F[X], X ≥ Str} ⟹ X ≤ Rec
//│           ∀X. {X ≥ F[X], X ≥ Str} ⟹ X ≤ ∀X. {X ≥ F[X]} ⟹ X
//│             ∀X. {X ≥ F[X], X ≥ Str} ⟹ X ≤ {α ≥ F[α]} ⟹ α
//│               ∀X. {X ≥ F[X], X ≥ Str} ⟹ X ≤ α
//│                 ∀X. {X ≥ F[X], X ≥ Str} ⟹ X ≤ F[α]
//│                   {β ≥ F[β], β ≥ Str} ⟹ β ≤ F[α]
//│                     {β ≥ Str} ⟹ β ≤ F[α]
//│                       β ≤ F[α]
//│                         F[β] ∨ Str ≤ F[α]
//│                           F[β] ≤ F[α]
//│                             β ≤ α
//│                               F[β] ∨ Str ≤ α
//│                                 Str ≤ α
//│                                   Str ≤ F[α]

// A negative occurrence in the defining guard need not satisfy a positive fixed-point law.
type NegativeProducer = [X restricts ~X] -> Int -> X
//│ NegativeProducer = ∀X. {X ≥ ¬X} ⟹ Int → X

:te
NegativeProducer <:< (Int -> Bot)
//│ ═══[TYPE ERROR] Cannot solve judgment NegativeProducer ≤ Int → ⊥.
//│ Typing error tree:
//│   NegativeProducer ≤ Int → ⊥
//│     ∀X. {X ≥ ¬X} ⟹ Int → X ≤ Int → ⊥
//│       {α ≥ ¬α} ⟹ Int → α ≤ Int → ⊥
//│         Int → α ≤ Int → ⊥
//│           α ≤ ⊥
//│             ⊤ ≤ ⊥

// The record encoding exercises the same witness with a structural recursive layer.
type Chain = [X restricts (Int | {next: X})] -> X
type ChainProducer = [X] -> Int -> ([(Int | {next: X}) <:< X] => X)
declare fun chainProducer: ChainProducer
//│ Chain = ∀X. {X ≥ Int ∨ {next: X}} ⟹ X
//│ ChainProducer = ∀X. Int → ({Int ∨ {next: X} ≤ X} ⟹ X)
//│ chainProducer: ChainProducer

ChainProducer <:< (Int -> Chain)
//│ OK

chainProducer[Chain] as (Int -> Chain)
//│ Int → Chain

// Instantiating at Chain also gives any wider result that contains Chain.
ChainProducer <:< (Int -> (Chain | Str))
//│ OK

chainProducer[Chain] as (Int -> (Chain | Str))
//│ Int → (Chain ∨ Str)

:te
(Int | {next: (Chain | Str)}) <:< (Chain | Str)
//│ ═══[TYPE ERROR] Cannot solve judgment Int ∨ {next: Chain ∨ Str} ≤ Chain ∨ Str.
//│ Typing error tree:
//│   Int ∨ {next: Chain ∨ Str} ≤ Chain ∨ Str
//│     {next: Chain ∨ Str} ≤ Chain ∨ Str
//│       {next: Str} ≤ Chain ∨ Str
//│         {next: Str} ≤ Chain
//│           {next: Str} ≤ ∀X. {X ≥ Int ∨ {next: X}} ⟹ X
//│             {next: Str} ≤ {α ≥ Int ∨ {next: α}} ⟹ α
//│               {next: Str} ≤ α
//│                 {next: Str} ≤ Int
//│                   Str ≤ ⊥
//│                 {next: Str} ≤ {next: α}
//│                   Str ≤ α
//│                     Str ≤ Int
//│                     Str ≤ {next: α}
//│         {next: Str} ≤ Str
//│           Str ≤ ⊥
//│         {next: Str} ∧ ¬Str ≤ Chain ∨ Str
//│           {next: Str} ∧ ¬Str ≤ Chain
//│             {next: Str} ∧ ¬Str ≤ ∀X. {X ≥ Int ∨ {next: X}} ⟹ X
//│               {next: Str} ∧ ¬Str ≤ {β ≥ Int ∨ {next: β}} ⟹ β
//│                 {next: Str} ∧ ¬Str ≤ β
//│                   {next: Str} ∧ ¬Str ≤ Int
//│                     {next: Str} ≤ Int
//│                       Str ≤ ⊥
//│                     ¬Str ≤ Int
//│                   {next: Str} ∧ ¬Str ≤ {next: β}
//│                     {next: Str} ≤ {next: β}
//│                       Str ≤ β
//│                         Str ≤ Int
//│                         Str ≤ {next: β}
//│                     ¬Str ≤ {next: β}
//│           {next: Str} ∧ ¬Str ≤ Str
//│             {next: Str} ≤ Str
//│               Str ≤ ⊥
//│             ¬Str ≤ Str

:te
chainProducer[Chain | Str] as (Int -> (Chain | Str))
//│ ═══[TYPE ERROR] Cannot solve judgment Int → ({Int ∨ {next: Chain ∨ Str} ≤ Chain ∨ Str} ⟹ Chain ∨ Str) ≤ Int → (Chain ∨ Str).
//│ Typing error tree:
//│   Int → ({Int ∨ {next: Chain ∨ Str} ≤ Chain ∨ Str} ⟹ Chain ∨ Str) ≤ Int → (Chain ∨ Str)
//│     {Int ∨ {next: Chain ∨ Str} ≤ Chain ∨ Str} ⟹ Chain ∨ Str ≤ Chain ∨ Str
//│       {Int ∨ {next: Chain ∨ Str} ≤ Chain ∨ Str} ⟹ Chain ∨ Str ≤ Chain
//│         {Int ∨ {next: Chain ∨ Str} ≤ Chain ∨ Str} ⟹ Chain ∨ Str ≤ ∀X. {X ≥ Int ∨ {next: X}} ⟹ X
//│           {Int ∨ {next: Chain ∨ Str} ≤ Chain ∨ Str} ⟹ Chain ∨ Str ≤ {α ≥ Int ∨ {next: α}} ⟹ α
//│             {Int ∨ {next: Chain ∨ Str} ≤ Chain ∨ Str} ⟹ Chain ∨ Str ≤ α
//│               Chain ∨ Str ≤ α
//│                 Str ≤ α
//│                   Str ≤ Int
//│                   Str ≤ {next: α}
//│       {Int ∨ {next: Chain ∨ Str} ≤ Chain ∨ Str} ⟹ Chain ∨ Str ≤ Str
//│         Int ∨ {next: Chain ∨ Str} ≤ Chain ∨ Str
//│           {next: Chain ∨ Str} ≤ Chain ∨ Str
//│             {next: Str} ≤ Chain ∨ Str
//│               {next: Str} ≤ Chain
//│                 {next: Str} ≤ ∀X. {X ≥ Int ∨ {next: X}} ⟹ X
//│                   {next: Str} ≤ {β ≥ Int ∨ {next: β}} ⟹ β
//│                     {next: Str} ≤ β
//│                       {next: Str} ≤ Int
//│                         Str ≤ ⊥
//│                       {next: Str} ≤ {next: β}
//│                         Str ≤ β
//│                           Str ≤ Int
//│                           Str ≤ {next: β}
//│               {next: Str} ≤ Str
//│                 Str ≤ ⊥
//│               {next: Str} ∧ ¬Str ≤ Chain ∨ Str
//│                 {next: Str} ∧ ¬Str ≤ Chain
//│                   {next: Str} ∧ ¬Str ≤ ∀X. {X ≥ Int ∨ {next: X}} ⟹ X
//│                     {next: Str} ∧ ¬Str ≤ {γ ≥ Int ∨ {next: γ}} ⟹ γ
//│                       {next: Str} ∧ ¬Str ≤ γ
//│                         {next: Str} ∧ ¬Str ≤ Int
//│                           {next: Str} ≤ Int
//│                             Str ≤ ⊥
//│                           ¬Str ≤ Int
//│                         {next: Str} ∧ ¬Str ≤ {next: γ}
//│                           {next: Str} ≤ {next: γ}
//│                             Str ≤ γ
//│                               Str ≤ Int
//│                               Str ≤ {next: γ}
//│                           ¬Str ≤ {next: γ}
//│                 {next: Str} ∧ ¬Str ≤ Str
//│                   {next: Str} ≤ Str
//│                     Str ≤ ⊥
//│                   ¬Str ≤ Str
//│       ({Int ∨ {next: Chain ∨ Str} ≤ Chain ∨ Str} ⟹ Chain ∨ Str) ∧ ¬Str ≤ Chain ∨ Str
//│         ({Int ∨ {next: Chain ∨ Str} ≤ Chain ∨ Str} ⟹ Chain ∨ Str) ∧ ¬Str ≤ Chain
//│           ({Int ∨ {next: Chain ∨ Str} ≤ Chain ∨ Str} ⟹ Chain ∨ Str) ∧ ¬Str ≤ ∀X. {X ≥ Int ∨ {next: X}} ⟹ X
//│             ({Int ∨ {next: Chain ∨ Str} ≤ Chain ∨ Str} ⟹ Chain ∨ Str) ∧ ¬Str ≤ {δ ≥ Int ∨ {next: δ}} ⟹ δ
//│               ({Int ∨ {next: Chain ∨ Str} ≤ Chain ∨ Str} ⟹ Chain ∨ Str) ∧ ¬Str ≤ δ
//│                 (Chain ∨ Str) ∧ ¬Str ≤ δ
//│                   Chain ∧ ¬Str ≤ δ
//│                     Chain ∧ ¬Str ≤ Int
//│                       Chain ≤ Int
//│                         ∀X. {X ≥ Int ∨ {next: X}} ⟹ X ≤ Int
//│                           {ε ≥ Int ∨ {next: ε}} ⟹ ε ≤ Int
//│                             ε ≤ Int
//│                               Int ∨ {next: ε} ≤ Int
//│                                 {next: ε} ≤ Int
//│                                   ε ≤ ⊥
//│                                     Int ∨ {next: ε} ≤ ⊥
//│                                       Int ≤ ⊥
//│                       ¬Str ≤ Int
//│                     Chain ∧ ¬Str ≤ {next: δ}
//│                       Chain ≤ {next: δ}
//│                         ∀X. {X ≥ Int ∨ {next: X}} ⟹ X ≤ {next: δ}
//│                           {ζ ≥ Int ∨ {next: ζ}} ⟹ ζ ≤ {next: δ}
//│                             ζ ≤ {next: δ}
//│                               Int ∨ {next: ζ} ≤ {next: δ}
//│                                 Int ≤ {next: δ}
//│                       ¬Str ≤ {next: δ}
//│         ({Int ∨ {next: Chain ∨ Str} ≤ Chain ∨ Str} ⟹ Chain ∨ Str) ∧ ¬Str ≤ Str
//│           {Int ∨ {next: Chain ∨ Str} ≤ Chain ∨ Str} ⟹ Chain ∨ Str ≤ Str
//│             Int ∨ {next: Chain ∨ Str} ≤ Chain ∨ Str
//│               {next: Chain ∨ Str} ≤ Chain ∨ Str
//│                 {next: Str} ≤ Chain ∨ Str
//│                   {next: Str} ≤ Chain
//│                     {next: Str} ≤ ∀X. {X ≥ Int ∨ {next: X}} ⟹ X
//│                       {next: Str} ≤ {η ≥ Int ∨ {next: η}} ⟹ η
//│                         {next: Str} ≤ η
//│                           {next: Str} ≤ Int
//│                             Str ≤ ⊥
//│                           {next: Str} ≤ {next: η}
//│                             Str ≤ η
//│                               Str ≤ Int
//│                               Str ≤ {next: η}
//│                   {next: Str} ≤ Str
//│                     Str ≤ ⊥
//│                   {next: Str} ∧ ¬Str ≤ Chain ∨ Str
//│                     {next: Str} ∧ ¬Str ≤ Chain
//│                       {next: Str} ∧ ¬Str ≤ ∀X. {X ≥ Int ∨ {next: X}} ⟹ X
//│                         {next: Str} ∧ ¬Str ≤ {θ ≥ Int ∨ {next: θ}} ⟹ θ
//│                           {next: Str} ∧ ¬Str ≤ θ
//│                             {next: Str} ∧ ¬Str ≤ Int
//│                               {next: Str} ≤ Int
//│                                 Str ≤ ⊥
//│                               ¬Str ≤ Int
//│                             {next: Str} ∧ ¬Str ≤ {next: θ}
//│                               {next: Str} ≤ {next: θ}
//│                                 Str ≤ θ
//│                                   Str ≤ Int
//│                                   Str ≤ {next: θ}
//│                               ¬Str ≤ {next: θ}
//│                     {next: Str} ∧ ¬Str ≤ Str
//│                       {next: Str} ≤ Str
//│                         Str ≤ ⊥
//│                       ¬Str ≤ Str
//│           ¬Str ≤ Str

// An input-only parameter and a guarded result parameter admit independent instances.
type NominalParametric = [A, X] -> A -> ([(Int | F[X]) <:< X] => X)
declare fun nominalParametric: NominalParametric
//│ NominalParametric = ∀A, X. A → ({Int ∨ F[X] ≤ X} ⟹ X)
//│ nominalParametric: NominalParametric

NominalParametric <:< (Int -> Values)
//│ OK

nominalParametric[Int][Values] as (Int -> Values)
//│ Int → Values
