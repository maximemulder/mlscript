:ctml

type F
type Rec = [X restricts F[X]] -> X
type LayerRec = [X restricts F[X]] -> F[X]
type Producer = [X restricts F[X]] -> Int -> F[X]
type WidenedProducer = [X restricts F[X]] -> Int -> X
//│ Rec = ∀X. {X ≥ F[X]} ⟹ X
//│ LayerRec = ∀X. {X ≥ F[X]} ⟹ F[X]
//│ Producer = ∀X. {X ≥ F[X]} ⟹ Int → F[X]
//│ WidenedProducer = ∀X. {X ≥ F[X]} ⟹ Int → X

LayerRec <:< Rec
//│ OK

Rec <:< LayerRec
//│ OK

Producer <:< (Int -> Rec)
//│ OK

WidenedProducer <:< (Int -> Rec)
//│ OK

// A nonrecursive guard distinguishes the cycle from arrow instantiation.
type PlainProducer = [X restricts Int] -> Int -> X
//│ PlainProducer = ∀X. {X ≥ Int} ⟹ Int → X

PlainProducer <:< (Int -> Int)
//│ OK

// An explicit witness supplies a finite derivation for the failing producer comparison.
declare fun producer: Producer
//│ producer: Producer

producer[Rec] as (Int -> Rec)
//│ Int → Rec

// The corresponding declared list-shaped scheme isolates inference from subtyping.
data class LNil()
data class LCons(head, tail)
type IntList = [X restricts (LNil | (LCons & {head: Int} & {tail: X}))] -> X
type ListScheme = [X restricts (LNil | (LCons & {head: Int} & {tail: X}))] ->
  LNil | (LCons & {head: Int} & {tail: X})
//│ LNil: Unit → LNil
//│ LCons: ∀α, β. α → β → ((LCons ∧ {head: α}) ∧ {tail: β})
//│ IntList = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X
//│ ListScheme = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})

ListScheme <:< IntList
//│ OK

declare fun listValue: ListScheme
//│ listValue: ListScheme

listValue[IntList] as IntList
//│ IntList
