//│                   {ζ ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: ζ})} ⟹ ζ ≤ LCons
//│                     ζ ≤ LCons
//│                       LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: ζ}) ≤ LCons
//│                         LNil ≤ LCons

/** Unary traversal does not depend on list names or element fields. */
data class Stop()
/** A unary structural successor. */
data class Next(rest)
//│ Stop: Unit → Stop
//│ Next: ∀α. α → (Next ∧ {rest: α})

fun unary(xs) = if xs is
  Stop() then 0
  Next(t) then unary(t)
//│ unary: (∀α. {α ≥ Stop ∨ (Next ∧ {rest: α})} ⟹ α) → Int

unary(Next(Next(Stop()))) as Int
//│ Int

:te
unary(Next(false))
//│ ═══[TYPE ERROR] Cannot solve judgment (∀α. {α ≥ Stop ∨ (Next ∧ {rest: α})} ⟹ α) → Int ≤ β → γ.
//│ Typing error tree:
//│   (∀α. {α ≥ Stop ∨ (Next ∧ {rest: α})} ⟹ α) → Int ≤ β → γ
//│     β ≤ ∀α. {α ≥ Stop ∨ (Next ∧ {rest: α})} ⟹ α
//│       Next ∧ {rest: δ} ≤ ∀α. {α ≥ Stop ∨ (Next ∧ {rest: α})} ⟹ α
//│         Next ∧ {rest: δ} ≤ {ε ≥ Stop ∨ (Next ∧ {rest: ε})} ⟹ ε
//│           Next ∧ {rest: δ} ≤ ε
//│             Next ∧ {rest: δ} ≤ Stop
//│               Next ≤ Stop
//│               {rest: δ} ≤ Stop
//│                 δ ≤ ⊥
//│                   Bool ≤ ⊥
//│             Next ∧ {rest: δ} ≤ Next ∧ {rest: ε}
//│               Next ∧ {rest: δ} ≤ {rest: ε}
//│                 Next ≤ {rest: ε}
//│                 {rest: δ} ≤ {rest: ε}
//│                   δ ≤ ε
//│                     Bool ≤ ε
//│                       Bool ≤ Stop
//│                       Bool ≤ Next ∧ {rest: ε}
//│                         Bool ≤ Next

/** Multiple recursive fields share the same positive invariant. */
data class Leaf(value)
/** A branching recursive node. */
data class Fork(left, right)
//│ Leaf: ∀α. α → (Leaf ∧ {value: α})
//│ Fork: ∀β, γ. β → γ → ((Fork ∧ {left: β}) ∧ {right: γ})

fun leaves(tree) = if tree is
  Leaf(_) then 1
  Fork(l, r) then leaves(l) + leaves(r)
//│ leaves: (∀α. {α ≥ (Leaf ∧ {value: ⊤}) ∨ ((Fork ∧ {left: α}) ∧ {right: α})} ⟹ α) → Int

leaves(Fork(Leaf(1), Fork(Leaf("two"), Leaf(true)))) as Int
//│ Int

:te
leaves(Fork(Leaf(1), false))
//│ ═══[TYPE ERROR] Cannot solve judgment (∀α. {α ≥ (Leaf ∧ {value: ⊤}) ∨ ((Fork ∧ {left: α}) ∧ {right: α})} ⟹ α) → Int ≤ β → γ.
//│ Typing error tree:
//│   (∀α. {α ≥ (Leaf ∧ {value: ⊤}) ∨ ((Fork ∧ {left: α}) ∧ {right: α})} ⟹ α) → Int ≤ β → γ
//│     β ≤ ∀α. {α ≥ (Leaf ∧ {value: ⊤}) ∨ ((Fork ∧ {left: α}) ∧ {right: α})} ⟹ α
//│       (Fork ∧ {left: δ}) ∧ {right: ε} ≤ ∀α. {α ≥ (Leaf ∧ {value: ⊤}) ∨ ((Fork ∧ {left: α}) ∧ {right: α})} ⟹ α
//│         (Fork ∧ {left: δ}) ∧ {right: ε} ≤ {ζ ≥ (Leaf ∧ {value: ⊤}) ∨ ((Fork ∧ {left: ζ}) ∧ {right: ζ})} ⟹ ζ
//│           (Fork ∧ {left: δ}) ∧ {right: ε} ≤ ζ
//│             (Fork ∧ {left: δ}) ∧ {right: ε} ≤ Leaf ∧ {value: ⊤}
//│               (Fork ∧ {left: δ}) ∧ {right: ε} ≤ Leaf
//│                 Fork ∧ {left: δ} ≤ Leaf
//│                   Fork ≤ Leaf
//│                   {left: δ} ≤ Leaf
//│                     δ ≤ ⊥
//│                       η ≤ ⊥
//│                         Leaf ∧ {value: θ} ≤ ⊥
//│                           Leaf ≤ ⊥
//│                           {value: θ} ≤ ⊥
//│                             θ ≤ ⊥
//│                               Int ≤ ⊥
//│                 {right: ε} ≤ Leaf
//│                   ε ≤ ⊥
//│                     Bool ≤ ⊥
//│             (Fork ∧ {left: δ}) ∧ {right: ε} ≤ (Fork ∧ {left: ζ}) ∧ {right: ζ}
//│               (Fork ∧ {left: δ}) ∧ {right: ε} ≤ {right: ζ}
//│                 Fork ∧ {left: δ} ≤ {right: ζ}
//│                   Fork ≤ {right: ζ}
//│                   {left: δ} ≤ {right: ζ}
//│                     δ ≤ ⊥
//│                       η ≤ ⊥
//│                         Leaf ∧ {value: θ} ≤ ⊥
//│                           Leaf ≤ ⊥
//│                           {value: θ} ≤ ⊥
//│                             θ ≤ ⊥
//│                               Int ≤ ⊥
//│                 {right: ε} ≤ {right: ζ}
//│                   ε ≤ ζ
//│                     Bool ≤ ζ
//│                       Bool ≤ Leaf ∧ {value: ⊤}
//│                         Bool ≤ Leaf
//│                       Bool ≤ (Fork ∧ {left: ζ}) ∧ {right: ζ}
//│                         Bool ≤ Fork ∧ {left: ζ}
//│                           Bool ≤ Fork

/** Nested recursive bindings retain their validated payload relationships. */
fun localCopy(xs) =
  fun go(ys) = if ys is
    LNil() then LNil()
    LCons(h, t) then LCons(h, go(t))
  go(xs)
//│ localCopy: ∀α, β. {β ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: β})} ⟹ (∀γ. {γ ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: γ})} ⟹ γ) → β

:fixme // FIXME: The enclosing nonrecursive wrapper hoists the result carrier; its witness is not inferred.
localCopy(LCons(1, LNil())) as IntList
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ IntList.
//│ Typing error tree:
//│   α ≤ IntList
//│     LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: γ}) ≤ IntList
//│       LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: γ}) ≤ ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X
//│         LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: γ}) ≤ {δ ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: δ})} ⟹ δ
//│           LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: γ}) ≤ δ
//│             (LCons ∧ {head: β}) ∧ {tail: γ} ≤ δ
//│               (LCons ∧ {head: β}) ∧ {tail: γ} ≤ LNil
//│                 LCons ∧ {head: β} ≤ LNil
//│                   LCons ≤ LNil
//│                   {head: β} ≤ LNil
//│                     β ≤ ⊥
//│                       ε ≤ ⊥
//│                         Int ≤ ⊥
//│                 {tail: γ} ≤ LNil
//│                   γ ≤ ⊥
//│                     LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: γ}) ≤ ⊥
//│                       LNil ≤ ⊥
//│               (LCons ∧ {head: β}) ∧ {tail: γ} ≤ (LCons ∧ {head: Int}) ∧ {tail: δ}
//│                 (LCons ∧ {head: β}) ∧ {tail: γ} ≤ {tail: δ}
//│                   LCons ∧ {head: β} ≤ {tail: δ}
//│                     LCons ≤ {tail: δ}
//│                     {head: β} ≤ {tail: δ}
//│                       β ≤ ⊥
//│                         ε ≤ ⊥
//│                           Int ≤ ⊥
//│                   {tail: γ} ≤ {tail: δ}
//│                     γ ≤ δ
//│                       LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: γ}) ≤ δ

// Explicit witnesses separate wrapper instantiation from recursive-body inference.
localCopy[Int][IntList](LCons(1, LNil())) as IntList
//│ IntList
