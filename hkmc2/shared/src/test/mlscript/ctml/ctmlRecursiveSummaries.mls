:ctml


/** Empty list. */
data class LNil()
/** A list cell with structural payloads. */
data class LCons(head, tail)
//│ LNil: Unit → LNil
//│ LCons: ∀α, β. α → β → ((LCons ∧ {head: α}) ∧ {tail: β})

/** Traverse using a shared inferred recursive invariant. */
fun walk(xs) = if xs is
  LNil() then 0
  LCons(_, t) then walk(t)
//│ walk: (∀α. {α ≥ LNil ∨ ((LCons ∧ {head: ⊤}) ∧ {tail: α})} ⟹ α) → Int

walk(LCons(1, LCons("two", LNil()))) as Int
//│ Int

:te
walk(LCons(1, false))
//│ ═══[TYPE ERROR] Cannot solve judgment (∀α. {α ≥ LNil ∨ ((LCons ∧ {head: ⊤}) ∧ {tail: α})} ⟹ α) → Int ≤ β → γ.
//│ Typing error tree:
//│   (∀α. {α ≥ LNil ∨ ((LCons ∧ {head: ⊤}) ∧ {tail: α})} ⟹ α) → Int ≤ β → γ
//│     β ≤ ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: ⊤}) ∧ {tail: α})} ⟹ α
//│       (LCons ∧ {head: δ}) ∧ {tail: ε} ≤ ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: ⊤}) ∧ {tail: α})} ⟹ α
//│         (LCons ∧ {head: δ}) ∧ {tail: ε} ≤ {ζ ≥ LNil ∨ ((LCons ∧ {head: ⊤}) ∧ {tail: ζ})} ⟹ ζ
//│           (LCons ∧ {head: δ}) ∧ {tail: ε} ≤ ζ
//│             (LCons ∧ {head: δ}) ∧ {tail: ε} ≤ LNil
//│               LCons ∧ {head: δ} ≤ LNil
//│                 LCons ≤ LNil
//│                 {head: δ} ≤ LNil
//│                   δ ≤ ⊥
//│                     Int ≤ ⊥
//│               {tail: ε} ≤ LNil
//│                 ε ≤ ⊥
//│                   Bool ≤ ⊥
//│             (LCons ∧ {head: δ}) ∧ {tail: ε} ≤ (LCons ∧ {head: ⊤}) ∧ {tail: ζ}
//│               (LCons ∧ {head: δ}) ∧ {tail: ε} ≤ {tail: ζ}
//│                 LCons ∧ {head: δ} ≤ {tail: ζ}
//│                   LCons ≤ {tail: ζ}
//│                   {head: δ} ≤ {tail: ζ}
//│                     δ ≤ ⊥
//│                       Int ≤ ⊥
//│                 {tail: ε} ≤ {tail: ζ}
//│                   ε ≤ ζ
//│                     Bool ≤ ζ
//│                       Bool ≤ LNil
//│                       Bool ≤ (LCons ∧ {head: ⊤}) ∧ {tail: ζ}
//│                         Bool ≤ LCons ∧ {head: ⊤}
//│                           Bool ≤ LCons

/** Count cells without annotating the recursive definition. */
fun length(xs) = if xs is
  LNil() then 0
  LCons(_, t) then 1 + length(t)
//│ length: (∀α. {α ≥ LNil ∨ ((LCons ∧ {head: ⊤}) ∧ {tail: α})} ⟹ α) → Int

length(LCons(1, LNil())) as Int
//│ Int

/** Preserve payload types while reconstructing cells. */
fun copy(xs) = if xs is
  LNil() then LNil()
  LCons(h, t) then LCons(h, copy(t))
//│ copy: ∀α. (∀β. {β ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: β})} ⟹ β) → (∀γ. {γ ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: γ})} ⟹ γ)

/** Relate callback input and output payloads across recursion. */
fun map(f, xs) = if xs is
  LNil() then LNil()
  LCons(h, t) then LCons(f(h), map(f, t))
//│ map: ∀α, β. (α → β) → (∀γ. {γ ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: γ})} ⟹ γ) → (∀δ. {δ ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: δ})} ⟹ δ)

type IntList = [X restricts (LNil | (LCons & {head: Int} & {tail: X}))] -> X
type StrList = [X restricts (LNil | (LCons & {head: Str} & {tail: X}))] -> X
//│ IntList = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X
//│ StrList = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: X})} ⟹ X

copy(LCons(1, LNil())) as IntList
map(x => "value", LCons(1, LNil())) as StrList
length(map(x => x + 1, LCons(1, LNil()))) as Int
//│ IntList
//│ StrList
//│ Int

:te
map(x => x + 1, LCons("bad", LNil()))
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ β → γ.
//│ Typing error tree:
//│   α ≤ β → γ
//│     (∀δ. {δ ≥ LNil ∨ ((LCons ∧ {head: ε}) ∧ {tail: δ})} ⟹ δ) → (∀ζ. {ζ ≥ LNil ∨ ((LCons ∧ {head: η}) ∧ {tail: ζ})} ⟹ ζ) ≤ β → γ
//│       β ≤ ∀δ. {δ ≥ LNil ∨ ((LCons ∧ {head: ε}) ∧ {tail: δ})} ⟹ δ
//│         (LCons ∧ {head: θ}) ∧ {tail: ι} ≤ ∀δ. {δ ≥ LNil ∨ ((LCons ∧ {head: ε}) ∧ {tail: δ})} ⟹ δ
//│           (LCons ∧ {head: θ}) ∧ {tail: ι} ≤ {κ ≥ LNil ∨ ((LCons ∧ {head: ε}) ∧ {tail: κ})} ⟹ κ
//│             (LCons ∧ {head: θ}) ∧ {tail: ι} ≤ κ
//│               (LCons ∧ {head: θ}) ∧ {tail: ι} ≤ LNil
//│                 LCons ∧ {head: θ} ≤ LNil
//│                   LCons ≤ LNil
//│                   {head: θ} ≤ LNil
//│                     θ ≤ ⊥
//│                       Str ≤ ⊥
//│                 {tail: ι} ≤ LNil
//│                   ι ≤ ⊥
//│                     λ ≤ ⊥
//│                       LNil ≤ ⊥
//│               (LCons ∧ {head: θ}) ∧ {tail: ι} ≤ (LCons ∧ {head: ε}) ∧ {tail: κ}
//│                 (LCons ∧ {head: θ}) ∧ {tail: ι} ≤ LCons ∧ {head: ε}
//│                   (LCons ∧ {head: θ}) ∧ {tail: ι} ≤ {head: ε}
//│                     LCons ∧ {head: θ} ≤ {head: ε}
//│                       LCons ≤ {head: ε}
//│                       {head: θ} ≤ {head: ε}
//│                         θ ≤ ε
//│                           θ ≤ Int
//│                             Str ≤ Int
//│                     {tail: ι} ≤ {head: ε}
//│                       ι ≤ ⊥
//│                         λ ≤ ⊥
//│                           LNil ≤ ⊥

:te
copy(LCons(1, false))
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α. (∀β. {β ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: β})} ⟹ β) → (∀γ. {γ ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: γ})} ⟹ γ) ≤ δ → ε.
//│ Typing error tree:
//│   ∀α. (∀β. {β ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: β})} ⟹ β) → (∀γ. {γ ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: γ})} ⟹ γ) ≤ δ → ε
//│     (∀β. {β ≥ LNil ∨ ((LCons ∧ {head: ζ}) ∧ {tail: β})} ⟹ β) → (∀γ. {γ ≥ LNil ∨ ((LCons ∧ {head: ζ}) ∧ {tail: γ})} ⟹ γ) ≤ δ → ε
//│       δ ≤ ∀β. {β ≥ LNil ∨ ((LCons ∧ {head: ζ}) ∧ {tail: β})} ⟹ β
//│         (LCons ∧ {head: η}) ∧ {tail: θ} ≤ ∀β. {β ≥ LNil ∨ ((LCons ∧ {head: ζ}) ∧ {tail: β})} ⟹ β
//│           (LCons ∧ {head: η}) ∧ {tail: θ} ≤ {ι ≥ LNil ∨ ((LCons ∧ {head: ζ}) ∧ {tail: ι})} ⟹ ι
//│             (LCons ∧ {head: η}) ∧ {tail: θ} ≤ ι
//│               (LCons ∧ {head: η}) ∧ {tail: θ} ≤ LNil
//│                 LCons ∧ {head: η} ≤ LNil
//│                   LCons ≤ LNil
//│                   {head: η} ≤ LNil
//│                     η ≤ ⊥
//│                       Int ≤ ⊥
//│                 {tail: θ} ≤ LNil
//│                   θ ≤ ⊥
//│                     Bool ≤ ⊥
//│               (LCons ∧ {head: η}) ∧ {tail: θ} ≤ (LCons ∧ {head: ζ}) ∧ {tail: ι}
//│                 (LCons ∧ {head: η}) ∧ {tail: θ} ≤ {tail: ι}
//│                   LCons ∧ {head: η} ≤ {tail: ι}
//│                     LCons ≤ {tail: ι}
//│                     {head: η} ≤ {tail: ι}
//│                       η ≤ ⊥
//│                         Int ≤ ⊥
//│                   {tail: θ} ≤ {tail: ι}
//│                     θ ≤ ι
//│                       Bool ≤ ι
//│                         Bool ≤ LNil
//│                         Bool ≤ (LCons ∧ {head: ζ}) ∧ {tail: ι}
//│                           Bool ≤ LCons ∧ {head: ζ}
//│                             Bool ≤ LCons

:te
map(x => "value", LCons(1, LNil())) as IntList
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ IntList.
//│ Typing error tree:
