:ctml

/** Base constructor of a unary chain. */
data class Stop()
/** Recursive constructor with an unrestricted tail. */
data class Next(tail)
//│ Stop: Unit → Stop
//│ Next: ∀α. α → (Next ∧ {tail: α})

/** Infer the traversal body independently of its recursive invariant. */
fun step(self, xs) = if xs is
  Stop() then 0
  Next(t) then self(t)
//│ step: ∀α, β, γ, δ. {α ≤ ¬({β ≤ Stop, γ ≥ Int} ⟹ ⊥) ∨ ¬({β ≤ {tail: δ} ∧ Next} ⟹ ¬(δ → γ)), β ≤ ¬({γ ≥ Int} ⟹ ¬Stop) ∨ ¬({α ≤ δ → γ} ⟹ ¬({tail: δ} ∧ Next)), γ ≥ ({β ≤ Stop} ⟹ Int) ∧ ({α ≤ δ → γ, β ≤ {tail: δ} ∧ Next} ⟹ ⊥)} ⟹ α → β → γ

/** Candidate invariant expressed with the existing least-fixed-point encoding. */
type Nodes = [X restricts (Stop | (Next & {tail: X}))] -> X
//│ Nodes = ∀X. {X ≥ Stop ∨ (Next ∧ {tail: X})} ⟹ X

// Checking a compact summary after inferring the guarded scheme is incomplete.
:fixme // FIXME: The inferred curried scheme does not split the inner input into constructor cases.
val summary: (Nodes -> Int) -> Nodes -> Int = step
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ, δ. {α ≤ ¬({β ≤ Stop, γ ≥ Int} ⟹ ⊥) ∨ ¬({β ≤ {tail: δ} ∧ Next} ⟹ ¬(δ → γ)), β ≤ ¬({γ ≥ Int} ⟹ ¬Stop) ∨ ¬({α ≤ δ → γ} ⟹ ¬({tail: δ} ∧ Next)), γ ≥ ({β ≤ Stop} ⟹ Int) ∧ ({α ≤ δ → γ, β ≤ {tail: δ} ∧ Next} ⟹ ⊥)} ⟹ α → β → γ ≤ (Nodes → Int) → Nodes → Int.
//│ Typing error tree:
//│   ∀α, β, γ, δ. {α ≤ ¬({β ≤ Stop, γ ≥ Int} ⟹ ⊥) ∨ ¬({β ≤ {tail: δ} ∧ Next} ⟹ ¬(δ → γ)), β ≤ ¬({γ ≥ Int} ⟹ ¬Stop) ∨ ¬({α ≤ δ → γ} ⟹ ¬({tail: δ} ∧ Next)), γ ≥ ({β ≤ Stop} ⟹ Int) ∧ ({α ≤ δ → γ, β ≤ {tail: δ} ∧ Next} ⟹ ⊥)} ⟹ α → β → γ ≤ (Nodes → Int) → Nodes → Int
//│     {ε ≤ ¬({ζ ≤ Stop, η ≥ Int} ⟹ ⊥) ∨ ¬({ζ ≤ {tail: θ} ∧ Next} ⟹ ¬(θ → η)), ζ ≤ ¬({η ≥ Int} ⟹ ¬Stop) ∨ ¬({ε ≤ θ → η} ⟹ ¬({tail: θ} ∧ Next)), η ≥ ({ζ ≤ Stop} ⟹ Int) ∧ ({ε ≤ θ → η, ζ ≤ {tail: θ} ∧ Next} ⟹ ⊥)} ⟹ ε → ζ → η ≤ (Nodes → Int) → Nodes → Int
//│       {ζ ≤ ¬({η ≥ Int} ⟹ ¬Stop) ∨ ¬({ε ≤ θ → η} ⟹ ¬({tail: θ} ∧ Next)), η ≥ ({ζ ≤ Stop} ⟹ Int) ∧ ({ε ≤ θ → η, ζ ≤ {tail: θ} ∧ Next} ⟹ ⊥)} ⟹ ε → ζ → η ≤ (Nodes → Int) → Nodes → Int
//│         {η ≥ ({ζ ≤ Stop} ⟹ Int) ∧ ({ε ≤ θ → η, ζ ≤ {tail: θ} ∧ Next} ⟹ ⊥)} ⟹ ε → ζ → η ≤ (Nodes → Int) → Nodes → Int
//│           ({ζ ≤ Stop} ⟹ Int) ∧ ({ε ≤ θ → η, ζ ≤ {tail: θ} ∧ Next} ⟹ ⊥) ≤ η
//│             ({ζ ≤ Stop} ⟹ Int) ∧ ({ε ≤ θ → η, ζ ≤ {tail: θ} ∧ Next} ⟹ ⊥) ≤ Int
//│               {ζ ≤ Stop} ⟹ Int ≤ Int
//│                 ζ ≤ Stop
//│                   Nodes ≤ Stop
//│                     ∀X. {X ≥ Stop ∨ (Next ∧ {tail: X})} ⟹ X ≤ Stop
//│                       {ι ≥ Stop ∨ (Next ∧ {tail: ι})} ⟹ ι ≤ Stop
//│                         ι ≤ Stop
//│                           Stop ∨ (Next ∧ {tail: ι}) ≤ Stop
//│                             Next ∧ {tail: ι} ≤ Stop
//│                               Next ≤ Stop
//│                               {tail: ι} ≤ Stop
//│                                 ι ≤ ⊥
//│                                   Stop ∨ (Next ∧ {tail: ι}) ≤ ⊥
//│                                     Stop ≤ ⊥
//│               {ε ≤ θ → η, ζ ≤ {tail: θ} ∧ Next} ⟹ ⊥ ≤ Int
//│                 {ζ ≤ {tail: θ} ∧ Next} ⟹ ⊥ ≤ Int
//│                   ζ ≤ {tail: θ} ∧ Next
//│                     Nodes ≤ {tail: θ} ∧ Next
//│                       ∀X. {X ≥ Stop ∨ (Next ∧ {tail: X})} ⟹ X ≤ {tail: θ} ∧ Next
//│                         ∀X. {X ≥ Stop ∨ (Next ∧ {tail: X})} ⟹ X ≤ {tail: θ}
//│                           {κ ≥ Stop ∨ (Next ∧ {tail: κ})} ⟹ κ ≤ {tail: θ}
//│                             κ ≤ {tail: θ}
//│                               Stop ∨ (Next ∧ {tail: κ}) ≤ {tail: θ}
//│                                 Stop ≤ {tail: θ}

/** One layer of the candidate invariant. */
type Layer = Stop | (Next & {tail: Nodes})
//│ Layer = Stop ∨ (Next ∧ {tail: Nodes})

/** Validate a proposed invariant by checking one body layer with a shared recursive contract. */
val walk = fix[Nodes -> Int]((self: Nodes -> Int) => xs =>
  if (xs as Layer) is
    Stop() then 0
    Next(t) then (self as (Nodes -> Int))(t))
//│ walk: Nodes → Int

walk(Next(Next(Stop()))) as Int
//│ Int

:te
walk(Next(false))
//│ ═══[TYPE ERROR] Cannot solve judgment Nodes → Int ≤ α → β.
//│ Typing error tree:
//│   Nodes → Int ≤ α → β
//│     α ≤ Nodes
//│       Next ∧ {tail: γ} ≤ Nodes
//│         Next ∧ {tail: γ} ≤ ∀X. {X ≥ Stop ∨ (Next ∧ {tail: X})} ⟹ X
//│           Next ∧ {tail: γ} ≤ {δ ≥ Stop ∨ (Next ∧ {tail: δ})} ⟹ δ
//│             Next ∧ {tail: γ} ≤ δ
//│               Next ∧ {tail: γ} ≤ Stop
//│                 Next ≤ Stop
//│                 {tail: γ} ≤ Stop
//│                   γ ≤ ⊥
//│                     Bool ≤ ⊥
//│               Next ∧ {tail: γ} ≤ Next ∧ {tail: δ}
//│                 Next ∧ {tail: γ} ≤ {tail: δ}
//│                   Next ≤ {tail: δ}
//│                   {tail: γ} ≤ {tail: δ}
//│                     γ ≤ δ
//│                       Bool ≤ δ
//│                         Bool ≤ Stop
//│                         Bool ≤ Next ∧ {tail: δ}
//│                           Bool ≤ Next

// A bad recursive argument must fail inside the recursive branch.
:te
val badWalk = fix[Nodes -> Int]((self: Nodes -> Int) => xs =>
  if (xs as Layer) is
    Stop() then 0
    Next(t) then (self as (Nodes -> Int))(false))
//│ ═══[TYPE ERROR] Cannot solve judgment Bool ≤ Nodes.
//│ Typing error tree:
//│   Bool ≤ Nodes
//│     Bool ≤ ∀X. {X ≥ Stop ∨ (Next ∧ {tail: X})} ⟹ X
//│       Bool ≤ {α ≥ Stop ∨ (Next ∧ {tail: α})} ⟹ α
//│         Bool ≤ α
//│           Bool ≤ Stop
//│           Bool ≤ Next ∧ {tail: α}
//│             Bool ≤ Next

/** Empty list for the local-refinement control. */
data class LNil()
/** A cell whose head may have any type. */
data class LCons(head, tail)
//│ LNil: Unit → LNil
//│ LCons: ∀α, β. α → β → ((LCons ∧ {head: α}) ∧ {tail: β})

/** Candidate list invariant that permits heterogeneous heads. */
type AnyList = [X restricts (LNil | (LCons & {head: Top} & {tail: X}))] -> X
/** Expose one list layer for branch checking. */
type AnyLayer = LNil | (LCons & {head: Top} & {tail: AnyList})
//│ AnyList = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: ⊤}) ∧ {tail: X})} ⟹ X
//│ AnyLayer = LNil ∨ ((LCons ∧ {head: ⊤}) ∧ {tail: AnyList})

/** Refine a heterogeneous head locally while sharing a recursive contract. */
val sumInts = fix[AnyList -> Int]((self: AnyList -> Int) => xs =>
  if (xs as AnyLayer) is
    LNil() then 0
    LCons(h, t) then
      if h is Int then h + (self as (AnyList -> Int))(t)
      else (self as (AnyList -> Int))(t))
//│ sumInts: AnyList → Int

/** Infer local refinement independently of the recursive summary. */
fun intOrZero(h) = if h is Int then h else 0
//│ intOrZero: ∀α, β. {α ≥ ({β ≤ Int} ⟹ β) ∧ ({β ≤ ¬Int} ⟹ Int), β ≤ ¬({α ≥ β} ⟹ ¬Int) ∨ ¬({α ≥ Int} ⟹ Int)} ⟹ β → α

// The helper retains guarded result constraints when used without a summary.
:fixme // FIXME: Guarded helper requirements are not discharged inside the recursive summary.
val sumWithHelper = fix[AnyList -> Int]((self: AnyList -> Int) => xs =>
  if (xs as AnyLayer) is
    LNil() then 0
    LCons(h, t) then intOrZero(h) + (self as (AnyList -> Int))(t))
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Int.
//│ Typing error tree:
//│   α ≤ Int
//│     (β ∨ (({β ≤ Int} ⟹ β) ∧ ({β ≤ ¬Int} ⟹ Int))) ∨ Int ≤ Int
//│       β ∨ (({β ≤ Int} ⟹ β) ∧ ({β ≤ ¬Int} ⟹ Int)) ≤ Int
//│         β ≤ Int
//│           ⊤ ≤ Int

/** Validate a nonrecursive summary before composing it with the recursive summary. */
val checkedIntOrZero: Top -> Int = intOrZero
//│ checkedIntOrZero: ⊤ → Int

/** Compose checked summaries without retaining the helper's guarded result scheme. */
val sumWithCheckedHelper = fix[AnyList -> Int]((self: AnyList -> Int) => xs =>
  if (xs as AnyLayer) is
    LNil() then 0
    LCons(h, t) then checkedIntOrZero(h) + (self as (AnyList -> Int))(t))
//│ sumWithCheckedHelper: AnyList → Int

sumWithCheckedHelper(LCons(1, LCons("skip", LNil()))) as Int
//│ Int

// The summary must not justify an operation on an unrefined head.
:te
val badSum = fix[AnyList -> Int]((self: AnyList -> Int) => xs =>
  if (xs as AnyLayer) is
    LNil() then 0
    LCons(h, t) then h + (self as (AnyList -> Int))(t))
//│ ═══[TYPE ERROR] Cannot solve judgment ⊤ ≤ Int.
//│ Typing error tree:
//│   ⊤ ≤ Int
