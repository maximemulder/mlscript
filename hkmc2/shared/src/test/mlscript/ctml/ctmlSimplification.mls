:ctml

val nat: Nat
val int_or_string: Int | Str
//│ nat: Nat
//│ int_or_string: Int ∨ Str

// A conditional and its redex translation need only the scrutinee and result type variables.
// The relation between the outer parameter and the fresh inner parameter is eliminated.

:ctml-cfg no-wrap-ifs

fun direct(a) = if a is Int then a + 1 else a
//│ direct: ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ α), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬Int} ⟹ α → β

:ctml-cfg wrap-ifs

fun wrapped(a) = if a is Int then a + 1 else a
//│ wrapped: ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ α), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬Int} ⟹ α → β

// Additional aliases compose without accumulating quantified parameters.

fun aliases(a) =
  let b = a
  let c = b
  if c is Int then c + 1 else c
//│ aliases: ∀α, β. {β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ ¬Int} ⟹ α), α ≤ ¬({β ≥ Int} ⟹ ¬Int) ∨ ¬Int} ⟹ α → β

wrapped(1)
//│ Int

aliases(1)
//│ Int

wrapped("hello")
//│ Str

aliases("hello")
//│ Str

wrapped(int_or_string)
//│ Int ∨ Str

aliases(int_or_string)
//│ Int ∨ Str

// Bounds on both sides of the eliminated parameter must be retained. A result preserves the
// subclass of the argument when its branch returns the argument unchanged.

fun preserve(a) = if a is Int then a else "other"
//│ preserve: ∀α, β. {α ≥ ({β ≤ Int} ⟹ β) ∧ ({β ≤ ¬Int} ⟹ Str), β ≤ ¬({α ≥ β} ⟹ ¬Int) ∨ ¬({α ≥ Str} ⟹ Int)} ⟹ β → α

preserve(nat) as Nat
//│ Nat

preserve(true) as Str
//│ Str

:te
preserve(true) as Int
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Int.
//│ Typing error tree:
//│   α ≤ Int
//│     Str ∨ (({β ≤ Int} ⟹ β) ∧ ({β ≤ ¬Int} ⟹ Str)) ≤ Int
//│       Str ≤ Int

// Nested splits also keep only the scrutinee and result variables. A union with the result's
// lower bound, and an intersection with the scrutinee's upper bound, are redundant.

fun classify(a) =
  if a is
    Nat then "nat"
    Int then a + 1
    Str then a ++ "!"
//│ classify: ∀α, β. {β ≥ ({α ≤ Nat} ⟹ Str) ∧ ({α ≤ (¬({β ≥ Int} ⟹ ¬Int) ∧ ¬Nat) ∨ (¬({β ≥ Str} ⟹ ¬Str) ∧ ¬Nat)} ⟹ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str)), α ≤ ¬({β ≥ Str} ⟹ ¬Nat) ∨ ¬({β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str)} ⟹ ¬((¬({β ≥ Int} ⟹ ¬Int) ∧ ¬Nat) ∨ (¬({β ≥ Str} ⟹ ¬Str) ∧ ¬Nat)))} ⟹ α → β

classify(nat)
//│ Str

classify(1)
//│ Str ∨ Int

classify("hello")
//│ Str

:te
classify(true)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. {β ≥ ({α ≤ Nat} ⟹ Str) ∧ ({α ≤ (¬({β ≥ Int} ⟹ ¬Int) ∧ ¬Nat) ∨ (¬({β ≥ Str} ⟹ ¬Str) ∧ ¬Nat)} ⟹ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str)), α ≤ ¬({β ≥ Str} ⟹ ¬Nat) ∨ ¬({β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str)} ⟹ ¬((¬({β ≥ Int} ⟹ ¬Int) ∧ ¬Nat) ∨ (¬({β ≥ Str} ⟹ ¬Str) ∧ ¬Nat)))} ⟹ α → β ≤ Bool → γ.
//│ Typing error tree:
//│   ∀α, β. {β ≥ ({α ≤ Nat} ⟹ Str) ∧ ({α ≤ (¬({β ≥ Int} ⟹ ¬Int) ∧ ¬Nat) ∨ (¬({β ≥ Str} ⟹ ¬Str) ∧ ¬Nat)} ⟹ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str)), α ≤ ¬({β ≥ Str} ⟹ ¬Nat) ∨ ¬({β ≥ ({α ≤ Int} ⟹ Int) ∧ ({α ≤ Str} ⟹ Str)} ⟹ ¬((¬({β ≥ Int} ⟹ ¬Int) ∧ ¬Nat) ∨ (¬({β ≥ Str} ⟹ ¬Str) ∧ ¬Nat)))} ⟹ α → β ≤ Bool → γ
//│     {ε ≥ ({δ ≤ Nat} ⟹ Str) ∧ ({δ ≤ (¬({ε ≥ Int} ⟹ ¬Int) ∧ ¬Nat) ∨ (¬({ε ≥ Str} ⟹ ¬Str) ∧ ¬Nat)} ⟹ ({δ ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str)), δ ≤ ¬({ε ≥ Str} ⟹ ¬Nat) ∨ ¬({ε ≥ ({δ ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str)} ⟹ ¬((¬({ε ≥ Int} ⟹ ¬Int) ∧ ¬Nat) ∨ (¬({ε ≥ Str} ⟹ ¬Str) ∧ ¬Nat)))} ⟹ δ → ε ≤ Bool → γ
//│       {δ ≤ ¬({ε ≥ Str} ⟹ ¬Nat) ∨ ¬({ε ≥ ({δ ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str)} ⟹ ¬((¬({ε ≥ Int} ⟹ ¬Int) ∧ ¬Nat) ∨ (¬({ε ≥ Str} ⟹ ¬Str) ∧ ¬Nat)))} ⟹ δ → ε ≤ Bool → γ
//│         δ ≤ ¬({ε ≥ Str} ⟹ ¬Nat) ∨ ¬({ε ≥ ({δ ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str)} ⟹ ¬((¬({ε ≥ Int} ⟹ ¬Int) ∧ ¬Nat) ∨ (¬({ε ≥ Str} ⟹ ¬Str) ∧ ¬Nat)))
//│           Bool ≤ ¬({ε ≥ Str} ⟹ ¬Nat) ∨ ¬({ε ≥ ({δ ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str)} ⟹ ¬((¬({ε ≥ Int} ⟹ ¬Int) ∧ ¬Nat) ∨ (¬({ε ≥ Str} ⟹ ¬Str) ∧ ¬Nat)))
//│             Bool ≤ ¬({ε ≥ Str} ⟹ ¬Nat)
//│               ¬Nat ≤ ¬Bool
//│                 Bool ≤ Nat
//│             Bool ≤ ¬({ε ≥ ({δ ≤ Int} ⟹ Int) ∧ ({δ ≤ Str} ⟹ Str)} ⟹ ¬((¬({ε ≥ Int} ⟹ ¬Int) ∧ ¬Nat) ∨ (¬({ε ≥ Str} ⟹ ¬Str) ∧ ¬Nat)))
//│               ¬((¬({ε ≥ Int} ⟹ ¬Int) ∧ ¬Nat) ∨ (¬({ε ≥ Str} ⟹ ¬Str) ∧ ¬Nat)) ≤ ¬Bool
//│                 Bool ≤ (¬({ε ≥ Int} ⟹ ¬Int) ∧ ¬Nat) ∨ (¬({ε ≥ Str} ⟹ ¬Str) ∧ ¬Nat)
//│                   Bool ≤ ¬({ε ≥ Int} ⟹ ¬Int) ∧ ¬Nat
//│                     Bool ≤ ¬({ε ≥ Int} ⟹ ¬Int)
//│                       ¬Int ≤ ¬Bool
//│                         Bool ≤ Int
//│                   Bool ≤ ¬({ε ≥ Str} ⟹ ¬Str) ∧ ¬Nat
//│                     Bool ≤ ¬({ε ≥ Str} ⟹ ¬Str)
//│                       ¬Str ≤ ¬Bool
//│                         Bool ≤ Str

// A variable used at both polarities must retain the connection to the function argument.

fun apply(f, a) = if a is Int then f(a) else a
//│ apply: ∀α, β, γ. {β ≤ ¬({α ≤ β → γ} ⟹ ¬Int) ∨ ¬({γ ≥ β} ⟹ Int), α ≤ ¬({β ≤ Int} ⟹ ¬(β → γ)) ∨ ¬({β ≤ ¬Int} ⟹ ⊥), γ ≥ ({α ≤ β → γ, β ≤ Int} ⟹ ⊥) ∧ ({β ≤ ¬Int} ⟹ β)} ⟹ α → β → γ

apply((x) => x + 1, 1)
//│ Int

apply((x) => x + 1, "hello")
//│ Str

:te
apply((x) => x ++ "!", 1)
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Int → β.
//│ Typing error tree:
//│   α ≤ Int → β
//│     γ → δ ≤ Int → β
//│       Int ≤ γ
//│         Int ≤ ¬Int

// Simplifying cyclic lower bounds must preserve their nonrecursive base case.

declare fun cycle[A, B, C]: [A >:> (B | Bool), B >:> C, C >:> A] => Unit -> A
//│ cycle: ∀A, B, C. {A ≥ B ∨ Bool, B ≥ C, C ≥ A} ⟹ Unit → A

val cycleResult = cycle()
//│ cycleResult: Bool

cycleResult as Bool
//│ Bool

:te
cycleResult as Int
//│ ═══[TYPE ERROR] Cannot solve judgment Bool ≤ Int.
//│ Typing error tree:
//│   Bool ≤ Int
