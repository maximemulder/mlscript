:ctml

type F
type G
type H
type R = [T restricts F[G[T]]] -> T
type Pair = [X, Y] -> ([F[Y] <:< X] => ([G[X] <:< Y] => Int -> [X, Y]))
type Reordered = [Y, X] -> ([G[X] <:< Y] => ([F[Y] <:< X] => Int -> [X, Y]))
//│ R = ∀T. {T ≥ F[G[T]]} ⟹ T
//│ Pair = ∀X, Y. {F[Y] ≤ X, G[X] ≤ Y} ⟹ Int → ⟨X, Y⟩
//│ Reordered = ∀Y, X. {G[X] ≤ Y, F[Y] ≤ X} ⟹ Int → ⟨X, Y⟩

Pair <:< (Int -> [R, G[R]])
//│ OK

Reordered <:< (Int -> [R, G[R]])
//│ OK

:te
Pair <:< (Int -> [R, Str])
//│ ═══[TYPE ERROR] Cannot solve judgment Pair ≤ Int → ⟨R, Str⟩.
//│ Typing error tree:
//│   Pair ≤ Int → ⟨R, Str⟩
//│     ∀X, Y. {F[Y] ≤ X, G[X] ≤ Y} ⟹ Int → ⟨X, Y⟩ ≤ Int → ⟨R, Str⟩
//│       Int → ⟨F[∀Y. {Y ≥ G[F[Y]]} ⟹ Y], ∀Y. {Y ≥ G[F[Y]]} ⟹ Y⟩ ≤ Int → ⟨R, Str⟩
//│         ⟨F[∀Y. {Y ≥ G[F[Y]]} ⟹ Y], ∀Y. {Y ≥ G[F[Y]]} ⟹ Y⟩ ≤ ⟨R, Str⟩
//│           ∀Y. {Y ≥ G[F[Y]]} ⟹ Y ≤ Str
//│             {α ≥ G[F[α]]} ⟹ α ≤ Str
//│               α ≤ Str
//│                 G[F[α]] ≤ Str

/** Closing a three-variable cycle yields one recursive type and its two unfoldings. */
type Ring = [Y, X, Z] -> ([H[X] <:< Z] => ([F[Y] <:< X] => ([G[Z] <:< Y] => Int -> [X, [Y, Z]])))
type Root = [T restricts F[G[H[T]]]] -> T
//│ Ring = ∀Y, X, Z. {H[X] ≤ Z, F[Y] ≤ X, G[Z] ≤ Y} ⟹ Int → ⟨X, ⟨Y, Z⟩⟩
//│ Root = ∀T. {T ≥ F[G[H[T]]]} ⟹ T

Ring <:< (Int -> [Root, [G[H[Root]], H[Root]]])
//│ OK

declare fun ring: Ring
ring[G[H[Root]], Root, H[Root]] as (Int -> [Root, [G[H[Root]], H[Root]]])
//│ ring: Ring
//│ Int → ⟨Root, ⟨G[H[Root]], H[Root]⟩⟩

/** Both coordinates have self-loops as well as a dependency on the other coordinate. */
type Nested = [X, Y] -> ([(Str | F[[X, Y]]) <:< X] => ([(Int | G[[Y, X]]) <:< Y] => Int -> [X, Y]))
type Outer = [S restricts (Str | F[[S, ([T restricts (Int | G[[T, S]])] -> T)]])] -> S
//│ Nested = ∀X, Y. {Str ∨ F[⟨X, Y⟩] ≤ X, Int ∨ G[⟨Y, X⟩] ≤ Y} ⟹ Int → ⟨X, Y⟩
//│ Outer = ∀S. {S ≥ Str ∨ F[⟨S, ∀T. {T ≥ Int ∨ G[⟨T, S⟩]} ⟹ T⟩]} ⟹ S

type Inner = [T restricts (Int | G[[T, Outer]])] -> T
//│ Inner = ∀T. {T ≥ Int ∨ G[⟨T, Outer⟩]} ⟹ T

Nested <:< (Int -> [Outer, Inner])
//│ OK

declare fun nested: Nested
nested[Outer, Inner] as (Int -> [Outer, Inner])
//│ nested: Nested
//│ Int → ⟨Outer, Inner⟩

/** The cap on Y must hold after substituting the mutually recursive witnesses. */
type Capped = [X, Y] -> ([F[Y] <:< X] => ([G[X] <:< Y] => ([Y <:< G[Top]] => Int -> X)))
//│ Capped = ∀X, Y. {F[Y] ≤ X, G[X] ≤ Y, Y ≤ G[⊤]} ⟹ Int → X

Capped <:< (Int -> R)
//│ OK

/** Either branch can contain the recursive carrier. Taking both minima violates the guard. */
type Based = [T restricts (Int | F[T])] -> T
type Choice = [X, Y, Z] -> ([(Int | F[X]) <:< X] => ([X <:< (Y | Z)] => Int -> [Y, Z]))
declare fun choice: Choice
//│ Based = ∀T. {T ≥ Int ∨ F[T]} ⟹ T
//│ Choice = ∀X, Y, Z. {Int ∨ F[X] ≤ X, X ≤ Y ∨ Z} ⟹ Int → ⟨Y, Z⟩
//│ choice: Choice

choice[Based, Based, Bot] as (Int -> [Based, Bot])
//│ Int → ⟨Based, ⊥⟩

choice[Based, Bot, Based] as (Int -> [Bot, Based])
//│ Int → ⟨⊥, Based⟩

Choice <:< (Int -> [Based, Bot])
//│ OK

Choice <:< (Int -> [Bot, Based])
//│ OK

:te
Choice <:< (Int -> [Bot, Bot])
//│ ═══[TYPE ERROR] Cannot solve judgment Choice ≤ Int → ⟨⊥, ⊥⟩.
//│ Typing error tree:
//│   Choice ≤ Int → ⟨⊥, ⊥⟩
//│     ∀X, Y, Z. {Int ∨ F[X] ≤ X, X ≤ Y ∨ Z} ⟹ Int → ⟨Y, Z⟩ ≤ Int → ⟨⊥, ⊥⟩
//│       ∀Y, Z. {∀X. {X ≥ Int ∨ F[X]} ⟹ X ≤ Y ∨ Z} ⟹ Int → ⟨Y, Z⟩ ≤ Int → ⟨⊥, ⊥⟩
//│         {∀X. {X ≥ Int ∨ F[X]} ⟹ X ≤ α ∨ β} ⟹ Int → ⟨α, β⟩ ≤ Int → ⟨⊥, ⊥⟩
//│           ∀X. {X ≥ Int ∨ F[X]} ⟹ X ≤ α ∨ β
//│             (∀X. {X ≥ Int ∨ F[X]} ⟹ X) ∧ ¬α ≤ β
//│               (∀X. {X ≥ Int ∨ F[X]} ⟹ X) ∧ ¬α ≤ ⊥
//│                 ∀X. {X ≥ Int ∨ F[X]} ⟹ X ≤ α
//│                   ∀X. {X ≥ Int ∨ F[X]} ⟹ X ≤ ⊥
//│                     {γ ≥ Int ∨ F[γ]} ⟹ γ ≤ ⊥
//│                       γ ≤ ⊥
//│                         Int ∨ F[γ] ≤ ⊥
//│                           Int ≤ ⊥

/** A closed constraint in a sibling component leaves the result covariant in X. */
type FixedF = [T restricts F[T]] -> T
type FixedG = [S restricts G[S]] -> S
type NamedSibling = [X restricts F[X]] -> Int -> [X, FixedG]
type InlineSibling = [X restricts F[X]] -> Int -> [X, ([S restricts G[S]] -> S)]
//│ FixedF = ∀T. {T ≥ F[T]} ⟹ T
//│ FixedG = ∀S. {S ≥ G[S]} ⟹ S
//│ NamedSibling = ∀X. {X ≥ F[X]} ⟹ Int → ⟨X, FixedG⟩
//│ InlineSibling = ∀X. {X ≥ F[X]} ⟹ Int → ⟨X, ∀S. {S ≥ G[S]} ⟹ S⟩

NamedSibling <:< (Int -> [FixedF, Top])
//│ OK

InlineSibling <:< (Int -> [FixedF, Top])
//│ OK

declare fun sibling: InlineSibling
sibling[FixedF] as (Int -> [FixedF, Top])
//│ sibling: InlineSibling
//│ Int → ⟨FixedF, ⊤⟩

/** The negative occurrence in an arrow domain can require a larger admissible X. */
type MixedSibling = [X restricts F[X]] -> Int -> [X -> X, ([S restricts G[S]] -> S)]
//│ MixedSibling = ∀X. {X ≥ F[X]} ⟹ Int → ⟨X → X, ∀S. {S ≥ G[S]} ⟹ S⟩

MixedSibling <:< (Int -> [(Top -> Top), Top])
//│ OK

/** At the least X the nested cap is satisfied and the result is FixedF. */
type UnderCap = [X restricts F[X]] -> Int -> ([X <:< FixedF] => X)
//│ UnderCap = ∀X. {X ≥ F[X]} ⟹ Int → ({X ≤ FixedF} ⟹ X)

UnderCap <:< (Int -> FixedF)
//│ OK

:te
UnderCap <:< (Int -> Str)
//│ ═══[TYPE ERROR] Cannot solve judgment UnderCap ≤ Int → Str.
//│ Typing error tree:
//│   UnderCap ≤ Int → Str
//│     ∀X. {X ≥ F[X]} ⟹ Int → ({X ≤ FixedF} ⟹ X) ≤ Int → Str
//│       Int → ({∀X. {X ≥ F[X]} ⟹ X ≤ FixedF} ⟹ ∀X. {X ≥ F[X]} ⟹ X) ≤ Int → Str
//│         {∀X. {X ≥ F[X]} ⟹ X ≤ FixedF} ⟹ ∀X. {X ≥ F[X]} ⟹ X ≤ Str
//│           ∀X. {X ≥ F[X]} ⟹ X ≤ Str
//│             {α ≥ F[α]} ⟹ α ≤ Str
//│               α ≤ Str
//│                 F[α] ≤ Str

/** The upper operand of a positive nested guard can require X = Top. */
type NeedsTop = [X restricts F[X]] -> Int -> ([Top <:< X] => Str)
//│ NeedsTop = ∀X. {X ≥ F[X]} ⟹ Int → ({⊤ ≤ X} ⟹ Str)

NeedsTop <:< (Int -> Str)
//│ OK

/** An arrow domain reverses the variance of its nested guard. */
type GuardedDomain = [X restricts F[X]] -> Int -> (([Top <:< X] => Str) -> X)
declare fun guardedDomain: GuardedDomain
//│ GuardedDomain = ∀X. {X ≥ F[X]} ⟹ Int → ({⊤ ≤ X} ⟹ Str) → X
//│ guardedDomain: GuardedDomain

GuardedDomain <:< (Int -> (Str -> FixedF))
//│ OK

guardedDomain[FixedF] as (Int -> (([Top <:< FixedF] => Str) -> FixedF))
//│ Int → ({⊤ ≤ FixedF} ⟹ Str) → FixedF

GuardedDomain <:< (Int -> (([Top <:< FixedF] => Str) -> FixedF))
//│ OK
