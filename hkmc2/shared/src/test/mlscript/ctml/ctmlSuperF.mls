// Tests copied from the SuperF paper test suite.

// Definitions

class List[A]
class ST[S, A]
type ChurchInt = [A] -> (A -> A) -> (A -> A)
//│ ChurchInt = ∀A. (A → A) → A → A

declare fun head: [A] -> List[A] -> A
declare fun tail: [A] -> List[A] -> List[A]
declare fun nil: [A] -> List[A]
declare fun cons: [A] -> A -> List[A] -> List[A]
declare fun single: [A] -> A -> List[A]
declare fun append: [A] -> List[A] -> List[A] -> List[A]
declare fun length: [A] -> List[A] -> Int
//│ head: ∀A. List[A] → A
//│ tail: ∀A. List[A] → List[A]
//│ nil: ∀A. List[A]
//│ cons: ∀A. A → List[A] → List[A]
//│ single: ∀A. A → List[A]
//│ append: ∀A. List[A] → List[A] → List[A]
//│ length: ∀A. List[A] → Int

declare fun const: [A, B] -> A -> B -> A
declare fun id: [A] -> A -> A
declare fun ids: List[[A] -> A -> A]
declare fun inc: Int -> Int
declare fun choose: [A] -> A -> A -> A
declare fun poly: ([A] -> A -> A) -> [Int, Bool]
declare fun fst: [A, B] -> ([A, B]) -> A
//│ const: ∀A, B. A → B → A
//│ id: ∀A. A → A
//│ ids: List[∀A. A → A]
//│ inc: Int → Int
//│ choose: ∀A. A → A → A
//│ poly: (∀A. A → A) → ⟨Int, Bool⟩
//│ fst: ∀A, B. ⟨A, B⟩ → A

declare fun auto: ([A] -> A -> A) -> ([A] -> A -> A)
declare fun auto2: [B] -> ([A] -> A -> A) -> (B -> B)
//│ auto: (∀A. A → A) → (∀A. A → A)
//│ auto2: ∀B. (∀A. A → A) → B → B

declare fun map: [A, B] -> (A -> B) -> List[A] -> List[B]
declare fun app: [A, B] -> (A -> B) -> A -> B
declare fun revapp: [A, B] -> (A) -> (A -> B) -> B
//│ map: ∀A, B. (A → B) → List[A] → List[B]
//│ app: ∀A, B. (A → B) → A → B
//│ revapp: ∀A, B. A → (A → B) → B

declare fun runST: [A] -> ([S] -> ST[S, A]) -> A
declare fun argST: [S] -> (ST[S, Int])
//│ runST: ∀A. (∀S. ST[S][A]) → A
//│ argST: ∀S. ST[S][Int]

declare fun zero: ChurchInt
declare fun succ: ChurchInt -> ChurchInt
//│ zero: ChurchInt
//│ succ: ChurchInt → ChurchInt

val z = (f, x) => x
val s = (n, f, x) => f(n(f, x))
val n3 = s(s(s(z)))
//│ z: ∀α. ⊤ → α → α
//│ s: ∀β, γ, δ, ε, ζ. {δ ≤ γ → ε, β ≤ ε → ζ} ⟹ (β → δ) → β → γ → ζ
//│ n3: ∀η, θ, ι, κ, λ, μ, ν, ξ, ο, π, ρ, σ, τ, υ, φ, χ, ψ, ω. {ι ≤ θ → κ, κ ≥ θ ∨ μ, μ ≥ θ, η ≤ κ → λ, μ ≥ θ, κ ≥ θ ∨ μ, κ ≥ μ, ι ≥ μ → μ, ρ ≥ λ, θ ≥ ο, η ≥ ξ, π ≤ ο → ρ, ρ ≥ λ, θ ≥ ο, ξ ≤ (ρ → σ) ∧ (κ → λ), η ≥ ξ, θ ≥ ο, ρ ≥ λ, π ≥ θ → λ, ν ≥ ξ → ο → σ, ψ ≥ σ, ο ≥ φ, ξ ≥ υ, χ ≤ φ → ψ, ψ ≥ σ, ο ≥ φ, υ ≤ (ψ → ω) ∧ (ρ → σ) ∧ (κ → λ), ξ ≥ υ, ο ≥ φ, ψ ≥ σ, χ ≥ ο → σ, ν ≤ υ → χ, τ ≥ υ → φ → ω} ⟹ τ

