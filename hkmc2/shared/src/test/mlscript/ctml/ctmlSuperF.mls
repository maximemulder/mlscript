// Terms

declare fun f: [A] -> ((A) -> A) -> List[A] -> A
//│ f: ∀A. (A → A) → List[A] → A

fun a1(x, y) = y
//│ a1: ∀α. ⊤ → α → α
// OK

val a2 = choose(id)
//│ a2: ∀α. {α ≥ ∀A. A → A} ⟹ α → α
// OK

val a3 = choose(nil, ids)
//│ a3: ⊥
// OK

fun a4(x) = x(x)
//│ a4: ∀α, β. {α ≤ α → β} ⟹ α → β
// OK

val a5 = id(auto)
//│ a5: ⊥
// OK

val a6 = id(auto2)
//│ a6: ⊥
// OK

val a7 = choose(id, auto)
//│ a7: ⊥
// OK

val a8 = choose(id, auto2)
//│ a8: ⊥
// OK

val a9 = f(choose(id), ids)
//│ a9: ⊥
// OK

val a10 = poly(id)
//│ a10: ⟨Int, Bool⟩
// OK

val a11 = poly((p) => p)
//│ a11: ⟨Int, Bool⟩
// OK

val a12 = id(poly((p) => p))
//│ a12: ⊥
// OK

fun b1(f) = (f(1), f(true))
//│ b1: ∀α, β. ((Int → α) ∧ (Bool → β)) → ⟨α, β⟩
// OK

fun b2(xs) = poly(head(xs))
//│ b2: List[∀A. A → A] → ⟨Int, Bool⟩
// OK

declare fun g: [A] -> List[A] -> List[A] -> A
//│ g: ∀A. List[A] → List[A] → A

val c1 = length(ids)
//│ c1: Int
// OK

val c2 = tail(ids)
//│ c2: List[∀A. A → A]
// OK

val c3 = head(ids)
//│ c3: ⊥
// OK

val c4 = single(id)
//│ c4: List[∀A. A → A]
// OK

val c5 = cons(id, ids)
//│ c5: List[∀A. A → A]
// OK

val c6 = cons((x) => x, ids)
//│ c6: List[∀α. α → α]
// OK

val c7 = append(single(inc), single(id))
//│ c7: List[Int → Int]
// OK

val c8 = g(single(id), ids)
//│ c8: ⊥
// OK

val c9 = map(poly, single(id))
//│ c9: List[⟨Int, Bool⟩]
// OK

val c10 = map(head, single(ids))
//│ c10: List[∀A. A → A]
// OK

val d1 = app(poly, id)
//│ d1: ⟨Int, Bool⟩
// OK

val d2 = revapp(id, poly)
//│ d2: ⊥
// OK

val d3 = runST(argST)
//│ d3: ⊥
// OK

val d4 = app(runST, argST)
//│ d4: ⊥
// OK

val d5 = revapp(argST, runST)
//│ d5: ⊥
// OK

declare fun k: [A] -> (A,  List[A]) -> A
//│ k: ∀A. A → List[A] → A

declare fun h: (Int) -> [A] -> (A) -> A
//│ h: Int → (∀A. A → A)

declare fun l: List[[A] -> (Int, A) -> A]
//│ l: List[∀A. Int → A → A]

declare fun r: ([A] -> (A) -> [B] -> (B) -> B) -> Int
//│ r: (∀A. A → (∀B. B → B)) → Int

val e1 = k(h, l)
//│ e1: ⊥
// OK

val e2 = (k((x) => h(x)))(l)
//│ e2: ⊥
// OK

val e3 = r((x, y) => y)
//│ e3: Int
// OK

val f5 = auto(id)
//│ f5: ∀A. A → A
// OK

val f6 = cons(head(ids), ids)
//│ f6: List[∀A. A → A]
// OK

val f7 = head(ids, 3)
//│ f7: ⊥
// OK

val f8 = choose(head(ids))
//│ f8: ∀α. α → α
// OK

val f9 =
  let f = revapp(id)
  f(poly)
//│ f9: ⊥
// OK

val f10 = choose(id, (x) => auto2(x))
//│ f10: ⊥
// OK

