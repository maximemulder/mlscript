:ctml

// Tests copied from the SuperF paper test suite.

// Definitions

class List[A]
class ST[S, A]
type ChurchInt = [A] -> (A -> A) -> (A -> A)
//│ ChurchInt = ∀A. (A → A) → A → A

declare fun head: [A] -> List[A] -> A
declare fun tail: [A] -> List[A] -> List[A]
declare fun nil: [A] -> List[A]
declare fun cons: [A] -> A -> List[A] -> List[A]
declare fun single: [A] -> A -> List[A]
declare fun append: [A] -> List[A] -> List[A] -> List[A]
declare fun length: [A] -> List[A] -> Int
//│ head: ∀A. List[A] → A
//│ tail: ∀A. List[A] → List[A]
//│ nil: ∀A. List[A]
//│ cons: ∀A. A → List[A] → List[A]
//│ single: ∀A. A → List[A]
//│ append: ∀A. List[A] → List[A] → List[A]
//│ length: ∀A. List[A] → Int

declare fun const: [A, B] -> A -> B -> A
declare fun id: [A] -> A -> A
declare fun ids: List[[A] -> A -> A]
declare fun inc: Int -> Int
declare fun choose: [A] -> A -> A -> A
declare fun poly: ([A] -> A -> A) -> [Int, Bool]
declare fun fst: [A, B] -> ([A, B]) -> A
//│ const: ∀A, B. A → B → A
//│ id: ∀A. A → A
//│ ids: List[∀A. A → A]
//│ inc: Int → Int
//│ choose: ∀A. A → A → A
//│ poly: (∀A. A → A) → ⟨Int, Bool⟩
//│ fst: ∀A, B. ⟨A, B⟩ → A

declare fun auto: ([A] -> A -> A) -> ([A] -> A -> A)
declare fun auto2: [B] -> ([A] -> A -> A) -> (B -> B)
//│ auto: (∀A. A → A) → (∀A. A → A)
//│ auto2: ∀B. (∀A. A → A) → B → B

declare fun map: [A, B] -> (A -> B) -> List[A] -> List[B]
declare fun app: [A, B] -> (A -> B) -> A -> B
declare fun revapp: [A, B] -> (A) -> (A -> B) -> B
//│ map: ∀A, B. (A → B) → List[A] → List[B]
//│ app: ∀A, B. (A → B) → A → B
//│ revapp: ∀A, B. A → (A → B) → B

declare fun runST: [A] -> ([S] -> ST[S, A]) -> A
declare fun argST: [S] -> (ST[S, Int])
//│ runST: ∀A. (∀S. ST[S][A]) → A
//│ argST: ∀S. ST[S][Int]

declare fun zero: ChurchInt
declare fun succ: ChurchInt -> ChurchInt
//│ zero: ChurchInt
//│ succ: ChurchInt → ChurchInt

val z = (f, x) => x
val s = (n, f, x) => f(n(f, x))
val n3 = s(s(s(z)))
//│ z: ∀α. ⊤ → α → α
//│ s: ∀β, γ, δ, ε. {γ ≤ (∀ζ. {β ≤ γ → ζ, ζ ≤ δ → ⊤} ⟹ ⊥) → ε} ⟹ β → γ → δ → ε
//│ n3: ∀η, θ, ι. {η ≤ (∀ζ. {∀κ, λ, μ. {λ ≤ (∀ζ. {∀ν, ξ, ο. {ν ≤ (∀ζ. {∀α. ⊤ → α → α ≤ ν → ζ, ζ ≤ ξ → ⊤} ⟹ ⊥) → ο} ⟹ ν → ξ → ο ≤ λ → ζ, ζ ≤ κ → ⊤} ⟹ ⊥) → μ} ⟹ λ → κ → μ ≤ η → ζ, ζ ≤ θ → ⊤} ⟹ ⊥) → ι} ⟹ η → θ → ι

// Terms

declare fun f: [A] -> ((A) -> A) -> List[A] -> A
//│ f: ∀A. (A → A) → List[A] → A

fun a1(x, y) = y
//│ a1: ∀α. ⊤ → α → α
// OK

val a2 = choose(id)
//│ a2: ∀α. {α ≥ ∀A. A → A} ⟹ α → α
// OK

val a3 = choose(nil, ids)
//│ a3: List[∀A. A → A]
// OK

fun a4(x) = x(x)
//│ a4: ∀α, β. {α ≤ α → β} ⟹ α → β
// OK

val a5 = id(auto)
//│ a5: ∀A. (∀A. A → A) → A → A
// OK

val a6 = id(auto2)
//│ a6: ∀B. (∀A. A → A) → B → B
// OK

val a7 = choose(id, auto)
//│ a7: ∀A. (∀A. A → A) → A → A
// OK

val a8 = choose(id, auto2)
//│ a8: ∀B. (∀A. A → A) → B → B
// OK

val a9 = f(choose(id), ids)
//│ a9: ∀A. A → A
// OK

val a10 = poly(id)
//│ a10: ⟨Int, Bool⟩
// OK

val a11 = poly((p) => p)
//│ a11: ⟨Int, Bool⟩
// OK

val a12 = id(poly((p) => p))
//│ a12: ⟨Int, Bool⟩
// OK

fun b1(f) = (f(1), f(true))
//│ b1: ∀α. α → ⟨∀β. {α ≤ Int → β} ⟹ β, ∀γ. {α ≤ Bool → γ} ⟹ γ⟩
// OK

fun b2(xs) = poly(head(xs))
//│ b2: ∀α, β. {α ≤ List[β]} ⟹ α → ⟨Int, Bool⟩
// OK

declare fun g: [A] -> List[A] -> List[A] -> A
//│ g: ∀A. List[A] → List[A] → A

val c1 = length(ids)
//│ c1: Int
// OK

val c2 = tail(ids)
//│ c2: List[∀A. A → A]
// OK

val c3 = head(ids)
//│ c3: ∀A. A → A
// OK

val c4 = single(id)
//│ c4: List[∀A. A → A]
// OK

val c5 = cons(id, ids)
//│ c5: List[∀A. A → A]
// OK

val c6 = cons((x) => x, ids)
//│ c6: List[∀α. α → α]
// OK

val c7 = append(single(inc), single(id))
//│ c7: List[Int → Int]
// OK

val c8 = g(single(id), ids)
//│ c8: ∀A. A → A
// OK

val c9 = map(poly, single(id))
//│ c9: List[⟨Int, Bool⟩]
// OK

val c10 = map(head, single(ids))
//│ c10: List[∀A. A → A]
// OK

val d1 = app(poly, id)
//│ d1: ⟨Int, Bool⟩
// OK

val d2 = revapp(id, poly)
//│ d2: ⟨Int, Bool⟩
// OK

val d3 = runST(argST)
//│ d3: Int
// OK

val d4 = app(runST, argST)
//│ d4: Int
// OK

val d5 = revapp(argST, runST)
//│ d5: Int
// OK

declare fun k: [A] -> (A,  List[A]) -> A
//│ k: ∀A. A → List[A] → A

declare fun h: (Int) -> [A] -> (A) -> A
//│ h: Int → (∀A. A → A)

declare fun l: List[[A] -> (Int, A) -> A]
//│ l: List[∀A. Int → A → A]

declare fun r: ([A] -> (A) -> [B] -> (B) -> B) -> Int
//│ r: (∀A. A → (∀B. B → B)) → Int

val e1 = k(h, l)
//│ e1: ∀A. Int → A → A
// OK

val e2 = (k((x) => h(x)))(l)
//│ e2: ∀A. Int → A → A
// OK

val e3 = r((x, y) => y)
//│ e3: Int
// OK

val f5 = auto(id)
//│ f5: ∀A. A → A
// OK

val f6 = cons(head(ids), ids)
//│ f6: List[∀A. A → A]
// OK

val f7 = head(ids, 3)
//│ f7: Int
// OK

val f8 = choose(head(ids))
//│ f8: ∀α. {α ≥ ∀A. A → A} ⟹ α → α
// OK

val f9 =
  let f = revapp(id)
  f(poly)
//│ f9: ⟨Int, Bool⟩
// OK

val f10 = choose(id, (x) => auto2(x))
//│ f10: ∀α. (∀A. A → A) → α → α
// OK

val toChurch = (n) => if n == 0 then z else s(toChurch(n - 1))
//│ toChurch: Int → ((∀α. ⊤ → α → α) ∨ (∀β, γ, δ. {δ ≤ (∀ε. {∀ζ. {Int → ((∀α. ⊤ → α → α) ∨ (∀β, γ, δ. {δ ≤ (∀ε. {∀ζ. {η ≤ Int → ζ} ⟹ ζ ≤ δ → ε, ε ≤ γ → ⊤} ⟹ ⊥) → β} ⟹ δ → γ → β)) ≤ Int → ζ} ⟹ ζ ≤ δ → ε, ε ≤ γ → ⊤} ⟹ ⊥) → β} ⟹ δ → γ → β))
// OK

val g1a = z as ChurchInt
//│ g1a: ChurchInt
// OK

val g2 = s
//│ g2: ∀α, β, γ, δ. {β ≤ (∀ε. {α ≤ β → ε, ε ≤ γ → ⊤} ⟹ ⊥) → δ} ⟹ α → β → γ → δ
// OK

val g2a = s as ((ChurchInt) -> ChurchInt)
//│ g2a: ChurchInt → ChurchInt
// OK

val g3a = n3 as ChurchInt
//│ g3a: ChurchInt
// OK

// val g4a = ((u: Unit) => n3(n3)) as ((Unit) -> ChurchInt)
// OK

val g5 = fst(fst(fst(n3((x) => (x, 0), 1))))
//│ g5: ∀α. {α ≥ ∀κ. κ → ⟨κ, Int⟩, α ≤ (∀β. {∀γ, δ, ε. {δ ≤ (∀β. {∀ζ, η, θ. {ζ ≤ (∀β. {∀ι. ⊤ → ι → ι ≤ ζ → β, β ≤ η → ⊤} ⟹ ⊥) → θ} ⟹ ζ → η → θ ≤ δ → β, β ≤ γ → ⊤} ⟹ ⊥) → ε} ⟹ δ → γ → ε ≤ α → β, β ≤ ⊥ → ⊤} ⟹ ⊥) → ⊤} ⟹ ⊥
// OK

