:ctml

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀α, β, γ. {α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {β ≤ Str, γ ≥ Str}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {α ≤ Str, γ ≥ Str}), γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})} ⟹ α → β → γ

foo(1, 2)
//│ Int

fun bop(a, b) =
  let x = foo(a, b)
  x
//│ bop: ∀α, β, γ, δ. {α ≤ (Int ⟹ {γ ≤ Int, ε ≥ Int}) ∨ (Str ⟹ {γ ≤ Str, ε ≥ Str}), α ≥ β, β ≤ (Int ⟹ {γ ≤ Int, ε ≥ Int}) ∨ (Str ⟹ {γ ≤ Str, ε ≥ Str}), γ ≤ (Int ⟹ {α ≤ Int, ε ≥ Int}) ∨ (Str ⟹ {α ≤ Str, ε ≥ Str}), γ ≥ δ, δ ≤ (Int ⟹ {α ≤ Int, ε ≥ Int}) ∨ (Str ⟹ {α ≤ Str, ε ≥ Str})} ⟹ β → δ → ((Int ⟹ {α ≤ Int, γ ≤ Int}) ∨ (Str ⟹ {α ≤ Str, γ ≤ Str}))

bop(0, 1)
//│ Int ∨ (Str ⟹ {β ≤ Str, α ≤ Str})
//│ γ ≥ Int, γ ≥ Int, γ ≥ Int, γ ≥ Int

bop("0", "1")
//│ (Int ⟹ {β ≤ Int, α ≤ Int}) ∨ Str
//│ γ ≥ Str, γ ≥ Str, γ ≥ Str, γ ≥ Str
