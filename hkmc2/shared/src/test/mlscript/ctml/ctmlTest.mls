:ctml

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀α, β, γ. {α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {β ≤ Str, γ ≥ Str}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {α ≤ Str, γ ≥ Str}), γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})} ⟹ α → β → γ

foo(1, 2)
//│ Int

fun bop(a, b) =
  let x = foo(a, b)
  x
//│ bop: ∀ο, ι, π, κ. {ο ≤ (Int ⟹ {π ≤ Int, ρ ≥ Int}) ∨ (Str ⟹ {π ≤ Str, ρ ≥ Str}), ο ≥ ι, ι ≤ (Int ⟹ {π ≤ Int, ρ ≥ Int}) ∨ (Str ⟹ {π ≤ Str, ρ ≥ Str}), π ≤ (Int ⟹ {ο ≤ Int, ρ ≥ Int}) ∨ (Str ⟹ {ο ≤ Str, ρ ≥ Str}), π ≥ κ, κ ≤ (Int ⟹ {ο ≤ Int, ρ ≥ Int}) ∨ (Str ⟹ {ο ≤ Str, ρ ≥ Str})} ⟹ ι → κ → ((Int ⟹ {ο ≤ Int, π ≤ Int}) ∨ (Str ⟹ {ο ≤ Str, π ≤ Str}))

bop(0, 1)
//│ Int ∨ (Str ⟹ {24 ≤ Str, 25 ≤ Str})
//│ ρ ≥ Int, ρ ≥ Int, ρ ≥ Int, ρ ≥ Int

bop("0", "1")
//│ (Int ⟹ {32 ≤ Int, 33 ≤ Int}) ∨ Str
//│ ρ ≥ Str, ρ ≥ Str, ρ ≥ Str, ρ ≥ Str










