:ctml

:ctml-cfg constrained

// Unique parameter

// Function definitions

fun foo(a) =
  if a is
    Int then (a as Int)
    Str then (a as Str)
//│ foo: ∀α. {α ≥ ({({α ≥ Int} ⟹ Int) ∨ ({α ≥ Str} ⟹ Str) ≤ Int} ⟹ Int) ∧ ({({α ≥ Int} ⟹ Int) ∨ ({α ≥ Str} ⟹ Str) ≤ Str} ⟹ Str)} ⟹ (({α ≥ Int} ⟹ Int) ∨ ({α ≥ Str} ⟹ Str)) → α

fun bar(a) =
  foo(a) as Int
