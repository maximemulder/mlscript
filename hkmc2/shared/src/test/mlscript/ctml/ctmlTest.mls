:ctml

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀γ. {γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})} ⟹ ∀β. {β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {α ≤ Str, γ ≥ Str})} ⟹ ∀α. {α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {β ≤ Str, γ ≥ Str})} ⟹ α → β → γ

foo(1, 2)
//│ Int

fun bop(a, b) =
  let x = foo(a, b)
  x
//│ bop: ∀ν. {ν ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})} ⟹ ∀ρ. {ρ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str}), ρ ≤ ν} ⟹ ((Int ⟹ {ρ ≥ Int}) ∨ (Str ⟹ {ρ ≥ Str})) → ((Int ⟹ {α ≤ Int, ρ ≥ Int}) ∨ (Str ⟹ {α ≤ Str, ρ ≥ Str})) → ν

