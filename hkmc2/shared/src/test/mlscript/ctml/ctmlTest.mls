:ctml

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀α, β, γ ◁ {α ≤ (Int ▷ {γ ≥ Int, β ≤ Int}) ∨ (Str ▷ {γ ≥ Str, β ≤ Str}), β ≤ (Int ▷ {γ ≥ Int, α ≤ Int}) ∨ (Str ▷ {γ ≥ Str, α ≤ Str}), γ ≥ (Int ▷ {β ≤ Int, α ≤ Int}) ∨ (Str ▷ {β ≤ Str, α ≤ Str})}. α → β → γ

foo(1, 2)
//│ Int

fun bop(a, b) =
  let x = foo(a, b)
  x
//│ bop: ∀β ◁ {β ≥ η, β ≤ Str}. ((Int ▷ {β ≤ Int}) ∨ (Str ▷ {β ≤ Str})) → ((Int ▷ {α ≤ Int}) ∨ (Str ▷ {α ≤ Str})) → (Int ∨ Str)

bop(0, 1)
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:53)
//│ ═══[ERROR] Type variable 'η' not found in the context.
//│ Typing error tree:
//│   ∀β ◁ {β ≥ η, β ≤ Str}. ((Int ▷ {β ≤ Int}) ∨ (Str ▷ {β ≤ Str})) → ((Int ▷ {α ≤ Int}) ∨ (Str ▷ {α ≤ Str})) → (Int ∨ Str) ≤ Int → ν
//│     η ≤ β

bop("0", "1")
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:53)
//│ ═══[ERROR] Type variable 'η' not found in the context.
