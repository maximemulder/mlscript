:ctml

:ctml-merge constrained

:ctml-dbg

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ SIMPLIFY INTER
//│ SIMPLIFY INTER
//│ SIMPLIFY INTER
//│ foo: ∀α. {α ≤ ({γ ≥ Int, β ≤ Int} ⟹ Int) ∧ ({γ ≥ Str, β ≤ Str} ⟹ Str)} ⟹ α → (∀β. {β ≤ ({γ ≥ Int, α ≤ Int} ⟹ Int) ∧ ({γ ≥ Str, α ≤ Str} ⟹ Str)} ⟹ β → (({β ≤ Int, α ≤ Int} ⟹ Int) ∧ ({β ≤ Str, α ≤ Str} ⟹ Str)))

foo(1, 2)
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:62)
//│ ═══[ERROR] Type variable '2' not found in the context.
//│ Typing error tree:
//│   ∀α. {α ≤ ({γ ≥ Int, β ≤ Int} ⟹ Int) ∧ ({γ ≥ Str, β ≤ Str} ⟹ Str)} ⟹ α → (∀β. {β ≤ ({γ ≥ Int, α ≤ Int} ⟹ Int) ∧ ({γ ≥ Str, α ≤ Str} ⟹ Str)} ⟹ β → (({β ≤ Int, α ≤ Int} ⟹ Int) ∧ ({β ≤ Str, α ≤ Str} ⟹ Str))) ≤ Int → δ
//│     {ε ≤ ({γ ≥ Int, β ≤ Int} ⟹ Int) ∧ ({γ ≥ Str, β ≤ Str} ⟹ Str)} ⟹ ε → (∀β. {β ≤ ({γ ≥ Int, ε ≤ Int} ⟹ Int) ∧ ({γ ≥ Str, ε ≤ Str} ⟹ Str)} ⟹ β → (({β ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({β ≤ Str, ε ≤ Str} ⟹ Str))) ≤ Int → δ
//│       ε → (∀β. {β ≤ ({γ ≥ Int, ε ≤ Int} ⟹ Int) ∧ ({γ ≥ Str, ε ≤ Str} ⟹ Str)} ⟹ β → (({β ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({β ≤ Str, ε ≤ Str} ⟹ Str))) ≤ Int → δ
//│         Int ≤ ε
//│           Int ≤ ({γ ≥ Int, β ≤ Int} ⟹ Int) ∧ ({γ ≥ Str, β ≤ Str} ⟹ Str)
//│             Int ≤ {γ ≥ Int, β ≤ Int} ⟹ Int
//│               ⊤ ≤ {γ ≥ Int, β ≤ Int} ⟹ Int
//│                 Int ≤ γ

:e
foo(1, "")
//│ ═══[ERROR] Type variable '2' not found in the context.
//│ Typing error tree:
//│   ∀α. {α ≤ ({γ ≥ Int, β ≤ Int} ⟹ Int) ∧ ({γ ≥ Str, β ≤ Str} ⟹ Str)} ⟹ α → (∀β. {β ≤ ({γ ≥ Int, α ≤ Int} ⟹ Int) ∧ ({γ ≥ Str, α ≤ Str} ⟹ Str)} ⟹ β → (({β ≤ Int, α ≤ Int} ⟹ Int) ∧ ({β ≤ Str, α ≤ Str} ⟹ Str))) ≤ Int → δ
//│     {ε ≤ ({γ ≥ Int, β ≤ Int} ⟹ Int) ∧ ({γ ≥ Str, β ≤ Str} ⟹ Str)} ⟹ ε → (∀β. {β ≤ ({γ ≥ Int, ε ≤ Int} ⟹ Int) ∧ ({γ ≥ Str, ε ≤ Str} ⟹ Str)} ⟹ β → (({β ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({β ≤ Str, ε ≤ Str} ⟹ Str))) ≤ Int → δ
//│       ε → (∀β. {β ≤ ({γ ≥ Int, ε ≤ Int} ⟹ Int) ∧ ({γ ≥ Str, ε ≤ Str} ⟹ Str)} ⟹ β → (({β ≤ Int, ε ≤ Int} ⟹ Int) ∧ ({β ≤ Str, ε ≤ Str} ⟹ Str))) ≤ Int → δ
