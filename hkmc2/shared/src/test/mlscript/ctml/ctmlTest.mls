:ctml

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀α, β, γ. {α ≤ (Int ⟹ {β ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {β ≤ Str, γ ≥ Str}), β ≤ (Int ⟹ {α ≤ Int, γ ≥ Int}) ∨ (Str ⟹ {α ≤ Str, γ ≥ Str}), γ ≥ (Int ⟹ {α ≤ Int, β ≤ Int}) ∨ (Str ⟹ {α ≤ Str, β ≤ Str})} ⟹ α → β → γ

foo(1, 2)
//│ Int

fun bop(a, b) =
  let x = foo(a, b)
  x
//│ bop: ∀α, β, γ, δ. {α ≤ (Int ⟹ {γ ≤ Int, 16 ≥ Int}) ∨ (Str ⟹ {γ ≤ Str, 16 ≥ Str}), α ≥ β, β ≤ (Int ⟹ {γ ≤ Int, 16 ≥ Int}) ∨ (Str ⟹ {γ ≤ Str, 16 ≥ Str}), γ ≤ (Int ⟹ {α ≤ Int, 16 ≥ Int}) ∨ (Str ⟹ {α ≤ Str, 16 ≥ Str}), γ ≥ δ, δ ≤ (Int ⟹ {α ≤ Int, 16 ≥ Int}) ∨ (Str ⟹ {α ≤ Str, 16 ≥ Str})} ⟹ β → δ → ((Int ⟹ {α ≤ Int, γ ≤ Int}) ∨ (Str ⟹ {α ≤ Str, γ ≤ Str}))

bop(0, 1)
//│ Int ∨ (Str ⟹ {24 ≤ Str, 25 ≤ Str})
//│ 16 ≥ Int, 16 ≥ Int, 16 ≥ Int, 16 ≥ Int

bop("0", "1")
//│ (Int ⟹ {32 ≤ Int, 33 ≤ Int}) ∨ Str
//│ 16 ≥ Str, 16 ≥ Str, 16 ≥ Str, 16 ≥ Str
