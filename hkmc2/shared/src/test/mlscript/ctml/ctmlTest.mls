:ctml

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ foo: ∀α, β, γ ◁ {α ≤ (Int ▷ {β ≤ Int, γ ≥ Int}) ∨ (Str ▷ {β ≤ Str, γ ≥ Str}), β ≤ (Int ▷ {α ≤ Int, γ ≥ Int}) ∨ (Str ▷ {α ≤ Str, γ ≥ Str}), γ ≥ (Int ▷ {α ≤ Int, β ≤ Int}) ∨ (Str ▷ {α ≤ Str, β ≤ Str})}. α → β → γ

foo(1, 2)
//│ Int

fun bop(a, b) =
  let x = foo(a, b)
  x
//│ bop: ∀ο, ι, π, κ ◁ {ο ≥ ι, ο ≤ (Int ▷ {π ≤ Int}) ∨ (Str ▷ {π ≤ Str}), ι ≤ (Int ▷ {π ≤ Int}) ∨ (Str ▷ {π ≤ Str}), π ≥ κ, π ≤ (Int ▷ {ο ≤ Int}) ∨ (Str ▷ {ο ≤ Str}), κ ≤ (Int ▷ {ο ≤ Int}) ∨ (Str ▷ {ο ≤ Str})}. ι → κ → ((Int ▷ {ο ≤ Int, π ≤ Int}) ∨ (Str ▷ {ο ≤ Str, π ≤ Str}))

bop(0, 1)
//│ Int ∨ Str

bop("0", "1")
//│ Int ∨ Str
