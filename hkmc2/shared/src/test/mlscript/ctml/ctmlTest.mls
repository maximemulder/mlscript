:ctml

fun foo(a, b) =
  if a is
    Int then (b as Int)
    Str then (b as Str)
//│ quantify γ
//│ foo: ∀α, β, γ ◁ {α ≤ (Int ▷ {γ ≥ Int, β ≤ Int}) ∨ (Str ▷ {γ ≥ Str, β ≤ Str}), β ≤ (Int ▷ {γ ≥ Int, α ≤ Int}) ∨ (Str ▷ {γ ≥ Str, α ≤ Str}), γ ≥ (Int ▷ {β ≤ Int, α ≤ Int}) ∨ (Str ▷ {β ≤ Str, α ≤ Str})}. α → β → γ

:ctml-dbg infer constrain var

fun bop(a, b) =
  let x = foo(a, b)
  x
//│ infer ELam(a,ELam(b,EApp(ELam(x,EVar(x)),EApp(EApp(EVar(foo),EVar(a)),EVar(b)))))
