//│         δ → ε → ⟨ζ, η⟩ ≤ Bool → κ
//│           Bool ≤ δ
//│             Bool ≤ Int

fun test(f) =
  let r(x) = f(x)
  (r(0), r(true))
//│ test: ∀α. ((Int ∨ Bool) → α) → ⟨α, α⟩

fst(test(id)) + 1
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:71)
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int → Int ≤ α → β.
//│ Typing error tree:
//│   Int → Int → Int ≤ α → β
//│     α ≤ Int
//│       γ ∨ δ ≤ Int
//│         γ ≤ Int
//│           Bool ≤ Int

not'(snd(test(id)))
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:71)
//│ ═══[TYPE ERROR] Cannot solve judgment Bool → Bool ≤ α → β.
//│ Typing error tree:
//│   Bool → Bool ≤ α → β
//│     α ≤ Bool
//│       γ ∨ δ ≤ Bool
