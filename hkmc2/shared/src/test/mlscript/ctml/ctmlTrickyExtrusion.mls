// Tests copied from the `TrickyExtrusion.mls` file. Most of these tests fail in CTML because the
// inferred types, although not incorrect, are not precise enough.

declare val fst: [T] -> ([T, Top]) -> T
declare val snd: [T] -> ([Top, T]) -> T
declare val id: [T] -> T -> T
declare val not': Bool -> Bool
declare val inc: Int -> Int
//│ fst: ∀T. ⟨T, ⊤⟩ → T
//│ snd: ∀T. ⟨⊤, T⟩ → T
//│ id: ∀T. T → T
//│ not': Bool → Bool
//│ inc: Int → Int

val True = true
//│ True: Bool

fun test(f) =
  let r(x, g) = (g(x), unit)
  (r(0, inc), r(true, not'))
//│ test: ⊤ → ⟨∀α, β. {∀γ, δ. γ → δ → ⟨∀ε. {δ ≤ γ → ε} ⟹ ε, Unit⟩ ≤ Int → β, β ≤ (Int → Int) → α} ⟹ α, ∀ζ, η. {∀γ, δ. γ → δ → ⟨∀ε. {δ ≤ γ → ε} ⟹ ε, Unit⟩ ≤ Bool → η, η ≤ (Bool → Bool) → ζ} ⟹ ζ⟩

fun test(f) =
  (f(0), f(true))
//│ test: ∀α. α → ⟨∀β. {α ≤ Int → β} ⟹ β, ∀γ. {α ≤ Bool → γ} ⟹ γ⟩

fun test(f) =
  let r(x) = f(x)
  (r(0), r(true))
//│ test: ∀α. α → ⟨∀β. {∀γ, δ. {α ≤ γ → δ} ⟹ γ → δ ≤ Int → β} ⟹ β, ∀ε. {∀γ, δ. {α ≤ γ → δ} ⟹ γ → δ ≤ Bool → ε} ⟹ ε⟩

