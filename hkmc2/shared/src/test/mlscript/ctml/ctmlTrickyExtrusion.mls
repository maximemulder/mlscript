:ctml

// Tests copied from the `TrickyExtrusion.mls` file.

declare val fst: [T] -> ([T, Top]) -> T
declare val snd: [T] -> ([Top, T]) -> T
declare val id: [T] -> T -> T
declare val not': Bool -> Bool
declare val inc: Int -> Int
//│ fst: ∀T. ⟨T, ⊤⟩ → T
//│ snd: ∀T. ⟨⊤, T⟩ → T
//│ id: ∀T. T → T
//│ not': Bool → Bool
//│ inc: Int → Int

val True = true
//│ True: Bool

fun test(f) =
  let r(x, g) = (g(x), unit)
  (r(0, inc), r(true, not'))
//│ test: ⊤ → ⟨⟨Int, Unit⟩, ⟨Bool, Unit⟩⟩

fun test(f) =
  (f(0), f(true))
//│ test: ∀α, β. ((Int → β) ∧ (Bool → α)) → ⟨β, α⟩

fun test(f) =
  let r(x) = f(x)
  (r(0), r(true))
//│ test: ∀α, β. ((Int → β) ∧ (Bool → α)) → ⟨β, α⟩

fun test(f) =
  let r(x, g) = (g(x), f(x))
  (r(0, inc), r(true, not'))
//│ test: ∀α, β. ((Int → β) ∧ (Bool → α)) → ⟨⟨Int, β⟩, ⟨Bool, α⟩⟩

fun test(f) =
  let r(x) = f(x)
  (r(0), r(true))
//│ test: ∀α, β. ((Int → β) ∧ (Bool → α)) → ⟨β, α⟩

fst(test(id)) + 1
//│ Int

not'(snd(test(id)))
//│ Bool

:te
not'(fst(test(id)))
//│ ═══[TYPE ERROR] Cannot solve judgment Bool → Bool ≤ α → β.
//│ Typing error tree:
//│   Bool → Bool ≤ α → β
//│     α ≤ Bool
//│       Int ≤ Bool
