// Tests copied from the `TrickyExtrusion.mls` file.

declare val fst: [T] -> ([T, Top]) -> T
declare val snd: [T] -> ([Top, T]) -> T
declare val id: [T] -> T -> T
declare val not': Bool -> Bool
declare val inc: Int -> Int
//│ fst: ∀T. ⟨T, ⊤⟩ → T
//│ snd: ∀T. ⟨⊤, T⟩ → T
//│ id: ∀T. T → T
//│ not': Bool → Bool
//│ inc: Int → Int

val True = true
//│ True: Bool

fun test(f) =
  let r(x, g) = (g(x), unit)
  (r(0, inc), r(true, not'))
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:71)
//│ ═══[TYPE ERROR] Cannot solve judgment α → ⟨β, γ⟩ ≤ (δ → ε → ⟨ζ, Unit⟩) → η.
//│ Typing error tree:
//│   α → ⟨β, γ⟩ ≤ (δ → ε → ⟨ζ, Unit⟩) → η
//│     δ → ε → ⟨ζ, Unit⟩ ≤ α
