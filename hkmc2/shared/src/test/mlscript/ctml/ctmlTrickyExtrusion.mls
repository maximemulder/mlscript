//│         δ → ε → ⟨ζ, Unit⟩ ≤ Bool → ι
//│           Bool ≤ δ
//│             Bool ≤ Int

fun test(f) =
  (f(0), f(true))
//│ test: ∀α, β. ((Int → α) ∧ (Bool → β)) → ⟨α, β⟩

fun test(f) =
  let r(x) = f(x)
  (r(0), r(true))
//│ test: ∀α. ((Int ∨ Bool) → α) → ⟨α, α⟩

fun test(f) =
  let r(x, g) = (g(x), f(x))
  (r(0, inc), r(true, not'))
//│ FAILURE: Unexpected type error
//│ FAILURE LOCATION: raise (test.scala:71)
//│ ═══[TYPE ERROR] Cannot solve judgment α → ⟨β, γ⟩ ≤ (δ → ε → ⟨ζ, η⟩) → θ.
//│ Typing error tree:
//│   α → ⟨β, γ⟩ ≤ (δ → ε → ⟨ζ, η⟩) → θ
//│     δ → ε → ⟨ζ, η⟩ ≤ α
