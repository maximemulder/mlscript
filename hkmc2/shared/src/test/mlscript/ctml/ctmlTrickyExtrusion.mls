:ctml

// Tests copied from the `TrickyExtrusion.mls` file. Most of these tests fail in CTML because the
// inferred types, although not incorrect, are not precise enough.

declare val fst: [T] -> ([T, Top]) -> T
declare val snd: [T] -> ([Top, T]) -> T
declare val id: [T] -> T -> T
declare val not': Bool -> Bool
declare val inc: Int -> Int
//│ fst: ∀T. ⟨T, ⊤⟩ → T
//│ snd: ∀T. ⟨⊤, T⟩ → T
//│ id: ∀T. T → T
//│ not': Bool → Bool
//│ inc: Int → Int

val True = true
//│ True: Bool

fun test(f) =
  let r(x, g) = (g(x), unit)
  (r(0, inc), r(true, not'))
//│ test: ⊤ → ⟨⟨Int, Unit⟩, ⊥⟩

fun test(f) =
  (f(0), f(true))
//│ test: ∀α. (Int → α) → ⟨α, ⊥⟩

fun test(f) =
  let r(x) = f(x)
  (r(0), r(true))
//│ test: ∀α, β. {α ≥ β, β ≤ α} ⟹ (Int → β) → ⟨α, ⊥⟩

:fixme
fun test(f) =
  let r(x, g) = (g(x), f(x))
  (r(0, inc), r(true, not'))
//│ test: ∀α. (Int → α) → ⟨⟨Int, α⟩, ⊥⟩
//│ FAILURE: Unexpected lack of error to fix

fun test(f) =
  let r(x) = f(x)
  (r(0), r(true))
//│ test: ∀α, β. {α ≥ β, β ≤ α} ⟹ (Int → β) → ⟨α, ⊥⟩

:fixme
fst(test(id)) + 1
//│ Int
//│ FAILURE: Unexpected lack of error to fix

:fixme
not'(snd(test(id)))
//│ Bool
//│ FAILURE: Unexpected lack of error to fix

:te
not'(fst(test(id)))
//│ ═══[TYPE ERROR] Cannot solve judgment Bool → Bool ≤ Int → α.
//│ Typing error tree:
//│   Bool → Bool ≤ Int → α
//│     Int ≤ Bool
