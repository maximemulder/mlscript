:ctml

// Tests copied from the `TrickyExtrusion.mls` file. Most of these tests fail in CTML because the
// inferred types, although not incorrect, are not precise enough.

declare val fst: [T] -> ([T, Top]) -> T
declare val snd: [T] -> ([Top, T]) -> T
declare val id: [T] -> T -> T
declare val not': Bool -> Bool
declare val inc: Int -> Int
//│ fst: ∀T. ⟨T, ⊤⟩ → T
//│ snd: ∀T. ⟨⊤, T⟩ → T
//│ id: ∀T. T → T
//│ not': Bool → Bool
//│ inc: Int → Int

val True = true
//│ True: Bool

fun test(f) =
  let r(x, g) = (g(x), unit)
  (r(0, inc), r(true, not'))
//│ test: ⊤ → ⟨⟨Int, Unit⟩, ⟨Bool, Unit⟩⟩

fun test(f) =
  (f(0), f(true))
//│ test: ∀α, β. ((Int → α) ∧ (Bool → β)) → ⟨α, β⟩

fun test(f) =
  let r(x) = f(x)
  (r(0), r(true))
//│ test: ∀α. ((Int ∨ Bool) → α) → ⟨α, α⟩

:fixme
fun test(f) =
  let r(x, g) = (g(x), f(x))
  (r(0, inc), r(true, not'))
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β. ((Int → (Int → Int) → α) ∧ (Bool → (Bool → Bool) → β)) → ⟨α, β⟩ ≤ (γ → δ → ⟨ε, ζ⟩) → η.
//│ Typing error tree:
//│   ∀α, β. ((Int → (Int → Int) → α) ∧ (Bool → (Bool → Bool) → β)) → ⟨α, β⟩ ≤ (γ → δ → ⟨ε, ζ⟩) → η
//│     ∀β. ((Int → (Int → Int) → θ) ∧ (Bool → (Bool → Bool) → β)) → ⟨θ, β⟩ ≤ (γ → δ → ⟨ε, ζ⟩) → η
//│       ((Int → (Int → Int) → θ) ∧ (Bool → (Bool → Bool) → ι)) → ⟨θ, ι⟩ ≤ (γ → δ → ⟨ε, ζ⟩) → η
//│         γ → δ → ⟨ε, ζ⟩ ≤ (Int → (Int → Int) → θ) ∧ (Bool → (Bool → Bool) → ι)
//│           γ → δ → ⟨ε, ζ⟩ ≤ Bool → (Bool → Bool) → ι
//│             Bool ≤ γ
//│               Bool ≤ Int

fun test(f) =
  let r(x) = f(x)
  (r(0), r(true))
//│ test: ∀α. ((Int ∨ Bool) → α) → ⟨α, α⟩

:fixme
fst(test(id)) + 1
//│ Int
//│ FAILURE: Unexpected lack of error to fix

:fixme
not'(snd(test(id)))
//│ Bool
//│ FAILURE: Unexpected lack of error to fix

:te
not'(fst(test(id)))
//│ Bool
//│ FAILURE: Unexpected lack of type error
