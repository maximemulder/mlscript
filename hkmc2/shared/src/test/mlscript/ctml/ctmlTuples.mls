:ctml

// Intersecting tuple requirements combines their components, including nested requirements.

fun pairRequirements(x: [Int, Top] & [Top, Str]) = x
//│ pairRequirements: ∀α. {α ≤ ⟨Int, Str⟩} ⟹ α → α

fun tripleRequirements(x: [Int, Top] & [Top, [Int, Top]] & [Top, [Top, Int]]) = x
//│ tripleRequirements: ∀α. {α ≤ ⟨Int, ⟨Int, Int⟩⟩} ⟹ α → α

// Component intersections preserve shared type variables.

declare fun polymorphicPair[A, B]: A -> B -> ([A, Top] & [Top, B])
fun pairFrom(a, b) = polymorphicPair(a, b)
//│ polymorphicPair: ∀A, B. A → B → (⟨A, ⊤⟩ ∧ ⟨⊤, B⟩)
//│ pairFrom: ∀α, β. α → β → ⟨α, β⟩

pairFrom(1, "hello") as [Int, Str]
//│ ⟨Int, Str⟩

:te
pairFrom(1, "hello") as [Str, Int]
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ ⟨Str, Int⟩.
//│ Typing error tree:
//│   α ≤ ⟨Str, Int⟩
//│     ⟨β, γ⟩ ≤ ⟨Str, Int⟩
//│       β ≤ Str
//│         Int ≤ Str

// Conflicting requirements on either component make the intersection empty.

fun emptyFirst(x: [Int, Top] & [Str, Bool]) = x
//│ emptyFirst: ⊥ → ⊥

fun emptySecond(x: [Top, Int] & [Bool, Str]) = x
//│ emptySecond: ⊥ → ⊥

// A union of pairs preserves correlation between its components.

:te
[1, 2] as ([Int, Str] | [Str, Int])
//│ ═══[TYPE ERROR] Cannot solve judgment ⟨Int, Int⟩ ≤ ⟨Int, Str⟩ ∨ ⟨Str, Int⟩.
//│ Typing error tree:
//│   ⟨Int, Int⟩ ≤ ⟨Int, Str⟩ ∨ ⟨Str, Int⟩
//│     ⟨Int, Int⟩ ≤ ⟨Int, Str⟩
//│       Int ≤ Str
//│     ⟨Int, Int⟩ ≤ ⟨Str, Int⟩
//│       Int ≤ Str

// Binary tuple expressions use square brackets and preserve nesting.

[1, "hello"]
//│ ⟨Int, Str⟩

[[1, "hello"], true] as [[Int, Str], Bool]
//│ ⟨⟨Int, Str⟩, Bool⟩

[1, ["hello", true]] as [Int, [Str, Bool]]
//│ ⟨Int, ⟨Str, Bool⟩⟩

val pair =
  let x = 1
  [x, true]
//│ pair: ⟨Int, Bool⟩

// Each tuple component is checked.

:te
[1 + "hello", true]
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
//│ Typing error tree:
//│   α ≤ Str → β
//│     Int → Int ≤ Str → β
//│       Str ≤ Int

:te
[1, true] as [Int, Str]
//│ ═══[TYPE ERROR] Cannot solve judgment ⟨Int, Bool⟩ ≤ ⟨Int, Str⟩.
//│ Typing error tree:
//│   ⟨Int, Bool⟩ ≤ ⟨Int, Str⟩
//│     Bool ≤ Str

// Parentheses group expressions; multiple expressions form an unsupported statement block.

(1)
//│ Int

:pe
(1, true)
//│ ═══[PARSE ERROR] Unsupported CTML term: Lit(IntLit(1))

:pe
fun statements(x) =
  x
  true
//│ ═══[PARSE ERROR] Unsupported CTML term: Ref(x)

// Other arities and spreads have no supported CTML product translation.

:pe
[]
//│ ═══[PARSE ERROR] Unsupported CTML term: Tup(List())

:pe
[1]
//│ ═══[PARSE ERROR] Unsupported CTML term: Tup(List(Fld(‹›,Lit(IntLit(1)),None)))

:pe
[1, ...[2, 3]]
//│ ═══[PARSE ERROR] Unsupported CTML term: Tup(List(Fld(‹›,Lit(IntLit(1)),None), Spd(Eager,Tup(List(Fld(‹›,Lit(IntLit(2)),None), Fld(‹›,Lit(IntLit(3)),None))))))

:pe
[1, "hello", true]
//│ ═══[PARSE ERROR] Unsupported CTML term: Tup(List(Fld(‹›,Lit(IntLit(1)),None), Fld(‹›,Lit(StrLit(hello)),None), Fld(‹›,Lit(BoolLit(true)),None)))

// A three-field MLscript tuple is distinct from a nested pair.

:pe
[1, ["hello", true]] as [Int, Str, Bool]
//│ ═══[PARSE ERROR] Unsupported CTML term: Tup(List(Fld(‹›,Ref(member:Int),None), Fld(‹›,Ref(member:Str),None), Fld(‹›,Ref(member:Bool),None)))

:pe
[[1, "hello"], true] as [Int, Str, Bool]
//│ ═══[PARSE ERROR] Unsupported CTML term: Tup(List(Fld(‹›,Ref(member:Int),None), Fld(‹›,Ref(member:Str),None), Fld(‹›,Ref(member:Bool),None)))

:pe
1 as [Int]
//│ ═══[PARSE ERROR] Unsupported CTML term: Tup(List(Fld(‹›,Ref(member:Int),None)))

:pe
unit as []
//│ ═══[PARSE ERROR] Unsupported CTML term: Tup(List())
