:ctml

// Source: hkmc2/shared/src/test/mlscript-compile/nofib/NofibPrelude.mls.
// Shared definitions for the CTML Nofib ports.
// Projections and external integer operations are trusted primitives.

declare fun fst[A, B]: ([A, B]) -> A
declare fun snd[A, B]: ([A, B]) -> B
//│ fst: ∀A, B. ⟨A, B⟩ → A
//│ snd: ∀A, B. ⟨A, B⟩ → B

val (*): Int -> Int -> Int
//│ *: Int → Int → Int

// Integer division truncates toward zero, as in the source Nofib prelude.
declare fun intQuot: Int -> Int -> Int
//│ intQuot: Int → Int → Int

fun intRem(a, b) = a - (b * intQuot(a, b))
//│ intRem: Int → Int → Int

fun quotRem(a, b) = [intQuot(a, b), intRem(a, b)]
//│ quotRem: Int → Int → ⟨Int, Int⟩

/** Integer comparisons used by the source range and maximum helpers. */
val (<): Int -> Int -> Bool
/** Integer less-than-or-equal comparison for inclusive ranges. */
val (<=): Int -> Int -> Bool
//│ <: Int → Int → Bool
//│ <=: Int → Int → Bool

/** Integer absolute value, implementing the source Math.abs operation. */
fun abs(x) = if x < 0 then 0 - x else x
//│ abs: Int → Int

/** Empty list constructor; source Nil is represented by LNil(). */
data class LNil()
//│ LNil: Unit → LNil

/** List cell; recursive relationships are inferred through constrained types. */
data class LCons(head, tail)
//│ LCons: ∀α, β. α → β → ((LCons ∧ {head: α}) ∧ {tail: β})

/** Inclusive source range, empty when a > b. */
fun enumFromTo(a, b) =
  if a <= b then LCons(a, enumFromTo(a + 1, b)) else LNil()
//│ enumFromTo: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: α})} ⟹ Int → Int → (LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: α}))

/** Source map preserves list order and applies f once per element. */
// FIXME: Inference of unannotated map exceeds the diff-test time limit.
// fun map(f, xs) = if xs is
//   LCons(x, tail) then LCons(f(x), map(f, tail))
//   LNil() then LNil()

/**
 * Trusted library contract; inference of the source implementation above is deferred.
 * ../ctmlRecursiveLists.mls checks a fixed-point implementation for rigid element types.
 * This declaration does not check the source implementation.
 */
declare fun map[A, B]: (A -> B) -> ([X restricts (LNil | (LCons & {head: A} & {tail: X}))] -> X) -> ([Y restricts (LNil | (LCons & {head: B} & {tail: Y}))] -> Y)
//│ map: ∀A, B. (A → B) → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: X})} ⟹ X) → (∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: B}) ∧ {tail: Y})} ⟹ Y)

// FIXME: Inference of unannotated take exceeds the 25-second diff-test limit.
// /** Source take returns empty for nonpositive counts and preserves shorter lists. */
// fun take(n, ls) = if ls is
//   LNil() then LNil()
//   LCons(h, t) then
//     if n <= 0 then LNil() else LCons(h, take(n - 1, t))

/** Trusted take contract; the source implementation above is not checked by this declaration. */
declare fun take[A]: Int -> ([X restricts (LNil | (LCons & {head: A} & {tail: X}))] -> X) -> ([Y restricts (LNil | (LCons & {head: A} & {tail: Y}))] -> Y)
//│ take: ∀A. Int → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: X})} ⟹ X) → (∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: Y})} ⟹ Y)

// FIXME: Inference of unannotated filter exceeds the 25-second diff-test limit.
// /** Source filter preserves the order of elements satisfying the predicate. */
// fun filter(f, ls) = if ls is
//   LNil() then LNil()
//   LCons(h, t) then
//     if f(h) then LCons(h, filter(f, t)) else filter(f, t)

/** Trusted filter contract; the source implementation above is not checked by this declaration. */
declare fun filter[A]: (A -> Bool) -> ([X restricts (LNil | (LCons & {head: A} & {tail: X}))] -> X) -> ([Y restricts (LNil | (LCons & {head: A} & {tail: Y}))] -> Y)
//│ filter: ∀A. (A → Bool) → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: X})} ⟹ X) → (∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: Y})} ⟹ Y)
