:ctml

// Source: hkmc2/shared/src/test/mlscript-compile/nofib/NofibPrelude.mls.
// Shared definitions for the CTML Nofib ports.

/** Trusted source strict equality, distinct from structural equality on arrays and data fields. */
val (===): Top -> Top -> Bool
//│ ===: ⊤ → ⊤ → Bool

/** Trusted model of `throw Error(message)`. A runtime implementation must raise without returning. */
declare fun raiseError: Str -> Bot
//│ raiseError: Str → ⊥

declare fun fst[A, B]: ([A, B]) -> A
declare fun snd[A, B]: ([A, B]) -> B
//│ fst: ∀A, B. ⟨A, B⟩ → A
//│ snd: ∀A, B. ⟨A, B⟩ → B

val (*): Int -> Int -> Int
//│ *: Int → Int → Int

// Integer division truncates toward zero, as in the source Nofib prelude.
declare fun intQuot: Int -> Int -> Int
//│ intQuot: Int → Int → Int

/** Source fractional division of two integer counts, modeled as a numeric result. */
declare fun divideToNum: Int -> Int -> Num
//│ divideToNum: Int → Int → Num

fun intRem(a, b) = a - (b * intQuot(a, b))
//│ intRem: Int → Int → Int

fun quotRem(a, b) = [intQuot(a, b), intRem(a, b)]
//│ quotRem: Int → Int → ⟨Int, Int⟩

/** Integer comparisons used by the source range and maximum helpers. */
val (<): Int -> Int -> Bool
/** Integer less-than-or-equal comparison for inclusive ranges. */
val (<=): Int -> Int -> Bool
//│ <: Int → Int → Bool
//│ <=: Int → Int → Bool

/** Integer absolute value, implementing the source Math.abs operation. */
fun abs(x) = if x < 0 then 0 - x else x
//│ abs: Int → Int

/** Floor division agrees with truncation except for nonintegral quotients with opposite signs. */
fun intDiv(a, b) =
  let q = intQuot(a, b)
  let r = a - (b * q)
  if r == 0 then q else if (a < 0) == (b < 0) then q else q - 1
//│ intDiv: Int → Int → Int

/** Source remainder uses the floor quotient, including when operands have opposite signs. */
fun intMod(a, b) = a - (b * intDiv(a, b))
//│ intMod: Int → Int → Int

/** Empty list constructor; source Nil is represented by LNil(). */
data class LNil()
//│ LNil: Unit → LNil

/** List cell; recursive relationships are inferred through constrained types. */
data class LCons(head, tail)
//│ LCons: ∀α, β. α → β → ((LCons ∧ {head: α}) ∧ {tail: β})

/** Runtime tag for a handle with a private cache and a typed, memoized resume function. */
class Delayed

/** Store an unevaluated initializer in a fresh handle. */
declare fun delay[A]: (() -> A) -> (Delayed & {resume: () -> A})
//│ delay: ∀A. (Unit → A) → (Delayed ∧ {resume: Unit → A})

/** Return the cached value, or run the initializer and cache its successful result. */
declare fun force[A]: (Delayed & {resume: () -> A}) -> A
//│ force: ∀A. (Delayed ∧ {resume: Unit → A}) → A

/** Empty lazy-list node, returned after forcing the enclosing handle. */
data class LzNil()
//│ LzNil: Unit → LzNil

/** Lazy-list cell; its tail is delayed separately from the node. */
data class LzCons(head, tail)
//│ LzCons: ∀α, β. α → β → ((LzCons ∧ {head: α}) ∧ {tail: β})

/** Source head is partial on empty lists. */
fun head(l) = if l is LCons(h, t) then h
//│ head: ∀α. (({tail: ⊤} ∧ {head: α}) ∧ LCons) → α

/** Source null_ returns false for every value other than the empty-list tag. */
fun null_(ls) = if ls is
  LNil() then true
  else false
//│ null_: ∀α. α → (({α ≤ LNil} ⟹ Bool) ∧ ({α ≤ ¬LNil} ⟹ Bool))

/** Inclusive source range, empty when a > b. */
fun enumFromTo(a, b) =
  if a <= b then LCons(a, enumFromTo(a + 1, b)) else LNil()
//│ enumFromTo: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: α})} ⟹ Int → Int → (LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: α}))

/**
 * Trusted map contract. preludeDeferred.mls checks translation of the unannotated implementation.
 * ../ctmlRecursiveLists.mls checks a fixed-point implementation for rigid element types.
 * This declaration does not check the source implementation.
 */
declare fun map[A, B]: (A -> B) -> ([X restricts (LNil | (LCons & {head: A} & {tail: X}))] -> X) -> ([Y restricts (LNil | (LCons & {head: B} & {tail: Y}))] -> Y)
//│ map: ∀A, B. (A → B) → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: X})} ⟹ X) → (∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: B}) ∧ {tail: Y})} ⟹ Y)

/**
 * Trusted take contract. preludeDeferred.mls checks translation of the unannotated implementation.
 */
declare fun take[A]: Int -> ([X restricts (LNil | (LCons & {head: A} & {tail: X}))] -> X) -> ([Y restricts (LNil | (LCons & {head: A} & {tail: Y}))] -> Y)
//│ take: ∀A. Int → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: X})} ⟹ X) → (∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: Y})} ⟹ Y)

/**
 * Trusted filter contract. preludeDeferred.mls checks translation of the unannotated implementation.
 */
declare fun filter[A]: (A -> Bool) -> ([X restricts (LNil | (LCons & {head: A} & {tail: X}))] -> X) -> ([Y restricts (LNil | (LCons & {head: A} & {tail: Y}))] -> Y)
//│ filter: ∀A. (A → Bool) → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: X})} ⟹ X) → (∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: Y})} ⟹ Y)

/**
 * Trusted append contract. Both inputs and the result are proper lists with a common
 * element type. ../ctmlRecursiveLists.mls checks the recursion with a rigid element type.
 * preludeDeferred.mls checks translation of the unannotated implementation.
 */
declare fun append[A]: ([X restricts (LNil | (LCons & {head: A} & {tail: X}))] -> X) -> ([Y restricts (LNil | (LCons & {head: A} & {tail: Y}))] -> Y) -> ([Z restricts (LNil | (LCons & {head: A} & {tail: Z}))] -> Z)
//│ append: ∀A. (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: X})} ⟹ X) → (∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: Y})} ⟹ Y) → (∀Z. {Z ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: Z})} ⟹ Z)

/** Compose functions in the order f(g(x)). */
fun compose(f, g) = x => f(g(x))
//│ compose: ∀α, β, γ. (β → γ) → (α → β) → α → γ

/** Integer specialization of the source Math.max helper. */
fun intMax(a, b) = if a < b then b else a
//│ intMax: ∀α, β. {β ≤ Int, α ≤ Int} ⟹ α → β → (α ∨ β)

/** Inclusive source progression with first two terms a and t. */
fun enumFromThenTo(a, t, b) =
  if a <= b then LCons(a, enumFromThenTo(t, 2 * t - a, b)) else LNil()
//│ enumFromThenTo: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: α})} ⟹ Int → Int → Int → (LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: α}))

/**
 * Trusted listLen contract. The count is independent of the elements' types.
 * ../ctmlRecursiveLists.mls checks the accumulator traversal with a rigid element type.
 * preludeDeferred.mls checks translation of the unannotated implementation.
 */
declare fun listLen: ([X restricts (LNil | (LCons & {head: Top} & {tail: X}))] -> X) -> Int
//│ listLen: (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: ⊤}) ∧ {tail: X})} ⟹ X) → Int

/** Repeat x n times in a strict list. */
fun replicate(n, x) = if n == 0 then LNil() else LCons(x, replicate(n - 1, x))
//│ replicate: ∀α, β. {β ≥ ((LCons ∧ {head: α}) ∧ {tail: β}) ∨ LNil} ⟹ Int → α → (((LCons ∧ {head: α}) ∧ {tail: β}) ∨ LNil)

/** Delay the stream of successive applications of f starting from x. */
fun iterate(f, x) = delay(() => LzCons(x, iterate(f, f(x))))
//│ iterate: ∀α, β. {β ≥ Delayed ∧ {resume: Unit → ((LzCons ∧ {head: α}) ∧ {tail: β})}} ⟹ (α → α) → α → (Delayed ∧ {resume: Unit → ((LzCons ∧ {head: α}) ∧ {tail: β})})

/** Enumerate successive integers starting at a. */
fun enumFrom(a) = delay(() => LzCons(a, enumFrom(a + 1)))
//│ enumFrom: ∀α. {α ≥ Delayed ∧ {resume: Unit → ((LzCons ∧ {head: Int}) ∧ {tail: α})}} ⟹ Int → (Delayed ∧ {resume: Unit → ((LzCons ∧ {head: Int}) ∧ {tail: α})})

/** Trusted integer-to-string conversion corresponding to the source x + "". */
declare fun stringOfInt: Int -> Str
//│ stringOfInt: Int → Str

/** Trusted source primitive. Return the number of UTF-16 code units in a source string. */
declare fun nofibStringLength: Str -> Int
//│ nofibStringLength: Str → Int

/** Trusted charAt returns one UTF-16 code unit or an empty string for an invalid index. */
declare fun nofibCharAt: Str -> Int -> Str
//│ nofibCharAt: Str → Int → Str

/** Split a string into its successive UTF-16 code units, as in the source charAt traversal. */
fun nofibStringToList(s) =
  /** Collect the characters starting at index i. */
  fun go(i) =
    if i < nofibStringLength(s) then LCons(nofibCharAt(s, i), go(i + 1)) else LNil()
  go(0)
//│ nofibStringToList: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α})} ⟹ Str → (LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α}))

// preludeTests.mls checks the inference failure of concat on a nonempty list.

/**
 * Trusted scanl contract. The result always starts with the initial accumulator.
 * ../ctmlRecursiveLists.mls checks the supplied invariant for rigid element types.
 * preludeDeferred.mls checks translation of the unannotated implementation.
 */
declare fun scanl[A, B]: (B -> A -> B) -> B -> ([X restricts (LNil | (LCons & {head: A} & {tail: X}))] -> X) -> ([Y restricts (LNil | (LCons & {head: B} & {tail: Y}))] -> (LCons & {head: B} & {tail: Y}))
//│ scanl: ∀A, B. (B → A → B) → B → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: A}) ∧ {tail: X})} ⟹ X) → (∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: B}) ∧ {tail: Y})} ⟹ (LCons ∧ {head: B}) ∧ {tail: Y})
