/** Reverse the accumulated characters, stopping at the first non-Cons, including "". */
fun reverseInput(s, acc) = if s is LCons(c, rest) then reverseInput(rest, LCons(c, acc)) else acc
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The accumulator reversal is translation-only.
/** Supply the typed input in the order the user entered it. */
fun returnn(s, consume) = consume(reverseInput(s, LNil()))
//│ CTML translation succeeded.

/** Build the continuation for the next editing step. */
data class ReadInput(n, reversed, limit, consume)
/** Delete a character and run the continuation on the remaining input. */
data class DeleteInput(n, reversed, limit, consume, input)
//│ ReadInput: ∀α, β, γ, δ. α → β → γ → δ → ((((ReadInput ∧ {n: α}) ∧ {reversed: β}) ∧ {limit: γ}) ∧ {consume: δ})
//│ DeleteInput: ∀ε, ζ, η, θ, ι. ε → ζ → η → θ → ι → (((((DeleteInput ∧ {n: ε}) ∧ {reversed: ζ}) ∧ {limit: η}) ∧ {consume: θ}) ∧ {input: ι})

:ctml-parse-only // FIXME: The input accumulator reversal is translation-only.
/** Implement the source input loop and its two deletion branches. */
fun edit(task) = if task is
  DeleteInput(n, s, limit, consume, input) then
    if 0 < n then
      writeString(nofibStringToList("BS_BS"),
        edit(ReadInput(n - 1, tail(s), limit, consume)), input)
    else ringBell(edit(ReadInput(0, nofibStringToList(""), limit, consume)), input)
  ReadInput(n, s, limit, consume) then input =>
    let eof = returnn(s, consume)
    /** Handle the next key and run the resulting display continuation. */
    fun consumeChar(c, rest) =
      if c == "B" then edit(DeleteInput(n, s, limit, consume, rest))
      else if c == "D" then edit(DeleteInput(n, s, limit, consume, rest))
      else if c == "`" then returnn(s, consume)(rest)
      else if n < limit then
        writeChar(c, edit(ReadInput(n + 1, LCons(c, s), limit, consume)), rest)
      else ringBell(edit(ReadInput(n, s, limit, consume)), rest)
    readChar(eof, consumeChar, input)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The input editing continuation is translation-only.
/** Reserve input columns and read, retaining the source's empty-string initial accumulator. */
fun readAt(pos, width, consume) =
  writeAt(pos, replicate(width, "_"), moveTo(pos, edit(ReadInput(0, "", width, consume))))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The input continuation is translation-only.
/** Write the prompt and start reading immediately after it. */
fun promptReadAt(pos, width, prompt, consume) = if pos is [x, y] then
  writeAt(pos, prompt, readAt([numAdd(x, numFromInt(listLen(prompt))), y], width, consume))
//│ CTML translation succeeded.

/** Center the reply with the source's fractional division of the character count. */
fun replyColumn(reply) = numSub(40.0, divideToNum(listLen(reply), 2))
//│ replyColumn: (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: ⊤}) ∧ {tail: X})} ⟹ X) → Num

replyColumn(LCons("x", LNil())) as Num
//│ Num

