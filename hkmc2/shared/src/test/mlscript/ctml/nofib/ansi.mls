// Source: hkmc2/shared/src/test/mlscript-compile/nofib/ansi.mls.
// The display and input use strict lists of source string code units. The input loop builds
// a continuation and the deletion step runs it, so the dispatcher keeps those results distinct.

/** The source clear-screen code. */
val cls = nofibStringToList("L")
//│ cls: LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α})} ⟹ α})

/** Build the position code, printing the row before the column. */
fun goto(x, y) = LCons("E", LCons("[",
  append(nofibStringToList(stringOfFloat(y)),
    LCons(";", append(nofibStringToList(stringOfFloat(x)), LCons("H", LNil()))))))
//│ goto: Num → Num → ((LCons ∧ {head: Str}) ∧ {tail: (LCons ∧ {head: Str}) ∧ {tail: ∀Z. {Z ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: Z})} ⟹ Z}})

/** Prefix text with a cursor position. */
fun at(pos, s) = if pos is [x, y] then append(goto(x, y), s)
//│ at: ∀α, β. {α ≥ Str, β ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: β})} ⟹ ⟨Num, Num⟩ → (∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: Y})} ⟹ Y) → β

/** Enclose text in the source highlight controls. */
fun highlight(s) = append(nofibStringToList("ESC[7m"), append(s, nofibStringToList("ESC[0m")))
//│ highlight: ∀α, Z. {Z ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: Z}), α ≥ Str} ⟹ (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X) → Z

/** End the program with an empty display suffix. */
fun endInput(_) = nofibStringToList("")
//│ endInput: ⊤ → (LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α})} ⟹ α}))

:ctml-cfg search-steps 20000 check-steps 20000

/** Consume one character or call the end-of-input continuation. */
fun readChar(eof, consume, cs) = if cs is
  LNil() then eof(LNil())
  LCons(c, rest) then consume(c, rest)
//│ readChar: ∀α, β, γ, δ, ε, ζ. {α ≤ ¬({γ ≤ LNil} ⟹ ¬(LNil → δ)) ∨ ¬({β ≤ ε → ζ → δ, γ ≤ ({head: ε} ∧ {tail: ζ}) ∧ LCons} ⟹ ⊥), γ ≤ ¬({α ≤ LNil → δ} ⟹ ¬LNil) ∨ ¬({β ≤ ε → ζ → δ} ⟹ ¬(({head: ε} ∧ {tail: ζ}) ∧ LCons)), β ≤ ¬({α ≤ LNil → δ, γ ≤ LNil} ⟹ ⊥) ∨ ¬({γ ≤ ({head: ε} ∧ {tail: ζ}) ∧ LCons} ⟹ ¬(ε → ζ → δ))} ⟹ α → β → γ → δ

/** Read one character without consuming it. */
fun peekChar(eof, consume, cs) = if cs is
  LNil() then eof(LNil())
  LCons(c, rest) then consume(c, LCons(c, rest))
//│ peekChar: ∀α, β, γ, δ, ε, ζ. {α ≤ ¬({γ ≤ LNil} ⟹ ¬(LNil → δ)) ∨ ¬({β ≤ ε → ((LCons ∧ {head: ε}) ∧ {tail: ζ}) → δ, γ ≤ ({head: ε} ∧ {tail: ζ}) ∧ LCons} ⟹ ⊥), γ ≤ ¬({α ≤ LNil → δ} ⟹ ¬LNil) ∨ ¬({β ≤ ε → ((LCons ∧ {head: ε}) ∧ {tail: ζ}) → δ} ⟹ ¬(({head: ε} ∧ {tail: ζ}) ∧ LCons)), β ≤ ¬({α ≤ LNil → δ, γ ≤ LNil} ⟹ ⊥) ∨ ¬({γ ≤ ({head: ε} ∧ {tail: ζ}) ∧ LCons} ⟹ ¬(ε → ((LCons ∧ {head: ε}) ∧ {tail: ζ}) → δ))} ⟹ α → β → γ → δ

