/** Advance past one character when there is any input. */
fun pressAnyKey(prog, input) = readChar(prog, (_, rest) => prog(rest), input)
//│ CTML translation succeeded.

/** Prepend a character before calling the input continuation. */
fun unreadChar(c, prog, cs) = prog(LCons(c, cs))
//│ unreadChar: ∀α, β, γ. α → (((LCons ∧ {head: α}) ∧ {tail: β}) → γ) → β → γ

unreadChar("x", head, LNil()) as Str
//│ Str

/** Emit a character before the continuation's display suffix. */
fun writeChar(c, prog, cs) = LCons(c, prog(cs))
//│ writeChar: ∀α, β, γ. α → (β → γ) → β → ((LCons ∧ {head: α}) ∧ {tail: γ})

/** Emit a string before the continuation's display suffix. */
fun writeString(s, prog, cs) = append(s, prog(cs))
//│ writeString: ∀α, β, Z. {Z ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Z})} ⟹ (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: X})} ⟹ X) → (∀Y. α → ({Y ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Y})} ⟹ Y)) → α → Z

writeString(LNil(), _ => LNil(), LNil()) as LNil
//│ LNil

type StrList = [X restricts (LNil | (LCons & {head: Str} & {tail: X}))] -> X
//│ StrList = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: X})} ⟹ X

writeString(LCons("x", LNil()), _ => LNil(), LNil()) as StrList
writeString(LNil(), x => LCons(x, LNil()), "y") as StrList
//│ StrList
//│ StrList

