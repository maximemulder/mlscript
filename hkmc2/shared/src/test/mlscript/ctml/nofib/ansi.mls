/** The source list notation used to lay out the opening screen in order. */
fun (::)(head, tail) = LCons(head, tail)
//│ ::: ∀α, β. α → β → ((LCons ∧ {head: α}) ∧ {tail: β})

:ctml-parse-only // FIXME: The prompt and input editing pipeline is translation-only.
/** Display the introduction, read a name, and wait for another key after the reply. */
fun program(input) = writes(
  cls ::
  at([17.0, 5.0], highlight(nofibStringToList("Demonstration program"))) ::
  at([48.0, 5.0], nofibStringToList("Version 1.0")) ::
  at([17.0, 7.0], nofibStringToList("This program illustrates a simple approach")) ::
  at([17.0, 8.0], nofibStringToList("to screen-based interactive programs using")) ::
  at([17.0, 9.0], nofibStringToList("the Hugs functional programming system.")) ::
  at([17.0, 11.0], nofibStringToList("Please press any key to continue ...")) ::
  LNil(),
  x => pressAnyKey(promptReadAt(
    [17.0, 15.0],
    18,
    nofibStringToList("Please enter your name: "),
    name =>
      let reply = append(nofibStringToList("Hello "), append(name, nofibStringToList("!")))
      writeAt([replyColumn(reply), 18.0], reply,
        moveTo([1.0, 23.0],
          y => writeString(nofibStringToList("I'm waiting..."), x => pressAnyKey(endInput, x), y)))
  ), x),
  input
)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The display program is translation-only.
/** Pipe the fixed input through the requested number of copies of the program. */
fun testAnsi_nofib(n) =
  foldr(compose, x => x, replicate(n, program))(nofibStringToList("testtesttest"))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The full display program is translation-only.
/** Join the display output for one run on the source input. */
fun main() = nofibListToString(testAnsi_nofib(1))
