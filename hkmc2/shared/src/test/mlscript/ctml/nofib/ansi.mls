/** Concatenate display fragments and then emit the continuation's suffix. */
fun writes(ss, a, b) = writeString(concat(ss), a, b)
//│ writes: ∀α, β, γ, Z. {Z ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: Z}), γ ≥ β} ⟹ (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: ∀R. {R ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: R})} ⟹ R}) ∧ {tail: X})} ⟹ X) → (∀Y. α → ({Y ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: Y})} ⟹ Y)) → α → Z

/** Emit the source bell code. */
fun ringBell(prog, cs) = writeChar("B", prog, cs)
//│ ringBell: ∀α, β. (α → β) → α → ((LCons ∧ {head: Str}) ∧ {tail: β})

/** Emit the clear-screen code. */
fun clearScreen(a, b) = writeString(cls, a, b)
//│ clearScreen: ∀α, β, γ, Z. {γ ≥ Str, Z ≥ (LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Z})) ∨ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: Z})} ⟹ ((∀Y. α → ({Y ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Y})} ⟹ Y)) ∧ (∀Y. α → ({Y ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: Y})} ⟹ Y))) → α → Z

/** Build a continuation that emits text at a position. */
fun writeAt(pos, s, a) = if pos is [x, y] then p => writeString(append(goto(x, y), s), a, p)
//│ writeAt: ∀α, β, γ, δ. {δ ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: δ}), β ≥ Str, γ ≥ β} ⟹ ⟨Num, Num⟩ → (∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Y})} ⟹ Y) → (∀Y. α → ({Y ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: Y})} ⟹ Y)) → α → δ

/** Build a continuation that moves the cursor. */
fun moveTo(pos, a) = if pos is [x, y] then p => writeString(goto(x, y), a, p)
//│ moveTo: ∀α, β, γ. {β ≥ Str, γ ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: γ})} ⟹ ⟨Num, Num⟩ → (∀Y. α → ({Y ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Y})} ⟹ Y)) → α → γ

ringBell(_ => LNil(), LNil()) as (LCons & {head: Str} & {tail: LNil})
//│ (LCons ∧ {head: Str}) ∧ {tail: LNil}

