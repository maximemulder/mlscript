:ctml-parse-only // FIXME: Inference exceeds a 20000-call solver budget.
/** Add vectors componentwise, keeping the unpaired suffix of the longer vector. */
fun dotPlus(fs, gs) = if
  fs is LNil() then gs
  gs is LNil() then fs
  fs is LCons(f, ft) and gs is LCons(g, gt) then LCons(numAdd(f, g), dotPlus(ft, gt))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds a 20000-call solver budget.
/** Multiply corresponding components, stopping as soon as either vector ends. */
fun dotMult(fs, gs) = if
  fs is LCons(f, ft) and gs is LCons(g, gt) then LCons(numMul(f, g), dotMult(ft, gt))
  else LNil()
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds a 20000-call solver budget.
/** Scale each component by c. */
fun scalarMut(c, fs) = if fs is
  LNil() then LNil()
  LCons(f, ft) then LCons(numMul(c, f), scalarMut(c, ft))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The vector multiplications are translation-only.
/** Delay each force vector until the corresponding state is demanded. */
fun testforce(k, ss) = delay(() =>
  if force(ss) is LzCons(State(pos, vel), atoms) then
    // The integer minus and fractional division produce the source constant -1.0 exactly.
    let minusOne = divideToNum(0 - 1, 1)
    LzCons(dotMult(scalarMut(minusOne, k), pos), testforce(k, atoms))
)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds a 20000-call solver budget.
/** Render the current position with a tab after every component. */
fun show(s) =
  /** Render the components of a position vector in order. */
  fun lscomp(ls) = if ls is
    LNil() then LNil()
    LCons(component, t) then LCons(stringOfFloat(component) ++ "\t", lscomp(t))
  if s is State(pos, vel) then nofibListToString(lscomp(pos))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The vector operations are translation-only.
/** Advance position and velocity by one time step. */
fun propagate(dt, aforce, state) = if state is State(pos, vel) then
  State(dotPlus(pos, scalarMut(dt, vel)), dotPlus(vel, scalarMut(dt, aforce)))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds a 20000-call solver budget.
/** Delay a pairwise combination of two lazy lists, stopping at the shorter list. */
fun zipWithLzLz(f, xss, yss) = delay(() =>
  if force(xss) is LzCons(x, xs) and force(yss) is LzCons(y, ys) then
    LzCons(f(x, y), zipWithLzLz(f, xs, ys))
  else LzNil()
)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Lazy zip and propagation are translation-only.
/** Tie the simulation stream through the delayed force-law and state computations. */
fun runExperiment(law, dt, param, init) = delay(() =>
  let stream = runExperiment(law, dt, param, init)
  LzCons(init, zipWithLzLz((x, y) => propagate(dt, x, y), law(param, stream), stream))
)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The simulation stream and rendering are translation-only.
/** Render the first n states of the source one-dimensional experiment. */
fun testAtom_nofib(n) =
  /** Append a newline after each rendered state. */
  fun lscomp(ls) = if ls is
    LNil() then LNil()
    LCons(state, t) then LCons(show(state) ++ "\n", lscomp(t))
  let init = State(LCons(1.0, LNil()), LCons(0.0, LNil()))
  nofibListToString(lscomp(takeLz(n, runExperiment(testforce, 0.02, LCons(1.0, LNil()), init))))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The benchmark harness is translation-only.
/** Use the source test input of 20 states. The original benchmark uses 1000. */
fun main() = testAtom_nofib(20)
