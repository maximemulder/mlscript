/** Recursive numeric vectors, used for both State fields in the source. */
type NumList = [X restricts (LNil | (LCons & {head: Num} & {tail: X}))] -> X
//│ NumList = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Num}) ∧ {tail: X})} ⟹ X

/** One simulation state with its position and velocity vectors. */
data class State(position: NumList, velocity: NumList)
//│ State: ∀α, β. {β ≤ NumList, α ≤ NumList} ⟹ α → β → ((State ∧ {position: α}) ∧ {velocity: β})

State(LCons(1.0, LNil()), LCons(0.0, LNil())).position.head as Num
//│ Num

