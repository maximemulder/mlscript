/** Digit glyphs in numeric order. */
val digits =
  let digits0 = glyph(" OOO ", "0  00", "0 0 0", "00  0", " 000 ")
  let digits1 = glyph("  1  ", " 11  ", "  1  ", "  1  ", "11111")
  let digits2 = glyph(" 222 ", "2   2", "   2 ", "  2  ", "22222")
  let digits3 = glyph("3333 ", "    3", " 333 ", "    3", "3333 ")
  let digits4 = glyph("   4 ", "  44 ", " 4 4 ", "44444", "   4 ")
  let digits5 = glyph("55555", "5    ", "5555 ", "    5", "5555 ")
  let digits6 = glyph("   66", "  6  ", " 666 ", "6   6", " 666 ")
  let digits7 = glyph("77777", "    7", "   7 ", "   7 ", "  7  ")
  let digits8 = glyph(" 888 ", "8   8", " 888 ", "8   8", " 888 ")
  let digits9 = glyph(" 999 ", "9   9", " 999 ", "  9  ", "99   ")
  let tail8 = LCons(digits8, LCons(digits9, LNil()))
  let tail4 = LCons(digits4, LCons(digits5, LCons(digits6, LCons(digits7, tail8))))
  let tail0 = LCons(digits0, LCons(digits1, LCons(digits2, LCons(digits3, tail4))))
  tail0
//│ CTML translation succeeded.

/** Join glyph rows with a two-character space. */
fun join(ls) =
  let gap = LCons(" ", LCons(" ", LNil()))
  foldr1((xs, ys) => append(xs, append(gap, ys)), ls)
//│ join: ∀α, β, γ. {γ ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: γ}), α ≥ ∀Z. {Z ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Z})} ⟹ Z, β ≥ Str, α ≤ ∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Y})} ⟹ Y} ⟹ (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ (LCons ∧ {head: α}) ∧ {tail: X}) → γ

/** Test for an ASCII uppercase character. */
fun isUpper(c) =
  let n = nofibCharCode(c)
  (65 <= n) && (n <= 90)
//│ isUpper: Str → Bool

/** Test for an ASCII lowercase character. */
fun isLower(c) =
  let n = nofibCharCode(c)
  (97 <= n) && (n <= 122)
//│ isLower: Str → Bool

/** Test for an ASCII digit. */
fun isDigit(c) =
  let n = nofibCharCode(c)
  (48 <= n) && (n <= 57)
//│ isDigit: Str → Bool

/** Test for the ASCII space character. */
fun isSpace(c) = nofibCharCode(c) == 32
//│ isSpace: Str → Bool

isUpper("I") as Bool
isLower("s") as Bool
isDigit("1") as Bool
isSpace("") as Bool
//│ Bool
//│ Bool
//│ Bool
//│ Bool

:ctml-parse-only // FIXME: The alphabet and digit tables are translation-only.
/** Select a glyph, with an empty row as the default for unsupported characters. */
fun picChar(c) =
  /** Collect the punctuation glyphs whose key matches this character. */
  fun lscomp(ls) = if ls is
    LNil() then LNil()
    LCons([key, letter], t) and
      key === c then LCons(letter, lscomp(t))
      else lscomp(t)
  if
    isUpper(c) then atIndex(nofibCharCode(c) - nofibCharCode("A"), alphas)
    isLower(c) then atIndex(nofibCharCode(c) - nofibCharCode("a"), alphas)
    isSpace(c) then blank
    isDigit(c) then atIndex(nofibCharCode(c) - nofibCharCode("0"), digits)
    c === "/" then slant
    c === "=" then reverse(slant)
    else head(append(lscomp(punct), LCons(LNil(), LCons(LNil(), LNil()))))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Glyph selection is translation-only.
/** Lay out glyphs side by side and prepend the source leading newline. */
fun say(s) = LCons("\n", unlines(map(join, transpose(map(picChar, s)))))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Banner layout is translation-only.
/** Render n copies of the source sentence. */
fun testBanner_nofib(n) =
  let x = nofibStringToList("Is this not a great banner?")
  say(concat(replicate(n, x)))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The benchmark harness is translation-only.
/** Join the characters of the one-copy banner into a string. */
fun main() = nofibListToString(testBanner_nofib(1))
//│ CTML translation succeeded.
