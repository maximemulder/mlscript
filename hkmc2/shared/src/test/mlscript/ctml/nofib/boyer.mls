:ctml-parse-only // FIXME: Term membership has no inferred type.
/** Test whether a rewritten term is true under the current true assumptions. */
fun truep(term, assumed) =
  if isApplicationOf(trueId, term) then true else termInList(term, assumed)
/** Test whether a rewritten term is false under the current false assumptions. */
fun falsep(term, assumed) =
  if isApplicationOf(falseId, term) then true else termInList(term, assumed)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The assumption tests have no inferred types.
/** Follow known branches and test both branches of an unknown condition. */
fun tautologyp(term, trueTerms, falseTerms) = if
  truep(term, trueTerms) then true
  falsep(term, falseTerms) then false
  term is Fun(id, LCons(cond, LCons(t, LCons(e, LNil()))), _) and id === ifId then
    if
      truep(cond, trueTerms) then tautologyp(t, trueTerms, falseTerms)
      falsep(cond, falseTerms) then tautologyp(e, trueTerms, falseTerms)
      else
        if tautologyp(t, LCons(cond, trueTerms), falseTerms) then
          tautologyp(e, trueTerms, LCons(cond, falseTerms))
        else false
  else false
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Rewriting and tautology checking have no inferred types.
/** Rewrite the input and test it with empty assumption lists. */
fun tautp(term) = tautologyp(rewrite(RewriteTerm(term)), LNil(), LNil())
//│ CTML translation succeeded.

/** Form a one-argument application list. */
fun args1(a) = LCons(a, LNil())
//│ args1: ∀α. α → ((LCons ∧ {head: α}) ∧ {tail: LNil})

/** Form a two-argument application list. */
fun args2(a, b) = LCons(a, LCons(b, LNil()))
//│ args2: ∀α, β. α → β → ((LCons ∧ {head: α}) ∧ {tail: (LCons ∧ {head: β}) ∧ {tail: LNil}})

/** Form a three-argument application list. */
fun args3(a, b, c) = LCons(a, LCons(b, LCons(c, LNil())))
//│ args3: ∀α, β, γ. α → β → γ → ((LCons ∧ {head: α}) ∧ {tail: (LCons ∧ {head: β}) ∧ {tail: (LCons ∧ {head: γ}) ∧ {tail: LNil}}})

/** Construct ONE with its delayed rule rewriting it to ADD1 ZERO. */
fun one(zero) = Fun(oneId, LNil(), delay(() => LCons(
  [one(zero), noLemmas(add1Id, args1(zero))],
  LNil()
)))
//│ one: ∀α, β. {β ≥ ((Fun ∧ {i: Symbol ∧ {name: Str}}) ∧ {args: LNil}) ∧ {lemmas: Delayed ∧ {resume: Unit → ((LCons ∧ {head: ⟨β, ((Fun ∧ {i: Symbol ∧ {name: Str}}) ∧ {args: (LCons ∧ {head: α}) ∧ {tail: LNil}}) ∧ {lemmas: Delayed ∧ {resume: Unit → LNil}}⟩}) ∧ {tail: LNil})}}} ⟹ α → (((Fun ∧ {i: Symbol ∧ {name: Str}}) ∧ {args: LNil}) ∧ {lemmas: Delayed ∧ {resume: Unit → ((LCons ∧ {head: ⟨β, ((Fun ∧ {i: Symbol ∧ {name: Str}}) ∧ {args: (LCons ∧ {head: α}) ∧ {tail: LNil}}) ∧ {lemmas: Delayed ∧ {resume: Unit → LNil}}⟩}) ∧ {tail: LNil})}})

if one(noLemmas(zeroId, LNil())) is Fun(_, _, rules) then
  if force(rules) is LCons([lhs, rhs], rest) then [lhs as Fun, [rhs as Fun, rest as LNil]]
//│ ⟨Fun, ⟨Fun, LNil⟩⟩

:ctml-parse-only // FIXME: Rewriting and tautology checking have no inferred types.
/** Instantiate and check the benchmark theorem. */
fun test0(input) =
  /** The theorem variable a. */
  let a = Var(aId)
  /** The theorem variable b. */
  let b = Var(bId)
  /** The theorem variable c. */
  let c = Var(cId)
  /** The theorem variable d. */
  let d = Var(dId)
  /** The theorem variable u. */
  let u = Var(uId)
  /** The theorem variable w. */
  let w = Var(wId)
  /** The theorem variable x. */
  let x = Var(xId)
  /** The theorem variable y. */
  let y = Var(yId)
  /** The theorem variable z. */
  let z = Var(zId)
  /** The constant FALSE with no rewrite rules. */
  let boyerFalse = noLemmas(falseId, LNil())
  /** The constant NIL with no rewrite rules. */
  let nil = noLemmas(nilId, LNil())
  /** The constant TRUE with no rewrite rules. */
  let boyerTrue = noLemmas(trueId, LNil())
  /** The constant ZERO with no rewrite rules. */
  let zero = noLemmas(zeroId, LNil())
  /** Attach each symbol's ordered rules, constructing subterms on demand. */
  fun makeFun(id, args) = Fun(id, args, delay(() =>
    /** Construct a constant in a lemma. */
    fun app0(symbol) = makeFun(symbol, LNil())
    /** Construct a unary application in a lemma. */
    fun app1(symbol, a) = makeFun(symbol, args1(a))
    /** Construct a binary application in a lemma. */
    fun app2(symbol, a, b) = makeFun(symbol, args2(a, b))
    /** Construct a ternary application in a lemma. */
    fun app3(symbol, a, b, c) = makeFun(symbol, args3(a, b, c))
    if
      id === twoId then
        LCons([app0(twoId), app1(add1Id, one(zero))], LNil())
      id === fourId then
        LCons([app0(fourId), app1(add1Id, app1(add1Id, app0(twoId)))], LNil())
      id === ifId then
        let rule = [
          app3(ifId, app3(ifId, x, y, z), u, w),
          app3(ifId, x, app3(ifId, y, u, w), app3(ifId, z, u, w))
        ]
        LCons(rule, LNil())
      id === notId then
        LCons([app1(notId, x), app3(ifId, x, boyerFalse, boyerTrue)], LNil())
      id === andId then
        let rule = [
          app2(andId, x, y),
          app3(ifId, x, app3(ifId, y, boyerTrue, boyerFalse), boyerFalse)
        ]
        LCons(rule, LNil())
      id === appendId then
        let rule = [
          app2(appendId, app2(appendId, x, y), z),
          app2(appendId, x, app2(appendId, y, z))
        ]
        LCons(rule, LNil())
      id === conspId then
        LCons([app1(conspId, app2(consId, x, y)), boyerTrue], LNil())
      id === differenceId then
        let rule1 = [app2(differenceId, x, x), zero]
        let rule2 = [app2(differenceId, app2(plusId, x, y), x), y]
        let rule3 = [app2(differenceId, app2(plusId, y, x), x), y]
        let rule4 = [
          app2(differenceId, app2(plusId, x, y), app2(plusId, x, z)),
          app2(differenceId, y, z)
        ]
        let rule5 = [
          app2(differenceId, app2(plusId, y, app2(plusId, x, z)), x),
          app2(plusId, y, z)
        ]
        let rule6 = [app2(differenceId, app1(add1Id, app2(plusId, y, z)), z), app1(add1Id, y)]
        let rule7 = [app2(differenceId, app1(add1Id, app1(add1Id, x)), app0(twoId)), x]
        LCons(
          rule1,
          LCons(
            rule2,
            LCons(rule3, LCons(rule4, LCons(rule5, LCons(rule6, LCons(rule7, LNil())))))
          )
        )
      id === dividesId then
        LCons([app2(dividesId, x, y), app1(zeropId, app2(remainderId, y, x))], LNil())
      id === equalId then
        let rule1 = [
          app2(equalId, app2(plusId, x, y), zero),
          app2(andId, app1(zeropId, x), app1(zeropId, y))
        ]
        let rule2 = [app2(equalId, app2(plusId, x, y), app2(plusId, x, z)), app2(equalId, y, z)]
        let rule3 = [
          app2(equalId, zero, app2(differenceId, x, y)),
          app1(notId, app2(lessId, y, x))
        ]
        let rule4 = [
          app2(equalId, x, app2(differenceId, x, y)),
          app2(orId, app2(equalId, x, zero), app1(zeropId, y))
        ]
        let rule5 = [
          app2(equalId, app2(timesId, x, y), zero),
          app2(orId, app1(zeropId, x), app1(zeropId, y))
        ]
        let rule6 = [
          app2(equalId, app2(appendId, x, y), app2(appendId, x, z)),
          app2(equalId, y, z)
        ]
        let rule7 = [
          app2(equalId, y, app2(timesId, x, y)),
          app2(orId, app2(equalId, y, zero), app2(equalId, x, one(zero)))
        ]
        let rule8 = [
          app2(equalId, x, app2(timesId, x, y)),
          app2(orId, app2(equalId, x, zero), app2(equalId, y, one(zero)))
        ]
        let rule9 = [
          app2(equalId, app2(timesId, x, y), one(zero)),
          app2(andId, app2(equalId, x, one(zero)), app2(equalId, y, one(zero)))
        ]
        let rule10 = [
          app2(equalId, app2(differenceId, x, y), app2(differenceId, z, y)),
          app3(
            ifId,
            app2(lessId, x, y),
            app1(notId, app2(lessId, y, z)),
            app3(ifId, app2(lessId, z, y), app1(notId, app2(lessId, y, x)), app2(equalId, x, z))
          )
        ]
        let rule11 = [
          app2(equalId, app2(lessId, x, y), z),
          app3(
            ifId,
            app2(lessId, x, y),
            app2(equalId, boyerTrue, z),
            app2(equalId, boyerFalse, z)
          )
        ]
        let lastRules = LCons(rule9, LCons(rule10, LCons(rule11, LNil())))
        let middleRules = LCons(rule5, LCons(rule6, LCons(rule7, LCons(rule8, lastRules))))
        LCons(rule1, LCons(rule2, LCons(rule3, LCons(rule4, middleRules))))
      id === evenId then
        let rule = [
          app1(evenId, x),
          app3(ifId, app1(zeropId, x), boyerTrue, app1(oddId, app1(sub1Id, x)))
        ]
        LCons(rule, LNil())
      id === expId then
        let rule1 = [
          app2(expId, x, app2(plusId, y, z)),
          app2(timesId, app2(expId, x, y), app2(expId, x, z))
        ]
        let rule2 = [app2(expId, x, app2(timesId, y, z)), app2(expId, app2(expId, x, y), z)]
        LCons(rule1, LCons(rule2, LNil()))
      id === gcdId then
        let rule1 = [app2(gcdId, x, y), app2(gcdId, y, x)]
        let rule2 = [
          app2(gcdId, app2(timesId, x, z), app2(timesId, y, z)),
          app2(timesId, z, app2(gcdId, x, y))
        ]
        LCons(rule1, LCons(rule2, LNil()))
      id === greaterEqId then
        LCons([app2(greaterEqId, x, y), app1(notId, app2(lessId, x, y))], LNil())
      id === greaterId then
        LCons([app2(greaterId, x, y), app2(lessId, y, x)], LNil())
      id === impliesId then
        let rule = [
          app2(impliesId, x, y),
