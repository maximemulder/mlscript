// Source: hkmc2/shared/src/test/mlscript-compile/nofib/boyer.mls.
// Each source symbol has one shared instance and is compared by identity. Arguments and
// lemma tables use strict lists, with the whole lemma table behind a memoizing delay.
// Tagged dispatchers retain the mutually recursive calls.

/** A symbol represented by a shared instance. */
data class Symbol(name: Str)
/** A variable identified by its symbol. */
data class Var(i: Symbol)
/** A function application carrying its arguments and delayed lemmas. */
data class Fun(i: Symbol, args, lemmas)
/** The value paired with a failed substitution lookup. */
data class Missing()
//│ Symbol: ∀α. {α ≤ Str} ⟹ α → (Symbol ∧ {name: α})
//│ Var: ∀β. {β ≤ Symbol} ⟹ β → (Var ∧ {i: β})
//│ Fun: ∀γ, δ, ε. {γ ≤ Symbol} ⟹ γ → δ → ε → (((Fun ∧ {i: γ}) ∧ {args: δ}) ∧ {lemmas: ε})
//│ Missing: Unit → Missing

/** Construct an application whose delayed lemma table is empty. */
fun noLemmas(id, args) = Fun(id, args, delay(() => LNil()))
//│ noLemmas: ∀α, β. {α ≤ Symbol} ⟹ α → β → (((Fun ∧ {i: α}) ∧ {args: β}) ∧ {lemmas: Delayed ∧ {resume: Unit → LNil}})

:ctml-cfg search-steps 100000 check-steps 100000

/** Recognize a function application with the given symbol. */
fun isApplicationOf(id, term) = if term is Fun(f, _, _) then f === id else false
//│ isApplicationOf: ∀α. ⊤ → α → (({α ≤ ((Fun ∧ {i: ⊤}) ∧ {args: ⊤}) ∧ {lemmas: ⊤}} ⟹ Bool) ∧ ({α ≤ ¬(((Fun ∧ {i: ⊤}) ∧ {args: ⊤}) ∧ {lemmas: ⊤})} ⟹ Bool))

:ctml-cfg search-steps 20000 check-steps 20000

/** Compare two terms. */
data class EqualTerms(a, b)
/** Compare the common prefix of two argument lists. */
data class EqualArguments(a, b)
//│ EqualTerms: ∀α, β. α → β → ((EqualTerms ∧ {a: α}) ∧ {b: β})
//│ EqualArguments: ∀γ, δ. γ → δ → ((EqualArguments ∧ {a: γ}) ∧ {b: δ})

:ctml-parse-only // FIXME: Recursive substitution lookup exceeds the solver budget.
/** Look up a symbol in a substitution, comparing keys by identity. */
fun find(id, subst) = if subst is
  LNil() then [false, Missing()]
  LCons([key, value], rest) then
    if id === key then [true, value] else find(id, rest)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The equality dispatcher exceeds the solver budget.
/** Compare terms and argument lists without evaluating the lemma fields. */
fun equal(task) = if task is
  EqualTerms(a, b) then
    if a is Var(x) and b is Var(y) then x === y
    else if a is Fun(f, xs, _) and b is Fun(g, ys, _) then
      if f === g then equal(EqualArguments(xs, ys)) else false
    else false
  EqualArguments(xs, ys) then
    if xs is LCons(x, xt) and ys is LCons(y, yt) then
      if equal(EqualTerms(x, y)) then equal(EqualArguments(xt, yt)) else false
    else true
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Term equality has no inferred type.
/** Look for a term among the assumptions. */
fun termInList(term, terms) = if terms is
  LNil() then false
  LCons(x, xs) then
    if equal(EqualTerms(term, x)) then true else termInList(term, xs)
//│ CTML translation succeeded.

/** Unify a term against a pattern. */
data class UnifyTerm(term, pat, subst)
/** Unify corresponding arguments from two lists. */
data class UnifyArguments(terms, patterns, subst)
//│ UnifyTerm: ∀α, β, γ. α → β → γ → (((UnifyTerm ∧ {term: α}) ∧ {pat: β}) ∧ {subst: γ})
//│ UnifyArguments: ∀δ, ε, ζ. δ → ε → ζ → (((UnifyArguments ∧ {terms: δ}) ∧ {patterns: ε}) ∧ {subst: ζ})

:ctml-parse-only // FIXME: Term equality has no inferred type.
/** Accumulate substitutions, verifying each repeated pat variable. */
fun unify(task) = if task is
  UnifyTerm(term, pat, subst) then
    if pat is Var(id) and find(id, subst) is [found, value] then
      if found then [equal(EqualTerms(term, value)), subst]
      else [true, LCons([id, term], subst)]
    else if term is Fun(f, xs, _) and pat is Fun(g, ys, _) then
      if f === g then unify(UnifyArguments(xs, ys, subst)) else [false, LNil()]
    else [false, LNil()]
  UnifyArguments(xs, ys, subst) then
    if xs is LNil() and ys is LNil() then [true, subst]
    else if xs is LCons(x, xt) and ys is LCons(y, yt) then
      if unify(UnifyTerm(x, y, subst)) is [headOk, headSubst] then
        // The source walks the tail even when unifying the heads fails.
        if unify(UnifyArguments(xt, yt, headSubst)) is [tailOk, tailSubst] then
          [headOk && tailOk, tailSubst]
    else [false, LNil()]
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Substitution lookup exceeds the solver budget.
/** Replace bound variables, leaving application symbols and lemma handles intact. */
fun applySubst(subst, term) = if term is
  Var(id) then
    if find(id, subst) is [found, value] then
      if found then value else Var(id)
  Fun(f, args, lemmas) then Fun(f, map(x => applySubst(subst, x), args), lemmas)
//│ CTML translation succeeded.

/** Rewrite a term from the bottom up. */
data class RewriteTerm(term)
/** Try a strict list of rewrite rules in order. */
data class RewriteWithLemmas(term, lemmas)
//│ RewriteTerm: ∀α. α → (RewriteTerm ∧ {term: α})
//│ RewriteWithLemmas: ∀β, γ. β → γ → ((RewriteWithLemmas ∧ {term: β}) ∧ {lemmas: γ})

:ctml-parse-only // FIXME: Unification and substitution have no inferred types.
/** Rewrite arguments, then repeat from the first lemma that applies. */
fun rewrite(task) = if task is
  RewriteTerm(term) then
    if term is
      Var(id) then Var(id)
      Fun(f, args, lemmas) then
        let rewritten = Fun(f, map(x => rewrite(RewriteTerm(x)), args), lemmas)
        rewrite(RewriteWithLemmas(rewritten, force(lemmas)))
  RewriteWithLemmas(term, lemmas) then
    if lemmas is
      LNil() then term
      LCons([lhs, rhs], rest) then
        if unify(UnifyTerm(term, lhs, LNil())) is [unified, subst] then
          if unified then rewrite(RewriteTerm(applySubst(subst, rhs)))
          else rewrite(RewriteWithLemmas(term, rest))
//│ CTML translation succeeded.

