:ctml-parse-only // FIXME: Recursive index insertion exceeds the solver budget.
/** Insert a rule ahead of existing rules with the same key. */
fun addToLUT(key, rule, lut) = if lut is
  Empty() then Node(Empty(), key, LCons(rule, LNil()), Empty())
  Node(left, k, rules, right) then
    if
      listEq(key, k) then Node(left, k, LCons(rule, rules), right)
      nameLt(key, k) then Node(addToLUT(key, rule, left), k, rules, right)
      else Node(left, k, rules, addToLUT(key, rule, right))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Recursive index lookup exceeds the solver budget.
/** Find the rules indexed by a function's name. */
fun getLUT(key, lut) = if lut is
  Empty() then LNil()
  Node(left, k, rules, right) then
    if
      listEq(key, k) then rules
      nameLt(key, k) then getLUT(key, left)
      else getLUT(key, right)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The token and Lisp parsers have no inferred types.
/** Parse each source rule. */
fun makeLemmas(rules) = if rules is
  LNil() then LNil()
  LCons(h, t) then LCons(mkLispList(strToToken(h)), makeLemmas(t))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Index insertion has no inferred type.
/** Index an equality rule by its left-hand function, preserving the invalid-rule error. */
fun addLemma(rule, lut) = if rule is
  Nill() then lut
  Atom(_) then raiseError("error")
  Conss(x, y) then
    let lhs = car(y)
    if listEq(tv(x), nofibStringToList("equal")) and not(atom(lhs)) then
      addToLUT(tv(car(lhs)), Conss(x, y), lut)
    else raiseError("error")
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Rule insertion has no inferred type.
/** Add rules in source order, prepending each to its matching bucket. */
fun addLemmaList(rules, lut) = if rules is
  LNil() then lut
  LCons(h, t) then addLemmaList(t, addLemma(h, lut))
//│ CTML translation succeeded.

/** Substitute into a single term. */
data class SubstituteTerm(term)
/** Substitute into the arguments of an application. */
data class SubstituteArgs(args)
//│ SubstituteTerm: ∀α. α → (SubstituteTerm ∧ {term: α})
//│ SubstituteArgs: ∀β. β → (SubstituteArgs ∧ {args: β})

:ctml-parse-only // FIXME: Substitution lookup has no inferred type.
/** Replace variables while leaving the operator of each application intact. */
fun applySubst(subst, task) = if task is
  SubstituteTerm(term) then
    if term is
      Nill() then Nill()
      Atom(name) then
        if assoc(Atom(name), subst) is Conss(_, value) then value else Atom(name)
      Conss(op, args) then Conss(op, applySubst(subst, SubstituteArgs(args)))
  SubstituteArgs(args) then
    if args is
      Nill() then Nill()
      Atom(_) then raiseError("error")
      Conss(h, t) then
        Conss(applySubst(subst, SubstituteTerm(h)), applySubst(subst, SubstituteArgs(t)))
//│ CTML translation succeeded.

/** Unify a term against a pattern. */
data class UnifyTerm(term, pat, subst)
/** Unify corresponding arguments from two Lisp lists. */
data class UnifyArgs(terms, patterns, subst)
//│ UnifyTerm: ∀α, β, γ. α → β → γ → (((UnifyTerm ∧ {term: α}) ∧ {pat: β}) ∧ {subst: γ})
//│ UnifyArgs: ∀δ, ε, ζ. δ → ε → ζ → (((UnifyArgs ∧ {terms: δ}) ∧ {patterns: ε}) ∧ {subst: ζ})

:ctml-parse-only // FIXME: Lisp equality and association lookup have no inferred types.
/** Match a pattern and carry the substitutions accumulated before any failure. */
fun unify(task) = if task is
  UnifyTerm(term, pat, subst) then
    if
      atom(pat) then
        if assoc(pat, subst) is Conss(_, value) then [lispListEq(term, value), subst]
        else [true, Conss(Conss(pat, term), subst)]
      atom(term) then [false, subst]
      lispListEq(car(term), car(pat)) then
        unify(UnifyArgs(cdr(term), cdr(pat), subst))
      else [false, subst]
  UnifyArgs(terms, patterns, subst) then
    if terms is Nill() then [true, subst]
    else if unify(UnifyTerm(car(terms), car(patterns), subst)) is [ok, next] then
      if ok then unify(UnifyArgs(cdr(terms), cdr(patterns), next)) else [false, next]
//│ CTML translation succeeded.

/** Rewrite one Lisp term. */
data class RewriteTerm(term)
/** Rewrite the arguments of a Lisp application. */
data class RewriteArgs(args)
/** Try a strict list of lemmas against a term. */
data class RewriteWithLemmas(term, rules)
//│ RewriteTerm: ∀α. α → (RewriteTerm ∧ {term: α})
//│ RewriteArgs: ∀β. β → (RewriteArgs ∧ {args: β})
//│ RewriteWithLemmas: ∀γ, δ. γ → δ → ((RewriteWithLemmas ∧ {term: γ}) ∧ {rules: δ})

:ctml-parse-only // FIXME: Unification, substitution, and lookup have no inferred types.
/** Rewrite arguments first and use the index to find candidate rules for the operator. */
fun rewrite(lut, task) = if task is
  RewriteTerm(term) then
    if term is
      Nill() then Nill()
      Atom(name) then Atom(name)
      Conss(op, args) then
        let rewritten = Conss(op, rewrite(lut, RewriteArgs(args)))
        rewrite(lut, RewriteWithLemmas(rewritten, getLUT(tv(op), lut)))
  RewriteArgs(args) then
    if args is
      Nill() then Nill()
      Atom(_) then raiseError("error")
      Conss(h, t) then Conss(rewrite(lut, RewriteTerm(h)), rewrite(lut, RewriteArgs(t)))
  RewriteWithLemmas(term, rules) then
    if rules is
      LNil() then term
      LCons(rule, rest) then
        if unify(UnifyTerm(term, cadr(rule), Nill())) is [ok, subst] then
          if ok then rewrite(lut, RewriteTerm(applySubst(subst, SubstituteTerm(caddr(rule)))))
          else rewrite(lut, RewriteWithLemmas(term, rest))
//│ CTML translation succeeded.

