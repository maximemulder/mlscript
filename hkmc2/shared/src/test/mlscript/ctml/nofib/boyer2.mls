/** Recognize a one-element Lisp list with the specified single-character atom. */
fun isTruthConstant(term, name) = if term is
  Conss(Atom(LCons(c, LNil())), Nill()) then c === name
  else false
//│ isTruthConstant: ∀α. α → ⊤ → (({α ≤ (Conss ∧ {hd: Atom ∧ {chars: (LCons ∧ {head: ⊤}) ∧ {tail: LNil}}}) ∧ {tl: Nill}} ⟹ Bool) ∧ ({α ≤ ¬((Conss ∧ {hd: Atom ∧ {chars: (LCons ∧ {head: ⊤}) ∧ {tail: LNil}}}) ∧ {tl: Nill})} ⟹ Bool))

/** Recognize the conditional symbol. */
fun isIf(term) = if term is
  Atom(LCons(i, LCons(f, LNil()))) then if i === "i" then f === "f" else false
  else false
//│ isIf: ∀α. α → (({α ≤ Atom ∧ {chars: (LCons ∧ {head: ⊤}) ∧ {tail: (LCons ∧ {head: ⊤}) ∧ {tail: LNil}}}} ⟹ Bool) ∧ ({α ≤ ¬(Atom ∧ {chars: (LCons ∧ {head: ⊤}) ∧ {tail: (LCons ∧ {head: ⊤}) ∧ {tail: LNil}}})} ⟹ Bool))

isTruthConstant(Conss(Atom(LCons("t", LNil())), Nill()), "t") as Bool
isIf(Atom(LCons("i", LCons("f", LNil())))) as Bool
//│ Bool
