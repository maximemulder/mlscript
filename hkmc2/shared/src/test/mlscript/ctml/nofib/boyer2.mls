/** Spell the substitution with the input-indexed name in both source positions. */
fun subtermSource(i) =
  let c = "c" ++ stringOfInt(i)
  "( ( x f ( plus ( plus a b )( plus " ++ c ++
    " ( zero ) ) ) )( y f ( times ( times a b )( plus " ++ c ++
    " d ) ) )( z f ( reverse ( append ( append a b ) ( [] ) ) ) )" ++
    "(u equal ( plus a b ) ( difference x y ) )(w lessp ( remainder a b )" ++
    "( member a ( length b ) ) ) )"
//│ subtermSource: Int → Str

