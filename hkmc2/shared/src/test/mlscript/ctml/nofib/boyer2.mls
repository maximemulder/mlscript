:ctml-parse-only // FIXME: Lisp membership has no inferred type.
/** Check a truth constant and then the current true assumptions. */
fun truep(term, known) = if term is
  Nill() then false
  else if isTruthConstant(term, "t") then true else lispmember(term, known)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Lisp membership has no inferred type.
/** Check a falsehood constant and then the current false assumptions. */
fun falsep(term, known) = if term is
  Nill() then false
  else if isTruthConstant(term, "f") then true else lispmember(term, known)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The truth tests have no inferred types.
/** Evaluate the conditional tree under the two sets of assumptions. */
fun tautologyp(term, trueTerms, falseTerms) = if term is
  Nill() then false
  Atom(name) then truep(Atom(name), trueTerms)
  Conss(op, args) then
    if
      truep(Conss(op, args), trueTerms) then true
      falsep(Conss(op, args), falseTerms) then false
      isIf(op) then
        if
          truep(car(args), trueTerms) then tautologyp(cadr(args), trueTerms, falseTerms)
          falsep(car(args), falseTerms) then tautologyp(caddr(args), trueTerms, falseTerms)
          else
            if tautologyp(cadr(args), Conss(car(args), trueTerms), falseTerms) then
              tautologyp(caddr(args), trueTerms, Conss(car(args), falseTerms))
            else false
      else false
//│ CTML translation succeeded.

/** Recognize any of the source token delimiters. */
fun isDelimiter(c) = (c === "(") || (c === ")") || (c === " ")
//│ isDelimiter: ⊤ → Bool

isDelimiter("(") as Bool
isDelimiter(" ") as Bool
//│ Bool
//│ Bool

:ctml-parse-only // FIXME: Character traversal exceeds the solver budget.
/** Collect the rest of a token, leaving its delimiter in the input. */
fun restOfToken(input) = if input is
  LNil() then [LNil(), LNil()]
  LCons(h, t) then
    if isDelimiter(h) then [LNil(), LCons(h, t)]
    else if restOfToken(t) is [a, b] then [LCons(h, a), b]
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Token-suffix traversal has no inferred type.
/** Skip spaces and read one token, emitting parentheses as individual tokens. */
fun getToken(input) = if input is
  LNil() then [LNil(), LNil()]
  LCons(h, t) then
    if
      h === " " then getToken(t)
      (h === "(") || (h === ")") then [LCons(h, LNil()), t]
      restOfToken(t) is [a, b] then [LCons(h, a), b]
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Token extraction has no inferred type.
/** Tokenize the source Lisp expression. */
fun strToToken(input) = if input is
  LNil() then LNil()
  else if getToken(input) is [a, b] then LCons(a, strToToken(b))
//│ CTML translation succeeded.

/** Recognize a token consisting only of the given delimiter. */
fun isToken(c, token) = if token is
  LCons(h, LNil()) then h === c
  else false
//│ isToken: ∀α. ⊤ → α → (({α ≤ (LCons ∧ {head: ⊤}) ∧ {tail: LNil}} ⟹ Bool) ∧ ({α ≤ ¬((LCons ∧ {head: ⊤}) ∧ {tail: LNil})} ⟹ Bool))

isToken("(", LCons("(", LNil())) as Bool
isToken("(", LCons("(", LCons("x", LNil()))) as Bool
//│ Bool
//│ Bool

