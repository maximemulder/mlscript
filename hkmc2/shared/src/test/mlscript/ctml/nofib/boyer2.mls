:ctml-parse-only // FIXME: Equality on Lisp cells exceeds the solver budget.
/** Compare Lisp cells recursively and atom names elementwise. */
fun lispListEq(x, y) = if
  x is Nill() and y is Nill() then true
  x is Atom(a) and y is Atom(b) then listEq(a, b)
  x is Conss(a, b) and y is Conss(c, d) and lispListEq(a, c) then lispListEq(b, d)
  else false
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Lisp equality has no inferred type.
/** Test whether a Lisp cell occurs in a list of assumptions. */
fun lispmember(term, terms) = if terms is
  Conss(x, xs) then
    if lispListEq(term, x) then true else lispmember(term, xs)
  else false
//│ CTML translation succeeded.

