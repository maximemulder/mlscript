/** Parse a Lisp list until its closing token or the end of the input. */
fun sublist(tokens) = if tokens is
  LNil() then [LNil(), Nill()]
  LCons(h, t) then
    if
      isToken("(", h) then
        if sublist(t) is [r1, l1] and sublist(r1) is [r2, l2] then [r2, Conss(l1, l2)]
      isToken(")", h) then [t, Nill()]
      else if sublist(t) is [rest, terms] then [rest, Conss(Atom(h), terms)]
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Sublist parsing has no inferred type.
/** Parse one Lisp list and require its parser to consume the remaining tokens. */
fun mkLispList(tokens) = if tokens is
  LCons(h, rest) and isToken("(", h) then
    if sublist(rest) is [LNil(), terms] then terms else Nill()
  else Nill()
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Lisp equality has no inferred type.
/** Look up an atom, stopping at the first malformed association entry. */
fun assoc(term, subst) = if subst is
  Conss(x, rest) then
    if x is Conss(Atom(key), _) then
      if lispListEq(term, Atom(key)) then x else assoc(term, rest)
    else Nill()
  else Nill()
//│ CTML translation succeeded.

/** An empty rule index. */
data class Empty()
/** An index node whose key is the atom name at the head of a rule. */
data class Node(left, key: Chars, rules, right)
//│ Empty: Unit → Empty
//│ Node: ∀α, β, γ, δ. {β ≤ Chars} ⟹ α → β → γ → δ → ((((Node ∧ {left: α}) ∧ {key: β}) ∧ {rules: γ}) ∧ {right: δ})

/** Compare atom names in the source's UTF-16 code-unit order. */
fun nameLt(a, b) = ltList(a, b, strLt, (x, y) => strLt(y, x))
//│ nameLt: ∀α, β. {β ≤ Str, α ≤ Str} ⟹ (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X) → (∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Y})} ⟹ Y) → Bool

Node(Empty(), LCons("x", LNil()), LCons(Nill(), LNil()), Empty()) as
  (Node & {left: Empty} & {key: Chars} & {rules: LCons} & {right: Empty})
//│ (((Node ∧ {left: Empty}) ∧ {key: Chars}) ∧ {rules: LCons}) ∧ {right: Empty}

ltList(LCons("a", LNil()), LCons("b", LNil()), strLt, (x, y) => strLt(y, x)) as Bool
//│ Bool

nameLt(LCons("a", LNil()), LCons("b", LNil())) as Bool
//│ Bool

