// Source: hkmc2/shared/src/test/mlscript-compile/nofib/boyer2.mls.
// Lisp cons cells are distinct from the strict lists of character codes, tokens, and rules.
// The lookup tree stores branches and entries in separate fields. Tagged dispatchers retain
// the mutually recursive calls in substitution, unification, and rewriting.

/** A proper list of source string code units. */
type Chars = [X restricts (LNil | (LCons & {head: Str} & {tail: X}))] -> X
//│ Chars = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: X})} ⟹ X

/** The empty Lisp list. */
data class Nill()
/** A Lisp atom with a character-list name. */
data class Atom(chars: Chars)
/** A Lisp cons cell. Its tail can itself be an atom in a substitution. */
data class Conss(hd, tl)
//│ Nill: Unit → Nill
//│ Atom: ∀α. {α ≤ Chars} ⟹ α → (Atom ∧ {chars: α})
//│ Conss: ∀β, γ. β → γ → ((Conss ∧ {hd: β}) ∧ {tl: γ})

/** Return an atom's character-list name. */
fun tv(term) = if term is Atom(chars) then chars
//│ tv: ∀α. ({chars: α} ∧ Atom) → α

/** Recognize a Lisp atom. */
fun atom(term) = if term is Atom(_) then true else false
//│ atom: ∀α. α → (({α ≤ Atom ∧ {chars: ⊤}} ⟹ Bool) ∧ ({α ≤ ¬(Atom ∧ {chars: ⊤})} ⟹ Bool))

/** Return a Lisp cell's head or the empty Lisp list. */
fun car(term) = if term is Conss(x, _) then x else Nill()
//│ car: ∀α, β. {β ≥ ({α ≤ ({hd: β} ∧ Conss) ∧ {tl: ⊤}} ⟹ ⊥) ∧ ({α ≤ ¬((Conss ∧ {hd: ⊤}) ∧ {tl: ⊤})} ⟹ Nill), α ≤ (({hd: β} ∧ Conss) ∧ {tl: ⊤}) ∨ ¬({β ≥ Nill} ⟹ (Conss ∧ {hd: ⊤}) ∧ {tl: ⊤})} ⟹ α → β

/** Return a Lisp cell's tail or the empty Lisp list. */
fun cdr(term) = if term is Conss(_, y) then y else Nill()
//│ cdr: ∀α, β. {β ≥ ({α ≤ ({tl: β} ∧ Conss) ∧ {hd: ⊤}} ⟹ ⊥) ∧ ({α ≤ ¬((Conss ∧ {hd: ⊤}) ∧ {tl: ⊤})} ⟹ Nill), α ≤ (({tl: β} ∧ Conss) ∧ {hd: ⊤}) ∨ ¬({β ≥ Nill} ⟹ (Conss ∧ {hd: ⊤}) ∧ {tl: ⊤})} ⟹ α → β

