:ctml-parse-only // FIXME: Inferring the complete rule list exceeds the solver budget.
/** The benchmark's rewrite rules in source order. */
val rules =
  let rule1 = nofibStringToList("(equal (compile form)(reverse (codegen (optimize form) (Nill) ) ) )")
  let rule2 = nofibStringToList("(equal (eqp x y)(equal (fix x)(fix y) ) )")
  let rule3 = nofibStringToList("(equal (greaterp x y)(lessp y x) )")
  let rule4 = nofibStringToList("(equal (lesseqp x y)(not (lessp y x) ) )")
  let rule5 = nofibStringToList("(equal (greatereqp x y)(not (lessp y x) ) )")
  let rule6 = nofibStringToList("(equal (boolean x)(or (equal x (t) )(equal x (f) ) )")
