/** Count the rows in the picture. */
fun height(p) = listLen(p)
//│ height: (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: ⊤}) ∧ {tail: X})} ⟹ X) → Int

/** Count the columns in the first row of a nonempty picture. */
fun width(p) = listLen(head(p))
//│ width: (({tail: ⊤} ∧ {head: ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: ⊤}) ∧ {tail: X})} ⟹ X}) ∧ LCons) → Int

/** A nonempty two-row picture for the dimension checks. */
val picture = LCons(LCons("a", LCons("b", LNil())), LCons(LCons("c", LCons("d", LNil())), LNil()))
//│ picture: (LCons ∧ {head: (LCons ∧ {head: Str}) ∧ {tail: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}) ∧ {tail: (LCons ∧ {head: (LCons ∧ {head: Str}) ∧ {tail: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}) ∧ {tail: LNil}}

