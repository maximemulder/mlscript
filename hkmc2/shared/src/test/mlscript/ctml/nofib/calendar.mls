/** Produce a row of n spaces. */
fun space(n) = replicate(n, " ")
//│ space: Int → (((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ ((LCons ∧ {head: Str}) ∧ {tail: α}) ∨ LNil} ⟹ α}) ∨ LNil)

/** Pad a row with spaces on the right. */
fun ljustify(n, s) = append(s, space(n - listLen(s)))
//│ ljustify: ∀α, Z. {α ≥ Str, Z ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: Z})} ⟹ Int → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X) → Z

/** Pad a row with spaces on the left. */
fun rjustify(n, s) = append(space(n - listLen(s)), s)
//│ rjustify: ∀α, Z. {α ≥ Str, Z ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: Z})} ⟹ Int → (∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: Y})} ⟹ Y) → Z

/** Center a row, putting any odd extra space on the right. */
fun cjustify(n, s) =
  let m = n - listLen(s)
  let halfm = intDiv(m, 2)
  append(space(halfm), append(s, space(m - halfm)))
//│ cjustify: ∀α, Z. {α ≥ Str, Z ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: Z})} ⟹ Int → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X) → Z

