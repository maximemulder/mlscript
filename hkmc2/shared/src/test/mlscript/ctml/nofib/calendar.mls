// Source: hkmc2/shared/src/test/mlscript-compile/nofib/calendar.mls.
// Pictures are lists of character rows. Month triples use nested pairs.
// The source runtime reference renders the year 1993 for the adapted input 0.

/** Apply the Gregorian century and quadrennial leap-year rules. */
fun leap(year) = if
  intMod(year, 100) == 0 then intMod(year, 400) == 0
  else intMod(year, 4) == 0
//│ leap: Int → Bool

/** List the month lengths in order, with February set by the leap-year rule. */
fun monthLengths(year) =
  let feb = if leap(year) then 29 else 28
  let octToDec = LCons(31, LCons(30, LCons(31, LNil())))
  let julToDec = LCons(31, LCons(31, LCons(30, octToDec)))
  let aprToDec = LCons(30, LCons(31, LCons(30, julToDec)))
  LCons(31, LCons(feb, LCons(31, aprToDec)))
//│ monthLengths: Int → ((LCons ∧ {head: Int}) ∧ {tail: (LCons ∧ {head: Int}) ∧ {tail: (LCons ∧ {head: Int}) ∧ {tail: (LCons ∧ {head: Int}) ∧ {tail: (LCons ∧ {head: Int}) ∧ {tail: (LCons ∧ {head: Int}) ∧ {tail: (LCons ∧ {head: Int}) ∧ {tail: (LCons ∧ {head: Int}) ∧ {tail: (LCons ∧ {head: Int}) ∧ {tail: (LCons ∧ {head: Int}) ∧ {tail: (LCons ∧ {head: Int}) ∧ {tail: (LCons ∧ {head: Int}) ∧ {tail: LNil}}}}}}}}}}}})

/** Spell each month name as a list of characters. */
val monthNames =
  let january = nofibStringToList("January")
  let february = nofibStringToList("February")
  let march = nofibStringToList("March")
  let april = nofibStringToList("April")
  let may = nofibStringToList("May")
  let june = nofibStringToList("June")
  let july = nofibStringToList("July")
  let august = nofibStringToList("August")
  let september = nofibStringToList("September")
  let october = nofibStringToList("October")
  let november = nofibStringToList("November")
  let december = nofibStringToList("December")
  let octToDec = LCons(october, LCons(november, LCons(december, LNil())))
  let julToDec = LCons(july, LCons(august, LCons(september, octToDec)))
  let aprToDec = LCons(april, LCons(may, LCons(june, julToDec)))
  LCons(january, LCons(february, LCons(march, aprToDec)))
//│ monthNames: (LCons ∧ {head: LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α})} ⟹ α})}) ∧ {tail: (LCons ∧ {head: LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α})} ⟹ α})}) ∧ {tail: (LCons ∧ {head: LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α})} ⟹ α})}) ∧ {tail: (LCons ∧ {head: LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α})} ⟹ α})}) ∧ {tail: (LCons ∧ {head: LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α})} ⟹ α})}) ∧ {tail: (LCons ∧ {head: LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α})} ⟹ α})}) ∧ {tail: (LCons ∧ {head: LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α})} ⟹ α})}) ∧ {tail: (LCons ∧ {head: LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α})} ⟹ α})}) ∧ {tail: (LCons ∧ {head: LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α})} ⟹ α})}) ∧ {tail: (LCons ∧ {head: LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α})} ⟹ α})}) ∧ {tail: (LCons ∧ {head: LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α})} ⟹ α})}) ∧ {tail: (LCons ∧ {head: LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α})} ⟹ α})}) ∧ {tail: LNil}}}}}}}}}}}}

/** Compute the weekday of January 1, with Sunday represented by zero. */
fun jan1st(year) =
  let last = year - 1
  intMod(year + intDiv(last, 4) - intDiv(last, 100) + intDiv(last, 400), 7)
//│ jan1st: Int → Int

/** Keep the weekday for the first day of each of the twelve months. */
fun firstDays(year) =
  take(12, map(x => intMod(x, 7), scanl((a, b) => a + b, jan1st(year), monthLengths(year))))
//│ firstDays: ∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: Y})} ⟹ Int → Y

firstDays(1993) as (LNil | (LCons & {head: Int}))
//│ LNil ∨ (LCons ∧ {head: Int})

/** Construct a blank picture of the given height and width. */
fun emptyPic(hw) = if hw is [h, w] then replicate(h, replicate(w, " "))
//│ emptyPic: ⟨Int, Int⟩ → (((LCons ∧ {head: ((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ ((LCons ∧ {head: Str}) ∧ {tail: α}) ∨ LNil} ⟹ α}) ∨ LNil}) ∧ {tail: ∀α. {α ≥ ((LCons ∧ {head: ((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ ((LCons ∧ {head: Str}) ∧ {tail: α}) ∨ LNil} ⟹ α}) ∨ LNil}) ∧ {tail: α}) ∨ LNil} ⟹ α}) ∨ LNil)

leap(1900) as Bool
leap(2000) as Bool
jan1st(1993) as Int
monthLengths(2000).tail.head as Int
//│ Bool
//│ Bool
//│ Int
//│ Int

