/** Take the smaller value, treating a missing bound as y. */
fun minm(x, y) = if x is
  None() then y
  Some(value) then if value < y then value else y
//│ minm: ∀α, β, γ. {β ≤ ¬({α ≤ None} ⟹ ⊥) ∨ ¬({α ≤ {value: γ ∧ Int} ∧ Some} ⟹ ¬Int), α ≤ None ∨ ¬({β ≤ Int} ⟹ ¬({value: γ ∧ Int} ∧ Some)), γ ≥ ({α ≤ None} ⟹ β) ∧ ({β ≤ Int, α ≤ {value: γ ∧ Int} ∧ Some} ⟹ β)} ⟹ α → β → γ

/** Take the larger value, treating a missing bound as y. */
fun maxm(x, y) = if x is
  None() then y
  Some(value) then intMax(value, y)
//│ maxm: ∀α, β, γ. {β ≤ ¬({α ≤ None} ⟹ ⊥) ∨ ¬({α ≤ {value: γ ∧ Int} ∧ Some} ⟹ ¬Int), α ≤ None ∨ ¬({β ≤ Int} ⟹ ¬({value: γ ∧ Int} ∧ Some)), γ ≥ ({α ≤ None} ⟹ β) ∧ ({β ≤ Int, α ≤ {value: γ ∧ Int} ∧ Some} ⟹ β)} ⟹ α → β → γ

:ctml-parse-only // FIXME: Association lookup is translation-only.
/** Hash a keyword using its length and the values of its end characters. */
fun hash(cvs, k) = if k is K(_, a, z, n) then n + assoc(a, cvs) + assoc(z, cvs)
//│ CTML translation succeeded.

/** Prepend x to the matching partition. */
fun select(p, x, ts_fs) = if ts_fs is [ts, fs] then
  if p(x) then [LCons(x, ts), fs] else [ts, LCons(x, fs)]
//│ select: ∀α, β, γ. (α → Bool) → α → ⟨β, γ⟩ → (⟨(LCons ∧ {head: α}) ∧ {tail: β}, γ⟩ ∨ ⟨β, (LCons ∧ {head: α}) ∧ {tail: γ}⟩)

/** Partition a list while preserving order within each partition. */
fun partition_(p, ls) = foldr((x, y) => select(p, x, y), [LNil(), LNil()], ls)
//│ partition_: ∀α, β, γ. {γ ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: γ}), β ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: β})} ⟹ (α → Bool) → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X) → ((⟨(LCons ∧ {head: α}) ∧ {tail: β}, γ⟩ ∨ ⟨β, (LCons ∧ {head: α}) ∧ {tail: γ}⟩) ∨ ⟨LNil, LNil⟩)

/** Preserve the source benchmark's identity frequency ordering. */
fun freqsorted(x) = x
//│ freqsorted: ∀α. α → α

:ctml-parse-only // FIXME: The character union is translation-only.
/** Group keys whose end characters are already determined. */
fun blocked_(ds, ls) = if ls is
  LNil() then LNil()
  LCons(k, ks) then
    let ds_ = union(ds, ends(k))
    if partition_(x => subset(ends(x), ds_), ks) is [det, rest] then
      LCons(k, append(det, blocked_(ds_, rest)))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Recursive key grouping is translation-only.
/** Group keys with no characters determined initially. */
fun blocked(ls) = blocked_(LNil(), ls)
//│ CTML translation succeeded.

