:ctml-parse-only // FIXME: The frequency lookup is translation-only.
/** Compare the combined end-character frequencies of two keys. */
fun morefreq(k1, k2) = if k1 is K(_, a, x, _) and k2 is K(_, b, y, _) then
  freq(b) + freq(y) < freq(a) + freq(x)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Keyword attribution, grouping, and search are translation-only.
/** Build and group the source key list before searching. */
fun cichelli_(n) =
  let attribkeys_ = attribkeys(append(keys, take(intMod(n, 2), keys)))
  let hashkeys = blocked(freqsorted(attribkeys_))
  findhash(hashkeys)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The benchmark search is translation-only.
/** Run the search on the supplied input. */
fun prog(n) = cichelli_(n)
//│ CTML translation succeeded.

