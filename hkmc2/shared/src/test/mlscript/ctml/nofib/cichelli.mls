/** Attach the characters and length used for hashing each key. */
fun attribkeys(ks) = map(k => K(k, head(k), last(k), listLen(k)), ks)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The full keyword table is translation-only.
/** The number of keywords in the source table. */
val numberofkeys = listLen(keys)
