/** An unsuccessful search with its leaf count. */
data class NotEver(i: Int)
/** A successful search with its leaf count and result. */
data class YesIts(i: Int, t)
//│ NotEver: ∀α. {α ≤ Int} ⟹ α → (NotEver ∧ {i: α})
//│ YesIts: ∀β, γ. {β ≤ Int} ⟹ β → γ → ((YesIts ∧ {i: β}) ∧ {t: γ})

:ctml-parse-only // FIXME: The source keyword count is translation-only.
/** Insert h if it stays unique and the hash range still fits the keywords. */
fun hinsert(h, hh) = if hh is H(lo, hi, hs) then
  let lo_ = minm(lo, h)
  let hi_ = maxm(hi, h)
  if inList(h, hs) || numberofkeys < 1 + hi_ - lo_
  then None()
  else Some(H(Some(lo_), Some(hi_), LCons(h, hs)))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Recursion over delayed attempts exceeds the 20000-call budget.
/** Find the first success, adding the leaves visited in preceding attempts. */
fun first(k, ls) = if force(ls) is
  LzNil() then NotEver(k)
  LzCons(a, l) and a is
    YesIts(leaves, y) then YesIts(k + leaves, y)
    NotEver(leaves) then first(k + leaves, l)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The delayed first-success traversal is translation-only.
/** Map each attempt lazily and stop at the first success. */
fun firstSuccess(f, possibles) = first(0, mapLz(f, possibles))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Hash insertion, association lookup, and firstSuccess lack checked types.
/** Search for character assignments that give distinct, contiguous keyword hashes. */
fun findhash_(keyHashSet, charAssocs, ks) = if ks is
  LNil() then YesIts(1, charAssocs)
  LCons(K(s, a, z, n), rest) then
    /** Try the additional assignments and recurse if the new hash fits. */
    fun tryy(newAssocs) =
      let newCharAssocs = append(newAssocs, charAssocs)
      if hinsert(hash(newCharAssocs, K(s, a, z, n)), keyHashSet) is
        None() then NotEver(1)
        Some(newKeyHashSet) then findhash_(newKeyHashSet, newCharAssocs, rest)
    if [assocm(a, charAssocs), assocm(z, charAssocs)] is
      [None(), None()] and
        a === z then firstSuccess(m => tryy(LCons([a, m], LNil())), enumFromToLz(0, maxval))
        else
          /** Enumerate the outer character values in ascending order. */
          fun lscomp1(ls1) = delay(() =>
            if force(ls1) is
              LzNil() then LzNil()
              LzCons(m, ms) then
                /** Enumerate the inner values and advance the outer stream on exhaustion. */
                fun lscomp2(ls2) = if force(ls2) is
                  LzNil() then lscomp1(ms)
                  LzCons(n, ns) then delay(() => LzCons([m, n], lscomp2(ns)))
                force(lscomp2(enumFromToLz(0, maxval)))
          )
          firstSuccess(
            pair => if pair is [m, n] then tryy(LCons([a, m], LCons([z, n], LNil()))),
            lscomp1(enumFromToLz(0, maxval))
          )
      [None(), Some(_)] then firstSuccess(m => tryy(LCons([a, m], LNil())), enumFromToLz(0, maxval))
      [Some(_), None()] then firstSuccess(n => tryy(LCons([z, n], LNil())), enumFromToLz(0, maxval))
      [Some(_), Some(_)] then tryy(LNil())
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The recursive hash search is translation-only.
/** Search without any initial hashes or character assignments. */
fun findhash(keys) = findhash_(H(None(), None(), LNil()), LNil(), keys)
//│ CTML translation succeeded.

