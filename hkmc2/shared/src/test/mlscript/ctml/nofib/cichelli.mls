/** Increment an existing histogram entry or append a new one. */
fun histins(x, yns) = if yns is
  LCons([y, n], rest) then
    if x === y then LCons([y, n + 1], rest) else LCons([y, n], histins(x, rest))
  else LCons([x, 1], LNil())
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Histogram insertion is translation-only.
/** Count occurrences with the source right fold. */
fun histo(ls) = foldr(histins, LNil(), ls)
//│ CTML translation succeeded.

/** Test whether every element of xs is in ys. */
fun subset(xs, ys) = all(x => inList(x, ys), xs)
//│ subset: ∀α. (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X) → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: ⊤}) ∧ {tail: X})} ⟹ X) → Bool

:ctml-parse-only // FIXME: The list of new members exceeds the 20000-call solver budget.
/** Append the members of ys that do not occur in xs. */
fun union(xs, ys) =
  /** Collect the elements of ys absent from xs, in order. */
  fun lscomp(ls) = if ls is
    LNil() then LNil()
    LCons(h, t) then if inList(h, xs) then lscomp(t) else LCons(h, lscomp(t))
  append(xs, lscomp(ys))
//│ CTML translation succeeded.

