/** Produce a delayed integer range including both endpoints. */
fun enumFromToLz(a, b) = delay(() =>
  if a <= b then LzCons(a, enumFromToLz(a + 1, b)) else LzNil()
)
//│ enumFromToLz: ∀α. {α ≥ Delayed ∧ {resume: Unit → (LzNil ∨ ((LzCons ∧ {head: Int}) ∧ {tail: α}))}} ⟹ Int → Int → (Delayed ∧ {resume: Unit → (LzNil ∨ ((LzCons ∧ {head: Int}) ∧ {tail: α}))})

:ctml-parse-only // FIXME: Recursive list inference exceeds the 20000-call solver budget.
/** Return the last element, raising the source error on an empty list. */
fun last(ls) =
  /** Walk the remaining cells with the most recent head. */
  fun go(h, t) = if t is
    LNil() then h
    LCons(next, rest) then go(next, rest)
  if ls is LCons(h, t) then go(h, t) else raiseError("last: empty list")
//│ CTML translation succeeded.

/** A recursively proper list of string code units. */
type Chars = [X restricts (LNil | (LCons & {head: Str} & {tail: X}))] -> X
//│ Chars = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: X})} ⟹ X

/** A recursively proper list of hash values. */
type Hashes = [X restricts (LNil | (LCons & {head: Int} & {tail: X}))] -> X
//│ Hashes = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X

/** A keyword, its first and last characters, and its length. */
data class K(s: Chars, c1: Str, c2: Str, i: Int)
/** A present value. */
data class Some(value)
/** A missing value. */
data class None()
//│ K: ∀α, β, γ, δ. {β ≤ Str, δ ≤ Int, γ ≤ Str, α ≤ Chars} ⟹ α → β → γ → δ → ((((K ∧ {s: α}) ∧ {c1: β}) ∧ {c2: γ}) ∧ {i: δ})
//│ Some: ∀ε. ε → (Some ∧ {value: ε})
//│ None: Unit → None

/** An optional integer bound on the hashes. */
type Bound = None | (Some & {value: Int})
//│ Bound = None ∨ (Some ∧ {value: Int})

/** The minimum, maximum, and set of hashes already assigned. */
data class H(f: Bound, s: Bound, ls: Hashes)
//│ H: ∀α, β, γ. {β ≤ Bound, γ ≤ Hashes, α ≤ Bound} ⟹ α → β → γ → (((H ∧ {f: α}) ∧ {s: β}) ∧ {ls: γ})

/** Produce the first and last characters in order, including duplicates. */
fun ends(k) = if k is K(_, a, z, _) then LCons(a, LCons(z, LNil()))
//│ ends: ∀α, β. (((({c2: β} ∧ {c1: α}) ∧ K) ∧ {s: ⊤}) ∧ {i: ⊤}) → ((LCons ∧ {head: α}) ∧ {tail: (LCons ∧ {head: β}) ∧ {tail: LNil}})

