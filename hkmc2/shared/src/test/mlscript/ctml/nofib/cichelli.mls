/** Find the value paired with x or raise the source error. */
fun assoc(x, yz) = if yz is
  LCons([y, z], yzs) then if x === y then z else assoc(x, yzs)
  else raiseError("assoc: not found")
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Recursive optional lookup exceeds the 20000-call solver budget.
/** Find the value paired with x and return an option. */
fun assocm(x, yz) = if yz is
  LCons([y, z], yzs) then if x === y then Some(z) else assocm(x, yzs)
  else None()
//│ CTML translation succeeded.

