/** Replace only the input ports. */
fun updateInports(p, ninports) = PS(pid(p), compType(p), pathDepth(p), ninports, outports(p))
//│ CTML translation succeeded.

/** Split a nonempty list recursively into a balanced sweep tree. */
fun put(xs) = if
  xs is LCons(x, LNil()) then Cell(x)
  splitAt(intDiv(listLen(xs), 2), xs) is [fstHalf, sndHalf] then
    Node(TreeUnit(), put(fstHalf), put(sndHalf))
//│ put: ∀α. (({head: α} ∧ LCons) ∧ {tail: LNil}) → (Cell ∧ {value: α})

:ctml-parse-only // FIXME: Inference exceeds the 20000-call solver budget.
/** Extract leaves in left-to-right order. */
fun get(t) = if t is
  Cell(x) then LCons(x, LNil())
  Node(_, l, r) then append(get(l), get(r))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds the 20000-call solver budget.
/** Combine sibling results upward while storing their separate values in the tree. */
fun upsweep(f, t) = if t is
  Cell(a) then [a, Cell(a)]
  Node(_, l, r) and upsweep(f, l) is [lv, lt] and upsweep(f, r) is [rv, rt] then
    [f(lv, rv), Node([lv, rv], lt, rt)]
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds the 20000-call solver budget.
/** Distribute accumulated values downward using the stored sibling results. */
fun downsweep(g, d, t) = if t is
  Cell(_) then Cell(d)
  Node([lv, rv], l, r) and g(lv, rv, d) is [dl, dr] then
    Node(TreeUnit(), downsweep(g, dl, l), downsweep(g, dr, r))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The tree sweeps are translation-only.
/** Return the upward result and the downward tree. */
fun sweep_ud(up, down, u, t) = if upsweep(up, t) is [ans, ut] then
  [ans, downsweep(down, u, ut)]
//│ CTML translation succeeded.

