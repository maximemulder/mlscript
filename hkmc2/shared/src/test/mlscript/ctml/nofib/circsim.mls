/** Make a packet of span one for every well-shaped output port. */
fun make_packet(state) =
  /** Copy routing fields from the ports into the packets. */
  fun lscomp(ls) = if ls is
    LNil() then LNil()
    LCons(h, t) and
      h is [p, [m, [ql, [dl, [qr, dr]]]]] then
        LCons([pid(state), [p, [m, [ql, [dl, [qr, [dr, 1]]]]]]], lscomp(t))
      else lscomp(t)
  lscomp(outports(state))
//│ CTML translation succeeded.

/** Update an input port if the sender and port identifiers match. */
fun compare_and_update(ipm, pid_port_m) = if
  ipm is [i, [p, m_]] and pid_port_m is [pid_, [port, m]] then
    if eqTup2([i, p], [pid_, port]) then [pid_, [port, m_]]
    else [pid_, [port, m]]
//│ compare_and_update: ∀α, β, γ, δ. ⟨⊤, ⟨⊤, α⟩⟩ → ⟨β, ⟨γ, δ⟩⟩ → (⟨β, ⟨γ, α⟩⟩ ∨ ⟨β, ⟨γ, δ⟩⟩)

/** Deliver a packet's signal to the matching input ports. */
fun up_i(ipm, ins) = if ipm is [i, [p, [m, [_, [_, [_, [_, _]]]]]]] then
  map(x => compare_and_update([i, [p, m]], x), ins)
//│ up_i: ∀α, β, γ, δ, ε, Y. {β ≤ ⟨γ, ⟨δ, ε⟩⟩, Y ≥ LNil ∨ ((LCons ∧ {head: ⟨γ, ⟨δ, α⟩⟩ ∨ ⟨γ, ⟨δ, ε⟩⟩}) ∧ {tail: Y})} ⟹ ⟨⊤, ⟨⊤, ⟨α, ⟨⊤, ⟨⊤, ⟨⊤, ⟨⊤, ⊤⟩⟩⟩⟩⟩⟩⟩ → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: X})} ⟹ X) → Y

/** Deliver the packet from the right first, then the packet from the left. */
fun update_i(lr, ins) = if lr is [l, r] then up_i(l, up_i(r, ins))
//│ update_i: ∀α, β, γ, δ, ε, ζ, Y. {γ ≤ ⟨δ, ⟨ε, ζ⟩⟩, Y ≥ LNil ∨ ((LCons ∧ {head: ⟨δ, ⟨ε, α⟩⟩ ∨ ⟨δ, ⟨ε, ζ ∨ β⟩⟩}) ∧ {tail: Y})} ⟹ ⟨⟨⊤, ⟨⊤, ⟨α, ⟨⊤, ⟨⊤, ⟨⊤, ⟨⊤, ⊤⟩⟩⟩⟩⟩⟩⟩, ⟨⊤, ⟨⊤, ⟨β, ⟨⊤, ⟨⊤, ⟨⊤, ⟨⊤, ⊤⟩⟩⟩⟩⟩⟩⟩⟩ → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: X})} ⟹ X) → Y

/** Clear the output's right request when the packet from the left is done. */
fun check_left(a, b) = if
  a is [pid_, [port, [pm, [pql, [pdl, [pqr, [pdr, e]]]]]]] and b is [p, [m, [ql, [dl, [qr, dr]]]]] then
    if pqr && (0 < pdr) then [p, [m, [ql, [dl, [qr, dr]]]]]
    else [p, [m, [ql, [dl, [false, dr]]]]]
//│ check_left: ∀α, β, γ, δ, ε, ζ. ⟨⊤, ⟨⊤, ⟨⊤, ⟨⊤, ⟨⊤, ⟨Bool, ⟨Int, ⊤⟩⟩⟩⟩⟩⟩⟩ → ⟨α, ⟨β, ⟨γ, ⟨δ, ⟨ε, ζ⟩⟩⟩⟩⟩ → (⟨α, ⟨β, ⟨γ, ⟨δ, ⟨ε, ζ⟩⟩⟩⟩⟩ ∨ ⟨α, ⟨β, ⟨γ, ⟨δ, ⟨Bool, ζ⟩⟩⟩⟩⟩)

/** Clear the output's left request when the packet from the right is done. */
fun check_right(a, b) = if
  a is [pid_, [port, [pm, [pql, [pdl, [pqr, [pdr, e]]]]]]] and b is [p, [m, [ql, [dl, [qr, dr]]]]] then
    if pql && (0 < pdl) then [p, [m, [ql, [dl, [qr, dr]]]]]
    else [p, [m, [false, [dl, [qr, dr]]]]]
//│ check_right: ∀α, β, γ, δ, ε, ζ. ⟨⊤, ⟨⊤, ⟨⊤, ⟨Bool, ⟨Int, ⟨⊤, ⟨⊤, ⊤⟩⟩⟩⟩⟩⟩⟩ → ⟨α, ⟨β, ⟨γ, ⟨δ, ⟨ε, ζ⟩⟩⟩⟩⟩ → (⟨α, ⟨β, ⟨γ, ⟨δ, ⟨ε, ζ⟩⟩⟩⟩⟩ ∨ ⟨α, ⟨β, ⟨Bool, ⟨δ, ⟨ε, ζ⟩⟩⟩⟩⟩)

/** Update output requests in the source order, checking the right packet first. */
fun update_o(lprp, out_) = if lprp is [lp, rp] then check_left(lp, check_right(rp, out_))
//│ update_o: ∀α, β, γ, δ, ε, ζ. ⟨⟨⊤, ⟨⊤, ⟨⊤, ⟨⊤, ⟨⊤, ⟨Bool, ⟨Int, ⊤⟩⟩⟩⟩⟩⟩⟩, ⟨⊤, ⟨⊤, ⟨⊤, ⟨Bool, ⟨Int, ⟨⊤, ⟨⊤, ⊤⟩⟩⟩⟩⟩⟩⟩⟩ → ⟨α, ⟨β, ⟨γ, ⟨δ, ⟨ε, ζ⟩⟩⟩⟩⟩ → (⟨α, ⟨β, ⟨γ ∨ Bool, ⟨δ, ⟨ε, ζ⟩⟩⟩⟩⟩ ∨ ⟨α, ⟨β, ⟨γ ∨ Bool, ⟨δ, ⟨Bool, ζ⟩⟩⟩⟩⟩)

:ctml-parse-only // FIXME: The port updates are translation-only.
/** Deliver all incoming packets and update output requests at the current depth. */
fun update_io(d, lrps, state) =
  /** Fold deliveries into the input port list. */
  fun update_is(s) = updateInports(s, foldr(update_i, inports(s), lrps))
  /** Update output flags for a component at the current depth. */
  fun update_os(s) =
    if pathDepth(s) == d then updateOutports(s, zipWith(update_o, lrps, outports(s))) else s
  update_os(update_is(state))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The packet traversal and state update are translation-only.
/** Route one padded and transposed batch of packets. */
fun do_send(d, states) =
  let states1 = map(s => check_depth(d, s), states)
  let send_results = map(x => snd(send(x)), transpose(pad_packets(map(make_packet, states1))))
  let pss_ = transpose(send_results)
  zipWith((x, y) => update_io(d, x, y), pss_, states)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The send and acknowledgement passes are translation-only.
/** Route packets until all requests at this depth are acknowledged. */
fun do_sends(d, states) = until(s => acknowledge(d, s), x => do_send(d, x), states)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Gate dispatch and output updates are translation-only.
/** Simulate a component and store any output at the current depth. */
fun simulate_component(d, state) =
  /** Keep the signals from well-shaped input ports. */
  fun lscomp(ls) = if ls is
    LNil() then LNil()
    LCons(h, t) and
      h is [_, [_, sig]] then LCons(sig, lscomp(t))
      else lscomp(t)
  let out_signals = lscomp(inports(state))
  let new_value = apply_component(compType(state), out_signals)
  if d == pathDepth(state) and new_value is Some(v) then update_outports(state, v)
  else state
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Component simulation is translation-only.
/** Simulate all components for one depth. */
fun simulate_components(depth, states) = map(s => simulate_component(depth, s), states)
//│ CTML translation succeeded.

/**
 * Trusted JavaScript Error message conversion. Undefined gives an empty message, and conversion
 * can itself throw.
 */
declare fun jsErrorMessage: Top -> Str
//│ jsErrorMessage: ⊤ → Str

:ctml-parse-only // FIXME: The routing, simulation, and request restoration are translation-only.
/** Store inputs, simulate each depth, and restore send requests for the next cycle. */
fun do_cycle(cpd, circuit, inputs) =
  /** Simulate and send at the next depth. */
  fun sim_then_send(state, d) = do_sends(d, simulate_components(d, state))
  if circuit is [size, [ins, [outs, states]]] then
    let states1 = map(s => store_inputs(zip(ins, inputs), s), states)
    let states2 = do_sends(0, states1)
    let states3 = foldl(sim_then_send, states2, enumFromTo(1, cpd))
    let states4 = restore_requests(states, states3)
    [size, [ins, [outs, states4]]]
  else raiseError(jsErrorMessage(circuit))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The cycle and flip-flop initialization are translation-only.
/** Initialize the flip-flops and scan input lists over the circuit, omitting the initial state. */
fun simulate(inputs_list, b) = if b is [size, [ins, [outs, states]]] then
  tail(scanl((x, y) => do_cycle(critical_path_depth([size, [ins, [outs, states]]]), x, y),
    [size, [ins, [outs, map(init_dffs, states)]]], inputs_list))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The state constructor is translation-only.
/** Construct the seven component states for one register bit in source order. */
fun reg(sto, n) =
  let inp = PS(n, Inp(), 0, LNil(), LCons([0, [F(), [false, [0, [true, 4]]]]], LNil()))
  let dffIn = LCons([n + 5, [0, F()]], LNil())
  let dff = PS(n + 1, Dff(), 1, dffIn, LCons([0, [F(), [false, [0, [true, 5]]]]], LNil()))
  let invIn = LCons([sto, [0, F()]], LNil())
  let inv_ = PS(n + 2, Inv(), 1, invIn, LCons([0, [F(), [false, [0, [true, 1]]]]], LNil()))
  let andIn = LCons([n + 1, [0, F()]], LCons([n + 2, [0, F()]], LNil()))
  let and_ = PS(n + 3, And2(), 2, andIn, LCons([0, [F(), [false, [0, [true, 2]]]]], LNil()))
  let andIn2 = LCons([sto, [0, F()]], LCons([n, [0, F()]], LNil()))
  let and_2 = PS(n + 4, And2(), 1, andIn2, LCons([0, [F(), [false, [0, [true, 1]]]]], LNil()))
  let orIn = LCons([n + 3, [0, F()]], LCons([n + 4, [0, F()]], LNil()))
  let or_ = PS(n + 5, Or2(), 3, orIn, LCons([0, [F(), [true, [4, [false, 0]]]]], LNil()))
  let outputState = PS(n + 6, Outp(), 4, LCons([n + 1, [0, F()]], LNil()), LNil())
  LCons(inp, LCons(dff, LCons(inv_, LCons(and_, LCons(and_2, LCons(or_, LCons(outputState, LNil())))))))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds the 20000-call solver budget.
/** Combine a lazy left list with a strict right list, forcing the left node first. */
fun zipWithLzNl(f, xss, yss) = if
  force(xss) is LzCons(x, xs) and yss is LCons(y, ys) then LCons(f(x, y), zipWithLzNl(f, xs, ys))
  else LNil()
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Register construction and the lazy zip are translation-only.
/** Make the input labels, output labels, and component states for a register. */
fun regs(bits) =
  /** Label a register input. */
  fun ilabel(n, pid_) = ["x" ++ stringOfInt(n), pid_]
  /** Label a register output. */
  fun olabel(n, pid_) = ["y" ++ stringOfInt(n), pid_]
  let is_ = LCons(["sto", 0], zipWithLzNl(ilabel, enumFrom(0), map(x => (7 * x) + 1, enumFromTo(0, bits - 1))))
  let os = zipWithLzNl(olabel, enumFrom(0), map(x => (7 * x) + 7, enumFromTo(0, bits - 1)))
  let sto = PS(0, Inp(), 0, LNil(), LCons([0, [F(), [false, [0, [true, (8 * (bits - 1)) + 5]]]]], LNil()))
  let states = LCons(sto, concat(map(x => reg(0, x), map(x => (7 * x) + 1, enumFromTo(0, bits - 1)))))
  [1 + (7 * bits), [is_, [os, states]]]
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Simulation and output collection are translation-only.
/** Collect the component outputs after each simulated cycle. */
fun circuit_simulate(inputs_list, circuit) = map(collect_outputs, simulate(inputs_list, circuit))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Circuit construction and simulation are translation-only.
/** Simulate the padded register with all input signals high for every cycle. */
fun run(num_bits, num_cycles) =
  let example = pad_circuit(regs(num_bits))
  let inputs = replicate(num_bits + 1, T())
  let cycles = replicate(num_cycles, inputs)
  circuit_simulate(cycles, example)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The simulation driver is translation-only.
/** Run the source eight-bit simulation. */
fun testCircsim_nofib(n) = run(8, n)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The driver is translation-only and CTML lists lack source rendering.
/** Render the forty-cycle benchmark result in the source list format. */
fun main() = testCircsim_nofib(40).toString()
//│ CTML translation succeeded.

