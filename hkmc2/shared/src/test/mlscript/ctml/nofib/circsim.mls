/** Fill each packet row up to the length of the longest row. */
fun pad_packets(pss) =
  /** Append delayed padding and take the required strict prefix. */
  fun pad(xs) =
    let max_ps = maximumInt(map(x => listLen(x), pss))
    takeLz(max_ps, appendNlLz(xs, replicateLz(max_ps, emptyPacket)))
  map(x => pad(x), pss)
//│ CTML translation succeeded.

