/** Acknowledge a completed send when no request is pending at this depth. */
fun acknowledge(d, states) =
  /** Test the two flags of one port. */
  fun check_lr_requests(pql) = if pql is [p, [m, [ql, [dl, [qr, dr]]]]] then ql || qr
  /** Test for any outstanding request in the port list. */
  fun check_requests(xs) = orList(map(check_lr_requests, xs))
  let states1 = map(s => check_depth(d, s), states)
  if orList(map(s => check_requests(outports(s)), states1)) then false else true
//│ CTML translation succeeded.

