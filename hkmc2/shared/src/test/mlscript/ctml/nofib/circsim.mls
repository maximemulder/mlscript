// Keep its constructor pattern in the same block so it is in scope during translation.
/** Per-component state. Port field refinements retain the types of supplied payloads. */
data class PS(pid: Int, compType: Component, pathDepth: Int, inports: Inports, outports: Outports)
/** Replace only the output ports. */
fun updateOutports(p, noutports) = PS(pid(p), compType(p), pathDepth(p), inports(p), noutports)
/** Write the same signal to every output port of a state. */
fun update_outports(state, value) =
  /** Keep the request fields of each well-shaped output port. */
  fun lscomp(ls) = if ls is
    LNil() then LNil()
    LCons(h, t) and
      h is [p, [m, [ql, [dl, [qr, dr]]]]] then LCons([p, [value, [ql, [dl, [qr, dr]]]]], lscomp(t))
      else lscomp(t)
  updateOutports(state, lscomp(outports(state)))
/** Store a labelled input signal in the output ports of its input component. */
fun store_inputs(label_inputs, state) = if state is
  PS(pid_, Inp(), _, _, _) then
    /** Collect state updates whose input label names this component. */
    fun lscomp(ls) = if ls is
      LNil() then LNil()
      LCons(h, t) and
        h is [[label, input_pid], value] and pid_ == input_pid then
          LCons(update_outports(state, value), lscomp(t))
        else lscomp(t)
    head(lscomp(label_inputs))
  else state
//│ CTML translation succeeded.

