/** Scan a tree from left to right. */
fun scanL(f, u, xs) =
  /** Give the right subtree the value accumulated over the left subtree. */
  fun down1(l, r, x) = [x, f(x, l)]
  if sweep_ud(f, down1, u, put(xs)) is [ans, t] then [ans, get(t)]
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The sweep and leaf collection are translation-only.
/** Scan a tree from right to left. */
fun scanR(f, u, xs) =
  /** Give the left subtree the value accumulated over the right subtree. */
  fun down2(l, r, x) = [f(r, x), x]
  if sweep_ud(f, down2, u, put(xs)) is [ans, t] then [ans, get(t)]
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The sweep and leaf collection are translation-only.
/** Scan both directions together, keeping the source order of the two final results. */
fun scanlr(f, g, lu, ru, xs) =
  /** Combine the two accumulated directional values independently. */
  fun up(lxly, rxry) = if lxly is [lx, ly] and rxry is [rx, ry] then [f(lx, rx), g(ly, ry)]
  /** Pass the rightward accumulator right and the leftward accumulator left. */
  fun down3(lxly, rxry, ab) = if lxly is [lx, ly] and rxry is [rx, ry] and ab is [a, b] then
    [[a, g(ry, b)], [f(a, lx), b]]
  let xs_ = map(x => [x, x], xs)
  if sweep_ud(up, down3, [lu, ru], put(xs_)) is [[l_ans, r_ans], t] then
    [[g(r_ans, ru), f(lu, l_ans)], get(t)]
//│ CTML translation succeeded.

/** Step until the current value satisfies the predicate. */
fun until(p, f, x) = if p(x) then x else until(p, f, f(x))
//│ until: ∀α. (α → Bool) → (α → α) → α → α

/** Find the first power of two at least as large as x. */
fun nearest_power_of_two(x) = until(a => x <= a, a => a * 2, 1)
//│ nearest_power_of_two: Int → Int

