/** Prepend strict cells, returning the original delayed suffix once they are exhausted. */
fun appendNlLz(xs, ys) = if xs is
  LNil() then ys
  LCons(h, t) then delay(() => LzCons(h, appendNlLz(t, ys)))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The strict-to-lazy append and padding state are translation-only.
/** Round the state count up to a power of two and fill with inactive components. */
fun pad_circuit(circuit) = if circuit is [size, [ins, [outs, states]]] then
  let p2 = nearest_power_of_two(size)
  let states_ = appendNlLz(states, replicateLz(p2, emptyState))
  [p2, [ins, [outs, takeLz(p2, states_)]]]
//│ CTML translation succeeded.

/** Test the singleton high signal by its tag. */
fun isHigh(x) = if x is T() then true else false
//│ isHigh: ∀α. α → (({α ≤ T} ⟹ Bool) ∧ ({α ≤ ¬T} ⟹ Bool))

/** Invert a signal. */
fun inv(x) = if isHigh(x) then F() else T()
//│ inv: ∀α. {α ≤ ¬({α ≤ T} ⟹ ¬T) ∨ ¬({α ≤ ¬T} ⟹ T)} ⟹ α → (T ∨ F)

/** Return high when both signals are high. */
fun and2(x, y) = if isHigh(x) && isHigh(y) then T() else F()
//│ and2: ∀α, β. {β ≤ ¬({β ≤ T} ⟹ ¬T) ∨ ¬({β ≤ ¬T} ⟹ T), α ≤ ¬({α ≤ T} ⟹ ¬T) ∨ ¬({α ≤ ¬T} ⟹ T)} ⟹ α → β → (F ∨ T)

/** Return high when either signal is high. */
fun or2(x, y) = if isHigh(x) || isHigh(y) then T() else F()
//│ or2: ∀α, β. {β ≤ ¬({β ≤ T} ⟹ ¬T) ∨ ¬({β ≤ ¬T} ⟹ T), α ≤ ¬({α ≤ T} ⟹ ¬T) ∨ ¬({α ≤ ¬T} ⟹ T)} ⟹ α → β → (F ∨ T)

/** Compare the singleton low signal by its tag. */
fun isLow(x) = if x is F() then true else false
//│ isLow: ∀α. α → (({α ≤ F} ⟹ Bool) ∧ ({α ≤ ¬F} ⟹ Bool))

/** Preserve the source equality test, with singleton signal equality represented by tags. */
fun xor(x, y) =
  if (isHigh(x) && isHigh(y)) || (isLow(x) && isLow(y)) || (x === y) then T() else F()
//│ xor: ∀α, β. {β ≤ (¬({β ≤ F} ⟹ ¬F) ∨ ¬({β ≤ ¬F} ⟹ F)) ∧ (¬({β ≤ T} ⟹ ¬T) ∨ ¬({β ≤ ¬T} ⟹ T)), α ≤ (¬({α ≤ F} ⟹ ¬F) ∨ ¬({α ≤ ¬F} ⟹ F)) ∧ (¬({α ≤ T} ⟹ ¬T) ∨ ¬({α ≤ ¬T} ⟹ T))} ⟹ α → β → (F ∨ T)

/** A padding packet with no requests and span one. */
val emptyPacket = [0 - 1, [0 - 1, [F(), [false, [0, [false, [0, 1]]]]]]]
//│ emptyPacket: ⟨Int, ⟨Int, ⟨F, ⟨Bool, ⟨Int, ⟨Bool, ⟨Int, Int⟩⟩⟩⟩⟩⟩⟩

/** Send the left packet rightward if its request spans the right packet. */
fun send_right(a, b) = if
  a is [ia, [sa, [ma, [qla, [dla, [qra, [dra, ea]]]]]]] and b is [ib, [sb, [mb, [qlb, [dlb, [qrb, [drb, eb]]]]]]] then
    if qra && (eb < dra) then [ia, [sa, [ma, [qla, [dla, [qra, [dra - eb, ea + eb]]]]]]]
    else [ib, [sb, [mb, [qlb, [dlb, [qrb, [drb, ea + eb]]]]]]]
//│ send_right: ∀α, β, γ, δ, ε, ζ, η, θ, ι, κ, λ, μ, ν. {ζ ≤ Bool} ⟹ ⟨α, ⟨β, ⟨γ, ⟨δ, ⟨ε, ⟨ζ, ⟨Int, Int⟩⟩⟩⟩⟩⟩⟩ → ⟨η, ⟨θ, ⟨ι, ⟨κ, ⟨λ, ⟨μ, ⟨ν, Int⟩⟩⟩⟩⟩⟩⟩ → (⟨α, ⟨β, ⟨γ, ⟨δ, ⟨ε, ⟨ζ, ⟨Int, Int⟩⟩⟩⟩⟩⟩⟩ ∨ ⟨η, ⟨θ, ⟨ι, ⟨κ, ⟨λ, ⟨μ, ⟨ν, Int⟩⟩⟩⟩⟩⟩⟩)

/** Send the right packet leftward if its request spans the left packet. */
fun send_left(a, b) = if
  a is [ia, [sa, [ma, [qla, [dla, [qra, [dra, ea]]]]]]] and b is [ib, [sb, [mb, [qlb, [dlb, [qrb, [drb, eb]]]]]]] then
    if qlb && (ea < dlb) then [ib, [sb, [mb, [qlb, [dlb - ea, [qrb, [drb, ea + eb]]]]]]]
    else [ia, [sa, [ma, [qla, [dla, [qra, [dra, ea + eb]]]]]]]
//│ send_left: ∀α, β, γ, δ, ε, ζ, η, θ, ι, κ, λ, μ, ν. {λ ≤ Bool} ⟹ ⟨α, ⟨β, ⟨γ, ⟨δ, ⟨ε, ⟨ζ, ⟨η, Int⟩⟩⟩⟩⟩⟩⟩ → ⟨θ, ⟨ι, ⟨κ, ⟨λ, ⟨Int, ⟨μ, ⟨ν, Int⟩⟩⟩⟩⟩⟩⟩ → (⟨θ, ⟨ι, ⟨κ, ⟨λ, ⟨Int, ⟨μ, ⟨ν, Int⟩⟩⟩⟩⟩⟩⟩ ∨ ⟨α, ⟨β, ⟨γ, ⟨δ, ⟨ε, ⟨ζ, ⟨η, Int⟩⟩⟩⟩⟩⟩⟩)

