/** Restore request flags and routing fields while keeping the new signals. */
fun restore_requests(old_states, new_states) =
  /** Combine one old port's routing fields with one new port's signal. */
  fun restore_outport(pql, mdq) = if
    pql is [p, [_, [ql, [dl, [qr, dq]]]]] and mdq is [_, [m, [_, [_, [_, _]]]]] then
      [p, [m, [ql, [dl, [qr, dq]]]]]
  /** Restore the outputs of a matching pair of states. */
  fun restore(os, ns) = updateOutports(ns, zipWith(restore_outport, outports(os), outports(ns)))
  zipWith(restore, old_states, new_states)
//│ CTML translation succeeded.

