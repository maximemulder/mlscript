/** Read each labelled output from its component's first input port. */
fun collect_outputs(circuit) = if circuit is [size, [ins, [outs, states]]] then
  /** Project the signal from an input port. */
  fun third(port) = if port is [_, [_, v]] then v
  /** Find the input port for the labelled component. */
  fun get_output(states, labelPort) = if labelPort is [label, p] then
    /** Collect the first input ports of all states with the given id. */
    fun lscomp(ls) = if ls is
      LNil() then LNil()
      LCons(s, t) and
        p == pid(s) then LCons(head(inports(s)), lscomp(t))
        else lscomp(t)
    third(head(lscomp(states)))
  map(p => get_output(states, p), outs)
//│ CTML translation succeeded.

