/** Apply the gate, requiring its source arity and returning an optional signal. */
fun apply_component(comp, signals) = if comp is
  Inp() then None()
  Outp() and signals is LCons(x, LNil()) then Some(x)
  Dff() and signals is LCons(x, LNil()) then Some(x)
  Inv() and signals is LCons(x, LNil()) then Some(inv(x))
  And2() and signals is LCons(x, LCons(y, LNil())) then Some(and2(x, y))
  Or2() and signals is LCons(x, LCons(y, LNil())) then Some(or2(x, y))
  Xor() and signals is LCons(x, LCons(y, LNil())) then Some(xor(x, y))
  None_() then None()
//│ CTML translation succeeded.

