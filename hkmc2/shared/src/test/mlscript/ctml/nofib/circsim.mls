// Source: hkmc2/shared/src/test/mlscript-compile/nofib/circsim.mls.
// Circuits, ports, and packets use right-nested pairs. Signals and component kinds use tags.

/** A leaf in the balanced sweep tree. */
data class Cell(value)
//│ Cell: ∀α. α → (Cell ∧ {value: α})

/** An internal sweep node whose payload changes between sweeps. */
data class Node(value, left, right)
//│ Node: ∀α, β, γ. α → β → γ → (((Node ∧ {value: α}) ∧ {left: β}) ∧ {right: γ})

/** A placeholder for internal nodes without sweep results. */
data class TreeUnit()
//│ TreeUnit: Unit → TreeUnit

/** A padding component. */
data class None_()
/** An external input. */
data class Inp()
/** An external output. */
data class Outp()
/** A delay flip-flop. */
data class Dff()
/** An inverter. */
data class Inv()
/** A two-input AND gate. */
data class And2()
/** A two-input OR gate. */
data class Or2()
/** The source XOR gate, whose operation tests signal equality. */
data class Xor()
//│ None_: Unit → None_
//│ Inp: Unit → Inp
//│ Outp: Unit → Outp
//│ Dff: Unit → Dff
//│ Inv: Unit → Inv
//│ And2: Unit → And2
//│ Or2: Unit → Or2
//│ Xor: Unit → Xor

/** A circuit component kind. */
type Component = None_ | Inp | Outp | Dff | Inv | And2 | Or2 | Xor
//│ Component = ((((((None_ ∨ Inp) ∨ Outp) ∨ Dff) ∨ Inv) ∨ And2) ∨ Or2) ∨ Xor

/** The low signal. */
data class F()
/** The high signal. */
data class T()
//│ F: Unit → F
//│ T: Unit → T

/** The two circuit signals. */
type Signal = F | T
//│ Signal = F ∨ T

/** Absence of a new component output. */
data class None()
/** A component output for this cycle. */
data class Some(value)
//│ None: Unit → None
//│ Some: ∀α. α → (Some ∧ {value: α})

/** Input records hold the sender id, port id, and payload. */
type Inport = [Int, [Int, Top]]
/** Output records hold the port id, payload, and two request/distance pairs. */
type Outport = [Int, [Top, [Bool, [Int, [Bool, Int]]]]]
//│ Inport = ⟨Int, ⟨Int, ⊤⟩⟩
//│ Outport = ⟨Int, ⟨⊤, ⟨Bool, ⟨Int, ⟨Bool, Int⟩⟩⟩⟩⟩

/** A proper list of input ports, with structurally inferred payload types. */
type Inports = [X restricts (LNil | (LCons & {head: Inport} & {tail: X}))] -> X
/** A proper list of output ports, with structurally inferred payload types. */
type Outports = [X restricts (LNil | (LCons & {head: Outport} & {tail: X}))] -> X
//│ Inports = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Inport}) ∧ {tail: X})} ⟹ X
//│ Outports = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Outport}) ∧ {tail: X})} ⟹ X

/** Project the component id. */
fun pid(p) = p.pid
//│ pid: ∀α. {pid: α} → α

/** Project the gate kind. */
fun compType(p) = p.compType
//│ compType: ∀α. {compType: α} → α

/** Project the component's critical path depth. */
fun pathDepth(p) = p.pathDepth
//│ pathDepth: ∀α. {pathDepth: α} → α

/** Project the input port list. */
fun inports(p) = p.inports
//│ inports: ∀α. {inports: α} → α

/** Project the output port list. */
fun outports(p) = p.outports
//│ outports: ∀α. {outports: α} → α

