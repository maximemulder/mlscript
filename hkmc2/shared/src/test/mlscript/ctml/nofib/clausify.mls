:ctml-parse-only // FIXME: The guarded stack reductions exceed the 5000-call budget.
/** Reduce one expression from the parser stack. */
fun red(s) = if s is
  LCons(Ast(p), LCons(Lex(op), LCons(Ast(q), s))) and op === "=" then LCons(Ast(Eqv(q, p)), s)
  LCons(Ast(p), LCons(Lex(op), LCons(Ast(q), s))) and op === ">" then LCons(Ast(Imp(q, p)), s)
  LCons(Ast(p), LCons(Lex(op), LCons(Ast(q), s))) and op === "|" then LCons(Ast(Dis(q, p)), s)
  LCons(Ast(p), LCons(Lex(op), LCons(Ast(q), s))) and op === "&" then LCons(Ast(Con(q, p)), s)
  LCons(Ast(p), LCons(Lex(op), s)) and op === "~" then LCons(Ast(Not(p)), s)
  else raiseError("match error")
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Matching the stack head and looking up its operator exhausts bounded inference.
/** Read the precedence of the operator behind the expression on top of the stack. */
fun spri(s) = if s is
  LCons(Ast(_), LCons(Lex(c), _)) then opri(c)
  else 0
//│ CTML translation succeeded.

/** Apply a state transition as long as its predicate holds. */
fun while_(p, f, x) = if p(x) then while_(p, f, f(x)) else x
//│ while_: ∀α. (α → Bool) → (α → α) → α → α

:ctml-parse-only // FIXME: The one-step stack reduction is translation-only.
/** Reduce until no pending operator remains. */
fun redstar(s) = while_(x => if spri(x) === 0 then false else true, red, s)
//│ CTML translation succeeded.

/** Build a list of display spaces. */
fun spaces(n) = replicate(n, " ")
//│ spaces: ∀α. {α ≥ ((LCons ∧ {head: Str}) ∧ {tail: α}) ∨ LNil} ⟹ Int → (((LCons ∧ {head: Str}) ∧ {tail: α}) ∨ LNil)

:ctml-parse-only // FIXME: Stack reduction is translation-only.
/** Parse the input using the source stack and precedence rules. */
fun parseHelper(t, s) = if t is
  LNil() then redstar(s)
  LCons(c, t) and c === " " then parseHelper(t, s)
  LCons(c, t) and c === "(" then parseHelper(t, LCons(Lex("("), s))
  LCons(c, t) and c === ")" and redstar(s) is LCons(x, LCons(Lex(paren), ss)) and paren === "(" then
    parseHelper(t, LCons(x, ss))
  LCons(c, t) then
    if charLeq("a", c) && charLeq(c, "z") then parseHelper(t, LCons(Ast(Sym(c)), s))
    else
      let pending = spri(s)
      let incoming = opri(c)
      if incoming < pending then parseHelper(LCons(c, t), red(s))
      else parseHelper(t, LCons(Lex(c), s))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The stack parser is translation-only.
/** Extract the complete formula from the final parser stack. */
fun parse(t) = if parseHelper(t, LNil()) is LCons(Ast(f), LNil()) then f
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Recursive conjunction splitting exceeds the 5000-call budget.
/** Prepend the non-conjunction formulas from left to right. */
fun splitHelper(p, a) = if p is
  Con(p, q) then splitHelper(p, splitHelper(q, a))
  else LCons(p, a)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The conjunction splitter is translation-only.
/** Split a conjunction into its clauses. */
fun split(p) = splitHelper(p, LNil())
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The recursive membership traversal exceeds the 5000-call budget.
/** Test whether a clause contains both a symbol and its negation. */
fun tautclause(c_a) = if c_a is [c, a] then
  /** Collect the positive symbols that also occur in the negative list. */
  fun lscomp(ls) = if ls is
    LNil() then LNil()
    LCons(h, t) then if inList(h, a) then LCons(h, lscomp(t)) else lscomp(t)
  if listEq(lscomp(c), LNil()) then false else true
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Clause construction and insertion are translation-only.
/** Discard a tautology or insert the clause in source order. */
fun uniclHelper(p, x) =
  let cp = clause(p)
  if tautclause(cp) then x else insert(clauseKey, cp, x)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The insertion fold is translation-only.
/** Collect non-tautological clauses without duplicate keys. */
fun unicl(a) = foldr(uniclHelper, LNil(), a)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The alternating list traversal is translation-only.
/** Format both sides of a clause with spaces and a trailing newline. */
fun disp(l_r) = if l_r is [l, r] then
  append(interleave(l, spaces(listLen(l))),
    append(nofibStringToList("<="),
      append(interleave(spaces(listLen(r)), r), nofibStringToList("\n"))))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Parsing, normalization, and display are translation-only.
/** Parse, normalize, extract, and display the source clauses. */
fun clauses(t) = concat(map(disp, unicl(split(disin(negin(elim(parse(t))))))))
//│ CTML translation succeeded.

