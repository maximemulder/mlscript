:ctml-parse-only // FIXME: Recursive ordered insertion exceeds bounded inference.
/** Insert by the source order, keeping the existing element for an equal key. */
fun insert(key, x, ys) = if ys is
  LNil() then LCons(x, LNil())
  LCons(y, rest) then
    if charLt(key(x), key(y)) then LCons(x, ys)
    else if charGt(key(x), key(y)) then LCons(y, insert(key, x, rest))
    else ys
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Ordered insertion is translation-only.
/** Accumulate the positive and negative symbols of one disjunction. */
fun clauseHelper(p, x) = if p is
  Dis(p, q) then clauseHelper(p, clauseHelper(q, x))
  Sym(s) and x is [c, a] then [insert(s => s, s, c), a]
  Not(Sym(s)) and x is [c, a] then [c, insert(s => s, s, a)]
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The clause accumulator is translation-only.
/** Build one clause from a disjunction of literals. */
fun clause(p) = clauseHelper(p, [LNil(), LNil()])
//│ CTML translation succeeded.

/** Test whether the outer formula constructor is conjunction. */
fun conjunct(p) = if p is Con(_, _) then true else false
//│ conjunct: ∀α. α → (({α ≤ (Con ∧ {a: ⊤}) ∧ {b: ⊤}} ⟹ Bool) ∧ ({α ≤ ¬((Con ∧ {a: ⊤}) ∧ {b: ⊤})} ⟹ Bool))

:ctml-parse-only // FIXME: Recursive distribution exceeds bounded inference.
/** Distribute disjunction over conjunction until the formula is in conjunctive normal form. */
fun disin(p) = if p is
  Dis(p, Con(q, r)) then Con(disin(Dis(p, q)), disin(Dis(p, r)))
  Dis(Con(p, q), r) then Con(disin(Dis(p, r)), disin(Dis(q, r)))
  Dis(p, q) then
    let dp = disin(p)
    let dq = disin(q)
    if conjunct(dp) || conjunct(dq) then disin(Dis(dp, dq)) else Dis(dp, dq)
  Con(p, q) then Con(disin(p), disin(q))
  else p
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Recursive formula rewriting exceeds bounded inference.
/** Replace implication and equivalence with negation, disjunction, and conjunction. */
fun elim(p) = if p is
  Sym(s) then Sym(s)
  Not(p) then Not(elim(p))
  Dis(p, q) then Dis(elim(p), elim(q))
  Con(p, q) then Con(elim(p), elim(q))
  Imp(p, q) then Dis(Not(elim(p)), elim(q))
  Eqv(f, f_) then Con(elim(Imp(f, f_)), elim(Imp(f_, f)))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The alternating list traversal exceeds bounded inference.
/** Alternate elements by exchanging the two lists at each step. */
fun interleave(xs, ys) = if xs is
  LCons(x, rest) then LCons(x, interleave(ys, rest))
  LNil() then LNil()
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Recursive negation rewriting exceeds bounded inference.
/** Move negations inwards to symbols using the source's rewrite order. */
fun negin(p) = if p is
  Not(Not(p)) then negin(p)
  Not(Con(p, q)) then Dis(negin(Not(p)), negin(Not(q)))
  Not(Dis(p, q)) then Con(negin(Not(p)), negin(Not(q)))
  Dis(p, q) then Dis(negin(p), negin(q))
  Con(p, q) then Con(negin(p), negin(q))
  else p
//│ CTML translation succeeded.

/** Read an operator's precedence or throw with the invalid operator as the message. */
fun opri(c) = if
  c === "(" then 0
  c === "=" then 1
  c === ">" then 2
  c === "|" then 3
  c === "&" then 4
  c === "~" then 5
  else raiseError(c)
//│ opri: Str → Int

opri("&") as Int
raiseError("?") as Bot
//│ Int
//│ ⊥

