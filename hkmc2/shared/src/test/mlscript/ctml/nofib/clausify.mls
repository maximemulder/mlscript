// Source: hkmc2/shared/src/test/mlscript-compile/nofib/clausify.mls.
// Formula and parser stack tags carry recursive children through structural fields.
// Both uses of insertion compare string keys. For two lists the key is the source's
// comma-separated string coercion of a pair, including literal quoting inside each list.

/** A formula variable, represented by a source string code unit. */
data class Sym(a: Str)
/** Negate one formula. */
data class Not(a)
/** Disjoin two formulas. */
data class Dis(a, b)
/** Conjoin two formulas. */
data class Con(a, b)
/** Express implication. */
data class Imp(a, b)
/** Express equivalence. */
data class Eqv(a, b)
//│ Sym: ∀α. {α ≤ Str} ⟹ α → (Sym ∧ {a: α})
//│ Not: ∀β. β → (Not ∧ {a: β})
//│ Dis: ∀γ, δ. γ → δ → ((Dis ∧ {a: γ}) ∧ {b: δ})
//│ Con: ∀ε, ζ. ε → ζ → ((Con ∧ {a: ε}) ∧ {b: ζ})
//│ Imp: ∀η, θ. η → θ → ((Imp ∧ {a: η}) ∧ {b: θ})
//│ Eqv: ∀ι, κ. ι → κ → ((Eqv ∧ {a: ι}) ∧ {b: κ})

/** A formula on the parser stack. */
data class Ast(f)
/** An operator or parenthesis on the parser stack. */
data class Lex(s: Str)
//│ Ast: ∀α. α → (Ast ∧ {f: α})
//│ Lex: ∀β. {β ≤ Str} ⟹ β → (Lex ∧ {s: β})

/** Compare code units or the string keys of a pair of clauses. */
fun charLt(a, b) = strLt(a, b)
//│ charLt: Str → Str → Bool

/** Compare code units in nondecreasing order. */
fun charLeq(a, b) = if strLt(b, a) then false else true
//│ charLeq: Str → Str → Bool

/** Compare code units or clause keys in descending order. */
fun charGt(a, b) = strLt(b, a)
//│ charGt: Str → Str → Bool

/** Compare code units in nonincreasing order. */
fun charGeq(a, b) = charLeq(b, a)
//│ charGeq: Str → Str → Bool

/** Render a pair as its two source list renderings separated by a comma. */
fun clauseKey(pair) = if pair is [left, right] then
  renderStringList(left) ++ "," ++ renderStringList(right)
//│ clauseKey: ∀α, β. {β ≤ Str, α ≤ Str} ⟹ ⟨∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X, ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: X})} ⟹ X⟩ → Str

clauseKey([LNil(), LNil()]) as Str
charLt(clauseKey([LCons("b", LNil()), LNil()]), clauseKey([LNil(), LCons("\n", LNil())])) as Bool
//│ Str
//│ Bool

