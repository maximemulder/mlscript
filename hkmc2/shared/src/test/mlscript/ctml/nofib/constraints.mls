/** Count the solutions obtained with one labelling algorithm. */
fun try_(n, algorithm) = listLen(search(algorithm, queens(n)))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The search and labellers are translation-only.
/** Compare the five algorithms in the source order. */
fun testConstraints_nofib(n) = map(x => try_(n, x),
  LCons(bt, LCons(bm, LCons(bjbt, LCons(bjbt_, LCons(fc, LNil()))))))
//│ CTML translation succeeded.

