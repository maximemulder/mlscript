/** Expand each seed with the child seeds it produces. */
fun initTree(f, x) = Node(x, map(y => initTree(f, y), f(x)))
//│ initTree: ∀α, β. {β ≥ (Node ∧ {lab: α}) ∧ {children: ∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Y})} ⟹ Y}} ⟹ (∀X. α → ({X ≥ LNil} ⟹ X)) → α → ((Node ∧ {lab: α}) ∧ {children: ∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Y})} ⟹ Y})

:ctml-parse-only // FIXME: Recursive enumeration of candidate assignments exceeds the 20000-call budget.
/** Enumerate assignment paths in increasing order of each variable's candidate values. */
fun mkTree(csp) = if csp is CSP(vars, vals, _) then
  /** Generate candidates for the next level of the assignment path. */
  fun next(ss) =
    if maxLevel(ss) < vars then
      /** Build one child path for each candidate value. */
      fun lscomp1(ls) = if ls is
        LNil() then LNil()
        LCons(j, t1) then LCons(LCons(Assign(maxLevel(ss) + 1, j), ss), lscomp1(t1))
      lscomp1(enumFromTo(1, vals))
    else LNil()
  initTree(next, LNil())
//│ CTML translation succeeded.

/** No conflicting earlier assignment was found. */
data class None()
/** The latest assignment conflicts with the given earlier assignment. */
data class Some(levels: [Int, Int])
//│ None: Unit → None
//│ Some: ∀α. {α ≤ ⟨Int, Int⟩} ⟹ α → (Some ∧ {levels: α})

:ctml-parse-only // FIXME: Filtering the reversed assignment path exceeds the 20000-call budget.
/** Find the earliest conflict with the latest assignment. */
fun earliestInconsistency(csp, aas) = if csp is CSP(_, _, rel) and aas is
  LNil() then None()
  LCons(a, as_) and filter(x => if rel(a, x) then false else true, reverse(as_)) is
    LNil() then None()
    LCons(b, _) then Some([level(a), level(b)])
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The earliest-conflict search is translation-only.
/** Label each node with its assignments and earliest inconsistency. */
fun labelInconsistencies(csp, t) =
  /** Pair the path with its earliest conflict. */
  fun f2(s) = [s, earliestInconsistency(csp, s)]
  mapTree(f2, t)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The assignment tree builder and inconsistency labelling are translation-only.
/** Solve by pruning inconsistent assignments and retaining complete leaves. */
fun btsolver0(csp) =
  let labelled = labelInconsistencies(csp, mkTree(csp))
  let consistent = prune(x => if snd(x) is None() then false else true, labelled)
  filter(x => complete(csp, x), leaves(mapTree(fst, consistent)))
//│ CTML translation succeeded.

/** A known conflict set, empty when the assignment is a solution. */
data class Known(vs: [X restricts (LNil | (LCons & {head: Int} & {tail: X}))] -> X)
/** A node without a known outcome. */
data class Unknown()
//│ Known: ∀α. {α ≤ ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X} ⟹ α → (Known ∧ {vs: α})
//│ Unknown: Unit → Unknown

/** Test whether a node has a known nonempty conflict set. */
fun knownConflict(c) = if c is
  Known(LCons(_, _)) then true
  else false
//│ knownConflict: ∀α. α → (({α ≤ Known ∧ {vs: (LCons ∧ {head: ⊤}) ∧ {tail: ⊤}}} ⟹ Bool) ∧ ({α ≤ ¬(Known ∧ {vs: (LCons ∧ {head: ⊤}) ∧ {tail: ⊤}})} ⟹ Bool))

/** Test whether a node is a solution. */
fun knownSolution(c) = if c is
  Known(LNil()) then true
  else false
//│ knownSolution: ∀α. α → (({α ≤ Known ∧ {vs: LNil}} ⟹ Bool) ∧ ({α ≤ ¬(Known ∧ {vs: LNil})} ⟹ Bool))

knownConflict(Known(LCons(2, LNil()))) as Bool
