/** A search tree node with its label and child list. */
data class Node(lab, children)
//│ Node: ∀α, β. α → β → ((Node ∧ {lab: α}) ∧ {children: β})

/** Extract the label of one node. */
fun label(n) = if n is Node(l, _) then l
//│ label: ∀α. (({lab: α} ∧ Node) ∧ {children: ⊤}) → α

/** Apply a function to every node's label. */
fun mapTree(f, n) = if n is Node(l, c) then Node(f(l), map(x => mapTree(f, x), c))
//│ mapTree: ∀α, β, γ, δ. {δ ≥ (Node ∧ {lab: β}) ∧ {children: ∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: δ}) ∧ {tail: Y})} ⟹ Y}, γ ≤ ({children: ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: X})} ⟹ X} ∧ {lab: α}) ∧ Node} ⟹ (α → β) → (({children: ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: X})} ⟹ X} ∧ {lab: α}) ∧ Node) → ((Node ∧ {lab: β}) ∧ {children: ∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: δ}) ∧ {tail: Y})} ⟹ Y})

