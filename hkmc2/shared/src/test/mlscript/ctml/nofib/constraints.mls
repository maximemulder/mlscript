// Source: hkmc2/shared/src/test/mlscript-compile/nofib/constraints.mls.
// The quicksort group uses one recursive dispatcher. Node's structural fields carry the
// label and children as the solvers transform the tree. Known and Unknown tag search results.

/** Assign a value to a one-based variable. */
data class Assign(varr: Int, value: Int)
//│ Assign: ∀α, β. {β ≤ Int, α ≤ Int} ⟹ α → β → ((Assign ∧ {varr: α}) ∧ {value: β})

/** An assignment with both integer fields available to the relation. */
type Assignment = Assign & {varr: Int} & {value: Int}
//│ Assignment = (Assign ∧ {varr: Int}) ∧ {value: Int}

/** A constraint problem with variable and value counts and a compatibility predicate. */
data class CSP(vars: Int, vals: Int, rel: Assignment -> Assignment -> Bool)
//│ CSP: ∀α, β, γ. {β ≤ Int, γ ≤ Assignment → Assignment → Bool, α ≤ Int} ⟹ α → β → γ → (((CSP ∧ {vars: α}) ∧ {vals: β}) ∧ {rel: γ})

/** Sort a list in the forward mode. */
data class Sort(ls, acc)
/** Partition around the pivot in the forward mode. */
data class Part(pivot, ls, smaller, greaterEqual, acc)
/** Sort a list in the reverse mode. */
data class ReverseSort(ls, acc)
/** Partition around the pivot in the reverse mode. */
data class ReversePart(pivot, ls, smallerEqual, greater, acc)
//│ Sort: ∀α, β. α → β → ((Sort ∧ {ls: α}) ∧ {acc: β})
//│ Part: ∀γ, δ, ε, ζ, η. γ → δ → ε → ζ → η → (((((Part ∧ {pivot: γ}) ∧ {ls: δ}) ∧ {smaller: ε}) ∧ {greaterEqual: ζ}) ∧ {acc: η})
//│ ReverseSort: ∀θ, ι. θ → ι → ((ReverseSort ∧ {ls: θ}) ∧ {acc: ι})
//│ ReversePart: ∀κ, λ, μ, ν, ξ. κ → λ → μ → ν → ξ → (((((ReversePart ∧ {pivot: κ}) ∧ {ls: λ}) ∧ {smallerEqual: μ}) ∧ {greater: ν}) ∧ {acc: ξ})

:ctml-parse-only // FIXME: Recursive dispatch across the four partition modes exceeds the 20000-call budget.
/** Run the source quicksort and partition modes with their respective accumulators. */
fun quicksort(le, task) = if task is
  Sort(ls, r) and ls is
    LNil() then r
    LCons(x, LNil()) then LCons(x, r)
    LCons(x, xs) then quicksort(le, Part(x, xs, LNil(), LNil(), r))
  Part(x, ls, rlt, rge, r) and ls is
    LNil() then quicksort(le, ReverseSort(rlt, LCons(x, quicksort(le, ReverseSort(rge, r)))))
    LCons(y, ys) then
      if le(x, y) then quicksort(le, Part(x, ys, rlt, LCons(y, rge), r))
      else quicksort(le, Part(x, ys, LCons(y, rlt), rge, r))
  ReverseSort(ls, r) and ls is
    LNil() then r
    LCons(x, LNil()) then LCons(x, r)
    LCons(x, xs) then quicksort(le, ReversePart(x, xs, LNil(), LNil(), r))
  ReversePart(x, ls, rle, rgt, r) and ls is
    LNil() then quicksort(le, ReverseSort(rle, LCons(x, quicksort(le, Sort(rgt, r)))))
    LCons(y, ys) then
      if le(y, x) then quicksort(le, ReversePart(x, ys, LCons(y, rle), rgt, r))
      else quicksort(le, ReversePart(x, ys, rle, LCons(y, rgt), r))
//│ CTML translation succeeded.

/** Extract the variable number of an assignment. */
fun level(a) = if a is Assign(v, _) then v
//│ level: ∀α. (({varr: α} ∧ Assign) ∧ {value: ⊤}) → α

/** Extract the assigned value. */
fun value(a) = if a is Assign(_, v) then v
//│ value: ∀α. (({value: α} ∧ Assign) ∧ {varr: ⊤}) → α

/** Read the level of the latest assignment, or zero at the root. */
fun maxLevel(ls) = if ls is
  LNil() then 0
  LCons(Assign(v, _), _) then v
//│ maxLevel: ∀α, β. {β ≥ ({α ≤ LNil} ⟹ Int) ∧ ({α ≤ ({head: ({varr: β} ∧ Assign) ∧ {value: ⊤}} ∧ LCons) ∧ {tail: ⊤}} ⟹ ⊥), α ≤ ¬({β ≥ Int} ⟹ ¬LNil) ∨ (({head: ({varr: β} ∧ Assign) ∧ {value: ⊤}} ∧ LCons) ∧ {tail: ⊤})} ⟹ α → β

/** Test whether each variable has been assigned. */
fun complete(csp, s) = if csp is CSP(v, _, _) then maxLevel(s) == v
//│ complete: ((({vars: ⊤} ∧ CSP) ∧ {vals: ⊤}) ∧ {rel: ⊤}) → (LNil ∨ (({head: ({varr: ⊤} ∧ Assign) ∧ {value: ⊤}} ∧ LCons) ∧ {tail: ⊤})) → Bool

/** Test that two queens share neither a column nor a diagonal. */
fun safe(as1, as2) = if as1 is Assign(i, m) and as2 is Assign(j, n) then
  (if m == n then false else true) && (if abs(i - j) == abs(m - n) then false else true)
//│ safe: (({value: Int} ∧ {varr: Int}) ∧ Assign) → (({value: Int} ∧ {varr: Int}) ∧ Assign) → Bool

/** Form the n-queens problem. */
fun queens(n) = CSP(n, n, safe)
//│ queens: ∀α. {α ≤ Int} ⟹ α → (((CSP ∧ {vars: α}) ∧ {vals: α}) ∧ {rel: (({value: Int} ∧ {varr: Int}) ∧ Assign) → (({value: Int} ∧ {varr: Int}) ∧ Assign) → Bool})

queens(6).vars as Int
queens(6).vals as Int
queens(6).rel(Assign(1, 1), Assign(2, 3)) as Bool
//│ Int
//│ Int
//│ Bool

