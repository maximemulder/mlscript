//│ Str
//│ Str

/** Fold from the children up, passing the child results in source order. */
fun foldTree(f, n) = if n is Node(l, c) then f(l, map(x => foldTree(f, x), c))
//│ foldTree: ∀α, β, γ, δ. {γ ≥ δ, β ≤ ({children: ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: X})} ⟹ X} ∧ {lab: α}) ∧ Node} ⟹ (α → (∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: Y})} ⟹ Y) → δ) → (({children: ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: X})} ⟹ X} ∧ {lab: α}) ∧ Node) → δ

/** Keep only children whose folded node labels satisfy the predicate. */
fun filterTree(p, t) =
  /** Rebuild the node with the children that meet the predicate. */
  fun f1(a, cs) = Node(a, filter(x => p(label(x)), cs))
  foldTree(f1, t)
//│ filterTree: (⊥ → Bool) → {lab: ⊥} → {lab: ⊥}

/** Remove children whose labels satisfy the pruning predicate. */
fun prune(p, t) = filterTree(x => if p(x) then false else true, t)
//│ prune: (⊥ → Bool) → {lab: ⊥} → {lab: ⊥}

