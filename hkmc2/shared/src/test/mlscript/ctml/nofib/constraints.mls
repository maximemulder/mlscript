/** Collect leaf labels from left to right. */
fun leaves(t) = if t is
  Node(leaf, LNil()) then LCons(leaf, LNil())
  Node(_, cs) then concat(map(leaves, cs))
//│ leaves: ∀α. (({lab: α} ∧ Node) ∧ {children: LNil}) → ((LCons ∧ {head: α}) ∧ {tail: LNil})

