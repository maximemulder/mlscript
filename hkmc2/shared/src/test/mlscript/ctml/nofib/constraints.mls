/** Mark complete assignments as solutions. */
fun checkComplete(csp, s) = if complete(csp, s) then Known(LNil()) else Unknown()
//│ checkComplete: ((({vars: ⊤} ∧ CSP) ∧ {vals: ⊤}) ∧ {rel: ⊤}) → (LNil ∨ (({head: ({varr: ⊤} ∧ Assign) ∧ {value: ⊤}} ∧ LCons) ∧ {tail: ⊤})) → (Unknown ∨ (Known ∧ {vs: LNil}))

