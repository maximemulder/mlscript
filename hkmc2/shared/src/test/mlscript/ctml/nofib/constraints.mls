:ctml-parse-only // FIXME: Recursive conflict gathering exceeds the 20000-call diagnostic.
/** Gather conflicts, stopping when one does not involve the latest assignment. */
fun combine(ls, acc) = if ls is
  LNil() then acc
  LCons([s, Known(cs)], css) then
    if inList(maxLevel(s), cs) then combine(css, union(cs, acc))
    else cs
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The conflict-set traversal is translation-only.
/** Propagate conflicts and cut the children of newly identified conflict nodes. */
fun bj_(csp, t) =
  /** Retain known outcomes and cut newly conflicted nodes. */
  fun f7(tp2, chs) = if tp2 is
    [a, Known(cs)] then Node([a, Known(cs)], chs)
    [a, Unknown()] then
      let cs_ = Known(combine(map(label, chs), LNil()))
      if knownConflict(cs_) then Node([a, cs_], LNil()) else Node([a, cs_], chs)
  foldTree(f7, t)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The conflict-set traversal is translation-only.
/** Propagate conflict sets upward in the tree. */
fun bj(csp, t) =
  /** Retain known outcomes and otherwise combine child conflicts. */
  fun f6(tp2, chs) = if tp2 is
    [a, Known(cs)] then Node([a, Known(cs)], chs)
    [a, Unknown()] then Node([a, Known(combine(map(label, chs), LNil()))], chs)
  foldTree(f6, t)
//│ CTML translation succeeded.

