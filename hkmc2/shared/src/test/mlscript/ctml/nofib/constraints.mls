/** Backtrack with conflict-directed backjumping. */
fun bjbt(csp, t) = bj(csp, bt(csp, t))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The backtracking and backjumping labellers are translation-only.
/** Backtrack with conflict-directed backjumping and child removal. */
fun bjbt_(csp, t) = bj_(csp, bt(csp, t))
//│ CTML translation succeeded.

/** Combine the conflict sets of the table entries. */
fun collect(ls) = if ls is
  LNil() then LNil()
  LCons(Known(cs), css) then union(cs, collect(css))
//│ collect: ∀α. {α ≤ LNil} ⟹ α → LNil

:ctml-parse-only // FIXME: The inferred collect type accepts only the empty list.
/** Use the first empty domain's conflicts when every value in a domain is excluded. */
fun domainWipeout(csp, t) = if csp is CSP(_, _, _) then
  /** Determine the outcome of one node using its table. */
  fun f8(tp2) = if tp2 is [[as_, cs], tbl] then
    let wipedDomains =
      /** Collect the rows in which every candidate is known to conflict. */
      fun lscomp1(ls) = if ls is
        LNil() then LNil()
        LCons(vs, t1) then
          if all(knownConflict, vs) then LCons(vs, lscomp1(t1)) else lscomp1(t1)
      lscomp1(tbl)
    let cs_ = if null_(wipedDomains) then cs else Known(collect(head(wipedDomains)))
    [as_, cs_]
  mapTree(f8, t)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Cache labelling and domain-wipeout detection are translation-only.
/** Label the tree by forward checking. */
fun fc(csp, t) = domainWipeout(csp, lookupCache(csp, cacheChecks(csp, emptyTable(csp), t)))
//│ CTML translation succeeded.

