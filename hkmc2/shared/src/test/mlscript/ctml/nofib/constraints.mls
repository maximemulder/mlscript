/** Extract solutions after labelling and pruning a problem's assignment tree. */
fun search(labeler, csp) =
  let labelled = labeler(csp, mkTree(csp))
  let viable = prune(x => knownConflict(snd(x)), labelled)
  map(fst, filter(x => knownSolution(snd(x)), leaves(viable)))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The earliest-conflict search is translation-only.
/** Label tree nodes for ordinary backtracking. */
fun bt(csp, t) =
  /** Pair the path with its conflict or completion outcome. */
  fun f3(s) =
    let result = if earliestInconsistency(csp, s) is Some([a, b]) then
      Known(LCons(a, LCons(b, LNil())))
    else checkComplete(csp, s)
    [s, result]
  mapTree(f3, t)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Nested recursive table initialization exceeds the 20000-call budget.
/** Initialize the backmarking table, including its leading empty row. */
fun emptyTable(csp) = if csp is CSP(vars, vals, _) then
  /** Build one row per variable. */
  fun lscomp1(ls) = if ls is
    LNil() then LNil()
    LCons(_, t1) then
      /** Set one entry per candidate value to unknown. */
      fun lscomp2(ls) = if ls is
        LNil() then LNil()
        LCons(_, t2) then LCons(Unknown(), lscomp2(t2))
      LCons(lscomp2(enumFromTo(1, vals)), lscomp1(t1))
  LCons(LNil(), lscomp1(enumFromTo(1, vars)))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Nested ranges and table zipping exceed the 20000-call budget.
/** Cache new conflicts between the latest assignment and future candidates. */
fun fillTable(s, csp, tbl) = if s is
  LNil() then tbl
  LCons(Assign(var_, val_), _) and csp is CSP(vars, vals, rel) then
    /** Record a conflict when the candidate has no cached outcome. */
    fun f4(cs, varval) = if varval is [varr, vall] and cs is Unknown() then
      if rel(Assign(var_, val_), Assign(varr, vall)) then cs
      else Known(LCons(var_, LCons(varr, LNil())))
    else cs
    /** Build a row of candidate assignments for each future variable. */
    fun lscomp1(ls) = if ls is
      LNil() then LNil()
      LCons(varrr, t1) then
        /** Pair the variable with each candidate value in order. */
        fun lscomp2(ls) = if ls is
          LNil() then LNil()
          LCons(valll, t2) then LCons([varrr, valll], lscomp2(t2))
        LCons(lscomp2(enumFromTo(1, vals)), lscomp1(t1))
    zipWith((x, y) => zipWith(f4, x, y), tbl, lscomp1(enumFromTo(var_ + 1, vars)))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The lookup and tree mapping exceed the 20000-call budget.
/** Label the nodes with their cached conflicts, retaining the tables. */
fun lookupCache(csp, t) =
  /** Read the selected value's entry from the current table row. */
  fun f5(csp, tp) = if tp is
    [LNil(), tbl] then [[LNil(), Unknown()], tbl]
    [LCons(a, as_), tbl] then
      let tableEntry = atIndex(value(a) - 1, head(tbl))
      let cs = if tableEntry is Unknown() then checkComplete(csp, LCons(a, as_)) else tableEntry
      [[LCons(a, as_), cs], tbl]
  mapTree(x => f5(csp, x), t)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The table update is translation-only.
/** Carry the cache table along each path, updating it before visiting a child. */
fun cacheChecks(csp, tbl, n) = if n is Node(s, cs) then
  Node([s, tbl], map(x => cacheChecks(csp, fillTable(s, csp, tail(tbl)), x), cs))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Cache initialization, update, and lookup are translation-only.
/** Label the tree by backmarking. */
fun bm(csp, t) = mapTree(fst, lookupCache(csp, cacheChecks(csp, emptyTable(csp), t)))
//│ CTML translation succeeded.

/** Keep the first conflict list in order and append the unseen elements of the second. */
fun union(xs, ys) =
  let eq = (x, y) => x == y
  append(xs, foldl((acc, y) => deleteBy(eq, y, acc), nubBy(eq, ys), xs))
//│ union: ∀α, β, γ, δ. {α ≥ {γ ≤ α} ⟹ γ, δ ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: δ})} ⟹ ((∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X) ∧ (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: X})} ⟹ X)) → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: X})} ⟹ X) → δ

// The second argument may contain conflicts when the first argument is empty.
