:ctml
:import NofibPrelude.mls
//│ Imported 15 member(s)

// Source: hkmc2/shared/src/test/mlscript-compile/nofib/cryptarithm1.mls.
// Source lists use LNil()/LCons; the fixed-length digit pattern is preserved.

/** Assemble the six source digits without changing their decimal positions. */
fun expand(a, b, c, d, e, f) = f + (e * 10) + (d * 100) + (c * 1000) + (b * 10000) + (a * 100000)
//│ expand: Int → Int → Int → Int → Int → Int → Int

/** Test THIRTY + 5 * TWELVE = NINETY on exactly ten digit bindings. */
fun condition(thirywelvn) = if thirywelvn is
  LCons(t, LCons(h, LCons(i, LCons(r, LCons(y, LCons(w, LCons(e, LCons(l, LCons(v, LCons(n, LNil())))))))))) then
    (expand(t, h, i, r, t, y) + 5 * expand(t, w, e, l, v, e)) == expand(n, i, n, e, t, y)
//│ condition: (({tail: ({tail: ({tail: ({tail: ({tail: ({tail: ({tail: ({tail: ({tail: ({head: Int} ∧ LCons) ∧ {tail: LNil}} ∧ {head: Int}) ∧ LCons} ∧ {head: Int}) ∧ LCons} ∧ {head: Int}) ∧ LCons} ∧ {head: Int}) ∧ LCons} ∧ {head: Int}) ∧ LCons} ∧ {head: Int}) ∧ LCons} ∧ {head: Int}) ∧ LCons} ∧ {head: Int}) ∧ LCons} ∧ {head: Int}) ∧ LCons) → Bool

expand(1, 2, 3, 4, 5, 6) as Int
//│ Int

condition(LCons(0, LCons(1, LCons(2, LCons(3, LCons(4, LCons(5, LCons(6, LCons(7, LCons(8, LCons(9, LNil()))))))))))) as Bool
//│ Bool

:te
expand(1, 2, 3, 4, 5, "bad")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
//│ Typing error tree:
//│   α ≤ Str → β
//│     Int → Int ≤ Str → β
//│       Str ≤ Int

:te
