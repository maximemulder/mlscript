:fixme // FIXME: The implicit recursive witness for take's enumFromTo argument is not inferred.
/** Preserve the source's inclusive ranges and ten-digit truncation for every iteration. */
fun testCryptarithm_nofib(n) =
  map((i =>
    let p0 = take(10, enumFromTo(0, 9 + i))
    filter(condition, permutations(p0))), enumFromTo(1, n))
