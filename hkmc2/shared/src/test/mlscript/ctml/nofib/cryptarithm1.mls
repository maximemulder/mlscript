/** Enumerate permutations by inserting the head into each permutation of the tail. */
fun permutations(ls) = if ls is
  LNil() then LCons(LNil(), LNil())
  LCons(j, js) then
    fun lscomp1(p1) = if p1 is
      LNil() then LNil()
      LCons(pjs, t1) then
        fun lscomp2(p2) = if p2 is
          LNil() then lscomp1(t1)
          LCons(r, t2) then LCons(r, lscomp2(t2))
        lscomp2(addj(j, pjs))
    lscomp1(permutations(js))
//│ permutations: ∀α. (∀β. {β ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: β})} ⟹ β) → (∀γ. {γ ≥ LNil ∨ ((LCons ∧ {head: ∀δ. {δ ≥ ((LCons ∧ {head: α}) ∧ {tail: δ}) ∨ LNil} ⟹ δ}) ∧ {tail: γ})} ⟹ γ)

permutations(LNil()) as IntLists
permutations(LCons(1, LCons(2, LNil()))) as IntLists
//│ IntLists
//│ IntLists

