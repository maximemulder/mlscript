/** Insert j at every position, preserving the source order of generated lists. */
fun addj(j, ls) = if ls is
  LNil() then LCons(LCons(j, LNil()), LNil())
  LCons(k, ks) then
    fun lscomp(p1) = if p1 is
      LNil() then LNil()
      LCons(h1, t1) then LCons(LCons(k, h1), lscomp(t1))
    LCons(LCons(j, LCons(k, ks)), lscomp(addj(j, ks)))
//│ addj: ∀α. α → (∀β. {β ≥ ((LCons ∧ {head: α}) ∧ {tail: β}) ∨ LNil} ⟹ β) → (∀γ. {γ ≥ LNil ∨ ((LCons ∧ {head: ∀δ. {δ ≥ ((LCons ∧ {head: α}) ∧ {tail: δ}) ∨ LNil} ⟹ δ}) ∧ {tail: γ})} ⟹ γ)

/** Expected element and outer-list types for insertion results. */
type IntList = [X restricts (LNil | (LCons & {head: Int} & {tail: X}))] -> X
type IntLists = [X restricts (LNil | (LCons & {head: IntList} & {tail: X}))] -> X
//│ IntList = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X
//│ IntLists = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: IntList}) ∧ {tail: X})} ⟹ X

addj(1, LNil()) as IntLists
addj(1, LCons(2, LCons(3, LNil()))) as IntLists
//│ IntLists
//│ IntLists

