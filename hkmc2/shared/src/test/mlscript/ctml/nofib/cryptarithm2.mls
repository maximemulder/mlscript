/** A successful lookup. */
data class Some(x)
//│ Some: ∀α. α → (Some ∧ {x: α})

/** A missing lookup. */
data class None()
//│ None: Unit → None

:ctml-parse-only // FIXME: Inference exceeds a 20000-call solver budget.
/** Find the first strict-equality match in an association list. */
fun lookup(k, t) = if t is
  LNil() then None()
  LCons([x, v], rest) then if k === x then Some(v) else lookup(k, rest)
//│ CTML translation succeeded.

/** Project the value of a successful lookup. */
fun fromSome(s) = if s is Some(x) then x
//│ fromSome: ∀α. ({x: α} ∧ Some) → α

/** Delete one occurrence using strict equality. */
fun delete_(xs, e) = deleteBy((x, y) => x === y, e, xs)
//│ delete_: ∀α, Y. {Y ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: Y})} ⟹ (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X) → ⊤ → Y

/** Delete each requested element in order. */
fun listDiff(a, ls) = foldl(delete_, a, ls)
//│ listDiff: ∀α, β, γ, Y. {α ≤ ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: X})} ⟹ X, Y ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: Y})} ⟹ α → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: X})} ⟹ X) → (α ∨ Y)

