:ctml-parse-only // FIXME: Inference exceeds a 20000-call solver budget.
/** Assign a fresh digit, preserving the order of alternatives. */
fun permute(c) =
  /** Enumerate the remaining choices and update the state for each choice. */
  fun choose(st) =
    let xs = digits(st)
    let choices = lift(map(x => [x, listDiff(xs, LCons(x, LNil()))], xs))
    /** Record the choice and return its digit. */
    fun update(iis) = if iis is [i, iss] then
      bind(put(Digits(iss, LCons([c, i], digitEnv(st)))), _p => return_(i))
    bind(choices, update)
  bind(get, choose)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Lookup and permutation are translation-only.
/** Reuse an assignment when present, or choose a fresh digit. */
fun select(c) =
  /** Resolve the character in the current environment. */
  fun find(st) = if lookup(c, digitEnv(st)) is
    Some(r) then return_(r)
    None() then permute(c)
  bind(get, find)
//│ CTML translation succeeded.

/** Return the tail, with an empty list as the empty case. */
fun rest(ls) = if ls is
  LNil() then LNil()
  LCons(x, xs) then xs
//│ rest: ∀α, β. {β ≥ ({α ≤ LNil} ⟹ LNil) ∧ ({α ≤ ({tail: β} ∧ LCons) ∧ {head: ⊤}} ⟹ ⊥), α ≤ ¬({β ≥ LNil} ⟹ ¬LNil) ∨ (({tail: β} ∧ LCons) ∧ {head: ⊤})} ⟹ α → β

:ctml-parse-only // FIXME: Digit selection and monadic traversals are translation-only.
/** Solve one column at a time, passing the carry to the next column. */
fun solve(tops, bots, carry) = if bots is
  LCons(bot, botss) then
    let column = if tops is
      LNil() then return_(carry)
      LCons(top, _) then bind(mapM(select, top), topNS => return_(sum(topNS) + carry))
    /** Check the bottom digit before advancing to the next column. */
    fun checkTop(topN) =
      /** Require this column to match its bottom digit. */
      fun checkBottom(botN) =
        bind(guard(intMod(topN, 10) === botN), _s => solve(rest(tops), botss, intDiv(topN, 10)))
      bind(select(bot), checkBottom)
    bind(column, checkTop)
  LNil() and tops is LNil() and carry === 0 then return_(())
  else StateT(_p => LNil())
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The column solver and its list traversals are translation-only.
/** Solve the puzzle, validate the equality, and render its first solution. */
fun puzzle(top, bot) =
  let solution = solve(transpose(map(reverse, top)), reverse(bot), 0)
  let answer = if execStateT(solution, Digits(enumFromTo(0, 9), LNil())) is LCons(a, _) then a
  let env = digitEnv(answer)
  let look = c => fromSome(lookup(c, env))
  let expand = ls => foldl((a, b) => a * 10 + look(b), 0, ls)
  let topVal = sum(map(xs => expand(xs), top))
  let botVal = expand(bot)
  /** Format one character-to-digit assignment. */
  fun renderAssignment(assignment) = if assignment is [c, i] then
    LCons(c, append(nofibStringToList(" => "), nofibStringToList(stringOfInt(i))))
  if
    10 < listLen(nubBy((x, y) => x === y, append(concat(top), bot))) then raiseError("error")
    topVal == botVal then unlines(map(renderAssignment, env))
    else raiseError("error")
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The puzzle solver is translation-only.
/** Build the source puzzle, including its large-input perturbation. */
fun testCryptarithm2_nofib(n) =
  let thirty = nofibStringToList("THIRTY")
  let twelve1 = nofibStringToList("TWELVE")
  let twelve2 = nofibStringToList("TWELVE")
  let twelve3 = nofibStringToList("TWELVE")
  let twelve4 = nofibStringToList("TWELVE")
  let twelve5 = append(nofibStringToList("TWELVE"),
    if 999999 < n then nofibStringToList("1") else LNil())
  let args = LCons(thirty, LCons(twelve1, LCons(twelve2, LCons(twelve3, LCons(twelve4,
    LCons(twelve5, LNil()))))))
  puzzle(args, nofibStringToList("NINETY"))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The benchmark harness is translation-only.
/** Render the source character-list result for benchmark input 1. */
fun main() = testCryptarithm2_nofib(1).toString()
