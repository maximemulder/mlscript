//│ ∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: Y})} ⟹ Y

/** Wrap a computation producing a list of result-state pairs. */
data class StateT(run)
//│ StateT: ∀α. α → (StateT ∧ {run: α})

/** Run a state computation from a supplied state. */
fun runStateT(m, s) = if m is StateT(run) then run(s)
//│ runStateT: ∀α, β. ({run: α → β} ∧ StateT) → α → β

/** Sequence nondeterministic state computations in source list order. */
fun bind(m, f) =
  /** Run each continuation from the state produced by its corresponding result. */
  fun run(s) =
    /** Apply the continuation to one result-state pair. */
    fun next(result) = if result is [a, ss] then runStateT(f(a), ss)
    concat(map(next, runStateT(m, s)))
  StateT(run)
//│ bind: ∀α, β. α → β → (StateT ∧ {run: ∀γ, δ, ε, ζ, η, θ, ι, κ, λ, μ, ν, ξ. {ζ ≤ ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: δ}) ∧ {tail: X})} ⟹ X, ξ ≤ ∀R. {R ≥ LNil ∨ ((LCons ∧ {head: η}) ∧ {tail: R})} ⟹ R, δ ≤ ⟨θ, κ⟩, ι ≥ θ, ν ≥ λ, μ ≤ {run: ν → ξ} ∧ StateT, β ≤ ι → μ, λ ≥ κ, α ≤ {run: ε → ζ} ∧ StateT, ε ≥ γ} ⟹ γ → (∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: η}) ∧ {tail: Y})} ⟹ Y)})

/** Return a result without changing the state. */
fun return_(a) = StateT(s => LCons([a, s], LNil()))
//│ return_: ∀α. α → (StateT ∧ {run: ∀β. β → ((LCons ∧ {head: ⟨α, β⟩}) ∧ {tail: LNil})})

:ctml-parse-only // FIXME: Subtype search repeats on the recursive state-list constraints.
/** Apply a state computation to each element using the source right fold. */
fun mapM(f, ls) =
  /** Prepend the result of the current computation to the remaining results. */
  fun step(a, r) = bind(f(a), x => bind(r, xs => return_(LCons(x, xs))))
  foldr(step, return_(LNil()), ls)
//│ CTML translation succeeded.

/** Lift a list of alternatives into a state computation. */
fun lift(ls) = StateT(s => concat(map(x => LCons([x, s], LNil()), ls)))
//│ lift: ∀α. α → (StateT ∧ {run: ∀β, γ, δ. {δ ≥ ⟨γ, β⟩, α ≤ ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: X})} ⟹ X} ⟹ β → (∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: δ}) ∧ {tail: Y})} ⟹ Y)})

/** Run a computation and retain the possible final states. */
fun execStateT(m, s) =
  /** Collect a final state from one alternative. */
  fun stateOnly(result) = if result is [a, ss] then LCons(ss, LNil())
  concat(map(stateOnly, runStateT(m, s)))
//│ execStateT: ∀α, β, γ, Y. {β ≤ ⟨⊤, γ⟩, Y ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: Y})} ⟹ ({run: α → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: X})} ⟹ X)} ∧ StateT) → α → Y

/** Keep the current state precisely when the guard holds. */
fun guard(b) = if b then StateT(s => LCons([(), s], LNil())) else StateT(s => LNil())
//│ guard: Bool → ((StateT ∧ {run: ⊤ → LNil}) ∨ (StateT ∧ {run: ∀α. α → ((LCons ∧ {head: ⟨Unit, α⟩}) ∧ {tail: LNil})}))

/** Replace the current state. */
fun put(s) = StateT(x => LCons([(), s], LNil()))
//│ put: ∀α. α → (StateT ∧ {run: ⊤ → ((LCons ∧ {head: ⟨Unit, α⟩}) ∧ {tail: LNil})})

/** Read the current state. */
val get = StateT(s => LCons([s, s], LNil()))
//│ get: StateT ∧ {run: ∀α. α → ((LCons ∧ {head: ⟨α, α⟩}) ∧ {tail: LNil})}

/** Proper list of available digits. */
type IntList = [X restricts (LNil | (LCons & {head: Int} & {tail: X}))] -> X
//│ IntList = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X

/** Proper list of character and digit assignments. */
type DigitEnv = [X restricts (LNil | (LCons & {head: [Str, Int]} & {tail: X}))] -> X
//│ DigitEnv = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: ⟨Str, Int⟩}) ∧ {tail: X})} ⟹ X

/** The remaining digits and the current assignments. */
data class Digits(i: IntList, c: DigitEnv)
//│ Digits: ∀α, β. {β ≤ DigitEnv, α ≤ IntList} ⟹ α → β → ((Digits ∧ {i: α}) ∧ {c: β})

/** Project the remaining digits. */
fun digits(d) = if d is Digits(a, b) then a
//│ digits: ∀α. (({c: ⊤} ∧ {i: α}) ∧ Digits) → α

/** Project the list of assigned digits. */
fun digitEnv(d) = if d is Digits(a, b) then b
//│ digitEnv: ∀α. (({c: α} ∧ {i: ⊤}) ∧ Digits) → α

