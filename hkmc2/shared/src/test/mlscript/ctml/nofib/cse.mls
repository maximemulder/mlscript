/** Run CSE on the source prefix of examples for each index from one to n. */
fun testCse_nofib(n) = map(
  i => map(
    cse,
    take(intMod(i, 6), LCons(example0, LCons(example1, LCons(example2,
      LCons(example3, LCons(example4, LCons(example5, LNil())))))))
  ),
  enumFromTo(1, n)
)
//│ CTML translation succeeded.

