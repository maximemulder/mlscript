/** Override one source mapping entry without calling f at that entry. */
fun newlyDefined(x, fx, f, y) = if x === y then fx else f(y)
//│ newlyDefined: ∀α, β, γ. ⊤ → α → (β → γ) → β → (γ ∨ α)

