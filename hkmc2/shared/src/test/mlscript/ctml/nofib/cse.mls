// Source: hkmc2/shared/src/test/mlscript-compile/nofib/cse.mls.
// State computations return [new state, answer], preserving the source component order.
// Ordinary definitions are unannotated; assertions below check their inferred types.

/** Return an answer without changing the state. */
fun retURN(a) = s => [s, a]
//│ retURN: ∀α, β. α → β → ⟨β, α⟩

/** Run m, then pass its answer and resulting state to the next computation. */
fun bind(m, f) = s => if m(s) is [s_, a] then f(a)(s_)
//│ bind: ∀α, β, γ, δ. (α → ⟨β, γ⟩) → (γ → β → δ) → α → δ

/** Run the state computation returned by m in its resulting state. */
fun join(m) = s => if m(s) is [s_, ma] then ma(s_)
//│ join: ∀α, β, γ. (α → ⟨β, β → γ⟩) → α → γ

/** Transform the answer of a computation while preserving its resulting state. */
fun mmap(f, m) = s => if m(s) is [s_, a] then [s_, f(a)]
//│ mmap: ∀α, β, γ, δ. (γ → δ) → (α → ⟨β, γ⟩) → α → ⟨β, δ⟩

/** Select a computation using the Boolean answer of c. */
fun mif(c, t, f) = bind(c, cond => if cond then t else f)
//│ mif: ∀α, β, γ. (α → ⟨β, Bool⟩) → (β → γ) → (β → γ) → α → γ

/** Run a computation from the supplied state and return its answer. */
fun startingWith(m, v) = if m(v) is [final, answer] then answer
//│ startingWith: ∀α, β. (α → ⟨⊤, β⟩) → α → β

/** Read the state without changing it. */
fun fetch(s) = [s, s]
//│ fetch: ∀α. α → ⟨α, α⟩

/** Apply f to the state without changing the state. */
fun fetchWith(f) = s => [s, f(s)]
//│ fetchWith: ∀α, β. (α → β) → α → ⟨α, β⟩

/** Replace the state using f and return the old state. */
fun update(f) = s => [f(s), s]
//│ update: ∀α, β. (α → β) → α → ⟨β, α⟩

/** Replace the state with s_ and return the old state. */
fun set_(s_) = s => [s_, s]
//│ set_: ∀α, β. α → β → ⟨α, β⟩

/** Increment the integer state and return its old value. */
val incr = update(x => x + 1)
//│ incr: ∀α. {α ≤ Int} ⟹ α → ⟨Int, α⟩

