/** Compare two lists element by element with source equality. */
fun listEq(xs, ys) = if
  xs is LNil() and ys is LNil() then true
  xs is LCons(hx, tx) and ys is LCons(hy, ty) and (hx == hy) then listEq(tx, ty)
  else false
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds a 20000-call diagnostic budget.
/** Collect the right-fold results, ending with the initial accumulator. */
fun scanr(f, q, ls) = if ls is
  LNil() then LCons(q, LNil())
  LCons(x, xs) and scanr(f, q, xs) is LCons(q, t) then LCons(f(x, q), LCons(q, t))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds a 20000-call diagnostic budget.
/** Fold from the right, supplying the current element first. */
fun foldr(f, z, xs) = if xs is
  LNil() then z
  LCons(h, t) then f(h, foldr(f, z, t))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds a 20000-call diagnostic budget.
/** Traverse the source list with state effects from left to right. */
fun mmapl(f, aas) = if aas is
  LNil() then retURN(LNil())
  LCons(a, as_) then
    bind(f(a), b => bind(mmapl(f, as_), bs => retURN(LCons(b, bs))))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds a 20000-call diagnostic budget.
/** Traverse the source list with state effects from right to left. */
fun mmapr(f, xs) = if xs is
  LNil() then retURN(LNil())
  LCons(x, xs) then
    bind(mmapr(f, xs), ys => bind(f(x), y => retURN(LCons(y, ys))))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds a 20000-call diagnostic budget.
/** Fold the source list with left-to-right state effects. */
fun mfoldl(f, a, xs) = if xs is
  LNil() then retURN(a)
  LCons(x, xs) then bind(f(a, x), fax => mfoldl(f, fax, xs))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds a 20000-call diagnostic budget.
/** Fold the source list with right-to-left state effects. */
fun mfoldr(f, a, xs) = if xs is
  LNil() then retURN(a)
  LCons(x, xs) then bind(mfoldr(f, a, xs), y => f(x, y))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Tree labelling depends on the unchecked mmapl definition.
/** Label the tree in preorder using the stateful left-to-right traversal. */
fun labelTree(t) =
  fun label(t) = if t is Node(x, xs) then
    bind(incr, n => bind(mmapl(label, xs), ts => retURN(Node([n, x], ts))))
  startingWith(label(t), 0)
//│ CTML translation succeeded.

/** Emit graph entries in preorder, encoding each source triple as a nested pair. */
fun ltGraph(t) =
  fun labelOf(t) = if t is Node([n, x], xs) then n
  if t is Node([n, x], xs) then
    LCons([n, [x, map(labelOf, xs)]], concat(map(ltGraph, xs)))
//│ ltGraph: ∀α, β, γ, δ, ε, ζ. {ζ ≥ ⟨α, ⟨β, ∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: δ}) ∧ {tail: Y})} ⟹ Y⟩⟩, ε ≤ ({b: (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: X})} ⟹ X) ∧ (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: ε}) ∧ {tail: X})} ⟹ X)} ∧ {a: ⟨α, β⟩}) ∧ Node, γ ≤ ({b: ⊤} ∧ {a: ⟨δ, ⊤⟩}) ∧ Node} ⟹ (({b: (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: X})} ⟹ X) ∧ (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: ε}) ∧ {tail: X})} ⟹ X)} ∧ {a: ⟨α, β⟩}) ∧ Node) → ((LCons ∧ {head: ⟨α, ⟨β, ∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: δ}) ∧ {tail: Y})} ⟹ Y⟩⟩}) ∧ {tail: ∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: ζ}) ∧ {tail: Y})} ⟹ Y})

/** Report whether the label was visited, adding it to the state on the first visit. */
fun visited(n) =
  bind(fetch, us => if inList(n, us) then retURN(true)
    else bind(set_(LCons(n, us)), _p => retURN(false)))
//│ visited: ∀α, β. {β ≤ ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: ⊤}) ∧ {tail: X})} ⟹ X} ⟹ α → β → (⟨(LCons ∧ {head: α}) ∧ {tail: β}, Bool⟩ ∨ ⟨β, Bool⟩)

// Check graph construction and visited-state tracking on concrete inputs.
ltGraph(Node([1, "leaf"], LNil())) as LCons & {head: [Int, [Str, LNil | LCons]]}
visited(1, LCons(2, LNil())) as [LNil | LCons, Bool]
//│ LCons ∧ {head: ⟨Int, ⟨Str, LNil ∨ LCons⟩⟩}
//│ ⟨LNil ∨ LCons, Bool⟩

:ctml-parse-only // FIXME: This stage depends on the unchecked foldr and listEq definitions.
/** Merge entries with the same symbol and the same redirected child labels. */
fun findCommon(ls) =
  fun sim(n_s_cs, r_lg) = if n_s_cs is [n, [s, cs]] and r_lg is [r, lg] then
    let rcs = map(r, cs)
    fun lscomp(ls) = if ls is
      LNil() then LNil()
      LCons([m, [s_, cs_]], t) and
        s === s_ and listEq(cs_, rcs) then LCons(m, lscomp(t))
        else lscomp(t)
    let ms = lscomp(lg)
    if null_(ms)
    then [r, LCons([n, [s, rcs]], lg)]
    else [x => newlyDefined(n, head(ms), r, x), lg]
  if foldr(sim, [x => x, LNil()], ls) is [a, b] then b else raiseError(ls.toString())
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Tree labelling and common-entry merging are translation-only.
/** Compute the graph with common subexpressions merged. */
fun cse(t) = findCommon(ltGraph(labelTree(t)))
//│ CTML translation succeeded.

