// The source tree tag uses the same structural constructor representation as the shared lists.
// Recursive tree/list relationships are obligations of consumers, not constructor annotations.
/** Source Node stores a label and its ordered list of children. */
data class Node(a, b)
//│ Node: ∀α, β. α → β → ((Node ∧ {a: α}) ∧ {b: β})

/** Construct the source binary addition node without changing child order. */
fun plus_(x, y) = Node("+", LCons(x, LCons(y, LNil())))
//│ plus_: ∀α, β. α → β → ((Node ∧ {a: Str}) ∧ {b: (LCons ∧ {head: α}) ∧ {tail: (LCons ∧ {head: β}) ∧ {tail: LNil}}})

/** Construct the source binary multiplication node without changing child order. */
fun mult_(x, y) = Node("*", LCons(x, LCons(y, LNil())))
//│ mult_: ∀α, β. α → β → ((Node ∧ {a: Str}) ∧ {b: (LCons ∧ {head: α}) ∧ {tail: (LCons ∧ {head: β}) ∧ {tail: LNil}}})

/** Construct the source product node over the supplied children. */
fun prod(xs) = Node("X", xs)
//│ prod: ∀α. α → ((Node ∧ {a: Str}) ∧ {b: α})

