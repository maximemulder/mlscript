:ctml-parse-only // FIXME: Keyword splitting and response cycling are translation-only.
/** Split keyword phrases and start an independent response cycle for each entry. */
val initial =
  /** Prepare all keyword entries in order. */
  fun lscomp(ls) = if ls is
    LNil() then LNil()
    LCons([k, rs], t) then LCons([words(k), cycle(rs)], lscomp(t))
  [lscomp(respMsgs), cycle(repeatMsgs)]
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds the 20000-call solver budget.
/** Test a strict prefix against a delayed list of words. */
fun prefix(xxs, yys) = if xxs is
  LNil() then true
  LCons(x, xs) then
    if force(yys) is
      LzNil() then false
      LzCons(y, ys) then listEq(x, y) && prefix(xs, ys)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds the 20000-call solver budget.
/** Lazily enumerate all nonempty suffixes of a strict list. */
fun tails(xs) = delay(() =>
  if xs is
    LNil() then LzNil()
    LCons(_, t) then LzCons(xs, tails(t))
)
//│ CTML translation succeeded.

/** Convert a whole word to uppercase. */
fun ucase(ls) = map(toUpper, ls)
//│ ucase: ∀α, Y. {Y ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: Y}), α ≤ Str} ⟹ (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X) → Y

:ctml-parse-only // FIXME: The recursive substitution table exhausts the test limit.
/** The word substitutions, with the reversible pairs in both directions. */
val conjugates =
  let oneways = LCons([nofibStringToList("me"), nofibStringToList("you")], LNil())
  let bothways = [nofibStringToList("are"), nofibStringToList("am")] ::
    [nofibStringToList("we're"), nofibStringToList("was")] ::
    [nofibStringToList("you"), nofibStringToList("I")] ::
    [nofibStringToList("your"), nofibStringToList("my")] ::
    [nofibStringToList("I've"), nofibStringToList("you've")] ::
    [nofibStringToList("I'm"), nofibStringToList("you're")] ::
    LNil()
  /** Uppercase the lookup side of every substitution. */
  fun prepare(ls) = map(pair => if pair is [w, r] then [ucase(w), r], ls)
  /** Produce the two directions of each reversible substitution. */
  fun lscomp(ls) = if ls is
    LNil() then LNil()
    LCons([x, y], t) then LCons(LCons([x, y], LCons([y, x], LNil())), lscomp(t))
  prepare(append(oneways, concat(lscomp(bothways))))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The substitution table and word join are translation-only.
/** Substitute words from the user's phrase and join them into a template suffix. */
fun conjug(d, w) =
  /** Use the whole input if the phrase after the keyword is empty. */
  fun maybe(d, xs) = if null_(xs) then d else xs
  /** Substitute the first matching word or keep the input word. */
  fun conj(w) =
    /** Keep substitutions whose uppercase key matches the word. */
    fun lscomp(ls) = if ls is
      LNil() then LNil()
      LCons([w_, m], t) and
        listEq(ucase(w), w_) then LCons(m, lscomp(t))
        else lscomp(t)
    head(append(lscomp(conjugates), LCons(w, LNil())))
  /** Use “me” when the last substituted word is “I”. */
  fun trailingI(ls) =
    /** Choose the final-word form when no words follow it. */
    fun cons(x, xs) =
      if listEq(x, nofibStringToList("I")) && null_(xs) then LCons(nofibStringToList("me"), LNil())
      else LCons(x, xs)
    foldr(cons, LNil(), ls)
  unwords(trailingI(map(conj, maybe(d, w))))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The branch depends on translation-only conjugation and lazy traversals.
/** Lazily construct a reply suffix for each match of the keyword. */
fun replies(key, l) =
  mapLz(x => conjug(l, leave(listLen(key), x)),
    filterLz(ls => prefix(key, lzMap(ucase, ls)), tails(l)))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Reply construction is translation-only.
/** Select the first matching keyword and advance only its response cursor. */
fun answer(st, l) =
  /** Put an unmatched keyword back at the front of the table. */
  fun cons(e, r_es) = if r_es is [r, es] then [r, LCons(e, es)]
  /** Search keyword entries in priority order. */
  fun ans(e_es, l) = if e_es is
    LCons([key, cursor], es) and force(cursor) is LzCons(a, rest) then
      let rs = replies(key, l)
      if nullLz(rs) then cons([key, cursor], ans(es, l))
      else if force(rs) is LzCons(reply, _) then
        [makeResponse(a, reply), LCons([key, rest], es)]
  if ans(keyTabOf(st), l) is [response, kt] then [response, newKeyTab(kt, st)]
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Answer generation is translation-only, and repeated expects a strict cursor.
/** Respond to each input line, keeping two trailing newlines per response. */
fun session(rs, prev, ls) = if ls is
  LNil() then LNil()
  LCons(l, t) and
    (if listEqBy(listEq, prev, l) then repeated(rs) else answer(rs, l)) is [response, next] then
      append(response, append(nofibStringToList("\n\n"), session(next, l, t)))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Word splitting and the session are translation-only.
/** Run the source conversation on progressively longer prefixes. */
fun testEliza_nofib(n) =
  let input =
    nofibStringToList("Are we alone?") ::
    nofibStringToList("That the Roswell event was actually an alien encounter. Do you agreed?") ::
    nofibStringToList("But why not talk about you, its more fun.") ::
    nofibStringToList("I dont ask, you do") ::
    nofibStringToList("do ray me") ::
    nofibStringToList("Nop, thats because your a computer") ::
    nofibStringToList("you dont") ::
    nofibStringToList("Oh, a paranoid computer, ehh?") ::
    nofibStringToList("Tell me about *your* mother") ::
    nofibStringToList("No, what what was she like?") ::
    nofibStringToList("I'm asking questions, not you") ::
    nofibStringToList("no") ::
    nofibStringToList("yes") ::
    nofibStringToList("but I'm not") ::
    LNil()
  /** Parse the first i modulo 20 lines and run one conversation. */
  fun runPrefix(i) =
    let messages = map(x => words(trim(x)), take(intMod(i, 20), input))
    let nonempty = filter(x => if null_(x) then false else true, messages)
    session(initial, LNil(), nonempty)
  map(runPrefix, enumFromTo(1, n))
//│ CTML translation succeeded.

