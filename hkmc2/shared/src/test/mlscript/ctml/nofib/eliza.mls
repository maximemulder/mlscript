/** Map a strict list into a lazy stream, applying f only when a cell is forced. */
fun lzMap(f, ls) = delay(() =>
  if ls is
    LNil() then LzNil()
    LCons(h, t) then LzCons(f(h), lzMap(f, t))
)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds the 20000-call solver budget.
/** Delay the prefix and force the continuation to obtain a handle when the prefix ends. */
fun appendLz(xs, next) = if xs is
  LNil() then force(next)
  LCons(h, t) then delay(() => LzCons(h, appendLz(t, next)))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The append with a delayed continuation is translation-only.
/** Cycle through the responses in order. */
fun cycle(xs) = appendLz(xs, delay(() => cycle(xs)))
//│ CTML translation succeeded.

/** Test whether the character is an ordinary space. */
fun isSpace(c) = c === " "
//│ isSpace: ⊤ → Bool

:ctml-parse-only // FIXME: Inference exceeds the 20000-call solver budget.
/** Skip spaces and split a character list into words. */
fun words(s) = if leaveWhile(isSpace, s) is
  LNil() then LNil()
  LCons(h, t) and break_(isSpace, LCons(h, t)) is [w, rest] then LCons(w, words(rest))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds the 20000-call solver budget.
/** Join words with one space between consecutive entries. */
fun unwords(ws) =
  /** Prepend a separator before each remaining word. */
  fun go(rest) = if rest is
    LNil() then LNil()
    LCons(w, t) then LCons(" ", append(w, go(t)))
  if ws is
    LNil() then LNil()
    LCons(w, t) then append(w, go(t))
//│ CTML translation succeeded.

/** Test whether forcing the stream produces an empty node. */
fun nullLz(ls) = if force(ls) is
  LzNil() then true
  LzCons(_, _) then false
//│ nullLz: ∀α. {α ≤ LzNil ∨ ((LzCons ∧ {head: ⊤}) ∧ {tail: ⊤})} ⟹ (Delayed ∧ {resume: Unit → α}) → (({α ≤ LzNil} ⟹ Bool) ∧ ({α ≤ (LzCons ∧ {head: ⊤}) ∧ {tail: ⊤}} ⟹ Bool))

/** Trim spaces and punctuation from both ends of the input. */
fun trim(ls) =
  /** Discard trailing punctuation until a retained character is seen. */
  fun cons(x, xs) = if inList(x, nofibStringToList(" .!?,")) and null_(xs) then LNil() else LCons(x, xs)
  foldr(cons, LNil(), leaveWhile(x => inList(x, nofibStringToList(" .!?,")), ls))
//│ trim: (∀X. {X ≥ LNil} ⟹ X) → LNil

trim(LNil()) as LNil
//│ LNil

