// The source pattern expects a strict list here, although initial stores a delayed stream.
// A repeated input hits a match error in the source. Keep that pattern for the inference port.
/** Take the next repeated-input response and advance its cursor. */
fun repeated(kt_rp) = if kt_rp is [kt, LCons(r, rp)] then [r, [kt, rp]]
//│ repeated: ∀α, β, γ. ⟨α, ({tail: γ} ∧ {head: β}) ∧ LCons⟩ → ⟨β, ⟨α, γ⟩⟩

/** Replace the keyword table, keeping the repeated-input cursor. */
fun newKeyTab(kt_, kt_rp) = if kt_rp is [kt, rp] then [kt_, rp]
//│ newKeyTab: ∀α, β. α → ⟨⊤, β⟩ → ⟨α, β⟩

/** Extract the keyword table from the session state. */
fun keyTabOf(kt_rp) = if kt_rp is [kt, rp] then kt
//│ keyTabOf: ∀α. ⟨α, ⊤⟩ → α

