/** Fill a template that starts with a question mark or period. */
fun makeResponse(cs, us) = if cs is
  LCons(c, t) and (c === "?" || c === ".") then
    append(t, LCons(" ", append(us, LCons(c, LNil()))))
  else cs
//│ CTML translation succeeded.

/** Right-associative strict list construction for the source tables. */
fun (::)(head, tail) = LCons(head, tail)
//│ ::: ∀α, β. α → β → ((LCons ∧ {head: α}) ∧ {tail: β})

