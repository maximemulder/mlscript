//│           β ≤ ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: δ}) ∧ {tail: X})} ⟹ X
//│             (LCons ∧ {head: ε}) ∧ {tail: ζ} ≤ ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: δ}) ∧ {tail: X})} ⟹ X
//│               (LCons ∧ {head: ε}) ∧ {tail: ζ} ≤ {η ≥ LNil ∨ ((LCons ∧ {head: δ}) ∧ {tail: η})} ⟹ η
//│                 (LCons ∧ {head: ε}) ∧ {tail: ζ} ≤ η
//│                   (LCons ∧ {head: ε}) ∧ {tail: ζ} ≤ LNil
//│                     LCons ∧ {head: ε} ≤ LNil
//│                       LCons ≤ LNil
//│                       {head: ε} ≤ LNil
//│                         ε ≤ ⊥
//│                           Int ≤ ⊥
//│                     {tail: ζ} ≤ LNil
//│                       ζ ≤ ⊥
//│                         θ ≤ ⊥
//│                           LNil ≤ ⊥
//│                   (LCons ∧ {head: ε}) ∧ {tail: ζ} ≤ (LCons ∧ {head: δ}) ∧ {tail: η}
//│                     (LCons ∧ {head: ε}) ∧ {tail: ζ} ≤ LCons ∧ {head: δ}
//│                       (LCons ∧ {head: ε}) ∧ {tail: ζ} ≤ {head: δ}
//│                         LCons ∧ {head: ε} ≤ {head: δ}
//│                           LCons ≤ {head: δ}
//│                           {head: ε} ≤ {head: δ}
//│                             ε ≤ δ
//│                               ε ≤ Str
//│                                 Int ≤ Str
//│                         {tail: ζ} ≤ {head: δ}
//│                           ζ ≤ ⊥
//│                             θ ≤ ⊥
//│                               LNil ≤ ⊥

nullLz(delay(() => LzNil())) as Bool
nullLz(delay(() => LzCons("response", delay(() => LzNil())))) as Bool
//│ Bool
//│ Bool

// A strict cursor returns a response and leaves the keyword table unchanged.
repeated([1, LCons("response", LNil())]) as [Str, [Int, LNil]]
newKeyTab(2, ["old table", true]) as [Int, Bool]
keyTabOf([1, true]) as Int
//│ ⟨Str, ⟨Int, LNil⟩⟩
//│ ⟨Int, Bool⟩
//│ Int

// The delayed cursor used by initial cannot satisfy the source repeated pattern.
:te
repeated([1, delay(() => LzCons("response", delay(() => LzNil())))])
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. ⟨α, ({tail: γ} ∧ {head: β}) ∧ LCons⟩ → ⟨β, ⟨α, γ⟩⟩ ≤ ⟨Int, δ⟩ → ε.
//│ Typing error tree:
//│   ∀α, β, γ. ⟨α, ({tail: γ} ∧ {head: β}) ∧ LCons⟩ → ⟨β, ⟨α, γ⟩⟩ ≤ ⟨Int, δ⟩ → ε
//│     ⟨ζ, ({tail: η} ∧ {head: θ}) ∧ LCons⟩ → ⟨θ, ⟨ζ, η⟩⟩ ≤ ⟨Int, δ⟩ → ε
//│       ⟨Int, δ⟩ ≤ ⟨ζ, ({tail: η} ∧ {head: θ}) ∧ LCons⟩
//│         δ ≤ ({tail: η} ∧ {head: θ}) ∧ LCons
//│           Delayed ∧ {resume: Unit → ι} ≤ ({tail: η} ∧ {head: θ}) ∧ LCons
//│             Delayed ∧ {resume: Unit → ι} ≤ {tail: η} ∧ {head: θ}
//│               Delayed ∧ {resume: Unit → ι} ≤ {tail: η}
//│                 Delayed ≤ {tail: η}
//│                 {resume: Unit → ι} ≤ {tail: η}
//│                   Unit → ι ≤ ⊥
