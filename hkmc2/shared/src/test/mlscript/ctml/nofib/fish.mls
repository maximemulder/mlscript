/** The empty picture. */
fun nil(a, b, c) = LNil()
//│ nil: ⊤ → ⊤ → ⊤ → LNil

/** Make a segment from its two endpoints. */
fun tup2(a_b, c_d) = if a_b is [a, b] and c_d is [c, d] then [[a, b], [c, d]]
//│ tup2: ∀α, β, γ, δ. ⟨α, β⟩ → ⟨γ, δ⟩ → ⟨⟨α, β⟩, ⟨γ, δ⟩⟩

:ctml-parse-only // FIXME: Inference exceeds a 20000-call solver budget.
/** Place tile segments relative to the origin a and axes b and c. */
fun grid(m, n, segments, a, b, c) =
  /** Transform the endpoints of every segment. */
  fun lscomp(ls) = if ls is
    LNil() then LNil()
    LCons([[x0, y0], [x1, y1]], tail) then
      LCons(
        tup2(
          vec_add(vec_add(a, scale_vec2(b, x0, m)), scale_vec2(c, y0, n)),
          vec_add(vec_add(a, scale_vec2(b, x1, m)), scale_vec2(c, y1, n))
        ),
        lscomp(tail)
      )
  lscomp(segments)
//│ CTML translation succeeded.

/** Rotate a picture by transforming its origin and axes. */
fun rot(p, a, b, c) = p(vec_add(a, b), c, vec_sub([0, 0], b))
//│ rot: ∀α, β. (⟨Int, Int⟩ → α → ⟨Int, Int⟩ → β) → ⟨Int, Int⟩ → ⟨Int, Int⟩ → α → β

/** Place two pictures side by side with the given width proportions. */
fun beside(m, n, p, q, a, b, c) = append(
  p(a, scale_vec2(b, m, m + n), c),
  q(vec_add(a, scale_vec2(b, m, m + n)), scale_vec2(b, n, n + m), c)
)
//│ beside: ∀α, β, γ, Z. {Z ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: Z}), α ≤ ⟨Int, Int⟩} ⟹ Int → Int → (∀X. α → ⟨Int, Int⟩ → β → ({X ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: X})} ⟹ X)) → (∀Y. ⟨Int, Int⟩ → ⟨Int, Int⟩ → β → ({Y ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: Y})} ⟹ Y)) → α → ⟨Int, Int⟩ → β → Z

/** Stack two pictures with the given height proportions. */
fun above(m, n, p, q, a, b, c) = append(
  p(vec_add(a, scale_vec2(c, n, m + n)), b, scale_vec2(c, m, n + m)),
  q(a, b, scale_vec2(c, n, m + n))
)
//│ above: ∀α, β, γ, Z. {Z ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: Z}), α ≤ ⟨Int, Int⟩} ⟹ Int → Int → (∀X. ⟨Int, Int⟩ → β → ⟨Int, Int⟩ → ({X ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: X})} ⟹ X)) → (∀Y. α → β → ⟨Int, Int⟩ → ({Y ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: Y})} ⟹ Y)) → α → β → ⟨Int, Int⟩ → Z

:ctml-parse-only // FIXME: The grid traversal is translation-only.
/** Place segments whose tile coordinates use a 16 by 16 grid. */
fun tile_to_grid(arg, arg2, arg3, arg4) = grid(16, 16, arg, arg2, arg3, arg4)
//│ CTML translation succeeded.

