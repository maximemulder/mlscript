/** Assemble the complete pattern from rotations of a corner. */
fun pseudolimit(a, b, c) = cycle_(pseudocorner, a, b, c)
//│ CTML translation succeeded.

/** Format a segment in the source flat-coordinate format. */
fun showFourTupleofInt(segment) = if segment is [[a, b], [c, d]] then
  append(nofibStringToList("("),
    append(nofibStringToList(stringOfInt(a)),
      append(nofibStringToList(","),
        append(nofibStringToList(stringOfInt(b)),
          append(nofibStringToList(","),
            append(nofibStringToList(stringOfInt(c)),
              append(nofibStringToList(","),
                nofibStringToList(stringOfInt(d)))))))))
//│ showFourTupleofInt: ∀Z. {Z ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: Z})} ⟹ ⟨⟨Int, Int⟩, ⟨Int, Int⟩⟩ → Z

:ctml-parse-only // FIXME: The source formatter uses a string as the final list tail.
/** Format a list of segments with the source separators and suffix. */
fun fmt(ls) = if ls is
  LNil() then nofibStringToList("[]")
  LCons(x, xs) then
    /** Render the remaining segments, ending with the source string tail. */
    fun showl(ls, s) = if ls is
      LNil() then LCons("]", s)
      LCons(x, xs) then
        append(nofibStringToList(",|"), append(showFourTupleofInt(x), showl(xs, s)))
    append(nofibStringToList("[|"), append(showFourTupleofInt(x), showl(xs, "")))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The complete picture drawing is translation-only.
/** Draw the source sequence of pictures for indices zero through n, inclusive. */
fun testFish_nofib(n) =
  map(
    i => let n = if i < 0 then i else 0 in pseudolimit([0, 0], [640 + n, 0], [0, 640 + n]),
    enumFromTo(0, n)
  )
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The workload is translation-only.
/** Render the source workload with input 1. */
fun main() = testFish_nofib(1)
//│ CTML translation succeeded.

