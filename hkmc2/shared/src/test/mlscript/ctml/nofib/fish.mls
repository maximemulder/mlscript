/** Combine four pictures in a two-by-two grid. */
fun quartet(a, b, c, d, origin, xAxis, yAxis) =
  above(
    1,
    1,
    (o, x, y) => beside(1, 1, a, b, o, x, y),
    (o, x, y) => beside(1, 1, c, d, o, x, y),
    origin,
    xAxis,
    yAxis
  )
//│ quartet: ∀α, β, γ, Z. {Z ≥ LNil ∨ ((LCons ∧ {head: β ∨ γ}) ∧ {tail: Z}), α ≤ ⟨Int, Int⟩} ⟹ (∀X. ⟨Int, Int⟩ → ⟨Int, Int⟩ → ⟨Int, Int⟩ → ({X ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: X})} ⟹ X)) → (∀Y. ⟨Int, Int⟩ → ⟨Int, Int⟩ → ⟨Int, Int⟩ → ({Y ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Y})} ⟹ Y)) → (∀X. α → ⟨Int, Int⟩ → ⟨Int, Int⟩ → ({X ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: X})} ⟹ X)) → (∀Y. ⟨Int, Int⟩ → ⟨Int, Int⟩ → ⟨Int, Int⟩ → ({Y ≥ LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: Y})} ⟹ Y)) → α → ⟨Int, Int⟩ → ⟨Int, Int⟩ → Z

:ctml-parse-only // FIXME: The tile pictures are translation-only.
/** Combine the four source tiles. */
fun t(a, b, c) = quartet(p, q, r, s, a, b, c)
//│ CTML translation succeeded.

/** Arrange a picture and its three successive rotations. */
fun cycle_(p1, origin, xAxis, yAxis) =
  quartet(
    p1,
    (a, b, c) => rot((a, b, c) => rot((a, b, c) => rot(p1, a, b, c), a, b, c), a, b, c),
    (a, b, c) => rot(p1, a, b, c),
    (a, b, c) => rot((a, b, c) => rot(p1, a, b, c), a, b, c),
    origin,
    xAxis,
    yAxis
  )
//│ cycle_: ∀α, β, Z. {Z ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: Z})} ⟹ ((∀X. ⟨Int, Int⟩ → ⟨Int, Int⟩ → ⟨Int, Int⟩ → ({X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X)) ∧ (⟨Int, Int⟩ → ⟨Int, Int⟩ → ⟨Int, Int⟩ → ({β ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: β})} ⟹ β))) → ⟨Int, Int⟩ → ⟨Int, Int⟩ → ⟨Int, Int⟩ → Z

