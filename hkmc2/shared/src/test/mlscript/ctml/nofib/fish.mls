/** Cycle a rotated copy of the second tile. */
fun u(a, b, c) = cycle_((a, b, c) => rot(q, a, b, c), a, b, c)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The combined tile picture is translation-only.
