// Source: hkmc2/shared/src/test/mlscript-compile/nofib/fish.mls.
// Represent each segment [x0, y0, x1, y1] as a pair of endpoint pairs.

/** Add two integer vectors componentwise. */
fun vec_add(v1, v2) = if v1 is [x1, y1] and v2 is [x2, y2] then [x1 + x2, y1 + y2]
//│ vec_add: ⟨Int, Int⟩ → ⟨Int, Int⟩ → ⟨Int, Int⟩

/** Subtract two integer vectors componentwise. */
fun vec_sub(v1, v2) = if v1 is [x1, y1] and v2 is [x2, y2] then [x1 - x2, y1 - y2]
//│ vec_sub: ⟨Int, Int⟩ → ⟨Int, Int⟩ → ⟨Int, Int⟩

/** Scale a vector, using the source floor division in each component. */
fun scale_vec2(v, a, b) = if v is [x, y] then [intDiv(x * a, b), intDiv(y * a, b)]
//│ scale_vec2: ⟨Int, Int⟩ → Int → Int → ⟨Int, Int⟩

/** An integer point or vector. */
type Point = [Int, Int]
//│ Point = ⟨Int, Int⟩

/** A directed segment on the grid. */
type Segment = [Point, Point]
//│ Segment = ⟨Point, Point⟩

