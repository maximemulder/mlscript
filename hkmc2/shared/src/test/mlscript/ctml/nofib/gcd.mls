// Independent checks of the driver's tuple-mapping stages use the trusted map contract.
/** Diagnostic result type for the driver's integer score list. */
type ScoreList = [X restricts (LNil | (LCons & {head: Int} & {tail: X}))] -> X
//│ ScoreList = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X

val sampleTriples = map(p => if p is [x, y] then [x, [y, gcdE(x, y)]],
  LCons([5000, 10000], LNil()))
//│ sampleTriples: ∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: ⟨Int, ⟨Int, ⟨Int, ⟨Int, Int⟩⟩⟩⟩}) ∧ {tail: Y})} ⟹ Y

map(p => if p is [d1, [d2, [gg, [u, v]]]] then abs(gg + u + v), sampleTriples) as ScoreList
//│ ScoreList

