//│   ((LCons ∧ {head: Int}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: α})} ⟹ α}) → Int ≤ β → γ
//│     β ≤ (LCons ∧ {head: Int}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: α})} ⟹ α}
