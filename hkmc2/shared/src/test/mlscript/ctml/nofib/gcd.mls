:ctml
:import NofibPrelude.mls
//│ Imported 12 member(s)

// Source: hkmc2/shared/src/test/mlscript-compile/nofib/gcd.mls.
// Partial port: the extended Euclidean kernel. The list-based driver is not yet ported.
// Triples are represented as [a, [b, c]], with nested tuple patterns for destructuring.

fun g(us, vs) =
  if us is [u1, [u2, u3]] and vs is [v1, [v2, v3]] then
    if v3 == 0 then [u3, [u1, u2]]
    else if quotRem(u3, v3) is [q, r] then
      g([v1, [v2, v3]], [u1 - (q * v1), [u2 - (q * v2), r]])
//│ g: ⟨Int, ⟨Int, Int⟩⟩ → ⟨Int, ⟨Int, Int⟩⟩ → ⟨Int, ⟨Int, Int⟩⟩

fun gcdE(x, y) =
  if x == 0 then [y, [0, 1]]
  else g([1, [0, x]], [0, [1, y]])
//│ gcdE: Int → Int → ⟨Int, ⟨Int, Int⟩⟩

// Both the base case and recursive entry accept integers and return an integer triple.

gcdE(0, 12) as [Int, [Int, Int]]
//│ ⟨Int, ⟨Int, Int⟩⟩

gcdE(30, 12) as [Int, [Int, Int]]
//│ ⟨Int, ⟨Int, Int⟩⟩

// Imported projections retain independent component types and polymorphic uses.

[fst([1, "hello"]), snd([true, "hello"])] as [Int, Str]
//│ ⟨Int, Str⟩

:te
fst(["hello", 1]) as Int
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Int.
//│ Typing error tree:
//│   α ≤ Int
//│     Str ≤ Int

// Invalid arguments and result types must be rejected.

:te
gcdE("hello", 12)
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int → ⟨Int, ⟨Int, Int⟩⟩ ≤ Str → α.
//│ Typing error tree:
//│   Int → Int → ⟨Int, ⟨Int, Int⟩⟩ ≤ Str → α
//│     Str ≤ Int

:te
gcdE(30, 12) as [Int, [Int, Str]]
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ ⟨Int, ⟨Int, Str⟩⟩.
//│ Typing error tree:
