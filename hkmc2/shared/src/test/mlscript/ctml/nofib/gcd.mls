/** Source maximum is partial on empty lists and compares successive candidates. */
fun max_(ls) = if ls is
  LCons(x, LNil()) then x
  LCons(x, LCons(y, xs)) then
    if x < y then max_(LCons(y, xs)) else max_(LCons(x, xs))
//│ max_: ((LCons ∧ {head: Int}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: α})} ⟹ α}) → Int

max_(LCons(1, LNil())) as Int
max_(LCons(1, LCons(3, LCons(2, LNil())))) as Int
//│ Int
//│ Int

:te
