// Source: hkmc2/shared/src/test/mlscript-compile/nofib/integer.mls.
// Lists use LNil() and LCons. Both arithmetic passes keep the source progression and order.

/** Build an inclusive progression from the start and step used by both passes. */
fun integerRange(start, step, limit) = enumFromThenTo(start, start + step, limit)
//│ integerRange: Int → Int → Int → (LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: α})} ⟹ α}))

// The benchmark's inclusive progression produces integers when it is nonempty.
(if integerRange(0 - 2100000000, 700000001, 2100000000) is
  LNil() then 0
  LCons(first, rest) then first) as Int
//│ Int

/** Add two integers. */
fun z_add(a, b) = a + b
//│ z_add: Int → Int → Int

/** Subtract the second integer from the first. */
fun z_sub(a, b) = a - b
//│ z_sub: Int → Int → Int

/** Multiply two integers. */
fun z_mul(a, b) = a * b
//│ z_mul: Int → Int → Int

/** Divide with the source floor quotient. */
fun z_div(a, b) = intDiv(a, b)
//│ z_div: Int → Int → Int

/** Compute the remainder with the source floor quotient. */
fun z_mod(a, b) = intMod(a, b)
//│ z_mod: Int → Int → Int

/** Compare equality. */
fun z_equal(a, b) = a == b
//│ z_equal: ⊤ → ⊤ → Bool

/** Compare strict ascending order. */
fun z_lt(a, b) = a < b
//│ z_lt: Int → Int → Bool

/** Compare ascending order including equality. */
fun z_leq(a, b) = a <= b
//│ z_leq: Int → Int → Bool

/** Compare strict descending order. */
fun z_gt(a, b) = b < a
//│ z_gt: Int → Int → Bool

/** Compare descending order including equality. */
fun z_geq(a, b) = b <= a
//│ z_geq: Int → Int → Bool

// Check the result of every operation at the source input magnitude.
let lo = 0 - 2100000000
let hi = 2100000000
[z_add(lo, hi) as Int, z_sub(lo, hi) as Int]
[z_mul(lo, hi) as Int, z_div(lo, hi) as Int]
[z_mod(lo, hi) as Int, z_equal(lo, hi) as Bool]
[z_lt(lo, hi) as Bool, z_leq(lo, hi) as Bool]
[z_gt(lo, hi) as Bool, z_geq(lo, hi) as Bool]
//│ lo: Int
//│ hi: Int
//│ ⟨Int, Int⟩
//│ ⟨Int, Int⟩
//│ ⟨Int, Bool⟩
//│ ⟨Bool, Bool⟩
//│ ⟨Bool, Bool⟩

:te
z_geq("not an integer", 0)
//│ ═══[TYPE ERROR] Cannot solve judgment Int → Int → Bool ≤ Str → α.
//│ Typing error tree:
//│   Int → Int → Bool ≤ Str → α
