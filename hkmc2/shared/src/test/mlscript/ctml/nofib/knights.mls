// Source: hkmc2/shared/src/test/mlscript-compile/nofib/knights.mls.
// Directions use nullary tags. Board positions are pairs of integers, and the oldest
// position stays delayed. The driver supplies ASCII digit lists split into UTF-16 units.

/** Test whether the first character represents an ASCII digit. */
fun myIsDigit(c) =
  let n = nofibCharCode(c)
  (48 <= n) && (n <= 57)
//│ myIsDigit: Str → Bool

/** Compare two integer pairs lexicographically. */
fun intintComp(ab, cd) = if ab is [a, b] and cd is [c, d] then
  (a < c) || ((a === c) && (b < d))
//│ intintComp: ⟨Int, Int⟩ → ⟨Int, Int⟩ → Bool

/** Compare two weighted boards by their weights. */
fun intChessSetComp(ab, cd) = if ab is [a, b] and cd is [c, d] then a < c
//│ intChessSetComp: ⟨Int, ⊤⟩ → ⟨Int, ⊤⟩ → Bool

