/** Read the last entry of a nonempty strict queue. */
fun inquireBack(xs) = if xs is
  LCons(x, LNil()) then x
  LCons(x, rest) then inquireBack(rest)
//│ CTML translation succeeded.

/** Read the first entry of a nonempty strict queue. */
fun inquireFront(xs) = head(xs)
//│ inquireFront: ∀α. (({tail: ⊤} ∧ {head: α}) ∧ LCons) → α

/** Append a list to the back of a strict queue. */
fun addAllBack(list, q) = append(q, list)
//│ addAllBack: ∀α, Z. {Z ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: Z})} ⟹ (∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: Y})} ⟹ Y) → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X) → Z

/** Prepend a list to the front of a strict queue. */
fun addAllFront(list, q) = append(list, q)
//│ addAllFront: ∀α, Z. {Z ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: Z})} ⟹ (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X) → (∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: Y})} ⟹ Y) → Z

:ctml-parse-only // FIXME: Inference exceeds the 20000-call solver budget.
/** Add an entry at the back of a strict queue. */
fun addBack(x, q) = append(q, LCons(x, LNil()))
//│ CTML translation succeeded.

/** Add an entry at the front of a strict queue. */
fun addFront(x, q) = LCons(x, q)
//│ addFront: ∀α, β. α → β → ((LCons ∧ {head: α}) ∧ {tail: β})

/** The empty strict queue. */
val createQueue = LNil()
//│ createQueue: LNil

/** A list of board coordinates in newest-first order. */
type Trail = [X restricts (LNil | (LCons & {head: [Int, Int]} & {tail: X}))] -> X
//│ Trail = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: ⟨Int, Int⟩}) ∧ {tail: X})} ⟹ X

/** Board size, number of visited squares, delayed first square, and trail. */
data class Board(a: Int, b: Int, c: Delayed & {resume: () -> [Int, Int]}, d: Trail)
//│ Board: ∀α, β, γ, δ. {β ≤ Int, δ ≤ Trail, γ ≤ Delayed ∧ {resume: Unit → ⟨Int, Int⟩}, α ≤ Int} ⟹ α → β → γ → δ → ((((Board ∧ {a: α}) ∧ {b: β}) ∧ {c: γ}) ∧ {d: δ})

/** Start the trail at the given square. */
fun createBoard(x, t) = Board(x, 1, delay(() => t), LCons(t, LNil()))
//│ createBoard: ∀α, β. {β ≤ ⟨Int, Int⟩, α ≤ Int} ⟹ α → β → ((((Board ∧ {a: α}) ∧ {b: Int}) ∧ {c: Delayed ∧ {resume: Unit → β}}) ∧ {d: (LCons ∧ {head: β}) ∧ {tail: LNil}})

/** Read the board size. */
fun sizeBoard(b) = if b is Board(a, count, first, trail) then a
//│ sizeBoard: ∀α. (((({b: ⊤} ∧ {d: ⊤}) ∧ {c: ⊤}) ∧ {a: α}) ∧ Board) → α

/** Count the squares in the current trail. */
fun noPieces(b) = if b is Board(size, n, first, trail) then n
//│ noPieces: ∀α. (((({b: α} ∧ {d: ⊤}) ∧ {c: ⊤}) ∧ {a: ⊤}) ∧ Board) → α

/** Extend the trail with one square. */
fun addPiece(t, b) = if b is Board(s, n, f, ts) then Board(s, n + 1, f, LCons(t, ts))
//│ addPiece: ∀α, β, γ, δ. {α ≤ ((¬({δ ≤ ¬({α ≤ ⊥} ⟹ ⊥), α ≤ ¬({δ ≤ ⊥} ⟹ ⊥)} ⟹ ⊥) ∨ ¬({δ ≤ ¬({α ≤ ⟨Int, Int⟩} ⟹ ⊥)} ⟹ ¬(⟨Int, Int⟩ ∨ ¬({δ ≤ ⊥} ⟹ ⊥)))) ∧ (¬({α ≤ ¬({δ ≤ ⊥} ⟹ ⊥), δ ≤ ¬({α ≤ ⊥} ⟹ ⊥)} ⟹ ⊥) ∨ ¬({α ≤ ¬({α ≤ ⟨Int, Int⟩} ⟹ ¬⟨Int, Int⟩) ∨ ¬({δ ≤ ⊥} ⟹ ⊥), δ ≤ ¬({α ≤ ⟨Int, Int⟩} ⟹ ⊥)} ⟹ ¬(⟨Int, Int⟩ ∨ ¬({δ ≤ ⊥} ⟹ ⊥))))) ∧ ⟨Int, Int⟩, γ ≤ Delayed ∧ {resume: Unit → ⟨Int, Int⟩}, β ≤ Int} ⟹ α → (((({b: Int} ∧ {d: δ}) ∧ {c: γ}) ∧ {a: β}) ∧ Board) → ((((Board ∧ {a: β}) ∧ {b: Int}) ∧ {c: γ}) ∧ {d: (LCons ∧ {head: α}) ∧ {tail: δ}})

