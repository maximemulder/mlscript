/** Read the move number for a previously visited square. */
fun pieceAtTile(x, b) = if b is Board(size, count, first, ts) then
  /** Search the trail and count from the end. */
  fun find(x, xs) = if xs is
    LNil() then raiseError("Tile not used")
    LCons(y, rest) then if eqTup2(x, y) then 1 + listLen(rest) else find(x, rest)
  find(x, ts)
//│ CTML translation succeeded.

