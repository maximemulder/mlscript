/** Render the numbered tour sorted into ascending square order. */
fun showChessSet(b) = if b is Board(sze, n, first, ts) then
  let sortedTrail = quickSortIntInt(assignMoveNo(ts, sze, n))
  printBoard(sze, 1, sortedTrail)
//│ CTML translation succeeded.

