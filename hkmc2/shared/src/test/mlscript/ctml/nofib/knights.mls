/** Drop the last entry of a nonempty list. */
fun myInit(xs) = if xs is
  LCons(a, LNil()) then LNil()
  LCons(a, t) then LCons(a, myInit(t))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds the 20000-call solver budget.
/** Read the last entry of a nonempty list. */
fun myLast(xs) =
  /** Carry the preceding element until the remainder is empty. */
  fun go(h, t) = if t is
    LNil() then h
    LCons(x, rest) then go(x, rest)
  if xs is LCons(a, t) then go(a, t)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds the 20000-call solver budget.
/** Sort the numbered squares using the two source partitions. */
fun quickSortIntInt(xs) = if xs is
  LNil() then LNil()
  LCons(x, rest) then
    /** Keep pairs strictly below the pivot. */
    fun lscomp1(ls) = if ls is
      LNil() then LNil()
      LCons(h, t) and
        intintComp(h, x) then LCons(h, lscomp1(t))
        else lscomp1(t)
    /** Keep pairs at or above the pivot. */
    fun lscomp2(ls) = if ls is
      LNil() then LNil()
      LCons(h, t) and
        intintComp(h, x) then lscomp2(t)
        else LCons(h, lscomp2(t))
    append(quickSortIntInt(lscomp1(rest)), LCons(x, quickSortIntInt(lscomp2(rest))))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds the 20000-call budget with the lazy append contract.
/** Sort by number of onward moves, delaying the pivot and following partition. */
fun quickSortIntChessSet(xs) = if force(xs) is
  LzNil() then delay(() => LzNil())
  LzCons(x, rest) then
    /** Keep boards with fewer onward moves than the pivot. */
    fun lscomp1(ls) = if force(ls) is
      LzNil() then delay(() => LzNil())
      LzCons(h, t) and
        intChessSetComp(h, x) then delay(() => LzCons(h, lscomp1(t)))
        else lscomp1(t)
    /** Keep boards with at least as many onward moves as the pivot. */
    fun lscomp2(ls) = if force(ls) is
      LzNil() then delay(() => LzNil())
      LzCons(h, t) and
        intChessSetComp(h, x) then lscomp2(t)
        else delay(() => LzCons(h, lscomp2(t)))
    appendLzLz(quickSortIntChessSet(lscomp1(rest)),
      delay(() => LzCons(x, quickSortIntChessSet(lscomp2(rest)))))
//│ CTML translation succeeded.

/** Count entries in a strict queue. */
fun sizeQueue(xs) = listLen(xs)
//│ sizeQueue: (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: ⊤}) ∧ {tail: X})} ⟹ X) → Int

/** Compare the strict queue with the empty list. */
fun emptyQueue(x) = listEq(x, LNil())
//│ emptyQueue: (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: ⊤}) ∧ {tail: X})} ⟹ X) → Bool

:ctml-parse-only // FIXME: Inference exceeds the 20000-call solver budget.
/** Remove the final entry of a nonempty strict queue. */
fun removeBack(xs) = if xs is
  LCons(x, LNil()) then LNil()
  LCons(x, rest) then LCons(x, removeBack(rest))
//│ CTML translation succeeded.

/** Remove the first entry of a nonempty strict queue. */
fun removeFront(xs) = if xs is LCons(h, t) then t
//│ removeFront: ∀α. (({tail: α} ∧ {head: ⊤}) ∧ LCons) → α

