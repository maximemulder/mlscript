/** Force both heads before returning a delay that pairs them. */
fun zipLzLz(xs, ys) = if
  force(xs) is LzCons(x, xt) and force(ys) is LzCons(y, yt) then
    delay(() => LzCons([x, y], zipLzLz(xt, yt)))
  else delay(() => LzNil())
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds the 20000-call solver budget.
/** Wait until demanded to force the next heads and combine them. */
fun zipWithLzLz(f, xs, ys) = delay(() =>
  if force(xs) is LzCons(x, xt) and force(ys) is LzCons(y, yt) then
    LzCons(f(x, y), zipWithLzLz(f, xt, yt))
  else LzNil()
)
//│ CTML translation succeeded.

/** Produce an infinite lazy list of one repeated value. */
fun repeat(x) = delay(() => LzCons(x, repeat(x)))
//│ repeat: ∀α, β. {β ≥ Delayed ∧ {resume: Unit → ((LzCons ∧ {head: α}) ∧ {tail: β})}} ⟹ α → (Delayed ∧ {resume: Unit → ((LzCons ∧ {head: α}) ∧ {tail: β})})

:ctml-parse-only // FIXME: The lazy zip traversals are translation-only.
/** Enumerate the starting tours, each with the starting backtracking count. */
fun root(sze) =
  /** Advance through the first coordinate. */
  fun lscomp1(ls) = if ls is
    LNil() then delay(() => LzNil())
    LCons(h1, t1) then
      /** Advance through the second coordinate before returning to the outer loop. */
      fun lscomp2(inner) = if inner is
        LNil() then lscomp1(t1)
        LCons(h2, t2) then delay(() => LzCons([h1, h2], lscomp2(t2)))
      lscomp2(enumFromTo(1, sze))
  appendLzLz(
    zipLzLz(
      repeat(1 - (sze * sze)),
      zipWithLzLz(startTour, lscomp1(enumFromTo(1, sze)), replicateLz(sze * sze, sze))
    ),
    delay(() => LzNil())
  )
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Lazy zip and successor selection are translation-only.
/** Extend one search entry and increment the backtracking count for its successors. */
fun grow(xy) = if xy is [x, y] then zipLzLz(repeat(x + 1), descendents(y))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The tour completion check is translation-only.
/** Test whether the search entry's trail is a closed tour. */
fun isFinished(xy) = if xy is [x, y] then tourFinished(y)
//│ CTML translation succeeded.

/** Check the head of a lazy queue for emptiness. */
fun emptyQueueLz(x) = if force(x) is LzNil() then true else false
//│ emptyQueueLz: ∀α. (Delayed ∧ {resume: Unit → α}) → (({α ≤ LzNil} ⟹ Bool) ∧ ({α ≤ ¬LzNil} ⟹ Bool))

/** Return the delayed remainder of a nonempty queue. */
fun removeFrontLz(xs) = if force(xs) is LzCons(h, t) then t
//│ removeFrontLz: ∀α. (Delayed ∧ {resume: Unit → (({tail: α} ∧ {head: ⊤}) ∧ LzCons)}) → α

/** Read the first entry of a nonempty lazy queue. */
fun inquireFrontLz(xs) = if force(xs) is LzCons(h, t) then h
//│ inquireFrontLz: ∀α. (Delayed ∧ {resume: Unit → (({tail: ⊤} ∧ {head: α}) ∧ LzCons)}) → α

/** Place all new entries before the remaining lazy queue. */
fun addAllFrontLz(list, q) = appendLzLz(list, q)
//│ addAllFrontLz: ∀α, Z. {Z ≥ Delayed ∧ {resume: Unit → (LzNil ∨ ((LzCons ∧ {head: α}) ∧ {tail: Z}))}} ⟹ (∀X. {X ≥ Delayed ∧ {resume: Unit → (LzNil ∨ ((LzCons ∧ {head: α}) ∧ {tail: X}))}} ⟹ X) → (∀Y. {Y ≥ Delayed ∧ {resume: Unit → (LzNil ∨ ((LzCons ∧ {head: α}) ∧ {tail: Y}))}} ⟹ Y) → Z

:ctml-parse-only // FIXME: Inference of the queue match exceeds the 20000-call solver budget.
/** Search depth-first, delaying the remainder after each completed tour. */
fun depthSearch(q, growFn, finFn) = if force(q) is
  LzNil() then delay(() => LzNil())
  LzCons(entry, rest) then
    if finFn(entry) then delay(() => LzCons(entry, depthSearch(rest, growFn, finFn)))
    else depthSearch(addAllFrontLz(growFn(entry), rest), growFn, finFn)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Search and board rendering are translation-only.
/** Parse the two arguments, take the requested tours, and render them. */
fun printTour(ss) =
  /** Accumulate the already validated decimal digits. */
  fun strToInt(y, xs) = if xs is
    LNil() then y
    LCons(x, rest) then strToInt((10 * y) + (nofibCharCode(x) - 48), rest)
  /** Render each tour with its backtracking count and board. */
  fun pp(xs) = if xs is
    LNil() then LNil()
    LCons([x, y], rest) then
      append(nofibStringToList("\nKnights tour with "),
        append(nofibStringToList(stringOfInt(x)),
          append(nofibStringToList(" backtracking moves\n"), append(showChessSet(y), pp(rest)))))
  if map(x => strToInt(0, x), ss) is
    LCons(size, LCons(number, LNil())) then pp(takeLz(number, depthSearch(root(size), grow, isFinished)))
    else raiseError("printTour error")
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The tour search and rendering are translation-only.
/** Check the source argument format before looking for tours. */
fun testKnights_nofib(ss) =
  let usageString = "\nUsage: knights <board size> <no solutions> \n"
  /** Test each character of one argument. */
  fun all_digits(s) = foldr((a, b) => myIsDigit(a) && b, true, s)
  /** Require precisely two digit lists. */
  fun argsOk(ss) = (listLen(ss) === 2) && foldr((a, b) => all_digits(a) && b, true, ss)
  if argsOk(ss) then printTour(ss) else raiseError(usageString)
//│ CTML translation succeeded.

