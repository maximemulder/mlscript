/** Remove the starting square and delay finding the new starting square. */
fun deleteFirst(b) = if b is Board(s, n, f, ts) then
  let ts_ = myInit(ts)
  Board(s, n - 1, delay(() => myLast(ts_)), ts_)
//│ CTML translation succeeded.

/** Fetch the square visited on move x. */
fun positionPiece(x, b) = if b is Board(size, n, first, ts) then atIndex(n - x, ts)
//│ positionPiece: ∀α. Int → (((({b: Int} ∧ {d: ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ (LCons ∧ {head: α}) ∧ {tail: X}}) ∧ {c: ⊤}) ∧ {a: ⊤}) ∧ Board) → α

/** Fetch the most recently visited square. */
fun lastPiece(b) = if b is Board(size, count, first, LCons(t, ts)) then t
//│ lastPiece: ∀α. (((({b: ⊤} ∧ {d: ({tail: ⊤} ∧ {head: α}) ∧ LCons}) ∧ {c: ⊤}) ∧ {a: ⊤}) ∧ Board) → α

/** Fetch the starting square by forcing its handle. */
fun firstPiece(b) = if b is Board(size, count, f, trail) then force(f)
//│ firstPiece: ∀α. (((({b: ⊤} ∧ {d: ⊤}) ∧ {c: Delayed ∧ {resume: Unit → α}}) ∧ {a: ⊤}) ∧ Board) → α

