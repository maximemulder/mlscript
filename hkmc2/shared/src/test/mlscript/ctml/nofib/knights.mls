/** Test whether the trail contains a given square. */
fun tup2InList(y, xs) = if xs is
  LNil() then false
  LCons(x, rest) and
    eqTup2(y, x) then true
    else tup2InList(y, rest)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The trail membership traversal is translation-only.
/** Test whether the square has yet to be visited. */
fun isSquareFree(x, b) = if b is Board(size, count, first, ts) then tup2InList(x, ts) == false
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds the 20000-call solver budget.
/** Pair every visited square's linear index with its move number. */
fun assignMoveNo(t, size, z) = if t is
  LNil() then LNil()
  LCons([x, y], rest) then LCons([(y - 1) * size + x, z], assignMoveNo(rest, size, z - 1))
//│ CTML translation succeeded.

/** Pad a rendered move number to the width of the board's largest number. */
fun spaces(s, y) =
  /** Count decimal digits by dividing by ten. */
  fun logTen(x) = if x === 0 then 0 else 1 + logTen(intDiv(x, 10))
  replicate((logTen(s) - logTen(y)) + 1, " ")
//│ spaces: Int → Int → (((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ ((LCons ∧ {head: Str}) ∧ {tail: α}) ∨ LNil} ⟹ α}) ∨ LNil)

:fixme // FIXME: Closing recursion over the board formatter fails.
/** Render occupied and unoccupied squares in row order. */
fun printBoard(s, n, xs) = if xs is
  LNil() and
    (s * s) < n then LNil()
    (intMod(n, s) == 0) == false then
      LCons("*", append(spaces(s * s, 1), printBoard(s, n + 1, LNil())))
    intMod(n, s) === 0 then
      append(nofibStringToList("*\n"), printBoard(s, n + 1, LNil()))
    else raiseError("printBoard empty list error")
  LCons([i, j], rest) and
    i === n and intMod(n, s) === 0 then
      append(nofibStringToList(stringOfInt(j)),
        append(nofibStringToList("\n"), printBoard(s, n + 1, rest)))
    i === n and (intMod(n, s) == 0) == false then
      append(nofibStringToList(stringOfInt(j)), append(spaces(s * s, j), printBoard(s, n + 1, rest)))
    (intMod(n, s) == 0) == false then
      LCons("*", append(spaces(s * s, 1), printBoard(s, n + 1, LCons([i, j], rest))))
    intMod(n, s) === 0 then
      append(nofibStringToList("*\n"), printBoard(s, n + 1, LCons([i, j], rest)))
    else raiseError("printBoard non-empty list error")
