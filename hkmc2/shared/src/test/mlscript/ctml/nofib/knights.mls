/** Move up two rows and left one column. */
data class UL()
/** Move up two rows and right one column. */
data class UR()
/** Move down two rows and left one column. */
data class DL()
/** Move down two rows and right one column. */
data class DR()
/** Move left two columns and up one row. */
data class LU()
/** Move left two columns and down one row. */
data class LD()
/** Move right two columns and up one row. */
data class RU()
/** Move right two columns and down one row. */
data class RD()
//│ UL: Unit → UL
//│ UR: Unit → UR
//│ DL: Unit → DL
//│ DR: Unit → DR
//│ LU: Unit → LU
//│ LD: Unit → LD
//│ RU: Unit → RU
//│ RD: Unit → RD

:ctml-parse-only // FIXME: Inference exceeds the 20000-call solver budget.
/** Compute the square reached by a move. */
fun move(d, xy) = if xy is [x, y] and d is
  UL() then [x - 1, y - 2]
  UR() then [x + 1, y - 2]
  DL() then [x - 1, y + 2]
  DR() then [x + 1, y + 2]
  LU() then [x - 2, y - 1]
  LD() then [x - 2, y + 1]
  RU() then [x + 2, y - 1]
  RD() then [x + 2, y + 1]
//│ CTML translation succeeded.

/** Start a tour on an even-sized board. */
fun startTour(st, size) =
  if intMod(size, 2) === 0 then createBoard(size, st)
  else raiseError("Tour doesnt exist for odd size board")
//│ startTour: ∀α, β. {α ≤ ⟨Int, Int⟩, β ≤ Int} ⟹ α → β → ((((Board ∧ {a: β}) ∧ {b: Int}) ∧ {c: Delayed ∧ {resume: Unit → α}}) ∧ {d: (LCons ∧ {head: α}) ∧ {tail: LNil}})

:ctml-parse-only // FIXME: The direction dispatch is translation-only.
/** Extend the board by moving from its most recent square. */
fun moveKnight(board, dir) = addPiece(move(dir, lastPiece(board)), board)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The trail membership traversal is translation-only.
/** Check the board bounds and whether the target square is free. */
fun canMoveTo(xy, board) = if xy is [x, y] then
  let sze = sizeBoard(board)
  if (1 <= x) && (x <= sze) && (1 <= y) && (y <= sze) then isSquareFree(xy, board)
  else false
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The direction dispatch and square availability check are translation-only.
/** Test whether a move from the current square is legal. */
fun canMove(board, dir) = canMoveTo(move(dir, lastPiece(board)), board)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Deleting the initial square and checking move legality are translation-only.
/** Test whether the tour can jump back to its starting square. */
fun canJumpFirst(board) = canMoveTo(firstPiece(board), deleteFirst(board))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Testing for a jump back to the first square is translation-only.
/** A completed tour visits every square and jumps back to the start. */
fun tourFinished(board) =
  let sze = sizeBoard(board)
  if noPieces(board) === (sze * sze) then canJumpFirst(board) else false
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The move legality check is translation-only.
/** Enumerate the legal moves using the source direction order. */
fun possibleMoves(board) =
  /** Filter the remaining directions. */
  fun lscomp(ls) = if ls is
    LNil() then LNil()
    LCons(x, t) and
      canMove(board, x) then LCons(x, lscomp(t))
      else lscomp(t)
  lscomp(LCons(UL(), LCons(UR(), LCons(DL(), LCons(DR(),
    LCons(LU(), LCons(LD(), LCons(RU(), LCons(RD(), LNil())))))))))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Enumerating legal moves is translation-only.
/** Test whether the current square has any legal moves. */
fun deadEnd(board) = listLen(possibleMoves(board)) === 0
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Enumerating legal moves and extending the board are translation-only.
/** Build successor boards in the order returned by possibleMoves. */
fun allDescend(board) = map(b => moveKnight(board, b), possibleMoves(board))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Successor enumeration is translation-only.
/** Delay pairing each successor with the number of legal moves from its shortened trail. */
fun descAndNo(board) =
  /** Produce the next weighted board on demand. */
  fun lscomp(ls) = if ls is
    LNil() then delay(() => LzNil())
    LCons(x, t) then delay(() =>
      LzCons([listLen(possibleMoves(deleteFirst(x))), x], lscomp(t)))
  lscomp(allDescend(board))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Weighted successor enumeration is translation-only.
/** Find all successor boards with just one onward move. */
fun singleDescend(board) =
  /** Keep forced successors with weight one. */
  fun lscomp(ls) = if force(ls) is
    LzNil() then LNil()
    LzCons([y, x], t) and
      y === 1 then LCons(x, lscomp(t))
      else lscomp(t)
  lscomp(descAndNo(board))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Successor enumeration and lazy quicksort are translation-only.
/** Reject a dead-end cycle, prefer a forced move, or sort the possible successors. */
fun descendents(board) =
  if canJumpFirst(board) and deadEnd(addPiece(firstPiece(board), board)) then delay(() => LzNil())
  else
    let singles = singleDescend(board)
    let scrut = listLen(singles)
    if
      scrut === 0 then mapLz(snd, quickSortIntChessSet(descAndNo(board)))
      scrut === 1 then
        if singles is LCons(h, LNil()) then delay(() => LzCons(h, delay(() => LzNil())))
        else raiseError("unreachable")
      else delay(() => LzNil())
//│ CTML translation succeeded.

