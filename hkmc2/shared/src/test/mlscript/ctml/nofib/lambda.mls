// Source: hkmc2/shared/src/test/mlscript-compile/nofib/lambda.mls.
// Names are lists of source string code units. Recursive constructor fields carry their
// inferred payloads. Fixed names are written as literal constructor lists. Each mutually
// recursive group uses its own tagged dispatcher.

/** A successful environment lookup. */
data class Some(x)
/** A failed environment lookup. */
data class None()
//│ Some: ∀α. α → (Some ∧ {x: α})
//│ None: Unit → None

/** A state computation returning the new state and the result. */
data class MyState(r)
//│ MyState: ∀α. α → (MyState ∧ {r: α})

/** Run a state computation on the supplied state. */
fun myRunState(m, s) = if m is MyState(f) then f(s)
//│ myRunState: ∀α, β. ({r: α → β} ∧ MyState) → α → β

/** Thread the first computation's state and value to its continuation. */
fun myBind(m, f) = MyState(s => if myRunState(m, s) is [next, a] then myRunState(f(a), next))
//│ myBind: ∀α, β. α → β → (MyState ∧ {r: ∀γ, δ, ε, ζ, η, θ, ι, κ, λ, μ, ν, ξ. {ξ ≤ η, ζ ≤ ⟨θ, κ⟩, λ ≥ κ, β ≤ λ → μ, μ ≤ {r: ν → ξ} ∧ MyState, ν ≥ ι, ι ≥ θ, ε ≤ ζ, δ ≥ γ, α ≤ {r: δ → ε} ∧ MyState} ⟹ γ → η})

/** Return a value while preserving the state. */
fun myReturn(a) = MyState(s => [s, a])
//│ myReturn: ∀α. α → (MyState ∧ {r: ∀β. β → ⟨β, α⟩})

/** Return the current state as the value as well. */
val myGet = MyState(s => [s, s])
//│ myGet: MyState ∧ {r: ∀α. α → ⟨α, α⟩}

/** Extract the result of a state computation. */
fun myEvalState(m, s) = if myRunState(m, s) is [_, a] then a
//│ myEvalState: ∀α, β. ({r: α → ⟨⊤, β⟩} ∧ MyState) → α → β

myRunState(myGet, "env") as [Str, Str]
myEvalState(myReturn(7), "env") as Int
myRunState(myBind(myReturn(7), n => MyState(s => [n, s])), "env") as [Int, Str]
//│ ⟨Str, Str⟩
//│ Int
//│ ⟨Int, Str⟩

