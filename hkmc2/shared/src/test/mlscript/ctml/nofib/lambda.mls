//│           None ≤ {x: δ}

/** Return the increment marker without changing the environment. */
val incr = myReturn(UnitValue())
//│ incr: MyState ∧ {r: ∀α. α → ⟨α, UnitValue⟩}

/** Run in a temporary environment, returning the value in the caller's environment. */
fun withEnv(tmp, m) = myReturn(myEvalState(m, tmp))
//│ withEnv: ∀α, β. α → ({r: α → ⟨⊤, β⟩} ∧ MyState) → (MyState ∧ {r: ∀γ. γ → ⟨γ, β⟩})

myRunState(withEnv(7, myGet), "outer") as [Str, Int]
//│ ⟨Str, Int⟩

/** Add a binding while evaluating a computation. */
fun pushVar(v, t, m) = myBind(myGet, env => withEnv(LCons([v, t], env), m))
//│ pushVar: ∀α, β, γ. α → β → γ → (MyState ∧ {r: ∀δ, ε, ζ, η, θ, ι, κ, λ, μ, ν, ξ, ο. {ο ≤ θ, η ≤ ⟨ι, λ⟩, μ ≥ λ, ∀ρ, σ, τ, υ, φ, χ. {γ ≤ {r: φ → ⟨⊤, χ⟩} ∧ MyState, φ ≥ υ, υ ≥ (LCons ∧ {head: σ}) ∧ {tail: τ}, τ ≥ ρ, σ ≥ ⟨α, β⟩} ⟹ ρ → (MyState ∧ {r: ∀ψ. ψ → ⟨ψ, χ⟩}) ≤ μ → ν, ν ≤ {r: ξ → ο} ∧ MyState, ξ ≥ κ, κ ≥ ι, ζ ≤ η, ε ≥ δ, MyState ∧ {r: ∀π. π → ⟨π, π⟩} ≤ {r: ε → ζ} ∧ MyState} ⟹ δ → θ})

myEvalState(pushVar(LCons("x", LNil()), Con(1), myGet), LNil()) as
  (LCons & {head: [LCons, Con]} & {tail: LNil})
//│ (LCons ∧ {head: ⟨LCons, Con⟩}) ∧ {tail: LNil}

/** Compare two terms. */
data class CompareTerm(a, b)
/** Compare two environments. */
data class CompareEnv(a, b)
//│ CompareTerm: ∀α, β. α → β → ((CompareTerm ∧ {a: α}) ∧ {b: β})
//│ CompareEnv: ∀γ, δ. γ → δ → ((CompareEnv ∧ {a: γ}) ∧ {b: δ})

:ctml-parse-only // FIXME: Recursive environment lookup exceeds the 20000-call diagnostic.
/** Find the first binding whose name equals the requested name. */
fun lookup(k, env) = if env is
  LNil() then None()
  LCons([name, value], rest) then
    if listEq(k, name) then Some(value) else lookup(k, rest)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Term and environment comparison exceed the 20000-call diagnostic.
/** Compare the constructors and operands selected by the source patterns. */
fun equal(task) = if task is
  CompareEnv(a, b) and a is LNil() and b is LNil() then true
  // The first pattern binds its tail before the next environment pattern reads it.
  CompareEnv(a, _) and a is LCons([s1, t1], tail1) and tail1 is LCons([s2, t2], tail2) and
    listEq(s1, s2) and equal(CompareTerm(t1, t2)) then equal(CompareEnv(tail1, tail2))
  CompareTerm(a, b) and a is Var(v) and b is Var(w) then listEq(v, w)
  CompareTerm(a, b) and a is Con(i) and b is Con(j) then i === j
  CompareTerm(a, b) and a is Incr() and b is Incr() then true
  // The right child of the first pattern is the scrutinee of the second pattern.
  CompareTerm(a, _) and a is Add(l, r) and r is Add(c, d) then
    equal(CompareTerm(l, c)) && equal(CompareTerm(r, d))
  CompareTerm(a, _) and a is Lam(v, body) and body is Lam(w, inner) then
    listEq(v, w) && equal(CompareTerm(body, inner))
  CompareTerm(a, _) and a is App(f, arg) and arg is App(g, other) then
    equal(CompareTerm(f, g)) && equal(CompareTerm(arg, other))
  CompareTerm(a, _) and a is IfZero(c, t, f) and t is IfZero(d, u, v) then
    equal(CompareTerm(c, d)) && equal(CompareTerm(t, u)) && equal(CompareTerm(f, v))
  CompareTerm(a, _) and a is Thunk(t, env) and env is Thunk(u, other) then
    equal(CompareTerm(t, u)) && equal(CompareEnv(env, other))
  else false
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Environment lookup is translation-only.
/** Look up a variable in the current state. */
fun lookupVar(v) =
  /** Extract the term selected by the source lookup. */
  fun value(env) = myMaybe(_ => raiseError("undefined"), x => x, lookup(v, env))
  myBind(myGet, env => myReturn(value(env)))
//│ CTML translation succeeded.

/** Evaluate a term in the state computation. */
data class Eval(t)
/** Evaluate a term and extract an integer in the state computation. */
data class EvalCon(t)
/** Apply a stateful closure to an unevaluated argument. */
data class Apply(t, a)
//│ Eval: ∀α. α → (Eval ∧ {t: α})
//│ EvalCon: ∀β. β → (EvalCon ∧ {t: β})
//│ Apply: ∀γ, δ. γ → δ → ((Apply ∧ {t: γ}) ∧ {a: δ})

:ctml-parse-only // FIXME: Lookup and equality are translation-only.
/** Evaluate with the environment threaded through the source state combinators. */
fun eval(task) = if task is
  EvalCon(t) then myBind(eval(Eval(t)),
    value => if value is Con(c) then myReturn(c) else raiseError("Not a Con"))
  Apply(Thunk(Lam(x, b), e), a) then
    myBind(myGet, orig => withEnv(e, pushVar(x, Thunk(a, orig), eval(Eval(b)))))
  Eval(t) and t is
    Var(x) then myBind(myGet, _ => myBind(lookupVar(x), t => eval(Eval(t))))
    Add(u, v) then
      myBind(eval(EvalCon(u)), i => myBind(eval(EvalCon(v)), j => myReturn(Con(i + j))))
    Thunk(t, e) then withEnv(e, eval(Eval(t)))
    Lam(x, b) then myBind(myGet, env => myReturn(Thunk(Lam(x, b), env)))
    App(u, v) then myBind(eval(Eval(u)), value => eval(Apply(value, v)))
    IfZero(c, a, b) then
      myBind(eval(Eval(c)),
        value => if equal(CompareTerm(value, Con(0))) then eval(Eval(a)) else eval(Eval(b)))
    Con(i) then myReturn(Con(i))
    Incr() then myBind(incr, _ => myReturn(Con(0)))
//│ CTML translation succeeded.

/** Evaluate a term in a supplied environment. */
data class SimpleEval(env, t)
/** Apply a closure with its argument captured in the supplied environment. */
data class SimpleApply(env, t, a)
/** Evaluate a term in a supplied environment and extract its integer. */
data class SimpleEvalCon(env, t)
//│ SimpleEval: ∀α, β. α → β → ((SimpleEval ∧ {env: α}) ∧ {t: β})
//│ SimpleApply: ∀γ, δ, ε. γ → δ → ε → (((SimpleApply ∧ {env: γ}) ∧ {t: δ}) ∧ {a: ε})
//│ SimpleEvalCon: ∀ζ, η. ζ → η → ((SimpleEvalCon ∧ {env: ζ}) ∧ {t: η})

:ctml-parse-only // FIXME: Lookup and equality are translation-only.
/** Evaluate directly, retaining the source's evaluation order and throwing branches. */
fun simpleEval(task) = if task is
  SimpleApply(env, t, a) then
    if t is Thunk(Lam(x, b), e) then simpleEval(SimpleEval(LCons([x, Thunk(a, env)], e), b))
    else raiseError("bad application")
  SimpleEvalCon(env, t) then
    if simpleEval(SimpleEval(env, t)) is Con(i) then i else raiseError("Not a Con")
  SimpleEval(env, t) and t is
    Var(v) then
      let value = myMaybe(_ => raiseError("undefined var"), x => x, lookup(v, env))
      simpleEval(SimpleEval(env, value))
    Con(i) then Con(i)
    Incr() then Con(0)
    Add(u, v) then
      let i = simpleEval(SimpleEvalCon(env, u))
      let j = simpleEval(SimpleEvalCon(env, v))
      Con(i + j)
    Lam(x, b) then Thunk(Lam(x, b), env)
    App(u, v) then
      let value = simpleEval(SimpleEval(env, u))
      simpleEval(SimpleApply(env, value, v))
    IfZero(c, a, b) then
      let value = simpleEval(SimpleEval(env, c))
      if equal(CompareTerm(value, Con(0))) then simpleEval(SimpleEval(env, a))
      else simpleEval(SimpleEval(env, b))
    Thunk(t, e) then simpleEval(SimpleEval(e, t))
    else raiseError(errorMessage(t))
//│ CTML translation succeeded.

raiseError(errorMessage(42)) as Bot
//│ ⊥

/** Parenthesize a term at or below the surrounding precedence. */
fun bracket(ambient, own, text) =
  if own <= ambient then LCons("(", append(text, LCons(")", LNil()))) else text
//│ bracket: ∀α, β. {β ≥ Str, α ≤ ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: X})} ⟹ X} ⟹ Int → Int → α → (α ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀Z. {Z ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Z})} ⟹ Z}))

bracket(1, 0, LCons("x", LNil())) as Name
//│ Name

/** Print a term at the given precedence. */
data class PrintTerm(precedence, t)
/** Print an environment with its surrounding brackets. */
data class PrintEnv(env)
/** Print successive bindings inside the brackets. */
data class PrintBindings(env)
//│ PrintTerm: ∀α, β. α → β → ((PrintTerm ∧ {precedence: α}) ∧ {t: β})
//│ PrintEnv: ∀γ. γ → (PrintEnv ∧ {env: γ})
//│ PrintBindings: ∀δ. δ → (PrintBindings ∧ {env: δ})

:ctml-parse-only // FIXME: The character producers cannot instantiate the append input types.
/** Render the term or environment with the source precedence and separators. */
fun print(task) = if task is
  PrintTerm(n, t) and t is
    Var(v) then v
    Con(i) then nofibStringToList(stringOfInt(i))
    Incr() then nofibStringToList("INCR")
    Lam(v, t) then bracket(n, 0, LCons("@",
      append(v, append(nofibStringToList(". "), print(PrintTerm(0 - 1, t))))))
    Add(a, b) then bracket(n, 1,
      append(print(PrintTerm(1, a)), append(nofibStringToList(" + "), print(PrintTerm(1, b)))))
    App(a, b) then bracket(n, 2,
      append(print(PrintTerm(2, a)), append(nofibStringToList(" "), print(PrintTerm(2, b)))))
    IfZero(c, a, b) then bracket(n, 0,
      append(nofibStringToList("IF "), append(print(PrintTerm(0, c)),
        append(nofibStringToList(" THEN "), append(print(PrintTerm(0, a)),
          append(nofibStringToList(" ELSE "), print(PrintTerm(0, b))))))))
    Thunk(t, e) then bracket(n, 0,
      append(print(PrintTerm(3, t)), append(nofibStringToList("::"), print(PrintEnv(e)))))
  PrintEnv(env) then LCons("[", append(print(PrintBindings(env)), LCons("]", LNil())))
  PrintBindings(LNil()) then LNil()
  PrintBindings(LCons([v, t], rest)) then
    let binding = append(v, LCons("=", append(print(PrintTerm(0, t)), nofibStringToList(", "))))
    append(binding, print(PrintBindings(rest)))
//│ CTML translation succeeded.

/** Build the self-application used twice by the source fixed-point term. */
val lfxx = Lam(LCons("x", LNil()), App(Var(LCons("F", LNil())),
  App(Var(LCons("x", LNil())), Var(LCons("x", LNil())))))
//│ lfxx: (Lam ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}) ∧ {t: (App ∧ {a: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}) ∧ {b: (App ∧ {a: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}) ∧ {b: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}}}

/** The fixed-point term in the object language. */
val fixTerm = Lam(LCons("F", LNil()), App(lfxx, lfxx))
//│ fixTerm: (Lam ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}) ∧ {t: (App ∧ {a: (Lam ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}) ∧ {t: (App ∧ {a: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}) ∧ {b: (App ∧ {a: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}) ∧ {b: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}}}}) ∧ {b: (Lam ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}) ∧ {t: (App ∧ {a: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}) ∧ {b: (App ∧ {a: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}) ∧ {b: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}}}}}

/** The decrement in the recursive summation term. */
val nMinus1 = Add(Var(LCons("n", LNil())), Con(0 - 1))
//│ nMinus1: (Add ∧ {a: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}) ∧ {b: Con ∧ {i: Int}}

/** A summation body taking its recursive call as an argument. */
val partialSum0 =
  let n = LCons("n", LNil())
  let sum = LCons("s", LCons("u", LCons("m", LNil())))
  Lam(sum, Lam(n, IfZero(Var(n), Con(0), Add(Var(n), App(Var(sum), nMinus1)))))
//│ partialSum0: (Lam ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: (LCons ∧ {head: Str}) ∧ {tail: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}}) ∧ {t: (Lam ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}) ∧ {t: ((IfZero ∧ {a: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}) ∧ {b: Con ∧ {i: Int}}) ∧ {c: (Add ∧ {a: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}) ∧ {b: (App ∧ {a: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: (LCons ∧ {head: Str}) ∧ {tail: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}}}) ∧ {b: (Add ∧ {a: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}) ∧ {b: Con ∧ {i: Int}}}}}}}

/** Tie the recursive knot in the object language. */
val sum0 = App(fixTerm, partialSum0)
//│ sum0: (App ∧ {a: (Lam ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}) ∧ {t: (App ∧ {a: (Lam ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}) ∧ {t: (App ∧ {a: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}) ∧ {b: (App ∧ {a: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}) ∧ {b: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}}}}) ∧ {b: (Lam ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}) ∧ {t: (App ∧ {a: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}) ∧ {b: (App ∧ {a: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}) ∧ {b: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}}}}}}) ∧ {b: (Lam ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: (LCons ∧ {head: Str}) ∧ {tail: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}}) ∧ {t: (Lam ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}) ∧ {t: ((IfZero ∧ {a: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}) ∧ {b: Con ∧ {i: Int}}) ∧ {c: (Add ∧ {a: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}) ∧ {b: (App ∧ {a: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: (LCons ∧ {head: Str}) ∧ {tail: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}}}) ∧ {b: (Add ∧ {a: Var ∧ {s: (LCons ∧ {head: Str}) ∧ {tail: LNil}}}) ∧ {b: Con ∧ {i: Int}}}}}}}}

/** Render the direct evaluator's result with its constructor label. */
fun showTerm(t) = if t is Con(i) then
  append(nofibStringToList("Con "), nofibStringToList(stringOfInt(i)))
//│ showTerm: ∀Z. {Z ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: Z})} ⟹ ({i: Int} ∧ Con) → Z

:ctml-parse-only // FIXME: Stateful evaluation and printing are translation-only.
/** Run the stateful evaluator in an empty environment and print both results. */
fun ev(t) = if myRunState(eval(Eval(t)), LNil()) is [env, value] then
  append(print(PrintTerm(0, value)), append(nofibStringToList("  "), print(PrintEnv(env))))
//│ CTML translation succeeded.

