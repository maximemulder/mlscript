/** Apply the success continuation. The source helper has no branch for None. */
fun myMaybe(_fallback, f, x) = if x is Some(value) then f(value)
//│ myMaybe: ∀α, β. ⊤ → (α → β) → ({x: α} ∧ Some) → β

myMaybe(_ => raiseError("undefined"), x => x + 1, Some(7)) as Int
//│ Int

