/** A variable name made of source string code units. */
type Name = [X restricts (LNil | (LCons & {head: Str} & {tail: X}))] -> X
//│ Name = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: X})} ⟹ X

/** A variable reference. */
data class Var(s: Name)
/** An integer constant. */
data class Con(i: Int)
/** The increment operation. */
data class Incr()
/** An addition of two terms. */
data class Add(a, b)
/** A lambda abstraction. */
data class Lam(s: Name, t)
/** A function application. */
data class App(a, b)
/** A conditional with a zero test. */
data class IfZero(a, b, c)
/** A term with its captured environment. */
data class Thunk(t, e)
/** The value of the increment computation. */
data class UnitValue()
//│ Var: ∀α. {α ≤ Name} ⟹ α → (Var ∧ {s: α})
//│ Con: ∀β. {β ≤ Int} ⟹ β → (Con ∧ {i: β})
//│ Incr: Unit → Incr
//│ Add: ∀γ, δ. γ → δ → ((Add ∧ {a: γ}) ∧ {b: δ})
//│ Lam: ∀ε, ζ. {ε ≤ Name} ⟹ ε → ζ → ((Lam ∧ {s: ε}) ∧ {t: ζ})
//│ App: ∀η, θ. η → θ → ((App ∧ {a: η}) ∧ {b: θ})
//│ IfZero: ∀ι, κ, λ. ι → κ → λ → (((IfZero ∧ {a: ι}) ∧ {b: κ}) ∧ {c: λ})
//│ Thunk: ∀μ, ν. μ → ν → ((Thunk ∧ {t: μ}) ∧ {e: ν})
//│ UnitValue: Unit → UnitValue

if Thunk(Lam(LCons("x", LNil()), Con(3)), LNil()) is Thunk(Lam(name, Con(i)), env) then
  [name as Name, [i as Int, env as LNil]]
//│ ⟨Name, ⟨Int, LNil⟩⟩

