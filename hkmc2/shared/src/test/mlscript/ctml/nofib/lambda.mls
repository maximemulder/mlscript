/** Run the direct evaluator on the first supplied input. */
fun mainSimple(args) = if null_(args) then raiseError("Args: number-to-sum-up-to")
  else showTerm(simpleEval(SimpleEval(LNil(), App(sum0, Con(head(args))))))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Stateful evaluation is translation-only.
/** Run the stateful evaluator on the first supplied input. */
fun mainMonad(args) = if null_(args) then raiseError("Args: number-to-sum-up-to")
  else ev(App(sum0, Con(head(args))))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Both evaluator drivers are translation-only.
/** Run both evaluators in source order on the same input. */
fun testLambda_nofib(n) = [mainSimple(LCons(n, LNil())), mainMonad(LCons(n, LNil()))]
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The paired evaluator run is translation-only.
/** Format the results with the comma used by the source pair's toString. */
