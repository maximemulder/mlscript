/** Test whether a reduced choice contains an available layout. */
fun nonEmptySet(doc) = if doc is
  NoDoc() then false
  Union(_, _) then true
  Empty() then true
  NilAbove(_) then true
  TextBeside(_, p) then nonEmptySet(p)
  Nest(_, p) then nonEmptySet(p)
  Above(_, _, _) then raiseError("nonEmptySet Above")
  Beside(_, _, _) then raiseError("nonEmptySet Beside")
//│ CTML translation succeeded.

