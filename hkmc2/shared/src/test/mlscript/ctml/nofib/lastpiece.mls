/** Render with the source zigzag parameters and trailing newline. */
fun printDoc(d) =
  /** Prepend the text fragment to the rendered suffix. */
  fun put(k, next) = if k is
    Chr(c) then LCons(c, next)
    DocStr(s) then append(s, next)
    PStr(s) then append(s, next)
  let done = LCons("\n", LNil())
  fullRender(ZigZagMode(), 200, 1.5, put, done, d)
//│ CTML translation succeeded.

