/** Choose a layout at the beginning of a line. */
data class Get(w: Int, doc)
/** Choose a layout after processing sl columns on a line. */
data class Get1(w: Int, sl: Int, doc)
//│ Get: ∀α, β. {α ≤ Int} ⟹ α → β → ((Get ∧ {w: α}) ∧ {doc: β})
//│ Get1: ∀γ, δ, ε. {δ ≤ Int, γ ≤ Int} ⟹ γ → δ → ε → (((Get1 ∧ {w: γ}) ∧ {sl: δ}) ∧ {doc: ε})

