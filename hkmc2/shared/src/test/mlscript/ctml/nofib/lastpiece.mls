/** Render a reduced document with source indentation and optional zigzags. */
fun displayDoc(m, pageWidth, ribbonWidth, txt, done, doc) =
  let gapWidth = pageWidth - ribbonWidth
  let shift = intDiv(gapWidth, 2)
  /** Process line starts and continuations in the same traversal. */
  fun lay(k, task) = if task is
    WithinLine(d) and d is
      NilAbove(p) then txt(nlText, lay(k, AtLineStart(p)))
      TextBeside(s, p) then txt(s, lay(k + annotSize(s), WithinLine(p)))
      Nest(_, p) then lay(k, WithinLine(p))
      Empty() then done
    AtLineStart(d) and d is
      Nest(k1, p) then lay(k + k1, AtLineStart(p))
      Empty() then done
      NilAbove(p) then txt(nlText, lay(k, AtLineStart(p)))
      TextBeside(s, p) then
        /** Prepend the indent and the first fragment on the line. */
        fun lay1(k) =
          let r = k + annotSize(s)
          txt(NoAnnot(DocStr(indent(k)), k), txt(s, lay(r, WithinLine(p))))
        if m is ZigZagMode() then
          if
            gapWidth <= k then
              let slashes = NoAnnot(DocStr(replicate(shift, "/")), shift)
              txt(nlText, txt(slashes, txt(nlText, lay1(k - shift))))
            k < 0 then
              let bars = NoAnnot(DocStr(replicate(shift, "|")), shift)
              txt(nlText, txt(bars, txt(nlText, lay1(k + shift))))
            else lay1(k)
        else lay1(k)
  lay(0, AtLineStart(doc))
//│ CTML translation succeeded.

