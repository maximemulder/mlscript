/** A proper list of source character code units. */
type Chars = [X restricts (LNil | (LCons & {head: Str} & {tail: X}))] -> X
//│ Chars = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: X})} ⟹ X

/** The page-width rendering mode. */
data class PageMode()
/** Show line shifts through a zigzag pattern. */
data class ZigZagMode()
/** Render left-aligned with source line breaks. */
data class LeftMode()
/** Render as one line with spaces between fragments. */
data class OneLineMode()
//│ PageMode: Unit → PageMode
//│ ZigZagMode: Unit → ZigZagMode
//│ LeftMode: Unit → LeftMode
//│ OneLineMode: Unit → OneLineMode

/** One character of text. */
data class Chr(c: Str)
/** A strict character list. */
data class DocStr(s: Chars)
/** A preformatted character list. */
data class PStr(s: Chars)
//│ Chr: ∀α. {α ≤ Str} ⟹ α → (Chr ∧ {c: α})
//│ DocStr: ∀β. {β ≤ Chars} ⟹ β → (DocStr ∧ {s: β})
//│ PStr: ∀γ. {γ ≤ Chars} ⟹ γ → (PStr ∧ {s: γ})

/** Start an annotation. */
data class AnnotStart()
/** End an annotation. */
data class AnnotEnd()
/** A text fragment and its width. */
data class NoAnnot(t, i: Int)
//│ AnnotStart: Unit → AnnotStart
//│ AnnotEnd: Unit → AnnotEnd
//│ NoAnnot: ∀α, β. {β ≤ Int} ⟹ α → β → ((NoAnnot ∧ {t: α}) ∧ {i: β})

/** The negative flag in the source document-reduction result. */
data class IsEmpty()
/** The positive flag in the source document-reduction result. */
data class NotEmpty()
//│ IsEmpty: Unit → IsEmpty
//│ NotEmpty: Unit → NotEmpty

/** The empty document. */
data class Empty()
/** A failed document choice. */
data class NoDoc()
/** A line break followed by a document. */
data class NilAbove(d)
/** An annotated fragment followed by a document. */
data class TextBeside(a, d)
/** A document with a changed indent. */
data class Nest(i: Int, d)
/** Two candidate document layouts. */
data class Union(d1, d2)
/** Horizontal concatenation with a source spacing flag. */
data class Beside(d1, b: Bool, d2)
/** Vertical concatenation with a source overlap flag. */
data class Above(d1, b: Bool, d2)
//│ Empty: Unit → Empty
//│ NoDoc: Unit → NoDoc
//│ NilAbove: ∀α. α → (NilAbove ∧ {d: α})
//│ TextBeside: ∀β, γ. β → γ → ((TextBeside ∧ {a: β}) ∧ {d: γ})
//│ Nest: ∀δ, ε. {δ ≤ Int} ⟹ δ → ε → ((Nest ∧ {i: δ}) ∧ {d: ε})
//│ Union: ∀ζ, η. ζ → η → ((Union ∧ {d1: ζ}) ∧ {d2: η})
//│ Beside: ∀θ, ι, κ. {ι ≤ Bool} ⟹ θ → ι → κ → (((Beside ∧ {d1: θ}) ∧ {b: ι}) ∧ {d2: κ})
//│ Above: ∀λ, μ, ν. {μ ≤ Bool} ⟹ λ → μ → ν → (((Above ∧ {d1: λ}) ∧ {b: μ}) ∧ {d2: ν})

/** The space fragment used for one-line rendering and separation. */
val spaceText = NoAnnot(Chr(" "), 1)
/** The newline fragment used by the renderers. */
val nlText = NoAnnot(Chr("\n"), 1)
//│ spaceText: (NoAnnot ∧ {t: Chr ∧ {c: Str}}) ∧ {i: Int}
//│ nlText: (NoAnnot ∧ {t: Chr ∧ {c: Str}}) ∧ {i: Int}

/** Return the width of a text fragment or zero for an annotation marker. */
fun annotSize(p) = if p is
  NoAnnot(_, l) then l
  else 0
//│ annotSize: ∀α, β. {β ≥ ({α ≤ ({i: β} ∧ NoAnnot) ∧ {t: ⊤}} ⟹ ⊥) ∧ ({α ≤ ¬((NoAnnot ∧ {t: ⊤}) ∧ {i: ⊤})} ⟹ Int), α ≤ (({i: β} ∧ NoAnnot) ∧ {t: ⊤}) ∨ ¬({β ≥ Int} ⟹ (NoAnnot ∧ {t: ⊤}) ∧ {i: ⊤})} ⟹ α → β

:ctml-parse-only // FIXME: The empty-document branches exceed the 20000-call budget.
/** Keep the reduced right document when the left document is empty. */
fun eliminateEmpty(cons, p, g, q) = if p is
  Empty() then q
  else [NotEmpty(),
    if q is
      [NotEmpty(), q1] then cons(p, g, q1)
      [IsEmpty(), _] then p
  ]
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The empty-document helper is translation-only.
/** Reduce adjacent vertical nodes in source order. */
fun reduceVert(doc) = if doc is
  Above(p, g, q) then
    eliminateEmpty((a, b, c) => Above(a, b, c), snd(reduceVert(p)), g, reduceVert(q))
  else [NotEmpty(), doc]
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Vertical reduction is translation-only.
/** Concatenate a list of documents vertically, without overlap. */
fun vcat(ls) = snd(reduceVert(foldr((p, q) => Above(p, false, q), Empty(), ls)))
//│ CTML translation succeeded.

/** Construct a text fragment with its list length. */
fun text(s) = TextBeside(NoAnnot(DocStr(s), listLen(s)), Empty())
//│ text: ∀α. {α ≤ Chars} ⟹ α → ((TextBeside ∧ {a: (NoAnnot ∧ {t: DocStr ∧ {s: α}}) ∧ {i: Int}}) ∧ {d: Empty})

/** Construct a single-character document. */
fun char(c) = TextBeside(NoAnnot(Chr(c), 1), Empty())
//│ char: ∀α. {α ≤ Str} ⟹ α → ((TextBeside ∧ {a: (NoAnnot ∧ {t: Chr ∧ {c: α}}) ∧ {i: Int}}) ∧ {d: Empty})

:ctml-parse-only // FIXME: The empty-document helper is translation-only.
/** Reduce adjacent horizontal nodes in source order. */
fun reduceHoriz(doc) = if doc is
  Beside(p, g, q) then
    eliminateEmpty((a, b, c) => Beside(a, b, c), snd(reduceHoriz(p)), g, reduceHoriz(q))
  else [NotEmpty(), doc]
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Horizontal reduction is translation-only.
/** Concatenate a list of documents horizontally, without spaces. */
fun hcat(ls) = snd(reduceHoriz(foldr((p, q) => Beside(p, false, q), Empty(), ls)))
//│ CTML translation succeeded.

/** Stack two documents using the source empty tests. */
fun above_(p, g, q) = if
  q is Empty() then p
  g is Empty() then q
  else Above(p, g, q)
//│ above_: ∀α, β, γ, δ. {δ ≥ ({γ ≤ Empty} ⟹ α) ∧ ({β ≤ ¬({δ ≥ γ} ⟹ ¬Empty) ∨ ¬({δ ≥ ((Above ∧ {d1: α}) ∧ {b: β}) ∧ {d2: γ}} ⟹ ¬Bool), γ ≤ ¬Empty} ⟹ ({β ≤ Empty} ⟹ γ) ∧ ({β ≤ Bool} ⟹ ((Above ∧ {d1: α}) ∧ {b: β}) ∧ {d2: γ})), γ ≤ ¬({δ ≥ α} ⟹ ¬Empty) ∨ ¬({β ≤ ¬({δ ≥ γ} ⟹ ¬Empty) ∨ ¬({δ ≥ ((Above ∧ {d1: α}) ∧ {b: β}) ∧ {d2: γ}} ⟹ ¬Bool), δ ≥ ({β ≤ Empty} ⟹ γ) ∧ ({β ≤ Bool} ⟹ ((Above ∧ {d1: α}) ∧ {b: β}) ∧ {d2: γ})} ⟹ Empty), β ≤ ¬({γ ≤ Empty, δ ≥ α} ⟹ ⊥) ∨ ¬({γ ≤ ¬Empty, δ ≥ ({β ≤ Empty} ⟹ γ) ∧ ({β ≤ Bool} ⟹ ((Above ∧ {d1: α}) ∧ {b: β}) ∧ {d2: γ})} ⟹ ¬(¬({δ ≥ γ} ⟹ ¬Empty) ∨ ¬({δ ≥ ((Above ∧ {d1: α}) ∧ {b: β}) ∧ {d2: γ}} ⟹ ¬Bool)))} ⟹ α → β → γ → δ

:ctml-parse-only // FIXME: Combining nested indents exceeds the 20000-call budget.
/** Combine nested indents and drop a zero indent. */
fun mkNest(k, p) = if
  p is Nest(k1, p1) then mkNest(k + k1, p1)
  p is NoDoc() then NoDoc()
  p is Empty() then Empty()
  k === 0 then p
  else Nest(k, p)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Recursive separator insertion exceeds the 20000-call budget.
/** Skip nesting and add the source separator when requested. */
fun nilBeside(g, p) = if
  p is Empty() then Empty()
  p is Nest(_, p1) then nilBeside(g, p1)
  g then TextBeside(spaceText, p)
  else p
//│ CTML translation succeeded.

/** Construct a list of n spaces. */
fun indent(n) = if n <= 0 then LNil() else LCons(" ", indent(n - 1))
//│ indent: ∀α. {α ≥ ((LCons ∧ {head: Str}) ∧ {tail: α}) ∨ LNil} ⟹ Int → (((LCons ∧ {head: Str}) ∧ {tail: α}) ∨ LNil)

:ctml-parse-only // FIXME: Combining nested indents is translation-only.
/** Start a new line unless source overlap can fill its indent with spaces. */
fun nilAboveNest(g, k, q) = if
  q is Empty() then Empty()
  q is Nest(k1, q1) then nilAboveNest(g, k + k1, q1)
  else
    if g then NilAbove(mkNest(k, q))
