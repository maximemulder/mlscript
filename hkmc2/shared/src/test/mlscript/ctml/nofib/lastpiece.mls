/** Test the first line length against the remaining width. */
fun fits(n, param) = if
  n < 0 then false
  param is
    NoDoc() then false
    Empty() then true
    NilAbove(_) then true
    TextBeside(s, p) then fits(n - annotSize(s), p)
    Above(_, _, _) then raiseError("fits Above")
    Beside(_, _, _) then raiseError("fits Beside")
    Union(_, _) then raiseError("fits Union")
    Nest(_, _) then raiseError("fits Nest")
//│ CTML translation succeeded.

