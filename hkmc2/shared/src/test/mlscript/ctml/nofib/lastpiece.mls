size(emptyBoard) as Int
size(Bin(1, [1, 2], "a", Tip(), Tip())) as Int
if Bin(1, [1, 2], "a", Tip(), Tip()) is Bin(n, k, v, _, _) then [n as Int, [k as Coord, v as Str]]
//│ (LT ∨ GT) ∨ EQ
