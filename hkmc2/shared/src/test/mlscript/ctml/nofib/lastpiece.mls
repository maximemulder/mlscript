/** Render a reduced document with the supplied line separator and layout choice. */
fun easyDisplay(nlSpaceText, choose, txt, done, x) =
  /** Consume reduced document nodes in source order. */
  fun lay(x) = if x is
    NoDoc() then raiseError("easyDisplay: NoDoc")
    Union(p, q) then lay(choose(p, q))
    Nest(_, p) then lay(p)
    Empty() then done
    NilAbove(p) then txt(nlSpaceText, lay(p))
    TextBeside(s, p) then txt(s, lay(p))
    Above(_, _, _) then raiseError("easyDisplay Above")
    Beside(_, _, _) then raiseError("easyDisplay Beside")
  lay(x)
//│ CTML translation succeeded.

/** A document fragment at the beginning of a line. */
data class AtLineStart(doc)
/** A document fragment that follows text on the same line. */
data class WithinLine(doc)
//│ AtLineStart: ∀α. α → (AtLineStart ∧ {doc: α})
//│ WithinLine: ∀β. β → (WithinLine ∧ {doc: β})

