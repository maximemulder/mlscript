/** Choose the source layout using page width and ribbon width. */
fun best(w0, r, doc) =
  /** Visit the document before or after the beginning of a line. */
  fun get(task) = if task is
    Get(w, d) and d is
      Empty() then Empty()
      NoDoc() then NoDoc()
      NilAbove(p) then NilAbove(get(Get(w, p)))
      TextBeside(s, p) then TextBeside(s, get(Get1(w, annotSize(s), p)))
      Nest(k, p) then Nest(k, get(Get(w - k, p)))
      Union(p, q) then nicest(w, r, get(Get(w, p)), get(Get(w, q)))
      Above(_, _, _) then raiseError("best get Above")
      Beside(_, _, _) then raiseError("best get Beside")
    Get1(w, sl, d) and d is
      Empty() then Empty()
      NoDoc() then NoDoc()
      NilAbove(p) then NilAbove(get(Get(w - sl, p)))
      TextBeside(s, p) then TextBeside(s, get(Get1(w, sl + annotSize(s), p)))
      Nest(_, p) then get(Get1(w, sl, p))
      Union(p, q) then nicest1(w, r, sl, get(Get1(w, sl, p)), get(Get1(w, sl, q)))
      Above(_, _, _) then raiseError("best get1 Above")
      Beside(_, _, _) then raiseError("best get1 Beside")
  get(Get(w0, doc))
//│ CTML translation succeeded.

