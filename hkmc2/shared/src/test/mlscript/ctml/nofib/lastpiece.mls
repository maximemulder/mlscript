// Source: hkmc2/shared/src/test/mlscript-compile/nofib/lastpiece.mls.
// The board map and document constructors carry recursive children in structural fields.
// Search and document evaluation retain mutual recursion through tagged dispatchers.

/** A board coordinate or placement offset. */
type Coord = [Int, Int]
//│ Coord = ⟨Int, Int⟩

/** A proper list of offsets in a placement. */
type Offsets = [X restricts (LNil | (LCons & {head: Coord} & {tail: X}))] -> X
//│ Offsets = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Coord}) ∧ {tail: X})} ⟹ X

/** A proper list of placements for one orientation. */
type Placements = [X restricts (LNil | (LCons & {head: Offsets} & {tail: X}))] -> X
//│ Placements = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Offsets}) ∧ {tail: X})} ⟹ X

/** An unsuccessful lookup or placement. */
data class None()
/** A successful lookup or placement with its value. */
data class Some(value)
//│ None: Unit → None
//│ Some: ∀α. α → (Some ∧ {value: α})

:ctml-parse-only // FIXME: Recursive filtering and mapping exceed the 20000-call budget.
/** Keep the successful results of a source mapping in order. */
fun mapMaybe(f, ls) = if ls is
  LNil() then LNil()
  LCons(h, t) and f(h) is
    None() then mapMaybe(f, t)
    Some(a) then LCons(a, mapMaybe(f, t))
//│ CTML translation succeeded.

/** A greater left coordinate. */
data class GT()
/** A smaller left coordinate. */
data class LT()
/** Equal coordinates. */
data class EQ()
//│ GT: Unit → GT
//│ LT: Unit → LT
//│ EQ: Unit → EQ

/** Order coordinates by row and then by column. */
fun compareIntInt(ab, cd) = if ab is [a, b] and cd is [c, d] then
  if
    c < a then GT()
    a < c then LT()
    d < b then GT()
    b < d then LT()
    else EQ()
//│ compareIntInt: ⟨Int, Int⟩ → ⟨Int, Int⟩ → ((EQ ∨ LT) ∨ GT)

/** An empty board map. */
data class Tip()
/** A node with its cached size, coordinate, marker, and left and right subtrees. */
data class Bin(i: Int, k: Coord, v: Str, l, r)
//│ Tip: Unit → Tip
//│ Bin: ∀α, β, γ, δ, ε. {β ≤ Coord, γ ≤ Str, α ≤ Int} ⟹ α → β → γ → δ → ε → (((((Bin ∧ {i: α}) ∧ {k: β}) ∧ {v: γ}) ∧ {l: δ}) ∧ {r: ε})

:ctml-parse-only // FIXME: Recursive board lookup exceeds the 20000-call budget.
/** Find a coordinate in the board map. */
fun mapLookup(k, m) = if m is
  Tip() then None()
  Bin(_, kx, x, l, r) and compareIntInt(k, kx) is
    LT() then mapLookup(k, l)
    GT() then mapLookup(k, r)
    EQ() then Some(x)
//│ CTML translation succeeded.

/** Read the subtree size from its root. */
fun size(p) = if p is
  Tip() then 0
  Bin(sz, _, _, _, _) then sz
//│ size: ∀α, β. {β ≥ ({α ≤ Tip} ⟹ Int) ∧ ({α ≤ (((({i: β} ∧ Bin) ∧ {k: ⊤}) ∧ {v: ⊤}) ∧ {l: ⊤}) ∧ {r: ⊤}} ⟹ ⊥), α ≤ ¬({β ≥ Int} ⟹ ¬Tip) ∨ ((((({i: β} ∧ Bin) ∧ {k: ⊤}) ∧ {v: ⊤}) ∧ {l: ⊤}) ∧ {r: ⊤})} ⟹ α → β

:ctml-parse-only // FIXME: Composing two subtree sizes exceeds the 20000-call budget.
/** Construct a node and count its children. */
fun bin(k, x, l, r) = Bin(size(l) + size(r) + 1, k, x, l, r)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Node construction via bin is translation-only.
/** Rotate a right child to the root. */
fun singleL(k1, x1, t1, r) = if r is
  Bin(_, k2, x2, t2, t3) then bin(k2, x2, bin(k1, x1, t1, t2), t3)
  else raiseError("singleL Tip")
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Node construction via bin is translation-only.
/** Rotate a left child to the root. */
fun singleR(k1, x1, l, t3) = if l is
  Bin(_, k2, x2, t1, t2) then bin(k2, x2, t1, bin(k1, x1, t2, t3))
  else raiseError("singleR Tip")
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Node construction via bin is translation-only.
/** Rotate the right child's left child to the root. */
fun doubleL(k1, x1, t1, r) = if r is
  Bin(_, k2, x2, Bin(_, k3, x3, t2, t3), t4) then
    bin(k3, x3, bin(k1, x1, t1, t2), bin(k2, x2, t3, t4))
  else raiseError("doubleL Tip")
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Node construction via bin is translation-only.
/** Rotate the left child's right child to the root. */
fun doubleR(k1, x1, l, t4) = if l is
  Bin(_, k2, x2, t1, Bin(_, k3, x3, t2, t3)) then
    bin(k3, x3, bin(k2, x2, t1, t2), bin(k1, x1, t3, t4))
  else raiseError("doubleR Tip")
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The left rotations are translation-only.
/** Choose the source single or double left rotation. */
fun rotateL(k, x, l, r) = if r is
  Bin(_, _, _, ly, ry) then
    if size(ly) < 2 * size(ry) then singleL(k, x, l, r) else doubleL(k, x, l, r)
  else raiseError("rotateL Tip")
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The right rotations are translation-only.
/** Choose the source single or double right rotation. */
fun rotateR(k, x, l, r) = if l is
  Bin(_, _, _, ly, ry) then
    if size(ry) < 2 * size(ly) then singleR(k, x, l, r) else doubleR(k, x, l, r)
  else raiseError("rotateR Tip")
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Both rotations are translation-only.
/** Apply the source factor-four subtree balance rule. */
fun balance(k, x, l, r) =
  let sizeL = size(l)
  let sizeR = size(r)
  let sizeX = sizeL + sizeR + 1
  if
    sizeL + sizeR <= 1 then Bin(sizeX, k, x, l, r)
    4 * sizeL <= sizeR then rotateL(k, x, l, r)
    4 * sizeR <= sizeL then rotateR(k, x, l, r)
    else Bin(sizeX, k, x, l, r)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Balancing a node is translation-only.
/** Insert or replace a board marker, rebalancing along the insertion path. */
fun insert(kx, x, m) = if m is
  Tip() then Bin(1, kx, x, Tip(), Tip())
  Bin(sz, ky, y, l, r) and compareIntInt(kx, ky) is
    LT() then balance(ky, y, insert(kx, x, l), r)
    GT() then balance(ky, y, l, insert(kx, x, r))
    EQ() then Bin(sz, kx, x, l, r)
//│ CTML translation succeeded.

/** The first orientation of a square. */
data class Male()
/** The second orientation of a square. */
data class Female()
//│ Male: Unit → Male
//│ Female: Unit → Female

/** Switch to the opposite square orientation. */
fun flip(s) = if s is
  Male() then Female()
  Female() then Male()
//│ flip: ∀α, β. {β ≥ ({α ≤ Male} ⟹ Female) ∧ ({α ≤ Female} ⟹ Male), α ≤ ¬({β ≥ Female} ⟹ ¬Male) ∨ ¬({β ≥ Male} ⟹ ¬Female)} ⟹ α → β

/** A piece marker and its two orientation-specific placement lists. */
data class P(i: Str, a: Placements, b: Placements)
//│ P: ∀α, β, γ. {β ≤ Placements, γ ≤ Placements, α ≤ Str} ⟹ α → β → γ → (((P ∧ {i: α}) ∧ {a: β}) ∧ {b: γ})

/** A completed board. */
data class Soln(b)
/** The results of feasible placements at a square. */
data class Choose(s)
/** The board and square where no placement fits. */
data class Fail(b, s: Coord)
//│ Soln: ∀α. α → (Soln ∧ {b: α})
//│ Choose: ∀β. β → (Choose ∧ {s: β})
//│ Fail: ∀γ, δ. {δ ≤ Coord} ⟹ γ → δ → ((Fail ∧ {b: γ}) ∧ {s: δ})

/** Add a placement offset to a board coordinate. */
fun addIntInt(row_col, orow_ocol) =
  if row_col is [row, col] and orow_ocol is [orow, ocol] then [row + orow, col + ocol]
//│ addIntInt: ⟨Int, Int⟩ → ⟨Int, Int⟩ → ⟨Int, Int⟩

/** Advance to the next column. */
fun next(row_col) = if row_col is [row, col] then [row, col + 1]
//│ next: ∀α. ⟨α, Int⟩ → ⟨α, Int⟩

/** Last board row. */
val maxRow = 8
/** Last board column. */
val maxCol = 8
/** Initial empty board. */
val emptyBoard = Tip()
//│ maxRow: Int
//│ maxCol: Int
//│ emptyBoard: Tip

:ctml-parse-only // FIXME: Board lookup is translation-only.
/** Check whether a coordinate has a marker. */
fun check(bd, sq) = mapLookup(sq, bd)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Board insertion is translation-only.
/** Record a marker at a coordinate. */
fun extend(bd, sq, id) = insert(sq, id, bd)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Board lookup and insertion are translation-only.
/** Add a marker only within the source bounds and on an unoccupied square. */
fun extend_maybe(bd, sq, id) = if sq is [row, col] then
  if
    maxRow < row || col < 1 || maxCol < col then None()
    check(bd, sq) is
      Some(_) then None()
      None() then Some(extend(bd, sq, id))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Recursive residual-list construction exceeds the 20000-call budget.
/** Enumerate each choice paired with the residual list in source order. */
fun pickOne(xs) =
  /** Rebuild the prefix of each residual list with the accumulated function. */
  fun go(f, xs) = if xs is
    LNil() then LNil()
    LCons(x, rest) then LCons([x, f(rest)], go(p => LCons(x, f(p)), rest))
  go(x => x, xs)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Board lookup and insertion are translation-only.
/** Fit the offsets in order, writing the anchor after all offsets succeed. */
fun fit(bd, sq, id, os) = if os is
  LNil() then Some(extend(bd, sq, id))
  LCons(o, rest) and extend_maybe(bd, addIntInt(sq, o), id) is
    Some(bd1) then fit(bd1, sq, id, rest)
    None() then None()
//│ CTML translation succeeded.

/** Search the board starting at this square. */
data class Search(sq: Coord, sey, bd, ps)
/** Try one piece placement for the current search. */
data class TryPlacement(sq: Coord, sey, bd, placement)
//│ Search: ∀α, β, γ, δ. {α ≤ Coord} ⟹ α → β → γ → δ → ((((Search ∧ {sq: α}) ∧ {sey: β}) ∧ {bd: γ}) ∧ {ps: δ})
//│ TryPlacement: ∀ε, ζ, η, θ. {ε ≤ Coord} ⟹ ε → ζ → η → θ → ((((TryPlacement ∧ {sq: ε}) ∧ {sey: ζ}) ∧ {bd: η}) ∧ {placement: θ})

:ctml-parse-only // FIXME: The placement and mapping helpers are translation-only.
/** Continue the search or test one placement before continuing. */
fun search(task) = if task is
  TryPlacement(sq, se, bd, [id, [os, ps]]) and fit(bd, sq, id, os) is
    Some(bd1) then Some(search(Search(next(sq), flip(se), bd1, ps)))
    None() then None()
  Search(row_col, sey, bd, ps) and row_col is [row, col] then
    if
      ps is LNil() then Soln(bd)
      col === maxCol + 1 then search(Search([row + 1, 1], flip(sey), bd, ps))
      check(bd, row_col) is Some(_) then search(Search(next(row_col), flip(sey), bd, ps))
      else
        /** List the choices of piece and placement in source order. */
        fun lscomp1(ls) = if ls is
          LNil() then LNil()
          LCons([P(id, ms, fs), rest], more) then
            /** List all offsets for the selected piece and then visit the remaining choices. */
            fun lscomp2(ls2) = if ls2 is
              LNil() then lscomp1(more)
              LCons(os, tail) then LCons([id, [os, rest]], lscomp2(tail))
            lscomp2(if sey is Male() then ms else fs)
        let choices = lscomp1(pickOne(ps))
        let results = mapMaybe(x => search(TryPlacement(row_col, sey, bd, x)), choices)
        if results is LNil() then Fail(bd, row_col) else Choose(results)
//│ CTML translation succeeded.

compareIntInt([1, 2], [2, 1]) as (LT | GT | EQ)
