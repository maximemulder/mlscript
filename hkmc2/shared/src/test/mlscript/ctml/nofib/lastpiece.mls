/** Select the source rendering routine for the given mode. */
fun fullRenderAnn(m, lineLen, ribbons, txt, rest, doc) = if m is
  OneLineMode() then easyDisplay(spaceText, (a, b) => b, txt, rest, arrange(Reduce(doc)))
  LeftMode() then easyDisplay(nlText, first, txt, rest, arrange(Reduce(doc)))
  else
    let ribbonLen = numCeilToInt(numDiv(numFromInt(lineLen), ribbons))
    let bestLineLen = if m is ZigZagMode() then 2147483647 else lineLen
    let doc1 = best(bestLineLen, ribbonLen, arrange(Reduce(doc)))
    displayDoc(m, lineLen, ribbonLen, txt, rest, doc1)
//│ CTML translation succeeded.

