/** Render successes, flatten groups of choices, and omit failed placements. */
fun display(s) = if s is
  Soln(bd) then vcat(LCons(text(nofibStringToList("Success!")),
    LCons(nest(2, displayBoard(bd)), LNil())))
  Choose(ss) then vcat(map(display, ss))
  Fail(_, [_, _]) then Empty()
//│ CTML translation succeeded.

