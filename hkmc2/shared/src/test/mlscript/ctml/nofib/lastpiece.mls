/** Evaluate source document composition with the original reduction order. */
fun arrange(task) = if task is
  Reduce(p) and p is
    Beside(p1, g, q) then arrange(PlaceBeside(p1, g, arrange(Reduce(q))))
    Above(p1, g, q) then arrange(PlaceAbove(p1, g, arrange(Reduce(q))))
    else p
  PlaceBeside(p, g, q) and p is
    NoDoc() then NoDoc()
    Union(p1, p2) then
      Union(arrange(PlaceBeside(p1, g, q)), arrange(PlaceBeside(p2, g, q)))
    Empty() then q
    Nest(k, p1) then Nest(k, arrange(PlaceBeside(p1, g, q)))
    Beside(p1, g1, q1) then
      if g1 === g then arrange(PlaceBeside(p1, g1, arrange(PlaceBeside(q1, g, q))))
      else arrange(PlaceBeside(arrange(Reduce(Beside(p1, g1, q1))), g, q))
    Above(_, _, _) then arrange(PlaceBeside(arrange(Reduce(p)), g, q))
    NilAbove(p1) then NilAbove(arrange(PlaceBeside(p1, g, q)))
    TextBeside(t, p1) then
      let rest = if p1 is Empty() then nilBeside(g, q) else arrange(PlaceBeside(p1, g, q))
      TextBeside(t, rest)
  PlaceAbove(p, g, q) and p is
    Above(p1, g1, q1) then arrange(PlaceAbove(p1, g1, arrange(PlaceAbove(q1, g, q))))
    Beside(_, _, _) then
      arrange(PlaceAboveNest(arrange(Reduce(p)), g, 0, arrange(Reduce(q))))
    else arrange(PlaceAboveNest(p, g, 0, arrange(Reduce(q))))
  PlaceAboveNest(p, g, k, q) and p is
    NoDoc() then NoDoc()
    Union(p1, p2) then
      Union(arrange(PlaceAboveNest(p1, g, k, q)), arrange(PlaceAboveNest(p2, g, k, q)))
    Empty() then mkNest(k, q)
    Nest(k1, p1) then Nest(k1, arrange(PlaceAboveNest(p1, g, k - k1, q)))
    NilAbove(p1) then NilAbove(arrange(PlaceAboveNest(p1, g, k, q)))
    TextBeside(s, p1) then
      let k1 = k - annotSize(s)
      let rest = if p1 is Empty() then nilAboveNest(g, k1, q)
        else arrange(PlaceAboveNest(p1, g, k1, q))
      TextBeside(s, rest)
    Above(_, _, _) then raiseError("aboveNest Above")
    Beside(_, _, _) then raiseError("aboveNest Beside")
//│ CTML translation succeeded.

