/** Render each board square in row-major order. */
fun displayBoard(bd) =
  /** Display the square's marker or a dot. */
  fun sq(n, col) = if check(bd, [n, col]) is
    Some(id) then char(id)
    None() then char(".")
  /** Render one row horizontally. */
  fun row(n) = hcat(map(col => sq(n, col), enumFromTo(1, maxCol)))
  above_(vcat(map(row, enumFromTo(1, maxCol))), false, text(LNil()))
//│ CTML translation succeeded.

