:ctml-parse-only // FIXME: Inference exceeds a 20000-call diagnostic budget.
/** Compute one score row, carrying the previous diagonal and current left-hand scores. */
fun algb2(x, k0j1, k1j1, yss) = if yss is
  LNil() then LNil()
  LCons([y, k0j], ys) then
    let kjcurr = nextScore(x, y, k0j1, k1j1, k0j)
    LCons([y, kjcurr], algb2(x, k0j, kjcurr, ys))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: This traversal depends on the unchecked algb2 definition.
/** Update the score row for each successive element and extract the final scores. */
fun algb1(xss, yss) = if xss is
  LNil() then map(snd, yss)
  LCons(x, xs) then algb1(xs, algb2(x, 0, 0, yss))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds a 20000-call diagnostic budget.
/** Pair each element of the second sequence with an initial zero score. */
fun zeroScores(ys) = if ys is
  LCons(y, rest) then LCons([y, 0], zeroScores(rest))
  LNil() then LNil()
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: This row builder depends on the unchecked algb1 and zeroScores definitions.
/** Compute the row of prefix scores, including the empty prefix. */
fun algb(xs, ys) = LCons(0, algb1(xs, zeroScores(ys)))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds a 20000-call diagnostic budget.
/** Find the last index with a maximal sum of the forward and backward scores. */
fun findk(k, km, m, ls) = if ls is
  LNil() then km
  LCons([x, y], rest) then
    let score = x + y
    if m <= score then findk(k + 1, k, score, rest) else findk(k + 1, km, m, rest)
//│ CTML translation succeeded.

