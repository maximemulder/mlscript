/** Extend the diagonal score on a match, or keep the better neighboring score. */
fun nextScore(x, y, diagonal, left, above) =
  if x == y then diagonal + 1 else intMax(left, above)
//│ nextScore: ⊤ → ⊤ → Int → Int → Int → Int

nextScore(1, 2, 0, 3, 4) as Int
//│ Int

:te
nextScore(1, 2, 0, "not a score", 4)
