// Source: hkmc2/shared/src/test/mlscript-compile/nofib/life.mls.
// Triples use nested pairs; lazy rows and generations use shared delay and force.
// The MLScript runtime reference for a board size of 15 is 468.

:ctml-parse-only // FIXME: Inference exceeds a 20000-call diagnostic budget.
/** Return the last element of a nonempty strict list. */
fun last(ls) =
  /** Carry the most recent element through the rest of the list. */
  fun go(h, t) = if t is
    LNil() then h
    LCons(head, tail) then go(head, tail)
  if ls is LCons(h, t) then go(h, t)
//│ CTML translation succeeded.

/** Delay the construction of a lazy list of n copies of x. */
fun copyLz(n, x) = delay(() =>
  if n === 0 then LzNil() else LzCons(x, copyLz(n - 1, x))
)
//│ copyLz: ∀α, β. {β ≥ Delayed ∧ {resume: Unit → (((LzCons ∧ {head: α}) ∧ {tail: β}) ∨ LzNil)}} ⟹ Int → α → (Delayed ∧ {resume: Unit → (((LzCons ∧ {head: α}) ∧ {tail: β}) ∨ LzNil)})

:ctml-parse-only // FIXME: Inference exceeds a 20000-call diagnostic budget.
/** Drop the last element; the source empty list renders as "[]" in the exception. */
fun init(ls) = if ls is
  LCons(a, LNil()) then LNil()
  LCons(a, t) then LCons(a, init(t))
  LNil() then raiseError("[]")
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds a 20000-call diagnostic budget.
/** Apply f to successive triples of elements, stopping at the shortest list. */
fun zipWith3(f, xs, ys, zs) = if
  xs is LCons(hx, tx) and ys is LCons(hy, ty) and zs is LCons(hz, tz) then
    LCons(f(hx, hy, hz), zipWith3(f, tx, ty, tz))
  else LNil()
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds a 20000-call diagnostic budget.
/** Wrap each node of a strict list in a delayed cell. */
fun lzfy(ls) = delay(() =>
  if ls is
    LCons(a, t) then LzCons(a, lzfy(t))
    else LzNil()
)
//│ CTML translation succeeded.

