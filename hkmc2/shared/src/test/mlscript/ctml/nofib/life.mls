val startSeed =
  LCons(0, LCons(0, LCons(0,
    LCons(1, LCons(1, LCons(1, LCons(1, LCons(1, LCons(0,
      LCons(1, LCons(1, LCons(1, LCons(1, LCons(1, LCons(0,
        LCons(1, LCons(1, LCons(1, LCons(1, LCons(1, LCons(0,
          LCons(1, LCons(1, LCons(1, LCons(1, LCons(1, LCons(0,
            LNil())))))))))))))))))))))))))))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: This board depends on the unchecked seed row and lzfy.
/** Assemble fourteen independently delayed empty rows and the seed row. */
val start =
  LCons(delay(() => LzNil()),
    LCons(delay(() => LzNil()),
      LCons(delay(() => LzNil()),
        LCons(delay(() => LzNil()),
          LCons(delay(() => LzNil()),
            LCons(delay(() => LzNil()),
              LCons(delay(() => LzNil()),
                LCons(delay(() => LzNil()),
                  LCons(delay(() => LzNil()),
                    LCons(delay(() => LzNil()),
                      LCons(delay(() => LzNil()),
                        LCons(delay(() => LzNil()),
                          LCons(delay(() => LzNil()),
                            LCons(delay(() => LzNil()),
                              LCons(lzfy(startSeed), LNil())))))))))))))))
//│ CTML translation succeeded.

/** Apply the Life rule to the middle cell of a three-by-three neighborhood. */
fun elt(top_, middle, bottom) = if
  top_ is [a, [b, c]] and middle is [d, [e, f]] and bottom is [g, [h, i]] then
    let tot = a + b + c + d + f + g + h + i
    if
      tot < 2 || 3 < tot then 0
      tot === 3 then 1
      else e
//│ elt: ∀α. ⟨Int, ⟨Int, Int⟩⟩ → ⟨Int, ⟨α, Int⟩⟩ → ⟨Int, ⟨Int, Int⟩⟩ → (α ∨ Int)

:ctml-parse-only // FIXME: This shift depends on the unchecked init.
/** Shift a row right, filling the first position with x. */
fun shiftr(x, xs) = LCons(x, init(xs))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds 20000 solver calls even with supplied init and append signatures.
/** Fill the last position with x after discarding the last source element. */
fun shiftl(x, xs) = append(init(xs), LCons(x, LNil()))
//│ CTML translation succeeded.

