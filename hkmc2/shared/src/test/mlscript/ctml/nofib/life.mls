/** Render each of the two cell states as the source two-character list. */
fun star(x) = if
  x === 0 then nofibStringToList("  ")
  x === 1 then nofibStringToList(" o")
  else raiseError("match error")
//│ star: ⊤ → (LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α})} ⟹ α}))

/** Insert a separator between two lists, preserving source association. */
fun glue(s, xs, ys) = append(xs, append(s, ys))
//│ glue: ∀α, β, Z. {Z ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: Z}), α ≥ β} ⟹ (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: X})} ⟹ X) → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X) → (∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: Y})} ⟹ Y) → Z

glue(LCons("n", LNil()), LCons("a", LNil()), LCons("b", LNil())) as (LNil | (LCons & {head: Str}))
//│ LNil ∨ (LCons ∧ {head: Str})

listLen(glue(LCons("n", LNil()), LCons("a", LNil()), LCons("b", LNil()))) as Int
//│ Int

