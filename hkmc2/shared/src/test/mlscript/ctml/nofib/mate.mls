/** Visit the bishop's four diagonal rays in source order. */
fun bishopmoves(c, sq, bd) =
  moveLine(bd, c, sq, p => if p is [x, y] then [x - 1, y + 1],
    moveLine(bd, c, sq, p => if p is [x, y] then [x + 1, y + 1],
      moveLine(bd, c, sq, p => if p is [x, y] then [x - 1, y - 1],
        moveLine(bd, c, sq, p => if p is [x, y] then [x + 1, y - 1], x => x))))(LNil())
