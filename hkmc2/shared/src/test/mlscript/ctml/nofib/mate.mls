/** Generate forward moves before captures, expanding promotions in source order. */
fun pawnmoves(c, pq, bd) = if pq is [p, q] then
  let fwd = if c is White() then 1 else -1
  /** Expand a move at the final rank into one move for each allowed promotion. */
  fun promote(xy, mcp) = if xy is [x, y] then
    if ((c is Black()) && y === 1) || ((c is White()) && y === 8) then
      map(param => Move([x, y], mcp, Some(param)),
        LCons([c, queen], LCons([c, rook], LCons([c, bishop], LCons([c, knight], LNil())))))
    else LCons(Move([x, y], mcp, None()), LNil())
  let movs =
    let on1 = [p, q + fwd]
    let on2 = [p, q + 2 * fwd]
    if pieceAt(bd, on1) is None() then
      append(promote(on1, None()),
        if ((q === 2 && (c is White())) || (q === 7 && (c is Black()))) &&
            (pieceAt(bd, on2) is None()) then LCons(Move(on2, None(), None()), LNil())
        else LNil())
    else LNil()
  /** Visit each of the two possible capture squares. */
  fun lscomp1(ls) = if ls is
    LNil() then LNil()
    LCons(sq, sqs) then
      /** Collect captures from the source's singleton optional-piece list. */
      fun lscomp2(ls) = if ls is
        LNil() then lscomp1(sqs)
        LCons(h, rest) then
          if h is Some(p) and negate(colourOf(p) === c) then
            LCons(promote(sq, Some(p)), lscomp2(rest))
          else lscomp2(rest)
      lscomp2(LCons(pieceAt(bd, sq), LNil()))
  let caps = concat(lscomp1(LCons([p + 1, q + fwd], LCons([p - 1, q + fwd], LNil()))))
  append(movs, caps)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The ray traversal has no inferred type.
/** Generate the queen's diagonal moves before its orthogonal moves. */
fun queenmoves(c, sq, bd) = append(bishopmoves(c, sq, bd), rookmoves(c, sq, bd))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: King lookup and force-list traversals have no inferred types.
/** Check whether any opposing piece attacks the given side's king. */
fun kingincheck(c, bd) =
  /** Test the attack rule for one opposing piece. */
  fun givesCheck(kxy) = if kxy is [k, [x, y]] then
    /** A queen applies the rook and bishop rules in that order. */
    fun kthreat(param) = if kingSquare(c, bd) is [xk, yk] and param is
      King() then abs(x - xk) <= 1 && abs(y - yk) <= 1
      Queen() then kthreat(rook) || kthreat(bishop)
      Rook() then
        (x === xk && emptyAtAll(bd, sq => if sq is [xe, ye] then
          xe === xk && intMin(y, yk) < ye && ye < intMax(y, yk))) ||
        (y === yk && emptyAtAll(bd, sq => if sq is [xe, ye] then
          ye === yk && intMin(x, xk) < xe && xe < intMax(x, xk)))
      Bishop() then
        (x + y === xk + yk && emptyAtAll(bd, sq => if sq is [xe, ye] then
          xe + ye === xk + yk && intMin(x, xk) < xe && xe < intMax(x, xk))) ||
        (x - y === xk - yk && emptyAtAll(bd, sq => if sq is [xe, ye] then
          xe - ye === xk - yk && intMin(x, xk) < xe && xe < intMax(x, xk)))
      Knight() then
        (abs(x - xk) === 2 && abs(y - yk) === 1) || (abs(x - xk) === 1 && abs(y - yk) === 2)
      Pawn() then abs(x - xk) === 1 && (if c is Black() then yk === y + 1 else yk === y - 1)
    kthreat(k)
  any(givesCheck, forcesColoured(opponent(c), bd))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Board updates and the check predicate have no inferred types.
/** Apply a move and discard it if the moving side would leave its king in check. */
fun tryMove(c, ksq, m, bd) =
  if ksq is [k, sq] and m is Move(dest, mcp, mpp) then
    let p = [c, k]
    let bd1 = rmPieceAt(c, sq, bd)
    let p_ = maybe(p, x => x, mpp)
    let bd2 = maybe(putPieceAt(dest, p_, bd1),
      _ => putPieceAt(dest, p_, rmPieceAt(opponent(c), dest, bd1)), mcp)
    if negate(kingincheck(c, bd2)) then Some([MoveInFull(p, sq, Move(dest, mcp, mpp)), bd2])
    else None()
  else raiseError(errorMessage(m))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The move generators have no inferred types.
/** Select the move generator for the indicated piece. */
fun rawmoves(c, ksq, bd) = if ksq is [k, sq] then
  let m = if k is
    King() then kingmoves
    Queen() then queenmoves
    Rook() then rookmoves
    Bishop() then bishopmoves
    Knight() then knightmoves
    Pawn() then pawnmoves
  m(c, sq, bd)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Move generation and validation have no inferred types.
/** Fold over pieces and destinations in the source order, retaining legal moves. */
fun moveDetailsFor(c, bd) =
  /** Prepend all legal moves for this piece to the moves for subsequent pieces. */
  fun collect(ksq, ms) =
    /** Prepend one move if it passes validation. */
    fun keep(rm, rest) = maybe(x => x, h => t => LCons(h, t), tryMove(c, ksq, rm, bd))(rest)
    foldr(keep, ms, rawmoves(c, ksq, bd))
  foldr(collect, LNil(), forcesColoured(c, bd))
//│ CTML translation succeeded.

/** Recognize an empty line or one beginning with the two comment characters. */
fun comment(s) = (s is LNil()) || listEq(take(2, s), nofibStringToList("--"))
//│ comment: ∀α. {α ≤ (¬({α ≤ LNil} ⟹ ¬LNil) ∨ ¬({α ≤ ¬LNil} ⟹ LNil)) ∧ (∀X. {X ≥ LNil} ⟹ X)} ⟹ α → Bool

