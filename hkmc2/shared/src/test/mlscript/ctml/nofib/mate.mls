/** Pass the moves on one ray to the continuation, stopping at the board edge or a piece. */
fun moveLine(bd, c, sq, inc, cont) =
  /** Add the next empty square or opposing piece on the ray. */
  fun ml(sq, ms) =
    let dest = inc(sq)
    if onboard(dest) and pieceAt(bd, dest) is
      None() then ml(dest, LCons(Move(dest, None(), None()), ms))
      Some(p) then
        if negate(colourOf(p) === c) then cont(LCons(Move(dest, Some(p), None()), ms))
        else cont(ms)
    else cont(ms)
  ms => ml(sq, ms)
//│ CTML translation succeeded.

