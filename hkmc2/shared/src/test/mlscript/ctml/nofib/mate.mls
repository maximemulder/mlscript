/** Render a move, including its origin, capture, and promotion when required. */
fun showMove(withPiece, m) =
  if m is MoveInFull([c, k], sq, Move(dest, mcp, mpp)) then
    let capt = mcp is Some(_)
    let prom = mpp is Some(_)
    let prefix = if withPiece then
      append(showPiece([c, k]),
        if (k is King()) || ((k is Pawn()) && negate(capt || prom)) then LNil()
        else LCons("/", showSquare(c, sq)))
    else LNil()
    append(prefix,
      append(maybe(LCons("-", LNil()),
          cp => LCons("x", append(showPiece(cp), LCons("/", LNil()))), mcp),
        append(showSquare(c, dest),
          maybe(LNil(), pp => LCons("(", append(showPiece(pp), LCons(")", LNil()))), mpp))))
//│ CTML translation succeeded.

