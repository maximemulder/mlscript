/** Compare pieces by colour and then by kind. */
fun pieceCompare(p1, p2) = if p1 is [c1, k1] and p2 is [c2, k2] then
  let co = colourOrder(c1) - colourOrder(c2)
  if co === 0 then kindOrder(k1) - kindOrder(k2) else co
//│ CTML translation succeeded.

/** Compare squares by rank and then by file. */
fun squareCompare(s1, s2) = if s1 is [f1, r1] and s2 is [f2, r2] then
  let ro = r1 - r2
  if ro === 0 then f1 - f2 else ro
//│ squareCompare: ⟨Int, Int⟩ → ⟨Int, Int⟩ → Int

