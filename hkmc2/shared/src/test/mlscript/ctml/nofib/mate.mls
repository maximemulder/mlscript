/** Read the Heathcote puzzle, then render the initial board and the solution. */
fun testMate_nofib(dummy) =
  let input = nofibStringToList(
    nofibReadText("./hkmc2/shared/src/test/mlscript/nofib/input/heathcote3.prob"))
  if readProblem(input) is [bd, [c, n]] then
    append(showBoard(bd), append(nofibStringToList("\n"),
      append(showColour(c), append(nofibStringToList(" to move and mate in "),
        append(nofibStringToList(stringOfFloat(n)), append(nofibStringToList("\n"),
          append(nofibStringToList("\n"), solve(bd, c, n))))))))
//│ CTML translation succeeded.

