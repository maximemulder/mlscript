/** Recognize an ASCII uppercase code unit. */
fun isUpper(c) =
  let x = nofibCharCode(c)
  65 <= x && x <= 90
//│ isUpper: Str → Bool

/** Recognize an ASCII lowercase code unit. */
fun isLower(c) =
  let x = nofibCharCode(c)
  97 <= x && x <= 122
//│ isLower: Str → Bool

/** Lowercase an ASCII uppercase initial and otherwise return the original string. */
fun toLower(c) =
  if isUpper(c) then nofibFromCharCode(nofibCharCode(c) + 32) else c
//│ toLower: Str → Str

/** Split a line at spaces, skipping consecutive separators. */
fun words(s) = if leaveWhile(x => x === " ", s) is
  LNil() then LNil()
  s_ and break_(x => x === " ", s_) is [w, rest] then LCons(w, words(rest))
//│ words: (∀X. {X ≥ LNil} ⟹ X) → LNil

