/** An optional result with a value. */
data class Some(value)
/** An optional result without a value. */
data class None()
//│ Some: ∀α. α → (Some ∧ {value: α})
//│ None: Unit → None

/** The six distinct kinds of piece. */
type Kind = King | Queen | Rook | Bishop | Knight | Pawn
/** The two sides of the board. */
type Colour = Black | White
/** A coloured piece. */
type Piece = [Colour, Kind]
/** A file and rank, in that order. */
type Square = [Int, Int]
/** The occupied squares of one side, paired with their pieces. */
type Forces = [X restricts (LNil | (LCons & {head: [Kind, Square]} & {tail: X}))] -> X
/** An optional captured piece or promotion. */
type OptionalPiece = None | (Some & {value: Piece})
//│ Kind = ((((King ∨ Queen) ∨ Rook) ∨ Bishop) ∨ Knight) ∨ Pawn
//│ Colour = Black ∨ White
//│ Piece = ⟨Colour, Kind⟩
//│ Square = ⟨Int, Int⟩
//│ Forces = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: ⟨Kind, Square⟩}) ∧ {tail: X})} ⟹ X
//│ OptionalPiece = None ∨ (Some ∧ {value: Piece})

/** A board with separate white and black forces. */
data class Board(white: Forces, black: Forces)
/** A destination, a possible capture, and a possible promotion. */
data class Move(destination: Square, capture: OptionalPiece, promotion: OptionalPiece)
/** A move paired with the piece and square it starts from. */
data class MoveInFull(piece: Piece, origin: Square, move: Move)
/** A mating move with the solution for each individual opposing reply. */
data class Solution(move: MoveInFull, replies)
/** A mating move with opposing replies grouped by their rendered solution. */
data class Soln(move: MoveInFull, replies)
//│ Board: ∀α, β. {β ≤ Forces, α ≤ Forces} ⟹ α → β → ((Board ∧ {white: α}) ∧ {black: β})
//│ Move: ∀γ, δ, ε. {δ ≤ OptionalPiece, ε ≤ OptionalPiece, γ ≤ Square} ⟹ γ → δ → ε → (((Move ∧ {destination: γ}) ∧ {capture: δ}) ∧ {promotion: ε})
//│ MoveInFull: ∀ζ, η, θ. {η ≤ Square, θ ≤ Move, ζ ≤ Piece} ⟹ ζ → η → θ → (((MoveInFull ∧ {piece: ζ}) ∧ {origin: η}) ∧ {move: θ})
//│ Solution: ∀ι, κ. {ι ≤ MoveInFull} ⟹ ι → κ → ((Solution ∧ {move: ι}) ∧ {replies: κ})
//│ Soln: ∀λ, μ. {λ ≤ MoveInFull} ⟹ λ → μ → ((Soln ∧ {move: λ}) ∧ {replies: μ})

/** Sort by partitioning in forward mode. */
data class Sort(ls, rest)
/** Partition around the pivot in forward mode. */
data class Part(pivot, ls, smaller, greaterEqual, rest)
/** Sort by partitioning in reverse mode. */
data class ReverseSort(ls, rest)
/** Partition around the pivot in reverse mode. */
data class ReversePart(pivot, ls, smallerEqual, greater, rest)
//│ Sort: ∀α, β. α → β → ((Sort ∧ {ls: α}) ∧ {rest: β})
//│ Part: ∀γ, δ, ε, ζ, η. γ → δ → ε → ζ → η → (((((Part ∧ {pivot: γ}) ∧ {ls: δ}) ∧ {smaller: ε}) ∧ {greaterEqual: ζ}) ∧ {rest: η})
//│ ReverseSort: ∀θ, ι. θ → ι → ((ReverseSort ∧ {ls: θ}) ∧ {rest: ι})
//│ ReversePart: ∀κ, λ, μ, ν, ξ. κ → λ → μ → ν → ξ → (((((ReversePart ∧ {pivot: κ}) ∧ {ls: λ}) ∧ {smallerEqual: μ}) ∧ {greater: ν}) ∧ {rest: ξ})

