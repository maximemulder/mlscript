/** The king tag. */
data class King()
/** The queen tag. */
data class Queen()
/** The rook tag. */
data class Rook()
/** The bishop tag. */
data class Bishop()
/** The knight tag. */
data class Knight()
/** The pawn tag. */
data class Pawn()
/** The black side. */
data class Black()
/** The white side. */
data class White()
