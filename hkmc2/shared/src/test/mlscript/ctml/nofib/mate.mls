/** Return the last item of a nonempty list. */
fun last(ls) = if ls is
  LCons(x, LNil()) then x
  LCons(_, t) then last(t)
//│ CTML translation succeeded.

/** Parse the JavaScript integer prefix of the assembled character list. */
fun intOfString(s) = nofibParseInt(nofibListToString(s))
//│ intOfString: (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: X})} ⟹ X) → Num

:ctml-parse-only // FIXME: Word splitting and selecting the last item have no inferred types.
/** Read the side from the first word and the target move count from the last word. */
fun parseGoal(ls) = if ls is
  LCons(gltxt, LNil()) then
    let ws = words(gltxt)
    let c = if listEq(head(ws), nofibStringToList("Black")) then black else white
    let n = intOfString(last(ws))
    [c, n]
  else raiseError("parseGoal")
//│ CTML translation succeeded.

/** Parse an empty square or the piece at the given file and rank. */
fun parseSquare(r, f, c) = if c === "-" then LNil() else
  let clr = if isUpper(c) then black else white
  let ch = toLower(c)
  let kin = if
    ch === "k" then king
    ch === "q" then queen
    ch === "r" then rook
    ch === "b" then bishop
    ch === "n" then knight
    ch === "p" then pawn
    else raiseError("match error")
  LCons([[clr, kin], [f, r]], LNil())
//│ parseSquare: ∀α, β. α → β → Str → (((LCons ∧ {head: ⟨⟨Black ∨ White, ((((Pawn ∨ Knight) ∨ Bishop) ∨ Rook) ∨ Queen) ∨ King⟩, ⟨β, α⟩⟩}) ∧ {tail: LNil}) ∨ LNil)

/** Parse the nonspace characters in a rank, pairing them with files one through eight. */
fun parseRank(r, x) =
  concat(zipWith((a, b) => parseSquare(r, a, b), enumFromTo(1, 8),
    filter(pp => negate(pp === " "), x)))
//│ parseRank: ∀α, β, Y. {β ≤ Str, Y ≥ LNil ∨ ((LCons ∧ {head: ⟨⟨Black ∨ White, ((((Pawn ∨ Knight) ∨ Bishop) ∨ Rook) ∨ Queen) ∨ King⟩, ⟨Int, α⟩⟩}) ∧ {tail: Y})} ⟹ α → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: β}) ∧ {tail: X})} ⟹ X) → Y

:ctml-parse-only // FIXME: Rank parsing has no inferred type.
/** Read the ranks from top to bottom and place the parsed pieces in source fold order. */
fun parseBoard(ls) =
  /** Place one parsed piece. */
  fun addPiece(psq, x) = if psq is [p, sq] then putPieceAt(sq, p, x)
  foldr(addPiece, emptyBoard, concat(zipWith(parseRank, reverse(enumFromTo(1, 8)), ls)))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The comment check and board and goal parsing have no inferred types.
/** Drop comments and split the eight board ranks from the goal. */
fun parseProblem(s) =
  if splitAt(8, filter(x => negate(comment(x)), s)) is [bdtxt, gltxt] then
    let bd = parseBoard(bdtxt)
    let gl = parseGoal(gltxt)
    [bd, gl]
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The line splitter and puzzle parser have no inferred types.
/** Read a complete puzzle from its character list. */
fun readProblem(s) = parseProblem(lines(s))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Folding over a strict list with delayed tails exceeds bounded inference.
/** Fold with a delayed result for the rest of the input. */
fun foldr_lz(f, a, x) = if x is
  LCons(h, t) then f(h, delay(() => foldr_lz(f, a, t)))
  LNil() then a
//│ CTML translation succeeded.

/** Search for a solution after every legal defence. */
data class Replies()
/** Search for the first attacking move that has a solution after every defence. */
data class Attack()
//│ Replies: Unit → Replies
//│ Attack: Unit → Attack

:ctml-parse-only // FIXME: Move generation and the lazy fold have no inferred types.
/** Alternate the source's all-replies and first-solution searches. */
fun search(task, bd, c, n) = if task is
  Replies() then
    let mds = moveDetailsFor(c, bd)
    /** Require a solution for this reply before inspecting the rest. */
    fun solnAnd(mifb, rest) = if mifb is [mif, b] then
      if search(Attack(), b, opponent(c), numSub(n, numFromInt(1))) is
        None() then None()
        Some(s) and force(rest) is
          None() then None()
          Some(ms) then Some(LCons([mif, s], ms))
    if
      n === numFromInt(0) then if null_(mds) then Some(LNil()) else None()
      numGt(n, numFromInt(0)) then foldr_lz(solnAnd, Some(LNil()), mds)
      else raiseError("n < 0")
  Attack() then
    /** Keep a mate or an attack with a solution after every reply. */
    fun solnOr(mifb, other) = if mifb is [mif, b] then
      if search(Replies(), b, opponent(c), numSub(n, numFromInt(1))) is
        None() then force(other)
        Some(LNil()) then
          if kingincheck(opponent(c), b) then Some(Solution(mif, LNil())) else force(other)
        Some(rs) then Some(Solution(mif, rs))
    if numGt(n, numFromInt(0)) then
      let mds = moveDetailsFor(c, bd)
      foldr_lz(solnOr, None(), mds)
    else raiseError("n <= 0")
//│ CTML translation succeeded.

/** Produce one space per positive indentation column. */
fun tab(n) = if n <= 0 then LNil() else LCons(" ", tab(n - 1))
//│ tab: ∀α. {α ≥ ((LCons ∧ {head: Str}) ∧ {tail: α}) ∨ LNil} ⟹ Int → (((LCons ∧ {head: Str}) ∧ {tail: α}) ∨ LNil)

/** Render a mating move and its compacted replies. */
data class ShowSolution(solution, turn)
/** Render the alternatives at a turn. */
data class ShowReplies(replies, turn)
//│ ShowSolution: ∀α, β. α → β → ((ShowSolution ∧ {solution: α}) ∧ {turn: β})
//│ ShowReplies: ∀γ, δ. γ → δ → ((ShowReplies ∧ {replies: γ}) ∧ {turn: δ})

:ctml-parse-only // FIXME: Move rendering and reply sorting have no inferred types.
/** Render the source's descriptive notation for an entire compacted solution. */
fun render(task) = if task is
  ShowReplies(rs, n) and rs is
    LNil() then LNil()
    LCons([mifs, s], rest) then
      append(tab(n), append(nofibStringToList("if "),
        if null_(rest) && 1 < listLen(mifs) then nofibStringToList("others")
        else append(showMoves(mifs), append(nofibStringToList("; "),
          append(render(ShowSolution(s, n + 1)), render(ShowReplies(rest, n)))))))
  ShowSolution(Soln(mif, rs), n) then
    append(nofibStringToList(stringOfInt(n)),
      append(nofibStringToList(". "), append(showMoveInFull(mif),
        if rs is
          LNil() then nofibStringToList("++\n")
          LCons([mifs, s], LNil()) then
            append(nofibStringToList(", "),
              append(if 1 < listLen(mifs) then nofibStringToList("...") else showMoves(mifs),
                append(nofibStringToList("; "), render(ShowSolution(s, n + 1)))))
          else append(nofibStringToList(",\n"), render(ShowReplies(sort(rs), n))))))
//│ CTML translation succeeded.

/** Compact one raw solution. */
data class Compact(solution)
/** Group one reply with any existing replies that render to the same continuation. */
data class InsertCompact(reply, groups)
//│ Compact: ∀α. α → (Compact ∧ {solution: α})
//│ InsertCompact: ∀β, γ. β → γ → ((InsertCompact ∧ {reply: β}) ∧ {groups: γ})

:ctml-parse-only // FIXME: Solution rendering and move comparison have no inferred types.
/** Group replies with equal continuation text, preserving the source insertion order. */
fun compact(task) = if task is
  Compact(Solution(mif, rs)) then
    Soln(mif, foldr((r, ls) => compact(InsertCompact(r, ls)), LNil(), rs))
  InsertCompact([mif, s], ls) then
    /** Insert a move before the first move greater than or equal to it. */
    fun insert(x, ls) = if ls is
      LNil() then LCons(x, LNil())
      LCons(y, ys) then
        if 0 < moveInFullCompare(x, y) then LCons(y, insert(x, ys))
        else LCons(x, LCons(y, ys))
    let cs = compact(Compact(s))
    /** Insert a group into the sorted list or merge it with an equal continuation. */
    fun ic(ls) = if ls is
      LNil() then LCons([LCons(mif, LNil()), cs], LNil())
      LCons([mifs, cs_], rest) then
        let a = render(ShowSolution(cs, 1))
        let b = render(ShowSolution(cs_, 1))
        let gt = (x, y) => strLt(y, x)
        if
          ltList(a, b, strLt, gt) then LCons([LCons(mif, LNil()), cs], LCons([mifs, cs_], rest))
          listEq(a, b) then LCons([insert(mif, mifs), cs], rest)
          negate(ltList(a, b, strLt, gt)) then LCons([mifs, cs_], ic(rest))
          else raiseError("compare error")
    ic(ls)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Compaction and rendering have no inferred types.
/** Render a compacted solution or the source message for an unsolved puzzle. */
fun showResult(s) = if s is
  None() then nofibStringToList("No solution!")
  Some(s) then render(ShowSolution(compact(Compact(s)), 1))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The recursive search and rendering have no inferred types.
/** Search for mate with at most the advertised number of moves by the attacking side. */
fun solve(bd, c, n) =
  let plies = numSub(numMul(numFromInt(2), n), numFromInt(1))
  showResult(search(Attack(), bd, c, plies))
//│ CTML translation succeeded.

