/** Keep the source's two comparator directions and accumulator order. */
fun quicksort(le, task) = if task is
  Sort(ls, r) and ls is
    LNil() then r
    LCons(x, LNil()) then LCons(x, r)
    LCons(x, xs) then quicksort(le, Part(x, xs, LNil(), LNil(), r))
  Part(x, ls, rlt, rge, r) and ls is
    LNil() then quicksort(le, ReverseSort(rlt, LCons(x, quicksort(le, ReverseSort(rge, r)))))
    LCons(y, ys) then
      if le(x, y) then quicksort(le, Part(x, ys, rlt, LCons(y, rge), r))
      else quicksort(le, Part(x, ys, LCons(y, rlt), rge, r))
  ReverseSort(ls, r) and ls is
    LNil() then r
    LCons(x, LNil()) then LCons(x, r)
    LCons(x, xs) then quicksort(le, ReversePart(x, xs, LNil(), LNil(), r))
  ReversePart(x, ls, rle, rgt, r) and ls is
    LNil() then quicksort(le, Sort(rle, LCons(x, quicksort(le, Sort(rgt, r)))))
    LCons(y, ys) then
      if le(y, x) then quicksort(le, ReversePart(x, ys, LCons(y, rle), rgt, r))
      else quicksort(le, ReversePart(x, ys, rle, LCons(y, rgt), r))
//│ CTML translation succeeded.

