/** Process jump destinations in source order, prepending each available move. */
fun sift(c, bd, ms, sqs) = if sqs is
  LNil() then ms
  LCons(sq, rest) then
    if onboard(sq) and pieceAt(bd, sq) is
      None() then sift(c, bd, LCons(Move(sq, None(), None()), ms), rest)
      Some(p) then
        if colourOf(p) === c then sift(c, bd, ms, rest)
        else sift(c, bd, LCons(Move(sq, Some(p), None()), ms), rest)
    else sift(c, bd, ms, rest)
//│ CTML translation succeeded.

