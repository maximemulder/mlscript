:ctml-parse-only // FIXME: Boolean list traversal exceeds the 20000-call budget.
/** Test the conjunction of a list of Boolean values. */
fun andd(ls) = if ls is
  LNil() then true
  LCons(b, bs) then b && andd(bs)
//│ CTML translation succeeded.

/** The first player's piece. */
data class X()
/** The second player's piece. */
data class O()
/** An unoccupied square. */
data class Empty()
//│ X: Unit → X
//│ O: Unit → O
//│ Empty: Unit → Empty

:ctml-parse-only // FIXME: Comparing piece tags exceeds the 20000-call solver budget.
/** Test whether two squares contain the same piece. */
fun eqPiece(p1, p2) = if p1 is
  X() and p2 is X() then true
  O() and p2 is O() then true
  Empty() and p2 is Empty() then true
  else false
//│ CTML translation succeeded.

/** The first player's winning evaluation. */
data class XWin()
/** The second player's winning evaluation. */
data class OWin()
/** The numeric evaluation of a position without a winner. */
data class Score(i: Int)
//│ XWin: Unit → XWin
//│ OWin: Unit → OWin
//│ Score: ∀α. {α ≤ Int} ⟹ α → (Score ∧ {i: α})

:ctml-parse-only // FIXME: Comparing evaluations exceeds the 20000-call solver budget.
/** Test equality of two positional evaluations. */
fun evaluationEq(x, y) = if x is
  XWin() and y is XWin() then true
  OWin() and y is OWin() then true
  Score(i) and y is Score(j) and i === j then true
  else false
//│ CTML translation succeeded.

/** A game-tree position and the list of positions one move away. */
data class Branch(a, cs)
//│ Branch: ∀α, β. α → β → ((Branch ∧ {a: α}) ∧ {cs: β})

/** Render the winning side or the numeric evaluation. */
fun showEvaluation(e) = if e is
  XWin() then nofibStringToList("XWin")
  OWin() then nofibStringToList("OWin")
  Score(i) then append(nofibStringToList("Score "), nofibStringToList(stringOfInt(i)))
//│ showEvaluation: ∀α, β, γ. {β ≥ ({α ≤ XWin} ⟹ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀δ. {δ ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: δ})} ⟹ δ})) ∧ ({α ≤ OWin ∨ ¬({β ≥ {γ ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: γ})} ⟹ γ} ⟹ ¬({i: Int} ∧ Score))} ⟹ ({α ≤ OWin} ⟹ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀δ. {δ ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: δ})} ⟹ δ})) ∧ ({α ≤ {i: Int} ∧ Score, γ ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: γ})} ⟹ γ)), α ≤ XWin ∨ ¬({β ≥ ({α ≤ OWin} ⟹ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀δ. {δ ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: δ})} ⟹ δ})) ∧ ({α ≤ {i: Int} ∧ Score, γ ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: γ})} ⟹ γ)} ⟹ ¬(OWin ∨ ¬({β ≥ {γ ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: γ})} ⟹ γ} ⟹ ¬({i: Int} ∧ Score))))} ⟹ α → β

/** Assemble three pieces or three rows in order. */
fun triple(a, b, c) = LCons(a, LCons(b, LCons(c, LNil())))
//│ triple: ∀α, β, γ. α → β → γ → ((LCons ∧ {head: α}) ∧ {tail: (LCons ∧ {head: β}) ∧ {tail: (LCons ∧ {head: γ}) ∧ {tail: LNil}}})

/** The first horizontal winning mask. */
val win1 = triple(triple(1, 1, 1), triple(0, 0, 0), triple(0, 0, 0))
