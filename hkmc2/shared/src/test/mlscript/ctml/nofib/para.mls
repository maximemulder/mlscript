/** Enumerate all line layouts, with the new-line alternatives first. */
fun formats(txt) = fold1(
  (w, ps) => append(map(p => new_(w, p), ps), map(p => glue(w, p), ps)),
  x => LCons(LCons(LCons(x, LNil()), LNil()), LNil()),
  txt
)
//│ CTML translation succeeded.

/** Maximum line width. */
val maxw = 70
//│ maxw: Int

