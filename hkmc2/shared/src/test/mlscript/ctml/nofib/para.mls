/** Introduce the first word and the initial candidate. */
fun startr(a) = if a <= maxw then [cons_([0, [0, 0]], nil_), [a, 1]]
  else raiseError("startr param error")
//│ startr: ∀α. {α ≤ Int} ⟹ α → ⟨⟨(LCons ∧ {head: ⟨Int, ⟨Int, Int⟩⟩}) ∧ {tail: LNil}, LNil⟩, ⟨α, Int⟩⟩

/** Divide with the source integer ceiling formula. */
fun ceildiv(n, m) = intDiv(n + m - 1, m)
//│ ceildiv: Int → Int → Int

