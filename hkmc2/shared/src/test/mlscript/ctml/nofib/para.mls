:ctml-parse-only // FIXME: The nonempty right fold is translation-only.
/** Split into groups, preserving empty groups at separators. */
fun format(a, x) = if x is LNil() then LCons(LNil(), LNil())
  else
    /** Match the source singleton Nil by tag and other separators by strict equality. */
    fun separatorEq(a, b) = if a is LNil() and b is LNil() then true else a === b
    /** Start a group at the separator or prepend to the current group. */
    fun breakk(a, b, xs) =
      if separatorEq(a, b) then LCons(LNil(), xs)
      else LCons(LCons(b, head(xs)), tail(xs))
    /** Initialize the group for the final element. */
    fun start(a, b) = breakk(a, b, LCons(LNil(), LNil()))
    fold1((x, y) => breakk(a, x, y), y => start(a, y), x)
//│ CTML translation succeeded.

