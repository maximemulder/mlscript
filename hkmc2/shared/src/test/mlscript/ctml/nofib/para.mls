/** Split words into lines using the decreasing suffix lengths. */
fun tile(ws, suffix) = if suffix is
  [LNil(), n] then LNil()
  [LCons(m, ms), n] then
    let l = n - m
    if splitAt(l, ws) is [ws1, ws2] then
      LCons(ws1, tile(ws2, [leave(l, LCons(m, ms)), m]))
//│ CTML translation succeeded.

/** Test whether both sides of the deque are empty. */
fun null__(q) = if q is [LNil(), LNil()] then true else false
//│ null__: ∀α. α → (({α ≤ ⟨LNil, LNil⟩} ⟹ Bool) ∧ ({α ≤ ¬⟨LNil, LNil⟩} ⟹ Bool))

:ctml-parse-only // FIXME: Inference exceeds the 20000-call solver budget.
/** Test whether exactly one side of the deque has exactly one element. */
fun single_(q) = if q is [x, y] then (null_(x) && single(y)) || (single(x) && null_(y))
//│ CTML translation succeeded.

/** The empty deque. */
val nil_ = [LNil(), LNil()]
//│ nil_: ⟨LNil, LNil⟩

/** Read the front of the deque. */
fun head_(q) = if q is [x, y] then
  if null_(x) then head(y) else head(x)
//│ head_: ∀α, β, γ. {α ≤ (¬({α ≤ LNil} ⟹ ¬LNil) ∨ ¬({α ≤ ¬LNil} ⟹ ⊥)) ∧ ({tail: ⊤} ∧ {head: γ}) ∧ LCons} ⟹ ⟨α, ({tail: ⊤} ∧ {head: β}) ∧ LCons⟩ → (γ ∨ β)

/** Read the back of the deque. */
fun last_(q) = if q is [y, x] then
  if null_(x) then head(y) else head(x)
//│ last_: ∀α, β, γ. {α ≤ (¬({α ≤ LNil} ⟹ ¬LNil) ∨ ¬({α ≤ ¬LNil} ⟹ ⊥)) ∧ ({tail: ⊤} ∧ {head: γ}) ∧ LCons} ⟹ ⟨({tail: ⊤} ∧ {head: β}) ∧ LCons, α⟩ → (γ ∨ β)

/** Add to the front, keeping the old front as the back when needed. */
fun cons_(a, q) = if q is [x, y] then
  if null_(y) then [LCons(a, LNil()), x] else [LCons(a, x), y]
//│ cons_: ∀α, β, γ. {γ ≤ ¬({γ ≤ LNil} ⟹ ¬LNil) ∨ ¬({γ ≤ ¬LNil} ⟹ LNil)} ⟹ α → ⟨β, γ⟩ → (⟨(LCons ∧ {head: α}) ∧ {tail: LNil}, β⟩ ∨ ⟨(LCons ∧ {head: α}) ∧ {tail: β}, γ⟩)

/** Add to the back, keeping the old back as the front when needed. */
fun snoc_(a, q) = if q is [y, x] then
  if null_(y) then [x, LCons(a, LNil())] else [y, LCons(a, x)]
//│ snoc_: ∀α, β, γ. {β ≤ ¬({β ≤ LNil} ⟹ ¬LNil) ∨ ¬({β ≤ ¬LNil} ⟹ LNil)} ⟹ α → ⟨β, γ⟩ → (⟨γ, (LCons ∧ {head: α}) ∧ {tail: LNil}⟩ ∨ ⟨β, (LCons ∧ {head: α}) ∧ {tail: γ}⟩)

