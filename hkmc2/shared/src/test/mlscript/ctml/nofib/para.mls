:ctml-parse-only // FIXME: Deque rebalancing and its singleton check are translation-only.
/** Prepend one word and maintain the deque of candidate suffix layouts. */
fun stepr(w, state) = if state is [ps, [tw, tl]] then
  let tot_width = w + 1 + tw
  let tot_len = 1 + tl
  /** Test for a candidate with no suffix. */
  fun single(p) = len_tl(p) === 0
  /** Measure the new first line. */
  fun width_hd(p) = if single(p) then tot_width else tot_width - width_tl(p) - 1
  /** The total cost after prepending the word. */
  fun cost(p) = if single(p) then 0 else cost_tl(p) + (let a = optw - width_hd(p) in a * a)
  /** Measure the former first line. */
  fun old_width_hd(p) = if single(p) then tw else tw - width_tl(p) - 1
  /** Introduce a candidate with a new first line. */
  fun new_(p) =
    if single(p) then [tw, [0, tl]]
    else [tw, [cost_tl(p) + (let x = optw - old_width_hd(p) in x * x), tl]]
  /** Discard back candidates dominated by the preceding candidate. */
  fun trim(ps_pq) = if
    null__(ps_pq) then ps_pq
    single_(ps_pq) then ps_pq
    else
      let ps_p = init_(ps_pq)
      let q = last_(ps_pq)
      let p = last_(ps_p)
      if cost(p) <= cost(q) then trim(ps_p) else ps_pq
  /** Discard back candidates whose first lines are too wide. */
  fun leave_nofit(ps_p) = if
    null__(ps_p) then ps_p
    maxw < width_hd(last_(ps_p)) then leave_nofit(init_(ps_p))
    else ps_p
  /** Find the width at which the two candidates exchange preference. */
  fun bf(p, q) =
    let wqh = width_hd(q)
    let rqh = maxw - wqh + 1
    if
      single(q) && (cost_tl(p) === 0) then intMin(optw - width_hd(p), rqh)
      single(q) then rqh
      else intMin(ceildiv(cost(p) - cost(q), 2 * (wqh - width_hd(p))), rqh)
  /** Add the new candidate, removing any front candidates it dominates. */
  fun myAdd(p, qr_rs) =
    if single_(qr_rs) || null__(qr_rs) then cons_(p, qr_rs)
    else
      let q = head_(qr_rs)
      let r_rs = tail_(qr_rs)
      let r = head_(r_rs)
      if bf(p, q) <= bf(q, r) then myAdd(p, r_rs) else cons_(p, qr_rs)
  [trim(leave_nofit(myAdd(new_(last_(ps)), ps))), [tot_width, tot_len]]
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The layout scan and tiling are translation-only.
/** Compute candidate layouts for each suffix, then recover the optimal lines. */
fun par3(ws) =
  let zs = scan1(stepr, startr, map(listLen, ws))
  tile(ws, [map(x => len_tl(last_(fst3(x))), zs), thd3(head(zs))])
//│ CTML translation succeeded.

