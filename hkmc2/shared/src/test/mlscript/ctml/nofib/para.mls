/** Test whether a list has exactly one element. */
fun single(xs) = if xs is LCons(a, LNil()) then true else false
//│ single: ∀α. α → (({α ≤ (LCons ∧ {head: ⊤}) ∧ {tail: LNil}} ⟹ Bool) ∧ ({α ≤ ¬((LCons ∧ {head: ⊤}) ∧ {tail: LNil})} ⟹ Bool))

