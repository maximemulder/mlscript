/** Join words with one space between each pair. */
fun unwords(ws) = if ws is
  LNil() then LNil()
  LCons(w, rest) then
    /** Prefix each remaining word with a space. */
    fun go(vs) = if vs is
      LNil() then LNil()
      LCons(v, tail_) then LCons(" ", append(v, go(tail_)))
    append(w, go(rest))
//│ CTML translation succeeded.

/** Recognize the source word separator. */
fun isSpace(c) = c === " "
//│ isSpace: ⊤ → Bool

:ctml-parse-only // FIXME: Inference exceeds the 20000-call solver budget.
/** Skip leading spaces and extract one word at a time. */
fun words(s) = if leaveWhile(isSpace, s) is
  LNil() then LNil()
  LCons(h, t) and
    break_(isSpace, LCons(h, t)) is [w, rest] then LCons(w, words(rest))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds the 20000-call solver budget.
/** Split into lines, including the empty last line after a final newline. */
fun lines(s) = if break_(x => x === "\n", s) is [l, rest] then
  LCons(l, if rest is
    LNil() then LNil()
    LCons(h, t) then lines(t)
  )
//│ CTML translation succeeded.

