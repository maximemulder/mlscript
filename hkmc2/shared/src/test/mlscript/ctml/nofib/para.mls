/** Fold a nonempty list from the right, using g for the last element. */
fun fold1(f, g, xs) = if xs is
  LCons(a, LNil()) then g(a)
  LCons(a, x) then f(a, fold1(f, g, x))
//│ CTML translation succeeded.

