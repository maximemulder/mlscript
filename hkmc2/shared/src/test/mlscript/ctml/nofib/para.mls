/** Project the first element of a nested-pair triple. */
fun fst3(x) = if x is [a, [b, c]] then a
//│ fst3: ∀α. ⟨α, ⟨⊤, ⊤⟩⟩ → α

/** Project the second element of a nested-pair triple. */
fun snd3(x) = if x is [a, [b, c]] then b
//│ snd3: ∀α. ⟨⊤, ⟨α, ⊤⟩⟩ → α

/** Project the third element of a nested-pair triple. */
fun thd3(x) = if x is [a, [b, c]] then c
//│ thd3: ∀α. ⟨⊤, ⟨⊤, α⟩⟩ → α

/** Read the suffix width from a layout candidate. */
fun width_tl(x) = fst3(x)
