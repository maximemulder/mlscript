/** Preferred line width. */
val optw = 63
//│ optw: Int

:ctml-parse-only // FIXME: The nonempty right fold is translation-only.
/** Measure squared deviation from the preferred width, omitting the last line. */
fun cost(ls) =
  /** Measure one line's squared deviation. */
  fun linc(l) = let a = optw - width(l) in a * a
  /** Add one line's cost. */
  fun plus(l, n) = linc(l) + n
  fold1(plus, x => 0, ls)
//│ CTML translation succeeded.

