/** Select the least costly element, taking the later one on ties. */
fun minWith(f, xs) = fold1((a, b) => if f(a) < f(b) then a else b, x => x, xs)
//│ CTML translation succeeded.

/** Prepend w as a new line. */
fun new_(w, ls) = LCons(LCons(w, LNil()), ls)
//│ new_: ∀α, β. α → β → ((LCons ∧ {head: (LCons ∧ {head: α}) ∧ {tail: LNil}}) ∧ {tail: β})

/** Prepend w to the first existing line. */
fun glue(w, ls) = if ls is LCons(l, rest) then LCons(LCons(w, l), rest)
//│ glue: ∀α, β, γ. α → (({tail: γ} ∧ {head: β}) ∧ LCons) → ((LCons ∧ {head: (LCons ∧ {head: α}) ∧ {tail: β}}) ∧ {tail: γ})

