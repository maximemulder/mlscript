/** Differentiate the series, starting with its linear coefficient. */
fun deriv(fss) = delay(() => if force(fss) is
  Pz() then Pz()
  Pc(_, fs_) then
    /** Multiply each coefficient by its degree. */
    fun deriv1(gss, n) = delay(() => if force(gss) is
      Pz() then Pz()
      Pc(f, tail) then Pc(numMul(numFromInt(n), f), deriv1(tail, n + 1))
    )
    force(deriv1(fs_, 1))
)
//│ CTML translation succeeded.

