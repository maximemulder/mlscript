/** Scale every coefficient by c. */
fun dotMult(c, ps) = delay(() => if force(ps) is
  Pz() then Pz()
  Pc(f, tail) then Pc(numMul(c, f), dotMult(c, tail))
)
//│ CTML translation succeeded.

