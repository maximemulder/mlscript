/** Add the two series coefficientwise. */
fun addPs(fss, gss) = delay(() => if force(fss) is
  Pz() then force(gss)
  Pc(f, fs_) and force(gss) is
    Pz() then force(fss)
    Pc(g, gs) then Pc(numAdd(f, g), addPs(fs_, gs))
)
