/** Compute the square root of a series with the source leading coefficients. */
fun sqrtPs(fss) = delay(() => if force(fss) is
  Pz() then Pz()
  Pc(f, tail) and
    f == 0.0 and force(tail) is Pc(g, fs_) and g == 0.0 then Pc(0.0, sqrtPs(fs_))
    f == 1.0 then
      /** Express the square root through the integral of its derivative. */
      fun qs() = delay(() =>
        addPs(fromIntegerPs(1.0), integral(divPs(deriv(delay(() => Pc(1.0, tail))), dotMultSndLz(2.0, qs()))))
      )
      force(force(qs()))
    else raiseError("match error")
)
//│ CTML translation succeeded.

