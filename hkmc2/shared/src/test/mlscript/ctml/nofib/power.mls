/** Extract the first n coefficients, stopping at the end of a finite series. */
fun extract(n, ps) = if
  n == 0 then LNil()
  force(ps) is
    Pz() then LNil()
    Pc(x, tail) then LCons(x, extract(n - 1, tail))
//│ CTML translation succeeded.

