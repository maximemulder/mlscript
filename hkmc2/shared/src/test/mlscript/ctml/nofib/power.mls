/** Compute the inverse series using the source zero and linear cases. */
fun revert(fss) = delay(() => if force(fss) is
  Pc(f0, tail) and
    f0 == 0.0 then
      /** Tie the inverse series to the recursive composition. */
      fun rs() = delay(() => Pc(0.0, divPs(fromIntegerPs(1.0), compose_(tail, rs()))))
      force(rs())
    force(tail) is Pc(f1, gs) and force(gs) is Pz() then
      Pc(numDiv(numSub(0.0, 1.0), f1), delay(() => Pc(numDiv(1.0, f1), delay(() => Pz()))))
)
//│ CTML translation succeeded.

