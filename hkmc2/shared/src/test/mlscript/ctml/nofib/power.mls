/** Divide two series, removing common leading zero coefficients. */
fun divPs(fss, gss) = delay(() => if force(fss) is
  Pz() and force(gss) is
    Pz() then raiseError("power series 0/0")
    Pc(g, gs) and g == 0.0 then force(divPs(delay(() => Pz()), gs))
    else Pz()
  Pc(f, fs_) and force(gss) is Pc(g, gs) and
    f == 0.0 and g == 0.0 then force(divPs(fs_, gs))
    f == 0.0 then
      let q = 0.0
      Pc(q, divPs(addPs(fs_, negatePs(dotMult(q, gs))), delay(() => Pc(g, gs))))
    else
      let q = numDiv(f, g)
      Pc(q, divPs(addPs(fs_, negatePs(dotMult(q, gs))), delay(() => Pc(g, gs))))
)
//│ CTML translation succeeded.

