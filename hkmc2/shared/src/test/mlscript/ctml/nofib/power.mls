/** Compose the first series with the second. */
fun compose_(fss, gss) = delay(() => if force(fss) is
  Pz() then Pz()
  Pc(f, fs_) and force(gss) is
    Pz() then Pc(f, delay(() => Pz()))
    Pc(g, gs) and g == 0.0 then Pc(f, multPs(gs, compose_(fs_, delay(() => Pc(0.0, gs)))))
    else force(addPs(delay(() => Pc(f, delay(() => Pz()))), multPs(gss, compose_(fs_, gss))))
)
//│ CTML translation succeeded.

