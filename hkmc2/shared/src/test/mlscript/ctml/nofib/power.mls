/** The zero series. */
data class Pz()
/** One coefficient and the delayed remainder. */
data class Pc(f: Num, s)
//│ Pz: Unit → Pz
//│ Pc: ∀α, β. {α ≤ Num} ⟹ α → β → ((Pc ∧ {f: α}) ∧ {s: β})

/** A delayed series of numeric coefficients. */
type Series = [X restricts (Delayed & {resume: () -> (Pz | (Pc & {f: Num} & {s: X}))})] -> X
//│ Series = ∀X. {X ≥ Delayed ∧ {resume: Unit → (Pz ∨ ((Pc ∧ {f: Num}) ∧ {s: X}))}} ⟹ X

