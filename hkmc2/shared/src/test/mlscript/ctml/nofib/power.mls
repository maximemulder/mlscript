/** The infinite series whose coefficients are all one. */
fun list() = delay(() => Pc(1.0, list()))
//│ list: ∀α. {α ≥ Delayed ∧ {resume: Unit → ((Pc ∧ {f: Num}) ∧ {s: α})}} ⟹ Unit → (Delayed ∧ {resume: Unit → ((Pc ∧ {f: Num}) ∧ {s: α})})

