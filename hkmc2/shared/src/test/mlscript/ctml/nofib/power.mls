/** The series for x. */
fun x_() = delay(() => Pc(0.0, delay(() => Pc(1.0, delay(() => Pz())))))
//│ x_: Unit → (Delayed ∧ {resume: Unit → ((Pc ∧ {f: Num}) ∧ {s: Delayed ∧ {resume: Unit → ((Pc ∧ {f: Num}) ∧ {s: Delayed ∧ {resume: Unit → Pz}})}})})

/** The series for a constant, with the zero series represented separately. */
fun fromIntegerPs(c) = if
  c == 0.0 then delay(() => Pz())
  else delay(() => Pc(c, delay(() => Pz())))
//│ fromIntegerPs: ∀α. {α ≤ Num} ⟹ α → ((Delayed ∧ {resume: Unit → ((Pc ∧ {f: α}) ∧ {s: Delayed ∧ {resume: Unit → Pz}})}) ∨ (Delayed ∧ {resume: Unit → Pz}))

