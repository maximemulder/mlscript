/** Evaluate all four extractions in source order and return the last. */
fun testPower_nofib(p) =
  let sine = extract(p, minusPs(sinx(), sqrtPs(minusPs(fromIntegerPs(1.0), powerPs(cosx(), 2)))))
  let tangent = extract(p, minusPs(
    divPs(sinx(), cosx()),
    revert(integral(divPs(fromIntegerPs(1.0), addPs(fromIntegerPs(1.0), powerPs(x_(), 2)))))
  ))
  let product = extract(p, ts())
  extract(p, tree())
//│ CTML translation succeeded.

