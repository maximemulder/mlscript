/** Integrate the series with zero constant of integration. */
fun integral(fs_) =
  /** Divide each successive coefficient by its new degree. */
  fun int1(fss, n) = delay(() => if force(fss) is
    Pz() then Pz()
    Pc(f, tail) then Pc(numDiv(f, numFromInt(n)), int1(tail, n + 1))
  )
  delay(() => Pc(0.0, int1(fs_, 1)))
//│ CTML translation succeeded.

