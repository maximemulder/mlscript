//│                     η ≤ LCons
//│                       LNil ∨ ((LCons ∧ {head: γ}) ∧ {tail: η}) ≤ LCons
//│                         LNil ≤ LCons

// Diagnostic control for the range used by cryptarithm1; ordinary range uses remain implicit.
take(10, enumFromTo[IntList](0, 10)) as IntList
