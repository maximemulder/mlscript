/** Flatten rows with a trailing newline per row. */
fun inferredUnlines(ls) = concat(map(x => append(x, LCons("\n", LNil())), ls))
//│ inferredUnlines: ∀α, Y. {Y ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: Y}), α ≤ ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: X})} ⟹ X} ⟹ (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X) → Y

