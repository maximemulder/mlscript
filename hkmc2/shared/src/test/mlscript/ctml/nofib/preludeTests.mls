//│                     Unit → ε ≤ Unit → (LzNil ∨ {tail: ζ})
//│                       ε ≤ LzNil ∨ {tail: ζ}
//│                         (LzCons ∧ {head: Int}) ∧ {tail: LNil} ≤ LzNil ∨ {tail: ζ}
