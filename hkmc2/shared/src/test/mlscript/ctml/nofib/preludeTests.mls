// Floor division and modulo infer ordinary integer contracts in all operand-sign cases.
// These are typing checks; campaign/nofib/check-floor-division.py checks the arithmetic model.
[intDiv(7, 3), intMod(7, 3)] as [Int, Int]
[intDiv(0 - 7, 3), intMod(0 - 7, 3)] as [Int, Int]
[intDiv(7, 0 - 3), intMod(7, 0 - 3)] as [Int, Int]
[intDiv(0 - 7, 0 - 3), intMod(0 - 7, 0 - 3)] as [Int, Int]
[intDiv(0 - 6, 3), intMod(0 - 6, 3)] as [Int, Int]
