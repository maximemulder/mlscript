/** Return the element at a zero-based list index. The source operation is partial. */
fun atIndex(i, ls) = if ls is
  LCons(h, t) and
    i == 0 then h
    else atIndex(i - 1, t)
//│ atIndex: ∀α, β. {β ≤ ({tail: β} ∧ {head: α}) ∧ LCons} ⟹ Int → (({tail: β} ∧ {head: α}) ∧ LCons) → α

