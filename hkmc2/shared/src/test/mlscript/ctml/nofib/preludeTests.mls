/** Proper lists of strings used for shared-operation result assertions. */
type StrList = [X restricts (LNil | (LCons & {head: Str} & {tail: X}))] -> X
//│ StrList = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: X})} ⟹ X

/** Proper lists of integer rows. */
type IntRows = [X restricts (LNil | (LCons & {head: IntList} & {tail: X}))] -> X
//│ IntRows = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: IntList}) ∧ {tail: X})} ⟹ X

/** Lazy integer prefix invariant. */
type IntLz = [X restricts (Delayed & {resume: () -> (LzNil | (LzCons & {head: Int} & {tail: X}))})] -> X
//│ IntLz = ∀X. {X ≥ Delayed ∧ {resume: Unit → (LzNil ∨ ((LzCons ∧ {head: Int}) ∧ {tail: X}))}} ⟹ X

/** Lazy string map result invariant. */
type StrLz = [X restricts (Delayed & {resume: () -> (LzNil | (LzCons & {head: Str} & {tail: X}))})] -> X
//│ StrLz = ∀X. {X ≥ Delayed ∧ {resume: Unit → (LzNil ∨ ((LzCons ∧ {head: Str}) ∧ {tail: X}))}} ⟹ X

concat(LCons(LCons(1, LNil()), LCons(LNil(), LNil()))) as IntList
transpose(LCons(LNil(), LCons(LCons(1, LNil()), LNil()))) as IntRows
reverse(LCons("x", LCons("y", LNil()))) as StrList
unlines(LCons(LCons("x", LNil()), LNil())) as StrList
//│ IntList
//│ IntRows
//│ StrList
//│ StrList

foldr((x, acc) => stringOfInt(x) ++ acc, "", LCons(1, LNil())) as Str
foldr1((a, b) => a + b, LCons(1, LCons(2, LNil()))) as Int
mapLz(stringOfInt, delayedCell) as StrLz
takeLzLz(1, delayedCell) as IntLz
//│ Str
//│ Int
//│ StrLz
//│ IntLz

/** Apply the callback to the second component of each pair and sum the results. */
fun sumSeconds(f, xs) =
  foldr((p, acc) => if p is [_, b] then acc + f(b), 0, xs)
//│ sumSeconds: ∀α, β. {α ≤ ⟨⊤, β⟩} ⟹ (β → Int) → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X) → Int

sumSeconds(x => x + 1, LCons(["unused", 4], LNil())) as Int
sumSeconds(nofibStringLength, LCons([4, "four"], LNil())) as Int
//│ Int
//│ Int

:te
