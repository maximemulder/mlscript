//│ preludeLazyEmpty: Delayed ∧ {resume: Unit → LzNil}
//│ preludeLazyOne: Delayed ∧ {resume: Unit → ((LzCons ∧ {head: Int}) ∧ {tail: Delayed ∧ {resume: Unit → LzNil}})}

