/** Render an integer as a document. */
fun ppInt(n, width, is_vert) = ppStr(nofibStringToList(stringOfInt(n)), width, is_vert)
//│ ppInt: Int → Int → ⊤ → ((((MkPrettyRep ∧ {cseq: CStr ∧ {a: LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α})} ⟹ α})}}) ∧ {n: Int}) ∧ {b1: Bool}) ∧ {b2: Bool})

/** Print a comma followed by a space. */
fun pp_SP(a, b) = ppStr(nofibStringToList(", "), a, b)
//│ pp_SP: Int → ⊤ → ((((MkPrettyRep ∧ {cseq: CStr ∧ {a: LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α})} ⟹ α})}}) ∧ {n: Int}) ∧ {b1: Bool}) ∧ {b2: Bool})

/** Print a space. */
fun ppSP(a, b) = ppChar(" ", a, b)
//│ ppSP: Int → ⊤ → ((((MkPrettyRep ∧ {cseq: CCh ∧ {a: Str}}) ∧ {n: Int}) ∧ {b1: Bool}) ∧ {b2: Bool})

/** Print an opening square bracket. */
fun ppLbrack(a, b) = ppChar("[", a, b)
//│ ppLbrack: Int → ⊤ → ((((MkPrettyRep ∧ {cseq: CCh ∧ {a: Str}}) ∧ {n: Int}) ∧ {b1: Bool}) ∧ {b2: Bool})

/** Print a closing square bracket. */
fun ppRbrack(a, b) = ppChar("]", a, b)
//│ ppRbrack: Int → ⊤ → ((((MkPrettyRep ∧ {cseq: CCh ∧ {a: Str}}) ∧ {n: Int}) ∧ {b1: Bool}) ∧ {b2: Bool})

/** Print an opening parenthesis. */
fun ppLparen(a, b) = ppChar("(", a, b)
//│ ppLparen: Int → ⊤ → ((((MkPrettyRep ∧ {cseq: CCh ∧ {a: Str}}) ∧ {n: Int}) ∧ {b1: Bool}) ∧ {b2: Bool})

/** Print a closing parenthesis. */
fun ppRparen(a, b) = ppChar(")", a, b)
//│ ppRparen: Int → ⊤ → ((((MkPrettyRep ∧ {cseq: CCh ∧ {a: Str}}) ∧ {n: Int}) ∧ {b1: Bool}) ∧ {b2: Bool})

/** Print a semicolon. */
fun ppSemi(a, b) = ppChar(";", a, b)
//│ ppSemi: Int → ⊤ → ((((MkPrettyRep ∧ {cseq: CCh ∧ {a: Str}}) ∧ {n: Int}) ∧ {b1: Bool}) ∧ {b2: Bool})

/** Print a comma. */
fun ppComma(a, b) = ppChar(",", a, b)
//│ ppComma: Int → ⊤ → ((((MkPrettyRep ∧ {cseq: CCh ∧ {a: Str}}) ∧ {n: Int}) ∧ {b1: Bool}) ∧ {b2: Bool})

/** Select the second value if the first is true. */
fun andL(a, b) = if a then b else false
//│ andL: ∀α. Bool → α → (α ∨ Bool)

/** Select the second value if the first is false. */
fun orL(a, b) = if a then true else b
//│ orL: ∀α. Bool → α → (α ∨ Bool)

/** Put two documents beside each other without a separator. */
fun ppBeside(p1, p2, width, is_vert) = if p1(width, false) is
  MkPrettyRep(seq1, ll1, emp1, sl1) and p2(width - ll1, false) is
    MkPrettyRep(seq2, ll2, emp2, sl2) then
      MkPrettyRep(cAppend(seq1, cIndent(ll1, seq2)), ll1 + ll2,
        andL(emp1, emp2), andL(0 <= width, andL(sl1, sl2)))
//│ ppBeside: ∀α, β, γ, δ. {γ ≤ Int, α ≤ Int} ⟹ (α → Bool → (((({n: γ} ∧ {b2: Bool}) ∧ {b1: Bool}) ∧ {cseq: β}) ∧ MkPrettyRep)) → (Int → Bool → (((({n: Int} ∧ {b2: Bool}) ∧ {b1: Bool}) ∧ {cseq: δ}) ∧ MkPrettyRep)) → α → ⊤ → ((((MkPrettyRep ∧ {cseq: (CAppend ∧ {a: β}) ∧ {b: (CIndent ∧ {a: γ}) ∧ {b: δ}}}) ∧ {n: Int}) ∧ {b1: Bool}) ∧ {b2: Bool})

:ctml-parse-only // FIXME: The nonempty printer fold exceeds the 20000-call budget.
/** Arrange the documents horizontally in order, with no separators. */
fun ppBesides(ps) = if ps is
  LNil() then ppNil
  LCons(_, _) then foldr1((a, b) => (c, d) => ppBeside(a, b, c, d), ps)
//│ CTML translation succeeded.

/** Put two documents beside each other with a space when both are nonempty. */
fun ppBesideSP(p1, p2, width, is_vert) = if p1(width, false) is
  MkPrettyRep(seq1, ll1, emp1, sl1) then
    let li = if emp1 then 0 else ll1 + 1
    if p2(width - li, false) is MkPrettyRep(seq2, ll2, emp2, sl2) then
      let wi = if emp1 then 0 else 1
      let sp = if orL(emp1, emp2) then cNil else cCh(" ")
      MkPrettyRep(cAppend(seq1, cAppend(sp, cIndent(li, seq2))), li + ll2,
        andL(emp1, emp2), andL(wi <= width, andL(sl1, sl2)))
//│ ppBesideSP: ∀α, β, γ. {α ≤ Int} ⟹ (α → Bool → (((({n: Int} ∧ {b2: Bool}) ∧ {b1: Bool}) ∧ {cseq: β}) ∧ MkPrettyRep)) → (Int → Bool → (((({n: Int} ∧ {b2: Bool}) ∧ {b1: Bool}) ∧ {cseq: γ}) ∧ MkPrettyRep)) → α → ⊤ → ((((MkPrettyRep ∧ {cseq: (CAppend ∧ {a: β}) ∧ {b: (CAppend ∧ {a: (CCh ∧ {a: Str}) ∨ CNil}) ∧ {b: (CIndent ∧ {a: Int}) ∧ {b: γ}}}}) ∧ {n: Int}) ∧ {b1: Bool}) ∧ {b2: Bool})

:ctml-parse-only // FIXME: The nonempty printer fold exceeds the 20000-call budget.
/** Arrange the documents horizontally, separating nonempty items with spaces. */
fun ppCat(ps) = if ps is
  LNil() then ppNil
  LCons(_, _) then foldr1((a, b) => (c, d) => ppBesideSP(a, b, c, d), ps)
//│ CTML translation succeeded.

/** Stack two documents vertically, with a newline when both are nonempty. */
fun ppAbove(p1, p2, width, is_vert) = if p1(width, true) is
  MkPrettyRep(seq1, ll1, emp1, sl1) and p2(width, true) is
    MkPrettyRep(seq2, ll2, emp2, sl2) then
      let nl = if orL(emp1, emp2) then cNil else cNL
      MkPrettyRep(cAppend(seq1, cAppend(nl, seq2)), ll2, andL(emp1, emp2), false)
//│ ppAbove: ∀α, β, γ, δ. {δ ≤ Int} ⟹ (α → Bool → (((({n: ⊤} ∧ {b2: ⊤}) ∧ {b1: Bool}) ∧ {cseq: β}) ∧ MkPrettyRep)) → (α → Bool → (((({n: δ} ∧ {b2: ⊤}) ∧ {b1: Bool}) ∧ {cseq: γ}) ∧ MkPrettyRep)) → α → ⊤ → ((((MkPrettyRep ∧ {cseq: (CAppend ∧ {a: β}) ∧ {b: (CAppend ∧ {a: CNil ∨ CNewline}) ∧ {b: γ}}}) ∧ {n: δ}) ∧ {b1: Bool}) ∧ {b2: Bool})

:ctml-parse-only // FIXME: The nonempty printer fold exceeds the 20000-call budget.
/** Stack the documents vertically in order. */
fun ppAboves(ps, a, b) = if ps is
  LNil() then ppNil(a, b)
  LCons(_, _) then foldr1((a, b) => (c, d) => ppAbove(a, b, c, d), ps)(a, b)
//│ CTML translation succeeded.

ppBeside(ppLparen, ppRparen, 80, false).n as Int
ppBesideSP(ppLparen, ppRparen, 80, false).b2 as Bool
ppAbove(ppLparen, ppRparen, 80, false).cseq.b.a as (CNil | CNewline)
//│ Int
//│ Bool
//│ CNil ∨ CNewline

:ctml-parse-only // FIXME: Combining the vertical and horizontal layouts exceeds the 20000-call budget.
/** Indent a printer when laying out vertically. */
fun ppNest(n, p, width, is_vert) = if
  is_vert and p(width - n, true) is MkPrettyRep(seq, ll, emp, sl) then
    MkPrettyRep(cIndent(n, seq), ll + n, emp, sl)
  else p(width, false)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The fit tests and three layouts exceed the 20000-call budget.
/** Place a hanging document beside its label if selected by the source fit rule. */
fun ppHang(p1, n, p2, width, is_vert) = if p1(width, false) is
  MkPrettyRep(seq1, ll1, emp1, sl1) and p2(width - (ll1 + 1), false) is
    MkPrettyRep(seq2, ll2, emp2, sl2) and p2(width - n, false) is
      MkPrettyRep(seq2_, ll2_, emp2_, sl2_) then
        if
          emp1 then p2(width, is_vert)
          orL(ll1 <= n, sl2) then
            MkPrettyRep(cAppend(seq1, cAppend(cCh(" "), cIndent(ll1 + 1, seq2))),
              ll1 + 1 + ll2, false, andL(sl1, sl2))
          else MkPrettyRep(cAppend(seq1, cAppend(cNL, cIndent(n, seq2_))), ll2_, false, false)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The printer folds and final rendering are translation-only.
/** Render the three source documents and add the trailing newline. */
fun testPretty_nofib() =
  /** Print one repeated word. */
  fun pp_word(a, b) = ppStr(nofibStringToList("xxxxx"), a, b)
  let pp_words = replicate(50, pp_word)
  /** Stack the three sections of the source document. */
  fun pretty_stuff(a, b) =
    let first = ppBesides(LCons((a, b) => ppInt(0 - 42, a, b),
      LCons((a, b) => ppChar("@", a, b),
        LCons((a, b) => ppStr(nofibStringToList("This is a string"), a, b), LNil()))))
    /** Hang the repeated words from the label. */
    fun third(a, b) = ppHang(
      (a, b) => ppStr(nofibStringToList("This is the label"), a, b), 8, ppCat(pp_words), a, b)
    ppAboves(LCons(first, LCons((a, b) => pp_SP(a, b), LCons(third, LNil()))), a, b)
  append(ppShow(80, pretty_stuff), nofibStringToList("\n"))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The full benchmark layout is translation-only.
/** Join the source output's character list into a string. */
fun main() = nofibListToString(testPretty_nofib())
//│ CTML translation succeeded.
