//│       Int ≤ γ
//│         Int ≤ Bool

/** Build a character-list document at the given width. */
fun ppStr(s, width, is_vert) =
  let ls = listLen(s)
  MkPrettyRep(cStr(s), ls, false, ls <= width)
//│ ppStr: ∀α. {α ≤ ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: X})} ⟹ X} ⟹ α → Int → ⊤ → ((((MkPrettyRep ∧ {cseq: CStr ∧ {a: α}}) ∧ {n: Int}) ∧ {b1: Bool}) ∧ {b2: Bool})

/** Build a one-character document at the given width. */
fun ppChar(c, width, is_vert) = MkPrettyRep(cCh(c), 1, false, 1 <= width)
//│ ppChar: ∀α. {α ≤ Str} ⟹ α → Int → ⊤ → ((((MkPrettyRep ∧ {cseq: CCh ∧ {a: α}}) ∧ {n: Int}) ∧ {b1: Bool}) ∧ {b2: Bool})

ppChar("@", 80, false).n as Int
ppChar("@", 80, false).cseq.a as Str
ppStr(LCons("x", LNil()), 80, false).b2 as Bool
//│ Int
//│ Str
//│ Bool

