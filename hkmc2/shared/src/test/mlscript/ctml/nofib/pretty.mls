/** Append two fragments at the current indentation. */
data class CAppend(a, b)
/** Increase indentation within a fragment. */
data class CIndent(a: Int, b)
/** A fragment containing a list of source character code units. */
data class CStr(a: [X restricts (LNil | (LCons & {head: Str} & {tail: X}))] -> X)
/** A fragment containing one source character code unit. */
data class CCh(a: Str)
/** The empty fragment. */
data class CNil()
/** A newline fragment. */
data class CNewline()
//│ CAppend: ∀α, β. α → β → ((CAppend ∧ {a: α}) ∧ {b: β})
//│ CIndent: ∀γ, δ. {γ ≤ Int} ⟹ γ → δ → ((CIndent ∧ {a: γ}) ∧ {b: δ})
//│ CStr: ∀ε. {ε ≤ ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: X})} ⟹ X} ⟹ ε → (CStr ∧ {a: ε})
//│ CCh: ∀ζ. {ζ ≤ Str} ⟹ ζ → (CCh ∧ {a: ζ})
//│ CNil: Unit → CNil
//│ CNewline: Unit → CNewline

/** User-facing presentation. */
data class PprForUser()
/** Debug presentation. */
data class PprDebug()
/** Presentation with all details. */
data class PprShowAll()
/** Interface presentation. */
data class PprInterface()
//│ PprForUser: Unit → PprForUser
//│ PprDebug: Unit → PprDebug
//│ PprShowAll: Unit → PprShowAll
//│ PprInterface: Unit → PprInterface

/** The empty document fragment. */
val cNil = CNil()
//│ cNil: CNil

/** A document fragment ending the current line. */
val cNL = CNewline()
//│ cNL: CNewline

/** Concatenate two document fragments. */
fun cAppend(cs1, cs2) = CAppend(cs1, cs2)
//│ cAppend: ∀α, β. α → β → ((CAppend ∧ {a: α}) ∧ {b: β})

/** Indent a document fragment. */
fun cIndent(n, cs) = CIndent(n, cs)
//│ cIndent: ∀α, β. {α ≤ Int} ⟹ α → β → ((CIndent ∧ {a: α}) ∧ {b: β})

/** Form a fragment from a character list. */
fun cStr(s) = CStr(s)
//│ cStr: ∀α. {α ≤ ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: X})} ⟹ X} ⟹ α → (CStr ∧ {a: α})

/** Form a fragment from a character. */
fun cCh(c) = CCh(c)
//│ cCh: ∀α. {α ≤ Str} ⟹ α → (CCh ∧ {a: α})

/** Prepend tabs of width eight followed by the remaining spaces. */
fun mkIndent(n, s) = if
  n === 0 then s
  8 <= n then LCons("\t", mkIndent(n - 8, s))
  else LCons(" ", mkIndent(n - 1, s))
//│ mkIndent: ∀α, β, γ. {α ≤ β ∧ γ, γ ≥ ((LCons ∧ {head: Str}) ∧ {tail: γ}) ∨ ((LCons ∧ {head: Str}) ∧ {tail: β}), β ≥ ((LCons ∧ {head: Str}) ∧ {tail: γ}) ∨ ((LCons ∧ {head: Str}) ∧ {tail: β})} ⟹ Int → α → ((((LCons ∧ {head: Str}) ∧ {tail: γ}) ∨ ((LCons ∧ {head: Str}) ∧ {tail: β})) ∨ α)

/** Proper list of source characters. */
type Text = [X restricts (LNil | (LCons & {head: Str} & {tail: X}))] -> X
//│ Text = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: X})} ⟹ X

mkIndent(3, LNil()) as Text
//│ Text

declare fun suffix: Text
//│ suffix: Text

mkIndent(9, suffix) as Text
//│ Text

mkIndent as (Int -> Text -> Text)
//│ Int → Text → Text

