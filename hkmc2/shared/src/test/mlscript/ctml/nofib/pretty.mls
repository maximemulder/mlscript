/** Resume the pending stack of column and fragment pairs. */
data class Pending(seqs)
/** Process a fragment at the given column before resuming the stack. */
data class Fragment(col: Int, seq, seqs)
//│ Pending: ∀α. α → (Pending ∧ {seqs: α})
//│ Fragment: ∀β, γ, δ. {β ≤ Int} ⟹ β → γ → δ → (((Fragment ∧ {col: β}) ∧ {seq: γ}) ∧ {seqs: δ})

:ctml-parse-only // FIXME: Recursive dispatch through the fragment stack exceeds the 20000-call budget.
/** Flatten fragments in source order, indenting only at the start of each line. */
fun flatten(nlp, task) = if task is
  Pending(seqs) and seqs is
    LNil() then LNil()
    LCons([col, seq], rest) then flatten(nlp, Fragment(col, seq, rest))
  Fragment(n, cseq, seqs) and cseq is
    CNil() then flatten(nlp, Pending(seqs))
    CAppend(seq1, seq2) then flatten(nlp, Fragment(n, seq1, LCons([n, seq2], seqs)))
    CIndent(n_, seq) then flatten(nlp, Fragment(n_ + n, seq, seqs))
    CNewline() then LCons("\n", flatten(true, Pending(seqs)))
    CStr(s) then
      if nlp then mkIndent(n, append(s, flatten(false, Pending(seqs))))
      else append(s, flatten(false, Pending(seqs)))
    CCh(c) then
      if nlp then mkIndent(n, LCons(c, flatten(false, Pending(seqs))))
      else LCons(c, flatten(false, Pending(seqs)))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The recursive fragment dispatcher is translation-only.
/** Render a fragment at the beginning of a line. */
fun cShow(seq) = flatten(true, Fragment(0, seq, LNil()))
//│ CTML translation succeeded.

/** A fragment with its final line length, emptiness, and single-line fit flag. */
data class MkPrettyRep(cseq, n: Int, b1: Bool, b2: Bool)
//│ MkPrettyRep: ∀α, β, γ, δ. {β ≤ Int, δ ≤ Bool, γ ≤ Bool} ⟹ α → β → γ → δ → ((((MkPrettyRep ∧ {cseq: α}) ∧ {n: β}) ∧ {b1: γ}) ∧ {b2: δ})

:ctml-parse-only // FIXME: The fragment renderer is translation-only.
/** Render a printer at the requested width. */
fun ppShow(width, p) = if p(width, false) is
  MkPrettyRep(seq, _, _, _) then cShow(seq)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The fragment renderer is translation-only.
/** Render a printer at the default width of eighty. */
fun ppUnformatted(p) = if p(80, false) is
  MkPrettyRep(seq, _, _, _) then cShow(seq)
//│ CTML translation succeeded.

/** Build the empty document at the given width. */
fun ppNil(width, is_vert) = MkPrettyRep(cNil, 0, true, 0 <= width)
//│ ppNil: Int → ⊤ → ((((MkPrettyRep ∧ {cseq: CNil}) ∧ {n: Int}) ∧ {b1: Bool}) ∧ {b2: Bool})

ppNil(0, false).b1 as Bool
//│ Bool

