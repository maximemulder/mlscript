:ctml-parse-only // FIXME: The random draw and witness test have no inferred types.
/** Draw a base, test it, and return the remaining stream. */
fun singleTest(n, kq, rs) = if random(n - 2, rs) is [x, rs_] then
  [singleTestX(n, kq, 2 + x), rs_]
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The individual trial is translation-only.
/** Run at most k trials and keep the remaining random state. */
fun multiTest(k, rs, n) =
  /** Stop at the first witness of compositeness. */
  fun mTest(k, rs) = if
    k == 0 then [true, rs]
    singleTest(n, findKQ(n), rs) is [t, rs_] and
      t then mTest(k - 1, rs_)
      else [false, rs_]
  if ((n <= 1) || even(n)) then [n == 2, rs] else mTest(k, rs)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Decimal parsing and repeated trials are translation-only.
/** Parse and classify one candidate before continuing with its remaining stream. */
fun doLine(cs, cont, rs) =
  let n = int_val_of_string(cs)
  if multiTest(100, rs, n) is [t, rs_] and
    t then LCons("Probably prime", cont(rs_))
    else LCons("Composite", cont(rs_))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The line classifier is translation-only.
/** Classify the input candidates while threading the random state between lines. */
fun doInput(state, lls) = if lls is
  LNil() then LNil()
  LCons(l, ls) then doLine(l, state => doInput(state, ls), state)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The input traversal is translation-only.
/** Seed the stream with the two source constants. */
fun process(process_arg1) = doInput(randomInts(111, 47), process_arg1)
//│ CTML translation succeeded.

