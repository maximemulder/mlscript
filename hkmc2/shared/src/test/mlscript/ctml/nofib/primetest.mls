// Source: hkmc2/shared/src/test/mlscript-compile/nofib/primetest.mls.
// Lists use LNil and LCons, and random streams use the shared memoizing delay and force.
// Decimal input consists of nonempty UTF-16 code units produced by nofibStringToList.

/** Test divisibility by two. */
fun even(x) = intMod(x, 2) == 0
//│ even: Int → Bool

/** Convert a decimal code unit to its digit value. */
fun int_val_of_char(x) = nofibCharCode(x) - 48
//│ int_val_of_char: Str → Int

:ctml-parse-only // FIXME: Inference exceeds a 20000-call solver budget.
/** Interpret the entire character list in base ten. */
fun int_val_of_string(s) =
  /** Accumulate decimal digits in source order. */
  fun f(l, a) = if l is
    LNil() then a
    LCons(h, t) then f(t, 10 * a + int_val_of_char(h))
  f(s, 0)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Recursing on the predicate split exceeds a 20000-call solver budget.
/** Split the source input at pipe characters. */
fun lines(s) = if break_(x => x == "|", s) is [l, s_] then
  let tt = if s_ is
    LNil() then LNil()
    LCons(_, s__) then lines(s__)
  LCons(l, tt)
//│ CTML translation succeeded.

/** Interpret a digit list in the given radix. */
fun makeNumber(b, ls) = foldl((a, x) => a * b + x, 0, ls)
//│ makeNumber: ∀α. {α ≤ Int} ⟹ Int → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X) → Int

/** Decompose a number into radix digits with the most significant digit first. */
fun chop(b, n) =
  /** Prepend each successive remainder to the digits already collected. */
  fun chop_(a, n) = if divMod(n, b) is [q, r] and
    n == 0 then a
    else chop_(LCons(r, a), q)
  chop_(LNil(), n)
//│ chop: ∀α. {α ≥ ((LCons ∧ {head: Int}) ∧ {tail: α}) ∨ LNil} ⟹ Int → Int → α

/** Compute a modular power by repeated squaring. */
fun powerMod(a, b, m) =
  /** Reduce the exponent while carrying the modular product. */
  fun f(a, b, c) =
    /** Square through the even exponents before the next multiplication. */
    fun g(a, b) =
      if even(b) then g(intMod(a * a, m), intDiv(b, 2))
      else f(a, b - 1, intMod(a * c, m))
    if b == 0 then c else g(a, b)
  if
    b == 0 then 1
    let a_ = intMod(a, m)
    else f(a_, b - 1, a_)
//│ powerMod: Int → Int → Int → Int

/** Count the source binary digits. */
fun log2(x) = listLen(chop(2, x))
//│ log2: Int → Int

/** Produce the source combined pseudorandom stream from two seed states. */
fun rands(s1, s2) =
  let k = intDiv(s1, 53668)
  let s1_ = (40014 * (s1 - k * 53668)) - k * 12211
  let s1__ = if s1_ < 0 then s1_ + 2147483563 else s1_
  let k_ = intDiv(s2, 52774)
  let s2_ = (40692 * (s2 - k_ * 52774)) - k_ * 3791
  let s2__ = if s2_ < 0 then s2_ + 2147483399 else s2_
  let z = s1__ - s2__
  if z < 1 then delay(() => LzCons(z + 2147483562, rands(s1__, s2__)))
  else delay(() => LzCons(z, rands(s1__, s2__)))
//│ rands: ∀α, β. {β ≥ (Delayed ∧ {resume: Unit → ((LzCons ∧ {head: Int}) ∧ {tail: β})}) ∨ (Delayed ∧ {resume: Unit → ((LzCons ∧ {head: Int}) ∧ {tail: α})}), α ≥ (Delayed ∧ {resume: Unit → ((LzCons ∧ {head: Int}) ∧ {tail: β})}) ∨ (Delayed ∧ {resume: Unit → ((LzCons ∧ {head: Int}) ∧ {tail: α})})} ⟹ Int → Int → ((Delayed ∧ {resume: Unit → ((LzCons ∧ {head: Int}) ∧ {tail: β})}) ∨ (Delayed ∧ {resume: Unit → ((LzCons ∧ {head: Int}) ∧ {tail: α})}))

/** Start the generator for seeds inside the source bounds. */
fun randomInts(s1, s2) =
  if (1 <= s1) and (s1 <= 2147483562) and (1 <= s2) and (s2 <= 2147483398)
  then rands(s1, s2)
  else raiseError("match error")
//│ randomInts: Int → Int → (Delayed ∧ {resume: Unit → ((LzCons ∧ {head: Int}) ∧ {tail: ∀α. {α ≥ Delayed ∧ {resume: Unit → ((LzCons ∧ {head: Int}) ∧ {tail: α})}} ⟹ α})})

/** Factor n - 1 as a power of two times an odd quotient. */
fun findKQ(n) =
  /** Repeatedly divide the quotient by two while it is even. */
  fun f(k, q) = if divMod(q, 2) is [d, r] and
    r == 0 then f(k + 1, d)
    else [k, q]
  f(0, n - 1)
//│ findKQ: Int → ⟨Int, Int⟩

/** Return the strict prefix and the remaining delayed stream. */
fun splitAtLz(n, ls) = [takeLz(n, ls), leaveLz(n, ls)]
//│ splitAtLz: ∀α, β. Int → ((∀X. {X ≥ Delayed ∧ {resume: Unit → (LzNil ∨ ((LzCons ∧ {head: α}) ∧ {tail: X}))}} ⟹ X) ∧ (∀X. {X ≥ Delayed ∧ {resume: Unit → (LzNil ∨ ((LzCons ∧ {head: β}) ∧ {tail: X}))}} ⟹ X)) → ⟨∀Y. {Y ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: Y})} ⟹ Y, ∀Y. {Y ≥ Delayed ∧ {resume: Unit → (LzNil ∨ ((LzCons ∧ {head: β}) ∧ {tail: Y}))}} ⟹ Y⟩

:ctml-parse-only // FIXME: Inference exceeds a 20000-call solver budget.
/** Sample radix digits bounded by the given digit sequence. */
fun uniform(nns, rrs) = if
  nns is LCons(n, LNil()) and rrs is LCons(r, rs) then LCons(intMod(r, n), LNil())
  nns is LCons(n, ns) and rrs is LCons(r, rs) and
    let t = intMod(r, n + 1)
    t == n then LCons(t, uniform(ns, rs))
    else LCons(t, map(x => intMod(x, 65536), rs))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The digit selection traversal is translation-only.
/** Draw one bounded random number and return the unused stream. */
fun random(n, rs) =
  let ns = chop(65536, n)
  if splitAtLz(listLen(ns), rs) is [rs1, rs2] then [makeNumber(65536, uniform(ns, rs1)), rs2]
//│ CTML translation succeeded.

// The prefix of an inferred stream has the corresponding strict list element type.
