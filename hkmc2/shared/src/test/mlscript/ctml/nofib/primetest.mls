/** Test whether a supplied base passes the modular witness test. */
fun singleTestX(n, kq, x) =
  /** Square a residue modulo the candidate prime. */
  fun square(x) = intMod(x * x, n)
  /** Stop at the first residue equal to n - 1 or 1. */
  fun witness(ls) = if ls is
    LNil() then false
    LCons(t, ts) and
      t == (n - 1) then true
      t == 1 then false
      else witness(ts)
  if kq is [k, q] and takeLz(k, iterate(square, powerMod(x, q, n))) is LCons(t, ts) then
    (t == 1) || (t == (n - 1)) || witness(ts)
//│ ═══[TYPE ERROR] Cannot solve judgment ∀α, β, γ. {γ ≤ Bool, ε ≤ β → γ, δ ≤ Int, β ≥ α} ⟹ (({tail: α} ∧ {head: ⊤}) ∧ LCons) → Bool ≤ ζ → η.
//│ Typing error tree:
//│   ∀α, β, γ. {γ ≤ Bool, ε ≤ β → γ, δ ≤ Int, β ≥ α} ⟹ (({tail: α} ∧ {head: ⊤}) ∧ LCons) → Bool ≤ ζ → η
//│     {κ ≤ Bool, ε ≤ ι → κ, δ ≤ Int, ι ≥ θ} ⟹ (({tail: θ} ∧ {head: ⊤}) ∧ LCons) → Bool ≤ ζ → η
//│       {ε ≤ ι → κ, δ ≤ Int, ι ≥ θ} ⟹ (({tail: θ} ∧ {head: ⊤}) ∧ LCons) → Bool ≤ ζ → η
//│         {δ ≤ Int, ι ≥ θ} ⟹ (({tail: θ} ∧ {head: ⊤}) ∧ LCons) → Bool ≤ ζ → η
//│           {ι ≥ θ} ⟹ (({tail: θ} ∧ {head: ⊤}) ∧ LCons) → Bool ≤ ζ → η
