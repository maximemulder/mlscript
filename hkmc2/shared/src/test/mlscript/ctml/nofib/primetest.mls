/** Check the seed validation and force two successive random cells. */
fun firstTwoRandoms(s1, s2) =
  if force(randomInts(s1, s2)) is LzCons(h, t) and force(t) is LzCons(next, rest)
  then [h, next]
//│ firstTwoRandoms: Int → Int → ⟨Int, Int⟩

firstTwoRandoms(111, 47) as [Int, Int]
//│ ⟨Int, Int⟩

/** A proper strict list of integer digits. */
type IntList = [X restricts (LNil | (LCons & {head: Int} & {tail: X}))] -> X
/** A proper delayed list of integer digits. */
type IntStream = [X restricts (Delayed & {resume: () -> (LzNil | (LzCons & {head: Int} & {tail: X}))})] -> X
//│ IntList = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Int}) ∧ {tail: X})} ⟹ X
//│ IntStream = ∀X. {X ≥ Delayed ∧ {resume: Unit → (LzNil ∨ ((LzCons ∧ {head: Int}) ∧ {tail: X}))}} ⟹ X

rands(111, 47) as IntStream
//│ IntStream

splitAtLz(1, delay(() => LzCons(7, delay(() => LzNil())))) as [IntList, IntStream]
//│ ⟨IntList, IntStream⟩

