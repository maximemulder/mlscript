/** The first member in the source item ordering. */
data class Bono()
/** The second member in the source item ordering. */
data class Edge()
/** The third member in the source item ordering. */
data class Larry()
/** The last member in the source item ordering. */
data class Adam()
//│ Bono: Unit → Bono
//│ Edge: Unit → Edge
//│ Larry: Unit → Larry
//│ Adam: Unit → Adam

:ctml-parse-only // FIXME: Comparing item tags exceeds the 20000-call solver budget.
/** Test whether a and b represent the same band member. */
fun itemEq(a, b) = if a is
  Bono() and b is Bono() then true
  Edge() and b is Edge() then true
  Larry() and b is Larry() then true
  Adam() and b is Adam() then true
  else false
//│ CTML translation succeeded.

/** Advance one position in the source item ordering. */
fun succItem(i) = if i is
  Bono() then Edge()
  Edge() then Larry()
  Larry() then Adam()
//│ succItem: ∀α, β. {β ≥ ({α ≤ Bono} ⟹ Edge) ∧ ({α ≤ ¬({β ≥ Larry} ⟹ ¬Edge) ∨ ¬({β ≥ Adam} ⟹ ¬Larry)} ⟹ ({α ≤ Edge} ⟹ Larry) ∧ ({α ≤ Larry} ⟹ Adam)), α ≤ ¬({β ≥ Edge} ⟹ ¬Bono) ∨ ¬({β ≥ ({α ≤ Edge} ⟹ Larry) ∧ ({α ≤ Larry} ⟹ Adam)} ⟹ ¬(¬({β ≥ Larry} ⟹ ¬Edge) ∨ ¬({β ≥ Adam} ⟹ ¬Larry)))} ⟹ α → β

/** Test whether i is the last item in the ordering. */
fun isEnd(i) = if i is
  Bono() then false
  Edge() then false
  Larry() then false
  Adam() then true
//│ isEnd: ∀α, β. {β ≥ ({α ≤ Bono} ⟹ Bool) ∧ ({α ≤ Edge ∨ ¬({β ≥ ({α ≤ Larry} ⟹ Bool) ∧ ({α ≤ Adam} ⟹ Bool)} ⟹ ¬(Larry ∨ Adam))} ⟹ ({α ≤ Edge} ⟹ Bool) ∧ ({α ≤ Larry ∨ Adam} ⟹ ({α ≤ Larry} ⟹ Bool) ∧ ({α ≤ Adam} ⟹ Bool))), α ≤ Bono ∨ ¬({β ≥ ({α ≤ Edge} ⟹ Bool) ∧ ({α ≤ Larry ∨ Adam} ⟹ ({α ≤ Larry} ⟹ Bool) ∧ ({α ≤ Adam} ⟹ Bool))} ⟹ ¬(Edge ∨ ¬({β ≥ ({α ≤ Larry} ⟹ Bool) ∧ ({α ≤ Adam} ⟹ Bool)} ⟹ ¬(Larry ∨ Adam))))} ⟹ α → β

:ctml-parse-only // FIXME: Item equality is translation-only.
/** Enumerate the members from a through b, including both endpoints. */
fun itemFromTo(a, b) = if itemEq(a, b) then LCons(a, LNil())
  else LCons(a, itemFromTo(succItem(a), b))
//│ CTML translation succeeded.

/** The starting bank. */
data class LeftBank()
/** The destination bank. */
data class RightBank()
//│ LeftBank: Unit → LeftBank
//│ RightBank: Unit → RightBank

/** One of the two banks. */
type Bank = LeftBank | RightBank
//│ Bank = LeftBank ∨ RightBank

:ctml-parse-only // FIXME: Comparing bank tags exceeds the 20000-call solver budget.
/** Test whether two positions name the same bank. */
fun bankEq(a, b) = if a is
  LeftBank() and b is LeftBank() then true
  RightBank() and b is RightBank() then true
  else false
//│ CTML translation succeeded.

/** The positions of Bono, the Edge, Larry, and Adam in that order. */
data class State(b: Bank, e: Bank, l: Bank, a: Bank)
//│ State: ∀α, β, γ, δ. {β ≤ Bank, δ ≤ Bank, γ ≤ Bank, α ≤ Bank} ⟹ α → β → γ → δ → ((((State ∧ {b: α}) ∧ {e: β}) ∧ {l: γ}) ∧ {a: δ})

:ctml-parse-only // FIXME: Bank equality is translation-only.
/** Test equality of all four positions. */
fun stateEq(s1, s2) = if s1 is State(a, b, c, d) and s2 is State(e, f, g, h) then
  bankEq(a, e) && bankEq(b, f) && bankEq(c, g) && bankEq(d, h)
//│ CTML translation succeeded.

/** Return Bono's current bank. */
fun bonoPos(s) = if s is State(a, _, _, _) then a
//│ bonoPos: ∀α. (((({b: α} ∧ State) ∧ {e: ⊤}) ∧ {l: ⊤}) ∧ {a: ⊤}) → α

/** Return the Edge's current bank. */
fun edgePos(s) = if s is State(_, b, _, _) then b
//│ edgePos: ∀α. (((({e: α} ∧ State) ∧ {b: ⊤}) ∧ {l: ⊤}) ∧ {a: ⊤}) → α

/** Return Larry's current bank. */
fun larryPos(s) = if s is State(_, _, c, _) then c
//│ larryPos: ∀α. (((({l: α} ∧ State) ∧ {b: ⊤}) ∧ {e: ⊤}) ∧ {a: ⊤}) → α

/** Return Adam's current bank. */
fun adamPos(s) = if s is State(_, _, _, d) then d
//│ adamPos: ∀α. (((({a: α} ∧ State) ∧ {b: ⊤}) ∧ {e: ⊤}) ∧ {l: ⊤}) → α

/** Start with everybody on the left. */
val initialState = State(LeftBank(), LeftBank(), LeftBank(), LeftBank())
//│ initialState: (((State ∧ {b: LeftBank}) ∧ {e: LeftBank}) ∧ {l: LeftBank}) ∧ {a: LeftBank}

/** Finish with everybody on the right. */
val finalState = State(RightBank(), RightBank(), RightBank(), RightBank())
//│ finalState: (((State ∧ {b: RightBank}) ∧ {e: RightBank}) ∧ {l: RightBank}) ∧ {a: RightBank}

:ctml-parse-only // FIXME: Selecting among the field projections exceeds the 20000-call budget.
/** Find the current bank of the given item. */
fun position(i, s) = if i is
  Bono() then bonoPos(s)
  Edge() then edgePos(s)
  Larry() then larryPos(s)
  Adam() then adamPos(s)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Choosing a state update exceeds the 20000-call solver budget.
/** Move one item to pos, preserving the other three positions. */
fun updateState(s, i, pos) = if s is State(a, b, c, d) and i is
  Bono() then State(pos, b, c, d)
  Edge() then State(a, pos, c, d)
  Larry() then State(a, b, pos, d)
  Adam() then State(a, b, c, pos)
//│ CTML translation succeeded.

/** Return the opposite riverbank. */
fun opposite(b) = if b is
  LeftBank() then RightBank()
  RightBank() then LeftBank()
//│ opposite: ∀α, β. {β ≥ ({α ≤ LeftBank} ⟹ RightBank) ∧ ({α ≤ RightBank} ⟹ LeftBank), α ≤ ¬({β ≥ RightBank} ⟹ ¬LeftBank) ∨ ¬({β ≥ LeftBank} ⟹ ¬RightBank)} ⟹ α → β

:ctml-parse-only // FIXME: State equality is translation-only.
/** Test whether the history contains no entry with this state. */
fun notSeen(state, states) =
  all(pair => if pair is [_, s] then if stateEq(state, s) then false else true, states)
//│ CTML translation succeeded.

