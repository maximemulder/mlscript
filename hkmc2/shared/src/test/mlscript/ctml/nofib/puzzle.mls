/** Prepend the source display line for one member. */
fun writeItem(i, b, rest) = if i is
  Bono() and b is LeftBank() then
    append(nofibStringToList("    Bono |                    |\n"), rest)
  Edge() and b is LeftBank() then
    append(nofibStringToList("The Edge |                    |\n"), rest)
  Larry() and b is LeftBank() then
    append(nofibStringToList("   Larry |                    |\n"), rest)
  Adam() and b is LeftBank() then
    append(nofibStringToList("    Adam |                    |\n"), rest)
  Bono() and b is RightBank() then
    append(nofibStringToList("         |                    | Bono\n"), rest)
  Edge() and b is RightBank() then
    append(nofibStringToList("         |                    | The Edge\n"), rest)
  Larry() and b is RightBank() then
    append(nofibStringToList("         |                    | Larry\n"), rest)
  Adam() and b is RightBank() then
    append(nofibStringToList("         |                    | Adam\n"), rest)
