:ctml-parse-only // FIXME: The item formatter has no checked type.
/** Prepend the display for the entire state. */
fun writeState(state, s) =
  append(
    nofibStringToList("----------------------------------------\n"),
    writeItem(Bono(), bonoPos(state),
      writeItem(Edge(), edgePos(state),
        writeItem(Larry(), larryPos(state),
          writeItem(Adam(), adamPos(state),
            append(nofibStringToList("----------------------------------------\n"), s)))))
  )
//│ CTML translation succeeded.

/** Read the total crossing time from the most recent entry. */
fun totalTime(history) = if history is LCons([time, _], _) then time
//│ totalTime: ∀α. (({head: ⟨α, ⊤⟩} ∧ LCons) ∧ {tail: ⊤}) → α

:ctml-parse-only // FIXME: The state formatter has no checked type.
/** Display a history with each time relative to the start of the crossing. */
fun writeHistory(history, x) = if history is
  LNil() then x
  else
    foldr(
      (timestate, acc) => s => if timestate is [time, state] then
        append(nofibStringToList("Time: "),
          append(nofibStringToList(stringOfInt(totalTime(history) - time)),
            LCons("\n", writeState(state, acc(s))))),
      x => x,
      history
    )(x)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The history formatter has no checked type.
/** Display every solution with its one-based number. */
fun writeSolutions(solutions, count, s) = if solutions is
  LNil() then s
  LCons(item, next) then
    append(nofibStringToList("Solution "),
      append(nofibStringToList(stringOfInt(count)),
        LCons("\n", writeHistory(item, writeSolutions(next, count + 1, s)))))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The recursive minimum traversal exceeds the 20000-call solver budget.
/** Keep the shortest histories in their original order. */
fun minSolutions(history) = if history is
  LNil() then LNil()
  LCons(first, rest) then
    /** Collect all histories tied at the best total encountered so far. */
    fun minAcc(minSoFar, mins, ls) = if ls is
      LNil() then mins
      LCons(history, next) then
        let total = totalTime(history)
        if
          minSoFar < total then minAcc(minSoFar, mins, next)
          minSoFar === total then minAcc(minSoFar, LCons(history, mins), next)
          else minAcc(total, LCons(history, LNil()), next)
    reverse(minAcc(totalTime(first), LCons(first, LNil()), rest))
//│ CTML translation succeeded.

/** The crossing time of each member, in minutes. */
fun u2times(i) = if i is
  Bono() then 10
  Edge() then 5
  Larry() then 2
  Adam() then 1
//│ u2times: ∀α, β. {β ≥ ({α ≤ Bono} ⟹ Int) ∧ ({α ≤ Edge ∨ ¬({β ≥ ({α ≤ Larry} ⟹ Int) ∧ ({α ≤ Adam} ⟹ Int)} ⟹ ¬(Larry ∨ Adam))} ⟹ ({α ≤ Edge} ⟹ Int) ∧ ({α ≤ Larry ∨ Adam} ⟹ ({α ≤ Larry} ⟹ Int) ∧ ({α ≤ Adam} ⟹ Int))), α ≤ Bono ∨ ¬({β ≥ ({α ≤ Edge} ⟹ Int) ∧ ({α ≤ Larry ∨ Adam} ⟹ ({α ≤ Larry} ⟹ Int) ∧ ({α ≤ Adam} ⟹ Int))} ⟹ ¬(Edge ∨ ¬({β ≥ ({α ≤ Larry} ⟹ Int) ∧ ({α ≤ Adam} ⟹ Int)} ⟹ ¬(Larry ∨ Adam))))} ⟹ α → β

:ctml-parse-only // FIXME: The item range and state updates are translation-only.
/** Enumerate solutions by moving one or two members at a time. */
fun transfer(source, dest, location, countdown, history) =
  if stateEq(source, dest) then LCons(LCons([countdown, dest], history), LNil())
  else
    let newHistory = LCons([countdown, dest], history)
    let newLocation = opposite(location)
    /** Try each single-member move from this bank. */
    fun lscomp1(ls) = if ls is
      LNil() then LNil()
      LCons(item, xs) then
        if bankEq(position(item, dest), location) then
          let newDest = updateState(dest, item, newLocation)
          if notSeen(newDest, history) then
            let newTime = countdown + u2times(item)
            LCons(transfer(source, newDest, newLocation, newTime, newHistory), lscomp1(xs))
          else lscomp1(xs)
        else lscomp1(xs)
    let moveOne = concat(lscomp1(itemFromTo(Bono(), Adam())))
    /** Try each first member of a two-member move. */
    fun lscomp2(ls) = if ls is
      LNil() then LNil()
      LCons(i, xs) then
        /** Try later members in source order, advancing the first member at the end. */
        fun lscomp3(ls) = if ls is
          LNil() then lscomp2(xs)
          LCons(j, ys) then
            if bankEq(position(i, dest), location) and bankEq(position(j, dest), location) then
              let newDest = updateState(updateState(dest, i, newLocation), j, newLocation)
              if notSeen(newDest, history) then
                let newTime = countdown + u2times(i)
                LCons(transfer(source, newDest, newLocation, newTime, newHistory), lscomp3(ys))
              else lscomp3(ys)
            else lscomp3(ys)
        lscomp3(itemFromTo(succItem(i), Adam()))
    let moveTwo = concat(lscomp2(itemFromTo(Bono(), Larry())))
    append(moveOne, moveTwo)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Search and formatting are translation-only.
/** Solve the puzzle and display the optimal crossings. */
fun testPuzzle_nofib(x) =
  let time = if listLen(x) === 1 then 0 else raiseError("puzzle expects exactly one argument")
  let solutions = transfer(initialState, finalState, RightBank(), time, LNil())
  let mins = minSolutions(solutions)
  writeSolutions(mins, 1, LNil())
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The benchmark driver is translation-only.
/** Run the source workload with its one-element argument list. */
fun main() = nofibListToString(testPuzzle_nofib(LCons(2, LNil())))
//│ CTML translation succeeded.

