:ctml-parse-only // FIXME: Block collection and decimal length do not check on nonempty inputs.
/** Encrypt each block and terminate each decimal result with a newline. */
fun encrypt(n, e, s) =
  unlines(map(c => string_of_z(power(e, n, code(c))), collect(size(n), s)))
//│ CTML translation succeeded.

