// Source: hkmc2/shared/src/test/mlscript-compile/nofib/rsa.mls.
// Keep the source ciphertext and hash arithmetic in JavaScript BigInt.

/** Bigint zero for the folds and exponent base case. */
val const0 = bigIntFrom(0)
/** Polynomial hash multiplier. */
val const31 = bigIntFrom(31)
/** Bigint one for the exponent base case and decrement. */
val const1 = bigIntFrom(1)
/** Bigint two for exponent halving. */
val const2 = bigIntFrom(2)
/** Radix for encoding a plaintext block. */
val const128 = bigIntFrom(128)
//│ const0: BigInt
//│ const31: BigInt
//│ const1: BigInt
//│ const2: BigInt
//│ const128: BigInt

/** Render a bigint as a list of decimal characters. */
fun string_of_z(x) = nofibStringToList(stringOfBigInt(x))
//│ string_of_z: ∀α. {α ≥ LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α})} ⟹ BigInt → (LNil ∨ ((LCons ∧ {head: Str}) ∧ {tail: α}))

/** Accumulate the ciphertext's character codes in the source rolling hash. */
fun hash(str) = foldl(
  (acc, c) => bigIntAdd(nofibCodePointBigInt(c), bigIntMul(acc, const31)),
  const0,
  str
)
//│ hash: ∀α. {α ≤ Str} ⟹ (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X) → BigInt

:ctml-parse-only // FIXME: The recursive Boolean traversal exceeds the 20000-call budget.
/** Check each Boolean until one is false. */
fun and_(ls) = if ls is
  LNil() then true
  LCons(h, t) then if h then and_(t) else false
//│ CTML translation succeeded.

/** Test whether a bigint exponent is even. */
fun even(a) = bigIntRem(a, const2) === const0
//│ even: BigInt → Bool

/** Encode a plaintext block in radix 128. */
fun code(ls) = foldl(
  (x, y) => bigIntAdd(bigIntMul(const128, x), nofibCodePointBigInt(y)),
  const0,
  ls
)
//│ code: ∀α. {α ≤ Str} ⟹ (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X) → BigInt

/** Raise x to n modulo m, squaring the recursive result for an even exponent. */
fun power(n, m, x) = if
  n === const0 then const1
  even(n) then
    let halfPower = power(bigIntQuot(n, const2), m, x)
    bigIntRem(bigIntMul(halfPower, halfPower), m)
  else bigIntRem(bigIntMul(x, power(bigIntSub(n, const1), m, x)), m)
//│ power: BigInt → BigInt → BigInt → BigInt

hash(LCons("a", LCons("b", LNil()))) as BigInt
code(LCons("a", LCons("b", LNil()))) as BigInt
power(bigIntFrom(7), bigIntFrom(11), bigIntFrom(3)) as BigInt
//│ BigInt
//│ BigInt
//│ BigInt

