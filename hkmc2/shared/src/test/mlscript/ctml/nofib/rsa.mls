/** Split the plaintext into consecutive blocks of the requested width. */
fun collect(n, xs) = if
  n === 0 then LNil()
  xs is LNil() then LNil()
  else LCons(take(n, xs), collect(n, leave(n, xs)))
//│ collect: ⊤ → LNil → LNil

