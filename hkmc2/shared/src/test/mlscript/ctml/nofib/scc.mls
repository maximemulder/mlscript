/** List of integer edges used to check transposition of the benchmark input. */
type SccEdges = [X restricts (LNil | (LCons & {head: [Int, Int]} & {tail: X}))] -> X
//│ SccEdges = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: ⟨Int, Int⟩}) ∧ {tail: X})} ⟹ X

// Check the transposition step using the prelude's trusted map contract.
map(swap, fst(sccInput())) as SccEdges
//│ SccEdges

:ctml-parse-only // FIXME: The component search is translation-only.
/** Run the fixed source graph, whose input parameter is unused. */
fun testScc_nofib(_input) = if sccInput() is [edges, vertices] then
  stronglyConnComp(edges, vertices)
//│ CTML translation succeeded.

