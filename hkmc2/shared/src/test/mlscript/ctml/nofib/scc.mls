// Source: hkmc2/shared/src/test/mlscript-compile/nofib/scc.mls.
// Edges and traversal state are binary tuples; lists use LNil() and LCons.
// The source runtime test expects "[[1],[2],[7,5,6],[3,4]]" for input 0.

/** Reverse a directed edge. */
fun swap(edge) = if edge is [from, to] then [to, from]
//│ swap: ∀α, β. ⟨α, β⟩ → ⟨β, α⟩

:ctml-parse-only // FIXME: Inference exceeds a 20000-call diagnostic budget.
/** Collect the targets of outgoing edges in their original order. */
fun new_range(edges, vertex) = if edges is
  LNil() then LNil()
  LCons([from, to], rest) and
    from == vertex then LCons(to, new_range(rest, vertex))
    else new_range(rest, vertex)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Inference exceeds a 20000-call budget with inList and append.
/** Visit each reachable vertex once and collect vertices in reverse finishing order. */
fun dfs(r, state, vertices) = if state is [visited, order] and
  vertices is
    LNil() then [visited, order]
    LCons(x, rest) and
      inList(x, visited) then dfs(r, [visited, order], rest)
      dfs(r, [LCons(x, visited), LNil()], r(x)) is [visited_, order_] then
        dfs(r, [visited_, append(LCons(x, order_), order)], rest)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The first depth-first traversal is translation-only.
/** Run depth-first searches in order, collecting one component per unvisited root. */
fun span_tree(r, state, vertices) = if state is [visited, components] and
  vertices is
    LNil() then [visited, components]
    LCons(x, rest) and
      inList(x, visited) then span_tree(r, [visited, components], rest)
      dfs(r, [LCons(x, visited), LNil()], r(x)) is [visited_, order_] then
        span_tree(r, [visited_, LCons(LCons(x, order_), components)], rest)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Neighbor lookup and both traversals are translation-only.
/** Traverse the transposed graph in the first search's reverse finishing order. */
fun stronglyConnComp(edges, vertices) = snd(span_tree(
  x => new_range(map(swap, edges), x),
  [LNil(), LNil()],
  snd(dfs(x => new_range(edges, x), [LNil(), LNil()], vertices))
))
//│ CTML translation succeeded.

/** Construct the source benchmark's vertices and edges in traversal order. */
fun sccInput() =
  let a = 1
  let b = 2
  let c = 3
  let d = 4
  let f = 5
  let g = 6
  let h = 7
  let vertices = LCons(a, LCons(b, LCons(c, LCons(d, LCons(f, LCons(g, LCons(h, LNil())))))))
  let edges = LCons([b, a], LCons([c, b], LCons([c, d], LCons([c, h],
    LCons([d, c], LCons([f, a], LCons([f, g], LCons([f, h],
      LCons([g, f], LCons([h, g], LNil()))))))))))
  [edges, vertices]
//│ sccInput: Unit → ⟨(LCons ∧ {head: ⟨Int, Int⟩}) ∧ {tail: (LCons ∧ {head: ⟨Int, Int⟩}) ∧ {tail: (LCons ∧ {head: ⟨Int, Int⟩}) ∧ {tail: (LCons ∧ {head: ⟨Int, Int⟩}) ∧ {tail: (LCons ∧ {head: ⟨Int, Int⟩}) ∧ {tail: (LCons ∧ {head: ⟨Int, Int⟩}) ∧ {tail: (LCons ∧ {head: ⟨Int, Int⟩}) ∧ {tail: (LCons ∧ {head: ⟨Int, Int⟩}) ∧ {tail: (LCons ∧ {head: ⟨Int, Int⟩}) ∧ {tail: (LCons ∧ {head: ⟨Int, Int⟩}) ∧ {tail: LNil}}}}}}}}}}, (LCons ∧ {head: Int}) ∧ {tail: (LCons ∧ {head: Int}) ∧ {tail: (LCons ∧ {head: Int}) ∧ {tail: (LCons ∧ {head: Int}) ∧ {tail: (LCons ∧ {head: Int}) ∧ {tail: (LCons ∧ {head: Int}) ∧ {tail: (LCons ∧ {head: Int}) ∧ {tail: LNil}}}}}}}⟩

// Distinct endpoint types check that swap reverses their positions.
swap([1, "target"]) as [Str, Int]
//│ ⟨Str, Int⟩

