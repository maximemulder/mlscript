:ctml-parse-only // FIXME: Inference exceeds a 20000-call budget even with a listLen contract.
/** Run the selection procedure for each seed and compute its fraction of successes. */
fun simulate(n, m, proc) =
  /** Collect the result of the procedure for each seed in order. */
  fun trials(ls) = if ls is
    LNil() then LNil()
    LCons(seed, t) then LCons(proc(infRand(m, seed)), trials(t))
  divideToNum(listLen(filter(x => x, trials(enumFromTo(1, n)))), n)
//│ CTML translation succeeded.

