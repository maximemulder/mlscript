// Source: hkmc2/shared/src/test/mlscript-compile/nofib/secretary.mls.
// Lazy cells use shared delay and force. Strict lists use LNil() and LCons.
// The MLScript runtime reference for input 50 is "[0.3,0.3,0.3,0.34,0.36]".

/** Generate the infinite stream for seed s; the source modulus power(2, 7) is 128. */
fun infRand(m, s) =
  /** Delay the next node and its successor. */
  fun next(x) = delay(() => LzCons(intMod(x, m) + 1, next(intMod(97 * x + 11, 128))))
  next(s)
//│ infRand: ∀α. {α ≥ Delayed ∧ {resume: Unit → ((LzCons ∧ {head: Int}) ∧ {tail: α})}} ⟹ Int → Int → (Delayed ∧ {resume: Unit → ((LzCons ∧ {head: Int}) ∧ {tail: α})})

/** Inspect both the first node and the first delayed tail of the infinite producer. */
fun firstTwoScores(seed) =
  if force(infRand(100, seed)) is LzCons(h, t) then
    if force(t) is LzCons(next, rest) then [h, next]
//│ firstTwoScores: Int → ⟨Int, Int⟩

firstTwoScores(1) as [Int, Int]
//│ ⟨Int, Int⟩

:te
infRand(100, "bad")
//│ ═══[TYPE ERROR] Cannot solve judgment α ≤ Str → β.
