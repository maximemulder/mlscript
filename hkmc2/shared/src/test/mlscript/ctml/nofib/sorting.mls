/** Read and sort the original Haskell source fixture before hashing. */
fun testSorting_nofib(d) =
  let f = nofibStringToList(
    nofibReadText("./hkmc2/shared/src/test/mlscript/nofib/input/Main.hs"))
  hash(mangle(f))
//│ CTML translation succeeded.

