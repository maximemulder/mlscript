// Source: hkmc2/shared/src/test/mlscript-compile/nofib/sorting.mls.
// Tree branches use structural recursive fields. All eight sort passes keep their source order.

/** Equal character lists. */
data class EQ()
/** A greater left character list. */
data class GT()
/** A smaller left character list. */
data class LT()
//│ EQ: Unit → EQ
//│ GT: Unit → GT
//│ LT: Unit → LT

:ctml-parse-only // FIXME: The recursive lexicographic comparison exceeds the 20000-call budget.
/** Compare lists by the code point of each source character. */
fun compareList(xs, ys) = if
  xs is LNil() and ys is LNil() then EQ()
  xs is LNil() and ys is LCons(_, _) then LT()
  xs is LCons(_, _) and ys is LNil() then GT()
  xs is LCons(x, xs_) and ys is LCons(y, ys_) then
    let a = nofibCodePoint(x)
    let b = nofibCodePoint(y)
    if
      a === b then compareList(xs_, ys_)
      0 <= a and 0 <= b and a < b then LT()
      else GT()
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The lexicographic comparison is translation-only.
/** Test whether the left list comes after the right list. */
fun gtList(a, b) = if compareList(a, b) is GT() then true else false
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The lexicographic comparison is translation-only.
/** Test whether the left list is no greater than the right list. */
fun leList(a, b) = if gtList(a, b) then false else true
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The lexicographic comparison is translation-only.
/** Test whether the left list comes before the right list. */
fun ltList_(a, b) = if compareList(a, b) is LT() then true else false
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The lexicographic comparison is translation-only.
/** Test whether the left list is no smaller than the right list. */
fun geList(a, b) = if ltList_(a, b) then false else true
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The lexicographic comparison is translation-only.
/** Test whether two character lists are equal. */
fun eqList(a, b) = if compareList(a, b) is EQ() then true else false
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Recursive separator insertion exceeds the 20000-call budget.
/** Insert the separator before every element. */
fun prependToAll(sep, xs) = if xs is
  LNil() then LNil()
  LCons(x, xs_) then LCons(sep, LCons(x, prependToAll(sep, xs_)))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Recursive separator insertion is translation-only.
/** Insert separators between successive elements. */
fun intersperse(sep, xs) = if xs is
  LNil() then LNil()
  LCons(x, xs_) then LCons(x, prependToAll(sep, xs_))
//│ CTML translation succeeded.

/** Split into lines without adding an empty line for a terminal newline. */
fun lines(s) = if
  s is LNil() then LNil()
  break_(x => x === "\n", s) is [l, s_] then
    let tt = if s_ is
      LNil() then LNil()
      LCons(_, s__) then lines(s__)
    LCons(l, tt)
//│ lines: LNil → LNil

/** Select the source heap's left branch when the index is even. */
fun odd(x) = intMod(x, 2) === 0
//│ odd: Int → Bool

/** Fold character codes into the source base-31 bigint hash. */
fun hash(str) = foldl(
  (acc, c) => bigIntAdd(nofibCodePointBigInt(c), bigIntMul(acc, bigIntFrom(31))),
  bigIntFrom(0),
  str
)
//│ hash: ∀α. {α ≤ Str} ⟹ (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X) → BigInt

:ctml-parse-only // FIXME: The lexicographic comparison is translation-only.
/** Quicksort using two passes to collect elements on each side of the pivot. */
fun quickSort(xs) = if xs is
  LNil() then LNil()
  LCons(x, xs_) then
    /** Collect elements at most the pivot in source order. */
    fun lscomp1(ls) = if ls is
      LNil() then LNil()
      LCons(h, t) then if leList(h, x) then LCons(h, lscomp1(t)) else lscomp1(t)
    /** Collect elements greater than the pivot in source order. */
    fun lscomp2(ls) = if ls is
      LNil() then LNil()
      LCons(h, t) then if gtList(h, x) then LCons(h, lscomp2(t)) else lscomp2(t)
    append(quickSort(lscomp1(xs_)), LCons(x, quickSort(lscomp2(xs_))))
//│ CTML translation succeeded.

/** Prepend an element to the selected half of a partition. */
fun select(p, x, ts_fs) = if ts_fs is [ts, fs] then
  if p(x) then [LCons(x, ts), fs] else [ts, LCons(x, fs)]
//│ select: ∀α, β, γ. (α → Bool) → α → ⟨β, γ⟩ → (⟨(LCons ∧ {head: α}) ∧ {tail: β}, γ⟩ ∨ ⟨β, (LCons ∧ {head: α}) ∧ {tail: γ}⟩)

/** Partition a list with the source right fold. */
fun partition(p, xs) = foldr((x, y) => select(p, x, y), [LNil(), LNil()], xs)
//│ partition: ∀α, β, γ. {γ ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: γ}), β ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: β})} ⟹ (α → Bool) → (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X) → ((⟨(LCons ∧ {head: α}) ∧ {tail: β}, γ⟩ ∨ ⟨β, (LCons ∧ {head: α}) ∧ {tail: γ}⟩) ∨ ⟨LNil, LNil⟩)

:ctml-parse-only // FIXME: The lexicographic comparison is translation-only.
/** Quicksort using one right-fold partition per pivot. */
fun quickSort2(xs) = if xs is
  LNil() then LNil()
  LCons(x, xs_) then
    if partition(y => geList(x, y), xs_) is [lo, hi] then
      append(quickSort2(lo), LCons(x, quickSort2(hi)))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The lexicographic comparison is translation-only.
/** Quicksort using a tail-recursive partition with reversed accumulators. */
fun quickerSort(xss) = if xss is
  LNil() then LNil()
  LCons(x, LNil()) then LCons(x, LNil())
  LCons(x, xs) then
    /** Accumulate both parts, then recurse on the two sublists. */
    fun split(x, lo, hi, ys) = if ys is
      LNil() then append(quickerSort(lo), LCons(x, quickerSort(hi)))
      LCons(y, ys_) then
        if leList(y, x) then split(x, LCons(y, lo), hi, ys_)
        else split(x, lo, LCons(y, hi), ys_)
    split(x, LNil(), LNil(), xs)
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The lexicographic comparison is translation-only.
/** Insertion sort with a reversed prefix of the sorted list. */
fun insertSort(xss) = if xss is
  LNil() then LNil()
  LCons(x, xs) then
    /** Move across the sorted prefix and insert the next item. */
    fun trins(rev, xs, ys) = if
      xs is LNil() and ys is LCons(y, ys_) then
        trins(LNil(), append(reverse(rev), LCons(y, LNil())), ys_)
      ys is LNil() then append(reverse(rev), xs)
      xs is LCons(x, xs_) and ys is LCons(y, ys_) then
        if ltList_(x, y) then trins(LCons(x, rev), xs_, LCons(y, ys_))
        else trins(LNil(), append(reverse(rev), LCons(y, LCons(x, xs_))), ys_)
    trins(LNil(), LCons(x, LNil()), xs)
//│ CTML translation succeeded.

/** The empty tree or heap. */
data class Tip()
/** A tree or heap node with two subtrees. */
data class Branch(a, l, r)
//│ Tip: Unit → Tip
//│ Branch: ∀α, β, γ. α → β → γ → (((Branch ∧ {a: α}) ∧ {l: β}) ∧ {r: γ})

:ctml-parse-only // FIXME: The recursive tree traversals exceed the 20000-call budget.
/** Tree sort by a right fold of inserts followed by an in-order traversal. */
fun treeSort(param) =
  /** Insert one item, putting equal items in the left subtree. */
  fun to_tree(x, t) = if t is
    Tip() then Branch(x, Tip(), Tip())
    Branch(y, l, r) then
      if leList(x, y) then Branch(y, to_tree(x, l), r)
      else Branch(y, l, to_tree(x, r))
  /** Read the items in in-order traversal. */
  fun readTree(t) = if t is
    Tip() then LNil()
    Branch(x, l, r) then append(readTree(l), LCons(x, readTree(r)))
  readTree(foldr(to_tree, Tip(), param))
//│ CTML translation succeeded.

/** The empty tree in the leaf-specialized tree sort. */
data class Tip2()
/** A leaf in the leaf-specialized tree sort. */
data class Twig2(a)
/** An internal node in the leaf-specialized tree sort. */
data class Branch2(a, l, r)
//│ Tip2: Unit → Tip2
//│ Twig2: ∀α. α → (Twig2 ∧ {a: α})
//│ Branch2: ∀β, γ, δ. β → γ → δ → (((Branch2 ∧ {a: β}) ∧ {l: γ}) ∧ {r: δ})

:ctml-parse-only // FIXME: The recursive tree traversals exceed the 20000-call budget.
/** Tree sort using a distinct constructor for a node without children. */
fun treeSort2(param) =
  /** Insert an item, promoting a leaf when it gains a child. */
  fun to_tree(x, t) = if t is
    Tip2() then Twig2(x)
    Twig2(y) then
      if leList(x, y) then Branch2(y, Twig2(x), Tip2())
      else Branch2(y, Tip2(), Twig2(x))
    Branch2(y, l, r) then
      if leList(x, y) then Branch2(y, to_tree(x, l), r)
      else Branch2(y, l, to_tree(x, r))
  /** Read the items in in-order traversal. */
  fun readTree(t) = if t is
    Tip2() then LNil()
    Twig2(x) then LCons(x, LNil())
    Branch2(x, l, r) then append(readTree(l), LCons(x, readTree(r)))
  readTree(foldr(to_tree, Tip2(), param))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Recursive heap construction exceeds the 20000-call budget.
/** Heapsort with the source index-based insertion and heap merge. */
fun heapSort(xs) =
  /** Insert one item along the direction selected by the current index bit. */
  fun to_heap(k, x, t) = if t is
    Tip() then Branch(x, Tip(), Tip())
    Branch(y, l, r) then
      if
        leList(x, y) and odd(k) then Branch(x, to_heap(intDiv(k, 2), y, l), r)
        leList(x, y) then Branch(x, l, to_heap(intDiv(k, 2), y, r))
        odd(k) then Branch(y, to_heap(intDiv(k, 2), x, l), r)
        else Branch(y, l, to_heap(intDiv(k, 2), x, r))
  /** Build the heap by inserting items as the recursion returns. */
  fun heap(k, xs) = if xs is
    LNil() then Tip()
    LCons(x, xs_) then to_heap(k, x, heap(k + 1, xs_))
  /** Merge the two heaps by promoting their smaller root. */
  fun mix(l, r) = if
    l is Tip() then r
    r is Tip() then l
    l is Branch(x, l1, r1) and r is Branch(y, l2, r2) then
      if leList(x, y) then Branch(x, mix(l1, r1), Branch(y, l2, r2))
      else Branch(y, Branch(x, l1, r1), mix(l2, r2))
  /** Extract each root and continue with its merged children. */
  fun clear(t) = if t is
    Tip() then LNil()
    Branch(x, l, r) then LCons(x, clear(mix(l, r)))
  clear(heap(0, xs))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: Recursive run splitting exceeds the 20000-call budget.
/** Sort by splitting the source runs and merging them from right to left. */
fun mergeSort(param) =
  /** Grow a run until the source comparisons end it. */
  fun runsplit(run, xs) = if
    run is LNil() and xs is LNil() then LNil()
    xs is LNil() then LCons(run, LNil())
    run is LNil() and xs is LCons(x, xs_) then runsplit(LCons(x, LNil()), xs_)
    run is LCons(r, rs) and xs is LCons(x, xs_) then
      if
        rs is LNil() and gtList(x, r) then runsplit(LCons(r, LCons(x, LNil())), xs_)
        leList(x, r) then runsplit(LCons(x, LCons(r, rs)), xs_)
        else LCons(LCons(r, rs), runsplit(LCons(x, LNil()), xs_))
  /** Merge two sorted runs, emitting both items on equality. */
  fun merge(xs, ys) = if
    xs is LNil() then ys
    ys is LNil() then xs
    xs is LCons(x, xs_) and ys is LCons(y, ys_) then
      if
        eqList(x, y) then LCons(x, LCons(y, merge(xs_, ys_)))
        ltList_(x, y) then LCons(x, merge(xs_, LCons(y, ys_)))
        else LCons(y, merge(LCons(x, xs_), ys_))
  /** Merge the remaining runs before merging the head run. */
  fun merge_lists(xs) = if xs is
    LNil() then LNil()
    LCons(x, xs_) then merge(x, merge_lists(xs_))
  merge_lists(runsplit(LNil(), param))
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The sorting passes and separator insertion are translation-only.
/** Compose the source sort passes with an intervening reversal. */
fun mangle(inpt) =
  let passes = LCons(heapSort, LCons(insertSort, LCons(mergeSort, LCons(quickSort,
    LCons(quickSort2, LCons(quickerSort, LCons(treeSort, LCons(treeSort2, LNil()))))))))
  /** Apply the composed sorter to the line list. */
  fun sort(param) = foldr(
    (f, g) => x => f(g(x)), x => x, intersperse(reverse, passes))(param)
  unlines(sort(lines(inpt)))
//│ CTML translation succeeded.

