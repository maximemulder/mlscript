    LCons(Sphere([0.272166, [0.272166, 0.544331]], 0.166667, s2),
      LCons(Sphere([0.643951, [0.172546, 0.0]], 0.166667, s2),
        LCons(Sphere([0.172546, [0.643951, 0.0]], 0.166667, s2),
