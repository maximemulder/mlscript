// Source: hkmc2/shared/src/test/mlscript-compile/nofib/sphere.mls.
// Vectors, camera parameters, and hit results use right-nested pairs.
// The three mutually recursive light paths share a tagged dispatcher.

/** A three-component floating-point vector or colour. */
type Vec = [Num, [Num, Num]]
//│ Vec = ⟨Num, ⟨Num, Num⟩⟩

/** JavaScript Math.PI. */
val pi = 3.141592653589793
/** Threshold for negligible rays and surface offsets. */
val epsilon = 0.000001
/** Distance used in a miss result or for a directional light. */
val infinity = 100000000.0
//│ pi: Num
//│ epsilon: Num
//│ infinity: Num

/** Add vectors componentwise. */
fun vecadd(a1, a2) =
  if a1 is [x1, [y1, z1]] and a2 is [x2, [y2, z2]] then
    [numAdd(x1, x2), [numAdd(y1, y2), numAdd(z1, z2)]]
//│ vecadd: ⟨Num, ⟨Num, Num⟩⟩ → ⟨Num, ⟨Num, Num⟩⟩ → ⟨Num, ⟨Num, Num⟩⟩

/** Subtract the second vector componentwise. */
fun vecsub(a1, a2) =
  if a1 is [x1, [y1, z1]] and a2 is [x2, [y2, z2]] then
    [numSub(x1, x2), [numSub(y1, y2), numSub(z1, z2)]]
//│ vecsub: ⟨Num, ⟨Num, Num⟩⟩ → ⟨Num, ⟨Num, Num⟩⟩ → ⟨Num, ⟨Num, Num⟩⟩

/** Multiply vectors componentwise. */
fun vecmult(a1, a2) =
  if a1 is [x1, [y1, z1]] and a2 is [x2, [y2, z2]] then
    [numMul(x1, x2), [numMul(y1, y2), numMul(z1, z2)]]
//│ vecmult: ⟨Num, ⟨Num, Num⟩⟩ → ⟨Num, ⟨Num, Num⟩⟩ → ⟨Num, ⟨Num, Num⟩⟩

/** Add up a list of vectors from right to left. */
fun vecsum(xs) = foldr(vecadd, [0.0, [0.0, 0.0]], xs)
//│ vecsum: ∀α. {α ≤ ⟨Num, ⟨Num, Num⟩⟩} ⟹ (∀X. {X ≥ LNil ∨ ((LCons ∧ {head: α}) ∧ {tail: X})} ⟹ X) → ⟨Num, ⟨Num, Num⟩⟩

/** Return a unit vector and the input's length. */
fun vecnorm(xyz) = if xyz is [x, [y, z]] then
  let len = numSqrt(numAdd(numAdd(numMul(x, x), numMul(y, y)), numMul(z, z)))
  [[numDiv(x, len), [numDiv(y, len), numDiv(z, len)]], len]
//│ vecnorm: ⟨Num, ⟨Num, Num⟩⟩ → ⟨⟨Num, ⟨Num, Num⟩⟩, Num⟩

/** Scale all three components by one factor. */
fun vecscale(xyz, a) = if xyz is [x, [y, z]] then
  [numMul(a, x), [numMul(a, y), numMul(a, z)]]
//│ vecscale: ⟨Num, ⟨Num, Num⟩⟩ → Num → ⟨Num, ⟨Num, Num⟩⟩

/** Take the dot product of two vectors. */
fun vecdot(a1, a2) = if a1 is [x1, [y1, z1]] and a2 is [x2, [y2, z2]] then
  numAdd(numAdd(numMul(x1, x2), numMul(y1, y2)), numMul(z1, z2))
//│ vecdot: ⟨Num, ⟨Num, Num⟩⟩ → ⟨Num, ⟨Num, Num⟩⟩ → Num

/** Take the cross product of two vectors. */
fun veccross(a1, a2) = if a1 is [x1, [y1, z1]] and a2 is [x2, [y2, z2]] then
  [numSub(numMul(y1, z2), numMul(y2, z1)),
    [numSub(numMul(z1, x2), numMul(z2, x1)), numSub(numMul(x1, y2), numMul(x2, y1))]]
//│ veccross: ⟨Num, ⟨Num, Num⟩⟩ → ⟨Num, ⟨Num, Num⟩⟩ → ⟨Num, ⟨Num, Num⟩⟩

/** Apply the source signed component test for negligible intensity. */
fun is_zerovector(v) = if v is [x, [y, z]] then
  numGt(epsilon, x) && numGt(epsilon, y) && numGt(epsilon, z)
//│ is_zerovector: ⟨Num, ⟨Num, Num⟩⟩ → Bool

/** A directional light with direction and colour. */
data class Directional(x: Vec, y: Vec)
/** A point light with position and colour. */
data class Point(x: Vec, y: Vec)
//│ Directional: ∀α, β. {β ≤ Vec, α ≤ Vec} ⟹ α → β → ((Directional ∧ {x: α}) ∧ {y: β})
//│ Point: ∀γ, δ. {δ ≤ Vec, γ ≤ Vec} ⟹ γ → δ → ((Point ∧ {x: γ}) ∧ {y: δ})

/** Return the position of a point light. */
fun lightpos(p) = if p is Point(pos, _) then pos
//│ lightpos: ∀α. (({x: α} ∧ Point) ∧ {y: ⊤}) → α

/** Normalize a directional light's direction. */
fun lightdir(d) = if d is Directional(dir, _) then fst(vecnorm(dir))
//│ lightdir: (({x: ⟨Num, ⟨Num, Num⟩⟩} ∧ Directional) ∧ {y: ⊤}) → ⟨Num, ⟨Num, Num⟩⟩

/** Return the colour of either light kind. */
fun lightcolour(x) = if x is
  Directional(_, col) then col
  Point(_, col) then col
//│ lightcolour: ∀α. ((({y: α} ∧ Directional) ∧ {x: ⊤}) ∨ (({y: α} ∧ Point) ∧ {x: ⊤})) → α

/** An ambient lighting coefficient. */
data class Ambient(v: Vec)
/** A diffuse lighting coefficient. */
data class Diffuse(v: Vec)
/** A specular lighting coefficient. */
data class Specular(v: Vec)
/** The exponent of the specular term. */
data class Specpow(v: Num)
/** A reflectivity coefficient. */
data class Reflect(v: Num)
/** A transmissivity coefficient. */
data class Transmit(v: Num)
/** An index of refraction. */
data class Refract(v: Num)
/** The surface body colour. */
data class Body(v: Vec)
//│ Ambient: ∀α. {α ≤ Vec} ⟹ α → (Ambient ∧ {v: α})
//│ Diffuse: ∀β. {β ≤ Vec} ⟹ β → (Diffuse ∧ {v: β})
//│ Specular: ∀γ. {γ ≤ Vec} ⟹ γ → (Specular ∧ {v: γ})
//│ Specpow: ∀δ. {δ ≤ Num} ⟹ δ → (Specpow ∧ {v: δ})
//│ Reflect: ∀ε. {ε ≤ Num} ⟹ ε → (Reflect ∧ {v: ε})
//│ Transmit: ∀ζ. {ζ ≤ Num} ⟹ ζ → (Transmit ∧ {v: ζ})
//│ Refract: ∀η. {η ≤ Num} ⟹ η → (Refract ∧ {v: η})
//│ Body: ∀θ. {θ ≤ Vec} ⟹ θ → (Body ∧ {v: θ})

/** One surface specification entry. */
type Surfspec = Ambient | Diffuse | Specular | Specpow | Reflect | Transmit | Refract | Body
//│ Surfspec = ((((((Ambient ∨ Diffuse) ∨ Specular) ∨ Specpow) ∨ Reflect) ∨ Transmit) ∨ Refract) ∨ Body

/** A proper list of surface specification entries. */
type Surface = [X restricts (LNil | (LCons & {head: Surfspec} & {tail: X}))] -> X
//│ Surface = ∀X. {X ≥ LNil ∨ ((LCons ∧ {head: Surfspec}) ∧ {tail: X})} ⟹ X

