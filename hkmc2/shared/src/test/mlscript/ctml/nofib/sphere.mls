/** A sphere with a center, radius, and ordered surface specification. */
data class Sphere(pos: Vec, radius: Num, surface: Surface)
//│ Sphere: ∀α, β, γ. {β ≤ Num, γ ≤ Surface, α ≤ Vec} ⟹ α → β → γ → (((Sphere ∧ {pos: α}) ∧ {radius: β}) ∧ {surface: γ})

/** Return a sphere's surface specification. */
fun spheresurf(s) = if s is Sphere(_, _, surf) then surf
//│ spheresurf: ∀α. ((({surface: α} ∧ Sphere) ∧ {pos: ⊤}) ∧ {radius: ⊤}) → α

/** The camera's target. */
val lookat = [0.0, [0.0, 0.0]]
/** The camera's vertical direction. */
val vup = [0.0, [0.0, 1.0]]
/** The source field of view in degrees. */
val fov = 45.0
/** The surface used by every sphere in the fixed scene. */
val s2 = LCons(Ambient([0.035, [0.0325, 0.025]]),
  LCons(Diffuse([0.5, [0.45, 0.35]]), LCons(Specular([0.8, [0.8, 0.8]]),
    LCons(Specpow(3.0), LCons(Reflect(0.5), LNil())))))
//│ lookat: ⟨Num, ⟨Num, Num⟩⟩
//│ vup: ⟨Num, ⟨Num, Num⟩⟩
//│ fov: Num
//│ s2: (LCons ∧ {head: Ambient ∧ {v: ⟨Num, ⟨Num, Num⟩⟩}}) ∧ {tail: (LCons ∧ {head: Diffuse ∧ {v: ⟨Num, ⟨Num, Num⟩⟩}}) ∧ {tail: (LCons ∧ {head: Specular ∧ {v: ⟨Num, ⟨Num, Num⟩⟩}}) ∧ {tail: (LCons ∧ {head: Specpow ∧ {v: Num}}) ∧ {tail: (LCons ∧ {head: Reflect ∧ {v: Num}}) ∧ {tail: LNil}}}}}

