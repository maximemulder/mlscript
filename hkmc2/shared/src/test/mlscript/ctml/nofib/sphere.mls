            LCons(Sphere([numSub(0.0, 0.471405), [0.471405, 0.0]], 0.166667, s2),
              LCons(Sphere([numSub(0.0, 0.643951), [numSub(0.0, 0.172546), 0.0]], 0.166667, s2),
                LCons(Sphere([0.0996195, [numSub(0.0, 0.371785), 0.544331]], 0.166667, s2),
