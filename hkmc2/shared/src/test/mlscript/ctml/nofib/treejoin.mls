:ctml-parse-only // FIXME: The fixture parser and join are translation-only.
/** Join the two original fixtures using their shared first-column key. */
fun testTreejoin_nofib(n) =
  let c1 = nofibStringToList(
    nofibReadText("./hkmc2/shared/src/test/mlscript/nofib/input/1500.1"))
  let c2 = nofibStringToList(
    nofibReadText("./hkmc2/shared/src/test/mlscript/nofib/input/1500.2"))
  let a = readTree(firstColumn, c1, Empty())
  let b = readTree(firstColumn, c2, Empty())
  join(a, b, Empty())
//│ CTML translation succeeded.

:ctml-parse-only // FIXME: The fixture parser, join, and recursive renderer are translation-only.
/** Run the benchmark and render the result. */
fun main() = renderJoin(testTreejoin_nofib(0))
