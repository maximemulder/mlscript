:ctml

fun a1(x, y) = y
//│ a1: ∀30. ⊤ → 30 → 30
// OK

val a2 = choose(id)
//│ a2: ∀32. {32 ≥ ∀A. A → A} ⟹ 32 → 32
// OK

val a3 = choose(nil, ids)
//│ a3: (∀A. List[⊥]) ∨ List[∀A. A → A]
// MAYBE

fun a4(x) = x(x)
//│ a4: ∀43, 44. {43 ≤ 43 → 44} ⟹ 43 → 44
// OK

val a5 = id(auto)
//│ a5: (∀A. A → A) → (∀A. A → A)
// OK

val a6 = id(auto2)
//│ a6: ∀B. (∀A. A → A) → B → B
// OK

val a7 = choose(id, auto)
//│ a7: (∀A. A → A) ∨ ((∀A. A → A) → (∀A. A → A))
// MAYBE

val a8 = choose(id, auto2)
//│ a8: (∀A. A → A) ∨ (∀B. (∀A. A → A) → B → B)
// MAYBE

val a9 = f(choose(id), ids)
//│ a9: (∀A. A → A) ∨ (∀A. A → A)
// MAYBE

val a10 = poly(id)
//│ a10: ⟨Int, Bool⟩
// OK

val a11 = poly((p) => p)
//│ a11: ⟨Int, Bool⟩
// OK

val a12 = id(poly((p) => p))
//│ a12: ⟨Int, Bool⟩
